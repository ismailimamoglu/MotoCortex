hery_isa_overspeed_chime_mute:{name:"\u0414\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u044f \u0434\u0437\u0432\u0456\u043d\u043a\u0430 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 ISA",desc:"\u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u0431\u0435\u0437\u043f\u0435\u0440\u0435\u0440\u0432\u043d\u043e\u0433\u043e \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 80/120 \u043a\u043c/\u0433\u043e\u0434 \u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044f\u0445 Tiggo/MG."},mg_ev_battery_preconditioning_toggle:{name:"\u0420\u0443\u0447\u043d\u0438\u0439 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u043d\u0430\u0433\u0440\u0456\u0432\u0443 \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0448\u0432\u0438\u0434\u043a\u043e\u0457 \u0437\u0430\u0440\u044f\u0434\u043a\u0438 EV",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u0440\u0443\u0447\u043d\u0438\u0439 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u043d\u0430\u0433\u0440\u0456\u0432\u0443 \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u043f\u0435\u0440\u0435\u0434 \u0448\u0432\u0438\u0434\u043a\u043e\u044e \u0437\u0430\u0440\u044f\u0434\u043a\u043e\u044e \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u043e\u0433\u043e \u0441\u0442\u0440\u0443\u043c\u0443."},chery_dms_fatigue_camera_mute:{name:"\u0417\u043d\u0438\u0436\u0435\u043d\u043d\u044f \u0447\u0443\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u0456 \u043a\u0430\u043c\u0435\u0440\u0438 \u043c\u043e\u043d\u0456\u0442\u043e\u0440\u0438\u043d\u0433\u0443 \u0432\u043e\u0434\u0456\u044f (DMS).",desc:"\u0417\u043c\u0435\u043d\u0448\u0443\u0454 \u043d\u0430\u0434\u043c\u0456\u0440\u043d\u043e \u0447\u0443\u0442\u043b\u0438\u0432\u0456 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u0432\u0442\u043e\u043c\u0443 \u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0437\u0430 \u043e\u0447\u0438\u043c\u0430 \u043d\u0430 \u0440\u0443\u043b\u044c\u043e\u0432\u0456\u0439 \u043a\u043e\u043b\u043e\u043d\u0446\u0456."},honda_walk_away_auto_lock:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0438\u0439 \u0434\u0432\u0435\u0440\u043d\u0438\u0439 \u0437\u0430\u043c\u043e\u043a Walk-Away",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0437\u0430\u043c\u0438\u043a\u0430\u0454 \u0432\u0441\u0456 \u0434\u0432\u0435\u0440\u0456, \u043a\u043e\u043b\u0438 \u0432\u043e\u0434\u0456\u0439 \u0432\u0456\u0434\u0441\u0442\u0443\u043f\u0430\u0454 \u043d\u0430 2 \u043c\u0435\u0442\u0440\u0438 \u0437 \u0431\u0440\u0435\u043b\u043e\u043a\u043e\u043c."},subaru_avh_auto_hold_memory:{name:"\u0420\u0435\u0436\u0438\u043c \u043f\u0430\u043c'\u044f\u0442\u0456 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0443\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f (AVH).",desc:"\u0417\u0430\u043f\u0430\u043c'\u044f\u0442\u043e\u0432\u0443\u0454 \u0441\u0442\u0430\u043d \u0443\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0433\u0430\u043b\u044c\u043c\u0430 AVH \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e/\u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0446\u0438\u043a\u043b\u0456\u0432 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f."},volvo_start_stop_default_off:{name:"\u0420\u0435\u0436\u0438\u043c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443-\u0437\u0443\u043f\u0438\u043d\u043a\u0438 \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0412\u0418\u041c\u041a",desc:"\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0454 \u0441\u0442\u0430\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u0434\u0432\u0438\u0433\u0443\u043d\u0430 Start-Stop \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0443 \u0412\u0418\u041c\u041a\u041d\u0415\u041d\u041d\u042f \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f."},volvo_polestar_digital_theme:{name:"\u0422\u0435\u043c\u0430 Polestar Blue Digital Cluster",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0444\u0456\u0440\u043c\u043e\u0432\u0443 \u0431\u043b\u0430\u043a\u0438\u0442\u043d\u0443 \u0434\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u0443 \u0442\u0435\u043c\u0443 Polestar \u043d\u0430 \u0434\u0438\u0441\u043f\u043b\u0435\u0457 \u0432\u043e\u0434\u0456\u044f Volvo."},vag_virtual_cockpit_r_theme:{name:"\u0412\u0456\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u0430 \u043a\u0430\u0431\u0456\u043d\u0430 R / S / Cupra Performance Themes",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0442\u0435\u043c\u0438 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0442\u0430\u0445\u043e\u043c\u0435\u0442\u0440\u0430 R-Line, S-Line \u0456 Cupra \u0432 \u0446\u0438\u0444\u0440\u043e\u0432\u0456\u0439 \u043a\u0430\u0431\u0456\u043d\u0456."},vag_sound_symposer_mute:{name:"Sound Symposer Fake Engine Noise Deactivation",desc:"\u0414\u0435\u0437\u0430\u043a\u0442\u0438\u0432\u0443\u0454 \u0444\u0430\u043b\u044c\u0448\u0438\u0432\u0438\u0439 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440 \u0437\u0432\u0443\u043a\u0443 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0434\u0438\u043d\u0430\u043c\u0456\u043a\u0430 \u043a\u0430\u0431\u0456\u043d\u0438 \u0434\u043b\u044f \u0447\u0438\u0441\u0442\u043e\u0457 \u043d\u043e\u0442\u0438 \u0432\u0438\u0445\u043b\u043e\u043f\u0443."},vag_wireless_carplay_enable:{name:"\u0411\u0435\u0437\u0434\u0440\u043e\u0442\u043e\u0432\u0430 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u044f Apple CarPlay \u0456 Android Auto",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u0431\u0435\u0437\u0434\u0440\u043e\u0442\u043e\u0432\u0438\u0439 Wi-Fi 5 \u0413\u0413\u0446 Apple CarPlay \u0456 Android Auto \u043d\u0430 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445 MIB2.5/MIB3."},vag_offroad_telemetry_menu:{name:"MIB Offroad Telemetry & Gauge Display",desc:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454 \u043a\u0443\u0442 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0443 \u043a\u0435\u0440\u043c\u0430, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043c\u0430\u0441\u043b\u0430, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043e\u0445\u043e\u043b\u043e\u0434\u0436\u0443\u044e\u0447\u043e\u0457 \u0440\u0456\u0434\u0438\u043d\u0438 \u0442\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u0432\u0438\u0441\u043e\u0442\u0438 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 MIB."},vag_easy_entry_driver_seat:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0430 \u043f\u0456\u0434\u043d\u0456\u0436\u043a\u0430 \u0441\u043f\u0438\u043d\u043a\u0438 \u0441\u0438\u0434\u0456\u043d\u043d\u044f \u0437 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043e\u043c \u0434\u043b\u044f \u043b\u0435\u0433\u043a\u043e\u0433\u043e \u0432\u0445\u043e\u0434\u0443",desc:"\u041f\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0454 \u0441\u0438\u0434\u0456\u043d\u043d\u044f \u0432\u043e\u0434\u0456\u044f \u0437 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043e\u043c \u043d\u0430 5 \u0441\u043c \u043f\u0456\u0441\u043b\u044f \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0442\u044f \u0434\u0432\u0435\u0440\u0435\u0439 \u0434\u043b\u044f \u043b\u0435\u0433\u043a\u043e\u0433\u043e \u0432\u0445\u043e\u0434\u0443 \u0432 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c."},vag_hba_memory_state:{name:"\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043f\u0430\u043c'\u044f\u0442\u0456 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0438 \u0434\u0430\u043b\u044c\u043d\u044c\u043e\u043c\u0443 \u0441\u0432\u0456\u0442\u043b\u0443 (HBA).",desc:"\u0417\u0430\u043f\u0430\u043c'\u044f\u0442\u043e\u0432\u0443\u0454 \u0441\u0442\u0430\u043d \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0438 \u0434\u0430\u043b\u044c\u043d\u044c\u043e\u0433\u043e \u0441\u0432\u0456\u0442\u043b\u0430 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0446\u0438\u043a\u043b\u0456\u0432 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f."},vag_battery_soc_display:{name:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0440\u0456\u0432\u043d\u044f \u0437\u0430\u0440\u044f\u0434\u0443 \u0431\u0430\u0442\u0430\u0440\u0435\u0457 (% SOC).",desc:"\u041f\u043e\u043a\u0430\u0437\u0443\u0454 \u0442\u043e\u0447\u043d\u0438\u0439 \u0432\u0456\u0434\u0441\u043e\u0442\u043e\u043a \u0437\u0430\u0440\u044f\u0434\u0443 \u0431\u0430\u0442\u0430\u0440\u0435\u0457 (% SOC) \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u0456\u0432, \u043a\u043e\u043b\u0438 \u0443\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u043a\u043d\u043e\u043f\u043a\u0430 \u043f\u043e\u0457\u0437\u0434\u043a\u0438."},bmw_idrive7_m_animation:{name:"iDrive 7 / 8 M-Performance Startup Animation",desc:"\u0417\u043c\u0456\u043d\u044e\u0454 \u0433\u0440\u0430\u0444\u0456\u043a\u0443 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0435\u043a\u0440\u0430\u043d\u0430 iDrive \u043d\u0430 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u044e \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0443 M-Performance \u0430\u0431\u043e M-GmbH."},bmw_bowers_wilkins_audio_profiles:{name:"Bowers & Wilkins 3D Sound Engine Unlock",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0430\u0443\u0434\u0456\u043e\u043f\u0440\u043e\u0444\u0456\u043b\u0456 Bowers & Wilkins Concert, Studio \u0442\u0430 Stage DSP \u0443 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445 HiFi."},bmw_hitch_zoom_camera:{name:"\u0420\u0435\u0436\u0438\u043c \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0447\u0435\u043f\u0430 \u043a\u0430\u043c\u0435\u0440\u0438 \u0437\u0430\u0434\u043d\u044c\u043e\u0433\u043e \u0432\u0438\u0434\u0443",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0440\u0435\u0436\u0438\u043c \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0438\u0440\u0456\u0432\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0437\u0447\u0456\u043f\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e \u0437\u0433\u043e\u0440\u0438 \u0432\u043d\u0438\u0437 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043e\u0433\u043b\u044f\u0434\u0443 \u0437 \u043a\u0430\u043c\u0435\u0440\u0438 \u0437\u0430\u0434\u043d\u044c\u043e\u0433\u043e \u0432\u0438\u0434\u0443."},bmw_secure_idle_protection:{name:"\u041d\u0430\u0434\u0456\u0439\u043d\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0432\u0456\u0434 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447",desc:"\u0411\u043b\u043e\u043a\u0443\u0454 \u0442\u0440\u0430\u043d\u0441\u043c\u0456\u0441\u0456\u044e \u0432 \u0440\u0435\u0436\u0438\u043c\u0456 \u043f\u0430\u0440\u043a\u0443\u0432\u0430\u043d\u043d\u044f, \u044f\u043a\u0449\u043e \u0432\u043e\u0434\u0456\u0439 \u0437\u0430\u043b\u0438\u0448\u0430\u0454 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0438\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u0456\u0437 \u0431\u0440\u0435\u043b\u043e\u043a\u043e\u043c."},bmw_seatbelt_handover_mute:{name:"\u0414\u0435\u0437\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u044f \u0432\u0430\u0436\u0435\u043b\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0456 \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u043e\u0433\u043e \u0440\u0435\u043c\u0435\u043d\u044f \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043a\u0443\u043f\u0435",desc:"\u0412\u0438\u043c\u0438\u043a\u0430\u0454 \u043c\u043e\u0442\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u043f\u043e\u0434\u043e\u0432\u0436\u0443\u0432\u0430\u0447 \u0440\u0435\u043c\u0435\u043d\u044f \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043d\u0430 \u043a\u0443\u043f\u0435 \u0441\u0435\u0440\u0456\u0457 4 \u0456 2 \u0441\u0435\u0440\u0456\u0457."},bmw_auto_heat_threshold_5c:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0430 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043f\u0456\u0434\u0456\u0433\u0440\u0456\u0432\u0443 \u0441\u0438\u0434\u0456\u043d\u044c \u0456 \u043a\u0435\u0440\u043c\u0430 (+5\xb0C)",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0438\u0439 \u043e\u0431\u0456\u0433\u0440\u0456\u0432 \u0441\u0438\u0434\u0456\u043d\u044c \u0456 \u043a\u0435\u0440\u043c\u0430, \u043a\u043e\u043b\u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043d\u0430\u0432\u043a\u043e\u043b\u0438\u0448\u043d\u044c\u043e\u0433\u043e \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u043f\u0430\u0434\u0430\u0454 \u043d\u0438\u0436\u0447\u0435 5\xb0C."},mercedes_amg_track_pace_unlock:{name:"MBUX AMG Track Pace Telemetry & Lap Timer",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0433\u0440\u0430\u0444\u0456\u043a\u0438 \u0447\u0430\u0441\u0443 \u043a\u043e\u043b\u0430, \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u0457 \u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u044f \u0442\u0430 G-force \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 MBUX."},mercedes_drive_mode_last_memory:{name:"Dynamic Select Last Drive Mode Memory",desc:"\u0417\u0430\u043f\u0430\u043c'\u044f\u0442\u043e\u0432\u0443\u0454 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u0432\u0438\u0431\u0440\u0430\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c \u0432\u043e\u0434\u0456\u043d\u043d\u044f (\u0406\u043d\u0434\u0438\u0432\u0456\u0434\u0443\u0430\u043b\u044c\u043d\u0438\u0439/\u0421\u043f\u043e\u0440\u0442) \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f."},mercedes_proximity_360_camera_auto:{name:"\u0414\u0430\u0442\u0447\u0438\u043a \u043d\u0430\u0431\u043b\u0438\u0436\u0435\u043d\u043d\u044f \u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0438\u0439 \u043e\u0433\u043b\u044f\u0434 \u043a\u0430\u043c\u0435\u0440\u0438 360\xb0",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0454 \u0435\u043a\u0440\u0430\u043d \u043d\u0430 \u043a\u0430\u043c\u0435\u0440\u0443 360, \u043a\u043e\u043b\u0438 \u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u0432\u0438\u044f\u0432\u043b\u044f\u044e\u0442\u044c \u043f\u0435\u0440\u0435\u0448\u043a\u043e\u0434\u0443 < 50 \u0441\u043c."},ford_sync_climate_screen_unlock:{name:"\u0421\u0442\u043e\u0440\u0456\u043d\u043a\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u043a\u043b\u0456\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e SYNC3 / SYNC4 \u0456\u0437 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0438\u043c \u0435\u043a\u0440\u0430\u043d\u043e\u043c",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u043a\u043b\u0456\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c, \u043f\u0456\u0434\u0456\u0433\u0440\u0456\u0432 \u0441\u0438\u0434\u0456\u043d\u044c \u0456 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0443 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u043f\u043e\u0442\u043e\u043a\u0443 \u043f\u043e\u0432\u0456\u0442\u0440\u044f."},ford_turn_signal_5_flashes:{name:"\u0421\u0438\u0433\u043d\u0430\u043b \u0437\u043c\u0456\u043d\u0438 \u0441\u043c\u0443\u0433\u0438 \u0440\u0443\u0445\u0443 \u043e\u0434\u043d\u0438\u043c \u0434\u043e\u0442\u0438\u043a\u043e\u043c (5 \u0441\u043f\u0430\u043b\u0430\u0445\u0456\u0432)",desc:"\u0417\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u0432\u043a\u0430\u0437\u0456\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0443 \u0434\u043b\u044f \u0437\u043c\u0456\u043d\u0438 \u0441\u043c\u0443\u0433\u0438 \u0440\u0443\u0445\u0443 \u043e\u0434\u043d\u0438\u043c \u0434\u043e\u0442\u0438\u043a\u043e\u043c \u0437 3 \u0434\u043e 5 \u0441\u043f\u0430\u043b\u0430\u0445\u0456\u0432."},ford_auto_engine_shutdown_disable:{name:"\u041f\u0435\u0440\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0456 \u043f\u0440\u043e\u0441\u0442\u043e\u044e \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 30 \u0445\u0432\u0438\u043b\u0438\u043d",desc:"\u0417\u0430\u043f\u043e\u0431\u0456\u0433\u0430\u0454 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u043c\u0443 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043d\u044e \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u043f\u0456\u044