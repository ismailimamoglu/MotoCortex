c1\u03b1 NOx",torque:"\u03a1\u03bf\u03c0\u03ae \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",selectedSensorsCount:"\u0395\u03c0\u03b9\u03bb\u03ad\u03c7\u03b8\u03b7\u03ba\u03b1\u03bd {{count}} / {{max}} \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2"},expertise:{historyFound:"\u0392\u03a1\u0395\u0398\u0397\u039a\u0395 \u03a4\u039f \u0399\u03a3\u03a4\u039f\u03a1\u0399\u039a\u039f \u039f\u03a7\u0397\u039c\u0391\u03a4\u039f\u03a3!",historyFoundDesc:"{{count}}\u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ad\u03c2 \u03b1\u03c5\u03c4\u03bf\u03cd \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03ad\u03c7\u03bf\u03c5\u03bd \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b7\u03b8\u03b5\u03af \u03c0\u03c1\u03bf\u03b7\u03b3\u03bf\u03c5\u03bc\u03ad\u03bd\u03c9\u03c2. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03b4\u03b5\u03af\u03c4\u03b5 \u03c4\u03bf \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03c4\u03c9.",viewHistory:"\u0394\u0395\u0399\u03a4\u0395 \u03a4\u0397\u039d \u0399\u03a3\u03a4\u039f\u03a1\u0399\u0391 \u203a",manualVin:"\u0391\u03a1\u0399\u0398\u039c\u039f\u03a3 \u03a0\u039b\u0391\u0399\u03a3\u0399\u039f\u03a5 (\u03a7\u0395\u0399\u03a1\u039f\u039a\u0399\u039d\u0397\u03a4\u0399\u039a\u0397 \u0395\u0399\u03a3\u039f\u0394\u039f\u03a3)",manualVinDesc:"\u0395\u03ac\u03bd \u03bf \u03c5\u03c0\u03bf\u03bb\u03bf\u03b3\u03b9\u03c3\u03c4\u03ae\u03c2 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b4\u03b5\u03bd \u03ba\u03bf\u03b9\u03bd\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03bd \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc \u03c0\u03bb\u03b1\u03b9\u03c3\u03af\u03bf\u03c5 (VIN), \u03bc\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03c4\u03bf\u03bd \u03b3\u03c1\u03ac\u03c8\u03b5\u03c4\u03b5 \u03b5\u03b4\u03ce.",vinPlaceholder:"\u03a0\u03bb\u03b7\u03ba\u03c4\u03c1\u03bf\u03bb\u03bf\u03b3\u03ae\u03c