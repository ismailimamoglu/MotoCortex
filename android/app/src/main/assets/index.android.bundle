7\u30ed\u30d1\u30a4\u30ed\u30c3\u30c8\u306e\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u4ecb\u5165\u306e\u92ed\u3055\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},nissan_intelligent_around_view:{name:"\u30a2\u30e9\u30a6\u30f3\u30c9\u30d3\u30e5\u30fc\u30e2\u30cb\u30bf\u30fc\u4f4e\u901f\u6642\u81ea\u52d5\u30dd\u30c3\u30d7\u30a2\u30c3\u30d7\uff08\u65e5\u7523\uff09",desc:"\u30d5\u30ed\u30f3\u30c8\u30d1\u30fc\u30ad\u30f3\u30b0\u30bb\u30f3\u30b5\u30fc\u304c\u969c\u5bb3\u7269\u3092\u691c\u51fa\u3059\u308b\u3068\u3001360 \u5ea6\u30ab\u30e1\u30e9\u8868\u793a\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u307e\u3059\u3002"},mazda_g_vectoring_display:{name:"G-\u30d9\u30af\u30bf\u30ea\u30f3\u30b0 \u30b3\u30f3\u30c8\u30ed\u30fc\u30eb \u30d7\u30e9\u30b9 \u30c0\u30a4\u30ca\u30df\u30c3\u30af \u30d3\u30b8\u30e5\u30a2\u30e9\u30a4\u30b6\u30fc (\u30de\u30c4\u30c0)",desc:"\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306eGVC+\u30b3\u30fc\u30ca\u30ea\u30f3\u30b0\u30c8\u30eb\u30af\u30d9\u30af\u30bf\u30ea\u30f3\u30b0\u30b0\u30e9\u30d5\u3092\u30a4\u30f3\u30d1\u30cd\u306b\u8868\u793a\u3057\u307e\u3059\u3002"},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP \u30d6\u30ec\u30fc\u30ad\u30a8\u30cd\u30eb\u30ae\u30fc\u56de\u751f\u30b3\u30f3\u30c7\u30f3\u30b5\u30fc\u30e1\u30fc\u30bf\u30fc (\u30de\u30c4\u30c0)",desc:"\u4e2d\u592e\u753b\u9762\u306b\u30b3\u30f3\u30c7\u30f3\u30b5\u306e\u5145\u653e\u96fb\u72b6\u614b\u3092\u8868\u793a\u3057\u307e\u3059\u3002"},mazda_smart_city_brake_sens:{name:"\u30b9\u30de\u30fc\u30c8\u30b7\u30c6\u30a3\u30d6\u30ec\u30fc\u30ad\u30b5\u30dd\u30fc\u30c8\uff08SCBS\uff09\u611f\u5ea6\uff08\u30de\u30c4\u30c0\uff09",desc:"\u4f4e\u901f\u81ea\u52d5\u7dca\u6025\u30d6\u30ec\u30fc\u30ad\u30bb\u30f3\u30b5\u30fc\u7bc4\u56f2\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},subaru_eyesight_distance_preset:{name:"\u30a2\u30a4\u30b5\u30a4\u30c8 \u30a2\u30c0\u30d7\u30c6\u30a3\u30d6 \u30af\u30eb\u30fc\u30ba \u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306e\u30c7\u30d5\u30a9\u30eb\u30c8\u8ddd\u96e2 (\u30b9\u30d0\u30eb)",desc:"\u8d77\u52d5\u6642\u306b\u30b9\u30c6\u30ec\u30aa \u30ab\u30e1\u30e9\u306e\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u30af\u30eb\u30fc\u30ba \u30ae\u30e3\u30c3\u30d7 \u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},subaru_xmode_auto_engage:{name:"X \u30e2\u30fc\u30c9 \u30aa\u30d5\u30ed\u30fc\u30c9 \u30c8\u30e9\u30af\u30b7\u30e7\u30f3\u81ea\u52d5\u30a8\u30f3\u30b2\u30fc\u30b8\u3057\u304d\u3044\u5024 (\u30b9\u30d0\u30eb)",desc:"\u30c7\u30e5\u30a2\u30eb\u6a5f\u80fd X \u30e2\u30fc\u30c9\u306e\u81ea\u52d5\u30a2\u30af\u30c6\u30a3\u30d9\u30fc\u30b7\u30e7\u30f3\u306e\u30db\u30a4\u30fc\u30eb \u30b9\u30ea\u30c3\u30d7\u3057\u304d\u3044\u5024\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},subaru_steering_responsive_headlights:{name:"\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u30ec\u30b9\u30dd\u30f3\u30b7\u30d6\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8 (SRH) \u30c8\u30b0\u30eb (\u30b9\u30d0\u30eb)",desc:"\u6307\u5411\u6027\u9069\u5fdc\u578b\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8 \u30b9\u30a4\u30d9\u30eb\u3092\u6709\u52b9\u307e\u305f\u306f\u7121\u52b9\u306b\u3057\u307e\u3059\u3002"},genesis_sport_plus_mode:{name:"Sport+ \u30d1\u30ef\u30fc\u30c8\u30ec\u30a4\u30f3 & \u96fb\u5b50\u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3 \u30e2\u30fc\u30c9 (\u30b8\u30a7\u30cd\u30b7\u30b9)",desc:"\u30c8\u30e9\u30c3\u30af\u6307\u5411\u306e ESC \u30aa\u30d5\u3068\u5f37\u5316\u3055\u308c\u305f\u30c0\u30f3\u30d1\u30fc \u30de\u30c3\u30d4\u30f3\u30b0\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3057\u307e\u3059\u3002"},genesis_ambient_active_light:{name:"\u30a2\u30af\u30c6\u30a3\u30d6\u30a2\u30f3\u30d3\u30a8\u30f3\u30c8\u7167\u660e\u30c9\u30e9\u30a4\u30d6\u30e2\u30fc\u30c9\u540c\u671f (Genesis)",desc:"\u30c9\u30e9\u30a4\u30d6\u30e2\u30fc\u30c9\u306b\u57fa\u3065\u3044\u3066\u5ba4\u5185\u74b0\u5883\u7167\u660e\u306e\u8272\u3092\u52d5\u7684\u306b\u5909\u66f4\u3057\u307e\u3059\u3002"},volvo_city_safety_warning:{name:"City Safety Autonomous Emergency Warning Sensitivity (Volvo)",desc:"\u30ec\u30fc\u30c0\u30fc\u3068\u30e9\u30a4\u30c0\u30fc\u306e\u885d\u7a81\u8b66\u544a\u306e\u8b66\u5831\u30bf\u30a4\u30df\u30f3\u30b0\uff08\u65e9\u671f/\u901a\u5e38\uff09\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},chery_ar_navigation_hud:{name:"HUD \u4e0a\u306e AR \u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u6295\u5f71\u30aa\u30fc\u30d0\u30fc\u30ec\u30a4 (Chery)",desc:"3D \u62e1\u5f35\u73fe\u5b9f\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u306e\u77e2\u5370\u3092\u30d5\u30ed\u30f3\u30c8\u30ac\u30e9\u30b9\u306b\u6295\u5f71\u3057\u307e\u3059\u3002"},jlr_terrain_response_preset:{name:"\u5730\u5f62\u5fdc\u7b54\u81ea\u52d5\u30aa\u30d5\u30ed\u30fc\u30c9\u30e2\u30fc\u30c9\u30d7\u30ea\u30bb\u30c3\u30c8 (JLR)",desc:"\u6700\u5f8c\u306e\u5730\u5f62\u5fdc\u7b54\u30b5\u30fc\u30d5\u30a7\u30b9 \u30d7\u30ed\u30d5\u30a1\u30a4\u30eb (\u8349/\u7802\u5229/\u96ea) \u3092\u8a18\u61b6\u3057\u307e\u3059\u3002"},jlr_adaptive_dynamics_firm:{name:"\u30a2\u30c0\u30d7\u30c6\u30a3\u30d6 \u30c0\u30a4\u30ca\u30df\u30af\u30b9 \u30c0\u30f3\u30d1\u30fc\u786c\u5ea6\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb (JLR)",desc:"\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u96fb\u5b50\u30b7\u30e7\u30c3\u30af\u30a2\u30d6\u30bd\u30fc\u30d0\u30fc\u306e\u30c0\u30f3\u30d4\u30f3\u30b0\u525b\u6027\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},jlr_wading_sensor_alert:{name:"\u30a6\u30a7\u30a4\u30c9\u611f\u77e5\u6df1\u5ea6\u8b66\u544a\u30c1\u30e3\u30a4\u30e0\u3057\u304d\u3044\u5024 (JLR)",desc:"\u8d85\u97f3\u6ce2\u6c34\u6df1\u8b66\u5831\u30c1\u30e3\u30a4\u30e0\u306e\u611f\u5ea6\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},alfa_dna_dynamic_memory:{name:"Alfa DNA \u30bb\u30ec\u30af\u30bf\u30fc \u30c0\u30a4\u30ca\u30df\u30c3\u30af \u30e2\u30fc\u30c9 \u30b9\u30bf\u30fc\u30c8\u30a2\u30c3\u30d7 \u30e1\u30e2\u30ea (Alfa Romeo)",desc:"\u518d\u59cb\u52d5\u5f8c\u3082\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u30e2\u30fc\u30c9\u306e\u30b9\u30ed\u30c3\u30c8\u30eb\u5fdc\u7b54\u3092\u7dad\u6301\u3057\u307e\u3059\u3002"},alfa_q4_torque_split:{name:"Q4 \u5168\u8f2a\u99c6\u52d5\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u30c8\u30eb\u30af\u5206\u5272\u30b0\u30e9\u30d5 (Alfa Romeo)",desc:"AWD\u306e\u30d5\u30ed\u30f3\u30c8/\u30ea\u30a2\u306e\u30d1\u30ef\u30fc\u5206\u5272\u7387\u3092\u8a08\u5668\u30c7\u30a3\u30b9\u30d7\u30ec\u30a4\u306b\u8868\u793a\u3057\u307e\u3059\u3002"},li_auto_range_extender_mode:{name:"REV \u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u30fc\u306e\u30d0\u30c3\u30c6\u30ea\u30fc\u5145\u96fb\u4fdd\u6301\u30ec\u30d9\u30eb (Li Auto)",desc:"\u5185\u71c3\u6a5f\u95a2\u767a\u96fb\u6a5f\u306e\u59cb\u52d5\u95be\u5024\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"},li_auto_cinema_seat_position:{name:"\u30b7\u30a2\u30bf\u30fc/\u30b7\u30cd\u30de\u30e2\u30fc\u30c9\u4eba\u9593\u5de5\u5b66\u306b\u57fa\u3065\u3044\u305f\u30b7\u30fc\u30c8\u30dd\u30b8\u30b7\u30e7\u30f3 (Li Auto)",desc:"\u30b7\u30cd\u30de\u30e2\u30fc\u30c9\u304c\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u3068\u304d\u306f\u3001\u5f8c\u90e8\u5ea7\u5e2d\u3092\u30ea\u30af\u30e9\u30a4\u30cb\u30f3\u30b0\u3055\u305b\u3001\u30ec\u30c3\u30b0\u30ec\u30b9\u30c8\u3092\u5c55\u958b\u3057\u307e\u3059\u3002"},zeekr_drift_mode_torque:{name:"\u30c7\u30e5\u30a2\u30eb\u30e2\u30fc\u30bf\u30fc\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30c9\u30ea\u30d5\u30c8\u30e2\u30fc\u30c9\u30ea\u30a2\u30d0\u30a4\u30a2\u30b9 (Zeekr)",desc:"100%\u306e\u30c8\u30eb\u30af\u3092\u30ea\u30a2\u306e\u96fb\u6c17\u30e2\u30fc\u30bf\u30fc\u306b\u9001\u308a\u3001\u5236\u5fa1\u3055\u308c\u305f\u30c9\u30ea\u30d5\u30c8\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002"},zeekr_ambient_beat_sync:{name:"\u30a2\u30f3\u30d3\u30a8\u30f3\u30c8\u7167\u660e \u97f3\u697d \u30ea\u30ba\u30e0 \u30d3\u30fc\u30c8\u540c\u671f (Zeekr)",desc:"\u518d\u751f\u3055\u308c\u308b\u97f3\u697d\u306e\u30d3\u30fc\u30c8\u306b\u540c\u671f\u3057\u3066\u3001\u5ba4\u5185\u306e\u30ad\u30e3\u30d3\u30f3\u7167\u660e\u304c\u8108\u52d5\u3057\u307e\u3059\u3002"},tata_drive_mode_voice:{name:"\u30c9\u30e9\u30a4\u30d6\u30e2\u30fc\u30c9\u30b9\u30a4\u30c3\u30c1\u306e\u97f3\u58f0\u30a2\u30ca\u30a6\u30f3\u30b9\uff08Tata\uff09",desc:"\u30c9\u30e9\u30a4\u30d6\u30e2\u30fc\u30c9(\u30b7\u30c6\u30a3/\u30b9\u30dd\u30fc\u30c4/\u30a8\u30b3)\u5207\u308a\u66ff\u3048\u6642\u306b\u97f3\u58f0\u3067\u78ba\u8a8d\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"},mahindra_zip_zap_zoom_custom:{name:"Zip/Zap/Zoom \u30d1\u30ef\u30fc\u30c8\u30ec\u30a4\u30f3 \u30b9\u30ed\u30c3\u30c8\u30eb\u5fdc\u7b54\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb (Mahindra)",desc:"Zip\u3001Zap\u3001Zoom \u306e\u904b\u8ee2\u30e2\u30fc\u30c9\u306e\u52a0\u901f\u66f2\u7dda\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002"},fun_cyberpunk_cluster_theme:{name:"\u30b5\u30a4\u30d0\u30fc\u30d1\u30f3\u30af 2077 \u30cd\u30aa\u30f3 \u30b0\u30e9\u30d5\u30a3\u30c3\u30af \u30b3\u30c3\u30af\u30d4\u30c3\u30c8 \u30c6\u30fc\u30de",desc:"\u672a\u6765\u7684\u306a\u30cd\u30aa\u30f3\u30b7\u30a2\u30f3\u3068\u30a2\u30f3\u30d0\u30fc\u306e\u30c7\u30b8\u30bf\u30eb\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u30b2\u30fc\u30b8\u30b9\u30bf\u30a4\u30eb\u3092\u9069\u7528\u3057\u307e\u3059\u3002"},fun_exhaust_flame_sound_effect:{name:"\u30b9\u30c6\u30ec\u30aa\u30b7\u30b9\u30c6\u30e0\u30dd\u30c3\u30d7\uff06\u30d0\u30f3\u6392\u6c17\u97f3FX",desc:"\u30ad\u30e3\u30d3\u30f3\u30b9\u30d4\u30fc\u30ab\u30fc\u304b\u3089\u30ea\u30a2\u30eb\u306a V8 \u30a8\u30ad\u30be\u30fc\u30b9\u30c8\u306e\u30dd\u30c3\u30d7\uff06\u30d0\u30f3\u30aa\u30fc\u30c7\u30a3\u30aa\u52b9\u679c\u3092\u518d\u751f\u3057\u307e\u3059\u3002"},fun_matrix_light_show_welcome:{name:"\u30ab\u30b9\u30bf\u30e0 \u30d8\u30c3\u30c9\u30e9\u30a4\u30c8 \u30de\u30c8\u30ea\u30c3\u30af\u30b9 LED \u30c0\u30f3\u30b9 \u30a6\u30a7\u30eb\u30ab\u30e0",desc:"\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u3068\u30a4\u30f3\u30b8\u30b1\u30fc\u30bf\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ea\u30ba\u30df\u30ab\u30eb\u306a\u30e9\u30a4\u30c8 \u30b7\u30e7\u30fc\u306e\u632f\u308a\u4ed8\u3051\u3092\u518d\u751f\u3057\u307e\u3059\u3002"},fun_stealth_fighter_display:{name:"\u30b9\u30c6\u30eb\u30b9\u6226\u95d8\u6a5f\u591c\u9593\u8d70\u884c\u30df\u30cb\u30de\u30ea\u30b9\u30c8\u30af\u30e9\u30b9\u30bf\u30fc\u30e2\u30fc\u30c9",desc:"\u771f\u3063\u6697\u306a\u591c\u9593\u8d70\u884c\u6642\u306b\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u30e1\u30fc\u30bf\u30fc\u3092\u9664\u304f\u3059\u3079\u3066\u306e\u30af\u30e9\u30b9\u30bf\u30fc\u30e9\u30a4\u30c8\u3092\u6d88\u706f\u3057\u307e\u3059\u3002"},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{name:"Retarder & Jake Brake Downshift Aggressiveness",desc:"Adjusts retarder torque blending curve and automatic transmission downshifting response under braking."},man_ecas_dock_level_memory:{name:"ECAS Air Suspension Loading Dock Height Memory",desc:"Stores and recalls customized pneumatic air suspension height level presets for loading docks."},daf_stationary_dpf_regen_trigger:{name:"Stationary DPF Forced Soot Regeneration",desc:"Initiates stationary diesel particulate filter thermal soot burn routine in parked position."},ford_trucks_reverse_buzzer_night_mode:{name:"Reverse Acoustic Alarm Night Quiet Mode",desc:"Attenuates reverse backup horn alarm volume for quiet night distribution in residential areas."},cummins_ecm_fleet_speed_limiter:{name:"Cummins Engine Road Speed Limiter (RSL)",desc:"Programs maximum allowable road vehicle speed in Cummins ECM parameter tables."}},codeBtn:"\u30b3\u30fc\u30c7\u30a3\u30f3\u30b0",removeBtn:"\u524a\u9664",unsupportedTitle:"\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u306a\u3044