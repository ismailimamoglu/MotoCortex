27\u0631\u0629."},bmw_launch_control_unlock:{name:"\u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0642\u0641\u0644",desc:"\u064a\u0641\u062a\u062d \u0628\u0631\u0646\u0627\u0645\u062c \u062a\u0633\u0631\u064a\u0639 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0645\u0635\u0646\u0639 \u0641\u064a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629."},mercedes_ambient_64_multi_zone:{name:"\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0645\u062d\u064a\u0637\u064a \u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0628\u0640 64 \u0644\u0648\u0646\u064b\u0627",desc:"\u064a\u0641\u062a\u062d \u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629 \u0644\u062f\u0648\u0631\u0629 \u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0641\u064a \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0644\u0646\u0638\u0627\u0645 MBUX."},ford_trailer_brake_activation:{name:"\u062a\u0645\u0643\u064a\u0646 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0645\u0642\u0637\u0648\u0631\u0629 (TBC).",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0645\u0642\u0637\u0648\u0631\u0629 \u0627\u0644\u0645\u062f\u0645\u062c\u0629 \u0641\u064a \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a."},gm_afm_dfm_cylinder_deactivation_disable:{name:"\u0642\u0641\u0644 \u0623\u0633\u0637\u0648\u062