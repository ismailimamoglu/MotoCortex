uae30 \uc791\uc5c5 \uc911 \ucc28\ub7c9\uc744 \uc190\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc73c\ubbc0\ub85c \ucf54\ub529 \ubc0f \uc801\uc751 \uae30\ub2a5\uc774 \uc7a0\uacbc\uc2b5\ub2c8\ub2e4. \uc548\uc804\ud55c \ucf54\ub529\uc744 \uc704\ud574 \uc815\ud488 ELM327 v2.1 \ub610\ub294 vLinker \uc7a5\uce58\ub97c \uad6c\uc785\ud558\uc138\uc694.",vehiclePids:"\ucc28\ub7c9 \uc13c\uc11c \uccb4\ud06c\ub9ac\uc2a4\ud2b8",checklistPrompt:"\ucc28\ub7c9 ECU\uc5d0\uc11c \uc9c0\uc6d0\ud558\ub294 \ud45c\uc900 \uc13c\uc11c \ub9e4\uac1c\ubcc0\uc218(PID)\uac00 \uc544\ub798\uc5d0 \ub098\uc5f4\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uccb4\ud06c \ud45c\uc2dc\uac00 \uc5c6\ub294 \uc13c\uc11c\ub294 \ucc28\ub7c9\uc5d0\uc11c \ubcf4\uace0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",supportedBadge:" \uc9c0\uc6d0\ub428",unsupportedBadge:" \uc9c0\uc6d0 \uc548 \ub428"},sensor:{oilTemp:"\uc5d4\uc9c4 \uc624\uc77c \uc628\ub3c4",boost:"\ud130\ubcf4 \ubd80\uc2a4\ud2b8 \uc555\ub825",widebandAfr:"\uad11\ub300\uc5ed O2 / AFR \ube44\uc728",transTemp:"\uc804\uc1a1 \uc628\ub3c4",catalystTemp:"\ucd09\ub9e4 \uc628\ub3c4",ethanol:"\uc5d0\ud0c4\uc62c \uc5f0\ub8cc %",timingAdvance:"\uc810\ud654 \ud0c0\uc774\ubc0d \uc5b4\ub4dc\ubc34\uc2a4",baro:"\uae30\uc555",rpm:"\uc5d4\uc9c4 RPM",speed:"\ucc28\ub7c9 \uc18d\ub3c4",coolant:"\ub0c9\uac01\uc218 \uc628\ub3c4",throttle:"\uc2a4\ub85c\ud2c0 \uc704\uce58",voltage:"\uc81c\uc5b4 \ubaa8\ub4c8 \uc804\uc555",maf:"MAF \uacf5\uae30 \uc720\ub7c9",iat:"\ud761\uae30 \uc628\ub3c4",load:"\uacc4\uc0b0\ub41c \uc5d4\uc9c4 \ubd80\ud558",fuel:"\uc5f0\ub8cc \uc218\uc900"},secretDebug:{title:"MOTO CORTEX \uac1c\ubc1c \ud328\ub110",logFileSize:"\ube14\ub799\ubc15\uc2a4/\ud30c\uc77c \ud06c\uae30:",dtcCloudSync:" DTC \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654",lastSync:"\ub9c8\uc9c0\ub9c9 \ub3d9\uae30\ud654",syncNow:"\uc9c0\uae08 \ub3d9\uae30\ud654",developerTools:"\uac1c\ubc1c\uc790 \ub3c4\uad6c",trialResetSuccess:"\ubb34\ub8cc \ud3c9\uac00\ud310 \uce74\uc6b4\ud130\uac00 \uc7ac\uc124\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4!",crashTestTitle:"\ucda9\ub3cc \ud14c\uc2a4\ud2b8",crashTestDesc:"\uc774\uc81c \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc774 \uc758\ub3c4\uc801\uc73c\ub85c \ucda9\ub3cc\ud569\ub2c8\ub2e4. Crashlytics \ud1b5\ud569\uc744 \ud655\uc778\ud558\ub824\uba74 \ud655\uc778\ud558\uc138\uc694.",crashButton:"\ucda9\ub3cc",crashTest:"\ucda9\ub3cc \ud14c\uc2a4\ud2b8"},features:{title:"\uc228\uaca8\uc9c4 \uae30\ub2a5 \ud574\uc81c & UDS \ucf54\ub529",subTitle:"ISO 14229 UDS \ub871 \ucf54\ub529 & \uc5b4\ub311\ud14c\uc774\uc158 \uc5d4\uc9c4",batteryVoltage:"\ubc30\ud130\ub9ac \uc804\uc555",voltageReady:" \uc548\uc804 (ECU \ucf54\ub529 \uc4f0\uae30 \uc900\ube44 \uc644\ub8cc)",voltageLocked:" \uc800\uc804\uc555 (\ucf54\ub529 \uc7a0\uae40)",locked:"\uc7a0\uae40",ready:"\uc900\ube44\ub428",allMarks:"\ubaa8\ub4e0 \ub9c8\ud06c",writeBtn:"\uc4f0\uae30",catLighting:"\uc870\uba85",catSound:"\uc18c\ub9ac \ubc0f \uc54c\ub9bc",catDisplay:"\uc545\uae30",catComfort:"\ud3b8\uc548\ud568",catSafety:"\uc548\uc804",safetyAlertTitle:" \ubc30\ud130\ub9ac \uc804\uc555 \ubd80\uc871 \uacbd\uace0",safetyAlertMsg:"\ucf54\ub529\uc5d0\ub294 \ucd5c\uc18c 12.2V \ubc30\ud130\ub9ac \uc804\uc555\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\n\ucda9\uc804\uae30\ub97c \uc5f0\uacb0\ud558\uac70\ub098 \uc2dc\ub3d9\uc744 \uac78\uc5b4\uc8fc\uc138\uc694.",items:{vag_staging_needle_sweep:{name:"\uac8c\uc774\uc9c0 \uc2a4\ud14c\uc774\uc9d5/\ub2c8\ub4e4 \uc2a4\uc715",desc:"\uc810\ud654 \uc2dc\uc791 \uc2dc \uae30\uad6c \ubc14\ub298\uc744 \ucd5c\ub300\ub85c \uc4f8\uc5b4\ub0c5\ub2c8\ub2e4."},vag_acoustic_lock_confirmation:{name:"\uc74c\ud5a5 \uc7a0\uae08 \ud655\uc778 \uc18c\ub9ac",desc:"\uc804\uc790\uc5f4\uc1e0\uac00 \uc7a0\uae38 \ub54c \uc9e7\uc740 \uacbd\uc801 \ud655\uc778 \uc18c\ub9ac\ub97c \ub0c5\ub2c8\ub2e4."},vag_american_parking_lights:{name:"\ubbf8\uad6d\uc2dd \uc8fc\ucc28\ub4f1",desc:"\uc8fc\ucc28\ub4f1\uc744 \uc0ac\uc6a9\ud558\uba74 20% \ubc1d\uae30\ub85c \uc804\ubc29 \ubc29\ud5a5\uc9c0\uc2dc\ub4f1\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \ubc1d\ud799\ub2c8\ub2e4."},vag_drl_menu_toggle:{name:"\uc8fc\uac04 \uc8fc\ud589\ub4f1(DRL) \uba54\ub274 \ud1a0\uae00",desc:"\uc778\ud3ec\ud14c\uc778\uba3c\ud2b8 \ucc28\ub7c9 \uc124\uc815 \uba54\ub274\uc5d0\uc11c DRL ON/OFF \uccb4\ud06c\ubc15\uc2a4\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},vag_tear_wiping:{name:"\uc55e\uc720\ub9ac \ucc22\uc5b4\uc9d0 \ub2e6\uae30",desc:"\uc55e\uc720\ub9ac \uc6cc\uc154 \uc0ac\uc6a9 \ud6c4 5\ucd08 \ud6c4\uc5d0 \ucd94\uac00 \ucd5c\uc885 \ub2e6\uae30\ub97c \uc2e4\ud589\ud569\ub2c8\ub2e4."},vag_emergency_brake_flashing:{name:"\ube44\uc0c1 \ube0c\ub808\uc774\ud06c \uc704\ud5d8 \uc810\uba78",desc:"\uae09\uc81c\ub3d9 \uc2dc \ube0c\ub808\uc774\ud06c\ub4f1\uacfc \uc704\ud5d8 \uc694\uc18c\ub97c \ube60\ub974\uac8c \uae5c\ubc15\uc785\ub2c8\ub2e4."},vag_cornering_lights:{name:"\ucf54\ub108\ub9c1 \uc548\uac1c\ub4f1",desc:"\uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \ud68c\uc804 \uce21\uc5d0 \ucf54\ub108\ub9c1 \uc548\uac1c\ub4f1\uc774 \ucf1c\uc9d1\ub2c8\ub2e4."},vag_comfort_mirror_folding:{name:"\uc804\uc790\uc5f4\uc1e0 \ucef4\ud3ec\ud2b8 \ubbf8\ub7ec \uc811\uc774\uc2dd",desc:"\uc804\uc790\uc5f4\uc1e0\uc758 \uc7a0\uae08 \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uc0ac\uc774\ub4dc \ubbf8\ub7ec\uac00 \uc790\ub3d9\uc73c\ub85c \uc811\ud799\ub2c8\ub2e4."},vag_lap_timer:{name:"\uacc4\uae30\ud310 \ub7a9 \ud0c0\uc774\uba38",desc:"\uacc4\uae30\ud310 \ud654\uba74\uc5d0\uc11c \ud2b8\ub799 \ub7a9 \ud0c0\uc774\uba38 \ud45c\uc2dc \ud0ed\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},vag_refuel_quantity:{name:"\uc7ac\uae09\uc720\ub7c9 \ud45c\uc2dc",desc:"\uc5f0\ub8cc\ub97c \uac00\ub4dd \ucc44\uc6b0\ub294 \ub370 \ud544\uc694\ud55c \uc815\ud655\ud55c \uc591\uc744 \ub9ac\ud130 \ub2e8\uc704\ub85c \ud45c\uc2dc\ud569\ub2c8\ub2e4."},bmw_start_stop_memory:{name:"\uc790\ub3d9 \uc2dc\uc791-\uc815\uc9c0 \uba54\ubaa8\ub9ac \ubaa8\ub4dc",desc:"\ucc28\ub7c9 \uc7ac\uc2dc\uc791 \uc2dc \ub9c8\uc9c0\ub9c9 \uc790\ub3d9 Start-Stop \uc0c1\ud0dc(OFF/ON)\ub97c \uae30\uc5b5\ud569\ub2c8\ub2e4."},bmw_digital_speedometer:{name:"\ub514\uc9c0\ud138 \uc18d\ub3c4\uacc4 \ub514\uc2a4\ud50c\ub808\uc774",desc:"\ud074\ub7ec\uc2a4\ud130 \ud654\uba74\uc5d0 \uc989\uac01\uc801\uc778 \ub514\uc9c0\ud138 \uc18d\ub3c4 \uc218\uce58 \ud45c\uc2dc \uc635\uc158\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4."},bmw_sport_displays:{name:"\uc2a4\ud3ec\uce20 \ub514\uc2a4\ud50c\ub808\uc774(HP \ubc0f Nm \uac8c\uc774\uc9c0)",desc:"iDrive \ud654\uba74\uc5d0\uc11c \uc2e4\uc2dc\uac04 \ub9c8\ub825 \ubc0f \ud1a0\ud06c \ub3d9\uc801 \ub2e4\uc774\uc5bc\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},bmw_acoustic_lock_sound:{name:"\uc74c\ud5a5 \uc7a0\uae08/\uc7a0\uae08 \ud574\uc81c \uc18c\ub9ac",desc:"\ucc28\ub7c9\uc744 \uc7a0\uadf8\uac70\ub098 \uc7a0\uae08 \ud574\uc81c\ud560 \ub54c \uacbd\ubcf4 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \uacbd\uace0\uc74c\uc774 \uc6b8\ub9bd\ub2c8\ub2e4."},bmw_mirror_fold_delay_zero:{name:"\uc778\uc2a4\ud134\ud2b8 \ubbf8\ub7ec \ud3f4\ub529(0.0\ucd08 \uc9c0\uc5f0)",desc:"\uc7a0\uae08 \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uc9c0\uccb4 \uc5c6\uc774 \uc989\uc2dc \uc0ac\uc774\ub4dc \ubbf8\ub7ec\ub97c \uc811\uc2b5\ub2c8\ub2e4."},bmw_tpms_tire_temperature:{name:"\ud0c0\uc774\uc5b4 \uacf5\uae30\uc555 \ubc0f \uc628\ub3c4 \ud45c\uc2dc",desc:"TPMS \ud654\uba74\uc5d0 \uacf5\uae30\uc555\uacfc \ud568\uaed8 \uc2e4\uc2dc\uac04 \ud0c0\uc774\uc5b4 \uc628\ub3c4\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4."},renault_trip_computer_enable:{name:"\uc628\ubcf4\ub4dc \ud2b8\ub9bd \ucef4\ud4e8\ud130 \ud65c\uc131\ud654",desc:"\ud3c9\uade0 \uc5f0\ub8cc \uc18c\ube44\ub7c9 \ubc0f \uc8fc\ud589 \uac70\ub9ac \ucef4\ud4e8\ud130 \ub514\uc2a4\ud50c\ub808\uc774\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},renault_external_temp_display:{name:"\uc678\ubd80 \uc628\ub3c4 \ud45c\uc2dc",desc:"\uacc4\uae30\ud310\uc5d0\uc11c \uc8fc\ubcc0 \uc2e4\uc678 \uc628\ub3c4 \ud310\ub3c5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},renault_automatic_tailgate:{name:"\uc5f4\uc1e0\uace0\ub9ac \ud2b8\ub801\ud06c \ucd9c\uc2dc",desc:"\uc804\uc790\uc5f4\uc1e0 \ud2b8\ub801\ud06c \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \ud2b8\ub801\ud06c \ub798\uce58 \uba54\ucee4\ub2c8\uc998\uc774 \uc644\uc804\ud788 \uc5f4\ub9bd\ub2c8\ub2e4."},renault_alarm_chirp:{name:"\uc54c\ub78c \uc7a0\uae08 \ud655\uc778 \uc18c\ub9ac",desc:"\ucc28\ub7c9 \ub3c4\uc5b4 \uc7a0\uae08 \uc2dc \uacbd\uc801 \ud655\uc778 \uc18c\ub9ac\uac00 \uc6b8\ub9bd\ub2c8\ub2e4."},renault_shift_indicator:{name:"\uae30\uc5b4 \ubcc0\uc18d \ud45c\uc2dc\uae30(GSI)",desc:"\uacc4\uae30\ud310\uc758 \uc5d0\ucf54 \ub4dc\ub77c\uc774\ube59 \ubcc0\uc18d UP/DOWN \ud654\uc0b4\ud45c\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ford_double_horn_honk_disable:{name:"\ubb38 \ub2eb\ud798 \uc2dc \uc774\uc911 \uacbd\uc801 \uacbd\uc801 \ube44\ud65c\uc131\ud654",desc:"\uc5d4\uc9c4\uc774 \uc791\ub3d9 \uc911\uc778 \uc0c1\ud0dc\uc5d0\uc11c \ub3c4\uc5b4\ub97c \ub2eb\uc744 \ub54c \uc774\uc911 \uacbd\uc801 \uacbd\uc801\uc744 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ford_auto_door_locking:{name:"20km/h \uc18d\ub3c4\uc5d0\uc11c \uc790\ub3d9 \ub3c4\uc5b4 \uc7a0\uae08",desc:"\ucc28\ub7c9 \uc18d\ub3c4\uac00 20km/h\ub97c \ucd08\uacfc\ud558\uba74 \ubaa8\ub4e0 \ub3c4\uc5b4\uac00 \uc790\ub3d9\uc73c\ub85c \uc7a0\uae41\ub2c8\ub2e4."},ford_tpms_psi_display:{name:"\uc22b\uc790 \ud0c0\uc774\uc5b4 \uacf5\uae30\uc555 \ud45c\uc2dc",desc:"\uacc4\uae30\ud310\uc5d0 \ud0c0\uc774\uc5b4\ub2f9 \uc815\ud655\ud55c PSI/BAR \uc555\ub825 \uc218\uce58\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4."},ford_sync_climate_screen:{name:"SYNC \ud654\uba74 \uc628\ub3c4 \uc870\uc808 \uc7a5\uce58",desc:"SYNC \ub514\uc2a4\ud50c\ub808\uc774\uc5d0 \uc628\ub3c4 \uc870\uc808 \ubc0f \uc2dc\ud2b8 \ub09c\ubc29 \ud130\uce58\uc2a4\ud06c\ub9b0 \uba54\ub274\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4."},stellantis_power_windows_remote:{name:"\uc804\uc790\uc5f4\uc1e0 \uc6d0\uaca9 \ucc3d \ub864\uc5c5/\ub2e4\uc6b4",desc:"\uc7a0\uae08/\uc7a0\uae08 \ud574\uc81c \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uc788\uc73c\uba74 \ubaa8\ub4e0 \ud30c\uc6cc \uc708\ub3c4\uc6b0\uac00 \uc62c\ub77c\uac00\uac70\ub098 \ub0b4\ub824\uac11\ub2c8\ub2e4."},stellantis_cornering_fogs:{name:"\ucf54\ub108\ub9c1 \uc548\uac1c\ub4f1 \ud65c\uc131\ud654",desc:"\uc800\uc18d \ud68c\uc804 \uc2dc \ucf54\ub108\ub9c1 \uc548\uac1c\ub4f1\uc774 \ucf1c\uc9d1\ub2c8\ub2e4."},vag_traffic_sign_recognition:{name:"\uad50\ud1b5\ud45c\uc9c0\ud310 \uc778\uc2dd(VZE)",desc:"\uce74\uba54\ub77c\uac00 \uac10\uc9c0\ud55c \uc18d\ub3c4 \ud45c\uc9c0\ud310\uc744 \uacc4\uae30\ud310\uacfc HUD\uc5d0 \ud45c\uc2dc\ud569\ub2c8\ub2e4."},vag_ambient_color_palette_30:{name:"30\uac00\uc9c0 \uc0c9\uc0c1 \uc8fc\ubcc0 \uc870\uba85 \ud314\ub808\ud2b8",desc:"MIB \uc778\ud3ec\ud14c\uc778\uba3c\ud2b8 \uba54\ub274\uc5d0\uc11c 30\uac1c\uc758 RGB \uc2e4\ub0b4 \uc870\uba85 \uc0c9\uc0c1 \uc120\ud0dd\uae30\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},vag_seatbelt_warning_mute:{name:"\uc548\uc804\ubca8\ud2b8 \ucc28\uc784\ubca8 \ube44\ud65c\uc131\ud654",desc:"\uacc4\uae30\ud310\uc758 \ubc84\ud074\uc774 \ud480\ub9b0 \uc548\uc804\ubca8\ud2b8 \uc74c\ud5a5 \ucc28\uc784\ubca8\uc744 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},bmw_alpina_cluster_theme:{name:"\uc54c\ud53c\ub098 \ub514\uc9c0\ud138 \ub300\uc2dc \ub808\uc774\uc544\uc6c3",desc:"\ub514\uc9c0\ud138 \uacc4\uae30\ud310\uc5d0 \ube14\ub8e8 \uc54c\ud53c\ub098 \uc2dc\uadf8\ub2c8\ucc98 \ud14c\ub9c8\ub97c \uc801\uc6a9\ud588\uc2b5\ub2c8\ub2e4."},bmw_video_in_motion:{name:"VIM(\ube44\ub514\uc624 \uc778 \ubaa8\uc158)",desc:"\uc6b4\uc804 \uc911 iDrive \ud654\uba74\uc5d0\uc11c USB \ube44\ub514\uc624 \uc7ac\uc0dd\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},bmw_sport_plus_mode_unlock:{name:"\uc2a4\ud3ec\uce20+ \uc6b4\uc804 \ubaa8\ub4dc \ud65c\uc131\ud654",desc:"DEC \uc120\ud0dd\uae30\uc5d0\uc11c Sport+ \uace0\uc131\ub2a5 \ub2e4\uc774\ub0b4\ubbf9 \uc8fc\ud589 \ubaa8\ub4dc\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},mercedes_amg_menu_unlock:{name:"AMG \uc131\ub2a5 \uc6d0\uaca9 \uce21\uc815 \uba54\ub274",desc:"AMG \uc624\uc77c \uc628\ub3c4, \ubcc0\uc18d\uae30 \uc628\ub3c4, \ub7a9 \ud0c0\uc774\uba38 \ubc0f G-\ubbf8\ud130\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4."},mercedes_agility_mode_enable:{name:"\ubbfc\ucca9\uc131(A) \uc804\uc1a1 \ubaa8\ub4dc",desc:"7G/9G-Tronic \ubcc0\uc18d\uae30\uc5d0\uc11c \ub9e4\uc6b0 \ubc18\uc751\uc131\uc774 \ub6f0\uc5b4\ub09c \ubbfc\ucca9\uc131 \ubcc0\uc18d \ud504\ub85c\uadf8\ub7a8\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},mercedes_drl_brightness_boost:{name:"\uc8fc\uac04 \uc8fc\ud589\ub4f1 \uac15\ub3c4 100%",desc:"LED \uc8fc\uac04 \uc8fc\ud589\ub4f1 \ucd9c\ub825\uc744 100% \ucd5c\ub300 \ubc1d\uae30\ub85c \ub192\uc785\ub2c8\ub2e4."},mercedes_alarm_lock_chirp:{name:"\uc74c\ud5a5 \uc7a0\uae08 \uacbd\uc801 \ucc98\ud504",desc:"\uc911\uc559 \uc7a0\uae08\uc774 \ud65c\uc131\ud654\ub418\uba74 \uc9e7\uc740 \uacbd\uc801 \uc18c\ub9ac \uc54c\ub9bc\uc774 \uc6b8\ub9bd\ub2c8\ub2e4."},mercedes_dpf_adblue_gauge:{name:"DPF \uadf8\uc744\uc74c \ubc0f AdBlue \ub808\ubca8 \uac8c\uc774\uc9c0",desc:"IC\uc758 \uc815\ud655\ud55c DPF \uadf8\uc744\uc74c \uc9c8\ub7c9 \ube44\uc728\uacfc \ub098\uba38\uc9c0 AdBlue \ubc94\uc704\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4."},renault_rs_monitor_enable:{name:"\ub974\ub178 \uc2a4\ud3ec\uce20 RS \ubaa8\ub2c8\ud130 \uc6d0\uaca9 \uce21\uc815",desc:"R-Link\uc5d0\uc11c \uc2e4\uc2dc\uac04 G-force, \ud130\ubcf4 \ubd80\uc2a4\ud2b8 \ubc0f \uc624\uc77c \uc628\ub3c4 \uc6d0\uaca9 \uce21\uc815\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},renault_duster_mirror_fold:{name:"\uba3c\uc9c0 \ub5a8\uc774 \uc790\ub3d9 \uac70\uc6b8 \uc811\uc774\uc2dd \uc7a0\uae08 \uc7a5\uce58",desc:"BCM \uc911\uc559 \uc7a0\uae08 \uba85\ub839\uc744 \ud1b5\ud574 \uc0ac\uc774\ub4dc \ubbf8\ub7ec\ub97c \uc790\ub3d9\uc73c\ub85c \uc811\uc2b5\ub2c8\ub2e4."},ford_bambi_mode_fog_light:{name:"\ubc24\ube44 \ubaa8\ub4dc(\ud558\uc774\ube54 + \uc548\uac1c\ub4f1)",desc:"\ud558\uc774\ube54 \ud5e4\ub4dc\ub77c\uc774\ud2b8\uac00 \ud65c\uc131\ud654\ub418\uba74 \uc548\uac1c\ub4f1\uc774 \ucf1c\uc9c4 \uc0c1\ud0dc\ub