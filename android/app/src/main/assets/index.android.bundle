3c3\u03b9\u03ba\u03bb\u03ad\u03c4\u03b1",heavyDutyTruck:"\u0392\u03b1\u03c1\u03ad\u03b1 \u039f\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1 & \u03a6\u03bf\u03c1\u03c4\u03b7\u03b3\u03ac",statusReadingVin:"Ara\xe7 \u015easi Numaras\u0131 (VIN) Okunuyor & Profil Olu\u015fturuluyor...",selectCategory:"\u0395\u03a0\u0399\u039b\u039f\u0393\u0397 \u039a\u0391\u03a4\u0397\u0393\u039f\u03a1\u0399\u0391\u03a3 \u039f\u03a7\u0397\u039c\u0391\u03a4\u039f\u03a3",statusConnected:"ECU \u0130leti\u015fimi Ba\u015far\u0131yla Kuruldu",statusAdaptingHardware:"Adapt\xf6r Ba\u011flant\u0131s\u0131 ve Donan\u0131m Skoru Do\u011frulan\u0131yor...",passengerCar:"\u0395\u03c0\u03b9\u03b2\u03b1\u03c4\u03b9\u03ba\u03ac & \u0395\u03bb\u03b1\u03c6\u03c1\u03ac \u0395\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac",changeCategory:"\u0391\u03bb\u03bb\u03b1\u03b3\u03ae \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1\u03c2",passengerCarDesc:"12V \u0395\u03c0\u03b9\u03b2\u03b1\u03c4\u03b9\u03ba\u03ac & \u0395\u03bb\u03b1\u03c6\u03c1\u03ac \u0395\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u039f\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1 (OBD2 / CAN / KWP)",motorcycleDesc:"\u03a4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1 \u03bc\u03bf\u03c4\u03bf\u03c3\u03b9\u03ba\u03bb\u03b5\u03c4\u03ce\u03bd Euro 5 & \u03c5\u03c8\u03b7\u03bb\u03ce\u03bd \u03c3\u03c4\u03c1\u03bf\u03c6\u03ce\u03bd",heavyDutyTruckDesc:"24V \u0395\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u0392\u03b1\u03c1\u03ad\u03b1 \u039f\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1, \u03a6\u03bf\u03c1\u03c4\u03b7\u03b3\u03ac & \u039b\u03b5\u03c9\u03c6\u03bf\u03c1\u03b5\u03af\u03b1 (SAE J1939)",ignitionWarningTitle:"\u0395\u039b\u0395\u0393\u03a7\u039f\u03a3 \u0394\u0399\u0391\u039a\u039f\u03a0\u03a4\u0397 (IGNITION ON)",ignitionWarningDesc:"\u039f \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1\u03c2 ELM327 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03c5\u03bd\u03b4\u03b5\u03b4\u03b5\u03bc\u03ad\u03bd\u03bf\u03c2, \u03b1\u03bb\u03bb\u03ac \u03bf \u03b5\u03b3\u03ba\u03ad\u03c6\u03b1\u03bb\u03bf\u03c2 (ECU) \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03ba\u03c1\u03af\u03bd\u03b5\u03c4\u03b1\u03b9. \u0393\u03c5\u03c1\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7 \u03c3\u03c4\u03bf ON \u03ae \u03b5\u03ba\u03ba\u03b9\u03bd\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03c4\u03b5 \u03be\u03b1\u03bd\u03ac.",goToDashboard:"\u039c\u0395\u03a4\u0391\u0392\u0391\u03a3\u0397 \u03a3\u03a4\u039f LIVE \u03a4\u0391\u039c\u03a0\u039b\u039f",connectRequired:"Connect Required",connectingECU:"Connecting E C U",pairingTipTitle:"\u039f\u0394\u0397\u0393\u039f\u03a3 \u03a0\u03a1\u03a9\u03a4\u0397\u03a3 \u03a3\u03a5\u039d\u0394\u0395\u03a3\u0397\u03a3 & \u03a1\u03a5\u0398\u039c\u0399\u03a3\u0397\u03a3",pairingTipDesc:"\u0393\u03b9\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03b5\u03af\u03c2 Bluetooth Classic \u03c3\u03b5 Android, \u03ba\u03ac\u03bd\u03c4\u03b5 \u03c3\u03cd\u03b6\u03b5\u03c5\u03be\u03b7 \u03c3\u03c4\u03b9\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 \u03c0\u03c1\u03b9\u03bd \u03b1\u03c0\u03cc \u03c4\u03b7 \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7 (PIN: 1234 \u03ae 0000). \u039f\u03b9 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03b5\u03af\u03c2 iOS \u03ba\u03b1\u03b9 BLE \u03c3\u03c5\u03bd\u03b4\u03ad\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2.",openBtSettings:"\u03a1\u03a5\u0398\u039c\u0399\u03a3\u0395\u0399\u03a3 BLUETOOTH",firstTimeGuideTitle:"\u039f\u0394\u0397\u0393\u039f\u03a3 \u03a0\u03a1\u03a9\u03a4\u0397\u03a3 \u03a3\u03a5\u039d\u0394\u0395\u03a3\u0397\u03a3 & \u03a1\u03a5\u0398\u039c\u0399\u03a3\u0397\u03a3",firstTimeGuideDescAndroid:"\u039a\u03ac\u03bd\u03c4\u03b5 \u03c3\u03cd\u03b6\u03b5\u03c5\u03be\u03b7 \u03c4\u03c9\u03bd \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03c9\u03bd Bluetooth Classic (ELM327) \u03c3\u03c4\u03b9\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 Bluetooth \u03c4\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c6\u03ce\u03bd\u03bf\u03c5 \u03c3\u03b1\u03c2 \u03c0\u03c1\u03b9\u03bd \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 (PIN: 1234 \u03ae 0000). \u039f\u03b9 \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ad\u03c2 BLE \u03ba\u03b1\u03b9 Wi-Fi \u03c3\u03c5\u03bd\u03b4\u03ad\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2.",firstTimeGuideDescIos:"\u039f\u03b9 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03b5\u03af\u03c2 BLE (Bluetooth 4.0+) \u03ba\u03b1\u03b9 Wi-Fi \u03b4\u03b5\u03bd \u03b1\u03c0\u03b1\u03b9\u03c4\u03bf\u03cd\u03bd \u03c3\u03cd\u03b6\u03b5\u03c5\u03be\u03b7 \u03c3\u03c4\u03b9\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c6\u03ce\u03bd\u03bf\u03c5, \u03b5\u03bd\u03c4\u03bf\u03c0\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03bd\u03b4\u03ad\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae."},dashboard:{selectDevice:"\u0391\u0393\u0393\u0399\u039e\u03a4\u0395 \u0393\u0399\u0391 \u0395\u03a0\u0399\u039b\u039f\u0393\u0397 \u03a3\u03a5\u03a3\u039a\u0395\u03a5\u0397\u03a3",connectedDevice:"\u03a3\u03a5\u039d\u0394\u0395\u0394\u0395\u039c\u0395\u039d\u0397 \u03a3\u03a5\u03a3\u039a\u0395\u03a5\u0397",noConnection:"\u039a\u03b1\u03bc\u03af\u03b1 \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7 \u03b1\u03ba\u03cc\u03bc\u03b1",batteryLow:"\u0397 \u03a4\u0391\u03a3\u0397 \u03a4\u0397\u03a3 \u039c\u03a0\u0391\u03a4\u0391\u03a1\u0399\u0391\u03a3 \u0395\u0399\u039d\u0391\u0399 \u03a7\u0391\u039c\u0397\u039b\u0397!",batteryLowDesc:"\u0397 \u03c4\u03ac\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03c4\u03bf{{voltage}}. \u039e\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03c4\u03b5 \u03ae \u03c6\u03bf\u03c1\u03c4\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1. \u0397 \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1 ECU \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b4\u03b9\u03b1\u03ba\u03bf\u03c0\u03b5\u03af \u03c3\u03b5 \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae \u03c4\u03ac\u03c3\u03b7.",batteryWarn:"\u0397 \u039c\u03a0\u0391\u03a4\u0391\u03a1\u0399\u0391 \u0391\u0394\u03a5\u039d\u0391\u039c\u0395\u0399",batteryWarnDesc:"\u03a4\u03ac\u03c3\u03b7 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2{{voltage}}. \u039d\u03b1 \u03b5\u03af\u03c3\u03c4\u03b5 \u03c0\u03c1\u03bf\u03c3\u03b5\u03ba\u03c4\u03b9\u03ba\u03bf\u03af \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03bc\u03b1\u03ba\u03c1\u03bf\u03c7\u03c1\u03cc\u03bd\u03b9\u03c9\u03bd \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b9\u03ce\u03bd.",rpm:"\u03a3\u03c4\u03c1\u03bf\u03c6\u03ad\u03c2 \u039a\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 (RPM)",speed:"\u03a4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 \u039f\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2",temp:"\u0398\u0395\u03a1\u039c\u039f\u039a\u03a1\u0391\u03a3\u0399\u0391",throttle:"\u0398\u03ad\u03c3\u03b7 \u03a0\u03b5\u03c4\u03b1\u03bb\u03bf\u03cd\u03b4\u03b1\u03c2",status:"\u039a\u0391\u03a4\u0391\u03a3\u03a4\u0391\u03a3\u0397 \u039c\u0395\u03a4\u0391\u03a6\u039f\u03a1\u0391\u03a3",statusHigh:"\u03a5\u03a8\u0397\u039b\u0391",statusNormal:"\u039a\u0391\u039d\u039f\u039d\u0399\u039a\u039f",statusLow:"\u03a7\u0391\u039c\u0397\u039b\u039f",battery:"\u039c\u03a0\u0391\u03a4\u0391\u03a1\u0399\u0391",load:"\u03a6\u039f\u03a1\u03a4\u0399\u039f",intake:"\u0391\u0395\u03a1\u0391 \u0395\u0399\u03a3\u0391\u0393\u03a9\u0393\u0397\u03a3",manifold:"\u03a0\u039f\u039b\u039b\u0391\u03a0\u039b\u0397 kPa",customizeTitle:"\u03a1\u03a5\u0398\u039c\u0399\u03a3\u0395\u0399\u03a3 \u03a0\u0399\u039d\u0391\u039a\u0391",customizeSubtitle:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03b8\u03ad\u03bb\u03b5\u03c4\u03b5 \u03bd\u03b1 \u03b2\u03bb\u03ad\u03c0\u03b5\u03c4\u03b5 \u03c3\u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 (\u0388\u03c9\u03c2 8).",layoutType:"\u03a4\u03cd\u03c0\u03bf\u03c2 \u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7\u03c2",layoutGrid:"\u03a0\u039b\u0395\u0393\u039c\u0391",layoutList:"\u039b\u0399\u03a3\u03a4\u0391",customizeButton:"\u0395\u03a0\u0395\u039e\u0395\u03a1\u0393\u0391\u03a3\u0399\u0391 \u0394\u0395\u0399\u039a\u03a4\u03a9\u039d",coolant:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03a8\u03c5\u03ba\u03c4\u03b9\u03ba\u03bf\u03cd",voltage:"\u03a4\u03ac\u03c3\u03b7 \u039c\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2",engineLoad:"\u03a6\u03bf\u03c1\u03c4\u03af\u03bf \u039a\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",intakeAirTemp:"\u0398\u03b5\u03c1\u03bc. \u0391\u03ad\u03c1\u03b1 \u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2",manifoldPressure:"\u03a0\u03af\u03b5\u03c3\u03b7 \u03a0\u03bf\u03bb\u03bb\u03b1\u03c0\u03bb\u03ae\u03c2 (MAP)",ambientTemp:"\u0395\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae \u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1",oilTemp:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u039b\u03b1\u03b4\u03b9\u03bf\u03cd",mafFlow:"\u03a1\u03bf\u03ae \u0391\u03ad\u03c1\u03b1 MAF",timingAdvance:"\u0391\u03b2\u03ac\u03bd\u03c2 \u0391\u03bd\u03b1\u03c6\u03bb\u03b5\u03be\u03b7\u03c2",fuelLevel:"\u03a3\u03c4\u03ac\u03b8\u03bc\u03b7 \u039a\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5",catalystTemp:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u