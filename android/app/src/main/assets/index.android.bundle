ocks drivetrain pitch, roll, wheel articulation, and coolant temp pages on Uconnect."},stellantis_peugeot_icockpit_3d_color_schemes:{name:"Peugeot 3D i-Cockpit Custom Color Scheme Palette",desc:"Unlocks Copper and Quartz color themes for 3D holographic digital instrument cluster."},gm_super_cruise_follow_distance_adjust:{name:"Super Cruise Hands-Free Following Distance Offset",desc:"Customizes gap spacing during autonomous Super Cruise highway driving."},gm_instrument_hud_calibration_reset:{name:"Head-Up Display Position & Tilt Zero-Point Calibration",desc:"Resets wind-shield HUD projector image angle and zero-level horizon alignment."},gm_afm_v8_cylinder_lock_no_v4_drop:{name:"AFM / DFM Cylinder Deactivation Override",desc:"Disables Active Fuel Management cylinder drop to keep engine operating in 8-cylinder mode."},dodge_ram_truck_fog_lights_with_high_beam:{name:"RAM Truck Fog Lights with High Beam",desc:"Prevents fog lights from turning OFF automatically when high beams are switched ON."},toyota_keyless_window_down:{name:"Toyota Key Fob Window Open",desc:"Rolls down all power windows when holding UNLOCK button on remote fob."},toyota_seatbelt_chime_disable:{name:"Toyota Passenger Seatbelt Alarm Mute",desc:"Disables persistent acoustic seatbelt warning chime in passenger seat."},honda_walkaway_auto_lock:{name:"Honda Walk-Away Auto Door Lock",desc:"Automatically locks all doors when Smart Key leaves 2.5m vehicle radius."},volvo_speed_limiter_unlock:{name:"Volvo 180 km/h Factory Speed Limiter Extended",desc:"Adjusts 180 km/h factory speed cap for Track / Autobahn performance use."},byd_v2l_3kw_power_unlock:{name:"BYD Vehicle-to-Load 3.6kW AC Output Mode",desc:"Enables external 220V/3.6kW V2L AC discharge port for camping appliances."},xiaomi_su7_drift_mode_unlock:{name:"Xiaomi SU7 Track Drift Mode & Rear-Torque Bias",desc:"Activates 100% rear motor torque bias and ESC Track Drift Mode."},vag_oil_service_reset:{name:"Oil Service Interval Reset",desc:"Resets oil change service counter and inspection interval for VAG vehicles."},vag_epb_service_mode:{name:"Electronic Parking Brake Brake Pad Service Mode",desc:"Retracts rear EPB caliper pistons for rear brake pad and rotor replacement."},bmw_bms_battery_registration:{name:"Intelligent Battery Sensor Battery Registration",desc:"Registers new 12V AGM/Lead-acid battery replacement in DME/DDE engine management."},bmw_motorrad_service_indicator_reset:{name:"BMW Motorrad Annual Service & Oil Indicator Reset",desc:"Clears annual service date and 10,000 km distance reminder on TFT instrument cluster."},ducati_desmo_service_reset:{name:"Ducati Desmo Valve Service Reminder Clear",desc:"Clears Desmoservice wrench icon on dashboard after 15,000 / 30,000 km service."},byd_bms_isolation_self_test:{name:"BYD Blade Battery High-Voltage Isolation Self-Test",desc:"Executes high-voltage system leakage & resistance diagnostics in BMS."},vag_drl_brightness_multi:{name:"Daytime Running Lights Brightness Adjustment",desc:"Adjust LED DRL intensity level for low-beam / parking mode."},bmw_comfort_turn_signal_cycles:{name:"One-Touch Comfort Turn Signal Pulse Count",desc:"Select how many blinks occur on quick tap of turn indicator lever."},bmw_oil_service_reset:{name:"CBS Engine Oil Reset",desc:"Resets Condition Based Service oil life percentage back to 100%."},generic_oil_service_reset:{name:"Universal Oil Maintenance Indicator Reset",desc:"Clears dashboard oil maintenance warning light across supported OBD2/UDS ECUs."},vag_epb_pad_change:{name:"EPB Brake Pad Replacement Mode",desc:"Retracts electronic parking brake calipers for rear brake pad servicing."},bmw_epb_pad_change:{name:"EPB Brake Service Mode",desc:"Opens parking brake actuator to service position for rear pad replacement."},mb_epb_pad_change:{name:"EPB Pad Fitting Mode",desc:"Releases parking brake spindle to workshop position for brake service."},vag_dpf_regen:{name:"DPF Service Regeneration Trigger",desc:"Initiates stationary Diesel Particula