t.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error\nECU trouble codes could not be read.",scannedSystems:"\u0938\u094d\u0915\u0948\u0928 \u0915\u0940 \u0917\u0908 \u092a\u094d\u0930\u0923\u093e\u0932\u093f\u092f\u093e\u0901",moduleEngine:"\u0907\u0902\u091c\u0928 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0907\u0915\u093e\u0908",moduleAbs:"\u090f\u0902\u091f\u0940-\u0932\u0949\u0915 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e",moduleTcm:"\u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u0949\u0921\u094d\u092f\u0942\u0932",moduleBcm:"\u0936\u093e\u0930\u0940\u0930\u093f\u0915 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092e\u0949\u0921\u094d\u092f\u0942\u0932",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091a\u0947\u0924\u093e\u0935\u0928\u0940",safetyWarningDesc:"\u0907\u0938 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928: \u2022 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u2022 \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u2022 \u0935\u093e\u0939\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0928 \u0915\u0930\u0947\u0902 \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",step1:"\u091a\u0930\u0923 1: \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u092e\u093f\u091f\u093e\u090f\u0901",step1Desc:"\u0938\u092d\u0940 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0926\u094b\u0937 \u0915\u094b\u0921 \u0914\u0930 \u091a\u0947\u0915 \u0907\u0902\u091c\u0928 \u0932\u093e\u0907\u091f \u0915\u094b \u0938\u093e\u092b\u093c \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0908\u0902\u0927\u0928 \u091f\u094d\u0930\u093f\u092e \u092e\u093e\u0928 \u0930\u0940\u0938\u0947\u091f \u0915\u0930 \u0926\u093f\u090f \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u0907\u0938 \u090f\u0915\u094d\u0936\u0928 \u0915\u094b \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e!",step2:"\u091a\u0930\u0923 2: \u0908\u0938\u0940\u092f\u0942 \u0939\u093e\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f",step2Desc:"\u0907\u0902\u091c\u0928 \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930 \u092a\u0930 \u090f\u0915 \u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u0930\u0940\u0938\u0947\u091f \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0939 \u092c\u0948\u091f\u0930\u0940 \u0915\u094b \u0939\u091f\u093e\u0928\u0947 \u0914\u0930 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0928\u0947 \u091c\u0948\u0938\u093e \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0917\u0948\u0930-\u0938\u0939\u093e\u092f\u0915 \u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u0902 \u0905\u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0939\u0948\u0964 \u0907\u0938\u0938\u0947 \u0915\u094b\u0908 \u0928\u0941\u0915\u0938\u093e\u0928 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e.",clearCodes:"\u0915\u094b\u0921 \u0939\u091f\u093e\u090f\u0902",ecuReset:"\u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902",finish:"\u091b\u094b\u0921\u093c\u0947\u0902",completed:"\u092a\u0942\u0930\u094d\u0923",completedDesc:"\u0938\u0947\u0935\u093e \u0938\u0902\u091a\u093e\u0932\u0928 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0942\u0930\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948. \u0906\u092a \u0935\u093e\u0939\u0928 \u0915\u094b \u092a\u0941\u0928\u0903 \u0906\u0930\u0902\u092d \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902.",hardResetDesc:"\u0938\u092d\u0940 \u0938\u0947\u0935\u093e \u0915\u093e\u0930\u094d\u092f \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0942\u0930\u0947 \u0915\u0930 \u0932\u093f\u090f \u0917\u090f \u0939\u0948\u0902. \u2022 \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0938\u093e\u092b\u093c \u0915\u0930 \u0926\u093f\u090f \u0917\u090f \u2022 \u0908\u0902\u0927\u0928 \u091f\u094d\u0930\u093f\u092e\u094d\u0938 \u0930\u0940\u0938\u0947\u091f \u2022 \u0908\u0938\u0940\u092f\u0942 \u0930\u0940\u0938\u0947\u091f \u0906\u092a \u0935\u093e\u0939\u0928 \u0915\u094b \u092a\u0941\u0928\u0903 \u0906\u0930\u0902\u092d \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902."},info:{desc:"\u092a\u0947\u0936\u0947\u0935\u0930 \u092e\u094b\u091f\u0930\u0938\u093e\u0907\u0915\u093f\u0932 \u0914\u0930 \u0935\u093e\u0939\u0928 \u0928\u093f\u0926\u093e\u0928 \u0905\u0928\u0941\u092a\u094d\u0930\u092f\u094b\u0917\u0964 \u0938\u092d\u0940 \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0917\u0924.",upgrade:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u092a\u094d\u0930\u094b \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902",upgradeAlert:"\u0936\u0940\u0918\u094d\u0930 \u092a\u0939\u0941\u0902\u091a",upgradeAlertDesc:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0935\u093f\u0915\u093e\u0938 \u092e\u0947\u0902 \u0939\u0948\u0964 \u091a\u0942\u0901\u0915\u093f \u0906\u092a \u0939\u092e\u093e\u0930\u0947 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0939\u0948\u0902, \u0938\u092d\u0940 \u092a\u094d\u0930\u094b \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0905\u092c \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0939\u092e\u093e\u0930\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u092e\u0942\u0932\u094d\u092f\u0935\u093e\u0928 \u0939\u0948!",helpGuide:"\u0938\u0939\u093e\u092f\u0924\u093e \u090f\u0935\u0902 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928",language:"\u092d\u093e\u0937\u093e/\u092d\u093e\u0937\u093e/\u092c\u0939\u093e\u0938\u093e",support:"\u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930",supportSubject:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0938\u092e\u0930\u094d\u0925\u0928 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e",thanks:"\u0927\u0928\u094d\u092f\u0935\u093e\u0926!",thanksDesc:"\u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u093e \u0927\u0928\u094d\u092f\u0935\u093e\u0926\u0964 \u0906\u092a \u0939\u092e\u0947\u0902 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0930 \u092a\u0930 \u090f\u0915 \u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u091b\u094b\u0921\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",sections:{live:{title:"\u0932\u093e\u0907\u0935 \u092e\u0949\u0928\u093f\u091f\u0930\u093f\u0902\u0917 \u0938\u0947\u0902\u0938\u0930",content:"\u0906\u092a \u0924\u0941\u0930\u0902\u0924 \u0906\u0930\u092a\u0940\u090f\u092e, \u0917\u0924\u093f, \u0907\u0902\u091c\u0928 \u0924\u093e\u092a\u092e\u093e\u0928, \u0925\u094d\u0930\u0949\u091f\u0932 \u0938\u094d\u0925\u093f\u0924\u093f, \u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c, \u0907\u0902\u091c\u0928 \u0932\u094b\u0921, \u0938\u0947\u0935\u0928 \u0935\u093e\u092f\u0941 \u0924\u093e\u092a\u092e\u093e\u0928 \u0914\u0930 \u092e\u0948\u0928\u093f\u092b\u094b\u0932\u094d\u0921 \u092a\u094d\u0930\u0947\u0936\u0930 \u0915\u0940 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0917\u0924\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092e\u093e\u0928 \u092a\u094d\u0930\u0924\u093f \u0938\u0947\u0915\u0902\u0921 1-5 \u092c\u093e\u0930 \u0924\u093e\u091c\u093c\u093e \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u091f\u0930\u094d\u092e\u093f\u0928\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u0942\u0921\u0940\u090f\u0938/\u0913\u092c\u0940\u0921\u0940 \u0915\u092e\u093e\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u0939\u0928 \u092e\u0947\u0902 \u0938\u0940\u0927\u0947 \u0939\u0938\u094d\u0924\u0915\u094d\u0937\u0947\u092a \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},expertise:{title:"\u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0914\u0930 \u0935\u093e\u0930\u0902\u091f\u0940",content:"\u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u094b\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0908\u0938\u0940\u092f\u0942 \u0915\u094b\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0935\u093e\u0939\u0928 \u092a\u0930 \u0926\u0930\u094d\u091c \u0935\u0940\u0906\u0908\u090f\u0928 \u0928\u0902\u092c\u0930 \u0914\u0930 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u093e\u0907\u0932\u0947\u091c \u0915\u094b \u0915\u0948\u092a\u094d\u091a\u0930 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924, \u092a\u093f\u091b\u0932\u0940 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u094b\u0902 \u0915\u093e \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u092f\u0939 \u0917\u0923\u0928\u093e \u0915\u0930\u0915\u0947 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u093e\u0939\u0928 \u0928\u0947 \u091a\u0947\u0915 \u0907\u0902\u091c\u0928 \u0932\u093e\u0907\u091f \u0915\u0947 \u0938\u093e\u0925 \u0915\u093f\u0924\u0928\u0940 \u0926\u0942\u0930 \u0924\u0915 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0940 \u0939\u0948\u0964 \u092a\u0930\u093f\u0923\u093e\u092e\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092a\u0940\u0921\u0940\u090f\u092b \u0914\u0930 \u092e\u0948\u0938\u0947\u091c\u093f\u0902\u0917 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092e\u0947\u0902 \u0938\u093e\u091d\u093e \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964"},tests:{title:"\u092c\u0948\u091f\u0930\u0940/\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923",content:"\u092c\u0948\u091f\u0930\u0940 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0947 3 \u091a\u0930\u0923 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902: \u0906\u0930\u093e\u092e, \u0915\u094d\u0930\u0948\u0902\u0915\u093f\u0902\u0917 \u0914\u0930 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u091a\u093e\u0930\u094d\u091c \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0906\u092a\u0915\u0940 \u092c\u0948\u091f\u0930\u0940/\u0928\u093f\u092f\u093e\u092e\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u094b \u092e\u093e\u092a\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u0947 \u092a\u094d\u0930\u094b\u0938\u0947\u0938\u0930 \u0914\u0930 \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0938\u0947 \u0924\u093e\u0924\u094d\u0915\u093e\u0932\u093f\u0915 \u0917\u0924\u093f \u0921\u0947\u091f\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947, 50 \u090f\u092e\u090f\u0938 \u0915\u0940 \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u0947 \u092e\u093e\u0930\u094d\u091c\u093f\u0928 \u0915\u0947 \u0938\u093e\u0925 0-60 \u0914\u0930 0-100 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0924\u094d\u0935\u0930\u0923 \u092e\u093e\u0928 \u092e\u093e\u092a\u0924\u093e \u0939\u0948\u0964"},hardware:{title:"\u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u0924\u093e",content:"ELM327 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0905\u0928\u0941\u0936\u0902\u0938\u093f\u0924 \u0939\u0948\u0964 \u0915\u0941\u091b \u0909\u0928\u094d\u0928\u0924 \u0915\u094b\u0921 v2.1 \u0915\u094d\u0932\u094b\u0928 \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0916\u0930\u093e\u092c \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0935\u093e\u0932\u0947 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u092a\u0930 \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u094b vLinker \u0914\u0930 OBDLink \u091c\u0948\u0938\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0915\u0947 \u0938\u093e\u0925 \u0938\u092c\u0938\u0947 \u0924\u0947\u091c\u093c \u0917\u0924\u093f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964"},warnings:{title:"\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u091a\u0947\u0924\u093e\u0935\u0928\u093f\u092f\u093e\u0901",content:"\u2022 \u092b\u0949\u0932\u094d\u091f \u0915\u094b\u0921 \u0939\u091f\u093e\u0928\u0947 \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092f\u093e \u0908\u0938\u0940\u092f\u0942 \u0930\u0940\u0938\u0947\u091f \u092b\u093c\u0902\u0915\u094d\u0936\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942 \u0914\u0930 \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u2022 \u0915\u093f\u0938\u0940 \u091a\u093e\u0932\u0942 \u0935\u093e\u0939\u0928 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0928 \u092d\u0947\u091c\u0947\u0902\u0964 \u2022 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0935\u093e\u0939\u0928 \u0938\u092d\u0940 \u0938\u0947\u0902\u0938\u0930\u094b\u0902 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e, \u0905\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0938\u0947\u0902\u0938\u0930 \"--\" \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0947\u0902\u0917\u0947\u0964"},onboarding:{title:"\u0915\u093e\u0928\u0942\u0928\u0940 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u0914\u0930 \u0905\u0928\u093e\u092e \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940",content:"\u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0914\u0930 \u0935\u093e\u0939\u0928 \u0905\u0928\u0941\u0915\u0942\u0932\u0924\u093e \u092e\u0947\u0902 \u0938\u0941\u0927\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f; \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0905\u091c\u094d\u091e\u093e\u0924 \u0907\u0902\u091c\u0928 \u092a\u0948\u0930\u093e\u092e\u0940\u091f\u0930 \u0914\u0930 \u0917\u0932\u0924\u0940 \u0928\u093f\u0926\u093e\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0917\u0932\u0924\u0940 \u0915\u094b\u0921 \u0915\u093e \u0939\u092e\u093e\u0930\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0930\u094d\u0935\u0930 \u092a\u0930 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u091c\u093e\u0930\u0940 \u0930\u0916\u0915\u0930 \u0906\u092a \u0907\u0928 \u0905\u0928\u093e\u092e \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092e\u094b\u091f\u0930\u0938\u093e\u0907\u0915\u093f\u0932 \u0915\u0947 \u0908\u0938\u0940\u092f\u0942 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u091a\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0914\u0930 \u0938\u094d\u0925\u093e\u0928 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"},featureCoding:{title:"\u091b\u093f\u092a\u0940 \u0939\u0941\u0908 \u0938\u0941\u0935\u093f\u0927\u093e \u0905\u0928\u0932\u0949\u0915 \u0914\u0930 \u092f\u0942\u0921\u0940\u090f\u0938 \u0915\u094b\u0921\u093f\u0902\u0917",content:"\u0939\u092e\u093e\u0930\u0947 \u0906\u0908\u090f\u0938\u0913 14229 \u092f\u0942\u0921\u0940\u090f\u0938 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0907\u0902\u091c\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u091a\u093e\u0932\u093f\u0924, \u0935\u0940\u090f\u091c\u0940, \u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942, \u0930\u0947\u0928\u0949\u0932\u094d\u091f \u0914\u0930 \u0921\u0947\u0938\u093f\u092f\u093e \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u090f\u0938 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0932\u093e\u0907\u091f\u094d\u0938, \u0928\u0940\u0921\u0932 \u0938\u094d\u0935\u0940\u092a, \u0939\u0949\u0930\u094d\u0928 \u090f\u0915 \u0932\u0949\u0915, \u0915\u092e\u094d\u092b\u0930\u094d\u091f \u0935\u093f\u0902\u0921\u094b\u091c \u0914\u0930 \u0921\u0940\u0906\u0930\u090f\u0932 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091c\u0948\u0938\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u091f\u0949\u0917\u0932 \u0915\u0930\u0947\u0902\u0964"},multiEcu:{title:"\u092e\u0932\u094d\u091f\u0940-\u0908\u0938\u0940\u092f\u0942 \u0938\u092d\u0940 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0938\u094d\u0915\u0948\u0928\u093f\u0902\u0917",content:"\u090f\u092c\u0940\u090f\u0938, \u090f\u092f\u0930\u092c\u0948\u0917, \u0911\u091f\u094b\u092e\u0948\u091f\u093f\u0915 \u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928, \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930, \u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f \u0915\u0902\u091f\u094d\u0930\u094b\u0932, \u0914\u0930 \u092c\u0949\u0921\u0940 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0938\u0939\u093f\u0924 \u0907\u0902\u091c\u0928 \u0908\u0938\u0940\u092f\u0942 \u0938\u0947 \u092a\u0930\u0947 \u0917\u0932\u0924\u0940 \u0915\u094b\u0921 \u0915\u094b \u0938\u094d\u0915\u0948\u0928 \u0914\u0930 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902\u0964"},advancedDiagnostics:{title:"\u0921\u0940\u0938\u0940\u091f\u0940 \u0905\u0928\u0941\u0915\u0942\u0932\u0928, \u0921\u0940\u092a\u0940\u090f\u092b \u0914\u0930 \u090f\u091a\u092a\u0940 \u092a\u093e\u0935\u0930 \u0917\u0947\u091c",content:"\u2022 \u0921\u0940\u0938\u0940\u091f\u0940/\u0921\u0940\u090f\u0938\u091c\u0940 \u0915\u094d\u0932\u091a \u0915\u093f\u0938 \u092a\u094d\u0935\u093e\u0907\u0902\u091f \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0914\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0930\u0940\u0938\u0947\u091f\n\u2022 \u0921\u0940\u092a\u0940\u090f\u092b \u0938\u0942\u091f \u0932\u094b\u0921 \u0914\u0930 \u0928\u093f\u0915\u093e\u0938 \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u0928 \u0924\u093e\u092a\u092e\u093e\u0928 \u0928\u093f\u0917\u0930\u093e\u0928\u0940\n\u2022 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u0932\u0918\u0941/\u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0908\u0902\u0927\u0928 \u091f\u094d\u0930\u093f\u092e\u094d\u0938 \u0914\u0930 \u0932\u0948\u092e\u094d\u092c\u094d\u0921\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923\n\u2022 \u0921\u093e\u092f\u0928\u0947\u092e\u093f\u0915 \u0939\u0949\u0930\u094d\u0938\u092a\u093e\u0935\u0930 \u0914\u0930 \u091f\u0949\u0930\u094d\u0915 \u0932\u093e\u0907\u0935 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0917\u094d\u0930\u093e\u092b\u093c"},demoMode:{title:"\u0921\u0947\u092e\u094b \u092e\u094b\u0921",content:"\u092d\u094c\u0924\u093f\u0915 OBD2 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0915\u0947 \u092c\u093f\u0928\u093e \u0910\u092a \u0915\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0909\u0938\u0915\u093e \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0930\u0947\u0902\u0964 \u092f\u0925\u093e\u0930\u094d\u0925\u0935\u093e\u0926\u0940 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0938\u093f\u092e\u0941\u0932\u0947\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0942\u0930\u094d\u0923 \u0915\u0948\u0928-\u092c\u0938 \u0914\u0930 \u092f\u0942\u0921\u0940\u090f\u0938 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0915\u0930\u0947\u0902\u0964"}},reconfigurePermissions:"\u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u0914\u0930 \u0915\u093e\u0928\u0942\u0928\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0947\u0902",shareWithFriend:"\u092e\u093f\u0924\u094d\u0930 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902",shareMessageText:"Cortex OBD2 Diagnostic Scanner \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u0939\u0928 ECU \u092b\u0949\u0932\u094d\u091f \u0915\u094b\u0921 \u0914\u0930 \u0932\u093e\u0907\u0935 \u0938\u0947\u0902\u0938\u0930 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0916\u094b\u091c\u0947\u0902! \u0905\u092d\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902: iOS: https://apps.apple.com/app/id6764052240 Android: https://play.google.com/store/apps/details?id=com.ismail.motocortexv2 Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:"\u2550\u2550\u2550 \u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u2550\u2550\u2550",vehicleIdentity:"\u0935\u093e\u0939\u0928 \u0906\u0908\u0921\u0940",vin:"\u091a\u0947\u0938\u093f\u0938 \u0928\u0902\u092c\u0930",odometer:"\u0926\u0942\u0930\u0940",milDist:"\u0907\u0902\u091c\u0928 \u0932\u093e\u0907\u091f \u091a\u093e\u0932\u0942",distSinceCleared:"\u0924\u094d\u0930\u0941\u091f\u093f \u0938\u093e\u092b\u093c \u0915\u0940 \u0917\u0908",dtcCount:"FAULT CODES ({{count}})",sensorData:"\u0932\u093e\u0907\u0935 \u0938\u0947\u0902\u0938\u0930 \u0921\u0947\u091f\u093e",noData:"\u0921\u0947\u091f\u093e \u092a\u0922\u093c\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932",proApp:"Cortex OBD2 Diagnostic Scanner v7 PRO \u0915\u0947 \u0938\u093e\u0925 \u0938\u094d\u0915\u0948\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964",date:"\u0926\u093f\u0928\u093e\u0902\u0915",vinNotFound:"\u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u091a\u0932\u093e",noDtcs:"\u0915\u094b\u0908 \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0928\u0939\u0940\u0902 - \u0938\u093e\u092b\u093c",speed:"\u0917\u0924\u093f",coolant:"\u0907\u0902\u091c\u0928 \u0915\u093e \u0924\u093e\u092a\u092e\u093e\u0928",throttle:"\u0917\u0948\u0938",engineLoad:"\u0907\u0902\u091c\u0928 \u0932\u094b\u0921",intakeAir:"\u0939\u0935\u093e \u0915\u093e \u0938\u0947\u0935\u0928",manifold:"\u0905\u0928\u0947\u0915 \u0917\u0941\u0928\u093e",voltage:"\u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c",shareMessage:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 OBD2 \u0921\u093e\u092f\u0917\u094d\u0928