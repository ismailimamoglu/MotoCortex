D t\xe9rbeli akusztikus hangol\xe1st a Mark Levinson pr\xe9mium hangsz\xf3r\xf3khoz."},lexus_ev_mode_beeper_mute:{name:"Alacsony sebess\xe9g\u0171 gyalogos elektromos aut\xf3 akusztikus figyelmeztet\u0151 hangjelz\xe9s n\xe9m\xedt\xe1sa (Lexus)",desc:"Elnyomja a kis sebess\xe9g\u0171 elektromos \xfczemm\xf3d\xfa szintetikus k\xfcls\u0151 harangsz\xf3t."},lexus_easy_access_seat:{name:"K\xf6nnyen hozz\xe1f\xe9rhet\u0151 korm\xe1nyker\xe9k \xe9s motoros \xfcl\xe9s cs\xfasztathat\xf3 h\xe1tt\xe1mla (Lexus)",desc:"Cs\xfasztatja a vezet\u0151\xfcl\xe9st, \xe9s elhajtja a korm\xe1nyt a k\xf6nny\u0171 be- \xe9s kisz\xe1ll\xe1s \xe9rdek\xe9ben."},nissan_epower_regen_mode:{name:"e-POWER egyped\xe1los regenerat\xedv f\xe9kez\xe9si m\xf3d (Nissan)",desc:"Be\xe1ll\xedtja az alap\xe9rtelmezett e-Pedal regenerat\xedv f\xe9kez\xe9si lass\xedt\xe1si szintet."},nissan_propilot_assist_timing:{name:"ProPILOT Lane Centering Assist korm\xe1nyz\xe1si \xe9rz\xe9kenys\xe9g (Nissan)",desc:"Konfigur\xe1lja a ProPILOT korm\xe1nyz\xe1si beavatkoz\xe1s \xe9less\xe9g\xe9t."},nissan_intelligent_around_view:{name:"K\xf6r\xfcltekint\u0151 monitor automatikus felugr\xf3 ablaka alacsony sebess\xe9gn\xe9l (Nissan)",desc:"Kikapcsolja a 360 fokos kamerakijelz\xe9st, amikor az el\xfcls\u0151 parkol\xf3\xe9rz\xe9kel\u0151k akad\xe1lyokat \xe9szlelnek."},mazda_g_vectoring_display:{name:"G-Vectoring Control Plus dinamikus megjelen\xedt\u0151 (Mazda)",desc:"Val\xf3s idej\u0171 GVC+ kanyarod\xe1si nyomat\xe9k vektorgrafikont jelen\xedt meg a m\u0171szerfalon."},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP f\xe9kenergia-visszanyer\u0151 kondenz\xe1tor m\xe9r\u0151 (Mazda)",desc:"Az elektromos kondenz\xe1tor t\xf6lt\xe9si \xe9s kis\xfct\xe9si \xe1llapot\xe1t mutatja a k\xf6zponti k\xe9perny\u0151n."},mazda_smart_city_brake_sens:{name:"Smart City Brake Support (SCBS) \xe9rz\xe9kenys\xe9ge (Mazda)",desc:"Be\xe1ll\xedtja az alacsony sebess\xe9g\u0171 automatikus v\xe9szf\xe9k-\xe9rz\xe9kel\u0151 tartom\xe1ny\xe1t.