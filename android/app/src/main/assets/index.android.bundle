{name:"TFT-\u0440\u043e\u0437\u043a\u043b\u0430\u0434\u043a\u0430 \u0434\u043e\u0440\u0456\u0436\u043a\u0438 \u0442\u0430 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0456\u0434\u0441\u0432\u0456\u0447\u0443\u0432\u0430\u043d\u043d\u044f Shift",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u043c\u0430\u043a\u0435\u0442 \u0433\u0443\u0441\u0435\u043d\u0438\u0446\u0456 R1/MT-09 SP \u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043e\u0432\u0430\u043d\u0456 \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0438 \u0447\u0430\u0441\u0442\u043e\u0442\u0438 \u043e\u0431\u0435\u0440\u0442\u0430\u043d\u043d\u044f."},yamaha_launch_control_sensitivity:{name:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0443\u0441\u043a\u043e\u043c (LCS) Rev Ceiling",desc:"\u041d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0454 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c, \u0443\u0442\u0440\u0438\u043c\u0443\u044e\u0447\u0438 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043e\u0431\u0435\u0440\u0442\u0456\u0432 \u043d\u0430 \u0445\u0432\u0438\u043b\u0438\u043d\u0443 (\u0434\u0456\u0430\u043f\u0430\u0437\u043e\u043d \u0432\u0456\u0434 8000 \u0434\u043e 10 000 \u043e\u0431\u0435\u0440\u0442\u0456\u0432 \u043d\u0430 \u0445\u0432\u0438\u043b\u0438\u043d\u0443)."},yamaha_heated_grips_accessory_enable:{name:"\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u044c\u043e\u0433\u043e TFT-\u043c\u0435\u043d\u044e \u0437 \u043f\u0456\u0434\u0456\u0433\u0440\u0456\u0432\u043e\u043c \u0440\u0443\u0447\u043e\u043a",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u043f\u0456\u0434\u0456\u0433\u0440\u0456\u0432 \u0440\u0443\u0447\u043e\u043a \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0434\u0430\u0442\u0447\u0438\u043a \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0438 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 TFT."},honda_hstc_wheelie_control_fine_tune:{name:"\u0422\u043e\u0447\u043d\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f HSTC Traction & Wheelie Control",desc:"\u0420\u0435\u0433\u0443\u043b\u044e\u0454 \u043a\u043e\u0435\u0444\u0456\u0446\u0456\u0454\u043d\u0442 \u043a\u043e\u0432\u0437\u0430\u043d\u043d\u044f Honda Selectable Torque Control \u0456 \u0434\u043e\u043f\u0443\u0441\u043a \u043f\u0456\u0434\u0439\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430."},honda_bi_directional_quickshifter_enable:{name:"\u0414\u0432\u043e\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0435 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f Quickshifter Retrofit",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u043a\u043e\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u0443\u0433\u043e\u0440\u0443/\u0432\u043d\u0438\u0437 \u0443 \u043f\u0430\u043c\u2019\u044f\u0442\u0456 ECU."},honda_service_reminder_custom_interval:{name:"\u041d\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u043e \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u044c \u0434\u043b\u044f \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u0430\u0441\u043b\u0430",desc:"\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0454 \u0456\u043d\u0434\u0438\u0432\u0456\u0434\u0443\u0430\u043b\u044c\u043d\u0438\u0439 \u0456\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u043f\u0440\u043e\u0431\u0456\u0433\u0443 \u0434\u043b\u044f \u0437\u0430\u043c\u0456\u043d\u0438 \u043c\u0430\u0441\u043b\u0430 \u043d\u0430 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u043c\u0443 \u043f\u0440\u0438\u043b\u0430\u0434\u0456."},honda_track_abs_rear_disable:{name:"Track ABS Rear-Wheel Deactivation",desc:"\u0412\u0438\u043c\u0438\u043a\u0430\u0454 \u043a\u0430\u043d\u0430\u043b ABS \u0437\u0430\u0434\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430, \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0447\u0438 ABS \u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0456\u0432 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0434\u043d\u0456\u0432 \u0442\u0440\u0435\u043a\u0443."},honda_cold_start_idle_enrichment:{name:"\u0417\u0431\u0430\u0433\u0430\u0447\u0435\u043d\u043d\u044f \u043f\u0430\u043b\u0438\u0432\u0430 \u043f\u0440\u0438 \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u043c\u0443 \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0442\u0430 \u0446\u0456\u043b\u044c\u043e\u0432\u0456 \u043e\u0431\u0435\u0440\u0442\u0438 \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u0433\u043e \u0445\u043e\u0434\u0443",desc:"\u0420\u0435\u0433\u0443\u043b\u044e\u0454 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u0433\u043e \u0445\u043e\u0434\u0443 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0456\u0432\u0443 \u0434\u043b\u044f \u0432\u0442\u043e\u0440\u0438\u043d\u043d\u0438\u0445 \u0432\u0438\u0445\u043b\u043e\u043f\u043d\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043c."},harley_custom_throttle_curve_editor:{name:"\u041a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0438\u0439 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u043a\u0440\u0438\u0432\u043e\u0457 \u0432\u0456\u0434\u0433\u0443\u043a\u0443 \u0434\u0440\u043e\u0441\u0435\u043b\u044c\u043d\u043e\u0457 \u0437\u0430\u0441\u043b\u0456\u043d\u043a\u0438",desc:"\u041d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0454 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0434\u0440\u043e\u0441\u0435\u043b\u044c\u043d\u043e\u0457 \u0437\u0430\u0441\u043b\u0456\u043d\u043a\u0438 Milwaukee-Eight / Revolution Max."},harley_security_alarm_sensitivity:{name:"\u0406\u043d\u0442\u0435\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043d\u0430 \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u0456 \u0442\u0430 \u0447\u0443\u0442\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0434\u043e \u043d\u0430\u0445\u0438\u043b\u0443",desc:"\u0420\u0435\u0433\u0443\u043b\u044e\u0454 \u0447\u0443\u0442\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0440\u0443\u0445\u0443 \u0442\u0430 \u0437\u0430\u0442\u0440\u0438\u043c\u043a\u0443 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043d\u0430 \u043e\u0445\u043e\u0440\u043e\u043d\u0443 \u0431\u0440\u0435\u043b\u043e\u043a\u0430 hands-free."},harley_boom_box_gts_hidden_diagnostics:{name:"\u0411\u0443\u043c! Box GTS Infotainment Hidden Diagnostic Menu",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0456\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u0456 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0456 \u0434\u0438\u0441\u043f\u043b\u0435\u0457, \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0438 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0442\u0430 \u0442\u0438\u0441\u043a\u0443 \u043c\u0430\u0441\u043b\u0430."},harley_rdrs_defensive_system_tune:{name:"\u0427\u0443\u0442\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e \u043a\u043e\u0432\u0437\u0430\u043d\u043d\u044f \u043a\u0440\u0443\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0443 RDRS",desc:"\u0422\u043e\u043d\u043a\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 Reflex Defensive Rider System \u0434\u043b\u044f \u043f\u043e\u043c\u2019\u044f\u043a\u0448\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0431\u0443\u043a\u0441\u043e\u0432\u043a\u0438 \u0437\u0430\u0434\u043d\u0456\u0445 \u043a\u043e\u043b\u0456\u0441 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043d\u0430 \u043d\u0438\u0436\u0447\u0443 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443."},byd_avas_low_speed_siren_mute:{name:"\u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u0441\u0438\u0440\u0435\u043d\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u043f\u0456\u0448\u043e\u0445\u043e\u0434\u0456\u0432 \u043d\u0430 \u043d\u0438\u0437\u044c\u043a\u0456\u0439 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 AVAS",desc:"\u0412\u0438\u043c\u0438\u043a\u0430\u0454 \u0430\u0431\u043e \u0437\u043d\u0438\u0436\u0443\u0454 \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u044e \u0430\u043a\u0443\u0441\u0442\u0438\u0447\u043d\u0443 \u0441\u0438\u0440\u0435\u043d\u0443 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u043e\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u043d\u0430 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u0434\u043e 30 \u043a\u043c/\u0433\u043e\u0434."},byd_ev_battery_preheat_manual_switch:{name:"\u0420\u0443\u0447\u043d\u0438\u0439 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u043d\u0430\u0433\u0440\u0456\u0432\u0443 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 EV",desc:"\u0414\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0440\u0443\u0447\u043d\u0443 \u0442\u0435\u0440\u043c\u043e\u043a\u043e\u043d\u0434\u0438\u0446\u0456\u044e\u0432\u0430\u043d\u043d\u044f \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 \u043f\u0435\u0440\u0435\u0434 \u0448\u0432\u0438\u0434\u043a\u0438\u043c \u0437\u0430\u0440\u044f\u0434\u0436\u0430\u043d\u043d\u044f\u043c \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u0438\u043c \u0441\u0442\u0440\u0443\u043c\u043e\u043c."},byd_v2l_220v_outlet_power_expansion:{name:"\u0420\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u043d\u044f \u0432\u0438\u0445\u0456\u0434\u043d\u043e\u0457 \u043f\u043e\u0442\u0443\u0436\u043d\u043e\u0441\u0442\u0456 V2L (\u0432\u0456\u0434 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u0433\u043e \u0437\u0430\u0441\u043e\u0431\u0443 \u0434\u043e \u043d\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f) 220 \u0412 (3,6 \u043a\u0412\u0442)",desc:"\u0417\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0443 \u043f\u043e\u0442\u0443\u0436\u043d\u0456\u0441\u0442\u044c \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u0440\u043e\u0437\u0440\u044f\u0434\u0443 V2L \u0437 2,2 \u043a\u0412\u0442 \u0434\u043e 3,6 \u043a\u0412\u0442."},byd_one_pedal_regen_default_max:{name:"\u0420\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u0435 \u0433\u0430\u043b\u044c\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0432\u043e\u0434\u0443 \u0437 \u043e\u0434\u043d\u0456\u0454\u044e \u043f\u0435\u0434\u0430\u043b\u043b\u044e \u041c\u0430\u043a\u0441",desc:"\u0411\u043b\u043e\u043a\u0443\u0454 \u0432\u0438\u0441\u043e\u043a\u0443 \u0440\u0435\u043a\u0443\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u0435 \u0433\u0430\u043b\u044c\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u044f\u043a \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u0435 \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f."},mg_ismart_connectivity_unlock:{name:"i-SMART Connectivity & Remote Telemetry Unlock",desc:"\u0414\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0456\u0439\u043d\u0435 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043b\u0456\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0441\u0442\u0430\u043d\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f."},mg_mg4_xpower_launch_control_enable:{name:"MG4 XPower Dual-Motor Launch Control Mode",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0440\u0435\u0436\u0438\u043c \u0440\u043e\u0437\u0433\u043e\u043d\u0443 0-100 \u043a\u043c/\u0433\u043e\u0434 \u0437\u0430 3,8 \u0441."},mg_battery_preheat_manual_trigger:{name:"\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044f \u043f\u0456\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0448\u0432\u0438\u0434\u043a\u043e\u0457 \u0437\u0430\u0440\u044f\u0434\u043a\u0438 \u0432\u0440\u0443\u0447\u043d\u0443",desc:"\u041f\u0440\u0438\u043c\u0443\u0441\u043e\u0432\u043e \u0432\u043c\u0438\u043a\u0430\u0454 \u0432\u0438\u0441\u043e\u043a\u043e\u0432\u043e\u043b\u044c\u0442\u043d\u0456 \u043d\u0430\u0433\u0440\u0456\u0432\u0430\u043b\u044c\u043d\u0456 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0434\u043b\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0457 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u0437\u0430\u0440\u044f\u0434\u0443 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u043e\u0433\u043e \u0441\u0442\u0440\u0443\u043c\u0443."},xpeng_xngp_adas_region_unlock:{name:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0435\u0433\u0456\u043e\u043d\u0443 \u043f\u043e\u043c\u0456\u0447\u043d\u0438\u043a\u0430 \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u043e\u0433\u043e \u0432\u043e\u0434\u0456\u043d\u043d\u044f XNGP",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0443 \u043d\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0439\u043d\u0443 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0443 \u043f\u0456\u043b\u043e\u0442\u0443 \u0432 \u043d\u0435\u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0438\u0445 \u0440\u0435\u0433\u0456\u043e\u043d\u0430\u0445."},xpeng_ambient_lighting_music_sync:{name:"\u041d\u0430\u0432\u043a\u043e\u043b\u0438\u0448\u043d\u0454 \u043e\u0441\u0432\u0456\u0442\u043b\u0435\u043d\u043d\u044f, \u0449\u043e \u0440\u0435\u0430\u0433\u0443\u0454 \u043d\u0430 \u043c\u0443\u0437\u0438\u0447\u043d\u0438\u0439 \u0440\u0438\u0442\u043c",desc:"\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0454 \u0456\u043c\u043f\u0443\u043b\u044c\u0441\u0438 \u0441\u0432\u0456\u0442\u043b\u043e\u0434\u0456\u043e\u0434\u043d\u043e\u0433\u043e \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u043e\u0441\u0432\u0456\u0442\u043b\u0435\u043d\u043d\u044f \u0441\u0430\u043b\u043e\u043d\u0443 \u0437 \u0431\u0430\u0441\u0430\u043c\u0438 \u0430\u0443\u0434\u0456\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0438."},xpeng_rear_camera_trailer_hitch_view:{name:"360\xb0 Camera Hitch & Ground Overlay Mode",desc:"\u0414\u043e\u0434\u0430\u0454 \u043d\u0430\u043a\u043b\u0430\u0434\u043a\u0443 \u0441\u0456\u0442\u043a\u0438 \u0432\u0438\u0440\u0456\u0432\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0432\u0438\u0441\u043e\u043a\u043e\u0457 \u0440\u043e\u0437\u0434\u0456\u043b\u044c\u043d\u043e\u0457 \u0437\u0434\u0430\u0442\u043d\u043e\u0441\u0442\u0456 \u043d\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443 \u043a\u0430\u043c\u0435\u0440\u0443."},nio_battery_swap_interval_reminder:{name:"\u0420\u0435\u0436\u0438\u043c \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u043d\u0434\u0438\u0446\u0456\u043e\u043d\u04