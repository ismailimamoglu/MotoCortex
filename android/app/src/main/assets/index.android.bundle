it MKL",dtcTitle:"FEHLERCODES (DTC)",dtcClean:"KEINE FEHLERCODES \u2014 SAUBER",extraActions:"WEITERE AKTIONEN",garageTitle:"GARAGE & VERGANGENE EINTR\xc4GE",share:"TEILEN",saveVehicle:"FAHRZEUG SPEICHERN",noRecords:"Noch keine gespeicherten Fahrzeuge.",clean:"SAUBER",faults:"FEHLER",vinRequired:"FIN Erforderlich",vinRequiredDesc:"Die FIN muss automatisch erkannt oder manuell eingegeben werden.",missingInfo:"Fehlende Info",missingInfoDesc:"Bitte f\xfcllen Sie Marke und Modell aus.",saved:"Gespeichert ",savedDesc:"Diagnoseergebnis zur Garage hinzugef\xfcgt.",connRequired:"Verbindung erforderlich",connRequiredDesc:"Bitte verbinden Sie sich zuerst mit dem Fahrzeug.",chronicFaultsTitle:"Statistische chronische Fehler",chronicFaultsObs:"{{code}} (Beobachtung: {{days}} eindeutige Tage / Gesamt: {{total}} Mal)",chronicFaultsPending:"Datenpool wird gesammelt / Statistiken werden analysiert",notScanned:"Nicht gescannt",notScannedDesc:"Bitte dr\xfccken Sie die Scan-Taste oben rechts, um Diagnosecodes zu lesen.",scanFailed:"SCAN fehlgeschlagen",errTimeout:"Error: Connection Timeout (TIMEOUT)\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost (CONNECTION_LOST)\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\n(HARDWARE_FATAL_RECOVERY_FAILED)\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error (ERROR_UNABLE_TO_READ)\nECU trouble codes could not be read.",scannedSystems:"GESCANNE SYSTEME",moduleEngine:"Motorsteuerger\xe4t (ECU)",moduleAbs:"Antiblockiersystem (ABS)",moduleTcm:"Getriebesteuermodul (TCM)",moduleBcm:"Karosseriesteuermodul (BCM)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" SICHERHEITSWARNUNG",safetyWarningDesc:"W\xe4hrend dieses Vorgangs:\n\n\u2022 Z\xfcndung muss AN sein\n\u2022 Motor muss AUS sein\n\u2022 Fahrzeug nicht starten\n\nFortfahren?",step1:"Schritt 1: Fehlercodes l\xf6schen",step1Desc:"Alle gespeicherten Fehlercodes und die Motorkontrollleuchte werden gel\xf6scht.\n\nNicht umkehrbar!",step2:"Schritt 2: ECU Hard Reset",step2Desc:"Ein Hard Reset wird an das Motorsteuerger\xe4t gesendet. \xc4hnlich wie Batterie abklemmen.",clearCodes:"Codes l\xf6schen",ecuReset:"ECU Reset durchf\xfchren",finish:"\xdcberspringen (Fertig)",completed:"Abgeschlossen ",completedDesc:"Service-Aktionen erfolgreich. Sie k\xf6nnen das Fahrzeug neu starten.",hardResetDesc:"Alle Service-Aktionen erfolgreich abgeschlossen."},info:{desc:"Professionelle Motorrad- und Fahrzeugdiagnose-App.",upgrade:" Upgrade auf Cortex OBD2 Diagnostic Scanner PRO",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner befindet sich in der Entwicklung. Als fr\xfcher Nutzer sind alle Pro-Funktionen freigeschaltet!",helpGuide:"HILFE & ANLEITUNG",language:" Sprache / Language",support:"SUPPORT-CENTER",thanks:"Danke!",thanksDesc:"Vielen Dank f\xfcr Ihr Feedback.",sections:{live:{title:"LIVE-SENSOREN",content:"\xdcberwachen Sie Drehzahl, Geschwindigkeit, Temperatur und mehr in Echtzeit."},expertise:{title:"DIAGNOSE & GARANTIE",content:"Die App liest ECU-Fehlercodes und berechnet historische Daten."},tests:{title:"BATTERIE- / LEISTUNGSTESTS",content:"Messen Sie den Batteriezustand und Beschleunigungswerte."},hardware:{title:"HARDWARE-KOMPATIBILIT\xc4T",content:"ELM327 Bluetooth v1.5 wird empfohlen."},warnings:{title:"WICHTIGE WARNUNGEN",content:"Z\xfcndung AN, Motor AUS beim L\xf6schen von Codes."},onboarding:{title:"RECHTLICHE BERECHTIGUNGEN & ANONYME TELEMETRIE",content:"Um die Anwendungsqualit\xe4t und Fahrzeugkompatibilit\xe4t zu verbessern, k\xf6nnen w\xe4hrend der Diagnose erfasste, vollst\xe4ndig anonymisierte Motorparameter und Diagnose-Fehlercodes (ohne pers\xf6nliche Daten und VIN) auf unseren sicheren Servern analysiert werden. Indem Sie fortfahren, stimmen Sie diesen Bedingungen f\xfcr anonyme Telemetrie zu.\n\nBluetooth- und Standortberechtigungen sind erforderlich, um eine Verbindung mit dem Steuerger\xe4t Ihres Motorrads herzustellen."},featureCoding:{title:"VERSTECKTE FUNKTION ENTSPERREN & UDS-CODIERUNG",content:"Angetrieben durch unsere ISO 14229 UDS-Protokoll-Engine k\xf6nnen Sie Funktionen wie US-Parklichter, Nadelsteuerung, Hupenbest\xe4tigungssperre, Komfortfenster und DRL-Einstellungen f\xfcr VAG-, BMW-, Renault- und Dacia-Fahrzeuge sicher umschalten."},multiEcu:{title:"MULTI-ECU-SCANNEN ALLER MODULE",content:"Scannen und l\xf6schen Sie Fehlercodes au\xdferhalb des Motorsteuerger\xe4ts \u2013 einschlie\xdflich ABS, Airbag, Automatikgetriebe (TCU), Kombiinstrument, Klimaregelung (HVAC) und Karosseriesteuermodule (BCM)."},advancedDiagnostics:{title:"DCT-ANPASSUNG, DPF und HP-LEISTUNGSANZEIGE",content:"\u2022 DCT/DSG-Kupplungs-Kiss-Point-Lernen und Zur\xfccksetzen der Anpassung\n\u2022 DPF-Ru\xdfbeladung (%/g) und \xdcberwachung der Abgasregenerationstemperatur\n\u2022 Echtzeit-Kurz-/Langzeit-Kraftstoffanpassung (STFT/LTFT) und Lambda-Analyse\n\u2022 Dynamisches Live-Telemetriediagramm f\xfcr PS (PS) und Drehmoment (Nm)."},demoMode:{title:"DEMO-MODUS (SIMULATION)",content:"Testen und erkunden Sie die App ohne physische OBD2-Hardware. Erleben Sie vollst\xe4ndige CAN-Bus- und UDS-Diagnosefunktionen mit realistischer Echtzeit-Telemetriesimulation."}},reconfigurePermissions:"Onboarding & rechtliche Bedingungen erneut ausf\xfchren",upgradeAlert:"Early Access ",supportSubject:"Cortex OBD2 Diagnostic Scanner Support & Feedback",shareWithFriend:"MIT EINEM FREUND TEILEN",shareMessageText:"Entdecken Sie Fahrzeug-ECU-Fehlercodes und Live-Sensortelemetrie mit dem Cortex OBD2 Diagnostic Scanner!\n\nJetzt herunterladen:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:" \u2550\u2550\u2550 CORTEX OBD2 DIAGNOSEBERICHT \u2550\u2550\u2550 ",vehicleIdentity:" FAHRZEUG-IDENTIT\xc4T",vi