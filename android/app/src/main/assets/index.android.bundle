YNC",desc:"\u0417\u0430\u043c\u0435\u043d\u044f\u0435\u0442 \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044e \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u043e\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430 SYNC \u043d\u0430 \u043b\u043e\u0433\u043e\u0442\u0438\u043f ST/RS."},toyota_reverse_beep_mute:{name:"\u0417\u0430\u0434\u043d\u044f\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0430, \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u0432 \u0441\u0430\u043b\u043e\u043d\u0435, \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0437\u0432\u0443\u043a\u0430",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u043d\u0435\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0432\u043d\u0443\u0442\u0440\u0438 \u0441\u0430\u043b\u043e\u043d\u0430 \u0434\u043e \u043e\u0434\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430."},toyota_remote_window_drop:{name:"\u0423\u0434\u0430\u043b\u0435\u043d\u043d\u043e\u0435 \u043e\u043a\u043d\u043e \u0441 \u0431\u0440\u0435\u043b\u043a\u0430 \u0441\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u043d\u0438\u0437",desc:"\u041e\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u0441\u044f \u0432\u0441\u0435 \u0441\u0442\u0435\u043a\u043b\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u0438\u043a\u0438 \u043f\u0440\u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043d\u0438\u0438 \u043a\u043d\u043e\u043f\u043a\u0438 \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0431\u0440\u0435\u043b\u043e\u043a\u0430."},toyota_auto_lock_shift_p:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u0432\u0435\u0440\u0435\u0439 \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0447 (P -> D)",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u0435\u0442 \u0432\u0441\u0435 \u0434\u0432\u0435\u0440\u0438 \u043f\u0440\u0438 \u0432\u044b\u0445\u043e\u0434\u0435 \u0438\u0437 \u043f\u0430\u0440\u043a\u043e\u0432\u043e\u0447\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f."},peugeot_icockpit_theme_unlock:{name:"\u0422\u0435\u043c\u0430 Peugeot 3D i-Cockpit Performance",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0446\u0432\u0435\u0442\u043d\u044b\u0435 \u0442\u0435\u043c\u044b \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f Copper \u0438 Track Red \u0432 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u043c 3D-\u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0435."},jeep_offroad_pages_enable:{name:"\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0432\u043d\u0435\u0434\u043e\u0440\u043e\u0436\u043d\u0438\u043a\u0430 Jeep Uconnect",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u0443\u0433\u043b\u0430 \u043d\u0430\u043a\u043b\u043e\u043d\u0430/\u043a\u0440\u0435\u043d\u0430, \u0448\u0430\u0440\u043d\u0438\u0440\u043d\u043e\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0435\u0441 \u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 4x4."},hyundai_smart_welcome_mirror:{name:"\u041f\u043e\u0434\u0445\u043e\u0434 Smart Key \u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0417\u0435\u0440\u043a\u0430\u043b\u043e \u0440\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043a\u043e\u0432\u044b\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u043f\u0440\u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0438 \u043a \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0441\u043c\u0430\u0440\u0442-\u043a\u043b\u044e\u0447\u0430."},hyundai_one_touch_turn_7_flashes:{name:"\u0421\u0438\u0433\u043d\u0430\u043b \u0441\u043c\u0435\u043d\u044b \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435 (7 \u043c\u0438\u0433\u0430\u043d\u0438\u0439)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043c\u0438\u0433\u0430\u043d\u0438\u044f \u043c\u0438\u0433\u0430\u043d\u0438\u044f \u0432 \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435 \u0434\u043e 7."},hyundai_svm_camera_speed_extend:{name:"\u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043a\u0430\u043c\u0435\u0440\u044b \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u0437\u043e\u0440\u0430 360\xb0 (20 \u043a\u043c/\u0447)",desc:"\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 360-\u0433\u0440\u0430\u0434\u0443\u0441\u043d\u0443\u044e \u043f\u0430\u0440\u043a\u043e\u0432\u043e\u0447\u043d\u0443\u044e \u043a\u0430\u043c\u0435\u0440\u0443 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043d\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0434\u043e 20 \u043a\u043c/\u0447."},hyundai_n_performance_exhaust_flap:{name:"\u0412\u044b\u043f\u0443\u0441\u043a\u043d\u0430\u044f \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0430 N-Performance \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u041e\u0422\u041a\u0420\u042b\u0422\u0410",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u043f\u0430\u043d\u0430 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u043d\u0430 \u041e\u0422\u041a\u0420\u042b\u0422\u041e \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f."},vag_rain_closing_sunroof:{name:"\u0414\u043e\u0436\u0434\u044c \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0430\u0435\u0442\u0441\u044f (Regenschlie\xdfen)",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043b\u044e\u043a \u0438 \u043e\u043a\u043d\u0430 \u043f\u0440\u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0438 \u0434\u043e\u0436\u0434\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0430\u0440\u043a\u043e\u0432\u043a\u0438."},bmw_launch_control_unlock:{name:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u0432\u043e\u0434\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c \u0432 \u042d\u0411\u0423 \u0442\u0440\u0430\u043d\u0441\u043c\u0438\u0441\u0441\u0438\u0438."},mercedes_ambient_64_multi_zone:{name:"64-\u0446\u0432\u0435\u0442\u043d\u044b\u0439 \u043c\u043d\u043e\u0433\u043e\u0437\u043e\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c Ambient",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044e \u043c\u043d\u043e\u0433\u043e\u0437\u043e\u043d\u043d\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u043e\u0432\u043e\u0433\u043e \u0446\u0438\u043a\u043b\u0430 \u0432\u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u043c \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0438 MBUX."},ford_trailer_brake_activation:{name:"\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440 \u0442\u043e\u0440\u043c\u043e\u0437\u043e\u0432 \u043f\u0440\u0438\u0446\u0435\u043f\u0430 (TBC) \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0435 \u043c\u0435\u043d\u044e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u0430 \u0442\u043e\u0440\u043c\u043e\u0437\u043e\u0432 \u043f\u0440\u0438\u0446\u0435\u043f\u0430 \u0432 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432."},gm_afm_dfm_cylinder_deactivation_disable:{name:"\u0426\u0438\u043b\u0438\u043d\u0434\u0440\u043e\u0432\u044b\u0439 \u0437\u0430\u043c\u043e\u043a AFM/DFM V8 (\u0431\u0435\u0437 \u043f\u0430\u0434\u0435\u043d\u0438\u044f V4)",desc:"\u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0432 8-\u0446\u0438\u043b\u0438\u043d\u0434\u0440\u043e\u0432\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u044e V4."},gm_remote_start_time_extend:{name:"\u041f\u0440\u043e\u0434\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430 (20 \u043c\u0438\u043d\u0443\u0442)",desc:"\u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0441 \u0437\u0430\u0432\u043e\u0434\u0441\u043a\u043e\u0433\u043e \u0431\u0440\u0435\u043b\u043e\u043a\u0430 \u0441 10 \u0434\u043e 20 \u043c\u0438\u043d\u0443\u0442."},dodge_srt_performance_pages:{name:"\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 SRT \u0438 \u0440\u0435\u0436\u0438\u043c\u044b \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0442\u0430\u0439\u043c\u0435\u0440\u0430\u043c \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f Uconnect 0\u2013100, \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u0435\u043b\u044e \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043a\u0438 \u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e \u0437\u0430\u043f\u0443\u0441\u043a\u0430."},ram_bambi_mode_fog:{name:"\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0435 \u0444\u0430\u0440\u044b \u0434\u043b\u044f \u0433\u0440\u0443\u0437\u043e\u0432\u0438\u043a\u043e\u0432 RAM \u0441 \u0434\u0430\u043b\u044c\u043d\u0438\u043c \u0441\u0432\u0435\u0442\u043e\u043c",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u043c \u0444\u0430\u0440\u0430\u043c RAM \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0444\u0430\u0440\u0430\u043c\u0438 \u0434\u0430\u043b\u044c\u043d\u0435\u0433\u043e \u0441\u0432\u0435\u0442\u0430."},byd_avas_pedestrian_siren_mute:{name:"AVAS EV \u041e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043d\u0438\u0437\u043a\u043e\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u043e\u0439 \u0441\u0438\u0440\u0435\u043d\u044b",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043d\u0438\u0437\u043a\u043e\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u0443\u044e \u0441\u0438\u0440\u0435\u043d\u0443 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043d\u0438\u0436\u0435 30 \u043a\u043c/\u0447."},chery_isa_overspeed_chime_mute:{name:"\u041e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043f\u0440\u0435\u0432\u044b\u0448\u0435\u043d\u0438\u0438 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 ISA",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b, \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u044e\u0449\u0438\u0439 \u043e \u043f\u0440\u0435\u0432\u044b\u0448\u0435\u043d\u0438\u0438 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 80/120 \u043a\u043c/\u0447 \u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044f\u0445 Tiggo/MG."},mg_ev_battery_preconditioning_toggle:{name:"\u0420\u0443\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u0433\u0440\u0435\u0432\u0430 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u043d\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 EV \u0441 \u0431\u044b\u0441\u0442\u0440\u043e\u0439 \u0437\u0430\u0440\u044f\u0434\u043a\u043e\u0439",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0440\u0443\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u0433\u0440\u0435\u0432\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u043f\u0435\u0440\u0435\u0434 \u0431\u044b\u0441\u0442\u0440\u043e\u0439 \u0437\u0430\u0440\u044f\u0434\u043a\u043e\u0439 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c \u0442\u043e\u043a\u043e\u043c."},chery_dms_fatigue_camera_mute:{name:"\u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043a\u0430\u043c\u0435\u0440\u044b \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f (DMS)",desc:"\u0423\u043c\u0435\u043d\u044c\u0448\u0430\u0435\u0442 \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e\u0431 \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u0438 \u0433\u043b\u0430\u0437 \u043d\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0439 \u043a\u043e\u043b\u043e\u043d\u043a\u0435."},honda_walk_away_auto_lock:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0432\u0435\u0440\u043d\u043e\u0439 \u0437\u0430\u043c\u043e\u043a Walk-Away",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u0435\u0442 \u0432\u0441\u0435 \u0434\u0432\u0435\u0440\u0438, \u043a\u043e\u0433\u0434\u0430 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0431\u0440\u0435\u043b\u043e\u043a\u0430 \u043e\u0442\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 2 \u043c\u0435\u0442\u0440\u043e\u0432."},subaru_avh_auto_hold_memory:{name:"\u0420\u0435\u0436\u0438\u043c \u043f\u0430\u043c\u044f\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f (AVH)",desc:"\u0417\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f/\u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0442\u043e\u0440\u043c\u043e\u0437\u0430 AVH \u0432\u043e \u0432\u0441\u0435\u0445 \u0446\u0438\u043a\u043b\u0430\u0445 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},volvo_start_stop_default_off:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0442\u0430\u0440\u0442-\u0441\u0442\u043e\u043f \u0420\u0435\u0436\u0438\u043c \u0412\u042b\u041a\u041b \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f Start-Stop \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0432 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0412\u042b\u041a\u041b \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},volvo_polestar_digital_theme:{name:"\u0422\u0435\u043c\u0430 Polarstar Blue Digital Cluster",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0444\u0438\u0440\u043c\u0435\u043d\u043d\u0443\u044e \u0441\u0438\u043d\u044e\u044e \u0442\u0435\u043c\u0443 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0448\u043a\u0430\u043b\u044b Polestar \u043d\u0430 \u0434\u0438\u0441\u043f\u043b\u0435\u0435 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f Volvo."},vag_virtual_cockpit_r_theme:{name:"\u0422\u0435\u043c\u044b \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 Virtual Cockpit R/S/Cupra",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0442\u0435\u043c\u044b \u0440\u0430\u0431\u043e\u0442\u044b \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0442\u0430\u0445\u043e\u043c\u0435\u0442\u0440\u0430 R-Line, S-Line \u0438 Cupra \u0432 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043a\u0430\u0431\u0438\u043d\u0435."},vag_sound_symposer_mute:{name:"Sound Symposer \u0414\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f \u043b\u043e\u0436\u043d\u043e\u0433\u043e \u0448\u0443\u043c\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440 \u043b\u043e\u0436\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0441\u0430\u043b\u043e\u043d\u043d\u043e\u0433\u043e \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0434\u043b\u044f \u0447\u0438\u0441\u0442\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430 \u0432\u044b\u0445\u043b\u043e\u043f\u0430."},vag_wireless_carplay_enable:{name:"\u0411\u0435\u0441\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u0430\u044f \u0441\u0432\u044f\u0437\u044c Apple CarPlay \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f Android",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0431\u0435\u0441\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u0443\u044e \u0441\u0432\u044f\u0437\u044c Wi-Fi 5 \u0413\u0413\u0446 Apple CarPlay \u0438 Android Auto \u043d\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u0445 MIB2.5/MIB3."},vag_offroad_telemetry_menu:{name:"MIB Offroad \u0422\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044f \u0438 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u0432",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0443\u0433\u043e\u043b \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043c\u0430\u0441\u043b\u0430, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043e\u0445\u043b\u0430\u0436\u0434\u0430\u044e\u0449\u0435\u0439 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0438 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0432\u044b\u0441\u043e\u0442\u044b \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 MIB."},vag_easy_entry_driver_seat:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430 \u0441\u043f\u0438\u043d\u043a\u0438 \u0441\u0438\u0434\u0435\u043d\u044c\u044f \u0441 \u043b\u0435\u0433\u043a\u0438\u043c \u0432\u0445\u043e\u0434\u043e\u043c \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043e\u043c",desc:"\u041f\u0440\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438 \u0434\u0432\u0435\u0440\u0438 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0435 \u0441\u0438\u0434\u0435\u043d\u044c\u0435 \u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043e\u043c \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044f \u043d\u0430\u0437\u0430\u0434 \u043d\u0430 5 \u0441\u043c, \u0447\u0442\u043e \u043e\u0431\u043b\u0435\u0433\u0447\u0430\u0435\u0442 \u043f\u043e\u0441\u0430\u0434\u043a\u0443 \u0432 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c."},vag_hba_memory_state:{name:"\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043f\u0430\u043c\u044f\u0442\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0430\u043b\u044c\u043d\u0438\u043c \u0441\u0432\u0435\u0442\u043e\u043c (HBA)",desc:"\u0417\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0430\u043b\u044c\u043d\u0438\u043c \u0441\u0432\u0435\u0442\u043e\u043c \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u043c \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},vag_battery_soc_display:{name:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0437\u0430\u0440\u044f\u0434\u0430 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 (% SOC)",desc:"\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0442\u043e\u0447\u043d\u044b\u0439 \u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u0437\u0430\u0440\u044f\u0434\u0430 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 (% SOC) \u043d\u0430 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432, \u043a\u043e\u0433\u0434\u0430 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u043d\u043e\u043f\u043a\u0430 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f."},bmw_idrive7_m_animation:{name:"\u0410\u043d\u0438\u043c\u0430\u0446\u0438\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0430 iDrive 7/8 M-Performance",desc:"\u0417\u0430\u043c\u0435\u043d\u044f\u0435\u0442 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u044d\u043a\u0440\u0430\u043d\u0430 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 iDrive \u043d\u0430 \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044e \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0430 M-Performance \u0438\u043b\u0438 M-GmbH."},bmw_bowers_wilkins_audio_profiles:{name:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u0432\u0438\u0436\u043a\u0430 3D-\u0437\u0432\u0443\u043a\u0430 Bowers & Wilkins",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0430\u0443\u0434\u0438\u043e\u043f\u0440\u043e\u0444\u0438\u043b\u0438 Bowers & Wilkins Concert, Studio \u0438 Stage DSP \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445 HiFi."},bmw_hitch_zoom_camera:{name:"\u041a\u0430\u043c\u0435\u0440\u0430 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0432\u0438\u0434\u0430, \u0440\u0435\u0436\u0438\u043c \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u0438\u0446\u0435\u043f\u043d\u043e\u0433\u043e \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0440\u0435\u0436\u0438\u043c \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u044f \u0441\u0446\u0435\u043f\u043d\u043e\u0433\u043e \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u043f\u0440\u0438\u0446\u0435\u043f\u0430 \u0441\u0432\u0435\u0440\u0445\u0443 \u0432\u043d\u0438\u0437 \u043f\u0440\u0438 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435 \u0441 \u043a\u0430\u043c\u0435\u0440\u044b \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0432\u0438\u0434\u0430."},bmw_secure_idle_protection:{name:"\u041d\u0430\u0434\u0435\u0436\u043d\u0430\u044f \u0437\u0430\u0449\u0438\u0442\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u043c \u0445\u043e\u0434\u0443 \u043e\u0442 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447",desc:"\u0411\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u043a\u043e\u0440\u043e\u0431\u043a\u0443 \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043f\u0430\u0440\u043a\u043e\u0432\u043a\u0438, \u0435\u0441\u043b\u0438 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u043f\u043e\u043a\u0438\u0434\u0430\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0441 \u0431\u0440\u0435\u043b\u043e\u043a\u043e\u043c."},bmw_seatbelt_handover_mute:{name:"\u0414\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u044b\u0447\u0430\u0433\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0440\u0435\u043c\u043d\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043a\u0443\u043f\u0435",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043c\u043e\u0442\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0443\u0434\u043b\u0438\u043d\u0438\u0442\u0435\u043b\u044c \u0440\u0435\u043c\u043d\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u043a\u0443\u043f\u0435 4-\u0439 \u0438 2-\u0439 \u0441\u0435\u0440\u0438\u0439."},bmw_auto_heat_threshold_5c:{name:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u0434\u043e\u0433\u0440\u0435\u0432\u0430 \u0441\u0438\u0434\u0435\u043d\u044c\u044f \u0438 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 (+5\xb0C)",desc:"\u0417\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u043e\u0433\u0440\u0435\u0432 \u0441\u0438\u0434\u0435\u043d\u0438\u0439 \u0438 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430, \u043a\u043e\u0433\u0434\u0430 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044b \u043f\u0430\u0434\u0430\u0435\u0442 \u043d\u0438\u0436\u0435 5\xb0C."},mercedes_amg_track_pace_unlock:{name:"MBUX AMG \u0422\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044f Track Pace \u0438 \u0442\u0430\u0439\u043c\u0435\u0440 \u043a\u0440\u0443\u0433\u0430",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043a\u0440\u0443\u0433\u0430, \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044e \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f \u0438 \u0433\u0440\u0430\u0444\u0438\u043a\u0438 \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043a\u0438 \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 MBUX."},mercedes_drive_mode_last_memory:{name:"\u0414\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u044b\u0431\u043e\u0440 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f. \u041f\u0430\u043c\u044f\u0442\u044c",desc:"\u0417\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f (\u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439/\u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u044b\u0439) \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},mercedes_proximity_360_camera_auto:{name:"\u0414\u0430\u0442\u0447\u0438\u043a \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044f, \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440 \u043a\u0430\u043c\u0435\u0440\u044b \u043d\u0430 360\xb0",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u044d\u043a\u0440\u0430\u043d \u043d\u0430 \u043a\u0430\u043c\u0435\u0440\u0443 360\xb0, \u043a\u043e\u0433\u0434\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0435 \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u044e\u0442 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u044b\u0441\u043e\u0442\u043e\u0439 \u043c\u0435\u043d\u0435\u0435 50 \u0441\u043c."},ford_sync_climate_screen_unlock:{name:"\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043a\u043b\u0438\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f SYNC3 / SYNC4 \u0441 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u044b\u043c \u044d\u043a\u0440\u0430\u043d\u043e\u043c",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043a\u043b\u0438\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c, \u043f\u043e\u0434\u043e\u0433\u0440\u0435\u0432 \u0441\u0438\u0434\u0435\u043d\u044c\u044f \u0438 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0443\u044e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0433\u043e \u043f\u043e\u0442\u043e\u043a\u0430."},ford_turn_signal_5_flashes:{name:"\u0421\u0438\u0433\u043d\u0430\u043b \u0441\u043c\u0435\u043d\u044b \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435 (5 \u043c\u0438\u0433\u0430\u043d\u0438\u0439)",desc:"\u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435 \u0441 3 \u0434\u043e 5 \u043c\u0438\u0433\u0430\u043d\u0438\u0439."},ford_auto_engine_shutdown_disable:{name:"\u041e\u0442\u043c\u0435\u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043d\u0430 30-\u043c\u0438\u043d\u0443\u0442\u043d\u043e\u043c \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u043c \u0445\u043e\u0434\u0443",desc:"\u041f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043f\u043e\u0441\u043b\u0435 30 \u043c\u0438\u043d\u0443\u0442 \u043f\u0440\u043e\u0441\u0442\u043e\u044f (\u0434\u043b\u044f \u043a\u0435\u043c\u043f\u0438\u043d\u0433\u0430 \u0438\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0440\u043e\u0437\u0435\u0442\u043a\u0438)."},ev_battery_preheat_manual_switch:{name:"\u0420\u0443\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u0433\u0440\u0435\u0432\u0430 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044f (\u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u043a \u0431\u044b\u0441\u0442\u0440\u043e\u0439 \u0437\u0430\u0440\u044f\u0434\u043a\u0435 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c \u0442\u043e\u043a\u043e\u043c)",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430\u0433\u0440\u0435\u0442\u044c \u0431\u0430\u0442\u0430\u0440\u0435\u044e \u0434\u043e 25\xb0C \u043f\u0435\u0440\u0435\u0434 \u0431\u044b\u0441\u0442\u0440\u043e\u0439 \u0437\u0430\u0440\u044f\u0434\u043a\u043e\u0439 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c \u0442\u043e\u043a\u043e\u043c \u0431\u0435\u0437 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u043f\u043e \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443."},ev_v2l_power_output_expand:{name:"V2L (\u043e\u0442 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u043a \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435) \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0432\u044b\u0445\u043e\u0434\u043d\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 220 \u0412 (3,6 \u043a\u0412\u0442)",desc:"\u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043f\u0440\u0435\u0434\u0435\u043b \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 \u0432\u043d\u0435\u0448\u043d\u0435\u0439 \u0431\u044b\u0442\u043e\u0432\u043e\u0439 \u0440\u043e\u0437\u0435\u0442\u043a\u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u043e\u043a\u0430 220 \u0412 V2L \u0441 2,2 \u043a\u0412\u0442 \u0434\u043e 3,6 \u043a\u0412\u0442."},ev_one_pedal_regen_force_level3:{name:"\u041f\u0440\u0438\u0432\u043e\u0434 \u0441 \u043e\u0434\u043d\u043e\u0439 \u043f\u0435\u0434\u0430\u043b\u044c\u044e. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0440\u0435\u043a\u0443\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u0435. \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e.",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0440\u0435\u043a\u0443\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u0435 (\u0440\u0435\u0436\u0438\u043c \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043e\u0434\u043d\u043e\u0439 \u043f\u0435\u0434\u0430\u043b\u044c\u044e) \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},byd_soc_max_charge_target_limit:{name:"\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u0435\u043b \u0437\u0430\u0440\u044f\u0434\u0430 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 BYD \u0434\u043b\u044f \u0437\u0430\u0449\u0438\u0442\u044b \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 (80\xa0% / 90\xa0%)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u0435\u043b \u0437\u0430\u0440\u044f\u0434\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e/\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0433\u043e \u0442\u043e\u043a\u0430 \u043d\u0430 80\xa0% \u0438\u043b\u0438 90\xa0%, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043b\u0438\u0442\u044c \u0441\u0440\u043e\u043a \u0441\u043b\u0443\u0436\u0431\u044b \u0431\u043b\u0435\u0439\u0434-\u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430."},byd_dmi_forced_pure_ev_speed_override:{name:"BYD DM-i Pure EV \u0440\u0435\u0436\u0438\u043c \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f",desc:"\u0411\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u043f\u0443\u0441\u043a \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 EV \u043d\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0434\u043e 130 \u043a\u043c/\u0447 \u0434\u0430\u0436\u0435 \u043f\u0440\u0438 \u043f\u043e\u043b\u043d\u043e\u043c \u0440\u0430\u0437\u0433\u043e\u043d\u0435."},byd_vtol_v2v_rescue_charge_mode:{name:"\u0420\u0435\u0436\u0438\u043c \u0441\u043f\u0430\u0441\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0440\u044f\u0434\u043a\u0438 BYD VTOL (\u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c-\u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c)",desc:"\u0420\