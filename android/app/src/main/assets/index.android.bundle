u0629 Renault Sport RS",desc:"\u062a\u0645\u0643\u064a\u0646 \u0642\u0648\u0629 \u0627\u0644\u062c\u0627\u0630\u0628\u064a\u0629 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0648\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u062a\u0648\u0631\u0628\u0648 \u0648\u0642\u064a\u0627\u0633 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0632\u064a\u062a \u0639\u0646 \u0628\u0639\u062f \u0639\u0644\u0649 R-Link."},renault_duster_mirror_fold:{name:"\u0645\u0646\u0641\u0636\u0629 \u0645\u0631\u0622\u0629 \u0623\u0648\u062a\u0648\u0645\u0627\u062a\u064a\u0643\u064a\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0637\u064a \u0639\u0644\u0649 \u0627\u0644\u0642\u0641\u0644",desc:"\u0637\u064a \u0627\u0644\u0645\u0631\u0627\u064a\u0627 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0628\u0631 \u0623\u0645\u0631 \u0627\u0644\u0642\u0641\u0644 \u0627\u0644\u0645\u0631\u0643\u0632\u064a BCM."},ford_bambi_mode_fog_light:{name:"\u0648\u0636\u0639\u064a\u0629 \u0628\u0627\u0645\u0628\u064a (\u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u0639\u0627\u0644\u064a + \u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0636\u0628\u0627\u0628)",desc:"\u064a\u0633\u0645\u062d \u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0636\u0628\u0627\u0628 \u0628\u0627\u0644\u0628\u0642\u0627\u0621 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0639\u0646\u062f \u062a\u0646\u0634\u064a\u0637 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0630\u0627\u062a \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u0639\u0627\u0644\u064a."},ford_st_rs_boot_animation:{name:"\u0634\u0627\u0634\u0629 \u0627\u0644\u062a\u0645\u0647\u064a\u062f \u0644\u0645\u0632\u0627\u0645\u0646\u0629 \u0623\u062f\u0627\u0621 ST/RS",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 \u0644\u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 \u0634\u0627\u0634\u0629 \u0627\u0644\u0644\u0645\u0633 SYNC \u0625\u0644\u0649 \u0634\u0639\u0627\u0631 ST / RS."},toyota_reverse_beep_mute:{name:"\u0643\u062a\u0645 \u0635\u0648\u062a \u0635\u0641\u064a\u0631 \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0644\u0644\u0639\u062a\u0627\u062f \u0627\u0644\u0639\u0643\u0633\u064a",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u0643\u062a\u0645 \u0635\u0648\u062a \u0631\u0646\u064a\u0646 \u0627\u0644\u062a\u0631\u0648\u0633 \u0627\u0644\u0639\u0643\u0633\u064a \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0628\u0625\u0635\u062f\u0627\u0631 \u0635\u0648\u062a \u062a\u0646\u0628\u064a\u0647 \u0648\u0627\u062d\u062f."},toyota_remote_window_drop:{name:"\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0639\u0646 \u0628\u0639\u062f \u0628\u0645\u0641\u062a\u0627\u062d \u0641\u0648\u0628 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0637\u064a",desc:"\u064a\u062a\u0645 \u0637\u064a \u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0644\u0644\u0623\u0633\u0641\u0644 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644 \u0627\u0644\u0631\u0626\u064a\u0633\u064a."},toyota_auto_lock_shift_p:{name:"\u0642\u0641\u0644 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u062a\u0631\u0648\u0633 (P -> D)",desc:"\u064a\u062a\u0645 \u0642\u0641\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0646 \u0648\u0636\u0639 \u0627\u0644\u0648\u0642\u0648\u0641."},peugeot_icockpit_theme_unlock:{name:"\u0628\u064a\u062c\u0648 3D i-Cockpit Performance Theme",desc:"\u064a\u0641\u062a\u062d \u0633\u0645\u0627\u062a \u0627\u0644\u0639\u0631\u0636 \u0630\u0627\u062a \u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0646\u062d\u0627\u0633\u064a \u0648\u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0631\u0642\u0645\u064a\u0629 \u062b\u0644\u0627\u062b\u064a\u0629 \u0627\u0644\u0623\u0628\u0639\u0627\u062f."},jeep_offroad_pages_enable:{name:"\u0635\u0641\u062d\u0627\u062a \u062c\u064a\u0628 \u064a\u0648\u0643\u0648\u0646\u064a\u0643\u062a \u0644\u0644\u0637\u0631\u0642 \u0627\u0644\u0648\u0639\u0631\u0629",desc:"\u062a\u0645\u0643\u0646 \u0645\u0642\u0627\u064a\u064a\u0633 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0645\u0644\u0639\u0628/\u0627\u0644\u062a\u062f\u062d\u0631\u062c\u060c \u0648\u062a\u0639\u0628\u064a\u0631 \u0627\u0644\u0639\u062c\u0644\u0629\u060c \u0648\u062d\u0627\u0644\u0629 \u0642\u0641\u0644 4x4."},hyundai_smart_welcome_mirror:{name:"\u0646\u0647\u062c \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a: \u0645\u0631\u0622\u0629 \u0627\u0644\u062a\u0631\u062d\u064a\u0628 \u062a\u062a\u0643\u0634\u0641",desc:"\u064a\u062a\u0645 \u0641\u062a\u062d \u0627\u0644\u0645\u0631\u0627\u064a\u0627 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0628 \u0645\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a."},hyundai_one_touch_turn_7_flashes:{name:"\u0625\u0634\u0627\u0631\u0629 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0633\u0627\u0631 \u0628\u0644\u0645\u0633\u0629 \u0648\u0627\u062d\u062f\u0629 (7 \u0648\u0645\u0636\u0627\u062a)",desc:"\u064a\u0636\u062