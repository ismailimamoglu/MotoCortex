9 VIN",vinRequiredDesc:"\u0393\u03b9\u03b1 \u03bd\u03b1 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03b5\u03af\u03c4\u03b5, \u03bf \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03c0\u03bb\u03b1\u03b9\u03c3\u03af\u03bf\u03c5 (VIN) \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03ae \u03bd\u03b1 \u03b3\u03c1\u03ac\u03c6\u03b5\u03c4\u03b1\u03b9 \u03c7\u03b5\u03b9\u03c1\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03b1.",missingInfo:"\u039b\u03b5\u03af\u03c0\u03bf\u03c5\u03bd \u03c0\u03bb\u03b7\u03c1\u03bf\u03c6\u03bf\u03c1\u03af\u03b5\u03c2",missingInfoDesc:"\u03a3\u03c5\u03bc\u03c0\u03bb\u03b7\u03c1\u03ce\u03c3\u03c4\u03b5 \u03c4\u03bf \u03c0\u03b5\u03b4\u03af\u03bf \u039c\u03ac\u03c1\u03ba\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03bf\u03bd\u03c4\u03ad\u03bb\u03bf.",saved:"\u0391\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03cd\u03c4\u03b7\u03ba\u03b5 ",savedDesc:"\u03a0\u03c1\u03bf\u03c3\u03c4\u03ad\u03b8\u03b7\u03ba\u03b5 \u03c3\u03c4\u03bf \u03b3\u03ba\u03b1\u03c1\u03ac\u03b6 \u03c9\u03c2 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03bf\u03b3\u03bd\u03c9\u03bc\u03bf\u03c3\u03cd\u03bd\u03b7\u03c2.",connRequired:"\u0391\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7",connRequiredDesc:"\u03a3\u03c5\u03bd\u03b4\u03b5\u03b8\u03b5\u03af\u03c4\u03b5 \u03c0\u03c1\u03ce\u03c4\u03b1 \u03c3\u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03be\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03b5\u03c4\u03b5 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1.",chronicFaultsTitle:"\u03a3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03a7\u03c1\u03cc\u03bd\u03b9\u03b1 \u03a0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03b1",chronicFaultsObs:"{{code}}(\u03a0\u03b1\u03c1\u03b1\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7:{{days}}\u0394\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03ae \u03b7\u03bc\u03ad\u03c1\u03b1 / \u03a3\u03cd\u03bd\u03bf\u03bb\u03bf:{{total}}\u03a6\u03bf\u03c1\u03ad\u03c2)",chronicFaultsPending:"\u03a3\u03c5\u03bb\u03bb\u03bf\u03b3\u03ae \u0394\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd / \u0391\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03a3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ce\u03bd",notScanned:"\u0394\u03b5\u03bd \u03ad\u03c7\u03b5\u03b9 \u03c3\u03b1\u03c1\u03c9\u03b8\u03b5\u03af",notScannedDesc:"\u03a0\u03b1\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03c3\u03ac\u03c1\u03c9\u03c3\u03b7\u03c2 \u03b5\u03c0\u03ac\u03bd\u03c9 \u03b4\u03b5\u03be\u03b9\u03ac \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03b2\u03ac\u03c3\u03b5\u03c4\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03cd\u03c2.",scanFailed:"\u0397 \u03a3\u0391\u03a1\u03a9\u03a3\u0397 \u0391\u03a0\u039f\u03a4\u03a5\u03a7\u0395",errTimeout:"Error: Connection Timeout (TIMEOUT)\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost (CONNECTION_LOST)\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\n(HARDWARE_FATAL_RECOVERY_FAILED)\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error (ERROR_UNABLE_TO_READ)\nECU trouble codes could not be read.",scannedSystems:"\u03a3\u0391\u03a1\u03a9\u039c\u0395\u039d\u0391 \u03a3\u03a5\u03a3\u03a4\u0397\u039c\u0391\u03a4\u0391",moduleEngine:"\u039c\u03bf\u03bd\u03ac\u03b4\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 (ECU)",moduleAbs:"\u03a3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03b1\u03bd\u03c4\u03b9\u03bc\u03c0\u03bb\u03bf\u03ba\u03b1\u03c1\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd (ABS)",moduleTcm:"\u039c\u03bf\u03bd\u03ac\u03b4\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03ba\u03b9\u03b2\u03c9\u03c4\u03af\u03bf\u03c5 \u03c4\u03b1\u03c7\u03c5\u03c4\u03ae\u03c4\u03c9\u03bd (TCM)",moduleBcm:"\u039c\u03bf\u03bd\u03ac\u03b4\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03c3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 (BCM)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" \u03a0\u03a1\u039f\u0395\u0399\u0394\u039f\u03a0\u039f\u0399\u0397\u03a3\u0397 \u0391\u03a3\u03a6\u0391\u039b\u0395\u0399\u0391\u03a3",safetyWarningDesc:"\u039a\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03b1\u03c5\u03c4\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1\u03c2: \u2022 \u0397 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u039f\u039d \u2022 \u039f \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf\u03c2 \u2022 \u039c\u03b7\u03bd \u03b5\u03ba\u03ba\u03b9\u03bd\u03b5\u03af\u03c4\u03b5 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u0398\u03ad\u03bb\u03b5\u03c4\u03b5 \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03b5\u03c4\u03b5;",step1:"\u0392\u03ae\u03bc\u03b1 1: \u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03ba\u03c9\u03b4\u03b9\u03ba\u03ce\u03bd \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd",step1Desc:"\u038c\u03bb\u03bf\u03b9 \u03bf\u03b9 \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03bf\u03b9 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2 (DTC) \u03ba\u03b1\u03b9 \u03b7 \u03bb\u03c5\u03c7\u03bd\u03af\u03b1 Check Engine \u03b8\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03bf\u03cd\u03bd. \u039f\u03b9 \u03c4\u03b9\u03bc\u03ad\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03bf\u03c0\u03ae\u03c2 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u03b8\u03b1 \u03bc\u03b7\u03b4\u03b5\u03bd\u03b9\u03c3\u03c4\u03bf\u03cd\u03bd. \u0391\u03c5\u03c4\u03ae \u03b7 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1 \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b1\u03bd\u03b1\u03b9\u03c1\u03b5\u03b8\u03b5\u03af!",step2:"\u0392\u03ae\u03bc\u03b1 2: \u03a3\u03ba\u03bb\u03b7\u03c1\u03ae \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac ECU",step2Desc:"\u039c\u03b9\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac (Hard Reset) \u03b8\u03b1 \u03c3\u03c4\u03b1\u03bb\u03b5\u03af \u03c3\u03c4\u03bf\u03bd \u03c5\u03c0\u03bf\u03bb\u03bf\u03b3\u03b9\u03c3\u03c4\u03ae \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1. \u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03cc\u03c0\u03c9\u03c2 \u03b7 \u03b1\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b7 \u03b5\u03b3\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2. \u0395\u03af\u03bd\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c3\u03b5 ECU \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03bf\u03c5\u03bd. \u0394\u03b5\u03bd \u03ba\u03ac\u03bd\u03b5\u03b9 \u03ba\u03b1\u03ba\u03cc.",clearCodes:"\u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03ba\u03c9\u03b4\u03b9\u03ba\u03ce\u03bd",ecuReset:"\u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03ba\u03c9\u03b4\u03b9\u03ba\u03ce\u03bd \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd",finish:"\u03a0\u03b1\u03c1\u03ac\u03bb\u03b5\u03b9\u03c8\u03b7 (\u03a4\u03ad\u03bb\u03bf\u03c2)",completed:"\u039f\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 ",completedDesc:"\u039f\u03b9 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b1\u03bd \u03bc\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03b9\u03bd\u03ae\u03c3\u03b5\u03c4\u03b5 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1.",hardResetDesc:"\u038c\u03bb\u03b5\u03c2 \u03bf\u03b9 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03ad\u03c7\u03bf\u03c5\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03b8\u03b5\u03af \u03bc\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1. \u2022 \u039f\u03b9 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03b7\u03ba\u03b1\u03bd \u2022 \u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c0\u03b5\u03c1\u03b9\u03ba\u03bf\u03c0\u03ae\u03c2 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u2022 \u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac ECU \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03b9\u03bd\u03ae\u03c3\u03b5\u03c4\u03b5 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1."},info:{desc:"\u0395\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7\u03c2 \u03bc\u03bf\u03c4\u03bf\u03c3\u03c5\u03ba\u03bb\u03b5\u03c4\u03ce\u03bd \u03ba\u03b1\u03b9 \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd. \u03a3\u03c5\u03bc\u03b2\u03b1\u03c4\u03cc \u03bc\u03b5 \u03cc\u03bb\u03b1 \u03c4\u03b1 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1.",upgrade:" \u0391\u03bd\u03b1\u03b2\u03ac\u03b8\u03bc\u03b9\u03c3\u03b7 \u03c3\u03b5 Cortex OBD2 Diagnostic Scanner PRO",upgradeAlertDesc:"\u03a4\u03bf Cortex OBD2 Diagnostic Scanner \u03b2\u03c1\u03af\u03c3\u03ba\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03c3\u03b5 \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7. \u0394\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03bf\u03c5 \u03cc\u03c4\u03b9 \u03b5\u03af\u03c3\u03c4\u03b5 \u03bf \u03c0\u03c1\u03ce\u03c4\u03bf\u03c2 \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03bc\u03b1\u03c2, \u03cc\u03bb\u03b5\u03c2 \u03bf\u03b9 \u03b5\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1\u03c4\u03b9\u03ba\u03ad\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b5\u03c2 \u03c3\u03b5 \u03b5\u03c3\u03ac\u03c2 \u03c4\u03ce\u03c1\u03b1. \u03a4\u03b1 \u03c3\u03c7\u03cc\u03bb\u03b9\u03ac \u03c3\u03b1\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03bf\u03bb\u03cd \u03c0\u03bf\u03bb\u03cd\u03c4\u03b9\u03bc\u03b1 \u03b3\u03b9\u03b1 \u03b5\u03bc\u03ac\u03c2!",helpGuide:"\u0392\u039f\u0397\u0398\u0397\u03a3\u03a4\u0395 \u039a\u0391\u0399 \u039f\u0394\u0397\u0393\u0397\u03a3\u03a4\u0395",language:" \u0393\u03bb\u03ce\u03c3\u03c3\u03b1 / \u0393\u03bb\u03ce\u03c3\u03c3\u03b1 / \u039c\u03c0\u03b1\u03c7\u03ac\u03c3\u03b1",support:"\u039a\u0395\u039d\u03a4\u03a1\u039f \u03a5\u03a0\u039f\u03a3\u03a4\u0397\u03a1\u0399\u039e\u0397\u03a3",supportSubject:"\u03a5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7 \u03ba\u03b1\u03b9 \u03c3\u03c7\u03cc\u03bb\u03b9\u03b1 Cortex OBD2 Diagnostic Scanner",thanks:"\u0395\u03c5\u03c7\u03b1\u03c1\u03b9\u03c3\u03c4\u03ce!",thanksDesc:"\u03a3\u03b1\u03c2 \u03b5\u03c5\u03c7\u03b1\u03c1\u03b9\u03c3\u03c4\u03bf\u03cd\u03bc\u03b5 \u03b3\u03b9\u03b1 \u03c4\u03b1 \u03c3\u03c7\u03cc\u03bb\u03b9\u03ac \u03c3\u03b1\u03c2. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03bc\u03b1\u03c2 \u03b1\u03c6\u03ae\u03c3\u03b5\u03c4\u03b5 \u03ad\u03bd\u03b1 \u03c3\u03c7\u03cc\u03bb\u03b9\u03bf \u03c3\u03c4\u03bf Play Store.",sections:{live:{title:"\u0391\u0399\u03a3\u0398\u0397\u03a4\u0397\u03a1\u0395\u03a3 \u0396\u03a9\u039d\u03a4\u0391\u039d\u0397\u03a3 \u03a0\u0391\u03a1\u0391\u039a\u039f\u039b\u039f\u03a5\u0398\u0397\u03a3\u0397\u03a3",content:"\u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03b5\u03af\u03c4\u03b5 \u03ac\u03bc\u03b5\u03c3\u03b1 RPM, \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1, \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1, \u03b8\u03ad\u03c3\u03b7 \u03c0\u03b5\u03c4\u03b1\u03bb\u03bf\u03cd\u03b4\u03b1\u03c2, \u03c4\u03ac\u03c3\u03b7 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2, \u03c6\u03bf\u03c1\u03c4\u03af\u03bf \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1, \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03b1\u03ad\u03c1\u03b1 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03af\u03b5\u03c3\u03b7 \u03c0\u03bf\u03bb\u03bb\u03b1\u03c0\u03bb\u03ae\u03c2 (MAP). \u039f\u03b9 \u03c4\u03b9\u03bc\u03ad\u03c2 \u03b1\u03bd\u03b1\u03bd\u03b5\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 1-5 \u03c6\u03bf\u03c1\u03ad\u03c2 \u03c4\u03bf \u03b4\u03b5\u03c5\u03c4\u03b5\u03c1\u03cc\u03bb\u03b5\u03c0\u03c4\u03bf \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 Bluetooth. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03ad\u03bc\u03b2\u03b5\u03c4\u03b5 \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03c3\u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u03bc\u03b5 \u03b5\u03bd\u03c4\u03bf\u03bb\u03ad\u03c2 UDS / OBD \u03bc\u03ad\u03c3\u03c9 \u03c4\u03bf\u03c5 \u03c4\u03b5\u03c1\u03bc\u03b1\u03c4\u03b9\u03ba\u03bf\u03cd."},expertise:{title:"\u0395\u039e\u0395\u03a4\u0391\u03a3\u0397 \u039a\u0391\u0399 \u0395\u0393\u0393\u03a5\u0397\u03a3\u0397",content:"\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03cd\u03c2 ECU (Brain) \u03b3\u03b9\u03b1 \u03c4\u03bf\u03bd \u03b5\u03bd\u03c4\u03bf\u03c0\u03b9\u03c3\u03bc\u03cc \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd. \u039a\u03b1\u03c4\u03b1\u03b3\u03c1\u03ac\u03c6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bf \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 VIN (VIN) \u03ba\u03b1\u03b9 \u03b7 \u03c4\u03c1\u03ad\u03c7\u03bf\u03c5\u03c3\u03b1 \u03c7\u03b9\u03bb\u03b9\u03bf\u03bc\u03b5\u03c4\u03c1\u03b9\u03ba\u03ae \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03ad\u03c7\u03bf\u03c5\u03bd \u03ba\u03b1\u03c4\u03b1\u03b3\u03c1\u03b1\u03c6\u03b5\u03af \u03c3\u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1. \u0395\u03c0\u03b9\u03c0\u03bb\u03ad\u03bf\u03bd, \u03c4\u03b1 \u03c0\u03c1\u03bf\u03b7\u03b3\u03bf\u03cd\u03bc\u03b5\u03bd\u03b1 \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b4\u03b9\u03bf\u03c1\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c5\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03ad\u03c7\u03b5\u03b9 \u03b4\u03b9\u03b1\u03bd\u03cd\u03c3\u03b5\u03b9 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u03bc\u03b5 \u03c4\u03b7 \u03bb\u03c5\u03c7\u03bd\u03af\u03b1 Check Engine. \u0397 \u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03ba\u03cd\u03c0\u03c4\u03b5\u03b9 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03ba\u03bf\u03b9\u03bd\u03bf\u03c0\u03bf\u03b9\u03b7\u03b8\u03b5\u03af \u03c3\u03b5 \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03b1 PDF \u03ba\u03b1\u03b9 \u039c\u03b7\u03bd\u03c5\u03bc\u03ac\u03c4\u03c9\u03bd."},tests:{title:"\u0394\u039f\u039a\u0399\u039c\u0395\u03a3 \u039c\u03a0\u0391\u03a4\u0391\u03a1\u0399\u0391\u03a3 / \u0391\u03a0\u039f\u0394\u039f\u03a3\u0397\u03a3",content:"\u0397 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae \u03c4\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 \u03ad\u03c7\u03b5\u03b9 3 \u03c3\u03c4\u03ac\u03b4\u03b9\u03b1: \u039f\u03b9 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ad\u03c2 \u03b1\u03bd\u03ac\u03c0\u03b1\u03c5\u03c3\u03b7\u03c2, \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7\u03c2 \u03b1\u03b4\u03c1\u03ac\u03bd\u03b5\u03b9\u03b1\u03c2 \u03bc\u03b5\u03c4\u03c1\u03bf\u03cd\u03bd \u03c4\u03b7\u03bd \u03c5\u03b3\u03b5\u03af\u03b1 \u03c4\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2/\u03c1\u03c5\u03b8\u03bc\u03b9\u03c3\u03c4\u03ae \u03c3\u03b1\u03c2. \u0397 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7\u03c2 \u03bc\u03b5\u03c4\u03c1\u03ac \u03c4\u03b9\u03bc\u03ad\u03c2 \u03b5\u03c0\u03b9\u03c4\u03ac\u03c7\u03c5\u03bd\u03c3\u03b7\u03c2 0-60 \u03ba\u03b1\u03b9 0-100 km/h \u03bc\u03b5 \u03c0\u03b5\u03c1\u03b9\u03b8\u03ce\u03c1\u03b9\u03bf \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2 50 ms, \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c3\u03c4\u03b9\u03b3\u03bc\u03b9\u03b1\u03af\u03b1\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u03b5\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae \u03c4\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c6\u03ce\u03bd\u03bf\u03c5 \u03c3\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03ac \u03c3\u03b1\u03c2."},hardware:{title:"\u03a3\u03a5\u039c\u0392\u0391\u03a4\u039f\u03a4\u0397\u03a4\u0391 \u03a5\u039b\u0399\u039a\u039f\u03a5",content:"\u03a3\u03c5\u03bd\u03b9\u03c3\u03c4\u03ac\u03c4\u03b1\u03b9 \u03c4\u03bf ELM327 Bluetooth (v1.5). \u039f\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03b9 \u03c0\u03c1\u03bf\u03b7\u03b3\u03bc\u03ad\u03bd\u03bf\u03b9 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03b5\u03bd\u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03bc\u03b7\u03bd \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03bf\u03cd\u03bd \u03c3\u03b5 \u03c5\u03bb\u03b9\u03ba\u03cc \u03ba\u03b1\u03ba\u03ae\u03c2 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03bc\u03b5 \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7 v2.1 CLONE. \u0391\u03c0\u03bf\u03ba\u03c4\u03ac\u03c4\u03b5 \u03c4\u03b7 \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03b7 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 \u03bc\u03b5 premium \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03b5\u03af\u03c2 \u03cc\u03c0\u03c9\u03c2 \u03c4\u03bf vLinker \u03ba\u03b1\u03b9 \u03c4\u03bf OBDLink."},warnings:{title:"\u03a3\u0397\u039c\u0391\u039d\u03a4\u0399\u039a\u0395\u03a3 \u03a0\u03a1\u039f\u0395\u0399\u0394\u039f\u03a0\u039f\u0399\u0397\u03a3\u0395\u0399\u03a3",content:"\u2022 \u0397 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 ON \u03ba\u03b1\u03b9 \u03bf \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 OFF \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1\u03c2 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03cd \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2 \u03ae \u03c4\u03b7\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac\u03c2 ECU. \u2022 \u039c\u03b7\u03bd \u03c3\u03c4\u03ad\u03bb\u03bd\u03b5\u03c4\u03b5 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c3\u03b5 \u03cc\u03c7\u03b7\u03bc\u03b1 \u03c0\u03bf\u03c5 \u03b2\u03c1\u03af\u03c3\u03ba\u03b5\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1. \u2022 \u039c\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03bc\u03b7\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03b5\u03b9 \u03ba\u03ac\u03b8\u03b5 \u03cc\u03c7\u03b7\u03bc\u03b1 \u03cc\u03bb\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2, \u03bf\u03b9 \u03bc\u03b7 \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03b9\u03b6\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2 \u03b8\u03b1 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03bf\u03c5\u03bd \"--\"."},onboarding:{title:"\u039d\u039f\u039c\u0399\u039c\u0395\u03a3 \u0391\u0394\u0395\u0399\u0395\u03a3 & \u0391\u039d\u03a9\u039d\u03a5\u039c\u0397 \u03a4\u0397\u039b\u0395\u039c\u0395\u03a4\u03a1\u0399\u0391",content:"\u03a0\u03c1\u03bf\u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf\u03c5 \u03bd\u03b1 \u03b2\u03b5\u03bb\u03c4\u03b9\u03c9\u03b8\u03b5\u03af \u03b7 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03b7\u03c2 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03b7 \u03c3\u03c5\u03bc\u03b2\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2. \u039f\u03b9 \u03b5\u03bd\u03c4\u03b5\u03bb\u03ce\u03c2 \u03b1\u03bd\u03ce\u03bd\u03c5\u03bc\u03b5\u03c2 \u03c0\u03b1\u03c1\u03ac\u03bc\u03b5\u03c4\u03c1\u03bf\u03b9 \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03bf\u03b9 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd \u03c0\u03bf\u03c5 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd (\u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03ad\u03c7\u03bf\u03c5\u03bd \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03ac \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03ba\u03b1\u03b9 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc \u03c0\u03bb\u03b1\u03b9\u03c3\u03af\u03bf\u03c5) \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03b1\u03bd\u03b1\u03bb\u03c5\u03b8\u03bf\u03cd\u03bd \u03c3\u03c4\u03bf\u03c5\u03c2 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03c2 \u03b4\u03b9\u03b1\u03ba\u03bf\u03bc\u03b9\u03c3\u03c4\u03ad\u03c2 \u03bc\u03b1\u03c2. \u03a3\u03c5\u03bd\u03b5\u03c7\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03c2, \u03c3\u03c5\u03bc\u03c6\u03c9\u03bd\u03b5\u03af\u03c4\u03b5 \u03bc\u03b5 \u03b1\u03c5\u03c4\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03bd\u03ce\u03bd\u03c5\u03bc\u03bf\u03c5\u03c2 \u03cc\u03c1\u03bf\u03c5\u03c2 \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1\u03c2. \u0391\u03c0\u03b1\u03b9\u03c4\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03ac\u03b4\u03b5\u03b9\u03b5\u03c2 Bluetooth \u03ba\u03b1\u03b9 Location \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd ECU \u03c4\u03b7\u03c2 \u03bc\u03bf\u03c4\u03bf\u03c3\u03c5\u03ba\u03bb\u03ad\u03c4\u03b1\u03c2 \u03c3\u03b1\u03c2."},featureCoding:{title:"\u039a\u03a1\u03a5\u03a6\u0397 \u0394\u03a5\u039d\u0391\u03a4\u039f\u03a4\u0397\u03a4\u0391 \u039e\u0395\u039a\u039b\u0395\u0399\u0394\u03a9\u039c\u0391 & \u039a\u03a9\u0394\u0399\u039a\u039f\u03a0\u039f\u0399\u0397\u03a3\u0397 UDS",content:"\u039c\u03b5 \u03c4\u03b7\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7 \u03c4\u03bf\u03c5 ISO 14229 UDS Protocol Engine \u03bc\u03b1\u03c2, \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03c3\u03c3\u03b5\u03c4\u03b5 \u03bc\u03b5 \u03b1\u03c3\u03c6\u03ac\u03bb\u03b5\u03b9\u03b1 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 \u03cc\u03c0\u03c9\u03c2 \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03c3\u03c4\u03ac\u03b8\u03bc\u03b5\u03c5\u03c3\u03b7\u03c2 \u0397\u03a0\u0391, \u03c4\u03bf \u03c3\u03ac\u03c1\u03c9\u03c3\u03b7 \u03b2\u03b5\u03bb\u03cc\u03bd\u03b1\u03c2, \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03ba\u03cc\u03c1\u03bd\u03b1\u03c2, \u03c4\u03b1 \u03c0\u03b1\u03c1\u03ac\u03b8\u03c5\u03c1\u03b1 \u03ac\u03bd\u03b5\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 DRL \u03b3\u03b9\u03b1 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1 VAG, BMW, Renault \u03ba\u03b1\u03b9 Dacia."},multiEcu:{title:"\u03a3\u0391\u03a1\u03a9\u03a3\u0397 \u039f\u039b\u03a9\u039d \u03a4\u03a9\u039d \u039c\u039f\u039d\u0391\u0394\u03a9\u039d MULTI-ECU",content:"\u03a3\u03b1\u03c1\u03ce\u03c3\u03c4\u03b5 \u03ba\u03b1\u03b9 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03c4\u03b5 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b7\u03c2 \u03c0\u03ad\u03c1\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd ECU \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u2014 \u03c3\u03c5\u03bc\u03c0\u03b5\u03c1\u03b9\u03bb\u03b1\u03bc\u03b2\u03b1\u03bd\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd \u03c4\u03c9\u03bd ABS, \u03b1\u03b5\u03c1\u03cc\u03c3\u03b1\u03ba\u03bf\u03c5, \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf\u03c5 \u03ba\u03b9\u03b2\u03c9\u03c4\u03af\u03bf\u03c5 \u03c4\u03b1\u03c7\u03c5\u03c4\u03ae\u03c4\u03c9\u03bd (TCU), \u03c0\u03af\u03bd\u03b1\u03ba\u03b1 \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd, \u03ba\u03bb\u03b9\u03bc\u03b1\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd (HVAC) \u03ba\u03b1\u03b9 \u03bc\u03bf\u03bd\u03ac\u03b4\u03c9\u03bd \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03b1\u03bc\u03b1\u03be\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 (BCM)."},advancedDiagnostics:{title:"DCT ADAPTATION, DPF & HP POWER GAUGE",content:"\u2022 \u0395\u03ba\u03bc\u03ac\u03b8\u03b7\u03c3\u03b7 \u03c3\u03b7\u03bc\u03b5\u03af\u03bf\u03c5 \u03c6\u03b9\u03bb\u03b9\u03bf\u03cd \u03c3\u03c5\u03bc\u03c0\u03bb\u03ad\u03ba\u03c4\u03b7 DCT / DSG \u03ba\u03b1\u03b9 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2\n\u2022 DPF Soot Load (%/g) & \u03a0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b7 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1\u03c2 \u03b1\u03bd\u03b1\u03b3\u03ad\u03bd\u03bd\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03c5\u03c3\u03b1\u03b5\u03c1\u03af\u03c9\u03bd\n\u2022 \u0392\u03c1\u03b1\u03c7\u03c5\u03c0\u03c1\u03cc\u03b8\u03b5\u03c3\u03bc\u03b5\u03c2/\u03bc\u03b1\u03ba\u03c1\u03bf\u03c0\u03c1\u03cc\u03b8\u03b5\u03c3\u03bc\u03b5\u03c2 \u03c0\u03b5\u03c1\u03b9\u03ba\u03bf\u03c0\u03ad\u03c2 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 (STFT/LTFT) & \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03bb\u03ac\u03bc\u03b4\u03b1 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03cc\u03bd\u03bf\n\u2022 \u0393\u03c1\u03ac\u03c6\u03b7\u03bc\u03b1 \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae\u03c2 \u03a4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1\u03c2 \u0394\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ae\u03c2 \u0399\u03c0\u03c0\u03bf\u03b4\u03cd\u03bd\u03b1\u03bc\u03b7\u03c2 (HP) & \u03a1\u03bf\u03c0\u03ae\u03c2 (Nm)."},demoMode:{title:"DEMO MODE (\u03a0\u03a1\u039f\u03a3\u039f\u039c\u039f\u0399\u03a9\u03a3\u0397)",content:"\u0394\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03c4\u03b5 \u03ba\u03b1\u03b9 \u03b5\u03be\u03b5\u03c1\u03b5\u03c5\u03bd\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c7\u03c9\u03c1\u03af\u03c2 \u03c6\u03c5\u03c3\u03b9\u03ba\u03cc \u03c5\u03bb\u03b9\u03ba\u03cc OBD2. \u0391\u03c0\u03bf\u03bb\u03b1\u03cd\u03c3\u03c4\u03b5 \u03c0\u03bb\u03ae\u03c1\u03b5\u03b9\u03c2 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 CAN-Bus \u03ba\u03b1\u03b9 UDS \u03bc\u03b5 \u03c1\u03b5\u03b1\u03bb\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03c0\u03c1\u03bf\u03c3\u03bf\u03bc\u03bf\u03af\u03c9\u03c3\u03b7 \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1\u03c2 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03cc\u03bd\u03bf."}},reconfigurePermissions:"\u0394\u03b9\u03ba\u03b1\u03b9\u03ce\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bd\u03bf\u03bc\u03b9\u03ba\u03bf\u03af \u03cc\u03c1\u03bf\u03b9 \u03b5\u03c0\u03b1\u03bd\u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7\u03c2",upgradeAlert:"Early Access ",shareWithFriend:"MOIRA\u03a3TE ME ENAN \u03a6\u0399\u039b\u039f",shareMessageText:"\u0391\u03bd\u03b1\u03ba\u03b1\u03bb\u03cd\u03c8\u03c4\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b7\u03c2 ECU \u03ba\u03b1\u03b9 \u03c4\u03b7 \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1 \u03bc\u03b5 \u03c4\u03bf Cortex OBD2 Diagnostic Scanner!\n\n\u039a\u03b1\u03c4\u03b5\u03b2\u03ac\u03c3\u03c4\u03b5 \u03c4\u03ce\u03c1\u03b1:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:" \u2550\u2550\u2550 CORTEX OBD2 \u0394\u0399\u0391\u0393\u039d\u03a9\u03a3\u03a4\u0399\u039a\u0397 \u0395\u039a\u0398\u0395\u03a3\u0397 \u2550\u2550\u2550 ",vehicleIdentity:" \u03a4\u03b1\u03c5\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u039f\u03a7\u0397\u039c\u0391\u03a4\u039f\u03a3",vin:"\u0391\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03c0\u03bb\u03b1\u03b9\u03c3\u03af\u03bf\u03c5 (VIN)",odometer:"\u0391\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7 (KM)",milDist:"\u03a6\u03c9\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b1\u03bd\u03b1\u03bc\u03bc\u03ad\u03bd\u03bf",distSinceCleared:"\u03a4\u03bf \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03b7\u03ba\u03b5",dtcCount:" \u039a\u03a9\u0394\u0399\u039a\u039f\u0399 \u03a3\u03a6\u0391\u039b\u039c\u0391\u03a4\u039f\u03a3 ({{count}}\u03c0\u03bf\u03c3\u03cc\u03c4\u03b7\u03c4\u03b1)",sensorData:" \u0396\u03a9\u039d\u03a4\u0391\u039d\u0391 \u0394\u0395\u0394\u039f\u039c\u0395\u039d\u0391 \u0391\u0399\u03a3\u0398\u0397\u03a4\u0397\u03a1\u0391",noData:"\u0391\u03c0\u03bf\u03c4\u03c5\u03c7\u03af\u03b1 \u03b1\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7\u03c2 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd",proApp:"\u03a3\u03ac\u03c1\u03c9\u03c3\u03b7 \u03bc\u03b5 Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"\u03b7\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1",vinNotFound:"\u0394\u03b5\u03bd \u03b5\u03bd\u03c4\u03bf\u03c0\u03af\u03c3\u03c4\u03b7\u03ba\u03b5",noDtcs:"\u039f\u03a7\u0399 \u039a\u03a9\u0394\u0399\u039a\u039f\u0399 \u03a3\u03a6\u0391\u039b\u039c\u0391\u03a4\u03a9\u039d - \u039a\u0391\u0398\u0391\u03a1\u0399\u03a3\u039c\u039f\u03a3",speed:"\u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1",coolant:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",throttle:"\u03b1\u03ad\u03c1\u03b9\u03bf",engineLoad:"\u03a6\u03bf\u03c1\u03c4\u03af\u03bf \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",intakeAir:"\u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03b1\u03ad\u03c1\u03b1",manifold:"\u03a0\u03bf\u03bb\u03bb\u03b1\u03c0\u03bb\u03ae",voltage:"\u03a4\u03ac\u03c3\u03b7 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2",shareMessage:"\u0391\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bc\u03bf\u03c4\u03bf\u03c3\u03c5\u03ba\u03bb\u03ad\u03c4\u03b1\u03c2 \u03c3\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03c4\u03c3\u03ad\u03c0\u03b7 \u03c3\u03b1\u03c2 \u03bc\u03b5 \u03c4\u03b7\u03bd \u0394\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ae \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae Motocortex OBD2! \u039b\u03ae\u03c8\u03b7: https://cortexobd2.app",subtitle:"\u03a0\u03bb\u03ae\u03c1\u03b7\u03c2 \u039c\u03b5\u03c4\u03b1\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03c2 \u0394\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03cc\u03c2 & \u03a4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03b9\u03ba\u03cc\u03c2 \u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2",vehicleInfo:"\u0391\u03bd\u03b1\u03b3\u03bd\u03ce\u03c1\u03b9\u03c3\u03b7 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 & \u039c\u03b5\u03c4\u03b1\u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 ECU",healthScore:"\u03a3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03ae \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03c5\u03b3\u03b5\u03af\u03b1\u03c2 ECU",dtcSection:"\u039a\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03b2\u03bb\u03ac\u03b2\u03b7\u03c2 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 (\u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 DTC)",telemetrySection:"\u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1 & \u03a3\u03c4\u03b9\u03b3\u03bc\u03b9\u03cc\u03c4\u03c5\u03c0\u03bf \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1",maintenanceSection:"\u0399\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 & \u03c3\u03c5\u03bd\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7\u03c2 Ak\u0131ll\u0131 Garaj",aiSection:"AI Doctor \u0393\u03b5\u03bd\u03b9\u03ba\u03ae \u0391\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2",noFaults:"\u0394\u03b5\u03bd \u03ad\u03c7\u03bf\u03c5\u03bd \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03c5\u03c4\u03b5\u03af \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03af \u03ae \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03bf\u03af \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c3\u03c4\u03b7 \u03bc\u03bd\u03ae\u03bc\u03b7 ECU.",noMaintenance:"\u0394\u03b5\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03ba\u03b1\u03c4\u03b1\u03b3\u03b5\u03b3\u03c1\u03b1\u03bc\u03bc\u03ad\u03bd\u03b5\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c7\u03c9\u03c1\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c5\u03c0\u03b7\u03c1\u03b5\u03c3\u03af\u03b1\u03c2 \u03c3\u03c4\u03bf Ak\u0131ll\u0131 Garaj.",disclaimer:"\u0391\u03c0\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03b5\u03c5\u03b8\u03cd\u03bd\u03b7\u03c2: \u0391\u03c5\u03c4\u03ae \u03b7 \u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03b5\u03af\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03bf \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03cc \u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03b9\u03ba\u03cc MotoCortex. \u03a3\u03c5\u03bd\u03b9\u03c3\u03c4\u03ac\u03c4\u03b1\u03b9 \u03c6\u03c5\u03c3\u03b9\u03ba\u03ae \u03b5\u03c0\u03b9\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7 \u03b1\u03c0\u03cc \u03c0\u03b9\u03c3\u03c4\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03cc \u03c0\u03c1\u03b9\u03bd \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b1\u03b3\u03bf\u03c1\u03ac \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2.",shareTitle:"\u039c\u03bf\u03b9\u03c1\u03b1\u03c3\u03c4\u03b5\u03af\u03c4\u03b5 \u03c4\u03b7\u03bd \u03ad\u03ba\u03b8\u03b5\u03c3\u03b7 \u03b1\u03be\u03b9\u03bf\u03bb\u03cc\u03b3\u03b7\u03c3\u03b7\u03c2 MotoCortex"},battery:{title:"\u0394\u039f\u039a\u0399\u039c\u0397 \u039c\u03a0\u0391\u03a4\u0391\u03a1\u0399\u0391\u03a3 & \u0395\u039a\u039a\u0399\u039d\u0397\u03a3\u0397\u03a3",ready:"\u0388\u03c4\u03bf\u03b9\u03bc\u03bf\u03b9 \u03bd\u03b1 \u03be\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03bf\u03c5\u03bd \u03c4\u03b9\u03c2 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ad\u03c2.",restingStatus:"\u0391\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7 \u03b1\u03bd\u03bf\u03b9\u03c7\u03c4\u03ae, \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03c3\u03b2\u03b7\u03c3\u03c4\u03cc\u03c2... \u0397 \u03c4\u03ac\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 \u03b4\u03b9\u03b1\u03b2\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9...",crankingStatus:"\u0395\u039a\u039a\u0399\u039d\u0397\u03a3\u0397 \u03a4\u03a9\u03a1\u0391! (\u0397 \u03bc\u03ad\u03c4\u03c1\u03b7\u03c3\u03b7 \u03b8\u03b1 \u03b3\u03af\u03bd\u03b5\u03b9 \u03b3\u03b9\u03b1 5 \u03b4\u03b5\u03c5\u03c4\u03b5\u03c1\u03cc\u03bb\u03b5\u03c0\u03c4\u03b1)",chargingStatus:"\u039f \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03c3\u03c4\u03bf \u03c1\u03b5\u03bb\u03b1\u03bd\u03c4\u03af... \u0393\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b1\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c4\u03ac\u03c3\u03b7\u03c2 \u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7\u03c2...",doneStatus:"\u039f\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b7 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae!",voltageError:"\u0394\u03b5\u03bd \u03ae\u03c4\u03b1\u03bd \u03b4\u03c5\u03bd\u03b1\u03c4\u03ae \u03b7 \u03b1\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c4\u03ac\u03c3\u03b7\u03c2. \u0395\u03bb\u03ad\u03b3\u03be\u03c4\u03b5 \u03c4\u03b7 \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7.",start:"\u0395\u039d\u0391\u03a1\u039e\u0397 \u0394\u039f\u039a\u0399\u039c\u0397\u03a3",retry:"\u0395\u03a0\u0391\u039d\u0391\u039b\u0397\u03a8\u0397 \u03a4\u0395\u03a3\u03a4",procedure:"\u0394\u0399\u0391\u0394\u0399\u039a\u0391\u03a3\u0399\u0391 \u0394\u039f\u039a\u0399\u039c\u0397\u03a3",steps:{1:"1. \u0391\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7 \u03b1\u03bd\u03bf\u03b9\u03c7\u03c4\u03ae, \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03c3\u03b2\u03b7\u03c3\u03c4\u03cc\u03c2 \u2192 \u039c\u03b5\u03c4\u03c1\u03ac\u03c4\u03b1\u03b9 \u03b7 \u03c4\u03ac\u03c3\u03b7 \u03b7\u03c1\u03b5\u03bc\u03af\u03b1\u03c2",2:"2. \u038c\u03c4\u03b1\u03bd \u03b5\u03bc\u03c6\u03b1\u03bd\u03b9\u03c3\u03c4\u03b5\u03af \u03c4\u03bf \u03bc\u03ae\u03bd\u03c5\u03bc\u03b1 \"START NOW\", \u03be\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1.",3:"3. \u03a7\u03b1\u03bc\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03b7 \u03c4\u03ac\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03ba\u03b1\u03c4\u03b1\u03b3\u03c1\u03ac\u03c6\u03b7\u03ba\u03b5 \u03b3\u03b9\u03b1 5 \u03b4\u03b5\u03c5\u03c4\u03b5\u03c1\u03cc\u03bb\u03b5\u03c0\u03c4\u03b1",4:"4. \u0397 \u03c4\u03ac\u03c3\u03b7 \u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7\u03c2/\u03c1\u03c5\u03b8\u03bc\u03b9\u03c3\u03c4\u03ae \u03bc\u03b5\u03c4\u03c1\u03ac\u03c4\u03b1\u03b9 \u03b5\u03bd\u03ce \u03bf \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af"},warning:"\u039c\u03b7\u03bd \u03b1\u03c0\u03bf\u03c3\u03c5\u03bd\u03b4\u03ad\u03b5\u03c4\u03b5 \u03c4\u03b7 \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7 Bluetooth \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae\u03c2.",resting:"\u0391\u039d\u0391\u03a0\u0391\u03a5\u03a3\u0397",cranking:"\u03a5\u039c\u039d\u039f\u03a3",charging:"\u03a6\u039f\u03a1\u03a4\u0399\u03a3\u0397",instantV:"\u03a3\u03a4\u0399\u0393\u039c\u0399\u0391\u0399\u0391 \u03a4\u0391\u03a3\u0397",evaluation:"\u0391\u039e\u0399\u039f\u039b\u039f\u0393\u0397\u03a3\u0397",verdicts:{full:"\u039c\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1: \u03a0\u03bb\u03ae\u03c1\u03c9\u03c2 \u03c6\u03bf\u03c1\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7",good:"\u039c\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1: \u039a\u03b1\u03bb\u03ae \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7",weak:"\u039c\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1: \u0395\u03be\u03b1\u03c3\u03b8\u03ad\u03bd\u03b9\u03c3\u03b7",empty:"\u039c\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1: \u0391\u03b4\u03cd\u03bd\u03b1\u03bc\u03b7/\u039d\u03b5\u03ba\u03c1\u03ae",crankNormal:"\u0388\u03bd\u03b1\u03c1\u03be\u03b7: \u039a\u03b1\u03bd\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03c4\u03ce\u03c3\u03b7",crankLow:"\u039c\u03af\u03b6\u03b1: \u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03c4\u03ac\u03c3\u03b7",crankCritical:"Anthem: Critical drop",regNormal:"\u03a6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7: \u03a1\u03c5\u03b8\u03bc\u03b9\u03c3\u03c4\u03ae\u03c2 \u03ba\u03b1\u03bd\u03bf\u03bd\u03b9\u03ba\u03cc\u03c2",regLow:"\u03a6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7: \u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7",regHigh:"\u03a6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7: \u03a5\u03c0\u03b5\u03c1\u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7",regFail:"\u03a6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7: \u039f \u03c1\u03c5\u03b8\u03bc\u03b9\u03c3\u03c4\u03ae\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03bb\u03b1\u03c4\u03c4\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c2"},verdictLocked:"\u039a\u03ac\u03bd\u03c4\u03b5 \u03b1\u03bd\u03b1\u03b2\u03ac\u03b8\u03bc\u03b9\u03c3\u03b7 \u03c3\u03b5 PRO \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03b2\u03ac\u03bb\u03b5\u03c4\u03b5 \u03bb\u03b5\u03c0\u03c4\u03bf\u03bc\u03b5\u03c1\u03ae \u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03b1\u03be\u03b9\u03bf\u03bb\u03cc\u03b3\u03b7\u03c3\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03b3\u03c1\u03ac\u03c6\u03b7\u03bc\u03b1 \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7\u03c2 \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03bc\u03af\u03b6\u03b1\u03c2."},freeze:{title:"\u03a0\u039b\u0391\u0399\u03a3\u0399\u039f FREZE",snapshot:"\u039c\u039d\u0397\u039c\u0397 \u0391\u03a0\u039f\u03a4\u03a5\u03a7\u0399\u0391\u03a3",desc:"\u0394\u03b9\u03b1\u03b2\u03ac\u03b6\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c0\u03b1\u03c1\u03b1\u03bc\u03ad\u03c4\u03c1\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03cc\u03c4\u03b1\u03bd \u03b1\u03bd\u03ac\u03b2\u03b5\u03b9 \u03b7 \u03bb\u03c5\u03c7\u03bd\u03af\u03b1 Check Engine. \u0391\u03c5\u03c4\u03ac \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c0\u03b1\u03c1\u03ad\u03c7\u03bf\u03c5\u03bd \u03ba\u03c1\u03af\u03c3\u03b9\u03bc\u03b5\u03c2 \u03c0\u03bb\u03b7\u03c1\u03bf\u03c6\u03bf\u03c1\u03af\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03b2\u03bb\u03b1\u03b2\u03ce\u03bd.",noDtcs:"\u0394\u03b5\u03bd \u03ad\u03c7\u03b5\u03b9 \u03ba\u03b1\u03c4\u03b1\u03b3\u03c1\u03b1\u03c6\u03b5\u03af \u03ba\u03c9\u03b4\u03b9\u03ba\u03cc\u03c2 \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2. \u039c\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03bc\u03b7\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 Freeze Frame.",read:"\u0394\u0399\u0391\u0392\u0391\u03a3\u03a4\u0395 \u03a0\u0391\u0393\u03a9\u039c\u0395\u039d\u0391 \u03a3\u03a4\u039f\u0399\u03a7\u0395\u0399\u0391",loading:"\u0397 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 02 \u03b1\u03bc\u03c6\u03b9\u03c3\u03b2\u03b7\u03c4\u03b5\u03af\u03c4\u03b1\u03b9...",noData:"\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1\u03bd \u03c0\u03b1\u03b3\u03c9\u03bc\u03ad\u03bd\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1. \u03a4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u03b5\u03bd\u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03bc\u03b7\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03b5\u03b9 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7 \u03b4\u03c5\u03bd\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1.",error:"\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03b1\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7\u03c2 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd",values:" \u0391\u039e\u0399\u0395\u03a3 \u03a3\u03a9\u0398\u0397\u039c\u0395\u039d\u0395\u03a3 \u03a4\u0397\u039d \u03a9\u03a1\u0391 \u03a4\u0397\u03a3 \u0391\u03a0\u039f\u03a4\u03a5\u03a7\u0399\u0391\u03a3",retry:"\u0394\u0399\u0391\u0392\u0391\u03a3\u03a4\u0395 \u039e\u0391\u039d\u0391",techInfo:"\u03a4\u0395\u03a7\u039d\u0399\u039a\u0395\u03a3 \u03a0\u039b\u0397\u03a1\u039f\u03a6\u039f\u03a1\u0399\u0395\u03a3",techDesc:"\u2022 OBD-II Mode 02: Freeze Frame Data \u2022 PID 020C00: RPM \u03c3\u03b5 \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1 \u2022 PID 020D00: \u039b\u03ac\u03b8\u03bf\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u2022 PID 020500: \u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03bd\u03b5\u03c1\u03bf\u03cd \u03c8\u03cd\u03be\u03b7\u03c2 \u03c4\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03c4\u03b7\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b7\u03c2 \u0391\u03c5\u03c4\u03ac \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03b1\u03bd\u03ae\u03ba\u03bf\u03c5\u03bd \u03c3\u03c4\u03bf\u03bd \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf \u03ba\u03c9\u03b4\u03b9\u03ba\u03cc \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2. \u038c\u03c4\u03b1\u03bd \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bf\u03b9 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2, \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b5\u03c0\u03af\u03c3\u03b7\u03c2 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c4\u03bf\u03c5 \u03c0\u03b1\u03b3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03bb\u03b1\u03b9\u03c3\u03af\u03bf\u03c5.",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"\u03a4\u0395\u03a3\u03a4 \u0391\u03a0\u039f\u0394\u039f\u03a3\u0397\u03a3",seconds:"\u0394\u0395\u03a5\u03a4\u0395\u03a1\u039f\u039b\u0395\u03a0\u03a4\u0391",speed:"KM/H",idle:"\u03a0\u03b1\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03ba\u03b1\u03b9 \u03b5\u03c4\u03bf\u03b9\u03bc\u03b1\u03c3\u03c4\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03b1\u03bd\u03b1\u03bb\u03ac\u03b2\u03b5\u03c4\u03b5 \u03b4\u03c1\u03ac\u03c3\u03b7.",ready:"\u0395\u03a4\u039f\u0399\u039c\u039f\u0399! \u039e\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03bf\u03b4\u03b7\u03b3\u03b5\u03af\u03c4\u03b5 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1...",readyDesc:"\u039f \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae\u03c2 \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03cc\u03c4\u03b1\u03bd \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 > 0.",measuring:"\u0397 \u039c\u0395\u03a4\u03a1\u0397\u03a3\u0397 \u0393\u0399\u039d\u0395\u03a4\u0391\u0399...",done:"\u0397 \u0394\u039f\u039a\u0399\u039c\u0397 \u039f\u039b\u039f\u039a\u039b\u0397\u03a1\u03a9\u0398\u0397\u039a\u0395",start:"\u0395\u039d\u0391\u03a1\u039e\u0397 \u0394\u039f\u039a\u0399\u039c\u0397\u03a3",stop:"\u03a3\u03a4\u0391\u039c\u0391\u03a4\u0397\u03a3\u03a4\u0395",reset:"\u0395\u03a0\u0391\u039d\u0391\u03a6\u039f\u03a1\u0391",howItWorks:"\u03a0\u03a9\u03a3 \u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u0395\u0399;",howDesc:"1. \u03a0\u03b1\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \"\u0388\u03bd\u03b1\u03c1\u03be\u03b7 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae\u03c2\". 2. \u03a4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03ba\u03af\u03bd\u03b7\u03c4\u03bf (\u03a4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 = 0) 3. \u03a4\u03bf Chrono \u03be\u03b5\u03ba\u03b9\u03bd\u03ac \u03cc\u03c4\u03b1\u03bd \u03be\u03b5\u03ba\u03b9\u03bd\u03ac\u03c4\u03b5 \u03bd\u03b1 \u03ba\u03b9\u03bd\u03b5\u03af\u03c3\u03c4\u03b5 4. \u039a\u03b1\u03c4\u03b1\u03b3\u03c1\u03ac\u03c6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c7\u03c1\u03cc\u03bd\u03bf\u03b9 \u03b4\u03b9\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7\u03c2 60 km/h \u03ba\u03b1\u03b9 100 km/h \u039a\u03ac\u03bd\u03c4\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c4\u03b5\u03c3\u03c4 \u03c3\u03b5 \u03b1\u03c3\u03c6\u03b1\u03bb\u03ae \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae!",sec:"\u03b4\u03b5\u03c5\u03c4"},dtc:{P0102:"\u0391\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03c1\u03bf\u03ae\u03c2 \u03b1\u03ad\u03c1\u03b1 (MAF) - \u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03b5\u03af\u03c3\u03bf\u03b4\u03bf\u03c2",P0113:"\u0391\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1\u03c2 \u03b1\u03ad\u03c1\u03b1 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 - \u03a5\u03c8\u03b7\u03bb\u03ae \u03c4\u03ac\u03c3\u03b7",P0171:"\u03a7\u03b1\u03bc\u03b7\u03bb\u03cc \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 (Bank 1)",P0300:"\u03a4\u03c5\u03c7\u03b1\u03af\u03bf/\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03c0\u03c5\u03c1\u03bf\u03b4\u03cc\u03c4\u03b7\u03c3\u03b7\u03c2 \u03c0\u03bf\u03bb\u03bb\u03b1\u03c0\u03bb\u03ce\u03bd \u03ba\u03c5\u03bb\u03af\u03bd\u03b4\u03c1\u03c9\u03bd",P0420:"\u03a3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03ba\u03b1\u03c4\u03b1\u03bb\u03c5\u03c4\u03b9\u03ba\u03bf\u03cd \u03bc\u03b5\u03c4\u03b1\u03c4\u03c1\u03bf\u03c0\u03ad\u03b1 (B1) - \u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7",P0700:"\u03a3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u0395\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u039c\u03b5\u03c4\u03ac\u03b4\u03bf\u03c3\u03b7\u03c2 - \u0392\u03bb\u03ac\u03b2\u03b7",P0715:"\u0391\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c3\u03c4\u03c1\u03bf\u03b2\u03af\u03bb\u03bf\u03c5 - \u0392\u03bb\u03ac\u03b2\u03b7 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2",P0560:"\u03a4\u03ac\u03c3\u03b7 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 - \u0392\u03bb\u03ac\u03b2\u03b7",P0562:"\u03a4\u03ac\u03c3\u03b7 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 - \u03a7\u03b1\u03bc\u03b7\u03bb\u03ae",U0100:"\u03a7\u03ac\u03b8\u03b7\u03ba\u03b5 \u03b7 \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03ae \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 (ECM/PCM)",U0121:"\u03a7\u03ac\u03b8\u03b7\u03ba\u03b5 \u03b7 \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1 \u03bc\u03b5 \u03c4\u03b7 \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03bd\u03c4\u03b9\u03bc\u03c0\u03bb\u03bf\u03ba\u03b1\u03c1\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd (ABS).",C0035:"\u0394\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03b1\u03c1\u03b9\u03c3\u03c4\u03b5\u03c1\u03bf\u03cd \u03bc\u03c0\u03c1\u03bf\u03c3\u03c4\u03b9\u03bd\u03bf\u03cd \u03c4\u03c1\u03bf\u03c7\u03bf\u03cd",B0001:"\u039a\u03cd\u03ba\u03bb\u03c9\u03bc\u03b1 \u0395\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u0391\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7\u03c2 \u039c\u03c0\u03c1\u03bf\u03c3\u03c4\u03b9\u03bd\u03bf\u03cd \u03a3\u03c4\u03b1\u03b4\u03af\u03bf\u03c5 1 \u03bf\u03b4\u03b7\u03b3\u03bf\u03cd",P0750:"\u0394\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bc\u03b1\u03b3\u03bd\u03b7\u03c4\u03b9\u03ba\u03ae\u03c2 \u03b2\u03b1\u03bb\u03b2\u03af\u03b4\u03b1\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03c4\u03b1\u03c7\u03c5\u03c4\u03ae\u03c4\u03c9\u03bd A",P0814:"\u0394\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03bf\u03b8\u03cc\u03bd\u03b7\u03c2 \u03b5\u03cd\u03c1\u03bf\u03c5\u03c2 \u03ba\u03b9\u03b2\u03c9\u03c4\u03af\u03bf\u03c5 \u03c4\u03b1\u03c7\u03c5\u03c4\u03ae\u03c4\u03c9\u03bd",U0140:"\u03a7\u03ac\u03b8\u03b7\u03ba\u03b5 \u03b7 \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1 \u03bc\u03b5 \u03c4\u03b7 \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03c3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 (BCM)",C0040:"\u0394\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03bc\u03c0\u03c1\u03bf\u03c3\u03c4\u03b9\u03bd\u03bf\u03cd \u03b4\u03b5\u03be\u03b9\u03bf\u03cd \u03c4\u03c1\u03bf\u03c7\u03bf\u03cd",C0110:"\u0394\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b1\u03bd\u03c4\u03bb\u03af\u03b1\u03c2 ABS",C0121:"\u0394\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03c0\u03af\u03b5\u03c3\u03b7\u03c2 \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd",B0010:"\u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7\u03c2 \u03a3\u03c4\u03ac\u03b4\u03b9\u03bf 1 \u0395\u03bc\u03c0\u03c1\u03cc\u03c2 \u0395\u03c0\u03b9\u03b2\u03b1\u03c4\u03ce\u03bd",B0020:"\u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7\u03c2 \u03b1\u03b5\u03c1\u03cc\u03c3\u03b1\u03ba\u03bf\u03c5 \u03b1\u03c1\u03b9\u03c3\u03c4\u03b5\u03c1\u03ae\u03c2 \u03c0\u03bb\u03b5\u03c5\u03c1\u03ac\u03c2",B1000:"\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03c5\u03bb\u03b9\u03ba\u03bf\u03cd \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1\u03c2 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03b1\u03bc\u03b1\u03be\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 (BCM).",B1325:"\u03a7\u03b1\u03bc\u03b7\u03bb\u03ae\u03c2 \u03c4\u03ac\u03c3\u03b7\u03c2 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c4\u03c1\u03bf\u03c6\u03bf\u03b4\u03bf\u03c3\u03af\u03b1\u03c2 \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ae\u03c2",generalFault:"General Fault"},vehicleSelect:{title:"\u0395\u03a0\u0399\u039b\u0395\u039e\u03a4\u0395 \u03a4\u039f \u039f\u03a7\u0397\u039c\u0391 \u03a3\u0391\u03a3 \u0393\u0399\u0391 \u039d\u0391 \u0391\u03a5\u039e\u0397\u03a3\u0395\u03a4\u0395 \u03a4\u0397 \u0394\u0399\u0391\u0393\u039d\u03a9\u03a3\u03a4\u0399\u039a\u0397 \u0391\u039a\u03a1\u0399\u0392\u0395\u0399\u0391",subtitle:"\u0394\u03ce\u03c3\u03c4\u03b5 \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b3\u03b9\u03b1 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ae \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03c4\u03b9\u03c3\u03c4\u03bf\u03af\u03c7\u03b9\u03c3\u03b7 \u03c0\u03c1\u03c9\u03c4\u03bf\u03ba\u03cc\u03bb\u03bb\u03bf\u03c5.",brand:"\u039c\u0391\u03a1\u039a\u0391",selectBrand:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u0395\u03c0\u03c9\u03bd\u03c5\u03bc\u03af\u03b1...",searchBrand:"\u0391\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7 \u03b5\u03c0\u03c9\u03bd\u03c5\u03bc\u03af\u03b1\u03c2...",customBrandPlaceholder:"\u03a0.\u03c7.: Triumph, CFMoto, Kia...",model:"\u039c\u039f\u039d\u03a4\u0395\u039b\u039f",selectModel:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03bc\u03bf\u03bd\u03c4\u03ad\u03bb\u03bf...",searchModel:"\u0391\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7 \u03bc\u03bf\u03bd\u03c4\u03ad\u03bb\u03bf\u03c5...",customModelPlaceholder:"\u03a0.\u03c7.: CBR600, \u03b3\u03ba\u03bf\u03bb\u03c6, \u03b5\u03c3\u03c4\u03af\u03b1\u03c3\u03b7...",year:"\u039c\u039f\u039d\u03a4\u0395\u039b\u039f \u0395\u03a4\u039f\u03a3",selectYear:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u0388\u03c4\u03bf\u03c2...",customYearPlaceholder:"\u03a0\u03c7: 2018",disconnect:"\u0391\u03a0\u039f\u03a3\u03a5\u039d\u0394\u0395\u03a3\u0397",confirm:"\u03a3\u03a5\u039d\u0395\u03a7\u0399\u03a3\u03a4\u0395",errorBrand:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03ae \u03b5\u03b9\u03c3\u03b1\u03b3\u03ac\u03b3\u03b5\u03c4\u03b5 \u03bc\u03b9\u03b1 \u03b5\u03c0\u03c9\u03bd\u03c5\u03bc\u03af\u03b1.",errorModel:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03ae \u03b5\u03b9\u03c3\u03b1\u03b3\u03ac\u03b3\u03b5\u03c4\u03b5 \u03ad\u03bd\u03b1 \u03bc\u03bf\u03bd\u03c4\u03ad\u03bb\u03bf.",errorYear:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03ae \u03b5\u03b9\u03c3\u03b1\u03b3\u03ac\u03b3\u03b5\u03c4\u03b5 \u03ad\u03bd\u03b1 \u03ad\u03b3\u03ba\u03c5\u03c1\u03bf \u03ad\u03c4\u03bf\u03c2 (\u03c0.\u03c7. 2018).",noResults:"\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03ad\u03c3\u03bc\u03b1\u03c4\u03b1",selectVehiclePrompt:"\u03a0\u0391\u03a1\u0391\u039a\u0391\u039b\u03a9 \u0395\u03a0\u0399\u039b\u0395\u0393\u039c\u0395\u039d\u039f \u039f\u03a7\u0397\u039c\u0391 \u03a0\u03a1\u03a9\u03a4\u0391",selectedVehicle:"\u0395\u03a0\u0399\u039b\u0395\u0393\u039c\u0395\u039d\u039f \u039f\u03a7\u0397\u039c\u0391",changeVehicle:"\u0391\u039b\u039b\u0391\u0393\u0397",newVehicle:"\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u039d\u03ad\u03bf\u03c5 \u039f\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2",titleMenu:"\u038c\u03c7\u03b7\u03bc\u03b1 & \u03a3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7",registeredVehiclesLabel:"\u039a\u0391\u03a4\u0391\u03a7\u03a9\u03a1\u0397\u039c\u0395\u039d\u0391 \u039f\u03a7\u0397\u039c\u0391\u03a4\u0391",viewRegisteredList:"\u03a0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae \u03ba\u03b1\u03c4\u03b1\u03c7\u03c9\u03c1\u03b7\u03bc\u03ad\u03bd\u03c9\u03bd \u03bf\u03c7\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd",registeredVehicles:"\u03a4\u0391 \u039a\u0391\u03a4\u0391\u03a7\u03a9\u03a1\u0397\u039c\u0395\u039d\u0391 \u039f\u03a7\u0397\u039c\u0391\u03a4\u0391 \u039c\u039f\u03a5",deleteConfirm:"\u0395\u03af\u03c3\u03c4\u03b5 \u03b2\u03ad\u03b2\u03b1\u03b9\u03bf\u03b9 \u03cc\u03c4\u03b9 \u03b8\u03ad\u03bb\u03b5\u03c4\u03b5 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03b5\u03c4\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03ba\u03b1\u03c4\u03b1\u03c7\u03c9\u03c1\u03b7\u03bc\u03ad\u03bd\u03b1 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1;",noRegisteredVehicles:"\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1\u03bd \u03ba\u03b1\u03c4\u03b1\u03c7\u03c9\u03c1\u03b7\u03bc\u03ad\u03bd\u03b1 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1.",selectVehicle:"\u0395\u03a0\u0399\u039b\u039f\u0393\u0389",mismatchTitle:"\u0391\u03c3\u03c5\u03bc\u03b2\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u039f\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2",mismatchDesc:"\u039f \u03ba\u03b1\u03c4\u03b1\u03c3\u03ba\u03b5\u03c5\u03b1\u03c3\u03c4\u03ae\u03c2 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03b5\u03b4\u03b5\u03bc\u03ad\u03bd\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03b8\u03b7\u03ba\u03b5 \u03c9\u03c2 \"{{make}}\" \u03b1\u03c0\u03cc \u03c4\u03bf VIN. \u03a9\u03c3\u03c4\u03cc\u03c3\u03bf, \u03c4\u03bf \u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03cc\u03c7\u03b7\u03bc\u03ac \u03c3\u03b1\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \"{{selected}}\".\n\n\u0398\u03ad\u03bb\u03b5\u03c4\u03b5 \u03bd\u03b1 \u03b1\u03ba\u03c5\u03c1\u03ce\u03c3\u03b5\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c4\u03c1\u03ad\u03c7\u03bf\u03c5\u03c3\u03b1 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b1\u03c0\u03c1\u03bf\u03c3\u03b4\u03b9\u03bf\u03c1\u03af\u03c3\u03b5\u03c4\u03b5 \u03bc\u03b5 \u03c4\u03b7 \u03c3\u03c9\u03c3\u03c4\u03ae \u03bc\u03ac\u03c1\u03ba\u03b1 ({{make}});",operations:{clearDtc:"\u039f\u03b9 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c3\u03c6\u03ac