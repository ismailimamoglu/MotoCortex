arge port for camping appliances."},xiaomi_su7_drift_mode_unlock:{name:"Xiaomi SU7 Track Drift Mode & Rear-Torque Bias",desc:"Activates 100% rear motor torque bias and ESC Track Drift Mode."},vag_oil_service_reset:{name:"Oil Service Interval Reset",desc:"Resets oil change service counter and inspection interval for VAG vehicles."},vag_epb_service_mode:{name:"Electronic Parking Brake Brake Pad Service Mode",desc:"Retracts rear EPB caliper pistons for rear brake pad and rotor replacement."},bmw_bms_battery_registration:{name:"Intelligent Battery Sensor Battery Registration",desc:"Registers new 12V AGM/Lead-acid battery replacement in DME/DDE engine management."},bmw_motorrad_service_indicator_reset:{name:"BMW Motorrad Annual Service & Oil Indicator Reset",desc:"Clears annual service date and 10,000 km distance reminder on TFT instrument cluster."},ducati_desmo_service_reset:{name:"Ducati Desmo Valve Service Reminder Clear",desc:"Clears Desmoservice wrench icon on dashboard after 15,000 / 30,000 km service."},byd_bms_isolation_self_test:{name:"BYD Blade Battery High-Voltage Isolation Self-Test",desc:"Executes high-voltage system leakage & resistance diagnostics in BMS."},vag_drl_brightness_multi:{name:"Daytime Running Lights Brightness Adjustment",desc:"Adjust LED DRL intensity level for low-beam / parking mode."},bmw_comfort_turn_signal_cycles:{name:"One-Touch Comfort Turn Signal Pulse Count",desc:"Select how many blinks occur on quick tap of turn indicator lever."},bmw_oil_service_reset:{name:"CBS Engine Oil Reset",desc:"Resets Condition Based Service oil life percentage back to 100%."},generic_oil_service_reset:{name:"Universal Oil Maintenance Indicator Reset",desc:"Clears dashboard oil maintenance warning light across supported OBD2/UDS ECUs."},vag_epb_pad_change:{name:"EPB Brake Pad Replacement Mode",desc:"Retracts electronic parking brake calipers for rear brake pad servicing."},bmw_epb_pad_change:{name:"EPB Brake Service Mode",desc:"Opens parking brake actuator 