rance."},honda_bi_directional_quickshifter_enable:{name:"Bi-Directional Quickshifter Retrofit Unlock",desc:"Enables auto-blipper and up/down quickshifter coding in ECU memory."},honda_service_reminder_custom_interval:{name:"Oil Service Reminder Distance Customizer",desc:"Sets custom oil change mileage interval on digital dash."},honda_track_abs_rear_disable:{name:"Track ABS Rear-Wheel Deactivation",desc:"Disables rear wheel ABS channel while retaining front cornering ABS for track days."},honda_cold_start_idle_enrichment:{name:"Cold-Start Fuel Enrichment & Idle Target RPM",desc:"Adjusts initial warm-up idle speed for aftermarket exhaust systems."},harley_custom_throttle_curve_editor:{name:"Custom Throttle Response Curve Editor",desc:"Adjusts Milwaukee-Eight / Revolution Max ride-by-wire throttle progression."},harley_security_alarm_sensitivity:{name:"Smart Security System Proximity & Tilt Sensitivity",desc:"Adjusts motion sensor sensitivity and hands-free fob arming delay."},harley_boom_box_gts_hidden_diagnostics:{name:"Boom! Box GTS Infotainment Hidden Diagnostic Menu",desc:"Unlocks engineering telemetry displays, engine temp, and oil pressure gauges."},harley_rdrs_defensive_system_tune:{name:"RDRS Drag-Torque Slip Control Sensitivity",desc:"Fine-tunes Reflex Defensive Rider System rear-wheel slip mitigation during downshifts."},byd_avas_low_speed_siren_mute:{name:"AVAS Low-Speed EV Pedestrian Warning Siren Mute",desc:"Mutes or lowers external acoustic vehicle alerting system siren under 30 km/h."},byd_ev_battery_preheat_manual_switch:{name:"Manual EV Battery Pre-Heating Toggle",desc:"Enables manual battery thermal conditioning prior to DC fast charging."},byd_v2l_220v_outlet_power_expansion:{name:"V2L 220V Outlet Power Expansion",desc:"Expands external V2L discharge power ceiling from 2.2 kW to 3.6 kW maximum."},byd_one_pedal_regen_default_max:{name:"One-Pedal Drive Regenerative Braking Default Max",desc:"Locks high regenerative braking as persistent default upon 