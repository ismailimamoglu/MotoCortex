n",manifoldPressure:"Presi\xf3n Colector",ambientTemp:"Temp. Exterior",oilTemp:"Temp. del Aceite",mafFlow:"Caudal de Aire MAF",timingAdvance:"Avance Encendido",fuelLevel:"Nivel de Combustible",catalystTemp:"Temp. Catalizador",layoutGauge:"INDICADOR",obdTerminalTitle:"SALUD Y TERMINAL DEL OBD",adapterClone:"ADAPTADOR CLON",adapterOriginal:"ORIGINALES",adapterCloneShort:"CLON",adapterOriginalShort:"ORIGINALES",pidLabel:"PID: {{pid}}",limitReached:"L\xedmite de selecci\xf3n",limitReachedDesc:"Puede seleccionar un m\xe1ximo de {{limit}} sensores con este protocolo.",customizeSubtitleKLine:"Protocolo K-Line conectado. Puede seleccionar un m\xe1ximo de {{limit}} sensores.",customizeSubtitleCAN:"Protocolo CAN-Bus conectado. Puede seleccionar un m\xe1ximo de {{limit}} sensores.",unit:"Unidad",statusNormal:"NORMALES",layoutChart:"GR\xc1FICO",adblue:"Nivel de AdBlue",egt:"Temp. de gases de escape",nox:"Valor del sensor NOx",torque:"Par motor",selectedSensorsCount:"{{count}} / {{max}} sensores seleccionados",proSensorMsg:"Upgrade to PRO to unlock and monitor advanced live sensors."},expertise:{historyFound:"\xa1HISTORIAL ENCONTRADO!",historyFoundDesc:"Este veh\xedculo tiene {{count}} registros previos.",viewHistory:"VER HISTORIAL \u203a",manualVin:"VIN",manualVinDesc:"Si la ECU no comparte el VIN autom\xe1ticamente, escr\xedbalo aqu\xed.",vinPlaceholder:"Escribir VIN...",startScan:"INICIAR ESCANEO",scanning:"ESCANEANDO...",vehicleIdentity:"IDENTIDAD DEL VEH\xcdCULO Y KILOMETRAJE",vin:"VIN",odometer:"Kilometraje Original",distSinceCleared:"Distancia desde Limpieza",milDist:"Distancia con MIL",dtcTitle:"C\xd3DIGOS DE ERROR",dtcClean:"SIN C\xd3DIGOS DE ERROR \u2014 LIMPIO",extraActions:"ACCIONES ADICIONALES",garageTitle:"GARAJE Y REGISTROS",share:"COMPARTIR",saveVehicle:"GUARDAR VEH\xcdCULO",noRecords:"No hay veh\xedculos guardados.",clean:"LIMPIO",faults:"ERRORES",vinRequired:"VIN Requerido",vinRequiredDesc:"El VIN debe detectarse o ingresarse manualmente.",missingInfo:"Falta Informaci\xf3n",missingInfoDesc:"Por favor complete Marca y Modelo.",saved:"Guardado",savedDesc:"Resultado de diagn\xf3stico guardado.",connRequired:"Conexi\xf3n Requerida",connRequiredDesc:"Con\xe9ctese al veh\xedculo primero.",chronicFaultsTitle:"Fallos cr\xf3nicos estad\xedsticos",chronicFaultsObs:"{{code}} (Observaci\xf3n: {{days}} d\xedas \xfanicos / Total: {{total}} veces)",chronicFaultsPending:"Recopilando grupo de datos / Analizando estad\xedsticas",notScanned:"No escaneado",notScannedDesc:"Presione el bot\xf3n de escaneo en la parte superior derecha para leer los c\xf3digos de diagn\xf3stico.",scanFailed:"ESCANEO ERROR",errTimeout:"Error: Connection Timeout\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error\nECU trouble codes could not be read.",scannedSystems:"SISTEMAS ESCANEADOS",moduleEngine:"Unidad de control del motor",moduleAbs:"Sistema de frenos antibloqueo",moduleTcm:"M\xf3dulo de control de transmisi\xf3n",moduleBcm:"M\xf3dulo de control de la carrocer\xeda",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:"ADVERTENCIA DE SEGURIDAD",safetyWarningDesc:"Contacto ENCENDIDO, Motor APAGADO. \xbfContinuar?",step1:"Paso 1: Borrar C\xf3digos",step1Desc:"Se borrar\xe1n los c\xf3digos de error y la luz del motor.",step2:"Paso 2: Reinicio de ECU",step2Desc:"Se enviar\xe1 un reinicio el\xe9ctrico a la ECU.",clearCodes:"Borrar C\xf3digos",ecuReset:"Reiniciar ECU",finish:"Omitir",completed:"Completado",completedDesc:"Operaciones de servicio completadas.",hardResetDesc:"Todas las operaciones completadas con \xe9xito."},info:{desc:"Aplicaci\xf3n profesional de diagn\xf3stico de veh\xedculos.",upgrade:"Mejorar a Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"Acceso Anticipado",upgradeAlertDesc:"Todas las funciones PRO est\xe1n desbloqueadas en esta versi\xf3n.",helpGuide:"AYUDA Y GU\xcdA",language:"Idioma / Language",support:"CENTRO DE SOPORTE",supportSubject:"Cortex OBD2 Diagnostic Scanner Soporte y Comentarios",thanks:"\xa1Gracias!",thanksDesc:"Gracias por sus comentarios.",sections:{live:{title:"SENSORES EN VIVO",content:"Monitoree RPM, Velocidad y Temperatura en tiempo real."},expertise:{title:"DIAGN\xd3STICO",content:"Detecci\xf3n de fallos mediante c\xf3digos de ECU."},tests:{title:"TESTS DE BATER\xcdA",content:"Mida la salud de la bater\xeda y el regulador."},hardware:{title:"COMPATIBILIDAD",content:"Se recomienda adaptador ELM327 Bluetooth v1.5."},warnings:{title:"ADVERTENCIAS",content:"Contacto ON, Motor OFF para borrar fallos."},onboarding:{title:"PERMISOS LEGALES Y TELEMETR\xcdA AN\xd3NIMA",content:"Para mejorar la calidad de la aplicaci\xf3n y la compatibilidad del veh\xedculo, los par\xe1metros del motor y los c\xf3digos de falla de diagn\xf3stico completamente anonimizados capturados durante el diagn\xf3stico pueden analizarse en nuestros servidores seguros. Al continuar, acepta estos t\xe9rminos de telemetr\xeda an\xf3nima. Se requieren permisos de Bluetooth y Ubicaci\xf3n para establecer una conexi\xf3n con la ECU de su motocicleta."},featureCoding:{title:"DESBLOQUEO DE FUNCIONES OCULTAS Y CODIFICACI\xd3N UDS",content:"Impulsado por nuestro motor de protocolo UDS ISO 14229, alterna de forma segura funciones como luces de estacionamiento de EE. UU., barrido de aguja, bloqueo de respuesta de bocina, ventanas de confort y configuraciones DRL para veh\xedculos VAG, BMW, Renault y Dacia."},multiEcu:{title:"ESCANEO DE TODOS LOS M\xd3DULOS MULTI-ECU",content:"Escanee y borre c\xf3digos de falla m\xe1s all\xe1 de la ECU del motor, incluidos ABS, Airbag, transmisi\xf3n autom\xe1tica, grupo de instrumentos, control de clima y m\xf3dulos de control de la carrocer\xeda."},advancedDiagnostics:{title:"ADAPTACI\xd3N DCT, DPF Y MEDIDOR DE POTENCIA HP",content:"\u2022 Reinicio de adaptaci\xf3n y aprendizaje del punto de beso del embrague DCT/DSG\n\u2022 Monitoreo de la carga de holl\xedn del DPF y temperatura de regeneraci\xf3n del escape\n\u2022 Ajustes de combustible a corto y largo plazo y an\xe1lisis Lambda en tiempo real\n\u2022 Gr\xe1fico de telemetr\xeda en vivo de caballos de fuerza y torque din\xe1micos"},demoMode:{title:"MODO DEMO",content:"Pruebe y explore la aplicaci\xf3n sin hardware OBD2 f\xedsico. Experimente las funciones de diagn\xf3stico CAN-Bus y UDS con simulaci\xf3n de telemetr\xeda en tiempo real."}},reconfigurePermissions:"Volver a ejecutar el onboarding y los t\xe9rminos legales",shareWithFriend:"COMPARTIR CON UN AMIGO",shareMessageText:"\xa1Descubre los c\xf3digos de falla de la ECU del veh\xedculo y la telemetr\xeda de sensores en vivo con Cortex OBD2 Diagnostic Scanner! Descargar ahora: iOS: https://apps.apple.com/app/id6764052240 Android: https://play.google.com/store/apps/details?id=com.ismail.motocortexv2 Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:"\u2550\u2550\u2550 REPORTE DE DIAGN\xd3STICO \u2550\u2550\u2550",vehicleIdentity:"IDENTIDAD DEL VEH\xcdCULO",vin:"VIN",odometer:"Kilometraje",milDist:"Distancia MIL",distSinceCleared:"Distancia desde Limpieza",dtcCount:"C\xd3DIGOS DE FALLA ({{count}})",sensorData:"DATOS EN VIVO",noData:"Sin datos disponibles",proApp:"Escaneado con Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"Fecha",vinNotFound:"No Detectado",noDtcs:"SIN C\xd3DIGOS DE ERROR \u2014 LIMPIO",speed:"Velocidad",coolant:"Temp. Motor",throttle:"Acelerador",engineLoad:"Carga Motor",intakeAir:"Admisi\xf3n Aire",manifold:"Colector",voltage:"Voltaje Bater\xeda",shareMessage:"\xa1Monitorea la salud de tu moto desde tu bolsillo con Cortex OBD2 Diagnostic Scanner! Descargar: https://cortexobd2.app",subtitle:"Inspecci\xf3n integral de diagn\xf3stico y telemetr\xeda de segunda mano",vehicleInfo:"Identificaci\xf3n del veh\xedculo y metadatos de la ECU",healthS