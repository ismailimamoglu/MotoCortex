d\u03b4\u03b5\u03b9\u03be\u03b7\u03c2 \u03c3\u03c5\u03bd\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7\u03c2 \u03bb\u03b1\u03b4\u03b9\u03bf\u03cd \u03b3\u03b5\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c7\u03c1\u03ae\u03c3\u03b7\u03c2",desc:"\u0394\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03b9\u03b7\u03c4\u03b9\u03ba\u03ae \u03bb\u03c5\u03c7\u03bd\u03af\u03b1 \u03c3\u03c5\u03bd\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7\u03c2 \u03bb\u03b1\u03b4\u03b9\u03bf\u03cd \u03c4\u03b1\u03bc\u03c0\u03bb\u03cc \u03c3\u03b5 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03b9\u03b6\u03cc\u03bc\u03b5\u03bd\u03b5\u03c2 \u03bc\u03bf\u03bd\u03ac\u03b4\u03b5\u03c2 ECU OBD2/UDS."},vag_epb_pad_change:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03c4\u03b1\u03ba\u03b1\u03ba\u03b9\u03ce\u03bd \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd EPB (VAG)",desc:"\u0391\u03c0\u03bf\u03c3\u03cd\u03c1\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03ad\u03c2 \u03b4\u03b1\u03b3\u03ba\u03ac\u03bd\u03b5\u03c2 \u03c4\u03bf\u03c5 \u03c7\u03b5\u03b9\u03c1\u03cc\u03c6\u03c1\u03b5\u03bd\u03bf\u03c5 \u03b3\u03b9\u03b1 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03c4\u03b1\u03ba\u03ac\u03ba\u03b9\u03b1 \u03c0\u03af\u03c3\u03c9 \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd."},bmw_epb_pad_change:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd EPB (BMW)",desc:"\u0391\u03bd\u03bf\u03af\u03b3\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03c4\u03ae \u03c7\u03b5\u03b9\u03c1\u03cc\u03c6\u03c1\u03b5\u03bd\u03bf\u03c5 \u03c3\u03c4\u03b7 \u03b8\u03ad\u03c3\u03b7 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03b3\u03b9\u03b1 \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c0\u03af\u03c3\u03c9 \u03c4\u03b1\u03ba\u03b1\u03ba\u03b9\u03bf\u03cd."},mb_epb_pad_change:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c4\u03bf\u03c0\u03bf\u03b8\u03ad\u03c4\u03b7\u03c3\u03b7\u03c2 \u03bc\u03b1\u03be\u03b9\u03bb\u03b1\u03c1\u03b9\u03bf\u03cd EPB (Mercedes-Benz)",desc:"\u0391\u03c0\u03b5\u03bb\u03b5\u03c5\u03b8\u03b5\u03c1\u03ce\u03bd\u03b5\u03b9 \u03c4\u03bf\u03bd \u03ac\u03be\u03bf\u03bd\u03b1 \u03c4\u03bf\u03c5 \u03c7\u03b5\u03b9\u03c1\u03cc\u03c6\u03c1\u03b5\u03bd\u03bf\u03c5 \u03c3\u03c4\u03b7 \u03b8\u03ad\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03bf\u03c5 \u03b3\u03b9\u03b1 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03c0\u03ad\u03b4\u03b7\u03c3\u03b7\u03c2."},vag_dpf_regen:{name:"DPF Service Regeneration Trigger (VAG)",desc:"\u0395\u03ba\u03ba\u03b9\u03bd\u03b5\u03af \u03c4\u03bf\u03bd \u03ba\u03cd\u03ba\u03bb\u03bf \u03ba\u03b1\u03cd\u03c3\u03b7\u03c2 \u03b1\u03b9\u03b8\u03ac\u03bb\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b1\u03b8\u03b5\u03c1\u03bf\u03cd \u03c6\u03af\u03bb\u03c4\u03c1\u03bf\u03c5 \u03c3\u03c9\u03bc\u03b1\u03c4\u03b9\u03b4\u03af\u03c9\u03bd \u03bd\u03c4\u03af\u03b6\u03b5\u03bb (DPF)."},bmw_dpf_regen:{name:"DPF Forced Regeneration Trigger (BMW)",desc:"\u0396\u03b7\u03c4\u03b5\u03af \u03b1\u03c0\u03cc \u03c4\u03bf DDE ECU \u03bd\u03b1 \u03be\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03b5\u03b9 \u03c4\u03b7 \u03c1\u03bf\u03c5\u03c4\u03af\u03bd\u03b1 \u03b1\u03bd\u03b1\u03b3\u03ad\u03bd\u03bd\u03b7\u03c3\u03b7\u03c2 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03cd \u03c6\u03af\u03bb\u03c4\u03c1\u03bf\u03c5 \u03c3\u03c9\u03bc\u03b1\u03c4\u03b9\u03b4\u03af\u03c9\u03bd."},psa_dpf_regen:{name:"\u0391\u03af\u03c4\u03b7\u03bc\u03b1 \u03b1\u03bd\u03b1\u03b3\u03ad\u03bd\u03bd\u03b7\u03c3\u03b7\u03c2 DPF (Peugeot/Citro\xebn)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7 \u03c3\u03c4\u03b1\u03b8\u03b5\u03c1\u03ae \u03b1\u03bd\u03b1\u03b3\u03ad\u03bd\u03bd\u03b7\u03c3\u03b7 DPF \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 ECU \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03bd\u03c4\u03af\u03b6\u03b5\u03bb HDi."},bmw_bms_battery_register:{name:"\u0395\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03b9\u03ce\u03bd BMS (BMW)",desc:"\u039a\u03b1\u03c4\u03b1\u03c7\u03c9\u03c1\u03b5\u03af \u03bd\u03ad\u03b1 \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 \u03bc\u03b5 \u0388\u03be\u03c5\u03c0\u03bd\u03bf \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 DME/DDE."},mb_bms_battery_register:{name:"\u0395\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae \u03ba\u03b1\u03b9 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 (Mercedes-Benz)",desc:"\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae \u03b3\u03ae\u03c1\u03b1\u03bd\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 \u03c3\u03c4\u03b7 \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1 SAM \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03b3\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bd\u03ad\u03b1\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2."},vag_sas_calibrate:{name:"\u0392\u03b1\u03b8\u03bc\u03bf\u03bd\u03cc\u03bc\u03b7\u03c3\u03b7 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b3\u03c9\u03bd\u03af\u03b1\u03c2 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd (SAS) (VAG)",desc:"\u0392\u03b1\u03b8\u03bc\u03bf\u03bd\u03bf\u03bc\u03b5\u03af \u03c4\u03b7 \u03b8\u03ad\u03c3\u03b7 \u03bc\u03b7\u03b4\u03ad\u03bd \u03c4\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b3\u03c9\u03bd\u03af\u03b1\u03c2 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd G85 \u03b3\u03b9\u03b1 ABS/ESP ECU."},toyota_sas_calibrate:{name:"\u0392\u03b1\u03b8\u03bc\u03bf\u03bd\u03cc\u03bc\u03b7\u03c3\u03b7 \u03bc\u03b7\u03b4\u03b5\u03bd\u03b9\u03ba\u03bf\u03cd \u03c3\u03b7\u03bc\u03b5\u03af\u03bf\u03c5 \u03b3\u03c9\u03bd\u03af\u03b1\u03c2 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd (Toyota)",desc:"\u0395\u03ba\u03c4\u03b5\u03bb\u03b5\u03af \u03b2\u03b1\u03b8\u03bc\u03bf\u03bd\u03cc\u03bc\u03b7\u03c3\u03b7 \u03c3\u03b7\u03bc\u03b5\u03af\u03bf\u03c5 \u03bc\u03b7\u03b4\u03ad\u03bd \u03c4\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b3\u03c9\u03bd\u03af\u03b1\u03c2 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd \u03c3\u03c4\u03bf Skid Control ECU."},generic_tba_adapt:{name:"\u0395\u03c5\u03b8\u03c5\u03b3\u03c1\u03ac\u03bc\u03bc\u03b9\u03c3\u03b7 & \u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03b5\u03c4\u03b1\u03bb\u03bf\u03cd\u03b4\u03b1\u03c2",desc:"\u0395\u03ba\u03c4\u03b5\u03bb\u03b5\u03af \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03ae \u03c1\u03bf\u03c5\u03c4\u03af\u03bd\u03b1 \u03b5\u03ba\u03bc\u03ac\u03b8\u03b7\u03c3\u03b7\u03c2 \u03c0\u03b1\u03cd\u03c3\u03b7\u03c2 \u03c3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b3\u03ba\u03b1\u03b6\u03b9\u03bf\u03cd \u03c3\u03c4\u03b7\u03bd ECU \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1."},epb_service_reset:{name:"Universal EPB Maintenance Reset",desc:"\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae \u03c6\u03b8\u03bf\u03c1\u03ac\u03c2 \u03c4\u03b7\u03c2 \u03b4\u03b1\u03b3\u03ba\u03ac\u03bd\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03c7\u03b5\u03b9\u03c1\u03cc\u03c6\u03c1\u03b5\u03bd\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bd\u03bf\u03bc\u03b5\u03af \u03c4\u03bf \u03b4\u03b9\u03ac\u03ba\u03b5\u03bd\u03bf \u03b1\u03ad\u03c1\u03b1."},vag_dsg_reset:{name:"\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03b2\u03b1\u03c3\u03b9\u03ba\u03ce\u03bd \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03c9\u03bd \u03ba\u03b9\u03b2\u03c9\u03c4\u03af\u03bf\u03c5 \u03c4\u03b1\u03c7\u03c5\u03c4\u03ae\u03c4\u03c9\u03bd DSG (VAG)",desc:"\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03b1 \u03c3\u03b7\u03bc\u03b5\u03af\u03b1 \u03b5\u03bc\u03c0\u03bb\u03bf\u03ba\u03ae\u03c2 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bc\u03c0\u03bb\u03ad\u03ba\u03c4\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03c2 \u03b2\u03b1\u03bb\u03b2\u03af\u03b4\u03b1\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03c4\u03b1\u03c7\u03c5\u03c4\u03ae\u03c4\u03c9\u03bd \u03b3\u03b9\u03b1 DSG/S-Tronic."},bmw_zf_reset:{name:"\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 \u03ba\u03b9\u03b2\u03c9\u03c4\u03af\u03bf\u03c5 \u03c4\u03b1\u03c7\u03c5\u03c4\u03ae\u03c4\u03c9\u03bd ZF 8HP (BMW)",desc:"\u0394\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c4\u03b9\u03bc\u03ad\u03c2 \u03c7\u03c1\u03cc\u03bd\u03bf\u03c5 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03af\u03b5\u03c3\u03b7\u03c2 \u03bc\u03b5\u03c4\u03ac\u03b4\u03bf\u03c3\u03b7\u03c2 EGS."},bmw_brake_fluid_reset:{name:"\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03b4\u03b9\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03c5\u03b3\u03c1\u03ce\u03bd \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd (BMW)",desc:"Resets Condition Based Service (CBS) \u03c7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03c5\u03b3\u03c1\u03ce\u03bd \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd 2 \u03b5\u03c4\u03ce\u03bd."},ford_injector_code:{name:"\u039a\u03c9\u03b4\u03b9\u03ba\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c3\u03c5\u03bd\u03c4\u03b5\u03bb\u03b5\u03c3\u03c4\u03ae \u03b4\u03b9\u03cc\u03c1\u03b8\u03c9\u03c3\u03b7\u03c2 \u03bc\u03c0\u03b5\u03ba (Ford)",desc:"\u03a0\u03c1\u03bf\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1\u03c4\u03af\u03b6\u03b5\u03b9 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03cd\u03c2 IQA 16 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03ae\u03c1\u03c9\u03bd \u03b3\u03b9\u03b1 \u03bc\u03c0\u03b5\u03ba \u03bd\u03c4\u03af\u03b6\u03b5\u03bb \u03c3\u03c4\u03bf PCM."},bmw_injector_code:{name:"\u039a\u03c9\u03b4\u03b9\u03ba\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c1\u03bf\u03ae\u03c2 \u03bc\u03c0\u03b5\u03ba \u03c8\u03b5\u03ba\u03b1\u03c3\u03bc\u03bf\u03cd \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 (BMW)",desc:"\u0393\u03c1\u03ac\u03c6\u03b5\u03b9 \u03c4\u03b9\u03bc\u03ad\u03c2 \u03b5\u03bd\u03b5\u03c1\u03b3\u03b5\u03b9\u03b1\u03ba\u03ae\u03c2 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bd\u03cc\u03bc\u03b7\u03c3\u03b7\u03c2 \u03b3\u03b9\u03b1 \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03b1\u03b8\u03ad\u03bd\u03c4\u03b1 \u03bc\u03c0\u03b5\u03ba \u03c8\u03b5\u03ba\u03b1\u03c3\u03bc\u03bf\u03cd \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u03c3\u03c4\u03bf DME."},generic_headlight_aim:{name:"\u0392\u03b1\u03b8\u03bc\u03bf\u03bd\u03cc\u03bc\u03b7\u03c3\u03b7 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7\u03c2 \u03b5\u03c5\u03b8\u03c5\u03b3\u03c1\u03ac\u03bc\u03bc\u03b9\u03c3\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7 \u03bc\u03b7\u03b4\u03b5\u03bd\u03b9\u03ba\u03ae \u03b8\u03ad\u03c3\u03b7 \u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac\u03c2 \u03b3\u03b9\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7\u03c2 \u03bf\u03c1\u03b9\u03b6\u03bf\u03bd\u03c4\u03af\u03c9\u03c3\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd."},bmw_12v_battery_reg:{name:"\u039a\u03b1\u03c4\u03b1\u03c7\u03ce\u03c1\u03b7\u03c3\u03b7 \u03b2\u03bf\u03b7\u03b8\u03b7\u03c4\u03b9\u03ba\u03ae\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 12V (BMW)",desc:"\u039a\u03b1\u03c4\u03b1\u03c7\u03c9\u03c1\u03b5\u03af \u03b2\u03bf\u03b7\u03b8\u03b7\u03c4\u03b9\u03ba\u03ae \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2/\u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2 AGM \u03c3\u03b5 PCU."},vag_comfort_turn_signal:{name:"\u03a0\u03bb\u03ae\u03b8\u03bf\u03c2 \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03c0\u03ae\u03c2 \u03c6\u03bb\u03b1\u03c2 Comfort (VAG)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc \u03ba\u03cd\u03ba\u03bb\u03c9\u03bd \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03c0\u03ae\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03bb\u03c9\u03c1\u03af\u03b4\u03b1\u03c2 \u03bc\u03b5\u03c4\u03b1\u03be\u03cd 3, 4 \u03ba\u03b1\u03b9 5 \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03c0\u03ce\u03bd."},vag_coming_home_duration:{name:"\u0394\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c6\u03c9\u03c4\u03cc\u03c2 \u03b5\u03c1\u03c7\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5/\u03b5\u03be\u03cc\u03b4\u03bf\u03c5 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c3\u03c0\u03af\u03c4\u03b9 (VAG)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c7\u03c1\u03bf\u03bd\u03cc\u03bc\u03b5\u03c4\u03c1\u03bf \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd \u03bc\u03b5\u03c4\u03ac \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 (10s - 60s)."},vag_remote_windows:{name:"\u0391\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf\u03c2 \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5 \u03ac\u03bd\u03b5\u03c3\u03b7\u03c2 (VAG)",desc:"\u0395\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf \u03ac\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03c3\u03b9\u03bc\u03bf \u03c4\u03c9\u03bd \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ce\u03bd \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03c9\u03bd \u03bc\u03b5 \u03c4\u03bf \u03c0\u03b1\u03c1\u03b1\u03c4\u03b5\u03c4\u03b1\u03bc\u03ad\u03bd\u03bf \u03c0\u03ac\u03c4\u03b7\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03b7\u03c1\u03af\u03bf\u03c5."},vag_auto_lock_15kmh:{name:"\u0391\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 \u03c3\u03c4\u03b1 15 km/h (VAG)",desc:"\u039a\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b5\u03c2 \u03cc\u03c4\u03b1\u03bd \u03b7 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c6\u03c4\u03ac\u03c3\u03b5\u03b9 \u03c4\u03b1 15 km/h."},vag_sfd_unlock_prep:{name:"\u03a0\u03c1\u03bf\u03b5\u03c4\u03bf\u03b9\u03bc\u03b1\u03c3\u03af\u03b1 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03c0\u03c1\u03bf\u03c3\u03c4\u03b1\u03c3\u03af\u03b1\u03c2 \u03c0\u03cd\u03bb\u03b7\u03c2 SFD (VAG 2020+)",desc:"\u03a0\u03c1\u03bf\u03b5\u03c4\u03bf\u03b9\u03bc\u03ac\u03b6\u03b5\u03b9 \u03c0\u03b5\u03c1\u03af\u03bf\u03b4\u03bf \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03b4\u03b9\u03b1\u03ba\u03c1\u03b9\u03c4\u03b9\u03ba\u03bf\u03cd \u03c0\u03cd\u03bb\u03b7\u03c2 MQB-evo SFD \u03b3\u03b9\u03b1 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae \u03c0\u03c1\u03bf\u03c3\u03c4\u03b1\u03c4\u03b5\u03c5\u03bc\u03ad\u03bd\u03c9\u03bd DID."},bmw_asd_deactivate:{name:"\u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 Active Sound Design (ASD) (BMW)",desc:"\u03a3\u03af\u03b3\u03b1\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b8\u03b5\u03c4\u03b9\u03ba\u03bf\u03cd \u03ae\u03c7\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03c0\u03bf\u03c5 \u03c0\u03b1\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03b7\u03c7\u03b5\u03af\u03b1 \u03c4\u03b7\u03c2 \u03ba\u03b1\u03bc\u03c0\u03af\u03bd\u03b1\u03c2."},bmw_comfort_turn_signal:{name:"Comfort Turn Count (BMW)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc \u03c0\u03b1\u03bb\u03bc\u03ce\u03bd \u03c4\u03b7\u03c2 \u03ad\u03bd\u03b4\u03b5\u03b9\u03be\u03b7\u03c2 \u03bc\u03b5 \u03ad\u03bd\u03b1 \u03c0\u03ac\u03c4\u03b7\u03bc\u03b1 (1 \u03ad\u03c9\u03c2 5 \u03b1\u03bd\u03b1\u03b2\u03bf\u03c3\u03b2\u03ae\u03bd\u03b5\u03b9)."},bmw_mirror_fold_lock:{name:"Comfort Access Mirror Fold on Lock (BMW)",desc:"\u0394\u03b9\u03c0\u03bb\u03ce\u03bd\u03b5\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5\u03c2 \u03c0\u03bb\u03b1\u03ca\u03bd\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b5\u03c2 \u03b1\u03bc\u03ad\u03c3\u03c9\u03c2 \u03bc\u03cc\u03bb\u03b9\u03c2 \u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03c3\u03b5\u03b9 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1."},toyota_coming_home_duration:{name:"\u039a\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7 \u03b5\u03c5\u03b3\u03b5\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03bf\u03c3\u03c6\u03bf\u03c1\u03ac\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd / \u0395\u03c0\u03b9\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c3\u03c4\u03bf \u03c3\u03c0\u03af\u03c4\u03b9 (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03c7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7 \u03ba\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7\u03c2 \u03c3\u03b2\u03b7\u03c3\u03af\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd \u03bc\u03b5\u03c4\u03ac \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03c3\u03b9\u03bc\u03bf \u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2 (30s-120s)."},toyota_lane_change_flash:{name:"\u0391\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03c6\u03bb\u03b1\u03c2 \u03c6\u03bb\u03b1\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03bb\u03c9\u03c1\u03af\u03b4\u03b1\u03c2 (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc \u03ba\u03cd\u03ba\u03bb\u03c9\u03bd \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03bb\u03c9\u03c1\u03af\u03b4\u03b1\u03c2 \u03bc\u03b5 \u03ad\u03bd\u03b1 \u03c0\u03ac\u03c4\u03b7\u03bc\u03b1."},toyota_remote_window_close:{name:"\u0391\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf \u03ba\u03bb\u03b5\u03af\u03c3\u03b9\u03bc\u03bf \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03bf\u03cd \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5 (Toyota)",desc:"\u0395\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03c3\u03b9\u03bc\u03bf \u03cc\u03bb\u03c9\u03bd \u03c4\u03c9\u03bd \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ce\u03bd \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03c9\u03bd \u03ba\u03c1\u03b1\u03c4\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c0\u03b1\u03c4\u03b7\u03bc\u03ad\u03bd\u03bf \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03b1\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5 \u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2."},toyota_autolock_behavior:{name:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf\u03c5 \u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2/\u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7 \u03c3\u03ba\u03b1\u03bd\u03b4\u03ac\u03bb\u03b7 \u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 (Shift out of P vs Vehicle Speed > 20 km/h)."},toyota_approach_welcome_lights:{name:"\u03a6\u03ce\u03c4\u03b1 \u03ba\u03b1\u03bb\u03c9\u03c3\u03bf\u03c1\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 Smart Key Approach (Toyota)",desc:"\u0391\u03bd\u03ac\u03b2\u03b5\u03b9 \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae\u03c2 \u03bb\u03b1\u03ba\u03ba\u03bf\u03cd\u03b2\u03b1\u03c2/\u03ba\u03b1\u03bc\u03c0\u03af\u03bd\u03b1\u03c2 \u03cc\u03c4\u03b1\u03bd \u03c4\u03bf \u03ad\u03be\u03c5\u03c0\u03bd\u03bf \u03ba\u03bb\u03b5\u03b9\u03b4\u03af \u03c0\u03bb\u03b7\u03c3\u03b9\u03ac\u03b6\u03b5\u03b9 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1."},hyundai_autolock_behavior:{name:"\u03a3\u03c5\u03bc\u03c0\u03b5\u03c1\u03b9\u03c6\u03bf\u03c1\u03ac \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf\u03c5 \u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2/\u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 (Hyundai/Kia)",desc:"\u039a\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03c4\u03b9\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b5\u03c2 \u03bc\u03b5 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03ae \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c3\u03c4\u03bf P \u03ae \u03c3\u03c4\u03bf Ignition Off."},hyundai_window_remote:{name:"\u0391\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf \u03ac\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1/\u03ba\u03bb\u03b5\u03af\u03c3\u03b9\u03bc\u03bf \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5 (Hyundai/Kia)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b1 \u03ba\u03c5\u03bb\u03b9\u03cc\u03bc\u03b5\u03bd\u03b1 \u03c0\u03b1\u03c1\u03ac\u03b8\u03c5\u03c1\u03b1 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c9/\u03ba\u03ac\u03c4\u03c9 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ce\u03bd\u03c4\u03b1\u03c2 \u03ad\u03be\u03c5\u03c0\u03bd\u03b1 \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03ac \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba."},hyundai_sport_mode_memory:{name:"\u039c\u03bd\u03ae\u03bc\u03b7 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 (Hyundai/Kia)",desc:"\u0398\u03c5\u03bc\u03ac\u03c4\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 (Sport/Eco) \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1."},tesla_charge_limit_custom:{name:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03bf\u03c1\u03af\u03bf\u03c5 \u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 (Tesla)",desc:"\u039f\u03c1\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03cc\u03c1\u03b9\u03bf \u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 HV (80% \u0397\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03b1 / 100% \u03a4\u03b1\u03be\u03af\u03b4\u03b9)."},tesla_mirror_fold_lock:{name:"\u0391\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03b1\u03bd\u03b1\u03b4\u03af\u03c0\u03bb\u03c9\u03c3\u03b7 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b7 \u03c3\u03c4\u03b7\u03bd \u03ba\u03bb\u03b5\u03b9\u03b4\u03b1\u03c1\u03b9\u03ac Walk-Away (Tesla)",desc:"\u0394\u03b9\u03c0\u03bb\u03ce\u03bd\u03b5\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5\u03c2 \u03c0\u03bb\u03b1\u03ca\u03bd\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b5\u03c2 \u03cc\u03c4\u03b1\u03bd \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1\u03b9 \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03bb\u03b5\u03b9\u03b4\u03b9\u03bf\u03cd \u03c4\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c6\u03ce\u03bd\u03bf\u03c5."},nissan_coming_home:{name:"\u0395\u03c5\u03b3\u03b5\u03bd\u03b9\u03ba\u03ae \u03ba\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7 \u03c3\u03b2\u03b7\u03c3\u03af\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03b1 (Nissan)",desc:"\u0394\u03b9\u03b1\u03c4\u03b7\u03c1\u03b5\u03af \u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03b5\u03af\u03c2 \u03b1\u03bd\u03b1\u03bc\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2 \u03b3\u03b9\u03b1 30 \u03b4\u03b5\u03c5\u03c4\u03b5\u03c1\u03cc\u03bb\u03b5\u03c0\u03c4\u03b1 \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03ad\u03be\u03bf\u03b4\u03bf \u03b1\u03c0\u03cc \u03c4\u03bf \u03b1\u03c5\u03c4\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03bf Nissan."},nissan_lane_change_flash:{name:"\u0391\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03c6\u03bb\u03b1\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03bb\u03c9\u03c1\u03af\u03b4\u03b1\u03c2 Tap-to-Pass (Nissan)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc \u03c0\u03b1\u03bb\u03bc\u03ce\u03bd \u03c4\u03c9\u03bd \u03b5\u03bd\u03b4\u03b5\u03b9\u03ba\u03c4\u03b9\u03ba\u03ce\u03bd \u03c6\u03bb\u03b1\u03c2 \u03c3\u03c4\u03bf \u03b5\u03bb\u03b1\u03c6\u03c1\u03cd \u03c3\u03c4\u03c1\u03cc\u03c6\u03b9\u03b3\u03b3\u03b1."},nissan_autolock_behavior:{name:"\u0391\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03ba\u03bb\u03b5\u03b9\u03b4\u03b1\u03c1\u03b9\u03ac \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 (Nissan)",desc:"\u039a\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b5\u03c2 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03cc\u03c4\u03b1\u03bd \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u03c6\u03c4\u03ac\u03c3\u03b5\u03b9 \u03c4\u03b1 24 km/h."},nissan_window_remote:{name:"\u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03bf\u03cd \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03b7\u03c1\u03af\u03bf\u03c5 \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba (Nissan)",desc:"\u0391\u03bd\u03bf\u03af\u03b3\u03b5\u03b9/\u03ba\u03bb\u03b5\u03af\u03bd\u03b5\u03b9 \u03c4\u03b1 \u03bc\u03c0\u03c1\u03bf\u03c3\u03c4\u03b9\u03bd\u03ac \u03c0\u03b1\u03c1\u03ac\u03b8\u03c5\u03c1\u03b1 \u03c0\u03b1\u03c4\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c0\u03b1\u03c1\u03b1\u03c4\u03b5\u03c4\u03b1\u03bc\u03ad\u03bd\u03b1 \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba."},nissan_seatbelt_chime_mute:{name:"\u0397\u03c7\u03b7\u03c4\u03b9\u03ba\u03ae \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03bf\u03bb\u03ae \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03b6\u03ce\u03bd\u03b7\u03c2 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03b1\u03c2 (Nissan)",desc:"\u03a3\u03af\u03b3\u03b1\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03b1\u03bd\u03cc\u03bc\u03b5\u03bd\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03b6\u03ce\u03bd\u03b7\u03c2 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03b1\u03c2 \u03b5\u03bd\u03ce \u03b4\u03b9\u03b1\u03c4\u03b7\u03c1\u03b5\u03af \u03c4\u03bf \u03b5\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bc\u03c0\u03bb\u03ad\u03b3\u03bc\u03b1\u03c4\u03bf\u03c2."},porsche_sport_chrono_launch:{name:"Sport Chrono Launch Control Profile Response (Porsche)",desc:"\u0392\u03b5\u03bb\u03c4\u03b9\u03c3\u03c4\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03bf \u03ba\u03b1\u03c4\u03ce\u03c6\u03bb\u03b9 \u03c3\u03c4\u03c1\u03bf\u03c6\u03ce\u03bd \u03b1\u03bd\u03ac \u03bb\u03b5\u03c0\u03c4\u03cc \u03ba\u03b1\u03b9 \u03c4\u03bf \u03b4\u03ac\u03b3\u03ba\u03c9\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bc\u03c0\u03bb\u03ad\u03ba\u03c4\u03b7 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 PDK."},porsche_pasm_default:{name:"\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 PASM Suspension Mode (Porsche)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03b1\u03ba\u03b1\u03bc\u03c8\u03af\u03b1 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03c4\u03b9\u03ba\u03ae\u03c2 \u03b1\u03bd\u03ac\u03c1\u03c4\u03b7\u03c3\u03b7\u03c2 PASM \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2."},porsche_exhaust_flap:{name:"\u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03cc \u03c0\u03c4\u03b5\u03c1\u03cd\u03b3\u03b9\u03bf \u03b5\u03be\u03ac\u03c4\u03bc\u03b9\u03c3\u03b7\u03c2 \u03bc\u03b5 \u03c3\u03c4\u03b1\u03b8\u03b5\u03c1\u03cc \u03ac\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 (Porsche)",desc:"\u0391\u03bd\u03b1\u03b3\u03ba\u03ac\u03b6\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03b5\u03bd\u03b5\u03c1\u03b3\u03ad\u03c2 \u03b2\u03b1\u03bb\u03b2\u03af\u03b4\u03b5\u03c2 \u03b5\u03be\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03bd\u03b1 \u03c0\u03b1\u03c1\u03b1\u03bc\u03ad\u03bd\u03bf\u03c5\u03bd 100% \u03b1\u03bd\u03bf\u03b9\u03c7\u03c4\u03ad\u03c2 \u03c3\u03b5 \u03cc\u03bb\u03b1 \u03c4\u03b1 \u03b5\u03cd\u03c1\u03b7 \u03c3\u03c4\u03c1\u03bf\u03c6\u03ce\u03bd."},audi_drive_select_memory:{name:"Audi Drive Select Mode Memory Retention (Audi)",desc:"\u0394\u03b9\u03b1\u03c4\u03b7\u03c1\u03b5\u03af \u03c4\u03bf \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf \u03b5\u03bd\u03b5\u03c1\u03b3\u03cc \u03c0\u03c1\u03bf\u03c6\u03af\u03bb Drive Select (\u0394\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03cc/\u0391\u03c4\u03bf\u03bc\u03b9\u03ba\u03cc) \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7."},audi_virtual_cockpit_themes:{name:"Audi Virtual Cockpit S/RS Sport Graphic Layout (Audi)",desc:"\u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ad\u03c2 \u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7\u03c2 \u03ba\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03bf\u03cd \u03c3\u03c4\u03c1\u03bf\u03c6\u03cc\u03bc\u03b5\u03c4\u03c1\u03bf\u03c5 S/RS \u03c3\u03c4\u03bf Virtual Cockpit."},vag_scandinavian_drl:{name:"\u03a3\u03ba\u03b1\u03bd\u03b4\u03b9\u03bd\u03b1\u03b2\u03b9\u03ba\u03ae \u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 DRL (VAG)",desc:"\u0394\u03b9\u03b1\u03c4\u03b7\u03c1\u03b5\u03af \u03c4\u03b1 \u03c0\u03af\u03c3\u03c9 \u03c0\u03af\u03c3\u03c9 \u03c6\u03ce\u03c4\u03b1 \u03c3\u03c5\u03bd\u03b5\u03c7\u03ce\u03c2 \u03b1\u03bd\u03b1\u03bc\u03bc\u03ad\u03bd\u03b1 \u03c0\u03b1\u03c1\u03ac\u03bb\u03bb\u03b7\u03bb\u03b1 \u03bc\u03b5 \u03c4\u03b1 \u03bc\u03c0\u03c1\u03bf\u03c3\u03c4\u03b9\u03bd\u03ac DRL."},vag_mirror_dip_reverse:{name:"\u0392\u03cd\u03b8\u03b9\u03c3\u03b7 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b7 \u03b5\u03c0\u03b9\u03b2\u03b1\u03c4\u03ce\u03bd \u03c3\u03c4\u03b7\u03bd \u03cc\u03c0\u03b9\u03c3\u03b8\u03b5\u03bd (VAG)",desc:"\u0391\u03bd\u03b5\u03b2\u03ac\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03c0\u03bb\u03b1\u03ca\u03bd\u03cc \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bd\u03bf\u03b4\u03b7\u03b3\u03bf\u03cd \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b1 \u03ba\u03ac\u03c4\u03c9 \u03cc\u03c4\u03b1\u03bd \u03bc\u03c0\u03b1\u03af\u03bd\u03b5\u03b9 \u03b7 \u03cc\u03c0\u03b9\u03c3\u03b8\u03b5\u03bd."},vag_dynamic_turn_signal:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ae\u03c2 / \u03b4\u03b9\u03b1\u03b4\u03bf\u03c7\u03b9\u03ba\u03ae\u03c2 \u03c6\u03bb\u03b1\u03c2 (VAG)",desc:"\u0395\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf \u03c3\u03b1\u03c1\u03c9\u03c4\u03b9\u03ba\u03cc \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03cc \u03bc\u03bf\u03c4\u03af\u03b2\u03bf \u03c6\u03bb\u03b1\u03c2 LED \u03c3\u03b5 \u03c3\u03c5\u03bc\u03b2\u03b1\u03c4\u03ad\u03c2 \u03bc\u03bf\u03bd\u03ac\u03b4\u03b5\u03c2 \u03c0\u03af\u03c3\u03c9 \u03c6\u03c9\u03c4\u03cc\u03c2."},vag_seatbelt_warning_duration:{name:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1\u03c2 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03b6\u03ce\u03bd\u03b7\u03c2 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03b1\u03c2 (VAG)",desc:"\u03a3\u03c5\u03bd\u03c4\u03bf\u03bc\u03b5\u03cd\u03b5\u03b9 \u03ae \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ad\u03bb\u03bb\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b5\u03c0\u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03b1\u03bd\u03cc\u03bc\u03b5\u03bd\u03bf \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03b9\u03b7\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7 \u03c4\u03b7\u03c2 \u03b6\u03ce\u03bd\u03b7\u03c2 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03b1\u03c2."},vag_sunroof_remote:{name:"\u0397\u03bb\u03b9\u03bf\u03c1\u03bf\u03c6\u03ae \u03c4\u03b7\u03bb\u03b5\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03ae\u03c1\u03b9\u03bf \u03ac\u03bd\u03b5\u03c3\u03b7\u03c2 (VAG)",desc:"\u0395\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf \u03ac\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03ba\u03bb\u03af\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c0\u03b1\u03bd\u03bf\u03c1\u03b1\u03bc\u03b9\u03ba\u03ae\u03c2 \u03b7\u03bb\u03b9\u03bf\u03c1\u03bf\u03c6\u03ae\u03c2 \u03bc\u03ad\u03c3\u03c9 \u03b1\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5 \u03c3\u03c5\u03b3\u03ba\u03c1\u03ac\u03c4\u03b7\u03c3\u03b7\u03c2 \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba."},vag_acc_distance_preset:{name:"ACC Adaptive Cruise \u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7 (VAG)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03c0\u03c1\u03bf\u03c6\u03af\u03bb \u03c1\u03b1\u03bd\u03c4\u03ac\u03c1 \u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2."},vag_infotainment_startup_logo:{name:"\u0393\u03c1\u03b1\u03c6\u03b9\u03ba\u03cc \u03bb\u03bf\u03b3\u03cc\u03c4\u03c5\u03c0\u03bf Infotainment Boot (VAG)",desc:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c4\u03bf \u03bb\u03bf\u03b3\u03cc\u03c4\u03c5\u03c0\u03bf \u03c4\u03b7\u03c2 \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03b8\u03cc\u03bd\u03b7\u03c2 \u03b5\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c8\u03c5\u03c7\u03b1\u03b3\u03c9\u03b3\u03af\u03b1\u03c2 (R-Line, GTI, RS)."},vag_ambient_color_cycle:{name:"\u039e\u03b5\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03bf\u03cd \u03c7\u03c1\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03bf\u03cd \u03c6\u03ac\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c6\u03c9\u03c4\u03cc\u03c2 \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 (VAG)",desc:"\u0395\u03c0\u03b5\u03ba\u03c4\u03b5\u03af\u03bd\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ad\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03b1\u03bb\u03ad\u03c4\u03b1\u03c2 \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 \u03c3\u03c4\u03bf \u03bc\u03b5\u03bd\u03bf\u03cd \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03c9\u03bd \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2."},vag_service_interval_custom:{name:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03bc\u03ad\u03bd\u03bf \u03cc\u03c1\u03b9\u03bf \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03b5\u03c0\u03b9\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 (VAG)",desc:"\u0394\u03b9\u03b1\u03bc\u03bf\u03c1\u03c6\u03ce\u03bd\u03b5\u03b9 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2 \u03c3\u03c4\u03cc\u03c7\u03bf\u03c5\u03c2 \u03c7\u03b9\u03bb\u03b9\u03bf\u03bc\u03ad\u03c4\u03c1\u03c9\u03bd \u03ba\u03b1\u03b9 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b5\u03c0\u03cc\u03bc\u03b5\u03bd\u03b7 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2."},vag_door_handle_lights_reverse:{name:"\u03a6\u03ce\u03c4\u03b1 \u03b5\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae\u03c2 \u03bb\u03b1\u03b2\u03ae\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 \u03b1\u03bd\u03b1\u03bc\u03bc\u03ad\u03bd\u03b1 \u03c3\u03c4\u03b7\u03bd \u03cc\u03c0\u03b9\u03c3\u03b8\u03b5\u03bd (VAG)",desc:"\u0391\u03bd\u03ac\u03b2\u03b5\u03b9 \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03bb\u03b1\u03ba\u03ba\u03bf\u03cd\u03b2\u03b1\u03c2 LED \u03c4\u03b7\u03c2 \u03bb\u03b1\u03b2\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03cc\u03c0\u03b9\u03c3\u03b8\u03b5\u03bd \u03b3\u03b9\u03b1 \u03bf\u03c1\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c3\u03c4\u03bf \u03ad\u03b4\u03b1\u03c6\u03bf\u03c2."},bmw_msport_exhaust_burble:{name:"M-Sport Exhaust Burble & Pop Intensity (BMW)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03b8\u03b5\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03ae\u03c7\u03bf\u03c5 \u03c5\u03c0\u03ad\u03c1\u03b2\u03b1\u03c3\u03b7\u03c2 \u03b4\u03b9\u03ac\u03c1\u03c1\u03b7\u03be\u03b7\u03c2 \u03c3\u03c4\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 Sport."},bmw_welcome_light_sequence:{name:"\u039a\u03b9\u03bd\u03bf\u03cd\u03bc\u03b5\u03bd\u03b1 \u03c3\u03c7\u03ad\u03b4\u03b9\u03b1 \u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03af\u03b1\u03c2 \u03c6\u03c9\u03c4\u03cc\u03c2 \u03ba\u03b1\u03bb\u03c9\u03c3\u03bf\u03c1\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 (BMW)",desc:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03b1 LED \u0