0107 tutaj.",vinPlaceholder:"Wpisz numer VIN...",startScan:"ROZPOCZNIJ SKANOWANIE EKSPERTOWE",scanning:"SKANOWANIE...",vehicleIdentity:"ID POJAZDU I PRZEBIEG",vin:"Numer podwozia",odometer:"Oryginalne KM",distSinceCleared:"B\u0142\u0105d usuni\u0119ty",milDist:"Kontrolka silnika w\u0142\u0105czona",dtcTitle:"Kody usterek",dtcClean:"BRAK KODU B\u0141\u0118DU - CZYSTY",extraActions:"DODATKOWE TRANSAKCJE",garageTitle:"ZAPISY GARA\u017bOWE I PRZESZ\u0141E",share:"UDOST\u0118PNIJ",saveVehicle:"ZAPISZ TO NARZ\u0118DZIE",noRecords:"Nie ma jeszcze zarejestrowanych pojazd\xf3w.",clean:"CZYSTY",faults:"NIEPOWODZENIE",vinRequired:"Wymagany numer VIN",vinRequiredDesc:"Aby dokona\u0107 rejestracji, numer podwozia musi pojawi\u0107 si\u0119 automatycznie lub zosta\u0107 wpisany r\u0119cznie.",missingInfo:"Brakuj\u0105ce informacje",missingInfoDesc:"Prosz\u0119 wype\u0142ni\u0107 pole Marka i Model.",saved:"Zapisano",savedDesc:"W wyniku ekspertyzy zosta\u0142 dostawiony do gara\u017cu.",connRequired:"Wymagane po\u0142\u0105czenie",connRequiredDesc:"Aby rozpocz\u0105\u0107 ten proces, najpierw po\u0142\u0105cz si\u0119 z pojazdem.",chronicFaultsTitle:"Statystyczne problemy przewlek\u0142e",chronicFaultsObs:"{{code}} (Observation: {{days}} Unique Days / Total: {{total}} Times)",chronicFaultsPending:"Zbieranie puli danych/analizowanie statystyk",notScanned:"Nie zeskanowano",notScannedDesc:"Naci\u015bnij przycisk skanowania w prawym g\xf3rnym rogu, aby odczyta\u0107 kody diagnostyczne.",scanFailed:"SKANOWANIE NIEUDANE",errTimeout:"Error: Connection Timeout\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error\nECU trouble codes could not be read.",scannedSystems:"SKANOWANE SYSTEMY",moduleEngine:"Jednostka steruj\u0105ca silnika",moduleAbs:"Uk\u0142ad przeciwblokuj\u0105cy",moduleTcm:"Modu\u0142 kontroli skrzyni bieg\xf3w",moduleBcm:"Modu\u0142 steruj\u0105cy nadwozia",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:"OSTRZE\u017bENIE BEZPIECZE\u0143STWA",safetyWarningDesc:"Podczas tego procesu: \u2022 Zap\u0142on musi by\u0107 W\u0141\u0104CZONY \u2022 Silnik musi by\u0107 WY\u0141\u0104CZONY \u2022 Nie uruchamiaj pojazdu Czy chcesz kontynuowa\u0107?",step1:"Krok 1: Usu\u0144 kody b\u0142\u0119d\xf3w",step1Desc:"Wszystkie zapisane kody usterek i kontrolka Sprawd\u017a silnik zostan\u0105 usuni\u0119te. Warto\u015bci korekty paliwa zostan\u0105 zresetowane. Tej akcji nie mo\u017cna cofn\u0105\u0107!",step2:"Krok 2: Twardy reset ECU",step2Desc:"Reset elektryczny zostanie wys\u0142any do komputera silnika. Dzia\u0142a to na zasadzie wyjmowania i instalowania baterii. Jest nieskuteczny w nieobs\u0142uguj\u0105cych ECU. To nie szkodzi.",clearCodes:"Usu\u0144 kody",ecuReset:"Wyczy\u015b\u0107 kody b\u0142\u0119d\xf3w",finish:"Pomi\u0144",completed:"Uko\u0144czono",completedDesc:"Operacje serwisowe zosta\u0142y zako\u0144czone pomy\u015blnie. Mo\u017cna ponownie uruchomi\u0107 pojazd.",hardResetDesc:"Wszystkie operacje serwisowe zosta\u0142y zako\u0144czone pomy\u015blnie. \u2022 Usuni\u0119to kody b\u0142\u0119d\xf3w \u2022 Zresetowano korekt\u0119 paliwa \u2022 Reset ECU Mo\u017cna ponownie uruchomi\u0107 pojazd."},info:{desc:"Profesjonalna aplikacja do diagnostyki motocykli i pojazd\xf3w. Kompatybilny ze wszystkimi pojazdami.",upgrade:"Uaktualnij do Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"Wczesny dost\u0119p",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner jest obecnie w fazie rozwoju. Poniewa\u017c jeste\u015b naszym wczesnym u\u017cytkownikiem, wszystkie funkcje profesjonalne s\u0105 ju\u017c dla Ciebie dost\u0119pne. Twoja opinia jest dla nas bardzo cenna!",helpGuide:"POMOC I PRZEWODNIK",language:"J\u0119zyk / J\u0119zyk / Bahasa",support:"CENTRUM WSPARCIA",supportSubject:"Wsparcie i opinie dotycz\u0105ce Cortex OBD2 Diagnostic Scanner",thanks:"Dzi\u0119kuj\u0119!",thanksDesc:"Dzi\u0119kujemy za Twoj\u0105 opini\u0119. Mo\u017cesz zostawi\u0107 nam komentarz w Sklepie Play.",sections:{live:{title:"CZUJNIKI MONITORUJ\u0104CE NA \u017bYWO",content:"Mo\u017cesz natychmiast monitorowa\u0107 obroty, pr\u0119dko\u015b\u0107, temperatur\u0119 silnika, po\u0142o\u017cenie przepustnicy, napi\u0119cie akumulatora, obci\u0105\u017cenie silnika, temperatur\u0119 powietrza dolotowego i ci\u015bnienie w kolektorze. Warto\u015bci s\u0105 od\u015bwie\u017cane 1-5 razy na sekund\u0119, w zale\u017cno\u015bci od szybko\u015bci Bluetooth. Za pomoc\u0105 terminala mo\u017cesz bezpo\u015brednio ingerowa\u0107 w pojazd za pomoc\u0105 polece\u0144 UDS/OBD."},expertise:{title:"BADANIE I GWARANCJA",content:"Aplikacja wykorzystuje kody ECU do wykrywania b\u0142\u0119d\xf3w. Rejestrowany jest numer VIN oraz aktualny przebieg zarejestrowany w poje\u017adzie. Dodatkowo b\u0142\u0119dy z przesz\u0142o\u015bci s\u0105 okre\u015blane poprzez obliczenie dystansu, jaki przejecha\u0142 pojazd, gdy \u015bwieci\u0142a si\u0119 kontrolka Check Engine. Wynikowy raport mo\u017cna udost\u0119pnia\u0107 w \u015brodowiskach PDF i Messaging."},tests:{title:"TESTY AKUMULATORA / WYDAJNO\u015aCI",content:"Testowanie akumulatora sk\u0142ada si\u0119 z 3 etap\xf3w: testy spoczynku, rozruchu i \u0142adowania w stanie spoczynku mierz\u0105 stan akumulatora/regulatora. Test wydajno\u015bci mierzy warto\u015bci przyspieszenia 0-60 i 0-100 km/h z marginesem b\u0142\u0119du 50 ms, wykorzystuj\u0105c chwilowe dane o pr\u0119dko\u015bci z procesora telefonu i pojazdu."},hardware:{title:"KOMPATYBILNO\u015a\u0106 SPRZ\u0118TU",content:"Zalecany jest modu\u0142 Bluetooth ELM327. Niekt\xf3re zaawansowane kody mog\u0105 nie dzia\u0142a\u0107 na sprz\u0119cie niskiej jako\u015bci z wersj\u0105 2.1 CLONE. Najszybsz\u0105 pr\u0119dko\u015b\u0107 uzyskasz dzi\u0119ki adapterom premium, takim jak vLinker i OBDLink."},warnings:{title:"WA\u017bNE OSTRZE\u017bENIA",content:"\u2022 Zap\u0142on musi by\u0107 w\u0142\u0105czony, a silnik wy\u0142\u0105czony podczas procesu usuwania kodu b\u0142\u0119du lub funkcji resetowania ECU. \u2022 Nie wysy\u0142aj resetu do dzia\u0142aj\u0105cego pojazdu. \u2022 Nie ka\u017cdy pojazd mo\u017ce obs\u0142ugiwa\u0107 wszystkie czujniki, w przypadku nieobs\u0142ugiwanych czujnik\xf3w wy\u015bwietli si\u0119 \u201e--\u201d."},onboarding:{title:"ZEZWOLENIA PRAWNE I ANONIMOWA TELEMETRIA",content:"W celu poprawy jako\u015bci aplikacji i kompatybilno\u015bci pojazd\xf3w; Ca\u0142kowicie anonimowe parametry silnika i kody usterek generowane podczas diagnostyki usterek mo\u017cna analizowa\u0107 na naszych bezpiecznych serwerach. Kontynuuj\u0105c, zgadzasz si\u0119 na warunki anonimowej telemetrii. Do komunikacji z ECU motocykla wymagane s\u0105 uprawnienia Bluetooth i lokalizacji."},featureCoding:{title:"ODBLOKOWANIE UKRYTYCH FUNKCJI I KODOWANIE UDS",content:"Obs\u0142ugiwany przez nasz silnik protoko\u0142u UDS ISO 14229, bezpiecznie prze\u0142\u0105czaj funkcje, takie jak ameryka\u0144skie \u015bwiat\u0142a postojowe, dzia\u0142anie ig\u0142y, blokada klaksonu, komfortowe szyby i ustawienia DRL w pojazdach VAG, BMW, Renault i Dacia."},multiEcu:{title:"SKANOWANIE WSZYSTKICH MODU\u0141\xd3W Z MULTI-ECU",content:"Zeskanuj i usu\u0144 kody usterek poza ECU silnika \u2014 w tym ABS, poduszk\u0119 powietrzn\u0105, automatyczn\u0105 skrzyni\u0119 bieg\xf3w, zestaw wska\u017anik\xf3w, klimatyzacj\u0119 i modu\u0142y steruj\u0105ce nadwozia."},advancedDiagnostics:{title:"ADAPTACJA DCT, DPF i WSKA\u0179NIK MOCY HP",content:"\u2022 Uczenie si\u0119 i resetowanie adaptacji punktu poca\u0142unku sprz\u0119g\u0142a DCT/DSG\n\u2022 Monitorowanie zawarto\u015bci sadzy w DPF i temperatury regeneracji spalin\n\u2022 Kr\xf3tko-/d\u0142ugoterminowe korekty paliwa w czasie rzeczywistym i analiza lambda\n\u2022 Dynamiczna moc i moment obrotowy Wykres telemetryczny na \u017cywo"},demoMode:{title:"TRYB DEMO",content:"Testuj i eksploruj aplikacj\u0119 bez fizycznego sprz\u0119tu OBD2. Poznaj pe\u0142ne funkcje diagnostyczne magistrali CAN i UDS dzi\u0119ki realistycznej symulacji telemetrii w czasie rzeczywistym."}},reconfigurePermissions:"Uprawnienia do ponownego wy\u015bwietlania i warunki prawne",shareWithFriend:"UDOST\u0118PNIJ ZNAJOMEMU",shareMessageText:"Odkryj kody b\u0142\u0119d\xf3w ECU i telemetri\u0119 czujnik\xf3w na \u017cywo za pomoc\u0105 Cortex OBD2 Diagnostic Scanner! Pobierz teraz: iOS: https://apps.apple.com/app/id6764052240 Android: https://play.google.com/store/apps/details?id=com.ismail.motocortexv2 Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:"\u2550\u2550\u2550 RAPORT DIAGNOSTYCZNY KORY MOTOKOROWEJ \u2550\u2550\u2550",vehicleIdentity:"ID POJAZDU",vin:"Numer podwozia",odometer:"Odleg\u0142o\u015b\u0107",milDist:"Kontrolka silnika w\u0142\u0105czona",distSinceCleared:"B\u0142\u0105d usuni\u0119ty",dtcCount:"FAULT CODES ({{count}})",sensorData:"DANE Z CZUJNIKA NA \u017bYWO",noData:"Nie uda\u0142o si\u0119 odczyta\u0107 danych",proApp:"Skanowane za pomoc\u0105 Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"data",vinNotFound:"Nie wykryto",noDtcs:"BRAK KODU B\u0141\u0118DU - CZYSTY",speed:"pr\u0119dko\u015b\u0107",coolant:"Temperatura silnika",throttle:"gaz",engineLoad:"Obci\u0105\u017cenie silnika",intakeAir:"Powietrze wlotowe",manifold:"Kolektor",voltage:"Napi\u0119cie akumulatora",shareMessage:"\u015aled\u017a stan swojego motocykla z kieszeni dzi\u0119ki aplikacji diagnostycznej Motocortex OBD2! Pobierz: https://cortexobd2.app",subtitle:"Kompleksowa diagnostyka u\u017cywana i kontrola telemetryczna",vehicleInfo:"Identyfikacja pojazdu i metadane ECU",healthScore:"Og\xf3lny wynik stanu zdrowia ECU",dtcSection:"Diagnostyczne kody usterek",telemetrySection:"Telemetria na \u017cywo i migawka czujnika",maintenanceSection:"Historia serwisu i konserwacji Ak\u0131ll\u0131 Garaj",aiSection:"Analiza og\xf3lnego stanu AI Doctor",noFaults:"Brak aktywnych lub historycznych kod\xf3w b\u0142\u0119d\xf3w zapisanych w pami\u0119ci ECU.",noMaintenance:"Brak zarejestrowanych wpis\xf3w do us\u0142ug w Ak\u0131ll\u0131 Garaj.",disclaimer:"Zastrze\u017cenie: Ten raport jest generowany przez oprogramowanie diagnostyczne MotoCortex. Przed zakupem pojazdu zaleca si\u0119 kontrol\u0119 fizyczn\u0105 przeprowadzon\u0105 przez certyfikowanego technika.",shareTitle:"Udost\u0119pnij raport z oceny MotoCortex"},battery:{title:"TEST AKUMULATORA I ROZRUCHU",ready:"Gotowy do rozpocz\u0119cia test\xf3w.",restingStatus:"Zap\u0142on w\u0142\u0105czony, silnik wy\u0142\u0105czony... Trwa odczytywanie napi\u0119cia akumulatora...",crankingStatus:"ROZPOCZNIJ TERAZ!",chargingStatus:"Silnik pracuje na biegu ja\u0142owym... Trwa odczytywanie napi\u0119cia \u0142adowania...",doneStatus:"Testowanie zako\u0144czone!",voltageError:"Nie uda\u0142o si\u0119 odczyta\u0107 napi\u0119cia. Sprawd\u017a po\u0142\u0105czenie.",start:"ROZPOCZNIJ TEST",retry:"POWT\xd3RZ TEST",procedure:"PROCEDURA TESTOWA",steps:{1:"1. Zap\u0142on w\u0142\u0105czony, silnik wy\u0142\u0105czony \u2192 Mierzone jest napi\u0119cie spoczynkowe",2:"2. Gdy pojawi si\u0119 komunikat \u201eSTART TERAZ\u201d, uruchom silnik.",3:"3. Najni\u017csze napi\u0119cie zarejestrowane przez 5 sekund",4:"4. Napi\u0119cie \u0142adowania/regulatora mierzone jest podczas pracy silnika"},warning:"Nie roz\u0142\u0105czaj po\u0142\u0105czenia Bluetooth podczas testowania.",resting:"ODPOCZYNEK",cranking:"HYMN",charging:"\u0141ADOWANIE",instantV:"NATYCHMIASTOWE NAPI\u0118CIE",evaluation:"OCENA",verdicts:{full:"Bateria: w pe\u0142ni na\u0142adowana",good:"Bateria: Stan dobry",weak:"Bateria: Os\u0142abienie",empty:"Bateria: s\u0142aba/martwa",crankNormal:"Pocz\u0105tek: Normalny spadek",crankLow:"Rozrusznik: Niskie napi\u0119cie",crankCritical:"Hymn: Krytyczny spadek",regNormal:"\u0141adowanie: Normalny regulator",regLow:"\u0141adowanie: Niskie \u0142adowanie",regHigh:"\u0141adowanie: Prze\u0142adowanie",regFail:"\u0141adowanie: regulator jest uszkodzony"},verdictLocked:"Uaktualnij do wersji PRO, aby wy\u015bwietli\u0107 szczeg\xf3\u0142owy raport oceny akumulatora i wykres analizy rozruchu."},freeze:{title:"ZAMRA\u017b RAMK\u0118",snapshot:"PAMI\u0118\u0106 AWARII",desc:"Odczytuje parametry silnika po za\u015bwieceniu si\u0119 kontrolki Check Engine. Dane te dostarczaj\u0105 kluczowych informacji w diagnostyce usterek.",noDtcs:"Nie zapisano \u017cadnego kodu b\u0142\u0119du. By\u0107 mo\u017ce nie ma danych typu Freeze Frame.",read:"CZYTAJ ZAMRO\u017bONE DANE",loading:"Tryb 02 jest kwestionowany...",noData:"Nie znaleziono zamro\u017conych danych. Pojazd mo\u017ce nie obs\u0142ugiwa\u0107 tej funkcji.",error:"B\u0142\u0105d odczytu danych",values:"WARTO\u015aCI ZAPISANE W CZASIE AWARII",retry:"PRZECZYTAJ PONOWNIE",techInfo:"INFORMACJE TECHNICZNE",techDesc:"\u2022 Tryb OBD-II 02: Zamro\u017cenie danych \u2022 PID 020C00: B\u0142\u0105d obrot\xf3w \u2022 PID 020D00: B\u0142\u0105d pr\u0119dko\u015bci \u2022 PID 020500: Temperatura wody ch\u0142odz\u0105cej w momencie wyst\u0105pienia b\u0142\u0119du Dane te nale\u017c\u0105 do ostatniego kodu b\u0142\u0119du. Po usuni\u0119ciu kod\xf3w b\u0142\u0119d\xf3w usuwane s\u0105 r\xf3wnie\u017c dane zamro\u017cone.",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"TEST WYDAJNO\u015aCI",seconds:"SEKUND",speed:"KM/H",idle:"Naci\u015bnij przycisk i przygotuj si\u0119 do dzia\u0142ania.",ready:"GOTOWY! Zacznij kierowa\u0107 pojazdem...",readyDesc:"Licznik uruchamia si\u0119, gdy pr\u0119dko\u015b\u0107 > 0.",measuring:"POMIAR JEST DOKONYWANY...",done:"TESTOWANIE ZAKO\u0143CZONE",start:"ROZPOCZNIJ TEST",stop:"ZATRZYMAJ si\u0119",reset:"ZRESETUJ",howItWorks:"JAK TO DZIA\u0141A?",howDesc:"1. Naci\u015bnij przycisk \u201eRozpocznij test\u201d. 2. Pojazd musi sta\u0107 w miejscu 3. Chrono rozpoczyna si\u0119, gdy zaczynasz si\u0119 porusza\u0107 4. Rejestruje si\u0119 czasy przejazdu z pr\u0119dko\u015bci\u0105 60 km/h i 100 km/h Rozwi\u0105\u017c ten test w bezpiecznym miejscu!",sec:"sek"},dtc:{P0102:"Czujnik przep\u0142ywu powietrza \u2013 niski sygna\u0142 wej\u015bciowy",P0113:"Czujnik temperatury powietrza dolotowego \u2013 wysokie napi\u0119cie",P0171:"Niski poziom paliwa w uk\u0142adzie",P0300:"Losowy/wielokrotny b\u0142\u0105d zap\u0142onu cylindra",P0420:"Uk\u0142ad katalizatora \u2014 niska wydajno\u015b\u0107",P0700:"Uk\u0142ad sterowania skrzyni\u0105 bieg\xf3w \u2013 usterka",P0715:"Czujnik pr\u0119dko\u015bci turbiny \u2013 awaria obwodu",P0560:"Napi\u0119cie systemu \u2014 awaria",P0562:"Napi\u0119cie systemu \u2014 niskie",U0100:"Utrata komunikacji z modu\u0142em steruj\u0105cym silnika",U0121:"Utrata komunikacji z modu\u0142em uk\u0142adu przeciwblokuj\u0105cego.",C0035:"Awaria obwodu czujnika pr\u0119dko\u015bci lewego przedniego ko\u0142a",B0001:"Obw\xf3d steruj\u0105cy wyzwalaniem przedniego stopnia kierowcy 1",P0750:"Elektrozaw\xf3r zmiany bieg\xf3w Awaria",P0814:"Awaria obwodu wy\u015bwietlacza zasi\u0119gu skrzyni bieg\xf3w",U0140:"Utrata komunikacji z modu\u0142em steruj\u0105cym nadwozia",C0040:"Awaria obwodu czujnika pr\u0119dko\u015bci prawego przedniego ko\u0142a",C0110:"Awaria obwodu silnika pompy ABS",C0121:"Awaria obwodu czujnika ci\u015bnienia hamulc\xf3w",B0010:"Kontrola rozmieszczenia z przodu pasa\u017cera, stopie\u0144 1",B0020:"Kontrola wyzwolenia lewej poduszki powietrznej",B1000:"Usterka sprz\u0119towa modu\u0142u steruj\u0105cego nadwozia.",B1325:"Niskie napi\u0119cie w obwodzie zasilania urz\u0105dzenia",generalFault:"General Fault"},vehicleSelect:{title:"WYBIERZ SWOJ POJAZD, ABY ZWI\u0118KSZY\u0106 DOK\u0141ADNO\u015a\u0106 DIAGNOSTYKI",subtitle:"Podaj dane pojazdu, aby uzyska\u0107 dok\u0142adn\u0105 diagnostyk\u0119 i dopasowanie protoko\u0142u.",brand:"MARKA",selectBrand:"Wybierz mark\u0119...",searchBrand:"Wyszukiwanie marki...",customBrandPlaceholder:"Np.: Triumph, CFMoto, Kia...",model:"MODEL",selectModel:"Wybierz model...",searchModel:"Szukaj modelu...",customModelPlaceholder:"Np.: CBR600, Golf, Focus...",year:"ROK MODELU",selectYear:"Wybierz rok...",customYearPlaceholder:"Np.: 2018",disconnect:"OD\u0141\u0104CZ",confirm:"KONTYNUUJ",errorBrand:"Wybierz lub wprowad\u017a mark\u0119.",errorModel:"Prosz\u0119 wybra\u0107 lub wprowadzi\u0107 model.",errorYear:"Prosz\u0119 wybra\u0107 lub wprowadzi\u0107 prawid\u0142owy rok.",noResults:"Nie znaleziono \u017cadnych wynik\xf3w",selectVehiclePrompt:"PROSZ\u0118 NAJPIERW WYBRA\u0106 POJAZD",selectedVehicle:"WYBRANY POJAZD",changeVehicle:"ZMIE\u0143",newVehicle:"Dodaj nowy pojazd",titleMenu:"Pojazd & Po\u0142\u0105czenie",registeredVehiclesLabel:"ZAREJESTROWANE POJAZDY",viewRegisteredList:"Zobacz zarejestrowane pojazdy",registeredVehicles:"MOJE ZAREJESTROWANE POJAZDY",deleteConfirm:"Czy na pewno chcesz usun\u0105\u0107 ten pojazd z zarejestrowanych pojazd\xf3w?",noRegisteredVehicles:"Nie znaleziono zarejestrowanych pojazd\xf3w.",selectVehicle:"WYBIERZ",mismatchTitle:"Niezgodno\u015b\u0107 Pojazdu",mismatchDesc:"Producent po\u0142\u0105czonego pojazdu zosta\u0142 wykryty jako \"{{make}}\" na podstawie VIN. Jednak wybrany pojazd to \"{{selected}}\". Czy chcesz anulowa\u0107 bie\u017c\u0105cy wyb\xf3r i zdefiniowa\u0107 go na nowo z prawid\u0142ow\u0105 mark\u0105?",operations:{clearDtc:"Kody b\u0142\u0119d\xf3w skasowane",fuelAdaptation:"Reset adaptacji paliwa",ecuReset:"Reset ECU"},searchLanguage:"Wyszukaj j\u0119zyk...",connectionSection:"Pod\u0142\u0105czenie urz\u0105dzenia OBD",noVehicleTitle:"WYMAGANE WYKRYCIE POJAZDU",noVehicleDesc:"To\u017csamo\u015b\u0107 pojazdu zostanie automatycznie wykryta poprzez po\u0142\u0105czenie OBD-II. Poni\u017cej sparuj i po\u0142\u0105cz si\u0119 z urz\u0105dzeniem.",registeredVehiclesButton:"MOJE ZAREJESTROWANE POJAZDY",connectDevice:"PO\u0141\u0104CZ Z URZ\u0104DZENIEM OBD2"},brands:{alfa_romeo:"Alfy Romeo",aston_martin:"Astona Martina",audi:"Audi",bajaj:"bajaj",bmw_car:"BMW",bmw_moto:"BMW",chery:"Wi\u015bnia",cupra:"Cupra",dacia:"Dacia",fiat:"Fiata",ford:"ford",hero:"bohater",honda_car:"Honda",honda_moto:"Honda",hyundai:"hyundai",indian:"Hindus",jeep:"jeep",kia:"Kia",ktm:"KTM-a",kuba:"Kuba",kymco:"Kymco",land_rover:"land rover",lexus:"Lexusa",mazda:"Mazdy",mg:"mg",mondial:"mondia\u0142",mv_agusta:"MV Augusta",nissan:"Nissana",opel:"opel",peugeot:"Peugeota",peugeot_car:"Peugeot",peugeot_moto:"Peugeot",porsche:"porsche",rks:"RKS",seat:"Siedzisko",skoda:"Skoda",suzuki_car:"Suzuki",suzuki_moto:"Suzuki",sym:"sym",tesla:"Tesli",togg:"togg",toyota:"Toyoty",triumph:"Triumf",tvs:"TVS",vespa:"Vespa",volkswagen:"Volkswagena",volvo:"Volvo",yuki:"Yuki",other:"Inne",aprilia:"Aprilia",benelli:"Benelli",cfmoto:"CFMoto",chevrolet:"Chevrolet",citroen:"Citro\xebn",ducati:"Ducati",harley:"Harley-Davidson",husqvarna:"Husqvarna",kawasaki:"Kawasaki",mercedes:"Mercedes-Benz",mitsubishi:"Mitsubishi",renault:"Renault",subaru:"Subaru",bmw:"BMW/MINI",gm:"GM/Chevrolet/GMC",dodge:"Dodge/RAM/Jeep",byd:"BYD EV",stellantis:"Stellantis/Fiat"},permissions:{headerSubtitle:"PANEL ZEZWOLE\u0143",cardTitle:"Wymagany dost\u0119p do sprz\u0119tu",cardDesc:"W celu poprawy jako\u015bci aplikacji i kompatybilno\u015bci z pojazdami, w pe\u0142ni zanonimizowane parametry silnika i kody usterek zarejestrowane podczas diagnostyki mog\u0105 by\u0107 analizowane na naszych bezpiecznych serwerach. Kontynuuj\u0105c, akceptujesz niniejsze warunki anonimowej telemetrii.",btSub:"S\u0142u\u017cy wy\u0142\u0105cznie do parowania z adapterem ELM327/OBD2 i strumieniowego przesy\u0142ania danych na \u017cywo z magistrali CAN/K-Line.",locLabel:"Pozwolenie na lokalizacj\u0119",locSub:"Znalezienie w pobli\u017cu energooszcz\u0119dnych urz\u0105dze\u0144 Bluetooth jest obowi\u0105zkowe ze wzgl\u0119du na architektur\u0119 systemu Android. Nie \u015bledzimy Twojej jazdy.",grantBtn:"ZEZWALAJ I KONTYNUUJ",skipBtn:"Na razie pomi\u0144",deniedDesc:"Odm\xf3wiono cz\u0119\u015bci pozwole\u0144. Cortex OBD2 Diagnostic Scanner mo\u017ce nie skanowa\u0107 lub nie \u0142\u0105czy\u0107 si\u0119 pomy\u015blnie z urz\u0105dzeniami OBD2.",proceedAnyway:"Kontynuuj mimo wszystko",openSettings:"Otw\xf3rz Ustawienia",btLabel:"Bluetooth",langTitle:"Wybierz j\u0119zyk",nextBtn:"KONTYNUUJ",langDesc:"Wybierz preferowany j\u0119zyk, aby dostosowa\u0107 swoje do\u015bwiadczenie diagnostyczne.",langSelectSub:"BRAMKA J\u0118ZYKOWA",telemetryLabel:"Telemetria diagnostyczna",telemetrySub:"Udost\u0119pniaj anonimowe protoko\u0142y i dzienniki b\u0142\u0119d\xf3w, aby poprawi\u0107 kompatybilno\u015b\u0107 pojazd\xf3w.",restartOnboarding:"Uruchom ponownie wst\u0119pn\u0105 konfiguracj\u0119"},disclaimer:{subtitle:"Read carefully before writing configuration to vehicle ECU.",p1:"ECU coding and parameter writing directly modifies your vehicle's Electronic Control Unit configuration memory. MotoCortex executes multi-stage journal backups, but failure to comply with safety rules can risk module lockouts.",check1:"I confirm that the vehicle battery is stable (>= 12.4V) and ignition is ON.",check2:"I understand that incorrect coding may require a factory reset and accept all liability.",proceed:"WRITE PARAMETERS"},hiddenFeatures:{title:"UKRYTE FUNKCJE",btnLabel:"ODBLOKUJ UKRYTE FUNKCJE",unsupported:"Ten adapter OBD2 nie obs\u0142uguje odblokowywania ukrytych funkcji.",unsupportedDesc:"Wymagany oryginalny ELM327 v2.1 lub wy\u017cszy. Klony nie s\u0105 obs\u0142ugiwane.",notConnected:"Najpierw po\u0142\u0105cz si\u0119 z pojazdem.",notConnectedDesc:"Urz\u0105dzenie OBD2 musi by\u0107 pod\u0142\u0105czone.",warning:"Te zmiany mog\u0105 wp\u0142yn\u0105\u0107 na gwarancj\u0119 pojazdu.",confirmTitle:"Wymagane potwierdzenie",confirmMsg:"Zmiana tej funkcji wp\u0142ywa na ustawienia ECU. Kontynuowa\u0107?",confirmOk:"Kontynuuj",confirmCancel:"Anuluj",categoryLighting:"O\u015aWIETLENIE",categorySound:"D\u0179WI\u0118K I OSTRZE\u017bENIA",categoryDisplay:"PANEL INSTRUMENT\xd3W",categoryDriving:"JAZDA",featureDrl:"\u015awiat\u0142a do jazdy dziennej",featureRearFog:"Override tylnej lampy przeciwmgielnej",featureDoorChime:"Wy\u0142\u0105cz sygna\u0142 drzwi",featureParkingAlert:"D\u017awi\u0119kowy alarm hamulca postojowego",featureRpmWarning:"Ostrze\u017cenie o limicie obrot\xf3w",featureFuelSensitivity:"Czu\u0142o\u015b\u0107 wska\u017anika paliwa",featureStartStop:"Start-Stop domy\u015blnie wy\u0142\u0105czony",featureSportMemory:"Pami\u0119\u0107 trybu sport",enabled:"W\u0141\u0104CZONE",disabled:"WY\u0141\u0104CZONE",writeSuccess:"Funkcja zaktualizowana pomy\u015blnie.",writeError:"B\u0142\u0105d zapisu. Spr\xf3buj ponownie.",simulationBanner:"TRYB SYMULACJI \u2014 Rzeczywisty zapis ECU jeszcze nieaktywny",closeBtn:"ZAMKNIJ",unsupportedOk:"OK",disclaimerTitle:"WY\u0141\u0104CZENIE ODPOWIEDZIALNO\u015aCI",disclaimerFeature:"Funkcja",disclaimerBody:"Zmiana tej funkcji ma bezpo\u015bredni wp\u0142yw na ustawienia fabryczne pojazdu i oprogramowanie ECU. Przeczytaj uwa\u017cnie nast\u0119puj\u0105ce zagro\u017cenia: \u2022 Nieprawid\u0142owe zastosowanie mo\u017ce spowodowa\u0107 utrat\u0119 gwarancji na pojazd.\n\u2022 Niekt\xf3re zmiany mog\u0105 powodowa\u0107 trwa\u0142e usterki lub nieoczekiwane b\u0142\u0119dy elektryczne.\n\u2022 Chocia\u017c operacja mo\u017ce by\u0107 odwracalna, niekt\xf3re modu\u0142y ECU mog\u0105 wymaga\u0107 przywr\xf3cenia ustawie\u0144 fabrycznych.\n\u2022 U\u017cytkownik ponosi wy\u0142\u0105czn\u0105 odpowiedzialno\u015b\u0107 za wszelkie szkody materialne i niematerialne powsta\u0142e w wyniku korzystania z tej funkcji.\n\u2022 Skaner diagnostyczny Cortex OBD2 nie ponosi odpowiedzialno\u015bci za jakiekolwiek nieprawid\u0142owe dzia\u0142anie lub szkody spowodowane tymi zmianami. Musisz potwierdzi\u0107, \u017ce przeczyta\u0142e\u015b i zrozumia\u0142e\u015b to ostrze\u017cenie.",checkboxTitle:"WYMAGANE POTWIERDZENIE",check1:"Przeczyta\u0142em to ostrze\u017cenie i rozumiem, \u017ce mo\u017ce to mie\u0107 wp\u0142yw na gwarancj\u0119 na m\xf3j pojazd.",check2:"Przyjmuj\u0119 do wiadomo\u015bci, \u017ce skaner diagnostyczny Cortex OBD2 nie ponosi odpowiedzialno\u015bci za jakiekolwiek usterki lub szkody powsta\u0142e w wyniku tej operacji.",check3:"Chc\u0119 dokona\u0107 tej zmiany \u015bwiadomie i z w\u0142asnej woli, akceptuj\u0105c wszelkie ryzyko.",disclaimerCancel:"ANULUJ",disclaimerContinue:"KONTYNUUJ",unsupportedTitle:"Nieobs\u0142ugiwane",unsupportedMsg:"Pod\u0142\u0105czone urz\u0105dzenie OBD2 nie obs\u0142uguje jeszcze tej funkcji. Do zapisu ukrytych funkcji wymagany jest kompatybilny adapter ELM327 v2.1+. Adaptery klonowane lub standardowe nie mog\u0105 przetwarza\u0107 tych polece\u0144."},disconnectShort:"ROZ\u0141.",obdTerminal:{title:"ZDROWIE I TERMINAL OBD",terminalTitle:"TERMINAL OBD",terminalPlaceholder:"Wpisz polecenie poni\u017cej, aby wys\u0142a\u0107 je do ECU",inputPlaceholder:"Wpisz polecenie...",sendButton:"WY\u015aLIJ",statsTitle:"STATYSTYKI ZDROWIA OBD",connectionProtocol:"Protok\xf3\u0142 po\u0142\u0105czenia:",none:"\u017badne",hardwareQualityScore:"Wynik Jako\u015bci sprz\u0119tu:",original:"Orygina\u0142",clone:"Klon",requestResponseCount:"Liczba \u017c\u0105da\u0144/odpowiedzi:",timeoutCount:"Liczba przekrocze\u0144 limitu czasu:",recoveryCount:"Liczba odzyskiwania:",diagnosticLogTitle:"DZIENNIK DIAGNOSTYCZNY",clearButton:"JASNE",shareButton:"UDOST\u0118PNIJ",noLogs:"Nie znaleziono dziennik\xf3w diagnostycznych.",noShareSupport:"Funkcje udost\u0119pniania nie s\u0105 dost\u0119pne na tym urz\u0105dzeniu."},dtcContext:{powertrain:"Ta usterka mo\u017ce mie\u0107 wp\u0142yw na zu\u017cycie paliwa i osi\u0105gi silnika. Odblokuj pe\u0142n\u0105 diagnostyk\u0119",cooling:"Wykryto krytyczne zagro\u017cenie och\u0142odzeniem. Zobacz szczeg\xf3\u0142owe kroki naprawy",ignition:"Wykryto problem z uk\u0142adem zap\u0142onu. Zobacz szczeg\xf3\u0142owe kroki naprawy",chassis:"Alarm systemu bezpiecze\u0144stwa podwozia. Odblokuj PRO, aby uzyska\u0107 pe\u0142n\u0105 analiz\u0119",body:"Znaleziono usterk\u0119 elektroniki nadwozia. Uaktualnij, aby uzyska\u0107 pe\u0142n\u0105 diagnostyk\u0119",network:"B\u0142\u0105d sieci komunikacyjnej. PRO odblokowuje pe\u0142ne rozwi\u0105zywanie problem\xf3w",fallback:"Odblokuj szczeg\xf3\u0142ow\u0105 analiz\u0119 usterek, koszty napraw i ocen\u0119 ryzyka"},perfTeaser:{limitTitle:"Osi\u0105gni\u0119to dzienny limit",limitDesc:"Osi\u0105gn\u0105\u0142e\u015b dzienny limit 3 bezp\u0142atnych test\xf3w 0-60 km/h. Przejd\u017a na wersj\u0119 PRO, aby uzyska\u0107 nieograniczone testy i pomiary pr\u0119dko\u015bci 0\u2013100 km/h."},sandbox:{title:"Kontrola telemetrii piaskownicy",connectionStatus:"Stan po\u0142\u0105czenia:",ecuStatus:"Stan ECU:",fps:"Wydajno\u015b\u0107 interfejsu u\u017cytkownika: {{fps}} FPS",stressBtnStart:"Rozpocznij napr\u0119\u017cenie 20 Hz",stressBtnStop:"Zatrzymaj p\u0119tl\u0119 telemetryczn\u0105",stopDisconnect:"Zatrzymaj / Roz\u0142\u0105cz",discoveredDevices:"ODKRYTE URZ\u0104DZENIA",connect:"PO\u0141\u0104CZ",scanning:"Skanowanie...",scan:"Skanuj urz\u0105dzenia",rpm:"Obroty silnika",speed:"Pr\u0119dko\u015b\u0107 pojazdu",coolant:"Temperatura p\u0142ynu ch\u0142odz\u0105cego",throttle:"Pozycja przepustnicy",notConnected:"Brak po\u0142\u0105czenia",connected:"Po\u0142\u0105czono",connecting:"\u0141\u0105czenie...",error:"B\u0142\u0105d",openSandbox:"WYKRES",advancedTerminal:"Zaawansowany terminal po\u0142\u0105czeniowy",terminalTitle:"Monitor terminala i autobusu na \u017cywo",pause:"PAUZA",resume:"WZN\xd3W",share:"UDOST\u0118PNIJ",clear:"JASNE",clearDtcs:"WYCZY\u015a\u0106 kod DTC",dtcTitle:"DIAGNOSTYKA DTC I KODY USTEREK",noDtcs:"W ECU nie znaleziono \u017cadnych kod\xf3w DTC",readDtcs:"PRZECZYTAJ kod DTC",sendDtcs:"WY\u015aLIJ"},health:{titleMenu:"ZDROWIE I MO\u017bLIWO\u015aCI OBD2",adapterQuality:"JAKO\u015a\u0106 I WYDAJNO\u015a\u0106 ADAPTERA",excellent:"DOSKONA\u0141Y",good:"DOBRY",clone:"