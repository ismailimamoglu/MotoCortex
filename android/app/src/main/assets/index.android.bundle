062a\u0648\u062c\u062f \u0631\u0645\u0648\u0632 \u062e\u0637\u0623 - \u0646\u0638\u064a\u0641\u0629",extraActions:"\u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629",garageTitle:"\u0627\u0644\u0645\u0631\u0622\u0628 \u0648\u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u0645\u0627\u0636\u064a\u0629",share:"\u0634\u0627\u0631\u0643",saveVehicle:"\u0627\u062d\u0641\u0638 \u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629",noRecords:"\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0631\u0643\u0628\u0627\u062a \u0645\u0633\u062c\u0644\u0629 \u062d\u062a\u0649 \u0627\u0644\u0622\u0646.",clean:"\u0646\u0638\u064a\u0641\u0629",faults:"\u0627\u0644\u0641\u0634\u0644",vinRequired:"\u0631\u0642\u0645 VIN \u0645\u0637\u0644\u0648\u0628",vinRequiredDesc:"\u0645\u0646 \u0623\u062c\u0644 \u0627\u0644\u062a\u0633\u062c\u064a\u0644\u060c \u064a\u062c\u0628 \u0623\u0646 \u064a\u0638\u0647\u0631 \u0631\u0642\u0645 \u0627\u0644\u0647\u064a\u0643\u0644 (VIN) \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0623\u0648 \u064a\u062a\u0645 \u0643\u062a\u0627\u0628\u062a\u0647 \u064a\u062f\u0648\u064a\u064b\u0627.",missingInfo:"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0641\u0642\u0648\u062f\u0629",missingInfoDesc:"\u064a\u0631\u062c\u0649 \u0645\u0644\u0621 \u062d\u0642\u0644 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u0637\u0631\u0627\u0632.",saved:"\u062a\u0645 \u0627\u0644\u062d\u0641\u0638 ",savedDesc:"\u062a\u0645\u062a \u0625\u0636\u0627\u0641\u062a\u0647 \u0625\u0644\u0649 \u0627\u0644\u0645\u0631\u0622\u0628 \u0646\u062a\u064a\u062c\u0629 \u0644\u0644\u062e\u0628\u0631\u0629.",connRequired:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0645\u0637\u0644\u0648\u0628",connRequiredDesc:"\u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0623\u0648\u0644\u0627\u064b \u0644\u0628\u062f\u0621 \u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629.",chronicFaultsTitle:"\u0627\u0644\u0645\u0634\u0627\u0643\u0644 \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0629 \u0627\u0644\u0645\u0632\u0645\u0646\u0629",chronicFaultsObs:"{{code}}(\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0629:{{days}}\u064a\u0648\u0645 \u0645\u062e\u062a\u0644\u0641 / \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a:{{total}}\u0645\u0631\u0627\u062a)",chronicFaultsPending:"\u062c\u0645\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a / \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a",notScanned:"\u0644\u0645 \u064a\u062a\u0645 \u0645\u0633\u062d\u0647\u0627 \u0636\u0648\u0626\u064a\u064b\u0627",notScannedDesc:"\u064a\u0631\u062c\u0649 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0645\u0633\u062d \u0641\u064a \u0623\u0639\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646 \u0644\u0642\u0631\u0627\u0621\u0629 \u0631\u0645\u0648\u0632 \u0627\u0644\u062a\u0634\u062e\u064a\u0635.",scanFailed:"\u0641\u0634\u0644 \u0627\u0644\u0645\u0633\u062d",errTimeout:"Error: Connection Timeout (TIMEOUT)\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost (CONNECTION_LOST)\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\n(HARDWARE_FATAL_RECOVERY_FAILED)\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error (ERROR_UNABLE_TO_READ)\nECU trouble codes could not be read.",scannedSystems:"\u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0645\u0645\u0633\u0648\u062d\u0629 \u0636\u0648\u0626\u064a\u0627",moduleEngine:"\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0643 (ECU)",moduleAbs:"\u0646\u0638\u0627\u0645 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0645\u0627\u0646\u0639\u0629 \u0644\u0644\u0627\u0646\u063a\u0644\u0627\u0642 (ABS)",moduleTcm:"\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 (TCM)",moduleBcm:"\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062c\u0633\u0645 (BCM)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" \u062a\u062d\u0630\u064a\u0631 \u0623\u0645\u0646\u064a",safetyWarningDesc:"\u062e\u0644\u0627\u0644 \u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629: \u2022 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u2022 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u062d\u0631\u0643 \u0641\u064a \u0648\u0636\u0639 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u2022 \u0644\u0627 \u062a\u0642\u0645 \u0628\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u061f",step1:"\u0627\u0644\u062e\u0637\u0648\u0629 1: \u0645\u0633\u062d \u0631\u0645\u0648\u0632 \u0627\u0644\u062e\u0637\u0623",step1Desc:"\u0633\u064a\u062a\u0645 \u0645\u0633\u062d \u062c\u0645\u064a\u0639 \u0631\u0645\u0648\u0632 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u0645\u062e\u0632\u0646\u0629 (DTC) \u0648\u0636\u0648\u0621 \u0641\u062d\u0635 \u0627\u0644\u0645\u062d\u0631\u0643. \u0633\u064a\u062a\u0645 \u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0642\u064a\u0645 \u0642\u0637\u0639 \u0627\u0644\u0648\u0642\u0648\u062f. \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621!",step2:"\u0627\u0644\u062e\u0637\u0648\u0629 2: \u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629",step2Desc:"\u0633\u064a\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0636\u0628\u0637 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a (\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0636\u0628\u0637 \u0627\u0644\u062b\u0627\u0628\u062a) \u0625\u0644\u0649 \u0643\u0645\u0628\u064a\u0648\u062a\u0631 \u0627\u0644\u0645\u062d\u0631\u0643. \u0625\u0646\u0647 \u064a\u0639\u0645\u0644 \u0645\u062b\u0644 \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0648\u062a\u0631\u0643\u064a\u0628\u0647\u0627. \u0625\u0646\u0647 \u063a\u064a\u0631 \u0641\u0639\u0627\u0644 \u0641\u064a \u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u063a\u064a\u0631 \u0627\u0644\u062f\u0627\u0639\u0645\u0629. \u0644\u0627 \u0636\u0631\u0631.",clearCodes:"\u062d\u0630\u0641 \u0627\u0644\u0631\u0645\u0648\u0632",ecuReset:"\u0645\u0633\u062d \u0631\u0645\u0648\u0632 \u0627\u0644\u062e\u0637\u0623",finish:"\u062a\u062e\u0637\u064a (\u0625\u0646\u0647\u0627\u0621)",completed:"\u0627\u0643\u062a\u0645\u0644 ",completedDesc:"\u062a\u0645\u062a \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062e\u062f\u0645\u0629 \u0628\u0646\u062c\u0627\u062d. \u064a\u0645\u0643\u0646\u0643 \u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629.",hardResetDesc:"\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u062c\u0645\u064a\u0639 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062e\u062f\u0645\u0629 \u0628\u0646\u062c\u0627\u062d. \u2022 \u0645\u0633\u062d \u0631\u0645\u0648\u0632 \u0627\u0644\u062e\u0637\u0623 \u2022 \u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0632\u062e\u0627\u0631\u0641 \u0627\u0644\u0648\u0642\u0648\u062f \u2022 \u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u064a\u0645\u0643\u0646\u0643 \u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},info:{desc:"\u062a\u0637\u0628\u064a\u0642 \u0627\u062d\u062a\u0631\u0627\u0641\u064a \u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u062f\u0631\u0627\u062c\u0627\u062a \u0627\u0644\u0646\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a. \u0645\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a.",upgrade:" \u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0625\u0644\u0649 Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"\u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0628\u0643\u0631 ",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner \u0642\u064a\u062f \u0627\u0644\u062a\u0637\u0648\u064a\u0631 \u062d\u0627\u0644\u064a\u064b\u0627. \u0646\u0638\u0631\u064b\u0627 \u0644\u0623\u0646\u0643 \u0645\u0633\u062a\u062e\u062f\u0645\u0646\u0627 \u0627\u0644\u0623\u0648\u0644\u060c \u0641\u0625\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0629 \u0645\u062a\u0627\u062d\u0629 \u0644\u0643 \u0627\u0644\u0622\u0646. \u0645\u0644\u0627\u062d\u0638\u0627\u062a\u0643 \u0642\u064a\u0645\u0629 \u0644\u0644\u063a\u0627\u064a\u0629 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0646\u0627!",helpGuide:"\u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0648\u0627\u0644\u062a\u0648\u062c\u064a\u0647",language:" \u0627\u0644\u0644\u063a\u0629 / \u0627\u0644\u0644\u063a\u0629 / \u0627\u0644\u0628\u0647\u0627\u0633\u0627",support:"\u0645\u0631\u0643\u0632 \u0627\u0644\u062f\u0639\u0645",supportSubject:"\u062f\u0639\u0645 Cortex OBD2 Diagnostic Scanner \u0648\u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a",thanks:"\u0634\u0643\u0631\u0627 \u0644\u0643!",thanksDesc:"\u0634\u0643\u0631\u0627 \u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a\u0643. \u064a\u0645\u0643\u0646\u0643 \u062a\u0631\u0643 \u062a\u0639\u0644\u064a\u0642 \u0644\u0646\u0627 \u0639\u0644\u0649 \u0645\u062a\u062c\u0631 Play.",sections:{live:{title:"\u0623\u062c\u0647\u0632\u0629 \u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u062d\u064a\u0629",content:"\u064a\u0645\u0643\u0646\u0643 \u0639\u0644\u0649 \u0627\u0644\u0641\u0648\u0631 \u0645\u0631\u0627\u0642\u0628\u0629 \u0639\u062f\u062f \u0627\u0644\u062f\u0648\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 \u0648\u0627\u0644\u0633\u0631\u0639\u0629 \u0648\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0645\u062d\u0631\u0643 \u0648\u0645\u0648\u0636\u0639 \u0627\u0644\u062e\u0627\u0646\u0642 \u0648\u062c\u0647\u062f \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0648\u062d\u0645\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 \u0648\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0647\u0648\u0627\u0621 \u0627\u0644\u0633\u062d\u0628 \u0648\u0636\u063a\u0637 \u0627\u0644\u0645\u0634\u0639\u0628 (MAP). \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0642\u064a\u0645 \u0645\u0646 1 \u0625\u0644\u0649 5 \u0645\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u062d\u0633\u0628 \u0633\u0631\u0639\u0629 \u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u0644\u062f\u064a\u0643. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u062f\u062e\u0644 \u0645\u0628\u0627\u0634\u0631\u0629 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0648\u0627\u0645\u0631 UDS/OBD \u0639\u0628\u0631 \u0627\u0644\u062c\u0647\u0627\u0632."},expertise:{title:"\u0627\u0644\u0641\u062d\u0635 \u0648\u0627\u0644\u0636\u0645\u0627\u0646",content:"\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0631\u0645\u0648\u0632 ECU (Brain) \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621. \u064a\u062a\u0645 \u0627\u0644\u062a\u0642\u0627\u0637 \u0631\u0642\u0645 VIN (VIN) \u0648\u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u0645\u0642\u0637\u0648\u0639\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0627\u0644\u0645\u0633\u062c\u0644\u0629 \u0639\u0644\u0649 \u0627\u0644\u0633\u064a\u0627\u0631\u0629. \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0630\u0644\u0643\u060c \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u062a\u064a \u0642\u0637\u0639\u062a\u0647\u0627 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0636\u0648\u0621 \u0641\u062d\u0635 \u0627\u0644\u0645\u062d\u0631\u0643. \u064a\u0645\u0643\u0646 \u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0646\u0627\u062a\u062c \u0641\u064a \u0628\u064a\u0626\u0627\u062a PDF \u0648\u0627\u0644\u0645\u0631\u0627\u0633\u0644\u0629."},tests:{title:"\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 / \u0627\u0644\u0623\u062f\u0627\u0621",content:"\u064a\u062a\u0643\u0648\u0646 \u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0645\u0646 3 \u0645\u0631\u0627\u062d\u0644: \u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u0631\u0627\u062d\u0629 \u0648\u0627\u0644\u062a\u062f\u0648\u064a\u0631 \u0648\u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u062e\u0627\u0645\u0644 \u062a\u0642\u064a\u0633 \u0635\u062d\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629/\u0627\u0644\u0645\u0646\u0638\u0645. \u064a\u0642\u064a\u0633 \u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0623\u062f\u0627\u0621 \u0642\u064a\u0645 \u0627\u0644\u062a\u0633\u0627\u0631\u0639 \u0645\u0646 0 \u0625\u0644\u0649 60 \u0648\u0645\u0646 0 \u0625\u0644\u0649 100 \u0643\u0645/\u0633\u0627\u0639\u0629 \u0645\u0639 \u0647\u0627\u0645\u0634 \u062e\u0637\u0623 \u064a\u0628\u0644\u063a 50 \u0645\u0644\u0644\u064a \u062b\u0627\u0646\u064a\u0629\u060c \u0648\u0630\u0644\u0643 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0644\u062d\u0638\u064a\u0629 \u0645\u0646 \u0645\u0639\u0627\u0644\u062c \u0647\u0627\u062a\u0641\u0643 \u0648\u0633\u064a\u0627\u0631\u062a\u0643."},hardware:{title:"\u062a\u0648\u0627\u0641\u0642 \u0627\u0644\u0623\u062c\u0647\u0632\u0629",content:"\u064a\u0648\u0635\u0649 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 ELM327 Bluetooth (\u0627\u0644\u0625\u0635\u062f\u0627\u0631 1.5). \u0642\u062f \u0644\u0627 \u062a\u0639\u0645\u0644 \u0628\u0639\u0636 \u0627\u0644\u0631\u0645\u0648\u0632 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0630\u0627\u062a \u0627\u0644\u062c\u0648\u062f\u0629 \u0627\u0644\u0631\u062f\u064a\u0626\u0629 \u0645\u0639 \u0625\u0635\u062f\u0627\u0631 v2.1 CLONE. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0623\u0633\u0631\u0639 \u0633\u0631\u0639\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u062d\u0648\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0645\u064a\u0632\u0629 \u0645\u062b\u0644 vLinker \u0648OBDLink."},warnings:{title:"\u062a\u062d\u0630\u064a\u0631\u0627\u062a \u0647\u0627\u0645\u0629",content:"\u2022 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0648\u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u0645\u062d\u0631\u0643 \u0623\u062b\u0646\u0627\u0621 \u0639\u0645\u0644\u064a\u0629 \u062d\u0630\u0641 \u0631\u0645\u0632 \u0627\u0644\u062e\u0637\u0623 \u0623\u0648 \u0648\u0638\u064a\u0641\u0629 \u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629. \u2022 \u0644\u0627 \u062a\u0631\u0633\u0644 \u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u0625\u0644\u0649 \u0645\u0631\u0643\u0628\u0629 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644. \u2022 \u0642\u062f \u0644\u0627 \u062a\u062f\u0639\u0645 \u0643\u0644 \u0645\u0631\u0643\u0628\u0629 \u062c\u0645\u064a\u0639 \u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631\u060c \u0641\u0633\u062a\u0639\u0631\u0636 \u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u063a\u064a\u0631 \u0627\u0644\u0645\u062f\u0639\u0648\u0645\u0629 \"--\"."},onboarding:{title:"\u0627\u0644\u0623\u0630\u0648\u0646\u0627\u062a \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0648\u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0645\u062c\u0647\u0648\u0644",content:"\u0645\u0646 \u0623\u062c\u0644 \u062a\u062d\u0633\u064a\u0646 \u062c\u0648\u062f\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u062a\u0648\u0627\u0641\u0642 \u0627\u0644\u0633\u064a\u0627\u0631\u0629\u061b \u064a\u0645\u0643\u0646 \u062a\u062d\u0644\u064a\u0644 \u0645\u0639\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0643 \u0648\u0623\u0643\u0648\u0627\u062f \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0645\u062c\u0647\u0648\u0644\u0629 \u0627\u0644\u0645\u0635\u062f\u0631 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0623\u062b\u0646\u0627\u0621 \u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 (\u062f\u0648\u0646 \u0627\u062d\u062a\u0648\u0627\u0621 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0648\u0631\u0642\u0645 \u0627\u0644\u0647\u064a\u0643\u0644) \u0639\u0644\u0649 \u062e\u0648\u0627\u062f\u0645\u0646\u0627 \u0627\u0644\u0622\u0645\u0646\u0629. \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0641\u0625\u0646\u0643 \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0634\u0631\u0648\u0637 \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0627\u0644\u0645\u062c\u0647\u0648\u0644\u0629 \u0647\u0630\u0647. \u0645\u0637\u0644\u0648\u0628 \u0623\u0630\u0648\u0646\u0627\u062a Bluetooth \u0648\u0627\u0644\u0645\u0648\u0642\u0639 \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u062f\u0631\u0627\u062c\u062a\u0643 \u0627\u0644\u0646\u0627\u0631\u064a\u0629."},featureCoding:{title:"\u0641\u062a\u062d \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u062e\u0641\u064a\u0629 \u0648\u062a\u0631\u0645\u064a\u0632 UDS",content:"\u0645\u062f\u0639\u0648\u0645\u064b\u0627 \u0628\u0645\u062d\u0631\u0643 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 ISO 14229 UDS \u0627\u0644\u062e\u0627\u0635 \u0628\u0646\u0627\u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u0628\u062f\u064a\u0644 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0628\u0623\u0645\u0627\u0646 \u0645\u062b\u0644 \u0645\u0635\u0627\u0628\u064a\u062d \u0648\u0642\u0648\u0641 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629\u060c \u0648\u0645\u0633\u062d \u0627\u0644\u0625\u0628\u0631\u0629\u060c \u0648\u0642\u0641\u0644 Horn Ack\u060c \u0648\u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0645\u0631\u064a\u062d\u0629\u060c \u0648\u0625\u0639\u062f\u0627\u062f\u0627\u062a DRL \u0644\u0645\u0631\u0643\u0628\u0627\u062a VAG\u060c \u0648BMW\u060c \u0648Renault\u060c \u0648Dacia."},multiEcu:{title:"\u0645\u0633\u062d \u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0648\u062d\u062f\u0627\u062a",content:"\u0642\u0645 \u0628\u0645\u0633\u062d \u0631\u0645\u0648\u0632 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0648\u0645\u0633\u062d\u0647\u0627 \u062e\u0627\u0631\u062c \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0643 - \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 ABS\u060c \u0648\u0627\u0644\u0648\u0633\u0627\u062f\u0629 \u0627\u0644\u0647\u0648\u0627\u0626\u064a\u0629\u060c \u0648\u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0623\u0648\u062a\u0648\u0645\u0627\u062a\u064a\u0643\u064a (TCU)\u060c \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u062e (HVAC)\u060c \u0648\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062c\u0633\u0645 (BCM)."},advancedDiagnostics:{title:"\u062a\u0643\u064a\u0641 DCT\u060c \u0648\u0645\u0642\u064a\u0627\u0633 \u0637\u0627\u0642\u0629 DPF \u0648HP",content:"\u2022 DCT / DSG \u0627\u0644\u0641\u0627\u0635\u0644 \u0642\u0628\u0644\u0629 \u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u0639\u0644\u0645 \u0648\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0643\u064a\u0641\n\u2022 \u062a\u062d\u0645\u064a\u0644 \u0633\u0646\u0627\u062c DPF (%/\u062c\u0645) \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u062a\u062c\u062f\u064a\u062f \u0627\u0644\u0639\u0627\u062f\u0645\n\u2022 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u062d\u0642\u064a\u0642\u064a \u0627\u0644\u062f\u064a\u0643\u0648\u0631\u0627\u062a \u0627\u0644\u0648\u0642\u0648\u062f \u0639\u0644\u0649 \u0627\u0644\u0645\u062f\u0649 \u0627\u0644\u0642\u0635\u064a\u0631 / \u0627\u0644\u0637\u0648\u064a\u0644 (STFT / LTFT) \u0648\u062a\u062d\u0644\u064a\u0644 \u0644\u0627\u0645\u062f\u0627\n\u2022 \u0627\u0644\u0631\u0633\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u064a \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0644\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0644\u0644\u0642\u062f\u0631\u0629 \u0627\u0644\u062d\u0635\u0627\u0646\u064a\u0629 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629 (HP) \u0648\u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 (\u0646\u064a\u0648\u062a\u0646 \u0645\u062a\u0631)."},demoMode:{title:"\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a (\u0645\u062d\u0627\u0643\u0627\u0629)",content:"\u0627\u062e\u062a\u0628\u0631 \u0648\u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u062f\u0648\u0646 \u062c\u0647\u0627\u0632 OBD2 \u0641\u0639\u0644\u064a. \u0627\u0633\u062a\u0645\u062a\u0639 \u0628\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0644\u0640 CAN-Bus \u0648 UDS \u0645\u0639 \u0645\u062d\u0627\u0643\u0627\u0629 \u0648\u0627\u0642\u0639\u064a\u0629 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u064a\u0629."}},reconfigurePermissions:"\u0625\u0639\u0627\u062f\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0630\u0648\u0646\u0627\u062a \u0648\u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629",shareWithFriend:"\u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0639 \u0635\u062f\u064a\u0642",shareMessageText:"\u0627\u0643\u062a\u0634\u0641 \u0623\u0639\u0637\u0627\u0644 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0643 \u0648\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u064a\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Cortex OBD2 Diagnostic Scanner!\n\n\u062d\u0645\u0644 \u0627\u0644\u0622\u0646:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:" \u062a\u0630\u0643\u064a\u0631\u064a \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062a\u0634\u062e\u064a\u0635\u064a \u0644\u0644\u0645\u0648\u062a\u0648\u0643\u0648\u0631\u062a\u0643\u0633 \u062a\u0630\u0643\u064a\u0631\u064a ",vehicleIdentity:" \u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0631\u0643\u0628\u0629",vin:"\u0631\u0642\u0645 \u0627\u0644\u0647\u064a\u0643\u0644 (VIN)",odometer:"\u0627\u0644\u0645\u0633\u0627\u0641\u0629 (\u0643\u0645)",milDist:"\u0636\u0648\u0621 \u0627\u0644\u0645\u062d\u0631\u0643 \u0645\u0636\u0627\u0621",distSinceCleared:"\u062a\u0645 \u0645\u0633\u062d \u0627\u0644\u062e\u0637\u0623",dtcCount:" \u0631\u0645\u0648\u0632 \u0627\u0644\u062e\u0637\u0623 ({{count}}\u0627\u0644\u0643\u0645\u064a\u0629)",sensorData:" \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0644\u062d\u064a\u0629",noData:"\u0641\u0634\u0644 \u0641\u064a \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a",proApp:"\u062a\u0645 \u0641\u062d\u0635\u0647\u0627 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"\u062a\u0627\u0631\u064a\u062e",vinNotFound:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0643\u0634\u0641 \u0639\u0646\u0647\u0627",noDtcs:"\u0644\u0627 \u062a\u0648\u062c\u062f \u0631\u0645\u0648\u0632 \u062e\u0637\u0623 - \u0646\u0638\u064a\u0641\u0629",speed:"\u0627\u0644\u0633\u0631\u0639\u0629",coolant:"\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0645\u062d\u0631\u0643",throttle:"\u063a\u0627\u0632",engineLoad:"\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643",intakeAir:"\u0643\u0645\u064a\u0629 \u0627\u0644\u0647\u0648\u0627\u0621",manifold:"\u0645\u0634\u0639\u0628",voltage:"\u062c\u0647\u062f \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629",shareMessage:"\u0627\u062a\u0628\u0639 \u062d\u0627\u0644\u0629 \u062f\u0631\u0627\u062c\u062a\u0643 \u0627\u0644\u0646\u0627\u0631\u064a\u0629 \u0645\u0646 \u062c\u064a\u0628\u0643 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0634\u062e\u064a\u0635 Motocortex Obd2! \u062a\u062d\u0645\u064a\u0644: https:// Motocortex.app",subtitle:"\u0641\u062d\u0635 \u0634\u0627\u0645\u0644 \u0644\u0644\u062a\u0634\u062e\u064a\u0635 \u0648\u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f",vehicleInfo:"\u062a\u062d\u062f\u064a\u062f \u0647\u0648\u064a\u0629 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0648\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0648\u0635\u0641\u064a\u0629 \u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629",healthScore:"\u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0627\u0644\u0634\u0627\u0645\u0644\u0629 \u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629",dtcSection:"\u0631\u0645\u0648\u0632 \u0627\u0644\u0645\u0634\u0627\u0643\u0644 \u0627\u0644\u062a\u0634\u062e\u064a\u0635\u064a\u0629 (\u062a\u062f\u0642\u064a\u0642 DTC)",telemetrySection:"\u0627\u0644\u0642\u064a\u0627\u0633 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0639\u0646 \u0628\u0639\u062f \u0648\u0644\u0642\u0637\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631",maintenanceSection:"\u062a\u0627\u0631\u064a\u062e \u062e\u062f\u0645\u0629 \u0648\u0635\u064a\u0627\u0646\u0629 Ak\u0131ll\u0131 Garaj",aiSection:"\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \