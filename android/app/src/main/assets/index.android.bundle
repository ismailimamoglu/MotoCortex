mi SU7 et biais de couple arri\xe8re",desc:"Active la polarisation de couple du moteur arri\xe8re \xe0 100 % et le mode ESC Track Drift."},vag_oil_service_reset:{name:"Oil Change Service Reset (Flexible Interval)",desc:"Resets instrument cluster oil change interval counter to factory 15,000 km / 365 days."},vag_epb_service_mode:{name:"Mode d'entretien des plaquettes de frein du frein de stationnement \xe9lectronique (EPB)",desc:"R\xe9tracte les pistons de l'\xe9trier arri\xe8re EPB pour le remplacement des plaquettes de frein arri\xe8re et du rotor."},bmw_bms_battery_registration:{name:"Enregistrement de la batterie du capteur de batterie intelligent (IBS)",desc:"Enregistre le nouveau remplacement de la batterie AGM/plomb-acide 12 V dans la gestion du moteur DME/DDE."},bmw_motorrad_service_indicator_reset:{name:"Entretien annuel BMW Motorrad et r\xe9initialisation de l'indicateur d'huile",desc:"Efface la date d'entretien annuel et le rappel de distance de 10 000 km sur le groupe d'instruments TFT."},ducati_desmo_service_reset:{name:"Rappel de service de valve Ducati Desmo Effacer",desc:"Efface l'ic\xf4ne de cl\xe9 Desmoservice sur le tableau de bord apr\xe8s 15 000/30 000 km d'entretien."},byd_bms_isolation_self_test:{name:"Auto-test d\u2019isolation haute tension de la batterie BYD Blade",desc:"Ex\xe9cute les diagnostics de fuite et de r\xe9sistance du syst\xe8me haute tension (400 V/800 V) dans BMS."},vag_drl_brightness_multi:{name:"R\xe9glage de la luminosit\xe9 des feux de jour (DRL)",desc:"Ajustez le niveau d'intensit\xe9 LED DRL pour les feux de croisement/mode stationnement."},bmw_comfort_turn_signal_cycles:{name:"Compteur d'impulsions des clignotants confort \xe0 une touche",desc:"S\xe9lectionnez le nombre de clignotements qui se produisent en appuyant rapidement sur le levier des clignotants."},bmw_oil_service_reset:{name:"R\xe9initialisation de l'huile moteur CBS (BMW)",desc:"R\xe9initialise le pourcentage de dur\xe9e de vie de l'huile du service bas\xe9 sur l'\xe9tat (CBS) \xe0 100\xa0%."},generic_oil_service_reset:{name:"R\xe9initialisation de l'indicateur d'entretien d'huile universel",desc:"Efface le voyant d\u2019avertissement de maintenance d\u2019huile du tableau de bord sur les ECU OBD2/UDS pris en charge."},vag_epb_pad_change:{name:"Mode de remplacement des plaquettes de frein EPB (VAG)",desc:"R\xe9tracte les \xe9triers de frein de stationnement \xe9lectroniques pour l\u2019entretien des plaquettes de frein arri\xe8re."},bmw_epb_pad_change:{name:"Mode de service des freins EPB (BMW)",desc:"Ouvre l'actionneur du frein de stationnement en position de service pour le remplacement des plaquettes arri\xe8re."},mb_epb_pad_change:{name:"Mode de montage des tampons EPB (Mercedes-Benz)",desc:"Rel\xe2che la broche du frein de stationnement en position atelier pour l'entretien des freins."},vag_dpf_regen:{name:"D\xe9clencheur de r\xe9g\xe9n\xe9ration du service DPF (VAG)",desc:"Lance le cycle de combustion des suies du filtre \xe0 particules diesel (DPF) stationnaire."},bmw_dpf_regen:{name:"D\xe9clencheur de r\xe9g\xe9n\xe9ration forc\xe9e DPF (BMW)",desc:"Demande au calculateur DDE de d\xe9marrer la routine de r\xe9g\xe9n\xe9ration active du filtre \xe0 particules."},psa_dpf_regen:{name:"Demande de r\xe9g\xe9n\xe9ration FAP (Peugeot/Citro\xebn)",desc:"D\xe9clenche la r\xe9g\xe9n\xe9ration DPF stationnaire pour les calculateurs de moteur diesel HDi."},bmw_bms_battery_register:{name:"Enregistrement de remplacement de batterie BMS (BMW)",desc:"Enregistre le remplacement d'une nouvelle batterie avec le capteur de batterie intelligent DME/DDE."},mb_bms_battery_register:{name:"Enregistrement et r\xe9initialisation de la batterie (Mercedes-Benz)",desc:"R\xe9initialise le compteur de vieillissement de la batterie dans le module SAM apr\xe8s l'installation d'une nouvelle batterie."},vag_sas_calibrate:{name:"Calibrage du capteur d'angle de braquage (SAS) (VAG)",desc:"Calibre la position du point z\xe9ro du capteur d'angle de br