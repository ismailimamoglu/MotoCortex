03 a bateriei",safetyAlertMsg:"Tensiune minim\u0103 a bateriei de 12,2 V necesar\u0103 pentru codare.\nV\u0103 rug\u0103m s\u0103 conecta\u021bi un \xeenc\u0103rc\u0103tor sau s\u0103 porni\u021bi motorul.",items:{vag_staging_needle_sweep:{name:"Etalonarea ecartamentului / M\u0103turarea acului",desc:"M\u0103tur\u0103 acele instrumente la maximum la pornirea aprinderii."},vag_acoustic_lock_confirmation:{name:"Ciripit de confirmare a bloc\u0103rii acustice",desc:"Emite un ciripit scurt de confirmare a claxonului la blocarea cheii."},vag_american_parking_lights:{name:"Lumini de parcare \xeen stil american",desc:"Ilumineaz\u0103 semnalele de direc\u021bie fa\u021b\u0103 \xeen mod continuu la 20% diminuare cu lumini de parcare."},vag_drl_menu_toggle:{name:"Lumini de zi (DRL) Comutare meniu",desc:"Activeaz\u0103 caseta de selectare DRL ON/OFF din meniul de set\u0103ri ale vehiculului infotainment."},vag_tear_wiping:{name:"Stergerea lacrimilor de parbriz",desc:"Execut\u0103 o \u0219tergere final\u0103 suplimentar\u0103 la 5 secunde dup\u0103 utilizarea sp\u0103l\u0103rii parbrizului."},vag_emergency_brake_flashing:{name:"Pericol de fr\xe2n\u0103 de urgen\u021b\u0103",desc:"Aprinde rapid luminile de fr\xe2n\u0103 \u0219i pericole \xeen cazul fr\xe2n\u0103rii puternice de urgen\u021b\u0103."},vag_cornering_lights:{name:"Lumini de cea\u021b\u0103 pentru viraj",desc:"Aprinde lumina de cea\u021b\u0103 \xeen viraje pe partea de rota\u021bie a volanului."},vag_comfort_mirror_folding:{name:"Key Fob Comfort Oglinda Pliabila",desc:"Pliaz\u0103 automat oglinzile laterale c\xe2nd butonul de blocare este ap\u0103sat pe telecomanda."},vag_lap_timer:{name:"Cronometru pentru turul grupului de instrumente",desc:"Deblocheaz\u0103 fila de afi\u0219are a cronometrului de tur\u0103 pe ecranul grupului de instrumente."},vag_refuel_quantity:{name:"Afi\u0219area cantit\u0103\u021bii de combustibil",desc:"Afi\u0219eaz\u0103 volumul exact \xeen litri necesar pentru o realimentare complet\u0103."},bmw_start_stop_memory:{name:"Modul de memorie pornire-oprire automat\u0103",desc:"\xce\u0219i aminte\u0219te ultima stare de pornire \u0219i oprire automat\u0103 (OFF/ON) la repornirile vehiculului."},bmw_digital_speedometer:{name:"Afi\u0219aj digital vitezometru",desc:"Adaug\u0103 op\u021biunea de afi\u0219are numeric\u0103 a vitezei digitale instantanee pe ecranul grupului."},bmw_sport_displays:{name:"Afi\u0219aje sport (indicatoare HP \u0219i Nm)",desc:"Activeaz\u0103 cadranele dinamice ale cailor putere \u0219i cuplului \xeen timp real pe ecranul iDrive."},bmw_acoustic_lock_sound:{name:"Sunet de blocare/deblocare acustic\u0103",desc:"Emite semnale de alarm\u0103 la \xeencuierea sau deblocarea vehiculului."},bmw_mirror_fold_delay_zero:{name:"Pliere instantanee a oglinzii (\xeent\xe2rziere 0,0 s)",desc:"Pliaz\u0103 oglinzile laterale instantaneu la ap\u0103sarea butonului de blocare f\u0103r\u0103 \xeent\xe2rziere."},bmw_tpms_tire_temperature:{name:"Afi\u0219area presiunii \u0219i temperaturii anvelopelor",desc:"Afi\u0219eaz\u0103 \xeen timp real temperatura anvelopelor \xeempreun\u0103 cu presiunea pe ecranul TPMS."},renault_trip_computer_enable:{name:"Activare computer de bord de bord",desc:"Deblocheaz\u0103 consumul mediu de combustibil \u0219i afi\u0219ajele computerului de bord."},renault_external_temp_display:{name:"Afi\u0219are extern\u0103 a temperaturii",desc:"Permite citirea temperaturii ambientale exterioare \xeen tabloul de instrumente."},renault_automatic_tailgate:{name:"Eliberarea portbagajului cheie",desc:"Aprinde complet mecanismul de blocare a portbagajului c\xe2nd \u021bine\u021bi ap\u0103sat butonul pentru portbagaj."},renault_alarm_chirp:{name:"Ciripit de confirmare a bloc\u0103rii alarmei",desc:"Se aude un ciripit de confirmare a claxonului la blocarea u\u0219ii vehiculului."},renault_shift_indicator:{name:"Indicator de schimbare a vitezelor (GSI)",desc:"Activeaz\u0103 s\u0103ge\u021bile SUS/JOS pentru schimbarea vitezei de conducere ecologic\