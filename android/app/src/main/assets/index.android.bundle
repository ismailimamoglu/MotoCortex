5\u062a\u0635\u0644\u0629 \u0639\u0644\u0649 \u0623\u0646\u0647\u0627 \"{{make}}\" \u0645\u0646 \u0631\u0642\u0645 \u0627\u0644\u0647\u064a\u0643\u0644 (VIN). \u0648\u0645\u0639 \u0630\u0644\u0643 \u060c \u0641\u0625\u0646 \u0645\u0631\u0643\u0628\u062a\u0643 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0647\u064a \"{{selected}}\".\n\n\u0647\u0644 \u062a\u0631\u063a\u0628 \u0641\u064a \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u062d\u062f\u064a\u062f \u0627\u0644\u062d\u0627\u0644\u064a \u0648\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u0631\u064a\u0641\u0647 \u0628\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u062d\u0629 ({{make}})\u061f",operations:{clearDtc:"\u062a\u0645 \u0645\u0633\u062d \u0631\u0645\u0648\u0632 \u0627\u0644\u0623\u0639\u0637\u0627\u0644",fuelAdaptation:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u062a\u0643\u064a\u064a\u0641 \u0627\u0644\u0648\u0642\u0648\u062f",ecuReset:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629"},searchLanguage:"\u0644\u063a\u0629 \u0627\u0644\u0628\u062d\u062b...",connectionSection:"\u0627\u062a\u0635\u0627\u0644 \u062c\u0647\u0627\u0632 \u0623\u0648 \u0628\u064a \u062f\u064a",noVehicleTitle:"\u0645\u0637\u0644\u0648\u0628 \u0643\u0634\u0641 \u0627\u0644\u0633\u064a\u0627\u0631\u0629",noVehicleDesc:"\u0633\u064a\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0647\u0648\u064a\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0628\u0631 \u0627\u062a\u0635\u0627\u0644 OBD-II. \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0646 \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u062c\u0647\u0627\u0632\u0643 \u0623\u062f\u0646\u0627\u0647.",registeredVehiclesButton:"\u0645\u0631\u0643\u0628\u0627\u062a\u064a \u0627\u06