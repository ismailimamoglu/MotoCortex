sy Access Steering Wheel & Power Seat Slide-Back",desc:"Slides driver seat back and tilts steering wheel away for easy entry/exit."},nissan_epower_regen_mode:{name:"e-POWER One-Pedal Regenerative Braking Mode",desc:"Sets default e-Pedal regenerative braking deceleration level."},nissan_propilot_assist_timing:{name:"ProPILOT Lane Centering Assist Steering Sensitivity",desc:"Configures ProPILOT steering intervention sharpness."},nissan_intelligent_around_view:{name:"Around View Monitor Auto-Pop-Up at Low Speed",desc:"Triggers 360-degree camera display when front parking sensors detect obstacles."},mazda_g_vectoring_display:{name:"G-Vectoring Control Plus Dynamic Visualizer",desc:"Displays real-time GVC+ cornering torque vectoring graph on instrument panel."},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP Brake Energy Recovery Capacitor Meter",desc:"Shows electric capacitor charge & discharge status on central screen."},mazda_smart_city_brake_sens:{name:"Smart City Brake Support Sensitivity",desc:"Sets low-speed automatic emergency braking sensor range."},subaru_eyesight_distance_preset:{name:"EyeSight Adaptive Cruise Control Default Distance",desc:"Configures stereo camera default cruise gap profile on startup."},subaru_xmode_auto_engage:{name:"X-Mode Off-Road Traction Auto-Engage Threshold",desc:"Sets wheel slip threshold for automatic dual-function X-Mode activation."},subaru_steering_responsive_headlights:{name:"Steering Responsive Headlights Toggle",desc:"Enables or disables directional adaptive headlight swivel."},genesis_sport_plus_mode:{name:"Sport+ Powertrain & Electronic Suspension Mode",desc:"Unlocks track-oriented ESC OFF and stiffened damper mapping."},genesis_ambient_active_light:{name:"Active Ambient Lighting Drive Mode Sync",desc:"Changes interior ambient lighting color dynamically based on drive mode."},volvo_city_safety_warning:{name:"City Safety Autonomous Emergency Warning Sensitivity",desc:"Configures radar and lidar collision warning alert timing."