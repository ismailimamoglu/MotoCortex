5 \u043a\u0430\u0440\u0442\u044b \u0436\u0435\u0441\u0442\u043e\u0432 \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u044f-\u0442\u044f\u0433\u0438",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u044c \u043a\u0430\u0440\u0442\u044b, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u044f \u0436\u0435\u0441\u0442 \u0440\u044b\u0447\u0430\u0433\u0430 \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435."},yamaha_quickshifter_cut_time_adjust:{name:"\u0412\u0440\u0435\u043c\u044f \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0432\u0438\u043a\u0448\u0438\u0444\u0442\u0435\u0440\u0430 \u043f\u0440\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u0438",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043a\u0432\u0438\u043a\u0448\u0438\u0444\u0442\u0435\u0440\u0430 \u0438 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0443 \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u043d\u0438\u044f \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},yamaha_ride_by_wire_throttle_map:{name:"\u0421\u0435\u043b\u0435\u043a\u0442\u043e\u0440 \u043f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043e\u043a \u043a\u0430\u0440\u0442\u044b \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438 \u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u043c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c",desc:"\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0440\u0435\u0436\u0438\u043c\u044b A (\u0430\u0433\u0440\u0435\u0441\u0441\u0438\u