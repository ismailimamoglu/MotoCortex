c9\u03bd\u03af\u03b1 \u03b4\u03b9\u03b5\u03cd\u03b8\u03c5\u03bd\u03c3\u03b7\u03c2 \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2."},bmw_easy_entry_steering:{name:"\u0395\u03cd\u03ba\u03bf\u03bb\u03b7 \u03b5\u03af\u03c3\u03bf\u03b4\u03bf\u03c2 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03b1\u03bd\u03b1\u03c3\u03c5\u03c1\u03cc\u03bc\u03b5\u03bd\u03b7 \u03ba\u03bf\u03bb\u03cc\u03bd\u03b1 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd (BMW)",desc:"\u0391\u03bd\u03b1\u03c3\u03cd\u03c1\u03b5\u03b9 \u03c4\u03bf \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03cc \u03c4\u03b9\u03bc\u03cc\u03bd\u03b9 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c9 \u03bc\u03b5 \u03c4\u03bf \u03c3\u03b2\u03ae\u03c3\u03b9\u03bc\u03bf \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b3\u03b9\u03b1 \u03b5\u03cd\u03ba\u03bf\u03bb\u03b7 \u03ad\u03be\u03bf\u03b4\u03bf."},bmw_bluetooth_audio_enable:{name:"\u0395\u03bd\u03b9\u03c3\u03c7\u03c5\u03bc\u03ad\u03bd\u03bf \u03be\u03b5\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03c1\u03bf\u03ae\u03c2 \u03ae\u03c7\u03bf\u03c5 Bluetooth (BMW)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7\u03bd \u03b1\u03c3\u03cd\u03c1\u03bc\u03b1\u03c4\u03b7 \u03c1\u03bf\u03ae \u03bc\u03bf\u03c5\u03c3\u03b9\u03ba\u03ae\u03c2 A2DP Bluetooth \u03c3\u03c4\u03bf iDrive HU_ENTRYNAV."},bmw_door_handle_lights_reverse:{name:"\u03a6\u03ce\u03c4\u03b1 \u03bb\u03b1\u03ba\u03ba\u03bf\u03cd\u03b2\u03b1\u03c2 \u03b5\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae\u03c2 \u03bb\u03b1\u03b2\u03ae\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 \u03c3\u03c4\u03b7\u03bd \u03cc\u03c0\u03b9\u03c3\u03b8\u03b5\u03bd (BMW)",desc:"\u0391\u03bd\u03ac\u03b2\u03b5\u03b9 \u03c4\u03b1 LED \u03c4\u03b7\u03c2 \u03bb\u03b1\u03b2\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 \u03cc\u03c4\u03b1\u03bd \u03bc\u03c0\u03b1\u03af\u03bd\u03b5\u03b9 \u03b7 \u03cc\u03c0\u03b9\u03c3\u03b8\u03b5\u03bd."},toyota_auto_headlight_threshold:{name:"\u0395\u03c5\u03b1\u03b9\u03c3\u03b8\u03b7\u03c3\u03af\u03b1 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 \u03c6\u03c9\u03c4\u03cc\u03c2 Auto Headlight (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03ba\u03b1\u03c4\u03ce\u03c6\u03bb\u03b9 \u03c4\u03bf\u03c5 \u03c3\u03bf\u03cd\u03c1\u03bf\u03c5\u03c0\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03bb\u03c5\u03ba\u03cc\u03c6\u03c9\u03c4\u03bf\u03c2 \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd."},toyota_turn_signal_click_volume:{name:"\u0388\u03bd\u03c4\u03b1\u03c3\u03b7 \u03ae\u03c7\u03bf\u03c5 \u03b7\u03c7\u03b5\u03af\u03bf\u03c5 \u03ba\u03bb\u03b9\u03ba \u03c3\u03c4\u03bf \u03c3\u03c4\u03c1\u03bf\u03c6\u03b9\u03ba\u03cc \u03c3\u03ae\u03bc\u03b1 (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03ad\u03bd\u03c4\u03b1\u03c3\u03b7 \u03ae\u03c7\u03bf\u03c5 \u03ba\u03c1\u03cc\u03c4\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03c1\u03b5\u03bb\u03ad \u03c6\u03bb\u03b1\u03c2 (\u03c7\u03b1\u03bc\u03b7\u03bb\u03ae, \u03bc\u03b5\u03c3\u03b1\u03af\u03b1, \u03c5\u03c8\u03b7\u03bb\u03ae)."},toyota_smart_key_approach_lights:{name:"Smart Key Proximity Poddle Lights Welcome (Toyota)",desc:"\u0391\u03bd\u03ac\u03b2\u03b5\u03b9 \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03bb\u03b1\u03ba\u03ba\u03bf\u03cd\u03b2\u03b1\u03c2 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b7 \u03cc\u03c4\u03b1\u03bd \u03c4\u03bf \u03ad\u03be\u03c5\u03c0\u03bd\u03bf \u03ba\u03bb\u03b5\u03b9\u03b4\u03af \u03c0\u03bb\u03b7\u03c3\u03b9\u03ac\u03b6\u03b5\u03b9 \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1."},toyota_rear_hatch_behavior:{name:"\u039b\u03bf\u03b3\u03b9\u03ba\u03ae \u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u0391\u03bd\u03bf\u03b9\u03c7\u03c4\u03bf\u03cd/\u039a\u03bb\u03b5\u03b9\u03c3\u03af\u03bc\u03b1\u03c4\u03bf\u03c2 \u0391\u03bd\u03bf\u03b9\u03b3\u03cc\u03bc\u03b5\u03bd\u03b7\u03c2/\u039a\u03bb\u03b5\u03b9\u03c3\u03af\u03bc\u03b1\u03c4\u03bf\u03c2 \u0397\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ae\u03c2 \u03a0\u03af\u03c3\u03c9 \u03a0\u03cc\u03c1\u03c4\u03b1\u03c2 (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c0\u03b1\u03c1\u03b1\u03bc\u03ad\u03c4\u03c1\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03b7\u03c1\u03af\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1\u03c2 \u03c0\u03af\u03b5\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd \u03c4\u03c1\u03bf\u03c6\u03bf\u03b4\u03bf\u03c3\u03af\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03c4\u03b1\u03bc\u03c0\u03bb\u03cc."},toyota_open_windows_smart_key:{name:"\u03a0\u03b1\u03c1\u03b1\u03c4\u03b5\u03c4\u03b1\u03bc\u03ad\u03bd\u03bf \u03c0\u03ac\u03c4\u03b7\u03bc\u03b1 \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03b7\u03c1\u03af\u03bf\u03c5 Smart Key (Toyota)",desc:"\u0395\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf \u03ac\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 \u03cc\u03bb\u03c9\u03bd \u03c4\u03c9\u03bd \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03c9\u03bd \u03ba\u03c1\u03b1\u03c4\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c0\u03b1\u03c4\u03b7\u03bc\u03ad\u03bd\u03bf \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03b1\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5 \u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2."},toyota_interior_light_dim_timer:{name:"\u039a\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7\u03c2 \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd \u03ba\u03b1\u03bc\u03c0\u03af\u03bd\u03b1\u03c2 \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03bf\u03cd \u03c7\u03ce\u03c1\u03bf\u03c5 (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7 \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03c6\u03c9\u03c4\u03cc\u03c2 \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03bf\u03cd \u03b8\u03cc\u03bb\u03bf\u03c5 \u03bc\u03b5\u03c4\u03ac \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03c3\u03b9\u03bc\u03bf \u03c4\u03b7\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2."},toyota_panic_alarm_remote:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c3\u03b5\u03b9\u03c1\u03ae\u03bd\u03b1\u03c2 \u03c3\u03c5\u03bd\u03b1\u03b3\u03b5\u03c1\u03bc\u03bf\u03cd \u03c0\u03b1\u03bd\u03b9\u03ba\u03bf\u03cd \u03c4\u03b7\u03bb\u03b5\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03b7\u03c1\u03af\u03bf\u03c5 \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba (Toyota)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03ae \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03bf\u03bd \u03c3\u03c5\u03bd\u03b1\u03b3\u03b5\u03c1\u03bc\u03cc \u03c0\u03b1\u03bd\u03b9\u03ba\u03bf\u03cd \u03c4\u03b7\u03c2 \u03ba\u03cc\u03c1\u03bd\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03bc\u03ad\u03c3\u03c9 \u03b1\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5 \u03ba\u03c1\u03b1\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03ba\u03bb\u03b5\u03b9\u03b4\u03b9\u03bf\u03cd."},toyota_eco_drive_indicator:{name:"\u0395\u03bd\u03b4\u03b5\u03b9\u03ba\u03c4\u03b9\u03ba\u03ae \u03bb\u03c5\u03c7\u03bd\u03af\u03b1 \u03b6\u03ce\u03bd\u03b7\u03c2 \u03c3\u03c5\u03bc\u03c0\u03bb\u03ad\u03b3\u03bc\u03b1\u03c4\u03bf\u03c2 \u03bc\u03b5\u03c4\u03ac\u03b4\u03bf\u03c3\u03b7\u03c2 \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 ECO (Toyota)",desc:"\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c6\u03b9\u03bb\u03b9\u03ba\u03ae \u03c0\u03c1\u03bf\u03c2 \u03c4\u03bf \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd \u03b3\u03c1\u03b1\u03bc\u03bc\u03ae \u03b5\u03c0\u03b9\u03c4\u03ac\u03c7\u03c5\u03bd\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bd\u03b4\u03b5\u03b9\u03ba\u03c4\u03b9\u03ba\u03ae \u03bb\u03c5\u03c7\u03bd\u03af\u03b1 \u03c3\u03c4\u03bf \u03c3\u03cd\u03bc\u03c0\u03bb\u03b5\u03b3\u03bc\u03b1."},hyundai_coming_home_duration:{name:"\u03a7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7\u03c2 \u03ba\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7\u03c2 \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd \u03c3\u03c5\u03bd\u03bf\u03b4\u03b5\u03af\u03b1\u03c2 (Hyundai/Kia)",desc:"\u0394\u03b9\u03b1\u03c4\u03b7\u03c1\u03b5\u03af \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03bc\u03b5\u03c3\u03b1\u03af\u03b1\u03c2 \u03c3\u03ba\u03ac\u03bb\u03b1\u03c2 \u03b1\u03bd\u03b1\u03bc\u03bc\u03ad\u03bd\u03b1 \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03ad\u03be\u03bf\u03b4\u03bf \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2."},hyundai_drl_menu_toggle:{name:"\u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03bc\u03b5\u03bd\u03bf\u03cd \u03c6\u03ce\u03c4\u03c9\u03bd \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2 (Hyundai/Kia)",desc:"\u03a0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c4\u03b5\u03b9 \u03c4\u03b7 \u03c1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7 DRL ON/OFF \u03c3\u03c4\u03b9\u03c2 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ad\u03c2 \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7 \u03c4\u03bf\u03c5 \u03c4\u03b1\u03bc\u03c0\u03bb\u03cc \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd."},hyundai_welcome_sequence:{name:"\u03a6\u03c9\u03c2 \u03ba\u03b1\u03bb\u03c9\u03c3\u03bf\u03c1\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 Smart Key Proximity & Mirror Unfold (Hyundai/Kia)",desc:"\u039e\u03b5\u03b4\u03b9\u03c0\u03bb\u03ce\u03bd\u03b5\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03ac\u03b2\u03b5\u03b9 \u03c4\u03b1 \u03c7\u03b5\u03c1\u03bf\u03cd\u03bb\u03b9\u03b1 \u03c4\u03c9\u03bd \u03b8\u03c5\u03c1\u03ce\u03bd \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c3\u03ad\u03b3\u03b3\u03b9\u03c3\u03b7."},hyundai_interior_light_delay:{name:"\u039a\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7\u03c2 \u03ba\u03bf\u03c0\u03ae\u03c2 \u03c6\u03c9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03bf\u03cd \u03c7\u03ce\u03c1\u03bf\u03c5 \u03ba\u03b1\u03bc\u03c0\u03af\u03bd\u03b1\u03c2 (Hyundai/Kia)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c7\u03c1\u03bf\u03bd\u03cc\u03bc\u03b5\u03c4\u03c1\u03bf \u03c0\u03c1\u03b9\u03bd \u03c3\u03b2\u03ae\u03c3\u03bf\u03c5\u03bd \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03c4\u03b1 \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ac \u03c6\u03ce\u03c4\u03b1 \u03b3\u03b9\u03b1 \u03b5\u03be\u03bf\u03b9\u03ba\u03bf\u03bd\u03cc\u03bc\u03b7\u03c3\u03b7 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2."},hyundai_heat_pump_efficiency:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b8\u03b5\u03c1\u03bc\u03b9\u03ba\u03ae\u03c2 \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7\u03c2 \u03b1\u03bd\u03c4\u03bb\u03af\u03b1\u03c2 \u03b8\u03b5\u03c1\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 EV Climate (Hyundai/Kia)",desc:"\u0392\u03b5\u03bb\u03c4\u03b9\u03c3\u03c4\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03bd\u03ac\u03bb\u03c9\u03c3\u03b7 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1\u03c2 \u03c4\u03b7\u03c2 \u03b1\u03bd\u03c4\u03bb\u03af\u03b1\u03c2 \u03b8\u03b5\u03c1\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 EV \u03c3\u03b5 \u03ba\u03c1\u03cd\u03bf \u03c7\u03b5\u03b9\u03bc\u03ce\u03bd\u03b1."},tesla_track_mode_params:{name:"\u03a0\u03c1\u03bf\u03c6\u03af\u03bb \u03c3\u03c4\u03b1\u03b8\u03b5\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03c4\u03c1\u03bf\u03c7\u03b9\u03ac\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03cc\u03bb\u03c9\u03c3\u03b7\u03c2 \u03c1\u03bf\u03c0\u03ae\u03c2 (Tesla)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c0\u03b1\u03c1\u03b1\u03bc\u03ad\u03c4\u03c1\u03bf\u03c5\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03c9\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03c0\u03b1\u03c1\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7\u03c2 \u03b5\u03c5\u03c3\u03c4\u03ac\u03b8\u03b5\u03b9\u03b1\u03c2 \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b5\u03bc\u03c0\u03c1\u03cc\u03c2/\u03c0\u03af\u03c3\u03c9."},tesla_regen_brake_strength:{name:"\u0391\u03bd\u03b1\u03b3\u03b5\u03bd\u03bd\u03b7\u03c4\u03b9\u03ba\u03cc \u03c0\u03c1\u03bf\u03c6\u03af\u03bb \u03b9\u03c3\u03c7\u03cd\u03bf\u03c2 \u03c0\u03ad\u03b4\u03b7\u03c3\u03b7\u03c2 (Tesla)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03ad\u03bd\u03c4\u03b1\u03c3\u03b7 \u03b1\u03bd\u03ac\u03ba\u03c4\u03b7\u03c3\u03b7\u03c2 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03b5\u03bd\u03c4\u03ac\u03bb \u03b3\u03ba\u03b1\u03b6\u03b9\u03bf\u03cd."},tesla_walkaway_door_lock:{name:"\u0391\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03ba\u03bb\u03b5\u03b9\u03b4\u03b1\u03c1\u03b9\u03ac \u03c0\u03cc\u03c1\u03c4\u03b1\u03c2 \u03bc\u03b5 \u03ba\u03bb\u03b5\u03b9\u03b4\u03af \u03c4\u03b7\u03bb\u03b5\u03c6\u03ce\u03bd\u03bf\u03c5 (Tesla)",desc:"\u039a\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c0\u03cc\u03c1\u03c4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03b9\u03ce\u03bd\u03b5\u03b9 \u03bc\u03b5 \u03ba\u03cc\u03c1\u03bd\u03b1 \u03cc\u03c4\u03b1\u03bd \u03c4\u03bf \u03ba\u03bb\u03b5\u03b9\u03b4\u03af \u03c4\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03c6\u03ce\u03bd\u03bf\u03c5 \u03b1\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03cd\u03bd\u03b5\u03c4\u03b1\u03b9."},tesla_acceleration_boost_unlock:{name:"\u03a0\u03c1\u03bf\u03c6\u03af\u03bb \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03ce\u03b8\u03b7\u03c3\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c4\u03ac\u03c7\u03c5\u03bd\u03c3\u03b7\u03c2 \u03bc\u03b5\u03c4\u03ac\u03b4\u03bf\u03c3\u03b7\u03c2 \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 (Tesla)",desc:"\u0391\u03c5\u03be\u03ac\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03bc\u03b5\u03c4\u03b1\u03c4\u03c1\u03bf\u03c0\u03ad\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b5\u03c1\u03b5\u03c2 \u03c6\u03bf\u03c1\u03ad\u03c2 0-100 km/h."},tesla_interior_ambient_color:{name:"\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03c7\u03c1\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 \u03ba\u03b1\u03bc\u03c0\u03af\u03bd\u03b1\u03c2 Footwell (Tesla)",desc:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03b1\u03bb\u03ad\u03c4\u03b1 \u03c7\u03c1\u03c9\u03bc\u03ac\u03c4\u03c9\u03bd RGB \u03bc\u03b5 \u03c6\u03c9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 LED \u03b3\u03b9\u03b1 \u03c4\u03b1 \u03c0\u03cc\u03b4\u03b9\u03b1."},audi_matrix_led_animation:{name:"Matrix LED Headlight Dynamic Welcome Light Dance (Audi)",desc:"\u03a0\u03b1\u03af\u03b6\u03b5\u03b9 \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ae \u03b5\u03bb\u03b1\u03c6\u03c1\u03b9\u03ac \u03c7\u03bf\u03c1\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf \u03be\u03b5\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2."},audi_mmi_startup_screen:{name:"\u0393\u03c1\u03b1\u03c6\u03b9\u03ba\u03cc \u03b8\u03ad\u03bc\u03b1 \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03bf\u03b8\u03cc\u03bd\u03b7\u03c2 \u03b1\u03c6\u03ae\u03c2 MMI (Audi)",desc:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c4\u03bf \u03ba\u03b9\u03bd\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03ba\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ae\u03c2 \u03bf\u03b8\u03cc\u03bd\u03b7\u03c2 MMI (S / RS / e-tron)."},audi_drive_select_efficiency:{name:"\u03a0\u03c1\u03bf\u03c6\u03af\u03bb \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7\u03c2 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 \u03c3\u03c4\u03bf Audi Drive Select (Audi)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b1\u03c0\u03bf\u03b4\u03bf\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03b5\u03be\u03bf\u03b9\u03ba\u03bf\u03bd\u03cc\u03bc\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u03c3\u03c4\u03b9\u03c2 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ad\u03c2 Drive Select."},audi_laptimer_boost_display:{name:"Lap Timer & Turbo Bar Pressure Maugen Overlay (Audi)",desc:"\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7 \u03b3\u03cd\u03c1\u03bf\u03c5 \u03b4\u03b9\u03b1\u03b4\u03c1\u03bf\u03bc\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae turbo boost \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03cc\u03bd\u03bf \u03c3\u03c4\u03bf Virtual Cockpit."},audi_needle_sweep_gauge:{name:"\u0395\u03c0\u03b1\u03bb\u03ae\u03b8\u03b5\u03c5\u03c3\u03b7 \u03c3\u03ac\u03c1\u03c9\u03c3\u03b7\u03c2 \u03b2\u03b5\u03bb\u03cc\u03bd\u03b1\u03c2 Sport Gauge (Audi)",desc:"\u0395\u03ba\u03c4\u03b5\u03bb\u03b5\u03af \u03c0\u03bb\u03ae\u03c1\u03b7 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae \u03c3\u03ac\u03c1\u03c9\u03c3\u03b7\u03c2 \u03b2\u03b5\u03bb\u03cc\u03bd\u03b1\u03c2 \u03c3\u03c4\u03c1\u03bf\u03c6\u03cc\u03bc\u03b5\u03c4\u03c1\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c4\u03b1\u03c7\u03cd\u03bc\u03b5\u03c4\u03c1\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7."},skoda_coming_home_lights:{name:"\u03a6\u03b5\u03cd\u03b3\u03bf\u03bd\u03c4\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c3\u03c0\u03af\u03c4\u03b9 / \u0395\u03c1\u03c7\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u03c3\u03c4\u03bf \u03c3\u03c0\u03af\u03c4\u03b9 \u03a7\u03c1\u03bf\u03bd\u03cc\u03bc\u03b5\u03c4\u03c1\u03bf \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd (Skoda)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c7\u03c1\u03bf\u03bd\u03cc\u03bc\u03b5\u03c4\u03c1\u03bf \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03ad\u03be\u03bf\u03b4\u03bf \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2."},skoda_comfort_turn_signal:{name:"\u03a1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7 \u03bc\u03ad\u03c4\u03c1\u03b7\u03c3\u03b7\u03c2 \u03c0\u03b1\u03bb\u03bc\u03ce\u03bd \u03bc\u03b5 \u03ad\u03bd\u03b4\u03b5\u03b9\u03be\u03b7 Comfort (Skoda)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03c0\u03ce\u03bd \u03c4\u03bf\u03c5 \u03c6\u03bb\u03b1\u03c2 \u03bc\u03b5 \u03ad\u03bd\u03b1 \u03ac\u03b3\u03b3\u03b9\u03b3\u03bc\u03b1 \u03bc\u03b5\u03c4\u03b1\u03be\u03cd 3 \u03ba\u03b1\u03b9 5 \u03b1\u03bd\u03b1\u03b2\u03bf\u03c3\u03b2\u03ae\u03bd\u03b5\u03b9."},cupra_sport_display_menu:{name:"Cupra Performance Instrument & Menu G-Meter (Cupra)",desc:"\u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c4\u03bf \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae \u03b4\u03cd\u03bd\u03b1\u03bc\u03b7\u03c2 G, \u03c4\u03bf \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae \u03b9\u03c3\u03c7\u03cd\u03bf\u03c2 kW \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03ad\u03bd\u03b4\u03b5\u03b9\u03be\u03b7 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1\u03c2 \u03bb\u03b1\u03b4\u03b9\u03bf\u03cd."},cupra_virtual_cockpit_copper:{name:"Copper Theme Dashboard Graphics Accent (Cupra)",desc:"\u0395\u03c6\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03bc\u03b5\u03c4\u03b1\u03bb\u03bb\u03b9\u03ba\u03cc \u03b8\u03ad\u03bc\u03b1 \u03bc\u03b5 \u03c7\u03ac\u03bb\u03ba\u03b9\u03bd\u03bf Cupra \u03c3\u03c4\u03bf \u03c3\u03cd\u03bc\u03c0\u03bb\u03b5\u03b3\u03bc\u03b1 \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ce\u03bd."},vag_brake_disc_drying:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c3\u03ba\u03bf\u03c5\u03c0\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 / \u03c3\u03c4\u03b5\u03b3\u03bd\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b4\u03af\u03c3\u03ba\u03bf\u03c5 \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd \u03c3\u03c4\u03b7 \u03b2\u03c1\u03bf\u03c7\u03ae (VAG)",desc:"\u03a0\u03b5\u03c1\u03b9\u03bf\u03b4\u03b9\u03ba\u03ac \u03b5\u03c6\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03b5\u03bb\u03ac\u03c7\u03b9\u03c3\u03c4\u03b7 \u03c0\u03af\u03b5\u03c3\u03b7 \u03c4\u03b1\u03bc\u03c0\u03cc\u03bd \u03c3\u03b5 \u03c5\u03b3\u03c1\u03cc \u03ba\u03b1\u03b9\u03c1\u03cc \u03c3\u03b5 \u03c3\u03c4\u03b5\u03b3\u03bd\u03bf\u03cd\u03c2 \u03c1\u03cc\u03c4\u03bf\u03c1\u03b5\u03c2."},vag_tourist_mode_lights:{name:"\u039c\u03bf\u03c4\u03af\u03b2\u03bf \u03b4\u03ad\u03c3\u03bc\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd \u03c4\u03bf\u03c5\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 (VAG)",desc:"\u0395\u03bd\u03b1\u03bb\u03bb\u03ac\u03c3\u03c3\u03b5\u03b9 \u03c4\u03bf \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf \u03b4\u03ad\u03c3\u03bc\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd \u03bc\u03b5\u03c4\u03b1\u03be\u03cd LHD \u03ba\u03b1\u03b9 RHD \u03b3\u03b9\u03b1 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf \u03b5\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03cc."},vag_hood_warning_mute:{name:"\u03a3\u03af\u03b3\u03b1\u03c3\u03b7 \u03ba\u03bf\u03c5\u03b4\u03bf\u03c5\u03bd\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 \u03bf\u03c1\u03b3\u03ac\u03bd\u03bf\u03c5 \u03b1\u03bd\u03bf\u03b9\u03c7\u03c4\u03bf\u03cd \u03ba\u03b1\u03c0\u03cc (VAG)",desc:"\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03ad\u03bb\u03bb\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b5\u03c0\u03af\u03bc\u03bf\u03bd\u03bf \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03b9\u03b7\u03c4\u03b9\u03ba\u03cc \u03ae\u03c7\u03bf \u03c4\u03bf\u03c5 \u03bf\u03c1\u03b3\u03ac\u03bd\u03bf\u03c5 \u03cc\u03c4\u03b1\u03bd \u03b7 \u03ba\u03bf\u03c5\u03ba\u03bf\u03cd\u03bb\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c0\u03b1\u03c3\u03c6\u03b1\u03bb\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7."},vag_emergency_brake_hazard:{name:"\u0391\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf \u03b1\u03bd\u03b1\u03b2\u03bf\u03c3\u03b2\u03ae\u03c3\u03b9\u03bc\u03bf \u03ba\u03b9\u03bd\u03b4\u03cd\u03bd\u03bf\u03c5 \u03c0\u03ad\u03b4\u03b7\u03c3\u03b7\u03c2 \u03ad\u03ba\u03c4\u03b1\u03ba\u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03b3\u03ba\u03b7\u03c2 (VAG)",desc:"\u0391\u03bd\u03b1\u03b2\u03bf\u03c3\u03b2\u03ae\u03bd\u03b5\u03b9 \u03b3\u03c1\u03ae\u03b3\u03bf\u03c1\u03b1 \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03ba\u03b9\u03bd\u03b4\u03cd\u03bd\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c3\u03ba\u03bb\u03b7\u03c1\u03ce\u03bd \u03c3\u03c4\u03ac\u03c3\u03b5\u03c9\u03bd \u03ad\u03ba\u03c4\u03b1\u03ba\u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03b3\u03ba\u03b7\u03c2 ABS."},vag_sunroof_comfort_open:{name:"\u039a\u03bb\u03af\u03c3\u03b7 \u03b7\u03bb\u03b9\u03bf\u03c1\u03bf\u03c6\u03ae\u03c2 / \u0386\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 \u03c4\u03b7\u03bb\u03b5\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03b7\u03c1\u03af\u03bf\u03c5 Comfort Key Fob Logic (VAG)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b1\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5 \u03ba\u03c1\u03b1\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03bb\u03ae\u03ba\u03c4\u03c1\u03c9\u03bd \u03b5\u03af\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03ba\u03bb\u03af\u03c3\u03b7 \u03b5\u03af\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03c0\u03bb\u03ae\u03c1\u03c9\u03c2 \u03b1\u03bd\u03bf\u03b9\u03c7\u03c4\u03ae \u03b7\u03bb\u03b9\u03bf\u03c1\u03bf\u03c6\u03ae."},bmw_ecopro_display_variant:{name:"\u03a3\u03c4\u03c5\u03bb \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd Cluster ECO PRO (BMW)",desc:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c4\u03bf \u03bc\u03c0\u03bb\u03b5 \u03b8\u03ad\u03bc\u03b1 \u03b3\u03c1\u03b1\u03c6\u03b9\u03ba\u03ce\u03bd \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7\u03c2 ECO PRO."},bmw_volume_bar_hud:{name:"\u0395\u03c0\u03b9\u03ba\u03ac\u03bb\u03c5\u03c8\u03b7 \u03b3\u03c1\u03b1\u03bc\u03bc\u03ae\u03c2 \u03ad\u03bd\u03c4\u03b1\u03c3\u03b7\u03c2 \u03ae\u03c7\u03bf\u03c5 Head-Up Display (BMW)",desc:"\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03c1\u03b1\u03bc\u03bc\u03ae \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03ad\u03bd\u03c4\u03b1\u03c3\u03b7\u03c2 \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae HUD."},bmw_anti_dazzle_mirror:{name:"\u0397\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03c7\u03c1\u03c9\u03bc\u03b9\u03ba\u03ae \u03b1\u03bd\u03c4\u03b9\u03b8\u03b1\u03bc\u03b2\u03c9\u03c4\u03b9\u03ba\u03ae \u03b5\u03c5\u03b1\u03b9\u03c3\u03b8\u03b7\u03c3\u03af\u03b1 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b7 (BMW)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03ba\u03b1\u03c4\u03ce\u03c6\u03bb\u03b9 \u03c4\u03bf\u03c5 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf\u03c5 \u03c6\u03c9\u03c4\u03bf\u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c0\u03c4\u03b7."},bmw_camera_pdc_warning_mute:{name:"\u03a1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03b1\u03c0\u03bf\u03ba\u03bf\u03c0\u03ae\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 PDC & Surround View (BMW)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03cc\u03c1\u03b9\u03bf \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c3\u03c4\u03bf \u03bf\u03c0\u03bf\u03af\u03bf \u03c3\u03b2\u03ae\u03bd\u03bf\u03c5\u03bd \u03bf\u03b9 \u03ba\u03ac\u03bc\u03b5\u03c1\u03b5\u03c2 \u03c3\u03c4\u03ac\u03b8\u03bc\u03b5\u03c5\u03c3\u03b7\u03c2."},toyota_pcs_distance_preset:{name:"\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7 \u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03c1\u03b9\u03bd \u03b1\u03c0\u03cc \u03c4\u03b7 \u03c3\u03cd\u03b3\u03ba\u03c1\u03bf\u03c5\u03c3\u03b7 (PCS) (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03b5\u03c5\u03b1\u03b9\u03c3\u03b8\u03b7\u03c3\u03af\u03b1 \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03c1\u03b1\u03bd\u03c4\u03ac\u03c1 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b1 \u03b5\u03bc\u03c0\u03c1\u03cc\u03c2."},toyota_bsm_timing:{name:"\u03a0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03b9\u03b7\u03c4\u03b9\u03ba\u03cc\u03c2 \u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b7\u03c2 \u03c4\u03c5\u03c6\u03bb\u03bf\u03cd \u03c3\u03b7\u03bc\u03b5\u03af\u03bf\u03c5 (BSM) (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc \u03c4\u03bf\u03c5 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03b9\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd \u03c4\u03bf\u03c5 \u03c0\u03bb\u03b5\u03c5\u03c1\u03b9\u03ba\u03bf\u03cd \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b7 \u03c3\u03c4\u03bf \u03c4\u03c5\u03c6\u03bb\u03cc \u03c3\u03b7\u03bc\u03b5\u03af\u03bf."},toyota_ac_noise_reduction:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03bc\u03b5\u03af\u03c9\u03c3\u03b7\u03c2 \u03b8\u03bf\u03c1\u03cd\u03b2\u03bf\u03c5 \u03b1\u03bd\u03b5\u03bc\u03b9\u03c3\u03c4\u03ae\u03c1\u03b1 \u03c3\u03c5\u03bc\u03c0\u03b9\u03b5\u03c3\u03c4\u03ae A/C (Toyota)",desc:"\u03a0\u03b5\u03c1\u03b9\u03bf\u03c1\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7 \u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 \u03b1\u03bd\u03b5\u03bc\u03b9\u03c3\u03c4\u03ae\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03b1\u03bd\u03b5\u03bc\u03b9\u03c3\u03c4\u03ae\u03c1\u03b1 \u03ba\u03bb\u03b9\u03bc\u03b1\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd \u03b3\u03b9\u03b1 \u03b7\u03c3\u03c5\u03c7\u03af\u03b1 \u03c3\u03c4\u03b7\u03bd \u03ba\u03b1\u03bc\u03c0\u03af\u03bd\u03b1."},toyota_sflow_control:{name:"S-Flow Smart Climate \u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b3\u03b9\u03b1 \u03ad\u03bd\u03b1\u03bd \u03b5\u03c0\u03b9\u03b2\u03ac\u03c4\u03b7 (Toyota)",desc:"\u039a\u03b1\u03c4\u03b5\u03c5\u03b8\u03cd\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03c1\u03bf\u03ae \u03b1\u03ad\u03c1\u03b1 A/C \u03b1\u03c0\u03bf\u03ba\u03bb\u03b5\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03c3\u03b5 \u03ba\u03b1\u03c4\u03b5\u03b9\u03bb\u03b7\u03bc\u03bc\u03ad\u03bd\u03b1 \u03ba\u03b1\u03b8\u03af\u03c3\u03bc\u03b1\u03c4\u03b1 \u03bc\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2 \u03b2\u03ac\u03c1\u03bf\u03c5\u03c2."},toyota_relock_timeout:{name:"\u03a7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7\u03c2 \u03ba\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7\u03c2 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7\u03c2 \u03b5\u03c0\u03b1\u03bd\u03b1\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03b1\u03c0\u03bf\u03bc\u03b1\u03ba\u03c1\u03c5\u03c3\u03bc\u03ad\u03bd\u03bf \u03be\u03b5\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 (Toyota)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03b4\u03b5\u03c5\u03c4\u03b5\u03c1\u03cc\u03bb\u03b5\u03c0\u03c4\u03b1 \u03c0\u03c1\u03b9\u03bd \u03b1\u03c0\u03cc \u03c4\u03bf \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf \u03b5\u03c0\u03b1\u03bd\u03b1\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03c4\u03c9\u03bd \u03b8\u03c5\u03c1\u03ce\u03bd \u03b5\u03ac\u03bd \u03b4\u03b5\u03bd \u03b1\u03bd\u03bf\u03af\u03be\u03b5\u03b9 \u03ba\u03b1\u03bc\u03af\u03b1 \u03c0\u03cc\u03c1\u03c4\u03b1 (30s-120s)."},lexus_mark_levinson_audio_profile:{name:"Mark Levinson Surround Sound DSP Audio Profile (Lexus)",desc:"\u0392\u03b5\u03bb\u03c4\u03b9\u03c3\u03c4\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03bf\u03bd \u03c4\u03c1\u03b9\u03c3\u03b4\u03b9\u03ac\u03c3\u03c4\u03b1\u03c4\u03bf \u03c7\u03c9\u03c1\u03b9\u03ba\u03cc \u03b1\u03ba\u03bf\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03c3\u03c5\u03bd\u03c4\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc \u03b3\u03b9\u03b1 \u03c4\u03b1 premium \u03b7\u03c7\u03b5\u03af\u03b1 Mark Levinson."},lexus_ev_mode_beeper_mute:{name:"\u03a3\u03af\u03b3\u03b1\u03c3\u03b7 \u03b2\u03bf\u03bc\u03b2\u03b7\u03c4\u03ae \u03b1\u03ba\u03bf\u03c5\u03c3\u03c4\u03b9\u03ba\u03ae\u03c2 \u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03b3\u03b9\u03b1 \u03c0\u03b5\u03b6\u03bf\u03cd\u03c2 \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 EV (Lexus)",desc:"\u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03ad\u03bb\u03bb\u03b5\u03b9 \u03c4\u03bf \u03c3\u03c5\u03bd\u03b8\u03b5\u03c4\u03b9\u03ba\u03cc \u03b5\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03cc \u03ba\u03bf\u03c5\u03b4\u03bf\u03cd\u03bd\u03b9\u03c3\u03bc\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ae\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2."},lexus_easy_access_seat:{name:"\u03a4\u03b9\u03bc\u03cc\u03bd\u03b9 \u03b5\u03cd\u03ba\u03bf\u03bb\u03b7\u03c2 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03c1\u03cc\u03bc\u03b5\u03bd\u03b7 \u03c0\u03bb\u03ac\u03c4\u03b7 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03bf\u03cd \u03ba\u03b1\u03b8\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 (Lexus)",desc:"\u03a3\u03cd\u03c1\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03bb\u03ac\u03c4\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03b1\u03b8\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 \u03bf\u03b4\u03b7\u03b3\u03bf\u03cd \u03ba\u03b1\u03b9 \u03b3\u03ad\u03c1\u03bd\u03b5\u03b9 \u03c4\u03bf \u03c4\u03b9\u03bc\u03cc\u03bd\u03b9 \u03bc\u03b1\u03ba\u03c1\u03b9\u03ac \u03b3\u03b9\u03b1 \u03b5\u03cd\u03ba\u03bf\u03bb\u03b7 \u03b5\u03af\u03c3\u03bf\u03b4\u03bf/\u03ad\u03be\u03bf\u03b4\u03bf."},nissan_epower_regen_mode:{name:"e-POWER One-Pedal Regenerative Braking Mode (Nissan)",desc:"\u039f\u03c1\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03b5\u03c0\u03af\u03c0\u03b5\u03b4\u03bf \u03b5\u03c0\u03b9\u03b2\u03c1\u03ac\u03b4\u03c5\u03bd\u03c3\u03b7\u03c2 \u03c0\u03ad\u03b4\u03b7\u03c3\u03b7\u03c2 \u03bc\u03b5 \u03b1\u03bd\u03ac\u03ba\u03c4\u03b7\u03c3\u03b7 e-Pedal."},nissan_propilot_assist_timing:{name:"ProPILOT Lane Centering Assist Steering Sensitivity (Nissan)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03c5\u03ba\u03c1\u03af\u03bd\u03b5\u03b9\u03b1 \u03c0\u03b1\u03c1\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd ProPILOT."},nissan_intelligent_around_view:{name:"\u0391\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf \u03b1\u03bd\u03b1\u03b4\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf \u03c0\u03b1\u03c1\u03ac\u03b8\u03c5\u03c1\u03bf \u03bf\u03b8\u03cc\u03bd\u03b7\u03c2 \u03b3\u03cd\u03c1\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae \u03c3\u03b5 \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 (Nissan)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 \u03ba\u03ac\u03bc\u03b5\u03c1\u03b1\u03c2 360 \u03bc\u03bf\u03b9\u03c1\u03ce\u03bd \u03cc\u03c4\u03b1\u03bd \u03bf\u03b9 \u03bc\u03c0\u03c1\u03bf\u03c3\u03c4\u03b9\u03bd\u03bf\u03af \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2 \u03c3\u03c4\u03ac\u03b8\u03bc\u03b5\u03c5\u03c3\u03b7\u03c2 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03bf\u03c5\u03bd \u03b5\u03bc\u03c0\u03cc\u03b4\u03b9\u03b1."},mazda_g_vectoring_display:{name:"G-Vectoring Control Plus Dynamic Visualizer (Mazda)",desc:"\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03b3\u03c1\u03ac\u03c6\u03b7\u03bc\u03b1 \u03b4\u03b9\u03b1\u03bd\u03c5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae\u03c2 \u03c1\u03bf\u03c0\u03ae\u03c2 \u03c3\u03c4\u03c1\u03ad\u03c8\u03b7\u03c2 GVC+ \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03cc\u03bd\u03bf \u03c3\u03c4\u03bf\u03bd \u03c0\u03af\u03bd\u03b1\u03ba\u03b1 \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd."},mazda_ieloop_capacitor_monitor:{name:"\u039c\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae\u03c2 \u03c0\u03c5\u03ba\u03bd\u03c9\u03c4\u03ae \u03b1\u03bd\u03ac\u03ba\u03c4\u03b7\u03c3\u03b7\u03c2 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1\u03c2 \u03c0\u03ad\u03b4\u03b7\u03c3\u03b7\u03c2 i-ELOOP (Mazda)",desc:"\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03ba\u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7\u03c2 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03bf\u03cd \u03c0\u03c5\u03ba\u03bd\u03c9\u03c4\u03ae \u03c3\u03c4\u03b7\u03bd \u03ba\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ae \u03bf\u03b8\u03cc\u03bd\u03b7."},mazda_smart_city_brake_sens:{name:"\u0395\u03c5\u03b1\u03b9\u03c3\u03b8\u03b7\u03c3\u03af\u03b1 Smart City Brake Support (SCBS) (Mazda)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03b5\u03cd\u03c1\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03c0\u03ad\u03b4\u03b7\u03c3\u03b7\u03c2 \u03ad\u03ba\u03c4\u03b1\u03ba\u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03b3\u03ba\u03b7\u03c2 \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2."},subaru_eyesight_distance_preset:{name:"\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7 EyeSight Adaptive Cruise Control (Subaru)",desc:"\u0394\u03b9\u03b1\u03bc\u03bf\u03c1\u03c6\u03ce\u03bd\u03b5\u03b9 \u03c4\u03bf \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03c0\u03c1\u03bf\u03c6\u03af\u03bb cruise gap \u03c3\u03c4\u03b5\u03c1\u03b5\u03bf\u03c6\u03c9\u03bd\u03b9\u03ba\u03ae\u03c2 \u03ba\u03ac\u03bc\u03b5\u03c1\u03b1\u03c2 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7."},subaru_xmode_auto_engage:{name:"\u039a\u03b1\u03c4\u03ce\u03c6\u03bb\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7\u03c2 \u03b5\u03bc\u03c0\u03bb\u03bf\u03ba\u03ae\u03c2 \u03ad\u03bb\u03be\u03b7\u03c2 \u03b5\u03ba\u03c4\u03cc\u03c2 \u03b4\u03c1\u03cc\u03bc\u03bf\u03c5 X-Mode (Subaru)",desc:"\u039f\u03c1\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03cc\u03c1\u03b9\u03bf \u03bf\u03bb\u03af\u03c3\u03b8\u03b7\u03c3\u03b7\u03c2 \u03c4\u03c1\u03bf\u03c7\u03bf\u03cd \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 X-Mode \u03b4\u03b9\u03c0\u03bb\u03ae\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2."},subaru_steering_responsive_headlights:{name:"\u0395\u03bd\u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7\u03c2 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd (SRH) (Subaru)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03ae \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b5\u03c5\u03b8\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03c4\u03b9\u03ba\u03ae \u03c0\u03b5\u03c1\u03b9\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03c9\u03bd."},genesis_sport_plus_mode:{name:"Sport+ Powertrain & \u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03b1\u03bd\u03ac\u03c1\u03c4\u03b7\u03c3\u03b7\u03c2 (Genesis)",desc:"\u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c4\u03bf ESC OFF \u03c0\u03c1\u03bf\u03c3\u03b1\u03bd\u03b1\u03c4\u03bf\u03bb\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03c3\u03c4\u03b7\u03bd \u03c4\u03c1\u03bf\u03c7\u03b9\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b7 \u03c7\u03b1\u03c1\u03c4\u03bf\u03b3\u03c1\u03ac\u03c6\u03b7\u03c3\u03b7 \u03ac\u03ba\u03b1\u03bc\u03c0\u03c4\u03bf\u03c5 \u03b1\u03c0\u03bf\u03c3\u03b2\u03b5\u03c3\u03c4\u03ae\u03c1\u03b1."},genesis_ambient_active_light:{name:"\u0395\u03bd\u03b5\u03c1\u03b3\u03cc\u03c2 \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 \u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03c3\u03c5\u03b3\u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 (Genesis)",desc:"\u0391\u03bb\u03bb\u03ac\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c7\u03c1\u03ce\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03bf\u03cd \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ac \u03bc\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03c4\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2."},volvo_city_safety_warning:{name:"\u03a0\u03cc\u03bb\u03b7 Safety Autonomous Emergency Warning Sensitivity (Volvo)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03c3\u03cd\u03b3\u03ba\u03c1\u03bf\u03c5\u03c3\u03b7\u03c2 \u03c1\u03b1\u03bd\u03c4\u03ac\u03c1 \u03ba\u03b1\u03b9 lidar (\u03a0\u03c1\u03ce\u03b9\u03bc\u03b7/\u039a\u03b1\u03bd\u03bf\u03bd\u03b9\u03ba\u03ae)."},chery_ar_navigation_hud:{name:"\u0395\u03c0\u03b9\u03ba\u03ac\u03bb\u03c5\u03c8\u03b7 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae\u03c2 \u03c0\u03bb\u03bf\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 AR \u03c3\u03b5 HUD (Chery)",desc:"\u03a0\u03c1\u03bf\u03b2\u03ac\u03bb\u03bb\u03b5\u03b9 \u03b2\u03ad\u03bb\u03b7 \u03c0\u03bb\u03bf\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 3D \u03b5\u03c0\u03b1\u03c5\u03be\u03b7\u03bc\u03ad\u03bd\u03b7\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf \u03c0\u03b1\u03c1\u03bc\u03c0\u03c1\u03af\u03b6."},jlr_terrain_response_preset:{name:"\u0391\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03b5\u03ba\u03c4\u03cc\u03c2 \u03b4\u03c1\u03cc\u03bc\u03bf\u03c5 \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7\u03c2 \u03b5\u03b4\u03ac\u03c6\u03bf\u03c5\u03c2 (JLR)",desc:"\u0398\u03c5\u03bc\u03ac\u03c4\u03b1\u03b9 \u03c4\u03bf \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf \u03c0\u03c1\u03bf\u03c6\u03af\u03bb \u03b5\u03c0\u03b9\u03c6\u03ac\u03bd\u03b5\u03b9\u03b1\u03c2 \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7\u03c2 \u03b5\u03b4\u03ac\u03c6\u03bf\u03c5\u03c2 (\u03b3\u03c1\u03b1\u03c3\u03af\u03b4\u03b9/\u03c7\u03b1\u03bb\u03af\u03ba\u03b9/\u03c7\u03b9\u03cc\u03bd\u03b9)."},jlr_adaptive_dynamics_firm:{name:"\u03a0\u03c1\u03bf\u03c6\u03af\u03bb \u03c3\u03c4\u03b1\u03b8\u03b5\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03bf\u03cd \u03b1\u03c0\u03bf\u03c3\u03b2\u03b5\u03c3\u03c4\u03ae\u03c1\u03b1 (JLR)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03b1\u03ba\u03b1\u03bc\u03c8\u03af\u03b1 \u03b1\u03c0\u03cc\u03c3\u03b2\u03b5\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03bf\u03cd \u03b1\u03bc\u03bf\u03c1\u03c4\u03b9\u03c3\u03ad\u03c1."},jlr_wading_sensor_alert:{name:"\u039a\u03b1\u03c4\u03ce\u03c6\u03bb\u03b9 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03b2\u03ac\u03b8\u03bf\u03c5\u03c2 Wade Sensing (JLR)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03c5\u03b1\u03b9\u03c3\u03b8\u03b7\u03c3\u03af\u03b1 \u03b7\u03c7\u03b7\u03c4\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03b2\u03ac\u03b8\u03bf\u03c5\u03c2 \u03bd\u03b5\u03c1\u03bf\u03cd \u03c5\u03c0\u03b5\u03c1\u03ae\u03c7\u03c9\u03bd."},alfa_dna_dynamic_memory:{name:"Alfa DNA Selector Dynamic Mode Startup Memory (Alfa Romeo)",desc:"\u0394\u03b9\u03b1\u03c4\u03b7\u03c1\u03b5\u03af \u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7 \u03b3\u03ba\u03b1\u03b6\u03b9\u03bf\u03cd Dynamic mode \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7."},alfa_q4_torque_split:{name:"\u0393\u03c1\u03ac\u03c6\u03b7\u03bc\u03b1 \u03b4\u03b9\u03b1\u03af\u03c1\u03b5\u03c3\u03b7\u03c2 \u03c1\u03bf\u03c0\u03ae\u03c2 \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03cc\u03bd\u03bf Q4 All-Wheel Drive (Alfa Romeo)",desc:"\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c0\u03bf\u03c3\u03bf\u03c3\u03c4\u03cc \u03ba\u03b1\u03c4\u03b1\u03bd\u03bf\u03bc\u03ae\u03c2 \u03b9\u03c3\u03c7\u03cd\u03bf\u03c2 AWD \u03b5\u03bc\u03c0\u03c1\u03cc\u03c2/\u03c0\u03af\u03c3\u03c9 \u03c3\u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd."},li_auto_range_extender_mode:{name:"\u0395\u03c0\u03af\u03c0\u03b5\u03b4\u03bf \u03b4\u03b9\u03b1\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7\u03c2 \u03c6\u03cc\u03c1\u03c4\u03b9\u03c3\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 \u03b3\u03b5\u03bd\u03bd\u03ae\u03c4\u03c1\u03b9\u03b1\u03c2 REV (Li Auto)",desc:"\u03a1\u03c5\u03b8\u03bc\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03ba\u03b1\u03c4\u03ce\u03c6\u03bb\u03b9 \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03b3\u03b5\u03bd\u03bd\u03ae\u03c4\u03c1\u03b9\u03b1\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03cd\u03c3\u03b7\u03c2."},li_auto_cinema_seat_position:{name:"\u0395\u03c1\u03b3\u03bf\u03bd\u03bf\u03bc\u03b9\u03ba\u03ae \u0398\u03ad\u03c3\u03b7 \u039a\u03b1\u03b8\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2 \u0398\u03ad\u03b1\u03c4\u03c1\u03bf\u03c5/\u039a\u03b9\u03bd\u03b7\u03bc\u03b1\u03c4\u03bf\u03b3\u03c1\u03ac\u03c6\u03bf\u03c5 (Li Auto)",desc:"\u0391\u03bd\u03b1\u03ba\u03bb\u03af\u03bd\u03b5\u03b9 \u03c4\u03b1 \u03c0\u03af\u03c3\u03c9 \u03ba\u03b1\u03b8\u03af\u03c3\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03be\u03b5\u03b4\u03b9\u03c0\u03bb\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b1 \u03c3\u03c4\u03b7\u03c1\u03af\u03b3\u03bc\u03b1\u03c4\u03b1 \u03c0\u03bf\u03b4\u03b9\u03ce\u03bd \u03cc\u03c4\u03b1\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03bd\u03b5\u03c1\u03b3\u03ae \u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ba\u03b9\u03bd\u03b7\u03bc\u03b1\u03c4\u03bf\u03b3\u03c1\u03ac\u03c6\u03bf\u03c5."},zeekr_drift_mode_torque:{name:"Dual Motor Performance Drift Mode Rear Bias (Zeekr)",desc:"\u03a3\u03c4\u03ad\u03bb\u03bd\u03b5\u03b9 100% \u03c1\u03bf\u03c0\u03ae \u03c3\u03c4\u03bf\u03bd \u03c0\u03af\u03c3\u03c9 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b3\u03b9\u03b1 \u03b5\u03bb\u03b5\u03b3\u03c7\u03cc\u03bc\u03b5\u03bd\u03b7 \u03bf\u03bb\u03af\u03c3\u03b8\u03b7\u03c3\u03b7."},zeekr_ambient_beat_sync:{name:"Ambient Lighting Music Rhythm Beat Sync (Zeekr)",desc:"\u03a0\u03b1\u03bb\u03bb\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03cc \u03c6\u03c9\u03c4\u03b9\u03c3\u03bc\u03cc \u03c4\u03b7\u03c2 \u03ba\u03b1\u03bc\u03c0\u03af\u03bd\u03b1\u03c2 \u03c3\u03b5 \u03c3\u03c5\u03b3\u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc \u03bc\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03c1\u03c5\u03b8\u03bc\u03bf\u03cd\u03c2 \u03bc\u03bf\u03c5\u03c3\u03b9\u03ba\u03ae\u03c2 \u03c0\u03bf\u03c5 \u03c0\u03b1\u03af\u03b6\u03b5\u03c4\u03b1\u03b9."},tata_drive_mode_voice:{name:"\u03a6\u03c9\u03bd\u03b7\u03c4\u03b9\u03ba\u03ae \u03b1\u03bd\u03b1\u03ba\u03bf\u03af\u03bd\u03c9\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 Drive (Tata)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7\u03bd \u03b7\u03c7\u03b7\u03c4\u03b9\u03ba\u03ae \u03c6\u03c9\u03bd\u03b7\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03af\u03c9\u03c3\u03b7 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03bd\u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03c4\u03c9\u03bd \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b9\u03ce\u03bd \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 (City/Sport/Eco)."},mahindra_zip_zap_zoom_custom:{name:"\u03a0\u03c1\u03bf\u03c6\u03af\u03bb \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7\u03c2 \u03b3\u03ba\u03b1\u03b6\u03b9\u03bf\u03cd Zip/Zap/Zoom (Mahindra)",desc:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03ba\u03b1\u03bc\u03c0\u03cd\u03bb\u03b7 \u03b5\u03c0\u03b9\u03c4\u03ac\u03c7\u03c5\u03bd\u03c3\u03b7\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 Zip, Zap \u03ba\u03b1\u03b9 Zoom."},fun_cyberpunk_cluster_theme:{name:"\u0398\u03ad\u03bc\u03b1 Cyberpunk 2077 Neon Graphic Cockpit",desc:"\u0395\u03c6\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c6\u03bf\u03c5\u03c4\u03bf\u03c5\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03bd\u03ad\u03bf\u03bd \u03ba\u03c5\u03b1\u03bd\u03cc \u03ba\u03b1\u03b9 \u03c0\u03bf\u03c1\u03c4\u03bf\u03ba\u03b1\u03bb\u03af \u03c8\u03b7\u03c6\u03b9\u03b1\u03ba\u03cc \u03c3\u03c4\u03c5\u03bb \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae \u03c4\u03b1\u03bc\u03c0\u03bb\u03cc."},fun_exhaust_flame_sound_effect:{name:"\u03a3\u03c4\u03b5\u03c1\u03b5\u03bf\u03c6\u03c9\u03bd\u03b9\u03ba\u03cc \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 Pop & Bang Exhaust Sound FX",desc:"\u03a0\u03b1\u03af\u03b6\u03b5\u03b9 \u03c1\u03b5\u03b1\u03bb\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03b7\u03c7\u03b7\u03c4\u03b9\u03ba\u03ac \u03b5\u03c6\u03ad pop & bang \u03b5\u03be\u03ac\u03c4\u03bc\u03b9\u03c3\u03b7\u03c2 V8 \u03bc\u03ad\u03c3\u03c9 \u03c4\u03c9\u03bd \u03b7\u03c7\u03b5\u03af\u03c9\u03bd \u03ba\u03b1\u03bc\u03c0\u03af\u03bd\u03b1\u03c2."},fun_matrix_light_show_welcome:{name:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03bc\u03ad\u03bd\u03bf Headlight Matrix LED Dance Welcome",desc:"\u03a0\u03b1\u03af\u03b6\u03b5\u03b9 \u03c1\u03c5\u03b8\u03bc\u03b9\u03ba\u03ae \u03c7\u03bf\u03c1\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 Light Show \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03b5\u03af\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bd\u03b4\u03b5\u03af\u03be\u03b5\u03b9\u03c2."},fun_stealth_fighter_display:{name:"Stealth Fighter Night Driving Minimalist Cluster Mode",desc:"\u03a3\u03b2\u03ae\u03bd\u03b5\u03b9 \u03cc\u03bb\u03b1 \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03c3\u03c5\u03bc\u03c0\u03bb\u03ad\u03b3\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b5\u03ba\u03c4\u03cc\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c4\u03b1\u03c7\u03cd\u03bc\u03b5\u03c4\u03c1\u03bf \u03b3\u03b9\u03b1 \u03bc\u03b1\u03cd\u03c1\u03b7 \u03bd\u03c5\u03c7\u03c4\u03b5\u03c1\u03b9\u03bd\u03ae \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7."},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{name:"Retarder & Jake Brake Downshift Aggressiveness",desc:"Adjusts retarder torque blending curve and automatic transmission downshifting response under braking."},man_ecas_dock_level_memory:{name:"ECAS Air Suspension Loading Dock Height Memory",desc:"Stores and recalls customized pneumatic air suspension height level presets for loading docks."},daf_stationary_dpf_regen_trigger:{name:"Stationary DPF Forced Soot Regeneration",desc:"Initiates stationary diesel particulate filter thermal soot burn routine in parked position."},ford_trucks_reverse_buzzer_night_mode:{name:"Reverse Acoustic Alarm Night Quiet Mode",desc:"Attenuates reverse backup horn alarm volume for quiet night distribution in residential areas."},cummins_ecm_fleet_speed_limiter:{name:"Cummins Engine Road Speed Limiter (RSL)",desc:"Programs maximum allowable road vehicle speed in Cummins ECM parameter tables."}},codeBtn:"\u039a\u03a9\u0394\u0399\u039a\u039f\u03a0\u039f\u0399\u0397\u03a3\u0397",removeBtn:"\u0391\u03a6\u0391\u0399\u03a1\u0395\u03a3\u0397",unsupportedTitle:"\u039c\u03b7 \u03a5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03b9\u03b6\u03cc\u03bc\u03b5\u03bd\u03bf \u038c\u03c7\u03b7\u03bc\u03b1",unsupportedMsg:"\u0391\u03c5\u03c4\u03ae \u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b4\u03b5\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03bf ECU \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03cc\u03c2 \u03c3\u03b1\u03c2.",layoutChart:"\u0393\u03a1\u0391\u03a6\u0397\u039c\u0391",selectBrand:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u0395\u03c0\u03c9\u03bd\u03c5\u03bc\u03af\u03b1 \u039f\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2",selectCategory:"\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u039a\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1",selectMakeTitle:"\u0395\u03a0\u0399\u039b\u0395\u039e\u03a4\u0395 \u039c\u0391\u03a1\u039a\u0391 \u039f\u03a7\u0397\u039c\u0391\u03a4\u039f\u03a3",selectCategoryTitle:"\u0395\u03a0\u0399\u039b\u039f\u0393\u0397 \u039a\u0391\u03a4\u0397\u0393\u039f\u03a1\u0399\u0391\u03a3 \u03a7\u0391\u03a1\u0391\u039a\u03a4\u0397\u03a1\u0399\u03a3\u03a4\u0399\u039a\u03a9\u039d",brandAll:"\u039f\u039b\u0391 \u039a\u0391\u039d\u039f\u03a5\u039d",categoryAll:"\u039f\u039b\u0395\u03a3 \u03a4\u0399\u03a3 \u039a\u0391\u03a4\u0397\u0393\u039f\u03a1\u0399\u0395\u03a3",lighting:"\u03a6\u03a9\u03a4\u0399\u03a3\u039c\u039f\u03a3",soundAlerts:"\u0397\u03a7\u0397\u03a4\u0399\u039a\u0395\u03a3 \u0395\u0399\u0394\u039f\u03a0\u039f\u0399\u0397\u03a3\u0395\u0399\u03a3",displayInstrument:"\u039f\u0398\u039f\u039d\u0397 / \u039f\u039c\u03a0\u0399\u0394\u0391",drivingComfort:"\u0391\u039d\u0395\u03a3\u0397 \u039f\u0394\u0397\u0393\u0397\u03a3\u0397\u03a3",securitySafety:"\u0391\u03a3\u03a6\u0391\u039b\u0395\u0399\u0391 & \u0391\u03a3\u03a6\u0391\u039b\u0395\u0399\u0391",restoreBtn:"\u0391\u03a0\u039f\u039a\u0391\u03a4\u0391\u03a3\u03a4\u0391\u03a3\u0397 \u0395\u03a1\u0393\u039f\u03a3\u03a4\u0391\u03a3\u0399\u0391\u03a3 \u039a\u0391\u03a4\u0391\u03a3\u03a4\u0391\u03a3\u0397\u03a3",searchPlaceholder:"\u0394\u03c5\u03bd\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7\u03c2, DID \u03ae ECU \u03c3\u03c4\u03cc\u03c7\u03bf\u03c5...",restoreSuccessTitle:"\u0391\u03c0\u03bf\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ac\u03b8\u03b7\u03ba\u03b5 \u03b7 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03b5\u03c1\u03b3\u03bf\u03c3\u03c4\u03b1\u03c3\u03af\u03bf\u03c5",restoreSuccessMsg:"\u03a4\u03bf \u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ad\u03c7\u03b5\u03b9 \u03b5\u03c0\u03b1\u03bd\u03ad\u03bb\u03b8\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 DID.",cloneLockedBanner:" \u0395\u03bd\u03c4\u03bf\u03c0\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1\u03c2 \u03ba\u03bb\u03ce\u03bd\u03bf\u03c5 \u2014 \u039a\u03bb\u03b5\u03b9\u03b4\u03c9\u03bc\u03ad\u03bd\u03b7 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 (\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03bc\u03cc\u03bd\u03bf \u03b3\u03b9\u03b1 \u03b1\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7)",cloneAlertTitle:" \u0391\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03c4\u03b7\u03ba\u03b5 \u03bf \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1\u03c2 OBD2 \u03ba\u03bb\u03ce\u03bd\u03bf\u03c2",cloneAlertMsg:"\u039f \u03c3\u03c5\u03bd\u03b4\u03b5\u03b4\u03b5\u03bc\u03ad\u03bd\u03bf\u03c2 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1\u03c2 OBD2 \u03c3\u03b1\u03c2 \u03b5\u03c0\u03b9\u03c3\u03b7\u03bc\u03ac\u03bd\u03b8\u03b7\u03ba\u03b5 \u03c9\u03c2 \u03c0\u03bb\u03b1\u03c3\u03c4\u03cc\u03c2 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1\u03c2 \u03ba\u03bb\u03ce\u03bd\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03ad\u03c7\u03b5\u03b9 \u03b1\u03c5\u03c3\u03c4\u03b7\u03c1\u03ae \u03b1\u03ba\u03c1\u03af\u03b2\u03b5\u03b9\u03b1 \u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd \u03c0\u03bf\u03c5 \u03b1\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae ECU.\n\n\u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b7\u03b3\u03b7\u03b8\u03b5\u03af\u03c4\u03b5 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b1\u03bd\u03b1\u03b6\u03b7\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2, \u03b1\u03bb\u03bb\u03ac \u03bf\u03b9 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03bb\u03b5\u03b9\u03b4\u03c9\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c3\u03c4\u03b1\u03c3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03cc\u03c2 \u03c3\u03b1\u03c2. \u03a3\u03c5\u03bd\u03b4\u03ad\u03c3\u03c4\u03b5 \u03ad\u03bd\u03b1\u03bd \u03b3\u03bd\u03ae\u03c3\u03b9\u03bf \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1 ELM327 v2.1+ \u03ae vLinker \u03b3\u03b9\u03b1 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae.",riskLow:"\u03a7\u0391\u039c\u0397\u039b\u039f\u03a3 \u039a\u0399\u039d\u0394\u03a5\u039d\u039f\u03a3",riskMedium:"\u039c\u0395\u03a3\u0391\u0399\u039f\u03a5 \u039a\u0399\u039d\u0394\u03a5\u039d\u039f\u03a5",riskHigh:"\u03a5\u03a8\u0397\u039b\u039f\u03a5 \u039a\u0399\u039d\u0394\u03a5\u039d\u039f\u03a5",sfdProtected:"ECU \u03bc\u03b5 \u03c0\u03c1\u03bf\u03c3\u03c4\u03b1\u03c3\u03af\u03b1 SFD",legalDisclaimerUsLights:" \u03a3\u03b7\u03bc\u03b5\u03af\u03c9\u03c3\u03b7: \u03a4\u03b1 \u03c3\u03c5\u03bd\u03b5\u03c7\u03ae \u03c6\u03ce\u03c