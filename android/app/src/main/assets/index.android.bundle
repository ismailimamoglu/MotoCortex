1a0\ucf5c\uc774 \uc5f0\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucd5c\ub300 {{limit}}\uac1c\uc758 \uc13c\uc11c\ub97c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",customizeSubtitleCAN:"CAN-Bus \ud504\ub85c\ud1a0\ucf5c\uc774 \uc5f0\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucd5c\ub300 {{limit}}\uac1c\uc758 \uc13c\uc11c\ub97c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",unit:"\ub2e8\uc704",layoutChart:"\ucc28\ud2b8",adblue:"AdBlue \ub808\ubca8",egt:"\ubc30\uae30\uac00\uc2a4 \uc628\ub3c4",nox:"NOx \uc13c\uc11c \uac12",torque:"\uc5d4\uc9c4 \ud1a0\ud06c",selectedSensorsCount:"{{count}} / {{max}} \uc13c\uc11c \uc120\ud0dd\ub428",proSensorMsg:"Upgrade to PRO to unlock and monitor advanced live sensors."},expertise:{historyFound:"\ucc28\ub7c9 \uae30\ub85d\uc774 \ubc1c\uacac\ub418\uc5c8\uc2b5\ub2c8\ub2e4!",historyFoundDesc:"\uc774 \ucc28\ub7c9\uc758{{count}}\uae30\ub85d\uc774 \uc774\uc804\uc5d0 \uc0dd\uc131\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc544\ub798\uc5d0\uc11c \ub0b4\uc5ed\uc744 \uac80\ud1a0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",viewHistory:"\uc5ed\uc0ac \ubcf4\uae30 \u203a",manualVin:"\uc100\uc2dc \ubc88\ud638",manualVinDesc:"\ucc28\ub7c9 \ucef4\ud4e8\ud130\uac00 \uc100\uc2dc \ubc88\ud638\ub97c \uc790\ub3d9\uc73c\ub85c \uacf5\uc720\ud558\uc9c0 \uc54a\ub294 \uacbd\uc6b0 \uc5ec\uae30\uc5d0 \uc785\ub825\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",vinPlaceholder:"VIN\uc744 \uc785\ub825\ud558\uc138\uc694...",startScan:"\uc804\ubb38\uac00 \uc2a4\uce94 \uc2dc\uc791",scanning:"\uc2a4\uce94 \uc911...",vehicleIdentity:"\ucc28\ub7c9 ID \ubc0f \ub9c8\uc77c\ub9ac\uc9c0",vin:"\uc100\uc2dc \ubc88\ud638",odometer:"\uc624\ub9ac\uc9c0\ub110 KM",distSinceCleared:"\uc624\ub958\uac00 \ud574\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",milDist:"\uc5d4\uc9c4 \ub77c\uc774\ud2b8 \ucf1c\uc9d0",dtcTitle:"\uc624\ub958 \ucf54\ub4dc",dtcClean:"\uc624\ub958 \ucf54\ub4dc \uc5c6\uc74c - \uae68\ub057\ud568",extraActions:"\ucd94\uac00 \uac70\ub798",garageTitle:"\ucc28\uace0 \ubc0f \uacfc\uac70 \uae30\ub85d",share:"\uacf5\uc720",saveVehicle:"\uc774 \ub3c4\uad6c\ub97c \uc800\uc7a5\ud558\uc138\uc694",noRecords:"\uc544\uc9c1 \ub4f1\ub85d\ub41c \ucc28\ub7c9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.",clean:"\uae68\ub057\ud558\ub2e4",faults:"\uc2e4\ud328",vinRequired:"VIN \ud544\uc218",vinRequiredDesc:"\ub4f1\ub85d\ud558\ub824\uba74 \ucc28\ub300 \ubc88\ud638\uac00 \uc790\ub3d9\uc73c\ub85c \ub098\ud0c0\ub098\uac70\ub098 \uc218\ub3d9\uc73c\ub85c \uc785\ub825\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4.",missingInfo:"\ub204\ub77d\ub41c \uc815\ubcf4",missingInfoDesc:"\ube0c\ub79c\ub4dc \ubc0f \ubaa8\ub378 \ud544\ub4dc\ub97c \uc791\uc131\ud558\uc2ed\uc2dc\uc624.",saved:"\uc800\uc7a5\ub428",savedDesc:"\uc804\ubb38 \uc9c0\uc2dd\uc758 \uacb0\uacfc\ub85c \ucc28\uace0\uc5d0 \ucd94\uac00\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",connRequired:"\uc5f0\uacb0 \ud544\uc694",connRequiredDesc:"\uc774 \ud504\ub85c\uc138\uc2a4\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \ucc28\ub7c9\uc5d0 \uc5f0\uacb0\ud558\uc138\uc694.",chronicFaultsTitle:"\ud1b5\uacc4\uc801 \ub9cc\uc131 \ubb38\uc81c",chronicFaultsObs:"{{code}} (Observation: {{days}} Unique Days / Total: {{total}} Times)",chronicFaultsPending:"\ub370\uc774\ud130 \ud480 \uc218\uc9d1/\ud1b5\uacc4 \ubd84\uc11d",notScanned:"\uc2a4\uce94\ub418\uc9c0 \uc54a\uc74c",notScannedDesc:"\uc9c4\ub2e8 \ucf54\ub4dc\ub97c \uc77d\uc73c\ub824\uba74 \uc624\ub978\ucabd \uc0c1\ub2e8\uc758 \uc2a4\uce94 \ubc84\ud2bc\uc744 \ub204\ub974\uc2ed\uc2dc\uc624.",scanFailed:"\uc2a4\uce94 \uc2e4\ud328",errTimeout:"Error: Connection Timeout\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error\nECU trouble codes could not be read.",scannedSystems:"\uc2a4\uce94\ub41c \uc2dc\uc2a4\ud15c",moduleEngine:"\uc5d4\uc9c4 \uc81c\uc5b4 \uc7a5\uce58",moduleAbs:"\uc7a0\uae40 \ubc29\uc9c0 \uc81c\ub3d9 \uc2dc\uc2a4\ud15c",moduleTcm:"\ubcc0\uc18d\uae30 \uc81c\uc5b4 \ubaa8\ub4c8",moduleBcm:"\ucc28\uccb4 \uc81c\uc5b4 \ubaa8\ub4c8",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:"\ubcf4\uc548 \uacbd\uace0",safetyWarningDesc:"\uc774 \uacfc\uc815\uc5d0\uc11c: \u2022 \uc810\ud654\uac00 \ucf1c\uc838 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. \u2022 \uc5d4\uc9c4\uc774 \uaebc\uc838 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. \u2022 \ucc28\ub7c9 \uc2dc\ub3d9\uc744 \uac78\uc9c0 \ub9c8\uc138\uc694. \uacc4\uc18d\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",step1:"1\ub2e8\uacc4: \uc624\ub958 \ucf54\ub4dc \uc9c0\uc6b0\uae30",step1Desc:"\uc800\uc7a5\ub41c \ubaa8\ub4e0 \uc624\ub958 \ucf54\ub4dc\uc640 \uc5d4\uc9c4 \uc810\uac80 \ud45c\uc2dc\ub4f1\uc774 \uc9c0\uc6cc\uc9d1\ub2c8\ub2e4. \uc5f0\ub8cc \ud2b8\ub9bc \uac12\uc774 \uc7ac\uc124\uc815\ub429\ub2c8\ub2e4. \uc774 \uc791\uc5c5\uc740 \ucde8\uc18c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4!",step2:"2\ub2e8\uacc4: ECU \ud558\ub4dc \ub9ac\uc14b",step2Desc:"\uc804\uae30\uc801 \uc7ac\uc124\uc815\uc774 \uc5d4\uc9c4 \ucef4\ud4e8\ud130\ub85c \uc804\uc1a1\ub429\ub2c8\ub2e4. \uc774\ub294 \ubc30\ud130\ub9ac\ub97c \uc81c\uac70\ud558\uace0 \uc124\uce58\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ube44\uc9c0\uc6d0 ECU\uc5d0\uc11c\ub294 \ud6a8\uacfc\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \ud574\ub97c \ub07c\uce58 \uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",clearCodes:"\ucf54\ub4dc \uc0ad\uc81c",ecuReset:"\uc624\ub958 \ucf54\ub4dc \uc9c0\uc6b0\uae30",finish:"\uac74\ub108\ub6f0\uae30",completed:"\uc644\ub8cc\ub428",completedDesc:"\uc11c\ube44\uc2a4 \uc791\uc5c5\uc774 \uc131\uacf5\uc801\uc73c\ub85c \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucc28\ub7c9\uc744 \ub2e4\uc2dc \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",hardResetDesc:"\ubaa8\ub4e0 \uc11c\ube44\uc2a4 \uc791\uc5c5\uc774 \uc131\uacf5\uc801\uc73c\ub85c \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \u2022 \uc624\ub958 \ucf54\ub4dc\uac00 \uc0ad\uc81c\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \u2022 \uc5f0\ub8cc \ud2b8\ub9bc \uc7ac\uc124\uc815 \u2022 ECU \ub9ac\uc14b \ucc28\ub7c9\uc744 \ub2e4\uc2dc \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},info:{desc:"\uc804\ubb38 \uc624\ud1a0\ubc14\uc774 \ubc0f \ucc28\ub7c9 \uc9c4\ub2e8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4. \ubaa8\ub4e0 \ucc28\ub7c9\uacfc \ud638\ud658\ub429\ub2c8\ub2e4.",upgrade:"Cortex OBD2 Diagnostic Scanner PRO\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc",upgradeAlert:"\uc55e\uc11c \ud574\ubcf4\uae30",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner\ub294 \ud604\uc7ac \uac1c\ubc1c \uc911\uc785\ub2c8\ub2e4. \uadc0\ud558\ub294 \ucd08\uae30 \uc0ac\uc6a9\uc790\uc774\ubbc0\ub85c \uc774\uc81c \ubaa8\ub4e0 Pro \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadc0\ud558\uc758 \ud53c\ub4dc\ubc31\uc740 \uc6b0\ub9ac\uc5d0\uac8c \ub9e4\uc6b0 \uc18c\uc911\ud569\ub2c8\ub2e4!",helpGuide:"\ub3c4\uc6c0\ub9d0 \ubc0f \uac00\uc774\ub4dc",language:"\uc5b8\uc5b4 / \uc5b8\uc5b4 / \ubc14\ud558\uc0ac\uc5b4",support:"\uc9c0\uc6d0 \uc13c\ud130",supportSubject:"Cortex OBD2 Diagnostic Scanner \uc9c0\uc6d0 \ubc0f \ud53c\ub4dc\ubc31",thanks:"\uac10\uc0ac\ud569\ub2c8\ub2e4!",thanksDesc:"\ud53c\ub4dc\ubc31\uc744 \ubcf4\ub0b4\uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4. Play \uc2a4\ud1a0\uc5b4\uc5d0 \ub313\uae00\uc744 \ub0a8\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",sections:{live:{title:"\uc2e4\uc2dc\uac04 \ubaa8\ub2c8\ud130\ub9c1 \uc13c\uc11c",content:"RPM, \uc18d\ub3c4, \uc5d4\uc9c4 \uc628\ub3c4, \uc2a4\ub85c\ud2c0 \uc704\uce58, \ubc30\ud130\ub9ac \uc804\uc555, \uc5d4\uc9c4 \ubd80\ud558, \ud761\uae30 \uc628\ub3c4 \ubc0f \ub9e4\ub2c8\ud3f4\ub4dc \uc555\ub825\uc744 \uc989\uc2dc \ubaa8\ub2c8\ud130\ub9c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. Bluetooth \uc18d\ub3c4\uc5d0 \ub530\ub77c \uac12\uc740 \ucd08\ub2f9 1~5\ud68c \uc0c8\ub85c \uace0\uccd0\uc9d1\ub2c8\ub2e4. \ub2e8\ub9d0\uae30\ub97c \ud1b5\ud574 UDS/OBD \uba85\ub839\uc73c\ub85c \ucc28\ub7c9\uc5d0 \uc9c1\uc811 \uac1c\uc785\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},expertise:{title:"\uac80\uc0ac \ubc0f \ubcf4\uc99d",content:"\uc774 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc740 ECU \ucf54\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc624\ub958\ub97c \uac10\uc9c0\ud569\ub2c8\ub2e4. \ucc28\ub7c9\uc5d0 \uae30\ub85d\ub41c VIN \ubc88\ud638\uc640 \ud604\uc7ac \uc8fc\ud589\uac70\ub9ac\uac00 \ucea1\ucc98\ub429\ub2c8\ub2e4. \ub610\ud55c, \uacfc\uac70 \uc624\ub958\ub294 \uc5d4\uc9c4 \uc810\uac80 \ud45c\uc2dc\ub4f1\uc73c\ub85c \ucc28\ub7c9\uc774 \uc774\ub3d9\ud55c \uac70\ub9ac\ub97c \uacc4\uc0b0\ud558\uc5ec \uacb0\uc815\ub429\ub2c8\ub2e4. \uacb0\uacfc \ubcf4\uace0\uc11c\ub294 PDF \ubc0f \uba54\uc2dc\uc9d5 \ud658\uacbd\uc5d0\uc11c \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},tests:{title:"\ubc30\ud130\ub9ac/\uc131\ub2a5 \ud14c\uc2a4\ud2b8",content:"\ubc30\ud130\ub9ac \ud14c\uc2a4\ud2b8\ub294 3\ub2e8\uacc4\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \ud734\uc9c0, \ud06c\ub7ad\ud0b9, \uc720\ud734 \ucda9\uc804 \ud14c\uc2a4\ud2b8\ub294 \ubc30\ud130\ub9ac/\uc870\uc808\uae30 \uc0c1\ud0dc\ub97c \uce21\uc815\ud569\ub2c8\ub2e4. \uc131\ub2a5 \ud14c\uc2a4\ud2b8\ub294 \ud734\ub300\ud3f0 \ud504\ub85c\uc138\uc11c\uc640 \ucc28\ub7c9\uc758 \uc21c\uac04 \uc18d\ub3c4 \ub370\uc774\ud130\ub97c \uc0ac\uc6a9\ud558\uc5ec 50ms\uc758 \uc624\ucc28 \ubc94\uc704\ub85c 0~60km/h \ubc0f 0~100km/h \uac00\uc18d\ub3c4 \uac12\uc744 \uce21\uc815\ud569\ub2c8\ub2e4."},hardware:{title:"\ud558\ub4dc\uc6e8\uc5b4 \ud638\ud658\uc131",content:"ELM327 \ube14\ub8e8\ud22c\uc2a4\ub97c \uad8c\uc7a5\ud569\ub2c8\ub2e4. \uc77c\ubd80 \uace0\uae09 \ucf54\ub4dc\ub294 v2.1 CLONE \ubc84\uc804\uc758 \ud488\uc9c8\uc774 \ub0ae\uc740 \ud558\ub4dc\uc6e8\uc5b4\uc5d0\uc11c \uc791\ub3d9\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. vLinker \ubc0f OBDLink\uc640 \uac19\uc740 \ud504\ub9ac\ubbf8\uc5c4 \uc5b4\ub311\ud130\ub97c \uc0ac\uc6a9\ud558\uba74 \uac00\uc7a5 \ube60\ub978 \uc18d\ub3c4\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},warnings:{title:"\uc911\uc694\ud55c \uacbd\uace0",content:"\u2022 \uacb0\ud568 \ucf54\ub4dc \uc0ad\uc81c \uacfc\uc815\uc774\ub098 ECU \ub9ac\uc14b \uae30\ub2a5 \uc911\uc5d0\ub294 \uc810\ud654 \uc7a5\uce58\uac00 \ucf1c\uc838 \uc788\uace0 \uc5d4\uc9c4\uc774 \uaebc\uc838 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. \u2022 \ub2ec\ub9ac\ub294 \ucc28\ub7c9\uc5d0 \uc7ac\uc124\uc815\uc744 \ubcf4\ub0b4\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \u2022 \ubaa8\ub4e0 \ucc28\ub7c9\uc774 \ubaa8\ub4e0 \uc13c\uc11c\ub97c \uc9c0\uc6d0\ud558\ub294 \uac83\uc740 \uc544\ub2c8\uba70, \uc9c0\uc6d0\ub418\uc9c0 \uc54a\ub294 \uc13c\uc11c\ub294 \"--\"\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4."},onboarding:{title:"\ubc95\uc801 \uad8c\ud55c \ubc0f \uc775\uba85 \uc6d0\uaca9 \uce21\uc815",content:"\uc560\ud50c\ub9ac\ucf00\uc774\uc158 \ud488\uc9c8\uacfc \ucc28\ub7c9 \ud638\ud658\uc131\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud574 \uacb0\ud568 \uc9c4\ub2e8 \uc911\uc5d0 \uc0dd\uc131\ub41c \uc644\uc804\ud788 \uc775\uba85\ud654\ub41c \uc5d4\uc9c4 \ub9e4\uac1c\ubcc0\uc218\uc640 \uacb0\ud568 \ucf54\ub4dc\ub97c \ub2f9\uc0ac\uc758 \ubcf4\uc548 \uc11c\ubc84\uc5d0\uc11c \ubd84\uc11d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacc4\uc18d\ud558\uba74 \uc774\ub7ec\ud55c \uc775\uba85 \uc6d0\uaca9 \uce21\uc815 \uc57d\uad00\uc5d0 \ub3d9\uc758\ud558\uac8c \ub429\ub2c8\ub2e4. \uc624\ud1a0\ubc14\uc774\uc758 ECU\uc640 \ud1b5\uc2e0\ud558\ub824\uba74 \ube14\ub8e8\ud22c\uc2a4 \ubc0f \uc704\uce58 \uad8c\ud55c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."},featureCoding:{title:"\uc228\uaca8\uc9c4 \uae30\ub2a5 \uc7a0\uae08 \ud574\uc81c \ubc0f UDS \ucf54\ub529",content:"ISO 14229 UDS \ud504\ub85c\ud1a0\ucf5c \uc5d4\uc9c4\uc73c\ub85c \uad6c\ub3d9\ub418\uba70 VAG, BMW, Renault \ubc0f Dacia \ucc28\ub7c9\uc6a9 \ubbf8\uad6d \uc8fc\ucc28\ub4f1, \ubc14\ub298 \uccad\uc18c, \uacbd\uc801 \uc2b9\uc778 \uc7a0\uae08, Comfort Windows \ubc0f DRL \uc124\uc815\uacfc \uac19\uc740 \uae30\ub2a5\uc744 \uc548\uc804\ud558\uac8c \uc804\ud658\ud569\ub2c8\ub2e4."},multiEcu:{title:"\ub2e4\uc911 ECU \ubaa8\ub4e0 \ubaa8\ub4c8 \uc2a4\uce90\ub2dd",content:"ABS, \uc5d0\uc5b4\ubc31, \uc790\ub3d9 \ubcc0\uc18d\uae30, \uacc4\uae30\ud310, \uc628\ub3c4 \uc870\uc808 \uc7a5\uce58 \ubc0f \ucc28\uccb4 \uc81c\uc5b4 \ubaa8\ub4c8\uc744 \ud3ec\ud568\ud558\uc5ec \uc5d4\uc9c4 ECU \uc678\ubd80\uc758 \uc624\ub958 \ucf54\ub4dc\ub97c \uc2a4\uce94\ud558\uace0 \uc81c\uac70\ud569\ub2c8\ub2e4."},advancedDiagnostics:{title:"DCT \uc801\uc751, DPF \ubc0f HP \ud30c\uc6cc \uac8c\uc774\uc9c0",content:"\u2022 DCT/DSG \ud074\ub7ec\uce58 \ud0a4\uc2a4 \ud3ec\uc778\ud2b8 \ud559\uc2b5 \ubc0f \uc801\uc751 \uc7ac\uc124\uc815\n\u2022 DPF \uadf8\uc744\uc74c \ubd80\ud558 \ubc0f \ubc30\uae30 \uc7ac\uc0dd \uc628\ub3c4 \ubaa8\ub2c8\ud130\ub9c1\n\u2022 \uc2e4\uc2dc\uac04 \ub2e8\uae30/\uc7a5\uae30 \uc5f0\ub8cc \ud2b8\ub9bc \ubc0f \ub78c\ub2e4 \ubd84\uc11d\n\u2022 \ub3d9\uc801 \ub9c8\ub825 \ubc0f \ud1a0\ud06c \uc2e4\uc2dc\uac04 \uc6d0\uaca9 \uce21\uc815 \uadf8\ub798\ud504"},demoMode:{title:"\ub370\ubaa8 \ubaa8\ub4dc",content:"\uc2e4\uc81c OBD2 \ud558\ub4dc\uc6e8\uc5b4 \uc5c6\uc774 \uc571\uc744 \ud14c\uc2a4\ud2b8\ud558\uace0 \ud0d0\uc0c9\ud574 \ubcf4\uc138\uc694. \ud604\uc2e4\uc801\uc778 \uc2e4\uc2dc\uac04 \uc6d0\uaca9 \uce21\uc815 \uc2dc\ubbac\ub808\uc774\uc158\uc744 \ud1b5\ud574 \uc804\uccb4 CAN-Bus \ubc0f UDS \uc9c4\ub2e8 \uae30\ub2a5\uc744 \uacbd\ud5d8\ud574 \ubcf4\uc138\uc694."}},reconfigurePermissions:"\uad8c\ud55c \ubc0f \ubc95\uc801 \uc870\uac74 \ub2e4\uc2dc \ud45c\uc2dc",shareWithFriend:"\uce5c\uad6c\uc640 \uacf5\uc720\ud558\uae30",shareMessageText:"Cortex OBD2 Diagnostic Scanner\ub85c \ucc28\ub7c9 ECU \uace0\uc7a5 \ucf54\ub4dc \ubc0f \uc2e4\uc2dc\uac04 \uc13c\uc11c \ud154\ub808\uba54\ud2b8\ub9ac\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694! \uc9c0\uae08 \ub2e4\uc6b4\ub85c\ub4dc: iOS: https://apps.apple.com/app/id6764052240 Android: https://play.google.com/store/apps/details?id=com.ismail.motocortexv2 Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:"=== CORTEX OBD2 \uc9c4\ub2e8 \ubcf4\uace0\uc11c ===",vehicleIdentity:"\ucc28\ub7c9 ID",vin:"\uc100\uc2dc \ubc88\ud638",odometer:"\uac70\ub9ac",milDist:"\uc5d4\uc9c4 \ub77c\uc774\ud2b8 \ucf1c\uc9d0",distSinceCleared:"\uc624\ub958\uac00 \ud574\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",dtcCount:"FAULT CODES ({{count}})",sensorData:"\ub77c\uc774\ube0c \uc13c\uc11c \ub370\uc774\ud130",noData:"\ub370\uc774\ud130\ub97c \uc77d\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4.",proApp:"Cortex OBD2 Diagnostic Scanner v7 PRO\ub85c \uc2a4\uce94\ud588\uc2b5\ub2c8\ub2e4.",date:"\ub0a0\uc9dc",vinNotFound:"\uac10\uc9c0\ub418\uc9c0 \uc54a\uc74c",noDtcs:"\uc624\ub958 \ucf54\ub4dc \uc5c6\uc74c - \uae68\ub057\ud568",speed:"\uc18d\ub3c4",coolant:"\uc5d4\uc9c4 \uc628\ub3c4",throttle:"\uac00\uc2a4",engineLoad:"\uc5d4\uc9c4 \ubd80\ud558",intakeAir:"\ud761\uc785 \uacf5\uae30",manifold:"\ub9e4\ub2c8\ud3f4\ub4dc",voltage:"\ubc30\ud130\ub9ac \uc804\uc555",shareMessage:"Motocortex OBD2 \uc9c4\ub2e8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc8fc\uba38\ub2c8\uc5d0\uc11c \uc624\ud1a0\ubc14\uc774 \uc0c1\ud0dc\ub97c \ucd94\uc801\ud558\uc138\uc694! \ub2e4\uc6b4\ub85c\ub4dc: https://cortexobd2.app",subtitle:"\uc885\ud569\uc801\uc778 \uc911\uace0 \uc9c4\ub2e8 \ubc0f \uc6d0\uaca9 \uce21\uc815 \uac80\uc0ac",vehicleInfo:"\ucc28\ub7c9 \uc2dd\ubcc4 \ubc0f ECU \uba54\ud0c0\ub370\uc774\ud130",healthScore:"\uc804\uccb4 ECU \uc0c1\ud0dc \uc810\uc218",dtcSection:"\uc9c4\ub2e8 \ubb38\uc81c \ucf54\ub4dc",telemetrySection:"\uc2e4\uc2dc\uac04 \uc6d0\uaca9 \uce21\uc815 \ubc0f \uc13c\uc11c \uc2a4\ub0c5\uc0f7",maintenanceSection:"Ak\u0131ll\u0131 Garaj \uc11c\ube44\uc2a4 \ubc0f \uc720\uc9c0 \ubcf4\uc218 \ub0b4\uc5ed",aiSection:"AI\ub2e5\ud130 \uc885\ud569\uc0c1\ud0dc \ubd84\uc11d",noFaults:"ECU \uba54\ubaa8\ub9ac\uc5d0 \uc800\uc7a5\ub41c \ud65c\uc131 \ub610\ub294 \uacfc\uac70 \uc624\ub958 \ucf54\ub4dc\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.",noMaintenance:"Ak\u0131ll\u0131 Garaj\uc5d0 \uae30\ub85d\ub41c \uc11c\ube44\uc2a4 \ud56d\ubaa9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.",disclaimer:"\uace0\uc9c0 \uc0ac\ud56d: \uc774 \ubcf4\uace0\uc11c\ub294 MotoCortex \uc9c4\ub2e8 \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc5d0 \uc758\ud574 \uc0dd\uc131\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucc28\ub7c9\uc744 \uad6c\uc785\ud558\uae30 \uc804\uc5d0 \uc778\uc99d\ubc1b\uc740 \uae30\uc220\uc790\uc758 \ubb3c\ub9ac\uc801 \uac80\uc0ac\ub97c \ubc1b\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.",shareTitle:"MotoCortex \ud3c9\uac00 \ubcf4\uace0\uc11c \uacf5\uc720"},battery:{title:"\ubc30\ud130\ub9ac \ubc0f \uc2dc\ub3d9 \ud14c\uc2a4\ud2b8",ready:"\ud14c\uc2a4\ud2b8\ub97c \uc2dc\uc791\ud560 \uc900\ube44\uac00 \ub418\uc5c8\uc2b5\ub2c8\ub2e4.",restingStatus:"\uc2dc\ub3d9 \ucf1c\uc9d0, \uc5d4\uc9c4 \uaebc\uc9d0... \ubc30\ud130\ub9ac \uc804\uc555\uc744 \uc77d\ub294 \uc911...",crankingStatus:"\uc9c0\uae08 \uc2dc\uc791\ud558\uc138\uc694!",chargingStatus:"\uc5d4\uc9c4\uc774 \uacf5\ud68c\uc804 \uc911\uc785\ub2c8\ub2e4... \ucda9\uc804 \uc804\uc555\uc744 \uc77d\ub294 \uc911\uc785\ub2c8\ub2e4...",doneStatus:"\ud14c\uc2a4\ud2b8 \uc644\ub8cc!",voltageError:"\uc804\uc555\uc744 \uc77d\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uc138\uc694.",start:"\ud14c\uc2a4\ud2b8 \uc2dc\uc791",retry:"\ubc18\ubcf5 \ud14c\uc2a4\ud2b8",procedure:"\ud14c\uc2a4\ud2b8 \uc808\ucc28",steps:{1:"1. \uc2dc\ub3d9 ON, \uc5d4\uc9c4 OFF \u2192 \ud734\uc9c0\uc804\uc555 \uce21\uc815",2:"2. \"START NOW\" \uba54\uc2dc\uc9c0\uac00 \ub098\ud0c0\ub098\uba74 \uc5d4\uc9c4\uc744 \uc2dc\ub3d9\ud569\ub2c8\ub2e4.",3:"3. 5\ucd08\uac04 \ucd5c\uc800 \uc804\uc555 \uae30\ub85d",4:"4. \uc5d4\uc9c4\uc774 \uc791\ub3d9\ud558\ub294 \ub3d9\uc548 \ucda9\uc804/\uc870\uc808\uae30 \uc804\uc555\uc744 \uce21\uc815\ud569\ub2c8\ub2e4."},warning:"\ud14c\uc2a4\ud2b8 \uc911\uc5d0\ub294 Bluetooth \uc5f0\uacb0\uc744 \ub04a\uc9c0 \ub9c8\uc2ed\uc2dc\uc624.",resting:"\ud734\uc2dd",cranking:"\uc564\uc378",charging:"\ucda9\uc804 \uc911",instantV:"\uc21c\uac04 \uc804\uc555",evaluation:"\ud3c9