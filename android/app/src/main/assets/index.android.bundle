g."},bmwmotorrad_reverse_assist_sensitivity:{name:"Electric Reverse Assist Motor Sensitivity",desc:"Fine-tunes reverse drive electric starter motor speed and torque limit."},ducati_riding_mode_custom_profile:{name:"Riding Mode Custom Profile Creator",desc:"Unlocks custom combinations for Race, Sport, Touring, and Urban profiles."},ducati_ohlins_suspension_mapping:{name:"\xd6hlins Smart EC 2.0 Semi-Active Suspension Mapping",desc:"Fine-tunes damping curve and stiffness presets for electronic suspension."},ducati_dashboard_lap_timer_gps:{name:"TFT Dashboard Lap Timer & GPS Sector Splits",desc:"Unlocks track lap timer and sector split display on instrument cluster."},ducati_engine_brake_control_ebc:{name:"Engine Brake Control Level Adjustment",desc:"Adjusts rear wheel deceleration torque during hard corner entry braking."},ducati_cruise_control_retrofit_enable:{name:"Cruise Control Retrofit Activation",desc:"Enables ECU software flag for retrofitted electronic cruise control switches."},ducati_exhaust_valve_sound_map:{name:"Exhaust Servo Valve Opening RPM Map",desc:"Adjusts acoustic exhaust valve opening threshold for enhanced exhaust note."},ducati_pit_lane_limiter_config:{name:"Pit Lane Speed Limiter Threshold",desc:"Enables 60 km/h pit lane speed limiter toggle on handlebar switches."},ducati_desmo_service_light_reset:{name:"Oil & Desmo Valve Service Light Reset",desc:"Clears Desmodromic valve service reminder warning on instrument cluster."},ktm_quickshifter_plus_delay_tuning:{name:"Quickshifter+ Shift Cut Time & Delay Fine-Tuning",desc:"Customizes ignition cut duration per gear for seamless up/down shifts."},ktm_rally_offroad_abs_tc_unlock:{name:"Rally / Off-Road ABS & TC Mode Unlock",desc:"Disables rear ABS and unlocks 9-stage slip adjustment in Rally mode."},ktm_my_ktm_connectivity_unlock:{name:"My KTM / Husqvarna Connectivity Module Activation",desc:"Enables Bluetooth navigation and turn-by-turn routing on TFT display."},ktm_cruise_control_retrofit_enable:{name