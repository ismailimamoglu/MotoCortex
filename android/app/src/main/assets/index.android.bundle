_beep_mute:{name:"Bip cont\xednuo da cabine de marcha \xe0 r\xe9 mudo",desc:"Silencia o sinal sonoro cont\xednuo da marcha \xe0 r\xe9 dentro da cabine em um \xfanico bipe."},toyota_remote_window_drop:{name:"Janela remota do chaveiro rolante para baixo",desc:"Abre todos os vidros el\xe9tricos ao segurar o bot\xe3o de desbloqueio do chaveiro."},toyota_auto_lock_shift_p:{name:"Portas com travamento autom\xe1tico na mudan\xe7a de marcha (P -> D)",desc:"Trava automaticamente todas as portas ao sair da posi\xe7\xe3o de estacionamento."},peugeot_icockpit_theme_unlock:{name:"Tema de desempenho do Peugeot 3D i-Cockpit",desc:"Desbloqueia temas de exibi\xe7\xe3o em cores Cobre e Vermelho em cluster digital 3D."},jeep_offroad_pages_enable:{name:"P\xe1ginas off-road do Jeep Uconnect",desc:"Permite medidores de \xe2ngulo de inclina\xe7\xe3o/rota\xe7\xe3o, articula\xe7\xe3o das rodas e status de bloqueio 4x4."},hyundai_smart_welcome_mirror:{name:"Desdobramento do espelho de boas-vindas da abordagem Smart Key",desc:"Desdobra automaticamente os espelhos laterais ao se aproximar do ve\xedculo com chave inteligente."},hyundai_one_touch_turn_7_flashes:{name:"Sinal de mudan\xe7a de faixa com um toque (7 flashes)",desc:"Define a dura\xe7\xe3o do pisca-pisca de mudan\xe7a de faixa com um toque para 7 piscadas."},hyundai_svm_camera_speed_extend:{name:"Extens\xe3o de velocidade da c\xe2mera surround 360\xb0 (20 km/h)",desc:"Mant\xe9m a c\xe2mera de estacionamento de 360 graus ativa at\xe9 velocidade de avan\xe7o de 20 km/h."},hyundai_n_performance_exhaust_flap:{name:"Flap de escape N-Performance padr\xe3o ABERTO",desc:"Define a posi\xe7\xe3o padr\xe3o da v\xe1lvula de escape ativa para ABERTA na partida do motor."},vag_rain_closing_sunroof:{name:"Fechamento por chuva (Regenschlie\xdfen)",desc:"Fecha automaticamente o teto solar e as janelas quando a chuva \xe9 detectada durante o estacionamento."},bmw_launch_control_unlock:{name:"Desbloqueio de controle de lan\xe7amento",desc:"Desbloqueia o programa de acelera\xe7\xe3o de controle de lan\xe7amento de f\xe1brica na ECU da transmiss\xe3o."},mercedes_ambient_64_multi_zone:{name:"Perfil ambiente multizona de 64 cores",desc:"Desbloqueia a anima\xe7\xe3o din\xe2mica do ciclo de cores multizonas na ilumina\xe7\xe3o interior MBUX."},ford_trailer_brake_activation:{name:"Controlador de freio de reboque (TBC) ativado",desc:"Ativa o menu integrado do controlador de freio do trailer no painel de instrumentos."},gm_afm_dfm_cylinder_deactivation_disable:{name:"Bloqueio de cilindro AFM/DFM V8 (sem queda V4)",desc:"Bloqueia o motor no modo de 8 cilindros permanentemente para evitar a vibra\xe7\xe3o do V4."},gm_remote_start_time_extend:{name:"Extens\xe3o da dura\xe7\xe3o da inicializa\xe7\xe3o remota (20 minutos)",desc:"Estende o tempo de execu\xe7\xe3o de partida remota do motor com chave de f\xe1brica de 10 para 20 minutos."},dodge_srt_performance_pages:{name:"P\xe1ginas de desempenho SRT e modos de dire\xe7\xe3o",desc:"Desbloqueia temporizadores de acelera\xe7\xe3o Uconnect 0-100, medidor de for\xe7a G e controle de lan\xe7amento."},ram_bambi_mode_fog:{name:"Far\xf3is de neblina para caminh\xe3o RAM com farol alto",desc:"Permite que os far\xf3is de neblina RAM permane\xe7am ativos ao lado dos far\xf3is altos."},byd_avas_pedestrian_siren_mute:{name:"Silenciador de sirene de baixa velocidade AVAS EV",desc:"Silencia a sirene do motor el\xe9trico artificial de baixa velocidade abaixo de 30 km/h."},chery_isa_overspeed_chime_mute:{name:"Desativa\xe7\xe3o do aviso sonoro de excesso de velocidade ISA",desc:"Desativa o bipe cont\xednuo de alerta de excesso de velocidade de 80/120 km/h nos modelos Tiggo/MG."},mg_ev_battery_preconditioning_toggle:{name:"Interruptor manual de pr\xe9-aquecimento da bateria de carga r\xe1pida EV",desc:"Ativa o interruptor manual de pr\xe9-aquecimento da bateria antes do carregamento r\xe1pido DC."},chery_dms_fatigue_camera_mute:{name:"Redu\xe7\xe3o da sensibilidade da c\xe2mera de monitoramento do motorista (DMS)",desc:"Reduz avisos de fadiga de rastreamento ocular excessivamente sens\xedveis na coluna de dire\xe7\xe3o."},honda_walk_away_auto_lock:{name:"Fechadura autom\xe1tica da porta",desc:"Trava automaticamente todas as portas quando o motorista se afasta 2 metros com o chaveiro."},subaru_avh_auto_hold_memory:{name:"Modo de mem\xf3ria de reten\xe7\xe3o autom\xe1tica de ve\xedculo (AVH)",desc:"Lembra o estado ON/OFF do freio AVH durante os ciclos de igni\xe7\xe3o."},volvo_start_stop_default_off:{name:"Modo Auto Start-Stop Padr\xe3o DESLIGADO",desc:"Define o estado padr\xe3o do sistema de desligamento do motor Start-Stop como DESLIGADO na partida do ve\xedculo."},volvo_polestar_digital_theme:{name:"Tema de cluster digital azul Polestar",desc:"Desbloqueia o tema do medidor din\xe2mico azul exclusivo da Polestar no display do motorista Volvo."},vag_virtual_cockpit_r_theme:{name:"Temas de desempenho do Virtual Cockpit R / S / Cupra",desc:"Desbloqueia temas de desempenho do tac\xf4metro central R-Line, S-Line e Cupra no cockpit digital."},vag_sound_symposer_mute:{name:"Sound Symposer Falso Desativa\xe7\xe3o de Ru\xeddo do Motor",desc:"Desativa o gerador de som do motor falso do alto-falante da cabine para obter uma nota de exaust\xe3o pura."},vag_wireless_carplay_enable:{name:"Ativa\xe7\xe3o sem fio Apple CarPlay e Android Auto",desc:"Permite Apple CarPlay sem fio Wi-Fi de 5 GHz e Android Auto em unidades MIB2.5/MIB3."},vag_offroad_telemetry_menu:{name:"Telemetria offroad MIB e exibi\xe7\xe3o de medidor",desc:"Exibe o \xe2ngulo de dire\xe7\xe3o, temperatura do \xf3leo, temperatura do l\xedquido refrigerante e medidores de altitude na tela MIB."},vag_easy_entry_driver_seat:{name:"Degrau traseiro autom\xe1tico do assento el\xe9trico de entrada f\xe1cil",desc:"Move o banco do motorista el\xe9trico para tr\xe1s 5 cm ap\xf3s a abertura da porta para facilitar a entrada do ve\xedculo."},vag_hba_memory_state:{name:"Reten\xe7\xe3o de mem\xf3ria do assistente de farol