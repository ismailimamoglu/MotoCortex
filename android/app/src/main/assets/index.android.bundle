093f\u091f \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0925\u0940\u092e",desc:"3\u0921\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092a\u0930 \u0915\u0949\u092a\u0930 \u0914\u0930 \u091f\u094d\u0930\u0948\u0915 \u0930\u0947\u0921 \u0915\u0932\u0930 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0925\u0940\u092e \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},jeep_offroad_pages_enable:{name:"\u091c\u0940\u092a \u092f\u0942\u0915\u0928\u0947\u0915\u094d\u091f \u0911\u092b-\u0930\u094b\u0921 \u092a\u0947\u091c",desc:"\u092a\u093f\u091a/\u0930\u094b\u0932 \u090f\u0902\u0917\u0932 \u0917\u0947\u091c, \u0935\u094d\u0939\u0940\u0932 \u0906\u0930\u094d\u091f\u093f\u0915\u094d\u092f\u0942\u0932\u0947\u0936\u0928 \u0914\u0930 4x4 \u0932\u0949\u0915 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},hyundai_smart_welcome_mirror:{name:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0940 \u090f\u092a\u094d\u0930\u094b\u091a \u0935\u0947\u0932\u0915\u092e \u092e\u093f\u0930\u0930 \u0905\u0928\u092b\u094b\u0932\u094d\u0921",desc:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u0939\u0928 \u0915\u0947 \u092a\u093e\u0938 \u0906\u0928\u0947 \u092a\u0930 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0938\u093e\u0907\u0921 \u092e\u093f\u0930\u0930 \u0916\u0941\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},hyundai_one_touch_turn_7_flashes:{name:"\u0935\u0928-\u091f\u091a \u0932\u0947\u0928 \u091a\u0947\u0902\u091c \u0938\u093f\u0917\u094d\u0928\u0932 (7 \u092b\u093c\u094d\u0932\u0948\u0936)",desc:"\u0935\u0928-\u091f\u091a \u0932\u0947\u0928 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092c\u094d\u0932\u093f\u0902\u0915\u0930 \u0905\u0935\u0927\u093f \u0915\u094b 7 \u092b\u093c\u094d\u0932\u0948\u0936 \u092a\u0930 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},hyundai_svm_camera_speed_extend:{name:"360\xb0 \u0938\u0930\u093e\u0909\u0902\u0921 \u0915\u0948\u092e\u0930\u093e \u0938\u094d\u092a\u0940\u0921 \u090f\u0915\u094d\u0938\u091f\u0947\u0902\u0936\u0928 (20 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e)",desc:"360-\u0921\u093f\u0917\u094d\u0930\u0940 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0915\u0948\u092e\u0930\u093e \u0915\u094b 20 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0906\u0917\u0947 \u0915\u0940 \u0917\u0924\u093f \u0924\u0915 \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},hyundai_n_performance_exhaust_flap:{name:"\u090f\u0928-\u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u090f\u0917\u094d\u091c\u0949\u0938\u094d\u091f \u092b\u094d\u0932\u0948\u092a \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0913\u092a\u0928",desc:"\u0907\u0902\u091c\u0928 \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0928\u093f\u0915\u093e\u0938 \u0935\u093e\u0932\u094d\u0935 \u0915\u0940 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_rain_closing_sunroof:{name:"\u092c\u093e\u0930\u093f\u0936 \u0915\u093e \u0938\u092e\u093e\u092a\u0928 (\u0930\u0947\u0917\u0947\u0928\u094d\u0938\u0915\u094d\u0932\u093f\u0938\u0947\u0928)",desc:"\u092a\u093e\u0930\u094d\u0915 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u092c\u093e\u0930\u093f\u0936 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u0928\u0947 \u092a\u0930 \u0938\u0928\u0930\u0942\u092b \u0914\u0930 \u0916\u093f\u0921\u093c\u0915\u093f\u092f\u093e\u0901 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964"},bmw_launch_control_unlock:{name:"\u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0905\u0928\u0932\u0949\u0915 \u0932\u0949\u0928\u094d\u091a \u0915\u0930\u0947\u0902",desc:"\u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u0902 \u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0932\u0949\u0928\u094d\u091a \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u090f\u0915\u094d\u0938\u0947\u0932\u0947\u0930\u0947\u0936\u0928 \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},mercedes_ambient_64_multi_zone:{name:"64-\u0930\u0902\u0917 \u092e\u0932\u094d\u091f\u0940-\u091c\u093c\u094b\u0928 \u092a\u0930\u093f\u0935\u0947\u0936 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932",desc:"\u090f\u092e\u092c\u0940\u092f\u0942\u090f\u0915\u094d\u0938 \u0906\u0902\u0924\u0930\u093f\u0915 \u092a\u094d\u0930\u0915\u093e\u0936 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u092e\u0947\u0902 \u0917\u0924\u093f\u0936\u0940\u0932 \u092c\u0939\u0941-\u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0930\u0902\u0917 \u091a\u0915\u094d\u0930 \u090f\u0928\u0940\u092e\u0947\u0936\u0928 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ford_trailer_brake_activation:{name:"\u091f\u094d\u0930\u0947\u0932\u0930 \u092c\u094d\u0930\u0947\u0915 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0915 (\u091f\u0940\u092c\u0940\u0938\u0940) \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902",desc:"\u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092e\u0947\u0902 \u090f\u0915\u0940\u0915\u0943\u0924 \u091f\u094d\u0930\u0947\u0932\u0930 \u092c\u094d\u0930\u0947\u0915 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0915 \u092e\u0947\u0928\u0942 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},gm_afm_dfm_cylinder_deactivation_disable:{name:"\u090f\u090f\u092b\u090f\u092e/\u0921\u0940\u090f\u092b\u090f\u092e \u0935\u09408 \u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u0932\u0949\u0915 (\u0915\u094b\u0908 \u0935\u09404 \u0921\u094d\u0930\u0949\u092a \u0928\u0939\u0940\u0902)",desc:"V4 \u0915\u0902\u092a\u0928 \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0902\u091c\u0928 \u0915\u094b 8-\u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u092e\u094b\u0921 \u092e\u0947\u0902 \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},gm_remote_start_time_extend:{name:"\u0926\u0942\u0930\u0938\u094d\u0925 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0905\u0935\u0927\u093f \u0935\u093f\u0938\u094d\u0924\u093e\u0930 (20 \u092e\u093f\u0928\u091f)",desc:"\u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u0930\u093f\u092e\u094b\u091f \u0907\u0902\u091c\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0930\u0928 \u091f\u093e\u0907\u092e \u0915\u094b 10 \u0938\u0947 20 \u092e\u093f\u0928\u091f \u0924\u0915 \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964"},dodge_srt_performance_pages:{name:"\u090f\u0938\u0906\u0930\u091f\u0940 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092a\u0943\u0937\u094d\u0920 \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921",desc:"\u092f\u0942\u0915\u0928\u0947\u0915\u094d\u091f 0-100 \u090f\u0915\u094d\u0938\u0947\u0932\u0947\u0930\u0947\u0936\u0928 \u091f\u093e\u0907\u092e\u0930, \u091c\u0940-\u092b\u094b\u0930\u094d\u0938 \u092e\u0940\u091f\u0930 \u0914\u0930 \u0932\u0949\u0928\u094d\u091a \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ram_bambi_mode_fog:{name:"\u0939\u093e\u0908 \u092c\u0940\u092e \u0915\u0947 \u0938\u093e\u0925 \u0930\u0948\u092e \u091f\u094d\u0930\u0915 \u092b\u0949\u0917 \u0932\u093e\u0907\u091f\u094d\u0938",desc:"\u0930\u0948\u092e \u092b\u0949\u0917 \u0932\u093e\u0907\u091f \u0915\u094b \u0939\u093e\u0908 \u092c\u0940\u092e \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0915\u0947 \u0938\u093e\u0925 \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},byd_avas_pedestrian_siren_mute:{name:"AVAS EV \u0932\u094b-\u0938\u094d\u092a\u0940\u0921 \u0938\u093e\u092f\u0930\u0928 \u092e\u094d\u092f\u0942\u091f",desc:"30 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0938\u0947 \u0915\u092e \u0917\u0924\u093f \u0935\u093e\u0932\u0947 \u0915\u0943\u0924\u094d\u0930\u093f\u092e \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u092e\u094b\u091f\u0930 \u0938\u093e\u092f\u0930\u0928 \u0915\u094b \u092e\u094d\u092f\u0942\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},chery_isa_overspeed_chime_mute:{name:"\u0906\u0908\u090f\u0938\u090f \u0913\u0935\u0930\u0938\u094d\u092a\u0940\u0921 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091d\u0902\u0915\u093e\u0930 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f\u0915\u0930\u0923",desc:"\u091f\u093f\u0917\u094d\u0917\u094b/\u090f\u092e\u091c\u0940 \u092e\u0949\u0921\u0932 \u092a\u0930 \u0932\u0917\u093e\u0924\u093e\u0930 80/120 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0913\u0935\u0930\u0938\u094d\u092a\u0940\u0921 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092c\u0940\u092a \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},mg_ev_battery_preconditioning_toggle:{name:"\u0908\u0935\u0940 \u092b\u093e\u0938\u094d\u091f-\u091a\u093e\u0930\u094d\u091c \u092c\u0948\u091f\u0930\u0940 \u092a\u094d\u0930\u0940-\u0939\u0940\u091f\u093f\u0902\u0917 \u092e\u0948\u0928\u0941\u0905\u0932 \u0938\u094d\u0935\u093f\u091a",desc:"\u0921\u0940\u0938\u0940 \u092b\u093e\u0938\u094d\u091f \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0948\u0928\u0941\u0905\u0932 \u092c\u0948\u091f\u0930\u0940 \u092a\u094d\u0930\u0940-\u0939\u0940\u091f\u093f\u0902\u0917 \u0938\u094d\u0935\u093f\u091a \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},chery_dms_fatigue_camera_mute:{name:"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092e\u0949\u0928\u093f\u091f\u0930\u093f\u0902\u0917 (\u0921\u0940\u090f\u092e\u090f\u0938) \u0915\u0948\u092e\u0930\u093e \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e \u092e\u0947\u0902 \u0915\u092e\u0940",desc:"\u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0915\u0949\u0932\u092e \u092a\u0930 \u0905\u0924\u093f-\u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932 \u0928\u0947\u0924\u094d\u0930-\u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0925\u0915\u093e\u0928 \u091a\u0947\u0924\u093e\u0935\u0928\u093f\u092f\u094b\u0902 \u0915\u094b \u0915\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},honda_walk_away_auto_lock:{name:"\u0935\u0949\u0915-\u0905\u0935\u0947 \u0911\u091f\u094b \u0921\u094b\u0930 \u0932\u0949\u0915",desc:"\u091c\u092c \u0921\u094d\u0930\u093e\u0907\u0935\u0930 2 \u092e\u0940\u091f\u0930 \u0915\u0940 \u0926\u0942\u0930\u0940 \u092a\u0930 \u091a\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0924\u094b \u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u0915\u0947 \u0938\u093e\u0925 \u0938\u092d\u0940 \u0926\u0930\u0935\u093e\u091c\u0947 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},subaru_avh_auto_hold_memory:{name:"\u0911\u091f\u094b \u0935\u094d\u0939\u0940\u0915\u0932 \u0939\u094b\u0932\u094d\u0921 (\u090f\u0935\u0940\u090f\u091a) \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u094b\u0921",desc:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u0915\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 AVH \u092c\u094d\u0930\u0947\u0915 \u0939\u094b\u0932\u094d\u0921 \u091a\u093e\u0932\u0942/\u092c\u0902\u0926 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},volvo_start_stop_default_off:{name:"\u0911\u091f\u094b \u0938\u094d\u091f\u093e\u0930\u094d\u091f-\u0938\u094d\u091f\u0949\u092a \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0911\u092b \u092e\u094b\u0921",desc:"\u0935\u093e\u0939\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0939\u094b\u0928\u0947 \u092a\u0930 \u0938\u094d\u091f\u093e\u0930\u094d\u091f-\u0938\u094d\u091f\u0949\u092a \u0907\u0902\u091c\u0928 \u0936\u091f\u0911\u092b\u093c \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u0940 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u092c\u0902\u0926 \u092a\u0930 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},volvo_polestar_digital_theme:{name:"\u092a\u094b\u0932\u0938\u094d\u091f\u093e\u0930 \u092c\u094d\u0932\u0942 \u0921\u093f\u091c\u093f\u091f\u0932 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0925\u0940\u092e",desc:"\u0935\u094b\u0932\u094d\u0935\u094b \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092e\u0947\u0902 \u092a\u094b\u0932\u0938\u094d\u091f\u093e\u0930 \u0938\u093f\u0917\u094d\u0928\u0947\u091a\u0930 \u092c\u094d\u0932\u0942 \u0921\u093e\u092f\u0928\u0947\u092e\u093f\u0915 \u0917\u0947\u091c \u0925\u0940\u092e \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_virtual_cockpit_r_theme:{name:"\u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0915\u0949\u0915\u092a\u093f\u091f \u0906\u0930/\u090f\u0938/\u0915\u092a\u0930\u093e \u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u0925\u0940\u092e\u094d\u0938",desc:"\u0921\u093f\u091c\u093f\u091f\u0932 \u0915\u0949\u0915\u092a\u093f\u091f \u092e\u0947\u0902 \u0906\u0930-\u0932\u093e\u0907\u0928, \u090f\u0938-\u0932\u093e\u0907\u0928 \u0914\u0930 \u0915\u092a\u0930\u093e \u0938\u0947\u0902\u091f\u094d\u0930\u0932 \u091f\u0948\u0915\u094b\u092e\u0940\u091f\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0925\u0940\u092e \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_sound_symposer_mute:{name:"\u0927\u094d\u0935\u0928\u093f \u0938\u093f\u092e\u094d\u092a\u094b\u091c\u0930 \u0928\u0915\u0932\u0940 \u0907\u0902\u091c\u0928 \u0936\u094b\u0930 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f\u0915\u0930\u0923",desc:"\u0936\u0941\u0926\u094d\u0927 \u0928\u093f\u0915\u093e\u0938 \u0928\u094b\u091f \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u092c\u093f\u0928 \u0938\u094d\u092a\u0940\u0915\u0930 \u0928\u0915\u0932\u0940 \u0907\u0902\u091c\u0928 \u0927\u094d\u0935\u0928\u093f \u091c\u0928\u0930\u0947\u091f\u0930 \u0915\u094b \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_wireless_carplay_enable:{name:"\u0935\u093e\u092f\u0930\u0932\u0947\u0938 \u090f\u092a\u094d\u092a\u0932 \u0915\u093e\u0930\u092a\u094d\u0932\u0947 \u0914\u0930 \u090f\u0902\u0921\u094d\u0930\u0949\u0907\u0921 \u0911\u091f\u094b \u090f\u0915\u094d\u091f\u093f\u0935\u0947\u0936\u0928",desc:"MIB2.5/MIB3 \u0907\u0915\u093e\u0907\u092f\u094b\u0902 \u092a\u0930 5GHz \u0935\u093e\u0908-\u092b\u093e\u0908 \u0935\u093e\u092f\u0930\u0932\u0947\u0938 Apple CarPlay \u0914\u0930 Android Auto \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_offroad_telemetry_menu:{name:"\u090f\u092e\u0906\u0908\u092c\u0940 \u0911\u092b\u0930\u094b\u0921 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0914\u0930 \u0917\u0947\u091c \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947",desc:"\u090f\u092e\u0906\u0908\u092c\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0915\u094b\u0923, \u0924\u0947\u0932 \u0924\u093e\u092a\u092e\u093e\u0928, \u0936\u0940\u0924\u0932\u0915 \u0924\u093e\u092a\u092e\u093e\u0928 \u0914\u0930 \u090a\u0902\u091a\u093e\u0908 \u0917\u0947\u091c \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_easy_entry_driver_seat:{name:"\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0906\u0938\u093e\u0928 \u092a\u094d\u0930\u0935\u0947\u0936 \u092a\u093e\u0935\u0930 \u0938\u0940\u091f \u092c\u0948\u0915-\u0938\u094d\u091f\u0947\u092a",desc:"\u0935\u093e\u0939\u0928 \u0915\u0947 \u0906\u0938\u093e\u0928 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0947 \u0932\u093f\u090f \u0926\u0930\u0935\u093e\u091c\u093e \u0916\u0941\u0932\u0928\u0947 \u092a\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0938\u0940\u091f \u0915\u094b 5 \u0938\u0947\u092e\u0940 \u092a\u0940\u091b\u0947 \u0932\u0947 \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},vag_hba_memory_state:{name:"\u0939\u093e\u0908-\u092c\u0940\u092e \u0905\u0938\u093f\u0938\u094d\u091f (\u090f\u091a\u092c\u0940\u090f) \u092e\u0947\u092e\u094b\u0930\u0940 \u0930\u093f\u091f\u0947\u0902\u0936\u0928",desc:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u092a\u0941\u0928\u0930\u093e\u0930\u0902\u092d \u091a\u0915\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u0939\u093e\u0908-\u092c\u0940\u092e \u0905\u0938\u093f\u0938\u094d\u091f \u0911\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},vag_battery_soc_display:{name:"\u092c\u0948\u091f\u0930\u0940 \u091a\u093e\u0930\u094d\u091c \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f (% \u090f\u0938\u0913\u0938\u0940) \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947",desc:"\u091f\u094d\u0930\u093f\u092a \u092c\u091f\u0928 \u0926\u092c\u093e\u090f \u0930\u0916\u0928\u0947 \u092a\u0930 \u0909\u092a\u0915\u0930\u0923 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092a\u0930 \u0938\u091f\u0940\u0915 \u092c\u0948\u091f\u0930\u0940 \u091a\u093e\u0930\u094d\u091c \u092a\u094d\u0930\u0924\u093f\u0936\u0924 (% \u090f\u0938\u0913\u0938\u0940) \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964"},bmw_idrive7_m_animation:{name:"\u0906\u0908\u0921\u094d\u0930\u093e\u0907\u0935 7/8 \u090f\u092e-\u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0905\u092a \u090f\u0928\u093f\u092e\u0947\u0936\u0928",desc:"\u0906\u0908\u0921\u094d\u0930\u093e\u0907\u0935 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092c\u0942\u091f \u0917\u094d\u0930\u093e\u092b\u093c\u093f\u0915 \u0915\u094b \u090f\u092e-\u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u092f\u093e \u090f\u092e-\u091c\u0940\u090f\u092e\u092c\u0940\u090f\u091a \u0932\u094b\u0917\u094b \u090f\u0928\u0940\u092e\u0947\u0936\u0928 \u092e\u0947\u0902 \u092c\u0926\u0932\u0924\u093e \u0939\u0948\u0964"},bmw_bowers_wilkins_audio_profiles:{name:"\u092c\u094b\u0935\u0930\u094d\u0938 \u090f\u0902\u0921 \u0935\u093f\u0932\u094d\u0915\u093f\u0902\u0938 3\u0921\u0940 \u0938\u093e\u0909\u0902\u0921 \u0907\u0902\u091c\u0928 \u0905\u0928\u0932\u0949\u0915",desc:"HiFi \u0938\u093f\u0938\u094d\u091f\u092e \u092a\u0930 \u092c\u094b\u0935\u0930\u094d\u0938 \u090f\u0902\u0921 \u0935\u093f\u0932\u094d\u0915\u093f\u0902\u0938 \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f, \u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u0914\u0930 \u0938\u094d\u091f\u0947\u091c DSP \u0911\u0921\u093f\u092f\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_hitch_zoom_camera:{name:"\u0930\u093f\u0935\u0930\u094d\u0938 \u0915\u0948\u092e\u0930\u093e \u091f\u094d\u0930\u0947\u0932\u0930 \u0939\u093f\u091a \u091c\u093c\u0942\u092e \u092e\u094b\u0921",desc:"\u0930\u093f\u0935\u0930\u094d\u0938 \u0915\u0948\u092e\u0930\u093e \u0935\u094d\u092f\u0942 \u092a\u0930 \u091f\u0949\u092a-\u0921\u093e\u0909\u0928 \u091f\u094d\u0930\u0947\u0932\u0930 \u0939\u093f\u091a \u0905\u0932\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u091c\u093c\u0942\u092e \u092e\u094b\u0921 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_secure_idle_protection:{name:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0907\u0902\u091c\u0928 \u0936\u093f\u092b\u094d\u091f-\u0932\u0949\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e",desc:"\u092f\u0926\u093f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091a\u093e\u0932\u0942 \u0935\u093e\u0939\u0928 \u0915\u094b \u091a\u093e\u092c\u0940 \u0915\u0947 \u0938\u093e\u0925 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u093e \u0939\u0948 \u0924\u094b \u092a\u093e\u0930\u094d\u0915 \u092e\u0947\u0902 \u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},bmw_seatbelt_handover_mute:{name:"\u0915\u0942\u092a \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u0939\u0948\u0902\u0921\u0913\u0935\u0930 \u0906\u0930\u094d\u092e \u0921\u093f\u090f\u0915\u094d\u091f\u093f\u0935\u0947\u0936\u0928",desc:"4 \u0938\u0940\u0930\u0940\u091c \u0914\u0930 2 \u0938\u0940\u0930\u0940\u091c \u0915\u0942\u092a\u094b\u0902 \u092a\u0930 \u092e\u094b\u091f\u0930 \u091a\u093e\u0932\u093f\u0924 \u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u090f\u0915\u094d\u0938\u091f\u0947\u0902\u0921\u0930 \u0906\u0930\u094d\u092e \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_auto_heat_threshold_5c:{name:"\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0938\u0940\u091f \u0914\u0930 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0935\u094d\u0939\u0940\u0932 \u0924\u093e\u092a \u0924\u093e\u092a\u092e\u093e\u0928 (+5\xb0C)",desc:"\u091c\u092c \u092a\u0930\u093f\u0935\u0947\u0936 \u0915\u093e \u0924\u093e\u092a\u092e\u093e\u0928 5\xb0C \u0938\u0947 \u0928\u0940\u091a\u0947 \u091a\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0924\u094b \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0938\u0940\u091f \u0914\u0930 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0935\u094d\u0939\u0940\u0932 \u0939\u0940\u091f\u093f\u0902\u0917 \u091a\u093e\u0932\u0942 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"},mercedes_amg_track_pace_unlock:{name:"\u090f\u092e\u092c\u0940\u092f\u0942\u090f\u0915\u094d\u0938 \u090f\u090f\u092e\u091c\u0940 \u091f\u094d\u0930\u0948\u0915 \u092a\u0947\u0938 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0914\u0930 \u0932\u0948\u092a \u091f\u093e\u0907\u092e\u0930",desc:"\u090f\u092e\u092c\u0940\u092f\u0942\u090f\u0915\u094d\u0938 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0932\u0948\u092a \u091f\u093e\u0907\u092e\u093f\u0902\u0917, \u090f\u0915\u094d\u0938\u0947\u0932\u0947\u0930\u0947\u0936\u0928 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0914\u0930 \u091c\u0940-\u092b\u094b\u0930\u094d\u0938 \u0917\u094d\u0930\u093e\u092b \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},mercedes_drive_mode_last_memory:{name:"\u0921\u093e\u092f\u0928\u093e\u092e\u093f\u0915 \u0938\u0947\u0932\u0947\u0915\u094d\u091f \u0932\u093e\u0938\u094d\u091f \u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921 \u092e\u0947\u092e\u094b\u0930\u0940",desc:"\u0935\u093e\u0939\u0928 \u092a\u0941\u0928\u0930\u093e\u0930\u0902\u092d \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0905\u0902\u0924\u093f\u092e \u091a\u092f\u0928\u093f\u0924 \u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921 (\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924/\u0916\u0947\u0932) \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},mercedes_proximity_360_camera_auto:{name:"\u092a\u094d\u0930\u0949\u0915\u094d\u0938\u093f\u092e\u093f\u091f\u0940 \u0938\u0947\u0902\u0938\u0930 \u0911\u091f\u094b 360\xb0 \u0915\u0948\u092e\u0930\u093e \u0926\u0943\u0936\u094d\u092f",desc:"\u091c\u092c \u092b\u094d\u0930\u0902\u091f \u0938\u0947\u0902\u0938\u0930 <50 \u0938\u0947\u092e\u0940 \u092c\u093e\u0927\u093e \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0924\u093e \u0939\u0948 \u0924\u094b \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 360 \u0915\u0948\u092e\u0930\u0947 \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"},ford_sync_climate_screen_unlock:{name:"SYNC3 / SYNC4 \u091f\u091a\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u091c\u0932\u0935\u093e\u092f\u0941 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092a\u0943\u0937\u094d\u0920",desc:"\u091c\u0932\u0935\u093e\u092f\u0941 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923, \u0917\u0930\u094d\u092e \u0938\u0940\u091f \u0914\u0930 \u0935\u093e\u092f\u0941 \u092a\u094d\u0930\u0935\u093e\u0939 \u0926\u093f\u0936\u093e \u091f\u091a\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0947\u091c \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ford_turn_signal_5_flashes:{name:"\u0935\u0928-\u091f\u091a \u0932\u0947\u0928 \u091a\u0947\u0902\u091c \u0938\u093f\u0917\u094d\u0928\u0932 (5 \u092b\u093c\u094d\u0932\u0948\u0936)",desc:"\u0935\u0928-\u091f\u091a \u0932\u0947\u0928 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u0905\u0935\u0927\u093f \u0915\u094b 3 \u0938\u0947 5 \u092b\u093c\u094d\u0932\u0948\u0936 \u0924\u0915 \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964"},ford_auto_engine_shutdown_disable:{name:"30-\u092e\u093f\u0928\u091f \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0911\u091f\u094b \u0907\u0902\u091c\u0928 \u0936\u091f\u0921\u093e\u0909\u0928 \u0913\u0935\u0930\u0930\u093e\u0907\u0921",desc:"30 \u092e\u093f\u0928\u091f \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 (\u0915\u0948\u0902\u092a\u093f\u0902\u0917/\u092a\u093e\u0935\u0930 \u0906\u0909\u091f\u0932\u0947\u091f \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u090f) \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u093e \u0939\u0948\u0964"},ev_battery_preheat_manual_switch:{name:"\u0908\u0935\u0940 \u092c\u0948\u091f\u0930\u0940 \u092a\u094d\u0930\u0940-\u0939\u0940\u091f\u093f\u0902\u0917 \u092e\u0948\u0928\u0941\u0905\u0932 \u0938\u094d\u0935\u093f\u091a (\u092b\u093e\u0938\u094d\u091f \u0921\u0940\u0938\u0940 \u091a\u093e\u0930\u094d\u091c \u0924\u0948\u092f\u093e\u0930\u0940)",desc:"\u0928\u0947\u0935\u093f\u0917\u0947\u0936\u0928 \u092e\u093e\u0930\u094d\u0917 \u0915\u0947 \u092c\u093f\u0928\u093e \u0921\u0940\u0938\u0940 \u092b\u093e\u0938\u094d\u091f \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u092c\u0948\u091f\u0930\u0940 \u0915\u094b 25 \u0921\u093f\u0917\u094d\u0930\u0940 \u0938\u0947\u0932\u094d\u0938\u093f\u092f\u0938 \u0924\u0915 \u092a\u094d\u0930\u0940-\u0939\u0940\u091f\u093f\u0902\u0917 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},ev_v2l_power_output_expand:{name:"V2L (\u0935\u093e\u0939\u0928-\u0938\u0947-\u0932\u094b\u0921) 220V \u0906\u0909\u091f\u0932\u0947\u091f \u092a\u093e\u0935\u0930 \u0935\u093f\u0938\u094d\u0924\u093e\u0930 (3.6 \u0915\u093f\u0932\u094b\u0935\u093e\u091f)",desc:"V2L \u092c\u093e\u0939\u0930\u0940 220V AC \u0918\u0930\u0947\u0932\u0942 \u092c\u093f\u091c\u0932\u0940 \u0906\u0909\u091f\u0932\u0947\u091f \u0938\u0940\u092e\u093e \u0915\u094b 2.2 \u0915\u093f\u0932\u094b\u0935\u093e\u091f \u0938\u0947 \u092c\u0922\u093c\u093e\u0915\u0930 3.6 \u0915\u093f\u0932\u094b\u0935\u093e\u091f \u0924\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ev_one_pedal_regen_force_level3:{name:"\u090f\u0915-\u092a\u0947\u0921\u0932 \u0921\u094d\u0930\u093e\u0907\u0935 \u0905\u0927\u093f\u0915\u0924\u092e \u092a\u0941\u0928\u0930\u094d\u092f\u094b\u091c\u0940 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f",desc:"\u0935\u093e\u0939\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u092a\u0930 \u0905\u0927\u093f\u0915\u0924\u092e \u092a\u0941\u0928\u0930\u094d\u092f\u094b\u091c\u0940 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 (\u0935\u0928-\u092a\u0947\u0921\u0932 \u0938\u094d\u091f\u0949\u092a \u092e\u094b\u0921) \u0915\u094b \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},byd_soc_max_charge_target_limit:{name:"BYD \u092c\u0948\u091f\u0930\u0940 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0905\u0927\u093f\u0915\u0924\u092e \u091a\u093e\u0930\u094d\u091c \u0938\u0940\u092e\u093e (80% / 90%)",desc:"\u092c\u094d\u0932\u0947\u0921 \u092c\u0948\u091f\u0930\u0940 \u0915\u0947 \u091c\u0940\u0935\u0928\u0915\u093e\u0932 \u0915\u094b \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0927\u093f\u0915\u0924\u092e \u090f\u0938\u0940/\u0921\u0940\u0938\u0940 \u091a\u093e\u0930\u094d\u091c \u0915\u091f\u0911\u092b \u0938\u0940\u092e\u093e \u0915\u094b 80% \u092f\u093e 90% \u092a\u0930 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},byd_dmi_forced_pure_ev_speed_override:{name:"BYD DM-i \u092a\u094d\u092f\u094b\u0930 \u0908\u0935\u0940 \u092e\u094b\u0921 \u0917\u0948\u0938\u094b\u0932\u0940\u0928 \u0907\u0902\u091c\u0928 \u0913\u0935\u0930\u0930\u093e\u0907\u0921",desc:"\u092b\u0941\u0932 \u0925\u094d\u0930\u0949\u091f\u0932 \u090f\u0915\u094d\u0938\u0947\u0932\u0947\u0930\u0947\u0936\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u092d\u0940 \u0908\u0935\u0940 \u092e\u094b\u0921 \u092e\u0947\u0902 \u0917\u0948\u0938\u094b\u0932\u0940\u0928 \u0907\u0902\u091c\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u094b 130 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0924\u0915 \u0930\u094b\u0915\u0924\u093e \u0939\u0948\u0964"},byd_vtol_v2v_rescue_charge_mode:{name:"BYD VTOL (\u0935\u093e\u0939\u0928-\u0938\u0947-\u0935\u093e\u0939\u0928) \u0930\u0947\u0938\u094d\u0915\u094d\u092f\u0942 \u091a\u093e\u0930\u094d\u091c \u092e\u094b\u0921",desc:"\u0938\u0921\u093c\u0915 \u092a\u0930 \u092b\u0902\u0938\u0947 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u094b \u091a\u093e\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0939\u0930\u0940 \u090f\u0938\u0940 \u092a\u093e\u0935\u0930 \u0906\u0909\u091f\u092a\u0941\u091f \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},hyundai_ipedal_memory_lock:{name:"\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906 \u0906\u0908-\u092a\u0947\u0921\u0932 \u0935\u0928-\u092a\u0947\u0921\u0932 \u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u0947\u092e\u094b\u0930\u0940 \u0932\u0949\u0915",desc:"i-PEDAL \u0935\u0928-\u092a\u0947\u0921\u0932 \u0938\u094d\u091f\u0949\u092a \u092e\u094b\u0921 \u0915\u094b \u0930\u093f\u0935\u0930\u094d\u0938 \u092e\u0947\u0902 \u0936\u093f\u092b\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0932\u0947\u0935\u0932 3 \u092a\u0930 \u0935\u093e\u092a\u0938 \u091c\u093e\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u093e \u0939\u0948\u0964"},hyundai_utility_mode_12v_saver:{name:"\u092f\u0942\u091f\u093f\u0932\u093f\u091f\u0940 \u0915\u0948\u092e\u094d\u092a\u093f\u0902\u0917 \u092e\u094b\u0921 \u0939\u093e\u0908-\u0935\u094b\u0932\u094d\u091f\u0947\u091c 12V \u0938\u0947\u0935\u0930",desc:"\u0938\u0939\u093e\u092f\u0915 12V \u092c\u0948\u091f\u0930\u0940 \u0915\u0940 \u0916\u092a\u0924 \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0940\u0927\u0947 HV \u091f\u094d\u0930\u0948\u0915\u094d\u0936\u0928 \u092c\u0948\u091f\u0930\u0940 \u0938\u0947 220V V2L \u0906\u0909\u091f\u0932\u0947\u091f \u0915\u094b \u092a\u093e\u0935\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},hyundai_phev_no_ice_climate_start:{name:"\u092a\u0940\u090f\u091a\u0908\u0935\u0940 \u0908\u0935\u0940 \u092e\u094b\u0921 \u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f \u0939\u0940\u091f\u093f\u0902\u0917 \u0917\u0948\u0938\u094b\u0932\u0940\u0928 \u0907\u0902\u091c\u0928 \u0926\u092e\u0928",desc:"\u0917\u0948\u0938\u094b\u0932\u0940\u0928 \u0907\u0902\u091c\u0928 \u0936\u0941\u0930\u0942 \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u0915\u0947\u092c\u093f\u0928 \u091c\u0932\u0935\u093e\u092f\u0941 \u0915\u0947 \u0932\u093f\u090f \u0939\u0940\u091f \u092a\u0902\u092a / \u092a\u0940\u091f\u0940\u0938\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0939\u0940\u091f\u0930 \u0915\u094b \u092e\u091c\u092c\u0942\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_taycan_ess_sound_profile_swap:{name:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0938\u094d\u092a\u094b\u0930\u094d\u091f \u0938\u093e\u0909\u0902\u0921 (\u0908\u090f\u0938\u090f\u0938) \u091f\u093e\u092f\u0915\u0928 / \u0906\u0930\u090f\u0938 \u0908-\u091f\u094d\u0930\u0949\u0928 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",desc:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0938\u093e\u0909\u0902\u0921 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u094b \u092a\u094b\u0930\u094d\u0936\u0947 \u091f\u0947\u0915\u094d\u0915\u0928 \u091c\u0940\u091f\u0940\u090f\u0938 \u092f\u093e \u0911\u0921\u0940 \u0906\u0930\u090f\u0938 \u0908-\u091f\u094d\u0930\u0949\u0928 \u091c\u0940\u091f\u0940 \u0938\u093e\u0909\u0902\u0921 \u091c\u0928\u0930\u0947\u091f\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932\u0924\u093e \u0939\u0948\u0964"},vag_meb_daily_charge_target_menu:{name:"\u090f\u092e\u0908\u092c\u0940 \u092c\u0948\u091f\u0930\u0940 \u0926\u0948\u0928\u093f\u0915 80% / \u091f\u094d\u0930\u093f\u092a 100% \u0924\u094d\u0935\u0930\u093f\u0924 \u091a\u093e\u0930\u094d\u091c \u092c\u093e\u0930",desc:"80% \u0926\u0948\u0928\u093f\u0915 \u092c\u0948\u091f\u0930\u0940 \u0926\u0947\u0916\u092d\u093e\u0932 \u0914\u0930 100% \u091f\u094d\u0930\u093f\u092a \u091a\u093e\u0930\u094d\u091c \u0915\u0947 \u092c\u0940\u091a \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u092e\u0906\u0908\u092c\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0924\u094d\u0935\u0930\u093f\u0924 \u091f\u0949\u0917\u0932 \u092c\u093e\u0930 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"},vag_gte_generator_charge_reserve:{name:"\u091c\u0940\u091f\u0940\u0908 / \u0908-\u092e\u094b\u0921 \u0907\u0902\u091c\u0928 \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u092c\u0948\u091f\u0930\u0940 \u092b\u094b\u0930\u094d\u0938 \u091a\u093e\u0930\u094d\u091c (80%)",desc:"\u0935\u093e\u0939\u0928 \u091a\u0932\u093e\u0924\u0947 \u0938\u092e\u092f \u0926\u0939\u0928 \u0907\u0902\u091c\u0928 \u0915\u094b \u0939\u093e\u0908-\u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092c\u0948\u091f\u0930\u0940 \u0915\u094b 80% \u0924\u0915 \u0930\u093f\u091a\u093e\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u0928\u0930\u0947\u091f\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u091c\u092c\u0942\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_hans_zimmer_iconic_sounds_m:{name:"\u0939\u0902\u0938 \u091c\u093c\u093f\u092e\u0930 \u0906\u0907\u0915\u094b\u0928\u093f\u0915\u0938\u093e\u0909\u0902\u0921\u094d\u0938 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u090f\u092e-\u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u0938\u093e\u0909\u0902\u0921 \u0907\u0902\u091c\u0928",desc:"i4 \u0914\u0930 iX \u092a\u0930 \u0939\u0902\u0938 \u091c\u093c\u093f\u092e\u0930 \u0927\u094d\u0935\u0928\u093f\u0915 \u090f\u092e-\u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u090f\u0915\u094d\u0938\u0947\u0932\u0947\u0930\u0947\u0936\u0928 \u0927\u094d\u0935\u0928\u093f \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_phev_max_edrive_140kmh:{name:"\u092a\u0940\u090f\u091a\u0908\u0935\u0940 \u092e\u0948\u0915\u094d\u0938 \u0908\u0921\u094d\u0930\u093e\u0907\u0935 \u092a\u094d\u092f\u094b\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0938\u094d\u092a\u0940\u0921 \u0938\u0940\u0932\u093f\u0902\u0917 (140 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e)",desc:"330e / 530e \u092a\u094d\u0932\u0917-\u0907\u0928 \u0939\u093e\u0907\u092c\u094d\u0930\u093f\u0921 \u092a\u0930 \u0905\u0927\u093f\u0915\u0924\u092e \u0936\u0941\u0926\u094d\u0927 \u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u0917\u0924\u093f \u0938\u0940\u092e\u093e \u0915\u094b 140 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0924\u0915 \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964"},bmw_ac_charging_current_limit_menu:{name:"\u090f\u0938\u0940 \u0939\u094b\u092e \u091a\u093e\u0930\u094d\u091c\u0930 \u0905\u0927\u093f\u0915\u0924\u092e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u0940\u092e\u093e \u091a\u092f\u0928\u0915\u0930\u094d\u0924\u093e (6\u090f - 32\u090f)",desc:"\u0939\u094b\u092e \u0938\u0930\u094d\u0915\u093f\u091f \u0913\u0935\u0930\u0932\u094b\u0921 \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0938\u0940 \u0939\u094b\u092e \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917 \u0