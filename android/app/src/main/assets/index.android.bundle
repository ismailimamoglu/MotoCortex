tteryLowDesc:"Batterispenningen er p\xe5{{voltage}}. Start eller lad kj\xf8ret\xf8yet. ECU-kommunikasjon kan bli avbrutt ved lav spenning.",batteryWarn:"BATTERIET BLIVER SVAKT",batteryWarnDesc:"Batterispenning{{voltage}}. V\xe6r forsiktig under langvarige operasjoner.",rpm:"Motoromdreininger (RPM)",speed:"Kj\xf8ret\xf8yhastighet",temp:"TEMPERATUR",throttle:"Gasspjeldposisjon",status:"OVERF\xd8RINGSSTATUS",statusHigh:"H\xd8Y",statusLow:"LAVT",battery:"BATTERI",load:"LAST",intake:"INNLUFT",manifold:"MANIFOLDE kPa",customizeTitle:"DASHBOARD INNSTILLINGER",customizeSubtitle:"Velg sensorene du vil se p\xe5 skjermen (Maks. 8).",layoutType:"Layouttype",layoutGrid:"GITTER",layoutList:"LISTE",customizeButton:"TILPASS GAUGE",coolant:"Kj\xf8lev\xe6sketemp.",voltage:"Batterispenning",engineLoad:"Motorbelastning",intakeAirTemp:"Innsugslufttemp.",manifoldPressure:"Manifoldtrykk (MAP)",ambientTemp:"Utvendig temperatur",oilTemp:"Oljetemperatur",mafFlow:"MAF-luftstr\xf8m",timingAdvance:"Tenningsforstilling",fuelLevel:"Drivstoffniv\xe5",catalystTemp:"Katalysatortemp.",layoutGauge:"M\xc5LER",obdTerminalTitle:"OBD HELSE & TERMINAL",adapterClone:"KLONEADAPTER",adapterOriginal:"ORIGINAL",adapterCloneShort:"KLONE",adapterOriginalShort:"ORIGINAL",pidLabel:"PID: {{pid}}",limitReached:"Utvalgsgrense",limitReachedDesc:"Du kan velge maksimalt {{limit}} sensorer med denne protokollen.",customizeSubtitleKLine:"K-Line protokoll tilkoblet. Du kan velge maksimalt {{limit}} sensorer.",customizeSubtitleCAN:"CAN-Bus-protokoll tilkoblet. Du kan velge maksimalt {{limit}} sensorer.",unit:"Enhet",statusNormal:"NORMAL",layoutChart:"SKJEMA",adblue:"AdBlue-niv\xe5",egt:"Eksastemperatur (EGT)",nox:"NOx-sensorverdi",torque:"Motordreiemoment",selectedSensorsCount:"{{count}} / {{max}} sensorer valgt"},expertise:{historyFound:"KJ\xd8RET\xd8YHISTORIE FUNNET!",historyFoundDesc:"{{count}}poster for dette kj\xf8ret\xf8yet er tidligere opprettet. Du kan se gjennom historien nedenfor.",viewHistory:"SE HISTORIEN \u203a",manualVin:"CHASSISNUMMER (MANUELL INNLEGGING)",manualVinDesc:"Hvis kj\xf8ret\xf8yets datamaskin ikke deler chassisnummeret (VIN) automatisk, kan du skrive det her.",vinPlaceholder:"Skriv inn VIN...",startScan:"START EKSPERTSKANNING",scanning:"SKANNER...",vehicleIdentity:"KJ\xd8RET\xd8Y ID OG KILESTAND",vin:"Chassisnummer (VIN)",odometer:"Original KM",distSinceCleared:"Feil fjernet",milDist:"Motorlys p\xe5",dtcTitle:"Feilkoder (DTC)",dtcClean:"INGEN FEILKODER - RENGJ\xd8R",extraActions:"EKSTRA TRANSAKSJONER",garageTitle:"GARASJE OG TIDLIGERE REKORDER",share:"DEL",saveVehicle:"LAGRE DETTE VERKT\xd8YET",noRecords:"Det er ingen registrerte kj\xf8ret\xf8y enn\xe5.",clean:"RENGJ\xd8R",faults:"FEIL",vinRequired:"VIN p\xe5krevd",vinRequiredDesc:"For \xe5 registrere seg m\xe5 chassisnummeret (VIN) vises automatisk eller skrives manuelt.",missingInfo:"Manglende informasjon",missingInfoDesc:"Fyll ut feltet Merke og modell.",saved:"Lagret ",savedDesc:"Den ble lagt til garasjen som f\xf8lge av ekspertisen.",connRequired:"Tilkobling n\xf8dvendig",connRequiredDesc:"Koble til kj\xf8ret\xf8yet f\xf8rst for \xe5 starte denne prosessen.",chronicFaultsTitle:"Statistiske kroniske problemer",chronicFaultsObs:"{{code}}(Observasjon:{{days}}Annen dag / totalt:{{total}}ganger)",chronicFaultsPending:"Samle datapool / analysere statistikk",notScanned:"Ikke skannet",notScannedDesc:"Trykk p\xe5 skanneknappen \xf8verst til h\xf8yre for \xe5 lese diagnosekoder.",scanFailed:"SKANNING MISLYKKET",errTimeout:"Error: Connection Timeout (TIMEOUT)\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost (CONNECTION_LOST)\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\n(HARDWARE_FATAL_RECOVERY_FAILED)\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error (ERROR_UNABLE_TO_READ)\nECU trouble codes could not be read.",scannedSystems:"SKANNEDE SYSTEMER",moduleEngine:"Motorkontrollenhet (ECU)",moduleAbs:"Blokkeringsfritt bremsesystem (ABS)",moduleTcm:"Transmisjonskontrollmodul (TCM)",moduleBcm:"Body Control Module (BCM)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" SIKKERHETSADVARSEL",safetyWarningDesc:"Under denne prosessen: \u2022 Tenningen m\xe5 v\xe6re P\xc5 \u2022 Motoren m\xe5 v\xe6re AV \u2022 Ikke start kj\xf8ret\xf8yet Vil du fortsette?",step1:"Trinn 1: Slett feilkoder",step1Desc:"Alle lagrede feilkoder (DTC) og Kontroller motor-lampen vil bli slettet. Drivstofftrimverdier vil bli tilbakestilt. Denne handlingen kan ikke angres!",step2:"Trinn 2: ECU hard tilbakestilling",step2Desc:"En elektrisk tilbakestilling (Hard Reset) vil bli sendt til motordatamaskinen. Det fungerer som \xe5 ta ut og sette inn batteriet. Det er ineffektivt i ikke-st\xf8ttende ECUer. Det gj\xf8r ingen skade.",clearCodes:"Slett koder",ecuReset:"Fjern feilkoder",finish:"Hopp over (Fullf\xf8r)",completed:"Fullf\xf8rt ",completedDesc:"Tjenesteoperasjoner er fullf\xf8rt. Du kan starte kj\xf8ret\xf8yet p\xe5 nytt.",hardResetDesc:"Alle serviceoperasjoner er fullf\xf8rt. \u2022 Feilkoder slettet \u2022 Drivstofftrim tilbakestilles \u2022 ECU tilbakestilt Du kan starte kj\xf8ret\xf8yet p\xe5 nytt."},info:{desc:"Profesjonell motorsykkel- og kj\xf8ret\xf8ydiagnoseapplikasjon. Kompatibel med alle kj\xf8ret\xf8y.",upgrade:" Oppgrader til Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"Tidlig tilgang ",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner er for tiden under utvikling. Siden du er v\xe5r tidlige bruker, er alle profesjonelle funksjoner tilgjengelige for deg n\xe5. Din tilbakemelding er veldig verdifull for oss!",helpGuide:"HJELP OG VEILEDNING",language:" Spr\xe5k / Spr\xe5k / Bahasa",support:"ST\xd8TTESENTER",supportSubject:"Cortex OBD2 Diagnostic Scanner-st\xf8tte og tilbakemelding",thanks:"Takk!",thanksDesc:"Takk for tilbakemeldingen. Du kan legge igjen en kommentar p\xe5 Play Store.",sections:{live:{title:"LIVE OVERV\xc5KNINGSSENSORER",content:"Du kan umiddelbart overv\xe5ke turtall, hastighet, motortemperatur, gassposisjon, batterispenning, motorbelastning, innsugningslufttemperatur og manifoldtrykk (MAP). Verdiene oppdateres 1-5 ganger per sekund avhengig av Bluetooth-hastigheten din. Du kan gripe direkte inn i kj\xf8ret\xf8yet med UDS / OBD-kommandoer via terminalen."},expertise:{title:"EKSAMEN OG GARANTI",content:"Applikasjonen bruker ECU (hjerne)-koder for \xe5 oppdage feil. VIN-nummeret (VIN) og gjeldende kj\xf8relengde registrert p\xe5 kj\xf8ret\xf8yet registreres. I tillegg bestemmes tidligere feil ved \xe5 beregne hvor langt kj\xf8ret\xf8yet har kj\xf8rt med Check Engine-lyset. Den resulterende rapporten kan deles i PDF- og meldingsmilj\xf8er."},tests:{title:"BATTERI / YTELSESTESTER",content:"Batteritesting har 3 trinn: Tester for hvile, sveiving og tomgangslading m\xe5ler batteriets/regulatorens helse. Ytelsestesten m\xe5ler 0-60 og 0-100 km/t akselerasjonsverdier med en feilmargin p\xe5 50ms, ved \xe5 bruke \xf8yeblikkelig hastighetsdata fra telefonens prosessor og kj\xf8ret\xf8yet ditt."},hardware:{title:"MASKINVAREKOMPATIBILITET",content:"ELM327 Bluetooth (v1.5) anbefales. Noen avanserte koder fungerer kanskje ikke p\xe5 maskinvare av d\xe5rlig kvalitet med v2.1 CLONE-versjon. Du f\xe5r den raskeste hastigheten med premium-adaptere som vLinker og OBDLink."},warnings:{title:"VIKTIGE ADVARSLER",content:"\u2022 Tenningen m\xe5 v\xe6re P\xc5 og motoren AV under feilkodesletteprosessen eller ECU-tilbakestillingsfunksjonen. \u2022 Ikke send en tilbakestilling til et kj\xf8rende kj\xf8ret\xf8y. \u2022 Ikke alle kj\xf8ret\xf8y st\xf8tter kanskje alle sensorer, sensorer som ikke st\xf8ttes vil vise \"--\"."},onboarding:{title:"JURIDISKE TILLATELSER OG ANONYM TELEMETRI",content:"For \xe5 forbedre applikasjonskvaliteten og kj\xf8ret\xf8ykompatibiliteten; Fullstendig anonymiserte motorparametere og feilkoder generert under feildiagnose (uten \xe5 inneholde personopplysninger og chassisnummer) kan analyseres p\xe5 v\xe5re sikre servere. Ved \xe5 fortsette godtar du disse anonyme telemetrivilk\xe5rene. Bluetooth og posisjonstillatelser kreves for \xe5 kommunisere med motorsykkelens ECU."},featureCoding:{title:"SKJULT FUNKSJON L\xc5S OP OG UDS-KODING",content:"Drevet av v\xe5r ISO 14229 UDS-protokollmotor, kan du trygt bytte funksjoner som amerikanske parkeringslys, n\xe5lesveip, hornl\xe5s, komfortvinduer og DRL-innstillinger for VAG-, BMW-, Renault- og Dacia-kj\xf8ret\xf8yer."},multiEcu:{title:"MULTI-ECU SKANNING AV ALLE MODUL",content:"Skann og fjern feilkoder utenfor motorens ECU \u2013 inkludert ABS, kollisjonspute, automatisk girkasse (TCU), instrumentgruppe, klimakontroll (HVAC) og kroppskontrollmoduler (BCM)."},advancedDiagnostics:{title:"DCT TILPASNING, DPF & HP POWER GAUGE",content:"\u2022 DCT / DSG Clutch Kiss Point Learning & Adaptation Reset\n\u2022 DPF sotbelastning (%/g) og eksosregenereringstemperaturoverv\xe5king\n\u2022 Sanntids kort/langsiktig drivstofftrim (STFT/LTFT) og lambdaanalyse\n\u2022 Dynamisk hestekrefter (HK) & dreiemoment (Nm) direkte telemetrigraf"},demoMode:{title:"DEMOMODUS (SIMULASJON)",content:"Test og utforsk appen uten fysisk OBD2-maskinvare. Opplev fulle CAN-Bus- og UDS-diagnosefunksjoner med realistisk telemetrisimulering i sanntid."}},reconfigurePermissions:"Vis tillatelser og juridiske vilk\xe5r p\xe5 nytt",shareWithFriend:"DEL MED EN VENN",shareMessageText:"Oppdag bilens ECU-feilkoder og levende sensortelemetri med Cortex OBD2 Diagnostic Scanner!\n\nLast ned n\xe5:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:" \u2550\u2550\u2550 CORTEX OBD2 DIAGNOSTISK RAPPORT \u2550\u2550\u2550 ",vehicleIdentity:" KJ\xd8RET\xd8Y ID",vin:"Chassisnummer (VIN)",odometer:"Avstand (KM)",milDist:"Motorlys p\xe5",distSinceCleared:"Feil fjernet",dtcCount:" FEILKODER ({{count}}mengde)",sensorData:" LIVE SENSORDATA",noData:"Kunne ikke lese data",proApp:"Skannet med Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"dato",vinNotFound:"Ikke oppdaget",noDtcs:"INGEN FEILKODER - RENGJ\xd8R",speed:"hastighet",coolant:"Motortemperatur",throttle:"gass",engineLoad:"Motorbelastning",intakeAir:"Innsug luft",voltage:"Batterispenning",shareMessage:"F\xf8lg statusen til motorsykkelen din fra lommen med Motocortex OBD2 Diagnostic Application! Last ned: https://cortexobd2.app",manifold:"Manifold",subtitle:"Omfattende brukte diagnose- og telemetriinspeksjon",vehicleInfo:"Kj\xf8ret\xf8ysidentifikasjon og ECU-metadata",healthScore:"Samlet helsepoeng for ECU",dtcSection:"Diagnostiske feilkoder (DTC-revisjon)",telemetrySection:"Direkte telemetri og sensorsnapshot",maintenanceSection:"Ak\u0131ll\u0131 Garaj Service- og vedlikeholdshistorikk",aiSection:"AI-lege overordnet tilstandsanalyse",noFaults:"Ingen aktive eller historiske feilkoder lagret i ECU-minnet.",noMaintenance:"Ingen registrerte tjenesteoppf\xf8ringer i Ak\u0131ll\u0131 Garaj.",disclaimer:"Ansvarsfraskrivelse: Denne rapporten er generert av MotoCortex diagnoseprogramvare. Fysisk inspeksjon av en sertifisert tekniker anbefales f\xf8r anskaffelse av kj\xf8ret\xf8y.",shareTitle:"Del MotoCortex vurderingsrapport"},battery:{title:"BATTERI OG STARTTEST",ready:"Klar til \xe5 begynne \xe5 teste.",restingStatus:"Tenning p\xe5, motor av... Batterispenning leses...",crankingStatus:"STARTER N\xc5! (M\xe5lingen vil bli utf\xf8rt i 5 sekunder)",chargingStatus:"Motoren g\xe5r p\xe5 tomgang... Ladespenning leses...",doneStatus:"Testing fullf\xf8rt!",voltageError:"Spenningen kunne ikke leses. Sjekk tilkoblingen.",retry:"GJENTA TEST",procedure:"TESTPROSEDYRE",steps:{1:"1. Tenning p\xe5, motor av \u2192 Hvilespenning m\xe5les",2:"2. N\xe5r meldingen \"START N\xc5\" vises, start motoren.",3:"3. Laveste spenning registrert i 5 sekunder",4:"4. Lade/regulatorspenning m\xe5les mens motore