miter_config:{name:"\u041f\u043e\u0440\u0456\u0433 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u043d\u0430 \u043f\u0456\u0442-\u043b\u0435\u0439\u043d",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u043e\u0431\u043c\u0435\u0436\u0443\u0432\u0430\u0447\u0430 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u043d\u0430 \u043f\u0456\u0442-\u043b\u0435\u0439\u043d \u0434\u043e 60 \u043a\u043c/\u0433\u043e\u0434 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430\u0445 \u043d\u0430 \u043a\u0435\u0440\u043c\u0456."},ducati_desmo_service_light_reset:{name:"\u0421\u043a\u0438\u0434\u0430\u043d\u043d\u044f \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043b\u0430\u043f\u0430\u043d\u0430 Oil & Desmo",desc:"\u041e\u0447\u0438\u0449\u0430\u0454 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043b\u0430\u043f\u0430\u043d\u0430 Desmodromic \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u0456\u0432."},ktm_quickshifter_plus_delay_tuning:{name:"Quickshifter+ Shift Cut Cut Time & Delay \u0422\u043e\u0447\u043d\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f",desc:"\u041d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0454 \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u0432\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u043e\u0436\u043d\u0443 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u0434\u043b\u044f \u043f\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u