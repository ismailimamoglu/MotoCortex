1\u03b1\u03c2, \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03ba\u03b1\u03c5\u03c3\u03b1\u03b5\u03c1\u03af\u03c9\u03bd \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03b1\u03bd\u03b1\u03b3\u03ad\u03bd\u03bd\u03b7\u03c3\u03b7\u03c2",sootLoad:"\u0395\u03a0\u0399\u03a0\u0395\u0394\u039f \u03a6\u039f\u03a1\u03a4\u03a9\u03a3\u0397\u03a3 \u039a\u0391\u0398\u0391\u03a1\u0399\u0391\u03a3",ashLoad:"\u0395\u03a0\u0399\u03a0\u0395\u0394\u039f \u03a3\u03a5\u03a3\u03a9\u03a1\u0395\u03a5\u03a3\u0397\u03a3 \u03a4\u03ad\u03c6\u03c1\u03b1\u03c2",egtTemp:"EXHAUST GAS TEMP (EGT)",diffPressure:"\u0394\u0399\u0391\u03a6\u039f\u03a1\u0399\u039a\u0397 \u03a0\u0399\u0395\u03a3\u0397",stateOptimal:"DPF CLEAN & HEALTHY (0% - 40%)",stateModerate:"DPF MODERATE LOADING (40% - 65%)",stateHighSoot:"HIGH SOOT ACCUMULATION (65% - 85%)",stateCriticalClogged:"CRITICAL CLOGGING (85%+)",egtCold:"Cold (< 300\xb0C)",egtWarm:"Warmed Up (300\xb0C - 550\xb0C)",egtRegenActive:"REGENERATION ACTIVE (550\xb0C+)",recommendNormal:"\u0397 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c6\u03af\u03bb\u03c4\u03c1\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b2\u03ad\u03bb\u03c4\u03b9\u03c3\u03c4\u03b7. \u03a3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03c4\u03b5 \u03ba\u03b1\u03bd\u03bf\u03bd\u03b9\u03ba\u03ac \u03c4\u03b7\u03bd \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7.",recommendMonitor:"\u03a3\u03c5\u03c3\u03c3\u03ce\u03c1\u03b5\u03c5\u03c3\u03b7 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7. \u03a3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b7.",recommendHighwayDrive:"Drive on highway for 20 mins at 2000-2500 RPM (Passive Regen).",recommendServiceRegen:"\u03a4\u03bf \u03c6\u03af\u03bb\u03c4\u03c1\u03bf \u03ad\u03c7\u03b5\u03b9 \u03b2\u03bf\u03c5\u03bb\u03ce\u03c3\u03b5\u03b9! \u0391