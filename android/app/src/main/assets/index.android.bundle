u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",simulationBanner:"\u0648\u0636\u0639 \u0627\u0644\u0645\u062d\u0627\u0643\u0627\u0629 \u2014 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0641\u064a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u063a\u064a\u0631 \u0646\u0634\u0637\u0629 \u0628\u0639\u062f",closeBtn:"\u0625\u063a\u0644\u0627\u0642",unsupportedOk:"OK",disclaimerTitle:"\u0625\u062e\u0644\u0627\u0621 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629",disclaimerFeature:"\u0645\u064a\u0632\u0629",disclaimerBody:"\u064a\u0624\u062b\u0631 \u062a\u063a\u064a\u064a\u0631 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0628\u0634\u0643\u0644 \u0645\u0628\u0627\u0634\u0631 \u0639\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0635\u0646\u0639 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0633\u064a\u0627\u0631\u062a\u0643 \u0648\u0628\u0631\u0646\u0627\u0645\u062c \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629. \u064a\u0631\u062c\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0628\u0639\u0646\u0627\u064a\u0629: \u2022 \u0642\u062f \u064a\u0624\u062f\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u063a\u064a\u0631 \u0627\u0644\u0635\u062d\u064a\u062d \u0625\u0644\u0649 \u0625\u0628\u0637\u0627\u0644 \u0636\u0645\u0627\u0646 \u0633\u064a\u0627\u0631\u062a\u0643.\n\u2022 \u0642\u062f \u062a\u0624\u062f\u064a \u0628\u0639\u0636 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0625\u0644\u0649 \u062d\u062f\u0648\u062b \u0623\u0639\u0637\u0627\u0644 \u062f\u0627\u0626\u0645\u0629 \u0623\u0648 \u0623\u062e\u0637\u0627\u0621 \u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639\u0629.\n\u2022 \u0641\u064a \u062d\u064a\u0646 \u0623\u0646 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0642\u062f \u062a\u0643\u0648\u0646 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0639\u0643\u0633\u060c \u0625\u0644\u0627 \u0623\u0646 \u0628\u0639\u0636 \u0648\u062d\u062f\u0627\u062a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0642\u062f \u062a\u062a\u0637\u0644\u0628 \u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0627\u0644\u0645\u0635\u0646\u0639.\n\u2022 \u064a\u062a\u062d\u0645\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u062d\u062f\u0647 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0623\u064a \u0636\u0631\u0631 \u0645\u0627\u062f\u064a \u0623\u0648 \u063a\u064a\u0631 \u0645\u0627\u062f\u064a \u0646\u0627\u062a\u062c \u0639\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629.\n\u2022 \u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u062d\u0645\u064a\u0644 Cortex Obd2 Diagnostic Scanner \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0623\u064a \u062e\u0644\u0644 \u0623\u0648 \u0636\u0631\u0631 \u0646\u0627\u062a\u062c \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a. \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646\u0643 \u0642\u0631\u0623\u062a \u0647\u0630\u0627 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0648\u0641\u0647\u0645\u062a\u0647.",checkboxTitle:"\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0645\u0637\u0644\u0648\u0628",check1:"\u0644\u0642\u062f \u0642\u0631\u0623\u062a \u0647\u0630\u0627 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0648\u0623\u062f\u0631\u0643\u062a \u0623\u0646 \u0636\u0645\u0627\u0646 \u0633\u064a\u0627\u0631\u062a\u064a \u0642\u062f \u064a\u062a\u0623\u062b\u0631.",check2:"\u0623\u0642\u0631 \u0628\u0623\u0646 Cortex Obd2 Diagnostic Scanner \u0644\u064a\u0633 \