9\u3002"},tesla_regen_brake_strength:{name:"\u56de\u751f\u5236\u52d5\u529b\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb (Tesla)",desc:"\u30a2\u30af\u30bb\u30eb\u30da\u30c0\u30eb\u306e\u30ea\u30d5\u30c8\u30aa\u30d5\u30a8\u30cd\u30eb\u30ae\u30fc\u56de\u751f\u5f37\u5ea6\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"},tesla_walkaway_door_lock:{name:"\u30a6\u30a9\u30fc\u30af\u30a2\u30a6\u30a7\u30a4\u96fb\u8a71\u30ad\u30fc\u81ea\u52d5\u30c9\u30a2\u30ed\u30c3\u30af (Tesla)",desc:"\u30c9\u30a2\u3092\u30ed\u30c3\u30af\u3057\u3001\u96fb\u8a71\u30ad\u30fc\u304c\u96e2\u308c\u308b\u3068\u30db\u30fc\u30f3\u304c\u9cf4\u3063\u3066\u78ba\u8a8d\u3057\u307e\u3059\u3002"},tesla_acceleration_boost_unlock:{name:"\u30d1\u30ef\u30fc\u30c8\u30ec\u30a4\u30f3\u52a0\u901f\u30d6\u30fc\u30b9\u30c8\u30c9\u30e9\u30a4\u30d6\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb (Tesla)",desc:"\u96fb\u6c17\u30e2\u30fc\u30bf\u30fc\u306e\u30a4\u30f3\u30d0\u30fc\u30bf\u30fc\u5fdc\u7b54\u3092\u30b7\u30e3\u30fc\u30d7\u306b\u3057\u30010 \uff5e 100 km/h \u306e\u30bf\u30a4\u30e0\u3092\u77ed\u7e2e\u3057\u307e\u3059\u3002"},tesla_interior_ambient_color:{name:"\u30ad\u30e3\u30d3\u30f3\u8db3\u5143\u5468\u56f2\u7167\u660e\u30ab\u30e9\u30fc\u30d7\u30ea\u30bb\u30c3\u30c8 (Tesla)",desc:"LED \u8db3\u5143\u5468\u56f2\u5149 RGB \u30ab\u30e9\u30fc \u30d1\u30ec\u30c3\u30c8\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002"},audi_matrix_led_animation:{name:"\u30de\u30c8\u30ea\u30c3\u30af\u30b9 LED \u30d8\u30c3\u30c9\u30e9\u30a4\u30c8 \u30c0\u30a4\u30ca\u30df\u30c3\u30af \u30a6\u30a7\u30eb\u30ab\u30e0 \u30e9\u30a4\u30c8 \u30c0\u30f3\u30b9 (\u30a2\u30a6\u30c7\u30a3)",desc:"\u8eca\u4e21\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3059\u308b\u3068\u3001\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u5149\u306e\u632f\u308a\u4ed8\u3051\u304c\u518d\u751f\u3055\u308c\u307e\u3059\u3002"},audi_mmi_startup_screen:{name:"MMI \u30bf\u30c3\u30c1 \u30b9\u30af\u30ea\u30fc\u30f3 \u30d6\u30fc\u30c8 \u30b0\u30e9\u30d5\u30a3\u30c3\u30af \u30c6\u30fc\u30de (\u30a2\u30a6\u30c7\u30a3)",desc:"MMI \u4e2d\u592e\u753b\u9762\u306e\u8d77\u52d5\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3 (S / RS / e-tron) \u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002"},audi_drive_select_efficiency:{name:"Audi Drive Select \u306e\u52b9\u7387\u904b\u8ee2\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb (Audi)",desc:"\u30c9\u30e9\u30a4\u30d6\u9078\u629e\u30aa\u30d7\u30b7\u30e7\u30f3\u3067\u71c3\u6599\u7bc0\u7d04\u52b9\u7387\u30e2\u30fc\u30c9\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002"},audi_laptimer_boost_display:{name:"\u30e9\u30c3\u30d7\u30bf\u30a4\u30de\u30fc & \u30bf\u30fc\u30dc\u30d0\u30fc\u5727\u529b\u8a08\u30aa\u30fc\u30d0\u30fc\u30ec\u30a4 (\u30a2\u30a6\u30c7\u30a3)",desc:"\u30d0\u30fc\u30c1\u30e3\u30eb\u30b3\u30c3\u30af\u30d4\u30c3\u30c8\u4e0a\u306b\u30c8\u30e9\u30c3\u30af\u30e9\u30c3\u30d7\u30bf\u30a4\u30de\u30fc\u3068\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u30bf\u30fc\u30dc\u30d6\u30fc\u30b9\u30c8\u8a08\u3092\u8868\u793a\u3057\u307e\u3059\u3002"},audi_needle_sweep_gauge:{name:"\u30b9\u30dd\u30fc\u30c4\u30b2\u30fc\u30b8\u306e\u30cb\u30fc\u30c9\u30eb\u30b9\u30a4\u30fc\u30d7\u691c\u8a3c\uff08\u30a2\u30a6\u30c7\u30a3\uff09",desc:"\u59cb\u52d5\u6642\u306b\u30bf\u30b3\u30e1\u30fc\u30bf\u30fc\u3068\u30b9\u30d4\u30fc\u30c9\u30e1\u30fc\u30bf\u30fc\u306e\u5168\u91dd\u30b9\u30a4\u30fc\u30d7\u30c6\u30b9\u30c8\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002"},skoda_coming_home_lights:{name:"\u51fa\u767a/\u5e30\u5b85\u7167\u660e\u30bf\u30a4\u30de\u30fc (\u30b7\u30e5\u30b3\u30c0)",desc:"\u8eca\u4e21\u964d\u8eca\u5f8c\u306e\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u70b9\u706f\u30bf\u30a4\u30de\u30fc\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},skoda_comfort_turn_signal:{name:"\u30b3\u30f3\u30d5\u30a9\u30fc\u30c8\u30a4\u30f3\u30b8\u30b1\u30fc\u30bf\u30fc\u30d1\u30eb\u30b9\u6570\u8abf\u6574 (\u30b7\u30e5\u30b3\u30c0)",desc:"\u30ef\u30f3\u30bf\u30c3\u30c1\u30a6\u30a4\u30f3\u30ab\u30fc\u70b9\u6ec5\u56de\u6570\u30923\uff5e5\u56de\u306e\u9593\u3067\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},cupra_sport_display_menu:{name:"\u30ad\u30e5\u30d7\u30e9\u6f14\u594f\u697d\u5668\uff06G\u30e1\u30fc\u30bf\u30fc\u30e1\u30cb\u30e5\u30fc\uff08\u30ad\u30e5\u30d7\u30e9\uff09",desc:"G\u30d5\u30a9\u30fc\u30b9\u30e1\u30fc\u30bf\u30fc\u3001kW\u30d1\u30ef\u30fc\u30b2\u30fc\u30b8\u3001\u6cb9\u6e29\u8868\u793a\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3057\u307e\u3059\u3002"},cupra_virtual_cockpit_copper:{name:"Copper \u30c6\u30fc\u30de\u306e\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9 \u30a2\u30af\u30bb\u30f3\u30c8 \u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30b9 (Cupra)",desc:"\u7279\u5fb4\u7684\u306a\u30ad\u30e5\u30d7\u30e9\u9285\u30e1\u30bf\u30ea\u30c3\u30af\u30a2\u30af\u30bb\u30f3\u30c8\u30c6\u30fc\u30de\u3092\u30b2\u30fc\u30b8\u30af\u30e9\u30b9\u30bf\u30fc\u306b\u9069\u7528\u3057\u307e\u3059\u3002"},vag_brake_disc_drying:{name:"\u96e8\u5929\u6642\u306e\u30d6\u30ec\u30fc\u30ad\u30c7\u30a3\u30b9\u30af\u62ed\u304d\u53d6\u308a\u30fb\u4e7e\u71e5\u6a5f\u80fd\uff08VAG\uff09",desc:"\u96e8\u5929\u6642\u306b\u306f\u4e7e\u71e5\u3057\u305f\u30ed\u30fc\u30bf\u30fc\u306b\u5b9a\u671f\u7684\u306b\u6700\u5c0f\u9650\u306e\u30d1\u30c3\u30c9\u5727\u529b\u3092\u52a0\u3048\u307e\u3059\u3002"},vag_tourist_mode_lights:{name:"\u30c4\u30fc\u30ea\u30b9\u30c8\u30e2\u30fc\u30c9\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u30d3\u30fc\u30e0\u30d1\u30bf\u30fc\u30f3 (VAG)",desc:"\u6d77\u5916\u3067\u306e\u904b\u8ee2\u6642\u306b\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u306e\u30d3\u30fc\u30e0\u30d1\u30bf\u30fc\u30f3\u3092\u5de6\u30cf\u30f3\u30c9\u30eb\u3068\u53f3\u30cf\u30f3\u30c9\u30eb\u306b\u5207\u308a\u66ff\u3048\u307e\u3059\u3002"},vag_hood_warning_mute:{name:"\u30dc\u30f3\u30cd\u30c3\u30c8\u30aa\u30fc\u30d7\u30f3\u8a08\u5668\u30c1\u30e3\u30a4\u30e0\u30df\u30e5\u30fc\u30c8 (VAG)",desc:"\u30d5\u30fc\u30c9\u306e\u30e9\u30c3\u30c1\u304c\u5916\u3055\u308c\u3066\u3044\u308b\u3068\u304d\u306b\u6301\u7d9a\u3059\u308b\u8a08\u5668\u8b66\u544a\u30c1\u30e3\u30a4\u30e0\u3092\u6291\u5236\u3057\u307e\u3059\u3002"},vag_emergency_brake_hazard:{name:"\u7dca\u6025\u30d6\u30ec\u30fc\u30ad\u81ea\u52d5\u30cf\u30b6\u30fc\u30c9\u30d5\u30e9\u30c3\u30b7\u30e3\u30fc (VAG)",desc:"ABS \u306e\u30cf\u30fc\u30c9\u7dca\u6025\u505c\u6b62\u4e2d\u306b\u30cf\u30b6\u30fc\u30c9 \u30e9\u30a4\u30c8\u304c\u9ad8\u901f\u70b9\u6ec5\u3057\u307e\u3059\u3002"},vag_sunroof_comfort_open:{name:"\u30b5\u30f3\u30eb\u30fc\u30d5 \u30c1\u30eb\u30c8 / \u30aa\u30fc\u30d7\u30f3 \u30ea\u30e2\u30fc\u30c8 \u30b3\u30f3\u30d5\u30a9\u30fc\u30c8 \u30ad\u30fc \u30d5\u30a9\u30d6 \u30ed\u30b8\u30c3\u30af (VAG)",desc:"\u30b5\u30f3\u30eb\u30fc\u30d5\u3092\u50be\u3051\u308b\u304b\u5b8c\u5168\u306b\u958b\u304f\u3088\u3046\u306b\u3001\u30ea\u30e2\u30fc\u30c8 \u30ad\u30fc \u30db\u30fc\u30eb\u30c9 \u30a2\u30af\u30b7\u30e7\u30f3\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},bmw_ecopro_display_variant:{name:"ECO PRO \u30a4\u30f3\u30b9\u30c8\u30eb\u30e1\u30f3\u30c8 \u30af\u30e9\u30b9\u30bf\u30fc \u30b2\u30fc\u30b8 \u30b9\u30bf\u30a4\u30ea\u30f3\u30b0 (BMW)",desc:"\u9752\u3044 ECO PRO \u52b9\u7387\u30b2\u30fc\u30b8\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af \u30c6\u30fc\u30de\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002"},bmw_volume_bar_hud:{name:"\u30d8\u30c3\u30c9\u30a2\u30c3\u30d7 \u30c7\u30a3\u30b9\u30d7\u30ec\u30a4 \u30aa\u30fc\u30c7\u30a3\u30aa \u30dc\u30ea\u30e5\u30fc\u30e0 \u30ec\u30d9\u30eb \u30d0\u30fc \u30aa\u30fc\u30d0\u30fc\u30ec\u30a4 (BMW)",desc:"\u97f3\u91cf\u5909\u66f4\u30d0\u30fc\u3092 HUD \u6295\u5f71\u4e0a\u306b\u76f4\u63a5\u8868\u793a\u3057\u307e\u3059\u3002"},bmw_anti_dazzle_mirror:{name:"\u30a8\u30ec\u30af\u30c8\u30ed\u30af\u30ed\u30df\u30c3\u30af\u9632\u7729\u30df\u30e9\u30fc\u8abf\u5149\u611f\u5ea6 (BMW)",desc:"\u81ea\u52d5\u30d0\u30c3\u30af\u30df\u30e9\u30fc\u8abf\u5149\u30d5\u30a9\u30c8\u30bb\u30f3\u30b5\u30fc\u306e\u3057\u304d\u3044\u5024\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"},bmw_camera_pdc_warning_mute:{name:"PDC \u304a\u3088\u3073\u30b5\u30e9\u30a6\u30f3\u30c9\u30d3\u30e5\u30fc\u901f\u5ea6\u306e\u30ab\u30c3\u30c8\u30aa\u30d5\u901f\u5ea6\u8abf\u6574 (BMW)",desc:"\u99d0\u8eca\u30ab\u30e1\u30e9\u304c\u30aa\u30d5\u306b\u306a\u308b\u8eca\u901f\u306e\u3057\u304d\u3044\u5024\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"},toyota_pcs_distance_preset:{name:"\u30d7\u30ea\u30b3\u30ea\u30b8\u30e7\u30f3 \u30b7\u30b9\u30c6\u30e0 (PCS) \u306e\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u8b66\u5831\u8ddd\u96e2 (\u30c8\u30e8\u30bf)",desc:"\u30ec\u30fc\u30c0\u30fc\u524d\u65b9\u885d\u7a81\u8b66\u544a\u8ddd\u96e2\u306e\u521d\u671f\u611f\u5ea6\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},toyota_bsm_timing:{name:"\u30d6\u30e9\u30a4\u30f3\u30c9\u30b9\u30dd\u30c3\u30c8\u30e2\u30cb\u30bf\u30fc\uff08BSM\uff09\u8b66\u544a \u8b66\u544a\u30bf\u30a4\u30df\u30f3\u30b0\uff08\u30c8\u30e8\u30bf\uff09",desc:"\u6b7b\u89d2\u30b5\u30a4\u30c9\u30df\u30e9\u30fc\u8b66\u544a\u706f\u306e\u70b9\u706f\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"},toyota_ac_noise_reduction:{name:"A/C\u30b3\u30f3\u30d7\u30ec\u30c3\u30b5\u30fc\u30d6\u30ed\u30ef\u30fc\u9a12\u97f3\u4f4e\u6e1b\u30e2\u30fc\u30c9\uff08\u30c8\u30e8\u30bf\uff09",desc:"\u8eca\u5185\u306e\u9759\u7c9b\u6027\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u7a7a\u8abf\u30d6\u30ed\u30ef\u30fc\u30d5\u30a1\u30f3\u306e\u6700\u5927\u901f\u5ea6\u3092\u5236\u9650\u3057\u307e\u3059\u3002"},toyota_sflow_control:{name:"S-Flow \u30b9\u30de\u30fc\u30c8 \u30af\u30e9\u30a4\u30e1\u30fc\u30c8 1 \u4eba\u4e57\u308a\u30e2\u30fc\u30c9 (\u30c8\u30e8\u30bf)",desc:"\u91cd\u91cf\u30bb\u30f3\u30b5\u30fc\u306b\u57fa\u3065\u3044\u3066\u3001A/C \u306e\u6c17\u6d41\u3092\u7740\u5e2d\u3057\u3066\u3044\u308b\u5ea7\u5e2d\u306e\u307f\u306b\u9001\u308a\u307e\u3059\u3002"},toyota_relock_timeout:{name:"\u30ea\u30e2\u30fc\u30c8\u30a2\u30f3\u30ed\u30c3\u30af\u5f8c\u306e\u81ea\u52d5\u518d\u30ed\u30c3\u30af\u9045\u5ef6\u30bf\u30a4\u30de\u30fc (\u30c8\u30e8\u30bf)",desc:"\u30c9\u30a2\u304c\u958b\u3044\u3066\u3044\u306a\u3044\u5834\u5408\u306b\u30c9\u30a2\u304c\u8