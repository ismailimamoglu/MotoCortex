l',nameKey:'dashboard.fuelLevel',defaultName:'Yak\u0131t Seviyesi',unit:'%',pid:'01 2F',icon:'',color:'#0ea5e9',isHighPriority:!1},{key:'catalystTemp',nameKey:'sensor.catalystTemp',defaultName:'Kat. S\u0131cakl\u0131\u011f\u0131',unit:'\xb0C',pid:'01 3C',icon:'',color:'#dc2626',isHighPriority:!1},{key:'turboBoost',nameKey:'sensor.boost',defaultName:'Turbo \u015earj Bas\u0131nc\u0131',unit:'kPa',pid:'01 0B',icon:'',color:'#ea580c',isHighPriority:!0},{key:'widebandAfr',nameKey:'sensor.widebandAfr',defaultName:'Geni\u015f Bant O2 / AFR',unit:'AFR',pid:'01 34',icon:'',color:'#14b8a6',isHighPriority:!0},{key:'transTemp',nameKey:'sensor.transTemp',defaultName:'\u015eanz\u0131man S\u0131cakl\u0131\u011f\u0131',unit:'\xb0C',pid:'01 7C',icon:'',color:'#d97706',isHighPriority:!1},{key:'ethanolPercent',nameKey:'sensor.ethanol',defaultName:'Etanol Oran\u0131 %',unit:'%',pid:'01 52',icon:'',color:'#10b981',isHighPriority:!1},{key:'baroPressure',nameKey:'sensor.baro',defaultName:'Barometrik Bas\u0131n\xe7',unit:'kPa',pid:'01 33',icon:'',color:'#475569',isHighPriority:!1},{key:'actualTorque',nameKey:'dashboard.torque',defaultName:'Motor Torku',unit:'Nm',pid:'01 62',icon:'',color:'#b45309',isHighPriority:!0},{key:'adblueLevel',nameKey:'dashboard.adblue',defaultName:'AdBlue Seviyesi',unit:'%',pid:'01 9B',icon:'',color:'#0284c7',isHighPriority:!1},{key:'egtTemp',nameKey:'dashboard.egt',defaultName:'Egzoz Gaz\u0131 S\u0131cakl\u0131\u011f\u0131',unit:'\xb0C',pid:'01 78',icon:'',color:'#e11d48',isHighPriority:!1},{key:'noxSensor',nameKey:'dashboard.nox',defaultName:'NOx Sens\xf6r\xfc',unit:'ppm',pid:'01 83',icon:'',color:'#0f766e',isHighPriority:!1}],['rpm','speed','coolant','voltage']);e.useDashboardStore=(0,t.create)()((0,s.persist)(o=>({activeSensors:l,layoutType:'grid',toggleSensor:t=>o(o=>o.activeSensors.includes(t)?o.activeSensors.length<=1?o:{activeSensors:o.activeSensors.filter(o=>o!==t)}:o.activeSensors.length>=8?o:{activeSensors:[...o.activeSensors,t]}),setLayoutType:t=>o({la