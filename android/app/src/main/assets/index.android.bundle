nfirm:"\u041f\u0420\u041e\u0414\u041e\u0412\u0416\u0423\u0419\u0422\u0415",errorBrand:"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0430\u0431\u043e \u0432\u0432\u0435\u0434\u0456\u0442\u044c \u0431\u0440\u0435\u043d\u0434.",errorModel:"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0430\u0431\u043e \u0432\u0432\u0435\u0434\u0456\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c.",errorYear:"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0430\u0431\u043e \u0432\u0432\u0435\u0434\u0456\u0442\u044c \u0434\u0456\u0439\u0441\u043d\u0438\u0439 \u0440\u0456\u043a (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, 2018).",noResults:"\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e",selectVehiclePrompt:"\u0411\u0423\u0414\u042c \u041b\u0410\u0421\u041a\u0410, \u0421\u041f\u041e\u0427\u0410\u0422\u041a\u0423 \u0412\u0418\u0411\u0415\u0420\u0406\u0422\u042c \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0418\u041b\u042c",selectedVehicle:"\u0412\u0418\u0411\u0420\u0410\u041d\u0418\u0419 \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0418\u041b\u042c",changeVehicle:"\u0417\u041c\u0406\u041d\u0418\u0422\u0418",newVehicle:"\u0414\u043e\u0434\u0430\u0442\u0438 \u043d\u043e\u0432\u0438\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c",titleMenu:"\u0422\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442 & \u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f",registeredVehiclesLabel:"\u0417\u0410\u0420\u0415\u0404\u0421\u0422\u0420\u041e\u0412\u0410\u041d\u0406 \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0406\u041b\u0406",viewRegisteredList:"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0456 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456",registeredVehicles:"\u041c\u041e\u0407 \u0417\u0410\u0420\u0404\u0421\u0422\u0420\u041e\u0412\u0410\u041d\u0406 \u0410\u