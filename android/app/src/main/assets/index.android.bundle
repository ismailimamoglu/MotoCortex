\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0631\u0629. \u0642\u062f \u064a\u0624\u062b\u0631 \u0627\u0644\u062a\u0631\u0645\u064a\u0632 \u063a\u064a\u0631 \u0627\u0644\u0645\u0635\u0631\u062d \u0628\u0647 \u0623\u0648 \u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u0644\u0645\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u0639\u0644\u0649 \u0627\u0644\u0636\u0645\u0627\u0646 \u0623\u0648 \u062a\u0639\u0637\u064a\u0644 \u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0633\u0644\u0627\u0645\u0629. \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u062a\u0642\u0639 \u0639\u0644\u0649 \u0639\u0627\u062a\u0642 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.",checkboxAccepted:" \u0623\u0646\u0627 \u0623\u0641\u0647\u0645 \u0648\u0623\u0642\u0628\u0644 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0641\u062a\u062d SGW",checkboxUnaccepted:"\u064a\u0631\u062c\u0649 \u0642\u0628\u0648\u0644 \u0627\u0644\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0642\u0628\u0644 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629",offlineLabel:"\u0631\u0645\u0632 \u0627\u0644\u062a\u062c\u0627\u0648\u0632 \u063a\u064a\u0631 \u0627\u0644\u0645\u062a\u0635\u0644 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0644\u0644\u0641\u0646\u064a \u0627\u0644\u0645\u064a\u062f\u0627\u0646\u064a:",offlinePlaceholder:"\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c OFF_89A2BF10",offlineUnlockBtn:"\u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644 \u062f\u0648\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a (15 \u062f\u0642\u064a\u0642\u0629)",cloudUnlockBtn:"\u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0631\u0645\u0632 \u0627\u0644\u0633\u062d\u0627\u0628\u0629 (60 \u062f\u0642\u064a\u0642\u0629)",toggleToCloud:"\u2190 \u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u0633\u062d\u0627\u0628\u064a",toggleToOffline:" \u0648\u0636\u0639 \u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u062d\u0642\u0644 \u063a\u064a\u0631 \u0627\u0644\u0645\u062a\u0635\u0644 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a",cancel:"\u064a\u0644\u063a\u064a",warning:"\u062a\u062d\u0630\u064a\u0631",acceptWarning:"\u064a\u0631\u062c\u0649 \u0642\u0628\u0648\u0644 \u0625\u062e\u0644\u0627\u0621 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629.",success:"\u0646\u062c\u0627\u062d",error:"\u062e\u0637\u0623",tokenError:"\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0645\u0645\u064a\u0632",tokenErrorMsg:"\u0641\u0634\u0644 \u0641\u064a \u0641\u062a\u062d SGW.",offlineActive:"\u062a\u062c\u0627\u0648\u0632 \u063a\u064a\u0631 \u0645\u062a\u0635\u0644 \u0646\u0634\u0637",description:"Description"},evBms:{title:"\u062a\u0634\u062e\u064a\u0635 EV BMS",subtitle:"\u0642\u064a\u0627\u0633 \u0627\u0644\u0635\u062d\u0629 \u0648\u062d\u0627\u0644\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 (SOH / SOC) ({{brand}})",sohLabel:"\u0635\u062d\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 (SOH):",capacityRetained:"\u0627\u0644\u0642\u062f\u0631\u0629 \u0627\u0644\u0645\u062d\u062a\u0641\u0638 \u0628\u0647\u0627",socLabel:"\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0634\u062d\u0646 (SOC):",remainingCharge:"\u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629",cellBalance:"\u062a\u0648\u0627\u0632\u0646 \u062c\u0647\u062f \u0627\u0644\u062e\u0644\u064a\u0629 (\u062d\u0632\u0645\u0629 16S)",optimalBalance:"\u0627\u0644\u062a\u0648\u0627\u0632\u0646 \u0627\u0644\u0623\u0645\u062b\u0644 (<30 \u0645\u0644\u0644\u064a \u0641\u0648\u0644\u062a \u062f\u0644\u062a\u0627)",mildImbalance:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u062e\u0644\u0644 \u0628\u0633\u064a\u0637 \u0641\u064a \u0627\u0644\u062a\u0648\u0627\u0632\u0646",thermalStatus:"\u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629 \u0648\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062d\u0632\u0645\u0629",packTemp:"\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0639\u0628\u0648\u0629:",packVoltage:"\u062d\u0632\u0645\u0629 \u0627\u0644\u062c\u0647\u062f:",chargeCycles:"\u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0634\u062d\u0646:",cycles:"\u062f\u0648\u0631\u0627\u062a"},serviceReset:{title:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u062e\u062f\u0645\u0629 \u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u0648\u0627\u0644\u062f\u0648\u0631\u064a\u0629",subtitle:"\u062d\u062f\u062f \u0645\u0647\u0645\u0629 \u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u0627\u0644\u0645\u0631\u0627\u062f \u062a\u0646\u0641\u064a\u0630\u0647\u0627 ({{make}})",preCheckTitle:"\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0633\u0628\u0642\u0629",preCheckIgnition:"\u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0645\u0641\u062a\u0627\u062d \u0625\u0634\u0639\u0627\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u062a\u0634\u063a\u064a\u0644.",preCheckEngine:"\u064a\u062c\u0628 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 (0 \u062f\u0648\u0631\u0629 \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629).",preCheckBattery:"\u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u062c\u0647\u062f \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0623\u0639\u0644\u0649 \u0645\u0646 12.2 \u0641\u0648\u0644\u062a.",selectRoutine:"\u062d\u062f\u062f \u0631\u0648\u062a\u064a\u0646 \u0627\u0644\u062e\u062f\u0645\u0629",intervalReset:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0627\u0644\u0641\u0627\u0635\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0644\u0635\u064a\u0627\u0646\u0629 \u0627\u0644\u062e\u062f\u0645\u0629",intervalTitle:"\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u0636\u0648\u0621 \u0645\u0624\u0634\u0631 \u0627\u0644\u0641\u0627\u0635\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0644\u0644\u062e\u062f\u0645\u0629",intervalSubtitle:"\u0645\u0633\u062d \u062a\u062d\u0630\u064a\u0631 \u062e\u062f\u0645\u0629 \u0627\u0646\u062f\u0641\u0627\u0639\u0629 \u0648\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u0641\u0627\u0635\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0644\u0644\u0641\u062d\u0635 \u0627\u0644\u062a\u0627\u0644\u064a.",tpsReset:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0645\u0633\u062a\u0634\u0639\u0631 \u0645\u0648\u0636\u0639 \u0627\u0644\u062e\u0627\u0646\u0642 (TPS).",tpsTitle:"\u062a\u0643\u064a\u0641 \u0645\u0633\u062a\u0634\u0639\u0631 \u0645\u0648\u0636\u0639 \u0627\u0644\u062e\u0627\u0646\u0642 (TPS).",tpsSubtitle:"\u0625\u0639\u0627\u062f\u0629 \u0645\u0639\u0627\u064a\u0631\u0629 \u0646\u0642\u0637\u0629 \u062a\u0648\u0642\u0641 \u062c\u0647\u062f \u0627\u0644\u062e\u0627\u0646\u0642 \u0627\u0644\u0635\u0641\u0631\u064a.",absBleed:"\u0646\u0632\u064a\u0641 ABS \u0648\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0635\u0645\u0627\u0645",absTitle:"\u0627\u062e\u062a\u0628\u0627\u0631 \u0646\u0632\u064a\u0641 \u0627\u0644\u0645\u0636\u062e\u0629 \u0627\u0644\u0647\u064a\u062f\u0631\u0648\u0644\u064a\u0643\u064a\u0629 ABS",absSubtitle:"\u064a\u0642\u0648\u0645 \u0628\u062a\u062f\u0648\u064a\u0631 \u0635\u0645\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0644\u0648\u0644\u0628\u064a ABS \u0644\u062a\u0637\u0647\u064a\u0631 \u0641\u0642\u0627\u0639\u0627\u062a \u0627\u0644\u0647\u0648\u0627\u0621 \u0645\u0646 \u062e\u0637\u0648\u0637 \u0627\u0644\u0641\u0631\u0627\u0645\u0644.",ecuRejected:"\u0631\u0641\u0636\u062a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0623\u0645\u0631 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u064a\u064a\u0646. \u062a\u0623\u0643\u062f \u0645\u0646 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0648\u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643."},aiDoctor:{analyzing:"\u062a\u062d\u0644\u064a\u0644 \u0631\u0645\u0648\u0632 DTC \u0648\u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0644\u0644\u0645\u062d\u0631\u0643 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 AI Doctor...",healthImpact:"\u062a\u0623\u062b\u064a\u0631 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0635\u062d\u064a\u0629: {{score}}/100",drivingSafety:"\u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629",causes:"\u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u0645\u062d\u062a\u0645\u0644\u0629",recommendedAction:"\u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u064a\u0643\u0627\u0646\u064a\u0643\u064a \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647",estimatedCost:"\u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u0642\u062f\u0631\u0629 \u0644\u0644\u0645\u0643\u0648\u0646\u0627\u062a/\u0627\u0644\u0625\u0635\u0644\u0627\u062d",noFaultsTitle:"\u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0623\u0645\u062b\u0644 \u2014 \u0644\u0645 \u064a\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0623\u064a \u0631\u0645\u0648\u0632 \u062e\u0637\u0623",noFaultsSummary:"\u0644\u0627 \u064a\u064f\u0638\u0647\u0631 \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0623\u064a \u0631\u0645\u0648\u0632 \u0645\u0634\u0643\u0644\u0629 \u062a\u0634\u062e\u064a\u0635\u064a\u0629 \u0646\u0634\u0637\u0629. \u0645\u0639\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0643 \u0636\u0645\u0646 \u0639\u062a\u0628\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0639\u0627\u062f\u064a\u0629.",stepMaintain:"\u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0641\u062a\u0631\u0627\u062a \u0645\u0646\u062a\u0638\u0645\u0629 \u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0632\u064a\u062a \u0648\u0627\u0644\u0641\u0644\u062a\u0631.",stepCheckVoltage:"\u062a\u062d\u0642\u0642 \u0628\u0634\u0643\u0644 \u062f\u0648\u0631\u064a \u0645\u0646 \u062c\u0647\u062f \u0627\u0633\u062a\u0631\u0627\u062d\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629.",safeDrive:"\u0622\u0645\u0646\u0629 \u0644\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0646\u062a\u0638\u0645.",misfireTitle:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u062e\u0644\u0644 \u0641\u064a \u0623\u0633\u0637\u0648\u0627\u0646\u0629 \u0627\u0644\u0645\u062d\u0631\u0643",misfireSummary:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u062e\u0644\u0644 \u0646\u0634\u0637 \u0641\u064a \u0623\u0633\u0637\u0648\u0627\u0646\u0629 \u0648\u0627\u062d\u062f\u0629 \u0623\u0648 \u0623\u0643\u062b\u0631. \u0642\u062f \u064a\u062f\u062e\u0644 \u0627\u0644\u0648\u0642\u0648\u062f \u063a\u064a\u0631 \u0627\u0644\u0645\u062d\u062a\u0631\u0642 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u0648\u0644 \u0627\u0644\u062d\u0641\u0627\u0632 \u0645\u0645\u0627 \u064a\u0633\u0628\u0628 \u062a\u0644\u0641\u064b\u0627 \u062f\u0627\u0626\u0645\u064b\u0627.",causeSparkPlug:"\u0634\u0645\u0639\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0627\u0644\u0628\u0627\u0644\u064a\u0629 \u0623\u0648 \u0627\u0644\u0641\u0627\u0633\u062f\u0629",causeIgnitionCoil:"\u0641\u0634\u0644 \u0645\u0644\u0641 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0623\u0648 \u0627\u0644\u0623\u0633\u0644\u0627\u0643",causeFuelInjector:"\u062d\u0627\u0642\u0646 \u0627\u0644\u0648\u0642\u0648\u062f \u0645\u0633\u062f\u0648\u062f \u0623\u0648 \u0645\u0639\u064a\u0628",stepInspectPlugs:"\u0641\u062d\u0635 \u0648\u0641\u062c\u0648\u0629 \u0634\u0645\u0639\u0627\u062a \u0627\u0644\u0625\u0634\u0639\u0627\u0644.",stepSwapCoils:"\u0642\u0645 \u0628\u062a\u0628\u062f\u064a\u0644 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0628\u064a\u0646 \u0627\u0644\u0623\u0633\u0637\u0648\u0627\u0646\u0627\u062a \u0644\u0627\u062e\u062a\u0628\u0627\u0631 \u0646\u0642\u0644 \u0627\u0644\u062e\u0637\u0623.",stepFuelPressure:"\u0642\u064a\u0627\u0633 \u0636\u063a\u0637 \u0627\u0644\u0633\u0643\u0643 \u0627\u0644\u062d\u062f\u064a\u062f\u064a\u0629 \u0627\u0644\u0648\u0642\u0648\u062f.",criticalDrive:"\u0644\u0627 \u062a\u0642\u0645 \u0628\u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0644\u0645\u0633\u0627\u0641\u0627\u062a \u0637\u0648\u064a\u0644\u0629 \u062a\u062d\u062a \u062f\u0648\u0627\u0633\u0629 \u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u062b\u0642\u064a\u0644\u0629. \u0642\u0645 \u0628\u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0641\u0648\u0631 \u0625\u0644\u0649 \u0627\u0644\u062e\u062f\u0645\u0629.",o2Title:"\u0639\u0637\u0644 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u062d\u0633\u0627\u0633 \u0627\u0644\u0623\u0643\u0633\u062c\u064a\u0646 (O2).",o2Summary:"\u062a\u062a\u062f\u0647\u0648\u0631 \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0627\u0644\u0645\u0631\u062a\u062f\u0629 \u0644\u062e\u0644\u064a\u0637 \u0627\u0644\u0647\u0648\u0627\u0621 \u0648\u0627\u0644\u0648\u0642\u0648\u062f. \u0642\u062f \u064a\u0639\u0645\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 \u0628\u0634\u0643\u0644 \u063a\u0646\u064a \u0623\u0648 \u0647\u0632\u064a\u0644\u060c \u0645\u0645\u0627 \u064a\u0642\u0644\u0644 \u0645\u0646 \u0643\u0641\u0627\u0621\u0629 \u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0648\u0642\u0648\u062f.",causeO2Heater:"\u0641\u0634\u0644 \u0639\u0646\u0635\u0631 \u062a\u0633\u062e\u064a\u0646 \u0645\u0633\u062a\u0634\u0639\u0631 O2",causeExhaustLeak:"\u062a\u0633\u0631\u0628 \u0645\u0634\u0639\u0628 \u0627\u0644\u0639\u0627\u062f\u0645 \u0625\u0644\u0649 \u0627\u0644\u0645\u0646\u0628\u0639 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u0634\u0639\u0631",causeHarness:"\u0645\u0648\u0635\u0644 \u062a\u0633\u062e\u064a\u0631 \u0627\u0644\u0623\u0633\u0644\u0627\u0643 \u0627\u0644\u062a\u0627\u0644\u0641\u0629",stepCheckWiring:"\u0627\u0641\u062d\u0635 \u0645\u062c\u0645\u0648\u0639\u0629 \u0623\u0633\u0644\u0627\u0643 \u0645\u0633\u062a\u0634\u0639\u0631 O2 \u0644\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0630\u0648\u0628\u0627\u0646\u0647\u0627 \u0623\u0648 \u0627\u0647\u062a\u0631\u0627\u0621\u0647\u0627.",stepCleanSensor:"\u0642\u0645 \u0628\u062a\u0646\u0638\u064a\u0641 \u0637\u0631\u0641 \u0645\u0633\u062a\u0634\u0639\u0631 O2 \u0623\u0648 \u0627\u0633\u062a\u0628\u062f\u0644 \u0627\u0644\u0645\u0633\u062a\u0634\u0639\u0631 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0645\u0642\u0627\u0648\u0645\u0629 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a.",warningDrive:"\u0622\u0645\u0646 \u0644\u0644\u0642\u064a\u0627\u062f\u0629 \u0625\u0644\u0649 \u0648\u0631\u0634\u0629 \u0627\u0644\u062a\u0635\u0644\u064a\u062d \u0628\u0633\u0631\u0639\u0629 \u0645\u0639\u062a\u062f\u0644\u0629.",genericTitle:"\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0643\u0648\u062f \u0627\u0644\u062a\u0634\u062e\u064a\u0635\u064a ({{codes}})",genericSummary:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0631\u0645\u0632 (\u0631\u0645\u0648\u0632) \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0646\u0634\u0637\u0629: {{codes}}. \u064a\u0648\u0635\u0649 \u0628\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0646\u0638\u0627\u0645.",causeGeneric1:"\u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u062e\u0627\u0631\u062c \u0646\u0637\u0627\u0642 \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0645\u062a\u0648\u0642\u0639",causeGeneric2:"\u0627\u062a\u0635\u0627\u0644 \u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0641\u0636\u0641\u0627\u0636 \u0623\u0648 \u062e\u0637\u0623 \u0623\u0631\u0636\u064a",stepGeneric1:"\u0625\u062c\u0631\u0627\u0621 \u0645\u0633\u062d \u062a\u0634\u062e\u064a\u0635\u064a \u0648\u062a\u0633\u062c\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0625\u0637\u0627\u0631 \u0627\u0644\u062a\u062c\u0645\u064a\u062f.",stepGeneric2:"\u0642\u0645 \u0628\u0645\u0633\u062d \u0631\u0645\u0648\u0632 DTC \u0628\u0639\u062f \u0641\u062d\u0635 \u0645\u0648\u0635\u0644\u0627\u062a \u0627\u0644\u062d\u0632\u0627\u0645.",reportTitle:"\u062a\u062d\u0644\u064a\u0644 \u0631\u0645\u0632 \u0627\u0644\u062a\u0634\u062e\u064a\u0635",healthImpactTitle:"\u062a\u0623\u062b\u064a\u0631 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0644\u0644\u0645\u062d\u0631\u0643",freeTrialBadge:" \u0623\u0646\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a",modalTitle:"Modal Title",modalSubtitle:"Modal Subtitle"},dtcRisk:{safeTitle:" \u0622\u0645\u0646 \u0644\u0644\u0642\u064a\u0627\u062f\u0629",safeDesc:"\u0647\u0630\u0627 \u0627\u0644\u0639\u0637\u0644 \u0644\u0627 \u064a\u0647\u062f\u062f \u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0645\u0628\u0627\u0634\u0631\u0629. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0628\u0633\u0631\u0639\u0629 \u0645\u0639\u062a\u062f\u0644\u0629 \u062d\u062a\u0649 \u0645\u0631\u0643\u0632 \u0627\u0644\u0635\u064a\u0627\u0646\u0629.",warningTitle:" \u062a\u062d\u0630\u064a\u0631: \u0641\u062d\u0635 \u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u0645\u0637\u0644\u0648\u0628",warningDesc:"\u0642\u062f \u064a\u062d\u062f\u062b \u0641\u0642\u062f\u0627\u0646 \u0641\u064a \u0627\u0644\u0623\u062f\u0627\u0621 \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0627\u0646\u0628\u0639\u0627\u062b\u0627\u062a. \u064a\u0631\u062c\u0649 \u0632\u064a\u0627\u0631\u0629 \u0645\u0631\u0643\u0632 \u0635\u064a\u0627\u0646\u0629 \u0645\u0639\u062a\u0645\u062f \u0641\u064a \u0623\u0642\u0631\u0628 \u0648\u0642\u062a.",criticalTitle:" \u062d\u0631\u062c: \u0623\u0648\u0642\u0641 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0641\u0648\u0631\u0627\u064b / \u0635\u064a\u0627\u0646\u0629 \u0639\u0627\u062c\u0644\u0629",criticalDesc:"\u062e\u0637\u0631 \u0645\u064a\u0643\u0627\u0646\u064a\u0643\u064a \u0623\u0648 \u0643\u0647\u0631\u0628\u0627\u0626\u064a \u062d\u0631\u062c! \u0642\u062f \u064a\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u062d\u0631\u0643 \u0623\u0648 \u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0644\u0644\u062a\u0644\u0641. \u0625\u0631\u0643\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0628\u0623\u0645\u0627\u0646 \u0641\u0648\u0631\u0627\u064b."},dtcDetail:{descTitle:"\u0648\u0635\u0641 \u0643\u0648\u062f \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u062a\u0634\u062e\u064a\u0635\u064a",possibleCausesTitle:"\u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u0645\u062d\u062a\u0645\u0644\u0629 \u0648\u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0627\u0644\u0625\u0635\u0644\u0627\u062d",cause1:"\u0627\u062a\u0635\u0627\u0644 \u0641\u0636\u0641\u0627\u0636 \u0623\u0648 \u062a\u0622\u0643\u0644 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0623\u0648 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0623\u0633\u0644\u0627\u0643",cause2:"\u062a\u0622\u0643\u0644 \u0645\u064a\u0643\u0627\u0646\u064a\u0643\u064a \u0623\u0648 \u0639\u0637\u0644 \u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0641\u064a \u0627\u0644\u0645\u0643\u0648\u0646",cause3:"\u0642\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u062c\u0647\u062f/\u0627\u0644\u0645\u0642\u0627\u0648\u0645\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062c\u0647\u0627\u0632 \u0642\u064a\u0627\u0633 \u0645\u062a\u0639\u062f\u062f \u0623\u0648 \u0627\u0633\u062a\u0628\u062f\u0644 \u0627\u0644\u0645\u0643\u0648\u0646",recommendedAction:"\u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647",tsbTitle:"\u0646\u0634\u0631\u0629 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0641\u0646\u064a\u0629 (TSB)",aiDoctorBtn:"\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u062e\u0628\u0631\u0627\u0621 AI DOCTOR",backToDetail:"\u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0639\u0637\u0644"},dtcCategory:{powertrain:"\u0627\u0644\u0645\u062d\u0631\u0643 / \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629",chassis:"\u0627\u0644\u0647\u064a\u0643\u0644 / \u0646\u0638\u0627\u0645 \u0627\u0644\u0641\u0631\u0627\u0645\u0644",body:"\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0627\u062a \u0627\u0644\u0647\u064a\u0643\u0644",network:"\u0627\u0644\u0634\u0628\u0643\u0629 / \u0646\u0638\u0627\u0645 \u0646\u0627\u0642\u0644 CAN"},guidedDiag:{p0102_cause1:"\u062d\u0633\u0627\u0633 MAF \u0645\u062a\u0633\u062e \u0623\u0648 \u062a\u0627\u0644\u0641",p0102_cause2:"\u062a\u0633\u0631\u064a\u0628 \u0641\u064a \u0633\u062d\u0628 \u0627\u0644\u0647\u0648\u0627\u0621 / \u062a\u0633\u0631\u064a\u0628 \u0645\u0641\u0631\u063a \u0627\u0644\u0647\u0648\u0627\u0621",p0102_cause3:"\u062a\u0644\u0641 \u0623\u0648 \u0623\u0643\u0633\u062f\u0629 \u0641\u064a \u0636\u0641\u064a\u0631\u0629 \u0627\u0644\u0623\u0633\u0644\u0627\u0643",p0102_action:"\u0642\u0645 \u0628\u062a\u0646\u0638\u064a\u0641 \u062d\u0633\u0627\u0633 MAF \u0628\u0644\u0645\u0646\u0638\u0641 \u0627\u0644\u062c\u0627\u0641 \u0623\u0648 \u0627\u0641\u062d\u0635 \u0639\u0644\u0628\u0629 \u0641\u0644\u062a\u0631 \u0627\u0644\u0647\u0648\u0627\u0621 \u0644\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u062a\u0633\u0631\u064a\u0628.",p0102_tsb:"TSB-2023-09: \u0627\u0641\u062d\u0635 \u0639\u0632\u0645 \u0634\u062f \u0645\u0650\u0631\u064e\u0628\u064e\u0651\u0637 \u062e\u0631\u0637\u0648\u0645 \u0633\u062d\u0628 \u0627\u0644\u0647\u0648\u0627\u0621 \u0642\u0628\u0644 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u062d\u0633\u0627\u0633 MAF.",p0171_cause1:"\u062a\u0633\u0631\u0628 \u062e\u0631\u0637\u0648\u0645 \u0627\u0644\u0641\u0631\u0627\u063a / \u062a\u0633\u0631\u0628 \u0627\u0644\u0645\u062f\u062e\u0648\u0644",p0171_cause2:"\u0645\u0636\u062e\u0629 \u0648\u0642\u0648\u062f \u0636\u0639\u064a\u0641\u0629/\u0636\u063a\u0637 \u0645\u0646\u062e\u0641\u0636",p0171_cause3:"\u062d\u0633\u0627\u0633 O2 \u0627\u0644\u0645\u0644\u0648\u062b 1",p0171_action:"\u0642\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u062f\u062e\u0627\u0646 \u0639\u0644\u0649 \u0645\u0634\u0639\u0628 \u0627\u0644\u0633\u062d\u0628 \u0648\u062a\u062d\u0642\u0642 \u0645\u0646 \u062a\u062c\u0647\u064a\u0632\u0627\u062a \u0627\u0644\u0648\u0642\u0648\u062f \u0637\u0648\u064a\u0644\u0629 \u0627\u0644\u0645\u062f\u0649 (LTFT).",p0171_tsb:"TSB-2022-14: \u0627\u0641\u062d\u0635 \u0627\u0644\u062d\u062c\u0627\u0628 \u0627\u0644\u062d\u0627\u062c\u0632 \u0644\u0635\u0645\u0627\u0645 PCV \u0644\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u062a\u0645\u0632\u0642\u0627\u062a.",p0420_cause1:"\u062a\u062f\u0647\u0648\u0631 \u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u0648\u0644 \u0627\u0644\u062d\u0641\u0627\u0632",p0420_cause2:"\u062e\u0637\u0623 \u0641\u064a \u0645\u0633\u062a\u0634\u0639\u0631 O2 \u0627\u0644\u062e\u0644\u0641\u064a",p0420_cause3:"\u062a\u0633\u0631\u0628 \u0627\u0644\u0639\u0627\u062f\u0645 \u0642\u0628\u0644 \u0627\u0644\u0645\u062d\u0648\u0644",p0420_action:"\u0642\u0627\u0631\u0646 \u0628\u064a\u0646 \u0627\u0644\u0623\u0634\u0643\u0627\u0644 \u0627\u0644\u0645\u0648\u062c\u064a\u0629 \u0644\u0645\u0633\u062a\u0634\u0639\u0631 O2 \u0627\u0644\u0645\u0646\u0628\u0639 \u0648\u0627\u0644\u0645\u0635\u0628 \u0623\u0648 \u062a\u062d\u0642\u0642 \u0645\u0646 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0645\u062d\u0648\u0644 \u0627\u0644\u062d\u0641\u0627\u0632.",p0300_cause1:"\u0634\u0645\u0639\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 / \u0645\u0644\u0641 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0627\u0644\u0628\u0627\u0644\u064a\u0629",p0300_cause2:"\u062d\u0627\u0642\u0646 \u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0645\u0633\u062f\u0648\u062f",p0300_cause3:"\u0627\u0646\u062e\u0641\u0627\u0636 \u0636\u063a\u0637 \u0627\u0633\u0637\u0648\u0627\u0646\u0629 \u0627\u0644\u0645\u062d\u0631\u0643",p0300_action:"\u0642\u0645 \u0628\u062a\u0628\u062f\u064a\u0644 \u0645\u0644\u0641 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0625\u0644\u0649 \u0627\u0644\u0623\u0633\u0637\u0648\u0627\u0646\u0629 \u0627\u0644\u0645\u062c\u0627\u0648\u0631\u0629 \u0648\u0631\u0627\u0642\u0628 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0647\u0646\u0627\u0643 \u062e\u0644\u0644 \u0641\u064a \u0627\u0644\u0625\u0634\u0639\u0627\u0644.",p17bf_cause1:"\u062a\u0633\u0631\u0628 \u0645\u0631\u0627\u0643\u0645 \u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u0647\u064a\u062f\u0631\u0648\u0644\u064a\u0643\u064a \u0627\u0644\u0645\u064a\u0643\u0627\u062a\u0631\u0648\u0646\u064a",p17bf_cause2:"\u062e\u0637\u0623 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u0635\u0645\u0627\u0645 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0644\u0648\u0644\u0628\u064a",p17bf_cause3:"\u0627\u0646\u062e\u0641\u0627\u0636 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0633\u0648\u0627\u0626\u0644 / \u062a\u062f\u0647\u0648\u0631 \u0627\u0644\u0633\u0648\u0627\u0626\u0644",p17bf_action:"\u0642\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u0645\u064a\u0643\u0627\u062a\u0631\u0648\u0646\u064a\u0643 DCT \u0648\u0641\u062d\u0635 \u063a\u0644\u0627\u0641 \u0627\u0644\u0645\u0631\u0643\u0645.",p17bf_tsb:"TSB-VAG-DSG: \u0627\u0633\u062a\u0628\u062f\u0644 \u0645\u0628\u064a\u062a \u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u0645\u064a\u0643\u0627\u062a\u0631\u0648\u0646\u064a \u0623\u0648 \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u062c\u0645\u0639 \u0627\u0644\u0645\u0639\u0632\u0632\u0629.",default_cause1:"\u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a / \u062e\u0637\u0623 \u0641\u064a \u0645\u0642\u0627\u0648\u0645\u0629 \u0627\u0644\u0623\u0633\u0644\u0627\u0643",default_cause2:"\u0627\u0644\u062a\u0622\u0643\u0644 \u0627\u0644\u0645\u064a\u0643\u0627\u0646\u064a\u0643\u064a \u0623\u0648 \u062a\u062f\u0647\u0648\u0631 \u0627\u0644\u0645\u0633\u062a\u0634\u0639\u0631",default_action:"\u0642\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u0641\u062d\u0635 \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u062c\u0647\u062f \u0648\u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062c\u0647\u0627\u0632 \u0627\u0644\u0642\u064a\u0627\u0633 \u0627\u0644\u0645\u062a\u0639\u062f\u062f."},ev:{loading:"\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629...",back:"\u2190 \u0627\u0644\u0639\u0648\u062f\u0629",title:" \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 \u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0648\u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629",sohTitle:"\u062d\u0627\u0644\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 (SOH)",socAndPack:"\u062d\u0627\u0644\u0629 \u0627\u0644\u0634\u062d\u0646 (SoC): {{soc}}% | \u062c\u0647\u062f \u0627\u0644\u0639\u0628\u0648\u0629: {{voltage}} \u0641\u0648\u0644\u062a",insulationTitle:"\u0627\u0644\u0639\u0632\u0644 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629",insulationResistance:"\u0645\u0642\u0627\u0648\u0645\u0629 \u0627\u0644\u0639\u0632\u0644",cellDeltaVoltage:"\u062f\u0644\u062a\u0627 \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u062e\u0644\u064a\u0629",maxCellTemp:"\u0623\u0642\u0635\u0649 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0644\u0644\u062e\u0644\u064a\u0629",minCellTemp:"\u062f\u0642\u064a\u0642\u0629 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u062e\u0644\u064a\u0629",cellDistribution:"\u062a\u0648\u0632\u064a\u0639 \u062c\u0647\u062f \u0627\u0644\u062e\u0644\u064a\u0629",cellIndex:"\u0627\u0644\u062e\u0644\u064a\u0629 #{{id}}",deviationWarning:" \u0627\u0644\u0627\u0646\u062d\u0631\u0627\u0641 \u0627\u0644\u0639\u0627\u0644\u064a",passportTitle:" \u062c\u0648\u0627\u0632 \u0633\u0641\u0631 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0631\u0642\u0645\u064a \u0644\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a",passportId:"\u0645\u0639\u0631\u0641 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631: {{id}}",nominalCapacity:"\u0627\u0644\u0633\u0639\u0629 \u0627\u0644\u0627\u0633\u0645\u064a\u0629: {{val}} \u0643\u064a\u0644\u0648\u0648\u0627\u0637 \u0633\u0627\u0639\u0629",remainingCapacity:"\u0627\u0644\u0642\u062f\u0631\u0629 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629: {{val}} \u0643\u064a\u0644\u0648\u0648\u0627\u062a \u0633\u0627\u0639\u0629",totalCycles:"\u0625\u062c\u0645\u0627\u0644\u064a \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0634\u062d\u0646: {{val}}",thermalRisk:"\u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629: {{val}}",carbonFootprint:"\u0627\u0644\u0628\u0635\u0645\u0629 \u0627\u0644\u0643\u0631\u0628\u0648\u0646\u064a\u0629: {{val}} \u0643\u062c\u0645 \u0645\u0646 \u062b\u0627\u0646\u064a \u0623\u0643\u0633\u064a\u062f \u0627\u0644\u0643\u0631\u0628\u0648\u0646"},privacy:{back:"\u2190 \u0627\u0644\u0639\u0648\u062f\u0629",title:"\u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a",subtitle:"\u0645\u0639\u0627\u0644\u062c\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u062d\u0642\u0648\u0642 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a.",permissionsTitle:"\u0623\u0630\u0648\u0646\u0627\u062a \u062c\u0645\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a",telemetryLabel:"\u0645\u062c\u0647\u0648\u0644 \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0648\u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a",telemetrySub:"\u064a\u0633\u062a\u062e\u062f\u0645 \u0644\u062a\u062d\u0633\u064a\u0646 \u0623\u062f\u0627\u0621 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.",crashLabel:"\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0623\u0639\u0637\u0627\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629",crashSub:"\u064a\u0631\u0633\u0644 \u0633\u062c\u0644\u0627\u062a \u0645\u062c\u0647\u0648\u0644\u0629 \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621.",rightsTitle:"\u062d\u0642\u0648\u0642 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0644\u0627\u0626\u062d\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0628\u064a\u0627