e2d\u0e19\u0e08\u0e38\u0e14\u0e1a\u0e2d\u0e14\u0e17\u0e35\u0e48\u0e01\u0e23\u0e30\u0e08\u0e01\u0e21\u0e2d\u0e07\u0e02\u0e49\u0e32\u0e07"},toyota_ac_noise_reduction:{name:"\u0e42\u0e2b\u0e21\u0e14\u0e25\u0e14\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e23\u0e1a\u0e01\u0e27\u0e19\u0e02\u0e2d\u0e07\u0e04\u0e2d\u0e21\u0e40\u0e1e\u0e23\u0e2a\u0e40\u0e0b\u0e2d\u0e23\u0e4c A/C \u0e42\u0e1a\u0e25\u0e40\u0e27\u0e2d\u0e23\u0e4c (\u0e42\u0e15\u0e42\u0e22\u0e15\u0e49\u0e32)",desc:"\u0e08\u0e33\u0e01\u0e31\u0e14\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e1e\u0e31\u0e14\u0e25\u0e21\u0e40\u0e1b\u0e48\u0e32\u0e25\u0e21\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e1b\u0e23\u0e31\u0e1a\u0e2d\u0e32\u0e01\u0e32\u0e28\u0e2a\u0e39\u0e07\u0e2a\u0e38\u0e14\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e40\u0e07\u0e35\u0e22\u0e1a\u0e43\u0e19\u0e2b\u0e49\u0e2d\u0e07\u0e42\u0e14\u0e22\u0e2a\u0e32\u0e23"},toyota_sflow_control:{name:"\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e42\u0e14\u0e22\u0e2a\u0e32\u0e23\u0e04\u0e19\u0e40\u0e14\u0e35\u0e22\u0e27 S-Flow Smart Climate (\u0e42\u0e15\u0e42\u0e22\u0e15\u0e49\u0e32)",desc:"\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e17\u0e34\u0e28\u0e17\u0e32\u0e07\u0e01\u0e32\u0e23\u0e44\u0e2b\u0e25\u0e02\u0e2d\u0e07\u0e2d\u0e32\u0e01\u0e32\u0e28 A/C \u0e44\u0e1b\u0e22\u0e31\u0e07\u0e17\u0e35\u0e48\u0e19\u0e31\u0e48\u0e07\u0e17\u0e35\u0e48\u0e16\u0e39\u0e01\u0e04\u0e23\u0e2d\u0e1a\u0e04\u0e23\u0e2d\u0e07\u0e42\u0e14\u0e22\u0e40\u0e09\u0e1e\u0e32\u0e30\u0e42\u0e14\u0e22\u0e2d\u0e34\u0e07\u0e15\u0e32\u0e21\u0e40\u0e0b\u0e47\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01"},toyota_relock_timeout:{name:"\u0e15\u0e31\u0e49\u0e07\u0e40\u0e27\u0e25\u0e32\u0e2b\u0e19\u0e48\u0e27\u0e07\u0e40\u0e27\u0e25\u0e32\u0e25\u0e47\u0e2d\u0e04\u0e0b\u0e49\u0e33\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e04\u0e23\u0e30\u0e22\u0e30\u0e44\u0e01\u0e25 (\u0e42\u0e15\u0e42\u0e22\u0e15\u0e49\u0e32)",desc:"\u0e1b\u0e23\u0e31\u0e1a\u0e27\u0e34\u0e19\u0e32\u0e17\u0e35\u0e01\u0e48\u0e2d\u0e19\u0e17\u0e35\u0e48\u0e1b\u0e23\u0e30\u0e15\u0e39\u0e08\u0e30\u0e25\u0e47\u0e2d\u0e01\u0e43\u0e2b\u0e21\u0e48\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e2b\u0e32\u0e01\u0e44\u0e21\u0e48\u0e21\u0e35\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e34\u0e14\u0e1b\u0e23\u0e30\u0e15\u0e39 (30 \u0e27\u0e34\u0e19\u0e32\u0e17\u0e35 - 120 \u0e27\u0e34\u0e19\u0e32\u0e17\u0e35)"},lexus_mark_levinson_audio_profile:{name:"\u0e42\u0e1b\u0e23\u0e44\u0e1f\u0e25\u0e4c\u0e40\u0e2a\u0e35\u0e22\u0e07 DSP \u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e0b\u0e2d\u0e23\u0e4c\u0e23\u0e32\u0e27\u0e14\u0e4c\u0e02\u0e2d\u0e07 Mark Levinson (Lexus)",desc:"\u0e1b\u0e23\u0e31\u0e1a\u0e08\u0e39\u0e19\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e2d\u0e30\u0e04\u0e39\u0e2a\u0e15\u0e34\u0e01\u0e40\u0e0a\u0e34\u0e07\u0e1e\u0e37\u0e49\u0e19\u0e17\u0e35\u0e48 3D \u0e43\u0e2b\u0e49\u0e40\u0e2b\u0e21\u0e32\u0e30\u0e2a\u0e21\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e25\u0e33\u0e42\u0e1e\u0e07\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e1e\u0e23\u0e35\u0e40\u0e21\u0e35\u0e22\u0e21\u0e02\u0e2d\u0e07 Mark Levinson"},lexus_ev_mode_beeper_mute:{name:"\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e1a\u0e35\u0e4a\u0e1a\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e40\u0e2a\u0e35\u0e22\u0e07 EV \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e04\u0e19\u0e40\u0e14\u0e34\u0e19\u0e16\u0e19\u0e19\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e15\u0e48\u0e33 (Lexus)",desc:"\u0e23\u0e30\u0e07\u0e31\u0e1a\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e23\u0e30\u0e06\u0e31\u0e07\u0e20\u0e32\u0e22\u0e19\u0e2d\u0e01\u0e2a\u0e31\u0e07\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e43\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e44\u0e1f\u0e1f\u0e49\u0e32\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e15\u0e48\u0e33"},lexus_easy_access_seat:{name:"\u0e40\u0e02\u0e49\u0e32\u0e16\u0e36\u0e07\u0e1e\u0e27\u0e07\u0e21\u0e32\u0e25\u0e31\u0e22\u0e41\u0e25\u0e30\u0e40\u0e1a\u0e32\u0e30\u0e19\u0e31\u0e48\u0e07\u0e1b\u0e23\u0e31\u0e1a\u0e44\u0e1f\u0e1f\u0e49\u0e32\u0e41\u0e1a\u0e1a\u0e2a\u0e44\u0e25\u0e14\u0e4c\u0e2b\u0e25\u0e31\u0e07 (Lexus)",desc:"\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e40\u0e1a\u0e32\u0e30\u0e19\u0e31\u0e48\u0e07\u0e04\u0e19\u0e02\u0e31\u0e1a\u0e44\u0e1b\u0e14\u0e49\u0e32\u0e19\u0e2b\u0e25\u0e31\u0e07\u0e41\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e07\u0e1e\u0e27\u0e07\u0e21\u0e32\u0e25\u0e31\u0e22\u0e2d\u0e2d\u0e01\u0e44\u0e1b\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e43\u0e2b\u0e49\u0e40\u0e02\u0e49\u0e32/\u0e2d\u0e2d\u0e01\u0e44\u0e14\u0e49\u0e07\u0e48\u0e32\u0e22"},nissan_epower_regen_mode:{name:"e-POWER One-Pedal Regenerative Braking Mode (\u0e19\u0e34\u0e2a\u0e2a\u0e31\u0e19)",desc:"\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e02\u0e2d\u0e07\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e0a\u0e30\u0e25\u0e2d\u0e01\u0e32\u0e23\u0e40\u0e1a\u0e23\u0e01\u0e41\u0e1a\u0e1a\u0e08\u0e48\u0e32\u0e22\u0e1e\u0e25\u0e31\u0e07\u0e07\u0e32\u0e19\u0e04\u0e37\u0e19 e-Pedal"},nissan_propilot_assist_timing:{name:"ProPILOT Lane Centering Assist \u0e04\u0e27\u0e32\u0e21\u0e44\u0e27 (Nissan)",desc:"\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e04\u0e48\u0e32\u0e04\u0e27\u0e32\u0e21\u0e04\u0e21\u0e0a\u0e31\u0e14\u0e02\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e41\u0e17\u0e23\u0e01\u0e41\u0e0b\u0e07\u0e1e\u0e27\u0e07\u0e21\u0e32\u0e25\u0e31\u0e22 ProPILOT"},nissan_intelligent_around_view:{name:"\u0e08\u0e2d\u0e20\u0e32\u0e1e\u0e21\u0e2d\u0e07\u0e42\u0e14\u0e22\u0e23\u0e2d\u0e1a\u0e1b\u0e47\u0e2d\u0e1b\u0e2d\u0e31\u0e1e\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e17\u0e35\u0e48\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e15\u0e48\u0e33 (\u0e19\u0e34\u0e2a\u0e2a\u0e31\u0e19)",desc:"\u0e40\u0e23\u0e35\u0e22\u0e01\u0e43\u0e0a\u0e49\u0e01\u0e32\u0e23\u0e41\u0e2a\u0e14\u0e07\u0e1c\u0e25\u0e02\u0e2d\u0e07\u0e01\u0e25\u0e49\u0e2d\u0e07 360 \u0e2d\u0e07\u0e28\u0e32\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e40\u0e0b\u0e47\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c\u0e08\u0e2d\u0e14\u0e23\u0e16\u0e14\u0e49\u0e32\u0e19\u0e2b\u0e19\u0e49\u0e32\u0e15\u0e23\u0e27\u0e08\u0e1e\u0e1a\u0e2a\u0e34\u0e48\u0e07\u0e01\u0e35\u0e14\u0e02\u0e27\u0e32\u0e07"},mazda_g_vectoring_display:{name:"G-Vectoring Control Plus Dynamic Visualizer (\u0e21\u0e32\u0e2a\u0e14\u0e49\u0e32)",desc:"\u0e41\u0e2a\u0e14\u0e07\u0e01\u0e23\u0e32\u0e1f\u0e40\u0e27\u0e01\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e41\u0e23\u0e07\u0e1a\u0e34\u0e14\u0e02\u0e13\u0e30\u0e40\u0e02\u0e49\u0e32\u0e42\u0e04\u0e49\u0e07 GVC+ \u0e41\u0e1a\u0e1a\u0e40\u0e23\u0e35\u0e22\u0e25\u0e44\u0e17\u0e21\u0e4c\u0e1a\u0e19\u0e41\u0e1c\u0e07\u0e2b\u0e19\u0e49\u0e32\u0e1b\u0e31\u0e14"},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP \u0e21\u0e34\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e27\u0e31\u0e14\u0e04\u0e48\u0e32\u0e1e\u0e25\u0e31\u0e07\u0e07\u0e32\u0e19\u0e40\u0e1a\u0e23\u0e01\u0e41\u0e1a\u0e1a\u0e01\u0e39\u0e49\u0e04\u0e37\u0e19 (Mazda)",desc:"\u0e41\u0e2a\u0e14\u0e07\u0e2a\u0e16\u0e32\u0e19\u0e30\u0e1b\u0e23\u0e30\u0e08\u0e38\u0e44\u0e1f\u0e1f\u0e49\u0e32\u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e04\u0e32\u0e22\u0e1b\u0e23\u0e30\u0e08\u0e38\u0e02\u0e2d\u0e07\u0e15\u0e31\u0e27\u0e40\u0e01\u0e47\u0e1a\u0e1b\u0e23\u0e30\u0e08\u0e38\u0e44\u0e1f\u0e1f\u0e49\u0e32\u0e1a\u0e19\u0e2b\u0e19\u0e49\u0e32\u0e08\u0e2d\u0e2a\u0e48\u0e27\u0e19\u0e01\u0e25\u0e32\u0e07"},mazda_smart_city_brake_sens:{name:"\u0e23\u0e30\u0e1a\u0e1a\u0e0a\u0e48\u0e27\u0e22\u0e40\u0e1a\u0e23\u0e01\u0e2d\u0e31\u0e08\u0e09\u0e23\u0e34\u0e22\u0e30 (SCBS) \u0e04\u0e27\u0e32\u0e21\u0e44\u0e27 (Mazda)",desc:"\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e0a\u0e48\u0e27\u0e07\u0e40\u0e0b\u0e47\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c\u0e40\u0e1a\u0e23\u0e01\u0e09\u0e38\u0e01\u0e40\u0e09\u0e34\u0e19\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e15\u0e48\u0e33"},subaru_eyesight_distance_preset:{name:"\u0e23\u0e30\u0e22\u0e30\u0e2b\u0e48\u0e32\u0e07\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e02\u0e2d\u0e07\u0e23\u0e30\u0e1a\u0e1a\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34 EyeSight Adaptive (Subaru)",desc:"\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e04\u0e48\u0e32\u0e42\u0e1b\u0e23\u0e44\u0e1f\u0e25\u0e4c\u0e0a\u0e48\u0e2d\u0e07\u0e27\u0e48\u0e32\u0e07\u0e01\u0e32\u0e23\u0e25\u0e48\u0e2d\u0e07\u0e40\u0e23\u0e37\u0e2d\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e02\u0e2d\u0e07\u0e01\u0e25\u0e49\u0e2d\u0e07\u0e2a\u0e40\u0e15\u0e2d\u0e23\u0e34\u0e42\u0e2d\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e23\u0e30\u0e1a\u0e1a"},subaru_xmode_auto_engage:{name:"X-Mode Off-Road Traction \u0e40\u0e01\u0e13\u0e11\u0e4c\u0e01\u0e32\u0e23\u0e21\u0e35\u0e2a\u0e48\u0e27\u0e19\u0e23\u0e48\u0e27\u0e21\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34 (Subaru)",desc:"\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e40\u0e01\u0e13\u0e11\u0e4c\u0e01\u0e32\u0e23\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e02\u0e2d\u0e07\u0e25\u0e49\u0e2d\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19 X-Mode \u0e41\u0e1a\u0e1a\u0e2a\u0e2d\u0e07\u0e1f\u0e31\u0e07\u0e01\u0e4c\u0e0a\u0e31\u0e19\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34"},subaru_steering_responsive_headlights:{name:"\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32\u0e15\u0e2d\u0e1a\u0e2a\u0e19\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e1a\u0e31\u0e07\u0e04\u0e31\u0e1a\u0e40\u0e25\u0e35\u0e49\u0e22\u0e27 (SRH) \u0e2a\u0e25\u0e31\u0e1a (Subaru)",desc:"\u0e40\u0e1b\u0e34\u0e14\u0e2b\u0e23\u0e37\u0e2d\u0e1b\u0e34\u0e14\u0e01\u0e32\u0e23\u0e2b\u0e21\u0e38\u0e19\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32\u0e41\u0e1a\u0e1a\u0e1b\u0e23\u0e31\u0e1a\u0e17\u0e34\u0e28\u0e17\u0e32\u0e07\u0e44\u0e14\u0e49"},genesis_sport_plus_mode:{name:"\u0e42\u0e2b\u0e21\u0e14 Sport+ Powertrain & Electronic Suspension (Genesis)",desc:"\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e04 ESC OFF \u0e17\u0e35\u0e48\u0e40\u0e19\u0e49\u0e19\u0e2a\u0e19\u0e32\u0e21\u0e41\u0e02\u0e48\u0e07\u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e17\u0e33\u0e41\u0e1c\u0e19\u0e17\u0e35\u0e48\u0e41\u0e14\u0e21\u0e40\u0e1b\u0e2d\u0e23\u0e4c\u0e43\u0e2b\u0e49\u0e41\u0e02\u0e47\u0e07\u0e02\u0e36\u0e49\u0e19"},genesis_ambient_active_light:{name:"\u0e01\u0e32\u0e23\u0e0b\u0e34\u0e07\u0e04\u0e4c\u0e42\u0e2b\u0e21\u0e14\u0e02\u0e31\u0e1a\u0e40\u0e04\u0e25\u0e37\u0e48\u0e2d\u0e19 Ambient Lighting \u0e41\u0e1a\u0e1a\u0e41\u0e2d\u0e04\u0e17\u0e35\u0e1f (Genesis)",desc:"\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e2a\u0e35\u0e02\u0e2d\u0e07\u0e41\u0e2a\u0e07\u0e20\u0e32\u0e22\u0e43\u0e19\u0e23\u0e16\u0e41\u0e1a\u0e1a\u0e44\u0e14\u0e19\u0e32\u0e21\u0e34\u0e01\u0e15\u0e32\u0e21\u0e42\u0e2b\u0e21\u0e14\u0e01\u0e32\u0e23\u0e02\u0e31\u0e1a\u0e02\u0e35\u0e48"},volvo_city_safety_warning:{name:"\u0e04\u0e27\u0e32\u0e21\u0e44\u0e27\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e09\u0e38\u0e01\u0e40\u0e09\u0e34\u0e19\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e02\u0e2d\u0e07 City Safety (\u0e27\u0e2d\u0e25\u0e42\u0e27\u0e48)",desc:"\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e04\u0e48\u0e32\u0e40\u0e27\u0e25\u0e32\u0e41\u0e08\u0e49\u0e07\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e01\u0e32\u0e23\u0e0a\u0e19\u0e01\u0e31\u0e19\u0e02\u0e2d\u0e07\u0e40\u0e23\u0e14\u0e32\u0e23\u0e4c\u0e41\u0e25\u0e30\u0e25\u0e34\u0e14\u0e32\u0e23\u0e4c (\u0e0a\u0e48\u0e27\u0e07\u0e15\u0e49\u0e19/\u0e1b\u0e01\u0e15\u0e34)"},chery_ar_navigation_hud:{name:"\u0e01\u0e32\u0e23\u0e09\u0e32\u0e22\u0e20\u0e32\u0e1e\u0e0b\u0e49\u0e2d\u0e19\u0e17\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e19\u0e33\u0e17\u0e32\u0e07 AR \u0e1a\u0e19 HUD (Chery)",desc:"\u0e09\u0e32\u0e22\u0e25\u0e39\u0e01\u0e28\u0e23\u0e19\u0e33\u0e17\u0e32\u0e07\u0e04\u0e27\u0e32\u0e21\u0e40\u0e1b\u0e47\u0e19\u0e08\u0e23\u0e34\u0e07\u0e40\u0e2a\u0e23\u0e34\u0e21\u0e41\u0e1a\u0e1a 3 \u0e21\u0e34\u0e15\u0e34\u0e1a\u0e19\u0e01\u0e23\u0e30\u0e08\u0e01\u0e2b\u0e19\u0e49\u0e32\u0e23\u0e16"},jlr_terrain_response_preset:{name:"\u0e01\u0e32\u0e23\u0e15\u0e2d\u0e1a\u0e2a\u0e19\u0e2d\u0e07\u0e20\u0e39\u0e21\u0e34\u0e1b\u0e23\u0e30\u0e40\u0e17\u0e28 \u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e42\u0e2b\u0e21\u0e14\u0e2d\u0e2d\u0e1f\u0e42\u0e23\u0e14\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34 (JLR)",desc:"\u0e08\u0e14\u0e08\u0e33\u0e42\u0e1b\u0e23\u0e44\u0e1f\u0e25\u0e4c\u0e1e\u0e37\u0e49\u0e19\u0e1c\u0e34\u0e27\u0e01\u0e32\u0e23\u0e15\u0e2d\u0e1a\u0e2a\u0e19\u0e2d\u0e07\u0e02\u0e2d\u0e07\u0e20\u0e39\u0e21\u0e34\u0e1b\u0e23\u0e30\u0e40\u0e17\u0e28\u0e25\u0e48\u0e32\u0e2a\u0e38\u0e14 (\u0e2b\u0e0d\u0e49\u0e32/\u0e01\u0e23\u0e27\u0e14/\u0e2b\u0e34\u0e21\u0e30)"},jlr_adaptive_dynamics_firm:{name:"\u0e42\u0e1b\u0e23\u0e44\u0e1f\u0e25\u0e4c\u0e04\u0e27\u0e32\u0e21\u0e41\u0e19\u0e48\u0e19\u0e02\u0e2d\u0e07\u0e41\u0e14\u0e21\u0e40\u0e1b\u0e2d\u0e23\u0e4c Adaptive Dynamics (JLR)",desc:"\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e04\u0e27\u0e32\u0e21\u0e41\u0e02\u0e47\u0e07\u0e02\u0e2d\u0e07\u0e42\u0e0a\u0e49\u0e04\u0e2d\u0e31\u0e1e\u0e2d\u0e34\u0e40\u0e25\u0e47\u0e01\u0e17\u0e23\u0e2d\u0e19\u0e34\u0e01\u0e2a\u0e4c"},jlr_wading_sensor_alert:{name:"\u0e40\u0e01\u0e13\u0e11\u0e4c\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e04\u0e27\u0e32\u0e21\u0e25\u0e36\u0e01\u0e02\u0e2d\u0e07 Wade Sensing (JLR)",desc:"\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e04\u0e48\u0e32\u0e04\u0e27\u0e32\u0e21\u0e44\u0e27\u0e02\u0e2d\u0e07\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e04\u0e27\u0e32\u0e21\u0e25\u0e36\u0e01\u0e02\u0e2d\u0e07\u0e19\u0e49\u0e33\u0e41\u0e1a\u0e1a\u0e2d\u0e31\u0e25\u0e15\u0e23\u0e32\u0e42\u0e0b\u0e19\u0e34\u0e01"},alfa_dna_dynamic_memory:{name:"Alfa DNA Selector \u0e2b\u0e19\u0e48\u0e27\u0e22\u0e04\u0e27\u0e32\u0e21\u0e08\u0e33\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e44\u0e14\u0e19\u0e32\u0e21\u0e34\u0e01 (Alfa Romeo)",desc:"\u0e04\u0e07\u0e01\u0e32\u0e23\u0e15\u0e2d\u0e1a\u0e2a\u0e19\u0e2d\u0e07\u0e02\u0e2d\u0e07\u0e04\u0e31\u0e19\u0e40\u0e23\u0e48\u0e07\u0e43\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e44\u0e14\u0e19\u0e32\u0e21\u0e34\u0e01\u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e23\u0e35\u0e2a\u0e15\u0e32\u0e23\u0e4c\u0e17"},alfa_q4_torque_split:{name:"\u0e01\u0e23\u0e32\u0e1f\u0e41\u0e22\u0e01\u0e41\u0e23\u0e07\u0e1a\u0e34\u0e14\u0e41\u0e1a\u0e1a\u0e40\u0e23\u0e35\u0e22\u0e25\u0e44\u0e17\u0e21\u0e4c\u0e02\u0e2d\u0e07\u0e23\u0e30\u0e1a\u0e1a\u0e02\u0e31\u0e1a\u0e40\u0e04\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e2a\u0e35\u0e48\u0e25\u0e49\u0e2d Q4 (Alfa Romeo)",desc:"\u0e41\u0e2a\u0e14\u0e07\u0e40\u0e1b\u0e2d\u0e23\u0e4c\u0e40\u0e0b\u0e47\u0e19\u0e15\u0e4c\u0e01\u0e32\u0e23\u0e41\u0e1a\u0e48\u0e07\u0e01\u0e33\u0e25\u0e31\u0e07 AWD \u0e14\u0e49\u0e32\u0e19\u0e2b\u0e19\u0e49\u0e32/\u0e14\u0e49\u0e32\u0e19\u0e2b\u0e25\u0e31\u0e07\u0e1a\u0e19\u0e08\u0e2d\u0e41\u0e2a\u0e14\u0e07\u0e1c\u0e25\u0e41\u0e1c\u0e07\u0e2b\u0e19\u0e49\u0e32\u0e1b\u0e31\u0e14"},li_auto_range_extender_mode:{name:"REV Generator \u0e23\u0e30\u0e14\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e40\u0e01\u0e47\u0e1a\u0e23\u0e31\u0e01\u0e29\u0e32\u0e1b\u0e23\u0e30\u0e08\u0e38\u0e41\u0e1a\u0e15\u0e40\u0e15\u0e2d\u0e23\u0e35\u0e48 (Li Auto)",desc:"\u0e1b\u0e23\u0e31\u0e1a\u0e40\u0e01\u0e13\u0e11\u0e4c\u0e01\u0e32\u0e23\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e01\u0e33\u0e40\u0e19\u0e34\u0e14\u0e44\u0e1f\u0e1f\u0e49\u0e32\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e22\u0e19\u0e15\u0e4c\u0e2a\u0e31\u0e19\u0e14\u0e32\u0e1b\u0e20\u0e32\u0e22\u0e43\u0e19"},li_auto_cinema_seat_position:{name:"\u0e42\u0e2b\u0e21\u0e14\u0e42\u0e23\u0e07\u0e20\u0e32\u0e1e\u0e22\u0e19\u0e15\u0e23\u0e4c / \u0e20\u0e32\u0e1e\u0e22\u0e19\u0e15\u0e23\u0e4c \u0e15\u0e33\u0e41\u0e2b\u0e19\u0e48\u0e07\u0e17\u0e35\u0e48\u0e19\u0e31\u0e48\u0e07\u0e15\u0e32\u0e21\u0e2b\u0e25\u0e31\u0e01\u0e2a\u0e23\u0e35\u0e23\u0e30\u0e28\u0e32\u0e2a\u0e15\u0e23\u0e4c (Li Auto)",desc:"\u0e1b\u0e23\u0e31\u0e1a\u0e40\u0e2d\u0e19\u0e40\u0e1a\u0e32\u0e30\u0e14\u0e49\u0e32\u0e19\u0e2b\u0e25\u0e31\u0e07\u0e41\u0e25\u0e30\u0e01\u0e32\u0e07\u0e17\u0e35\u0e48\u0e27\u0e32\u0e07\u0e02\u0e32\u0e2d\u0e2d\u0e01\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e20\u0e32\u0e1e\u0e22\u0e19\u0e15\u0e23\u0e4c"},zeekr_drift_mode_torque:{name:"\u0e21\u0e2d\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e04\u0e39\u0e48\u0e42\u0e2b\u0e21\u0e14\u0e14\u0e23\u0e34\u0e1f\u0e17\u0e4c\u0e2d\u0e04\u0e15\u0e34\u0e14\u0e49\u0e32\u0e19\u0e2b\u0e25\u0e31\u0e07 (Zeekr)",desc:"\u0e2a\u0e48\u0e07\u0e41\u0e23\u0e07\u0e1a\u0e34\u0e14 100% \u0e44\u0e1b\u0e22\u0e31\u0e07\u0e21\u0e2d\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e44\u0e1f\u0e1f\u0e49\u0e32\u0e14\u0e49\u0e32\u0e19\u0e2b\u0e25\u0e31\u0e07\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e01\u0e32\u0e23\u0e14\u0e23\u0e34\u0e1f\u0e17\u0e4c"},zeekr_ambient_beat_sync:{name:"\u0e41\u0e2a\u0e07\u0e42\u0e14\u0e22\u0e23\u0e2d\u0e1a \u0e40\u0e1e\u0e25\u0e07 \u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30 Beat Sync (Zeekr)",desc:"\u0e44\u0e1f\u0e2a\u0e48\u0e2d\u0e07\u0e2a\u0e27\u0e48\u0e32\u0e07\u0e20\u0e32\u0e22\u0e43\u0e19\u0e2b\u0e49\u0e2d\u0e07\u0e42\u0e14\u0e22\u0e2a\u0e32\u0e23\u0e08\u0e30\u0e01\u0e30\u0e1e\u0e23\u0e34\u0e1a\u0e15\u0e32\u0e21\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e40\u0e1e\u0e25\u0e07\u0e17\u0e35\u0e48\u0e40\u0e25\u0e48\u0e19"},tata_drive_mode_voice:{name:"\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e1b\u0e23\u0e30\u0e01\u0e32\u0e28\u0e2a\u0e27\u0e34\u0e15\u0e0a\u0e4c\u0e42\u0e2b\u0e21\u0e14\u0e01\u0e32\u0e23\u0e02\u0e31\u0e1a\u0e02\u0e35\u0e48 (\u0e17\u0e32\u0e17\u0e32)",desc:"\u0e40\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e01\u0e32\u0e23\u0e22\u0e37\u0e19\u0e22\u0e31\u0e19\u0e14\u0e49\u0e27\u0e22\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e01\u0e32\u0e23\u0e02\u0e31\u0e1a\u0e02\u0e35\u0e48 (City/Sport/Eco)"},mahindra_zip_zap_zoom_custom:{name:"\u0e42\u0e1b\u0e23\u0e44\u0e1f\u0e25\u0e4c\u0e01\u0e32\u0e23\u0e15\u0e2d\u0e1a\u0e2a\u0e19\u0e2d\u0e07\u0e04\u0e31\u0e19\u0e40\u0e23\u0e48\u0e07\u0e41\u0e1a\u0e1a Zip/Zap/Zoom Powertrain (Mahindra)",desc:"\u0e1b\u0e23\u0e31\u0e1a\u0e41\u0e15\u0e48\u0e07\u0e40\u0e2a\u0e49\u0e19\u0e42\u0e04\u0e49\u0e07\u0e01\u0e32\u0e23\u0e40\u0e23\u0e48\u0e07\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e42\u0e2b\u0e21\u0e14\u0e01\u0e32\u0e23\u0e02\u0e31\u0e1a\u0e02\u0e35\u0e48\u0e41\u0e1a\u0e1a Zip, Zap \u0e41\u0e25\u0e30 Zoom"},fun_cyberpunk_cluster_theme:{name:"\u0e18\u0e35\u0e21\u0e2b\u0e49\u0e2d\u0e07\u0e19\u0e31\u0e01\u0e1a\u0e34\u0e19\u0e01\u0e23\u0e32\u0e1f\u0e34\u0e01 Cyberpunk 2077 Neon",desc:"\u0e43\u0e0a\u0e49\u0e2a\u0e44\u0e15\u0e25\u0e4c\u0e21\u0e32\u0e15\u0e23\u0e27\u0e31\u0e14\u0e41\u0e14\u0e0a\u0e1a\u0e2d\u0e23\u0e4c\u0e14\u0e14\u0e34\u0e08\u0e34\u0e17\u0e31\u0e25\u0e2a\u0e35\u0e19\u0e35\u0e2d\u0e2d\u0e19\u0e44\u0e0b\u0e41\u0e2d\u0e19\u0e41\u0e2b\u0e48\u0e07\u0e2d\u0e19\u0e32\u0e04\u0e15\u0e41\u0e25\u0e30\u0e2a\u0e35\u0e40\u0e2b\u0e25\u0e37\u0e2d\u0e07\u0e2d\u0e33\u0e1e\u0e31\u0e19"},fun_exhaust_flame_sound_effect:{name:"\u0e23\u0e30\u0e1a\u0e1a\u0e2a\u0e40\u0e15\u0e2d\u0e23\u0e34\u0e42\u0e2d Pop & Bang Exhaust Sound FX",desc:"\u0e40\u0e25\u0e48\u0e19\u0e40\u0e2d\u0e1f\u0e40\u0e1f\u0e01\u0e15\u0e4c\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e1b\u0e47\u0e2d\u0e1b\u0e41\u0e25\u0e30\u0e1b\u0e31\u0e07\u0e17\u0e48\u0e2d\u0e44\u0e2d\u0e40\u0e2a\u0e35\u0e22 V8 \u0e17\u0e35\u0e48\u0e2a\u0e21\u0e08\u0e23\u0e34\u0e07\u0e1c\u0e48\u0e32\u0e19\u0e25\u0e33\u0e42\u0e1e\u0e07\u0e43\u0e19\u0e2b\u0e49\u0e2d\u0e07\u0e42\u0e14\u0e22\u0e2a\u0e32\u0e23"},fun_matrix_light_show_welcome:{name:"\u0e22\u0e34\u0e19\u0e14\u0e35\u0e15\u0e49\u0e2d\u0e19\u0e23\u0e31\u0e1a\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32 Matrix LED Dance \u0e41\u0e1a\u0e1a\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e40\u0e2d\u0e07",desc:"\u0e40\u0e25\u0e48\u0e19\u0e17\u0e48\u0e32\u0e40\u0e15\u0e49\u0e19 Light Show \u0e40\u0e1b\u0e47\u0e19\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e42\u0e14\u0e22\u0e43\u0e0a\u0e49\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32\u0e41\u0e25\u0e30\u0e44\u0e1f\u0e40\u0e25\u0e35\u0e49\u0e22\u0e27"},fun_stealth_fighter_display:{name:"Stealth Fighter Night \u0e02\u0e31\u0e1a\u0e40\u0e04\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e04\u0e25\u0e31\u0e2a\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e41\u0e1a\u0e1a\u0e21\u0e34\u0e19\u0e34\u0e21\u0e31\u0e25\u0e25\u0e34\u0e2a\u0e15\u0e4c",desc:"\u0e1b\u0e34\u0e14\u0e44\u0e1f\u0e04\u0e25\u0e31\u0e2a\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14 \u0e22\u0e01\u0e40\u0e27\u0e49\u0e19\u0e21\u0e32\u0e15\u0e23\u0e27\u0e31\u0e14\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e02\u0e31\u0e1a\u0e02\u0e35\u0e48\u0e43\u0e19\u0e40\u0e27\u0e25\u0e32\u0e01\u0e25\u0e32\u0e07\u0e04\u0e37\u0e19\u0e17\u0e35\u0e48\u0e21\u0e37\u0e14\u0e2a\u0e19\u0e34\u0e17"},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{name:"Retarder & Jake Brake Downshift Aggressiveness",desc:"Adjusts retarder torque blending curve and automatic transmission downshifting response under braking."},man_ecas_dock_level_memory:{name:"ECAS Air Suspension Loading Dock Height Memory",desc:"Stores and recalls customized pneumatic air suspension height level presets for loading docks."},daf_stationary_dpf_regen_trigger:{name:"Stationary DPF Forced Soot Regeneration",desc:"Initiates stationary diesel particulate filter thermal soot burn routine in parked position."},ford_trucks_reverse_buzzer_night_mode:{name:"Reverse Acoustic Alarm Night Quiet Mode",desc:"Attenuates reverse backup horn alarm volume for quiet night distribution in residential areas."},cummins_ecm_fleet_speed_limiter:{name:"Cummins Engine Road Speed Limiter (RSL)",desc:"Programs maximum allowable road vehicle speed in Cummins ECM parameter tables."}},codeBtn:"\u0e23\u0e2b\u0e31\u0e2a",removeBtn:"\u0e25\u0e1a",unsupportedTitle:"\u0e44\u0e21\u0e48\u0e23\u0e2d\u0e07\u0e23\u0e31\u0e1a\u0e22\u0e32\u0e19\u0e1e\u0e32\u0e2b\u0e19\u0e30",unsupportedMsg:"\u0e40\u0e27\u0e2d\u0e23\u0e4c\u0e0a\u0e31\u0e19\u0e2e\u0e32\u0e23\u0e4c\u0e14\u0e41\u0e27\u0e23\u0e4c\u0e2b\u0e23\u0e37\u0e2d\u0e0b\u0e2d\u0e1f\u0e15\u0e4c\u0e41\u0e27\u0e23\u0e4c ECU \u0e02\u0e2d\u0e07\u0e23\u0e16\u0e22\u0e19\u0e15\u0e4c\u0e44\u0e21\u0e48\u0e23\u0e2d\u0e07\u0e23\u0e31\u0e1a\u0e1f\u0e35\u0e40\u0e08\u0e2d\u0e23\u0e4c\u0e19\u0e35\u0e49",selectBrand:"\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e22\u0e35\u0e48\u0e2b\u0e49\u0e2d\u0e23\u0e16\u0e22\u0e19\u0e15\u0e4c",selectCategory:"\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e2b\u0e21\u0e27\u0e14\u0e2b\u0e21\u0e39\u0e48",selectMakeTitle:"\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e22\u0e35\u0e48\u0e2b\u0e49\u0e2d\u0e23\u0e16",selectCategoryTitle:"\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e2b\u0e21\u0e27\u0e14\u0e2b\u0e21\u0e39\u0e48\u0e04\u0e38\u0e13\u0e2a\u0e21\u0e1a\u0e31\u0e15\u0e34",brandAll:"\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14",categoryAll:"\u0e17\u0e38\u0e01\u0e2b\u0e21\u0e27\u0e14\u0e2b\u0e21\u0e39\u0e48",lighting:"\u0e41\u0e2a\u0e07\u0e2a\u0e27\u0e48\u0e32\u0e07",soundAlerts:"\u0e01\u0e32\u0e23\u0e41\u0e08\u0e49\u0e07\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e14\u0e49\u0e27\u0e22\u0e40\u0e2a\u0e35\u0e22\u0e07",displayInstrument:"\u0e08\u0e2d\u0e41\u0e2a\u0e14\u0e07\u0e1c\u0e25 / \u0e04\u