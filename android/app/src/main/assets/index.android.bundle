al Dash Layout",desc:"Anvender bl\xe5t Alpina-signatur-tema til digitalt instrumentpanel."},bmw_video_in_motion:{name:"Video In Motion (VIM)",desc:"L\xe5ser op for USB-videoafspilning p\xe5 iDrive-sk\xe6rmen, mens du k\xf8rer."},bmw_sport_plus_mode_unlock:{name:"Aktiv\xe9r Sport+ K\xf8retilstand",desc:"Aktiverer Sport+ h\xf8jtydende dynamisk k\xf8retilstand i DEC-v\xe6lgeren."},mercedes_amg_menu_unlock:{name:"AMG Performance Telemetri Menu",desc:"Viser AMG olie temp, transmission temp, lap timer og G-meter."},mercedes_agility_mode_enable:{name:"Agility (A) Transmissionstilstand",desc:"L\xe5ser op for ultraresponsivt Agility-skifteprogram i 7G/9G-Tronic-transmission."},mercedes_drl_brightness_boost:{name:"K\xf8relys 100 % intensitet",desc:"\xd8ger LED-k\xf8relysets output til 100 % fuld lysstyrke."},mercedes_alarm_lock_chirp:{name:"Akustisk l\xe5sehorn Chirp",desc:"Udsender kort horn-kvidren, n\xe5r centrall\xe5sen er aktiveret."},mercedes_dpf_adblue_gauge:{name:"DPF sod & AdBlue niveaum\xe5ler",desc:"Viser n\xf8jagtig DPF-sodmasseprocent og resterende AdBlue-omr\xe5de i IC."},renault_rs_monitor_enable:{name:"Renault Sport RS Monitor Telemetri",desc:"Aktiverer live G-force, turbo boost og olietemp telemetri p\xe5 R-Link."},renault_duster_mirror_fold:{name:"Duster automatisk spejlfoldning p\xe5 l\xe5s",desc:"Folder sidespejle automatisk sammen via BCM centrall\xe5skommando."},ford_bambi_mode_fog_light:{name:"Bambi-tilstand (fjernlys + t\xe5gelygter)",desc:"Tillader t\xe5gelygter at forblive ON, n\xe5r fjernlys forlygter aktiveres."},ford_st_rs_boot_animation:{name:"ST/RS Performance SYNC Boot Screen",desc:"\xc6ndrer SYNC-ber\xf8ringssk\xe6rmens startsplash-animation til ST / RS-logo."},toyota_reverse_beep_mute:{name:"Bakgear Kontinuerlig kabinebip-d\xe6mpning",desc:"D\xe6mper kontinuerlig bakgears klokke inde i kabinen til et enkelt bip."},toyota_remote_window_drop:{name:"Key Fob Fjernbetjening vindue Rul ned",desc:"Ruller alle elruder ned, n\xe5r du holder opl\xe5sni