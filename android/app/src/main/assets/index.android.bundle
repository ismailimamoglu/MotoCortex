0631\u0627\u0646 \u0645\u062d\u0648\u0644\u0627\u062a Bluetooth Obd2 \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629 (\u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629) \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a Android Bluetooth \u0642\u0628\u0644 \u0623\u0646 \u062a\u0638\u0647\u0631 \u0641\u064a \u0627\u0644\u0641\u062d\u0635.",deviceNotPairedTitle:"\u0627\u0644\u062c\u0647\u0627\u0632 \u063a\u064a\u0631 \u0645\u0642\u062a\u0631\u0646",deviceNotPairedDesc:"\u0642\u0628\u0644 \u062a\u0648\u0635\u064a\u0644 \u0645\u062d\u0648\u0644\u0627\u062a Bluetooth Obd2 \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629\u060c \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0642\u0631\u0627\u0646\u0647\u0627 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a Bluetooth \u0628\u0647\u0627\u062a\u0641\u0643. \u064a\u062a\u0645 \u062a\u0648\u062c\u064a\u0647\u0643 \u0625\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645.",unsupportedDeviceTitle:"\u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u063a\u064a\u0631 \u0627\u0644\u0645\u062a\u0648\u0627\u0641\u0642\u0629",unsupportedDeviceDesc:"\u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0630\u064a \u062a\u062d\u0627\u0648\u0644 \u062a\u0648\u0635\u064a\u0644\u0647 \u0644\u064a\u0633 \u0645\u062d\u0648\u0644\u064b\u0627 \u0645\u062a\u0648\u0627\u0641\u0642\u064b\u0627 \u0645\u0639 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 Obd2 \u0623\u0648 \u0644\u0627 \u064a\u062f\u0639\u0645 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629.",sendButton:"\u064a\u0631\u0633\u0644",connectDevice:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u062c\u0647\u0627\u0632 OBD2",adapterApproved:"\u062a\u0645\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u062d\u0648\u0644. \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0642\u062f\u0631\u0627\u062a... [2/5]",protocolNegotiating:"\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0627\u0644\u0645\u0633\u062d \u0648\u0627\u0644\u0627\u0633\u062a\u064a\u0642\u0627\u0638... [3/5]",ecuDetected:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c \u0648\u0627\u0644\u062a\u062d\u0642\u0642... [4/5]",ecuResponding:"\u0627\u0633\u062a\u062c\u0627\u0628\u062a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c \u0648\u0627\u0643\u062a\u0645\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644... [5/5]",protocolScanningHint:"(\u0645\u0633\u062d \u0627\u0644\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644\u0627\u062a \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629 SP5\u060c SP3\u060c SP6\u060c SP7 \u0628\u0627\u0644\u062a\u0633\u0644\u0633\u0644 ...)",protocolFailed:" \u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0627\u0644\u0645\u062a\u0648\u0627\u0641\u0642! (\u062a\u0645 \u062a\u062c\u0631\u0628\u0629 SP5\u060c SP3\u060c SP4\u060c SP6\u060c SP7)",ecuNotFound:" \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0644\u0627 \u062a\u0633\u062a\u062c\u064a\u0628!",hardwareCapabilityScore:"\u062f\u0631\u062c\u0629 \u0642\u062f\u0631\u0629 \u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u062d\u0648\u0644: {{score}}/100",hardwareFatal:"\u062e\u0637\u0623 \u0641\u0627\u062f\u062d: \u0623\u062c\u0647\u0632\u062a\u0643 \u0639\u0628\u0627\u0631\u0629 \u0639\u0646 \u0646\u0633\u062e\u0629 \u0632\u0627\u0626\u0641\u0629 \u0648\u0644\u0627 \u062a\u062f\u0639\u0645 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629. \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0631\u0629. \u064a\u0631\u062c\u0649 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u062d\u0648\u0644 \u0627\u0644\u062c\u0648\u062f\u0629 (\u0627\u0644\u0625\u0635\u062f\u0627\u0631 1.5 \u0623\u0648 \u0627\u0644\u0623\u0635\u0644\u064a).",progressFormat:"{{progress}}%",btDisabled:"\u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u0645\u0639\u0637\u0644",btDisabledDesc:"\u064a\u0631\u062c\u0649 \u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u0644\u0644\u0628\u062d\u062b \u0639\u0646 \u0645\u062d\u0648\u0644\u0627\u062a OBD2.",btDescIos:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u062d\u0648\u0644\u0627\u062a BLE OBD2 (Veepeak \u060c vLinker).",btDescAndroid:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0639\u0628\u0631 \u0645\u062d\u0648\u0644\u0627\u062a \u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a \u0623\u0648 BLE.",wifiDesc:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0645\u062d\u0648\u0644\u0627\u062a Wi-Fi (\u0639\u0627\u062f\u0629\u064b 192.168.0.10).",wifiGuide:"\u0644\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0645\u062d\u0648\u0644 Wi-Fi \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u060c \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a Wi-Fi \u0628\u0647\u0627\u062a\u0641\u0643 \u0648\u0627\u062e\u062a\u0631 \u0634\u0628\u0643\u0629 \u0645\u062d\u0648\u0644 OBD (\u0645\u062b\u0644 OBDII \u060c V-LINK). \u062b\u0645 \u0639\u062f \u0625\u0644\u0649 \u0647\u0646\u0627.",openWifiSettings:"\u0627\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a WI-FI",connectWifi:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0639\u0628\u0631 WI-FI",pairRequired:"\u0627\u0642\u062a\u0631\u0627\u0646 \u062c\u0647\u0627\u0632 OBD2",pairRequiredDesc:"\u0642\u062f \u064a\u0637\u0644\u0628 \u0646\u0638\u0627\u0645 Android \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0646 \u0644\u0623\u0646\u0643 \u062a\u062a\u0635\u0644 \u0644\u0644\u0645\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649. \u0639\u0627\u062f\u0629\u064b \u0645\u0627 \u064a\u0643\u0648\u0646 \u0631\u0642\u0645 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0646 (PIN) \u0643\u0645\u0627 \u064a\u0644\u064a:",pairNow:"\u0627\u0642\u062a\u0631\u0627\u0646 \u0648\u0627\u062a\u0635\u0627\u0644",pairingFailed:"\u0641\u0634\u0644 \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0646. \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0646 \u064a\u062f\u0648\u064a\u064b\u0627 \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a Android.",successVin:"\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0627\u062a\u0635\u0627\u0644. \u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0628\u0646\u062c\u0627\u062d.",cloneWarning:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0645\u062d\u0648\u0644 \u063a\u064a\u0631 \u0645\u062a\u0648\u0627\u0641\u0642. \u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u0631\u0645\u064a\u0632 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0645\u063a\u0644\u0642\u0629 \u0644\u0633\u0644\u0627\u0645\u062a\u0643.",viewHealth:"\u0642\u0627\u0626\u0645\u0629 \u0635\u062d\u0629 \u0648\u0642\u062f\u0631\u0627\u062a OBD2",statusPrompt:"\u062d\u062f\u062f \u0648\u0627\u062c\u0647\u0629 \u0627\u062a\u0635\u0627\u0644 OBD2 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0644\u062f\u064a\u0643 \u0623\u062f\u0646\u0627\u0647.",scanHintIos:"\u062a\u0623\u0643\u062f \u0645\u0646 \u062a\u0634\u063a\u064a\u0644 \u0645\u062d\u0648\u0644 BLE OBD2 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0648\u0642\u0631\u0628\u0647 \u0645\u0646 \u062c\u0647\u0627\u0632 iOS \u0627\u0644\u062e\u0627\u0635 \u0628\u0643.",scanHintAndroid:"\u062a\u0623\u0643\u062f \u0645\u0646 \u062a\u0646\u0634\u064a\u0637 \u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u0648\u0623\u0646 \u0627\u0644\u0645\u062d\u0648\u0644 \u062c\u0627\u0647\u0632 \u0644\u0644\u0627\u0642\u062a\u0631\u0627\u0646.",negotiating:"\u062c\u0627\u0631\u064a \u0628\u062f\u0621 \u0627\u062a\u0635\u0627\u0644 OBD2",failed:"\u0641\u0634\u0644\u062a \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644",errLayer1:"\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621: \u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u0645\u0639\u0637\u0644. \u064a\u0631\u062c\u0649 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u062c\u0647\u0627\u0632\u0643.",errLayer2:"\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621: \u0627\u0646\u062a\u0647\u062a \u0645\u0647\u0644\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644. \u062a\u0623\u0643\u062f \u0645\u0646 \u0625\u062f\u062e\u0627\u0644 \u0627\u0644\u0645\u062d\u0648\u0644 \u0628\u0625\u062d\u0643\u0627\u0645 \u0641\u064a \u0645\u0646\u0641\u0630 OBD2 \u0648\u0625\u0636\u0627\u0621\u0629 \u0645\u0624\u0634\u0631 \u0627\u0644\u0637\u0627\u0642\u0629.",errLayer5:"\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621: \u0641\u0634\u0644 \u0628\u062f\u0621 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 OBD2. \u062a\u0623\u0643\u062f \u0645\u0646 \u062a\u0634\u063a\u064a\u0644 \u0645\u0641\u062a\u0627\u062d \u062a\u0634\u063a\u064a\u0644 \u0633\u064a\u0627\u0631\u062a\u0643 \u0625\u0644\u0649 \u0648\u0636\u0639 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 ON (\u064a\u0648\u0635\u0649 \u0628\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643).",errLayer6:"\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621: \u062a\u0645 \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0645\u062d\u0648\u0644 \u060c \u0644\u0643\u0646 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0631\u0629 (ECU) \u0644\u0627 \u062a\u0633\u062a\u062c\u064a\u0628. \u064a\u0631\u062c\u0649 \u062a\u0634\u063a\u064a\u0644 \u0648\u0636\u0639 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 ON \u0623\u0648 \u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644.",errGeneric:"\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621: \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0648\u0635\u0648\u0644 \u0627\u0644\u0637\u0627\u0642\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u0648\u0644 \u060c \u0648\u062a\u0634\u063a\u064a\u0644 \u0648\u0636\u0639 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 ON \u060c \u0648\u0639\u062f\u0645 \u0641\u062a\u062d \u0623\u064a \u062a\u0637\u0628\u064a\u0642 OBD \u0622\u062e\u0631.",stepAdapter:"\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0645\u062d\u0648\u0644 \u0648\u062f\u0631\u062c\u0629 \u0627\u0644\u0642\u062f\u0631\u0629",stepProtocol:"\u062a\u0641\u0627\u0648\u0636 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 OBD2",stepHandshake:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u062a\u0635\u0627\u0644 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 (ECU)",stepStabilization:"\u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u062d\u0644\u0642\u0629 \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0627\u0644\u0646\u0634\u0637\u0629",cancel:"\u064a\u0644\u063a\u064a",terminalTitle:"\u0645\u062d\u0637\u0629 obd/\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0645\u062e\u0635\u0635",terminalDesc:"\u064a\u0645\u0643\u0646\u0643 \u0625\u0631\u0633\u0627\u0644 \u0623\u0648\u0627\u0645\u0631 obd-ii \u0623\u0648 at/st \u0645\u0628\u0627\u0634\u0631\u0629 \u0625\u0644\u0649 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629. \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c \"010C\" (\u0639\u062f\u062f \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0643 \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629) \u0623\u0648 \"ATRV\" (\u062c\u0647\u062f \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629).",ecuResponseLabel:"\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629:",adapterConnected:"\u0627\u0644\u0645\u062d\u0648\u0644 \u0645\u062a\u0635\u0644 (\u0645\u0648\u0627\u0641\u0642)",lowQualityAdapterWarning:" \u0645\u062d\u0648\u0644 \u0645\u0646\u062e\u0641\u0636 \u0627\u0644\u062c\u0648\u062f\u0629 (\u0627\u0644\u0646\u062a\u064a\u062c\u0629: {{score}}/100): \u0627\u0644\u0645\u062d\u0648\u0644 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0639\u0628\u0627\u0631\u0629 \u0639\u0646 \u0627\u0633\u062a\u0646\u0633\u0627\u062e \u0645\u0646\u062e\u0641\u0636 \u0627\u0644\u062c\u0648\u062f\u0629. \u0625\u0646\u0647 \u064a\u0641\u062a\u0642\u0631 \u0625\u0644\u0649 \u062f\u0642\u0629 \u0627\u0644\u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0644\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 (\u0645\u062b\u0644 K-Line \u0641\u064a Dacia \u0648Renault \u0648Fiat \u0648Lada). \u0646\u0648\u0635\u064a \u0628\u0634\u062f\u0629 \u0628\u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0625\u0644\u0649 \u0645\u062d\u0648\u0644 OBD2 \u0639\u0627\u0644\u064a \u0627\u0644\u062c\u0648\u062f\u0629 (\u0627\u0644\u0625\u0635\u062f\u0627\u0631 1.5 \u0623\u0648 OBDLink/vLinker \u0627\u0644\u0623\u0635\u0644\u064a) \u0644\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0646\u062c\u0627\u062d.",statusProfiling:"\u062a\u062d\u0644\u064a\u0644 \u0642\u062f\u0631\u0627\u062a \u0645\u062d\u0648\u0644 obd2...",statusScanningCan:"\u062c\u0627\u0631\u064d \u0641\u062d\u0635 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644\u0627\u062a CAN-Bus \u0627\u0644\u062d\u062f\u064a\u062b\u0629...",statusScanningKline:"\u0627\u0644\u0627\u0633\u062a\u064a\u0642\u0627\u0638 \u0645\u0646 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644\u0627\u062a K-Line. \u0642\u062f \u062a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 (\u062f\u0627\u0633\u064a\u0627\u060c \u0631\u064a\u0646\u0648\u060c \u0641\u064a\u0627\u062a) \u0645\u0627 \u064a\u0635\u0644 \u0625\u0644\u0649 15 \u062b\u0627\u0646\u064a\u0629 \u0644\u0644\u0631\u062f...",statusHandshake:"\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u062a\u0635\u0627\u0644 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629...",statusStabilization:"\u062c\u0627\u0631\u064d \u062a\u062b\u0628\u064a\u062a \u062a\u062f\u0641\u0642 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u064f\u0639\u062f...",changeType:"\u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644",errBluetoothUnavailable:"\u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631 \u0623\u0648 \u0645\u0639\u0637\u0644",errDeviceNotFound:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u062c\u0647\u0627\u0632 obd2",errTimeout:"\u0627\u0646\u062a\u0647\u062a \u0645\u0647\u0644\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644",errProtocolFailed:"\u0641\u0634\u0644 \u0627\u0644\u062a\u0641\u0627\u0648\u0636 \u0639\u0644\u0649 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 obd2",errEcuHandshake:"\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0644\u0627 \u062a\u0633\u062a\u062c\u064a\u0628",requiredTitle:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0645\u0637\u0644\u0648\u0628",requiredDesc:"\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u062c\u0647\u0627\u0632 obd2 \u0623\u0648 \u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a.",connectBtn:"\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u062c\u0647\u0627\u0632",noActiveTitle:"\u0644\u0627 \u064a\u0648\u062c\u062f \u0627\u062a\u0635\u0627\u0644 \u0646\u0634\u0637",noActiveDesc:"\u0644\u0627 \u064a\u0648\u062c\u062f \u0627\u062a\u0635\u0627\u0644 obd2 \u0646\u0634\u0637 \u0644\u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0647.",scanningAdapter:" \u062c\u0627\u0631\u064a \u0641\u062d\u0635 \u0627\u0644\u0645\u062d\u0648\u0644 (\u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0631\u062f)...",scanningDevices:"\u062c\u0627\u0631\u064a \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0623\u062c\u0647\u0632\u0629 OBD2 Bluetooth...",quickConnectTitle:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0645\u062d\u0648\u0644 \u0627\u0644\u0623\u062e\u064a\u0631",quickConnectDesc:"\u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0633\u0631\u064a\u0639 \u0628\u0645\u0647\u0627\u064a\u0626\u0643 \u0627\u