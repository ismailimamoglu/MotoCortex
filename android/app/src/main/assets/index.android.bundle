aomi_su7_hyperos_driver_profile_sync:{name:"Xiaomi SU7 HyperOS Driver Profile Ecosystem Sync",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0454 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0438\u0434\u0456\u043d\u043d\u044f, \u0434\u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u0442\u0430 \u043a\u043b\u0456\u043c\u0430\u0442\u0443 \u0447\u0435\u0440\u0435\u0437 Bluetooth \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 Xiaomi."},xiaomi_su7_boost_mode_throttle_curve:{name:"20-\u0441\u0435\u043a\u0443\u043d\u0434\u043d\u0435 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0435\u0436\u0438\u043c\u0443 \u043f\u043e\u0441\u0438\u043b\u0435\u043d\u043d\u044f",desc:"\u0417\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0443 \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u043d\u0430\u0434\u0434\u0443\u0432\u0443 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u044f."},xiaomi_su7_drift_mode_torque_vectoring:{name:"\u0420\u0435\u0436\u0438\u043c Drift RWD Torque Vectoring Allocation",desc:"\u0420\u043e\u0437\u043f\u043e\u0434\u0456\u043b\u044f\u0454 100% \u043a\u0440\u0443\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0443 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u043d\u0430 \u0437\u0430\u0434\u043d\u044e \u0432\u0456\u0441\u044c \u0456\u0437 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0438\u043c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0442\u044f\u0433\u0438."},chery_isa_overspeed_warning_chime_off:{name:"ISA Intelligent Speed Assist Warning Chime Mute",desc:"\u0412\u0438\u043c\u0438\u043a\u0430\u0454 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u0438\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u0438\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0435\u043d\u043d\u0456 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043e\u0433\u043e \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456."},chery_driver_monitoring_camera_sensitivity:{name:"DMS \u041c\u043e\u043d\u0456\u0442\u043e\u0440\u0438\u043d\u0433 \u0432\u0442\u043e\u043c\u0438 \u0432\u043e\u0434\u0456\u044f \u0427\u0443\u0442\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u043a\u0430\u043c\u0435\u0440\u0438",desc:"\u0417\u043c\u0435\u043d\u0448\u0443\u0454 \u0445\u0438\u0431\u043d\u043e-\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u0456 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u0432\u0456\u0434\u0432\u043e\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u0432\u0456\u0434 \u0432\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u044c\u043e\u0457 \u043a\u0430\u043c\u0435\u0440\u0438 \u0441\u043f\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f."},retrofit_parking_sensor_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0456\u0437\u043e\u0432\u0430\u043d\u0435 \u043a\u043e\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e/\u0437\u0430\u0434\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0456\u0457 \u043f\u0430\u0440\u043a\u0443\u0432\u0430\u043d\u043d\u044f (PDC).",desc:"\u0420\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044f \u043f\u043e\u0437\u0430\u043f\u0440\u043e\u0434\u0430\u0436\u043d\u043e\u0433\u043e \u0430\u0431\u043e OEM-\u043c\u043e\u0434\u0443\u043b\u044f \u043f\u0430\u0440\u043a\u0443\u0432\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0432 \u0441\u043f\u0438\u0441\u043a\u0443 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0448\u043b\u044e\u0437\u0443."},retrofit_360_camera_activation:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u043a\u0430\u043c\u0435\u0440 \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u043e\u0433\u043b\u044f\u0434\u0443 360\xb0",desc:"\u0410\u043a\u0442\u0438\u0432\u0443\u0454 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440 \u043a\u0430\u043c\u0435\u0440\u0438 \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u043e\u0433\u043b\u044f\u0434\u0443 \u0442\u0430 \u0434\u043e\u0434\u0430\u0454 \u0432\u0438\u0434 \u043a\u0430\u043c\u0435\u0440\u0438 \u0434\u043e \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0439\u043d\u043e-\u0440\u043e\u0437\u0432\u0430\u0436\u0430\u043b\u044c\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438."},retrofit_led_license_plate_light_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0456\u0437\u043e\u0432\u0430\u043d\u0435 \u0441\u0432\u0456\u0442\u043b\u043e\u0434\u0456\u043e\u0434\u043d\u0435 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u043a\u0430 \u0442\u0430 \u0437\u0430\u0434\u043d\u044c\u043e\u0433\u043e \u043b\u0456\u0445\u0442\u0430\u0440\u044f",desc:"\u0412\u0438\u043c\u0438\u043a\u0430\u0454 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0457 \u043b\u0430\u043c\u043f\u0438, \u0449\u043e\u0431 \u0437\u0430\u043f\u043e\u0431\u0456\u0433\u0442\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u0432\u0438\u043c \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f\u043c \u043f\u0440\u043e \u0432\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u043b\u0430\u043c\u043f\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0