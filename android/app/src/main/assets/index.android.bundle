3bb\u03b9\u03ba\u03ae\u03c2 \u03b1\u03bd\u03c4\u03bb\u03af\u03b1\u03c2 ABS",absSubtitle:"\u039a\u03c5\u03ba\u03bb\u03bf\u03c6\u03bf\u03c1\u03b5\u03af \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bc\u03b1\u03b3\u03bd\u03b7\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b2\u03b1\u03bb\u03b2\u03af\u03b4\u03b5\u03c2 ABS \u03b3\u03b9\u03b1 \u03c4\u03bf\u03bd \u03ba\u03b1\u03b8\u03b1\u03c1\u03b9\u03c3\u03bc\u03cc \u03c4\u03c9\u03bd \u03c6\u03c5\u03c3\u03b1\u03bb\u03af\u03b4\u03c9\u03bd \u03b1\u03ad\u03c1\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03b3\u03c1\u03b1\u03bc\u03bc\u03ad\u03c2 \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd.",ecuRejected:"ECU \u03b1\u03c0\u03ad\u03c1\u03c1\u03b9\u03c8\u03b5 \u03b5\u03bd\u03c4\u03bf\u03bb\u03ae \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac\u03c2. \u0392\u03b5\u03b2\u03b1\u03b9\u03c9\u03b8\u03b5\u03af\u03c4\u03b5 \u03cc\u03c4\u03b9 \u03b7 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03b7 \u03ba\u03b1\u03b9 \u03bf \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf\u03c2."},aiDoctor:{analyzing:"\u0391\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03ba\u03c9\u03b4\u03b9\u03ba\u03ce\u03bd DTC \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03bc\u03b5 AI Doctor...",healthImpact:"\u0391\u03bd\u03c4\u03af\u03ba\u03c4\u03c5\u03c0\u03bf\u03c2 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1\u03c2 \u03c5\u03b3\u03b5\u03af\u03b1\u03c2: {{score}}/100",drivingSafety:"\u039f\u03b4\u03b7\u03b3\u03af\u03b5\u03c2 \u0391\u03c3\u03c6\u03ac\u03bb\u03b5\u03b9\u03b1\u03c2 \u039f\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2",causes:"\u03a0\u03b9\u03b8\u03b1\u03bd\u03ad\u03c2 \u03b1\u03b9\u03c4\u03af\u03b5\u03c2",recommendedAction:"\u03a3\u03c5\u03bd\u03b9\u03c3\u03c4\u03ce\u03bc\u03b5\u03bd\u03b7 \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03ba\u03ae \u03b4\u03c1\u03ac\u03c3\u03b7",estimatedCost:"\u0395\u03ba\u03c4\u03b9\u03bc\u03ce\u03bc\u03b5\u03bd\u03bf \u03ba\u03cc\u03c3\u03c4\u03bf\u03c2 \u03b5\u03be\u03b1\u03c1\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 / \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c5\u03ae\u03c2",noFaultsTitle:"System Optimal \u2014 \u0394\u03b5\u03bd \u03b5\u03bd\u03c4\u03bf\u03c0\u03af\u03c3\u03c4\u03b7\u03ba\u03b1\u03bd \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2",noFaultsSummary:"\u0397 \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1 ECU \u03b4\u03b5\u03bd \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03cd\u03c2 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b7\u03c2 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5. \u039f\u03b9 \u03c0\u03b1\u03c1\u03ac\u03bc\u03b5\u03c4\u03c1\u03bf\u03b9 \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b2\u03c1\u03af\u03c3\u03ba\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b5\u03bd\u03c4\u03cc\u03c2 \u03c4\u03c9\u03bd \u03ba\u03b1\u03bd\u03bf\u03bd\u03b9\u03ba\u03ce\u03bd \u03bf\u03c1\u03af\u03c9\u03bd \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2.",stepMaintain:"\u0394\u03b9\u03b1\u03c4\u03b7\u03c1\u03b5\u03af\u03c4\u03b5 \u03c4\u03b1\u03ba\u03c4\u03b9\u03ba\u03ac \u03b4\u03b9\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03bb\u03b1\u03b4\u03b9\u03bf\u03cd \u03ba\u03b1\u03b9 \u03c6\u03af\u03bb\u03c4\u03c1\u03bf\u03c5.",stepCheckVoltage:"\u0395\u03bb\u03ad\u03b3\u03c7\u03b5\u03c4\u03b5 \u03c0\u03b5\u03c1\u03b9\u03bf\u03b4\u03b9\u03ba\u03ac \u03c4\u03b7\u03bd \u03c4\u03ac\u03c3\u03b7 \u03b7\u03c1\u03b5\u03bc\u03af\u03b1\u03c2 \u03c4\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2.",safeDrive:"\u0391\u03c3\u03c6\u03b1\u03bb\u03ad\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1.",misfireTitle:"\u0395\u03bd\u03c4\u03bf\u03c0\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03b1\u03c3\u03c4\u03bf\u03c7\u03af\u03b1 \u03ba\u03c5\u03bb\u03af\u03bd\u03b4\u03c1\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",misfireSummary:"\u0395\u03bd\u03c4\u03bf\u03c0\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03b5\u03bd\u03b5\u03c1\u03b3\u03ae \u03b1\u03c3\u03c4\u03bf\u03c7\u03af\u03b1 \u03c3\u03b5 \u03ad\u03bd\u03b1\u03bd \u03ae \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03bf\u03c5\u03c2 \u03ba\u03c5\u03bb\u03af\u03bd\u03b4\u03c1\u03bf\u03c5\u03c2. \u03a4\u03bf \u03ac\u03ba\u03b1\u03c5\u03c3\u03c4\u03bf \u03ba\u03b1\u03cd\u03c3\u03b9\u03bc\u03bf \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b5\u03b9\u03c3\u03ad\u03bb\u03b8\u03b5\u03b9 \u03c3\u03c4\u03bf\u03bd \u03ba\u03b1\u03c4\u03b1\u03bb\u03cd\u03c4\u03b7 \u03c0\u03c1\u03bf\u03ba\u03b1\u03bb\u03ce\u03bd\u03c4\u03b1\u03c2 \u03bc\u03cc\u03bd\u03b9\u03bc\u03b7 \u03b6\u03b7\u03bc\u03b9\u03ac.",causeSparkPlug:"\u03a6\u03b8\u03b1\u03c1\u03bc\u03ad\u03bd\u03bf \u03ae \u03bb\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf \u03bc\u03c0\u03bf\u03c5\u03b6\u03af",causeIgnitionCoil:"\u0391\u03c0\u03bf\u03c4\u03c5\u03c7\u03af\u03b1 \u03c0\u03b7\u03bd\u03af\u03bf\u03c5 \u03ae \u03c3\u03cd\u03c1\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2",causeFuelInjector:"\u0392\u03bf\u03c5\u03bb\u03c9\u03bc\u03ad\u03bd\u03bf \u03ae \u03b5\u03bb\u03b1\u03c4\u03c4\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03bc\u03c0\u03b5\u03ba \u03c8\u03b5\u03ba\u03b1\u03c3\u03bc\u03bf\u03cd \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5",stepInspectPlugs:"\u0395\u03c0\u03b9\u03b8\u03b5\u03c9\u03c1\u03ae\u03c3\u03c4\u03b5 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03bf\u03af\u03be\u03c4\u03b5 \u03c4\u03b1 \u03bc\u03c0\u03bf\u03c5\u03b6\u03af.",stepSwapCoils:"\u0391\u03bb\u03bb\u03ac\u03be\u03c4\u03b5 \u03c4\u03b1 \u03c0\u03b7\u03bd\u03af\u03b1 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2 \u03bc\u03b5\u03c4\u03b1\u03be\u03cd \u03c4\u03c9\u03bd \u03ba\u03c5\u03bb\u03af\u03bd\u03b4\u03c1\u03c9\u03bd \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b5\u03bb\u03ad\u03b3\u03be\u03b5\u03c4\u03b5 \u03c4\u03b7 \u03bc\u03b5\u03c4\u03b1\u03c6\u03bf\u03c1\u03ac \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2.",stepFuelPressure:"\u039c\u03b5\u03c4\u03c1\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c0\u03af\u03b5\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c9\u03bb\u03ae\u03bd\u03b1 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5.",criticalDrive:"\u039c\u03b7\u03bd \u03bf\u03b4\u03b7\u03b3\u03b5\u03af\u03c4\u03b5 \u03b5\u03ba\u03c4\u03b5\u03c4\u03b1\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b1\u03c0\u03bf\u03c3\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2 \u03bc\u03b5 \u03b2\u03b1\u03c1\u03cd \u03b3\u03ba\u03ac\u03b6\u03b9. \u039f\u03b4\u03b7\u03b3\u03ae\u03c3\u03c4\u03b5 \u03b1\u03bc\u03ad\u03c3\u03c9\u03c2 \u03c3\u03c4\u03bf \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2.",o2Title:"\u0394\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03bf\u03be\u03c5\u03b3\u03cc\u03bd\u03bf\u03c5.",o2Summary:"\u0397 \u03b1\u03bd\u03ac\u03b4\u03c1\u03b1\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03bc\u03b5\u03af\u03b3\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03ad\u03c1\u03b1-\u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u03c5\u03c0\u03bf\u03b2\u03b1\u03b8\u03bc\u03af\u03b6\u03b5\u03c4\u03b1\u03b9. \u039f \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03c0\u03bb\u03bf\u03cd\u03c3\u03b9\u03bf\u03c2 \u03ae \u03b1\u03b4\u03cd\u03bd\u03b1\u03c4\u03bf\u03c2, \u03bc\u03b5\u03b9\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5.",causeO2Heater:"\u0392\u03bb\u03ac\u03b2\u03b7 \u03b8\u03b5\u03c1\u03bc\u03b1\u03bd\u03c4\u03b9\u03ba\u03bf\u03cd \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 O2",causeExhaustLeak:"\u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae \u03c0\u03bf\u03bb\u03bb\u03b1\u03c0\u03bb\u03ae\u03c2 \u03b5\u03be\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03b1\u03bd\u03ac\u03bd\u03c4\u03b7 \u03c4\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1",causeHarness:"\u039a\u03b1\u03c4\u03b5\u03c3\u03c4\u03c1\u03b1\u03bc\u03bc\u03ad\u03bd\u03bf\u03c2 \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03bc\u03bf\u03c2 \u03ba\u03b1\u03bb\u03c9\u03b4\u03af\u03c9\u03c3\u03b7\u03c2",stepCheckWiring:"\u0395\u03c0\u03b9\u03b8\u03b5\u03c9\u03c1\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03ba\u03b1\u03bb\u03c9\u03b4\u03af\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 O2 \u03b3\u03b9\u03b1 \u03c4\u03ae\u03be\u03b7 \u03ae \u03be\u03ad\u03c6\u03c4\u03b9\u03c3\u03bc\u03b1.",stepCleanSensor:"\u039a\u03b1\u03b8\u03b1\u03c1\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf \u03ac\u03ba\u03c1\u03bf \u03c4\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 O2 \u03ae \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b5\u03ac\u03bd \u03b7 \u03b1\u03bd\u03c4\u03af\u03c3\u03c4\u03b1\u03c3\u03b7 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03ba\u03c4\u03cc\u03c2 \u03c0\u03c1\u03bf\u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ce\u03bd.",warningDrive:"\u0391\u03c3\u03c6\u03b1\u03bb\u03ad\u03c2 \u03b3\u03b9\u03b1 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7 \u03c3\u03b5 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03bf \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c5\u03ae\u03c2 \u03bc\u03b5 \u03bc\u03ad\u03c4\u03c1\u03b9\u03b1 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1.",genericTitle:"\u0391\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd \u03ba\u03ce\u03b4\u03b9\u03ba\u03b1",genericSummary:"\u0395\u03bd\u03c4\u03bf\u03c0\u03af\u03c3\u03c4\u03b7\u03ba\u03b1\u03bd \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03af \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2: {{codes}}. \u03a3\u03c5\u03bd\u03b9\u03c3\u03c4\u03ac\u03c4\u03b1\u03b9 \u03b7 \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2.",causeGeneric1:"\u039a\u03cd\u03ba\u03bb\u03c9\u03bc\u03b1 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b5\u03ba\u03c4\u03cc\u03c2 \u03b1\u03bd\u03b1\u03bc\u03b5\u03bd\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5 \u03b5\u03cd\u03c1\u03bf\u03c5\u03c2 \u03c4\u03ac\u03c3\u03b7\u03c2",causeGeneric2:"\u03a7\u03b1\u03bb\u03b1\u03c1\u03ae \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ae \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7 \u03ae \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03b3\u03b5\u03af\u03c9\u03c3\u03b7\u03c2",stepGeneric1:"\u0395\u03ba\u03c4\u03b5\u03bb\u03ad\u03c3\u03c4\u03b5 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ae \u03c3\u03ac\u03c1\u03c9\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03b1\u03b3\u03c1\u03ac\u03c8\u03c4\u03b5 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03ba\u03b1\u03c1\u03ad \u03c0\u03b1\u03b3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2.",stepGeneric2:"\u0394\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03c4\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03cd\u03c2 DTC \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03b5\u03c0\u03b9\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03c3\u03c5\u03bd\u03b4\u03ad\u03c3\u03bc\u03c9\u03bd \u03ba\u03b1\u03bb\u03c9\u03b4\u03af\u03c9\u03c3\u03b7\u03c2.",reportTitle:"\u0391\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd \u03ba\u03ce\u03b4\u03b9\u03ba\u03b1",healthImpactTitle:"\u0395\u03a0\u0399\u03a0\u03a4\u03a9\u03a3\u0397 \u0392\u0391\u0398\u039c\u039f\u039b\u039f\u0393\u0399\u0391\u03a3 \u03a5\u0393\u0395\u0399\u0391\u03a3 \u039a\u0399\u039d\u0397\u03a4\u0397\u03a1\u0391",freeTrialBadge:"\u03a7\u03a1\u0397\u03a3\u0399\u039c\u039f\u03a0\u039f\u0399\u0395\u0399\u03a4\u0395 \u03a4\u0397 1 \u0394\u03a9\u03a1\u0395\u0391\u039d \u0394\u039f\u039a\u0399\u039c\u0397 \u0394\u0399\u0391\u0393\u039d\u03a9\u03a3\u0397\u03a3 AI",modalTitle:"Modal Title",modalSubtitle:"Modal Subtitle"},dtcRisk:{safeTitle:"\u0391\u03a3\u03a6\u0391\u039b\u0395\u03a3 \u0393\u0399\u0391 \u039f\u0394\u0397\u0393\u0397\u03a3\u0397",safeDesc:"\u0391\u03c5\u03c4\u03ae \u03b7 \u03b2\u03bb\u03ac\u03b2\u03b7 \u03b4\u03b5\u03bd \u03b1\u03c0\u03b5\u03b9\u03bb\u03b5\u03af \u03ac\u03bc\u03b5\u03c3\u03b1 \u03c4\u03b7\u03bd \u03b1\u03c3\u03c6\u03ac\u03bb\u03b5\u03b9\u03b1. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03bf\u03b4\u03b7\u03b3\u03ae\u03c3\u03b5\u03c4\u03b5 \u03bc\u03b5 \u03bc\u03ad\u03c4\u03c1\u03b9\u03b1 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 \u03ad\u03c9\u03c2 \u03c4\u03bf \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03bf.",warningTitle:"\u03a0\u03a1\u039f\u0395\u0399\u0394\u039f\u03a0\u039f\u0399\u0397\u03a3\u0397: \u0391\u03a0\u0391\u0399\u03a4\u0395\u0399\u03a4\u0391\u0399 \u0395\u039b\u0395\u0393\u03a7\u039f\u03a3 \u03a3\u03a5\u039d\u0395\u03a1\u0393\u0395\u0399\u039f\u03a5",warningDesc:"\u039c\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03c0\u03c1\u03bf\u03ba\u03bb\u03b7\u03b8\u03b5\u03af \u03b1\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1 \u03b9\u03c3\u03c7\u03cd\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03c5\u03be\u03b7\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b5\u03ba\u03c0\u03bf\u03bc\u03c0\u03ad\u03c2. \u0395\u03c0\u03b9\u03c3\u03ba\u03b5\u03c6\u03b8\u03b5\u03af\u03c4\u03b5 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b1 \u03ad\u03bd\u03b1 \u03b5\u03be\u03bf\u03c5\u03c3\u03b9\u03bf\u03b4\u03bf\u03c4\u03b7\u03bc\u03ad\u03bd\u03bf \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b5\u03af\u03bf.",criticalTitle:"\u039a\u03a1\u0399\u03a3\u0399\u039c\u039f: \u03a3\u03a4\u0391\u039c\u0391\u03a4\u0397\u03a3\u03a4\u0395 \u03a4\u0397\u039d \u039f\u0394\u0397\u0393\u0397\u03a3\u0397 / \u03a3\u03a5\u039d\u0395\u03a1\u0393\u0395\u0399\u039f",criticalDesc:"\u039a\u03c1\u03af\u03c3\u03b9\u03bc\u03bf\u03c2 \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03ba\u03cc\u03c2 \u03ae \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03cc\u03c2 \u03ba\u03af\u03bd\u03b4\u03c5\u03bd\u03bf\u03c2! \u039f \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03ae \u03c4\u03b1 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03b1\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03c5\u03c0\u03bf\u03c3\u03c4\u03bf\u03cd\u03bd \u03b2\u03bb\u03ac\u03b2\u03b7. \u03a3\u03c4\u03b1\u03bc\u03b1\u03c4\u03ae\u03c3\u03c4\u03b5 \u03b1\u03bc\u03ad\u03c3\u03c9\u03c2."},dtcDetail:{descTitle:"\u03a0\u0395\u03a1\u0399\u0393\u03a1\u0391\u03a6\u0397 \u039a\u03a9\u0394\u0399\u039a\u039f\u03a5 \u0392\u039b\u0391\u0392\u0397\u03a3",possibleCausesTitle:"\u03a0\u0399\u0398\u0391\u039d\u0395\u03a3 \u0391\u0399\u03a4\u0399\u0395\u03a3 & \u039f\u0394\u0397\u0393\u0399\u0395\u03a3 \u0395\u03a0\u0399\u03a3\u039a\u0395\u03a5\u0397\u03a3",cause1:"\u03a7\u03b1\u03bb\u03b1\u03c1\u03ae \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7 \u03ae \u03b4\u03b9\u03ac\u03b2\u03c1\u03c9\u03c3\u03b7 \u03c3\u03c4\u03bf \u03ba\u03cd\u03ba\u03bb\u03c9\u03bc\u03b1 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03ae \u03c3\u03c4\u03b7\u03bd \u03c0\u03bb\u03b5\u03be\u03bf\u03cd\u03b4\u03b1 \u03ba\u03b1\u03bb\u03c9\u03b4\u03af\u03c9\u03c3\u03b7\u03c2",cause2:"\u039c\u03b7\u03c7\u03b1\u03bd\u03b9\u03ba\u03ae \u03c6\u03b8\u03bf\u03c1\u03ac \u03ae \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ae \u03b2\u03bb\u03ac\u03b2\u03b7 \u03c3\u03c4\u03bf \u03b5\u03be\u03ac\u03c1\u03c4\u03b7\u03bc\u03b1",cause3:"\u0395\u03ba\u03c4\u03b5\u03bb\u03ad\u03c3\u03c4\u03b5 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae \u03c4\u03ac\u03c3\u03b7\u03c2/\u03b1\u03bd\u03c4\u03af\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03bc\u03b5 \u03c0\u03bf\u03bb\u03cd\u03bc\u03b5\u03c4\u03c1\u03bf \u03ae \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf \u03b5\u03be\u03ac\u03c1\u03c4\u03b7\u03bc\u03b1",recommendedAction:"\u03a3\u03c5\u03bd\u03b9\u03c3\u03c4\u03ce\u03bc\u03b5\u03bd\u03b7 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1",tsbTitle:"\u0394\u0395\u039b\u03a4\u0399\u039f \u03a4\u0395\u03a7\u039d\u0399\u039a\u0397\u03a3 \u03a5\u03a0\u0397\u03a1\u0395\u03a3\u0399\u0391\u03a3",aiDoctorBtn:"\u0395\u039c\u03a0\u0395\u0399\u03a1\u039f\u0393\u039d\u03a9\u039c\u039f\u039d\u0399\u039a\u0397 \u0391\u039d\u0391\u039b\u03a5\u03a3\u0397 AI DOCTOR",backToDetail:"\u0395\u03a0\u0399\u03a3\u03a4\u03a1\u039f\u03a6\u0397 \u03a3\u03a4\u0399\u03a3 \u039b\u0395\u03a0\u03a4\u039f\u039c\u0395\u03a1\u0395\u0399\u0395\u03a3 \u0392\u039b\u0391\u0392\u0397\u03a3"},dtcCategory:{powertrain:"\u039a\u0399\u039d\u0397\u03a4\u0397\u03a1\u0391\u03a3 / \u03a3\u03a5\u03a3\u03a4\u0397\u039c\u0391 \u039c\u0395\u03a4\u0391\u0394\u039f\u03a3\u0397\u03a3",chassis:"\u03a0\u039b\u0391\u0399\u03a3\u0399\u039f / \u03a3\u03a5\u03a3\u03a4\u0397\u039c\u0391 \u03a0\u0395\u0394\u0397\u03a3\u0397\u03a3",body:"\u0397\u039b\u0395\u039a\u03a4\u03a1\u039f\u039d\u0399\u039a\u0391 \u0391\u039c\u0391\u039e\u03a9\u039c\u0391\u03a4\u039f\u03a3",network:"\u0394\u0399\u039a\u03a4\u03a5\u039f / \u03a3\u03a5\u03a3\u03a4\u0397\u039c\u0391 CAN BUS"},guidedDiag:{p0102_cause1:"\u0391\u03ba\u03ac\u03b8\u03b1\u03c1\u03c4\u03bf\u03c2 \u03ae \u03b5\u03bb\u03b1\u03c4\u03c4\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 MAF",p0102_cause2:"\u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 / \u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae \u03ba\u03b5\u03bd\u03bf\u03cd",p0102_cause3:"\u0396\u03b7\u03bc\u03b9\u03ac \u03ba\u03b1\u03bb\u03c9\u03b4\u03af\u03c9\u03c3\u03b7\u03c2",p0102_action:"\u039a\u03b1\u03b8\u03b1\u03c1\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 MAF \u03bc\u03b5 \u03ba\u03b1\u03b8\u03b1\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03b5\u03c0\u03b1\u03c6\u03ce\u03bd \u03ae \u03b5\u03bb\u03ad\u03b3\u03be\u03c4\u03b5 \u03c4\u03bf \u03ba\u03bf\u03c5\u03c4\u03af \u03c6\u03af\u03bb\u03c4\u03c1\u03bf\u03c5 \u03b1\u03ad\u03c1\u03b1.",p0102_tsb:"TSB-2023-09: \u0395\u03bb\u03ad\u03b3\u03be\u03c4\u03b5 \u03c4\u03b7 \u03c1\u03bf\u03c0\u03ae \u03c3\u03c6\u03b9\u03b3\u03ba\u03c4\u03ae\u03c1\u03b1 \u03ba\u03bf\u03bb\u03bb\u03ac\u03c1\u03bf\u03c5 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03c0\u03c1\u03b9\u03bd \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03c4\u03bf\u03bd MAF.",p0171_cause1:"\u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae \u03c3\u03c9\u03bb\u03ae\u03bd\u03b1 \u03ba\u03b5\u03bd\u03bf\u03cd / \u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2",p0171_cause2:"\u0391\u03c3\u03b8\u03b5\u03bd\u03ae\u03c2 \u0391\u03bd\u03c4\u03bb\u03af\u03b1 \u039a\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 / \u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03a0\u03af\u03b5\u03c3\u03b7",p0171_cause3:"\u03a6\u03ac\u03bf\u03c5\u03bb \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 O2 1",p0171_action:"\u03a0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae \u03ba\u03b1\u03c0\u03bd\u03bf\u03cd \u03c3\u03c4\u03b7\u03bd \u03c0\u03bf\u03bb\u03bb\u03b1\u03c0\u03bb\u03ae \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bb\u03ad\u03b3\u03be\u03c4\u03b5 \u03c4\u03b7 \u03bc\u03b1\u03ba\u03c1\u03bf\u03c0\u03c1\u03cc\u03b8\u03b5\u03c3\u03bc\u03b7 \u03b5\u03c0\u03ad\u03bd\u03b4\u03c5\u03c3\u03b7 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5.",p0171_tsb:"TSB-2022-14: \u0395\u03bb\u03ad\u03b3\u03be\u03c4\u03b5 \u03c4\u03bf \u03b4\u03b9\u03ac\u03c6\u03c1\u03b1\u03b3\u03bc\u03b1 \u03c4\u03b7\u03c2 \u03b2\u03b1\u03bb\u03b2\u03af\u03b4\u03b1\u03c2 PCV \u03b3\u03b9\u03b1 \u03c3\u03ba\u03b9\u03c3\u03af\u03bc\u03b1\u03c4\u03b1.",p0420_cause1:"\u03a5\u03c0\u03bf\u03b2\u03ac\u03b8\u03bc\u03b9\u03c3\u03b7 \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7\u03c2 \u03ba\u03b1\u03c4\u03b1\u03bb\u03c5\u03c4\u03b9\u03ba\u03bf\u03cd \u03bc\u03b5\u03c4\u03b1\u03c4\u03c1\u03bf\u03c0\u03ad\u03b1",p0420_cause2:"\u0392\u03bb\u03ac\u03b2\u03b7 \u03c0\u03af\u03c3\u03c9 \u03ba\u03b1\u03b8\u03bf\u03b4\u03b9\u03ba\u03bf\u03cd \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 O2",p0420_cause3:"\u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae \u03ba\u03b1\u03c5\u03c3\u03b1\u03b5\u03c1\u03af\u03c9\u03bd \u03c0\u03c1\u03b9\u03bd \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u03bc\u03b5\u03c4\u03b1\u03c4\u03c1\u03bf\u03c0\u03ad\u03b1",p0420_action:"\u03a3\u03c5\u03b3\u03ba\u03c1\u03af\u03bd\u03b5\u03c4\u03b5 \u03c4\u03b9\u03c2 \u03ba\u03c5\u03bc\u03b1\u03c4\u03bf\u03bc\u03bf\u03c1\u03c6\u03ad\u03c2 \u03c4\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 O2 \u03b1\u03bd\u03ac\u03bd\u03c4\u03b7 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03ac\u03bd\u03c4\u03b7 \u03ae \u03b5\u03bb\u03ad\u03b3\u03be\u03c4\u03b5 \u03c4\u03b7 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03b1\u03c4\u03b1\u03bb\u03c5\u03c4\u03b9\u03ba\u03bf\u03cd \u03bc\u03b5\u03c4\u03b1\u03c4\u03c1\u03bf\u03c0\u03ad\u03b1.",p0300_cause1:"\u03a6\u03b8\u03b1\u03c1\u03bc\u03ad\u03bd\u03bf \u03bc\u03c0\u03bf\u03c5\u03b6\u03af / \u03a0\u03bf\u03bb\u03bb\u03b1\u03c0\u03bb\u03b1\u03c3\u03b9\u03b1\u03c3\u03c4\u03ae\u03c2",p0300_cause2:"\u0392\u03bf\u03c5\u03bb\u03c9\u03bc\u03ad\u03bd\u03bf \u03bc\u03c0\u03b5\u03ba \u03c8\u03b5\u03ba\u03b1\u03c3\u03bc\u03bf\u03cd \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5",p0300_cause3:"\u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03c3\u03c5\u03bc\u03c0\u03af\u03b5\u03c3\u03b7 \u03ba\u03c5\u03bb\u03af\u03bd\u03b4\u03c1\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",p0300_action:"\u0391\u03bb\u03bb\u03ac\u03be\u03c4\u03b5 \u03c4\u03bf \u03c0\u03b7\u03bd\u03af\u03bf \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b4\u03b9\u03c0\u03bb\u03b1\u03bd\u03cc \u03ba\u03cd\u03bb\u03b9\u03bd\u03b4\u03c1\u03bf \u03ba\u03b1\u03b9 \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ae\u03c3\u03c4\u03b5 \u03b5\u03ac\u03bd \u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ae\u03c3\u03b5\u03b9 \u03bb\u03b1\u03bd\u03b8\u03b1\u03c3\u03bc\u03ad\u03bd\u03b7 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7.",p17bf_cause1:"\u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae \u03c3\u03c5\u03c3\u03c3\u03c9\u03c1\u03b5\u03c5\u03c4\u03ae \u03c5\u03b4\u03c1\u03b1\u03c5\u03bb\u03b9\u03ba\u03ae\u03c2 \u03c0\u03af\u03b5\u03c3\u03b7\u03c2 Mechatronic",p17bf_cause2:"\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bc\u03b1\u03b3\u03bd\u03b7\u03c4\u03b9\u03ba\u03ae\u03c2 \u03b2\u03b1\u03bb\u03b2\u03af\u03b4\u03b1\u03c2",p17bf_cause3:"\u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03c3\u03c4\u03ac\u03b8\u03bc\u03b7 \u03c5\u03b3\u03c1\u03ce\u03bd / \u0391\u03c0\u03bf\u03b9\u03ba\u03bf\u03b4\u03cc\u03bc\u03b7\u03c3\u03b7 \u03c5\u03b3\u03c1\u03ce\u03bd",p17bf_action:"\u03a0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae \u03c0\u03af\u03b5\u03c3\u03b7\u03c2 DCT Mechatronic \u03ba\u03b1\u03b9 \u03b5\u03c0\u03b9\u03b8\u03b5\u03c9\u03c1\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf \u03c0\u03b5\u03c1\u03af\u03b2\u03bb\u03b7\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03c3\u03c3\u03c9\u03c1\u03b5\u03c5\u03c4\u03ae.",p17bf_tsb:"TSB-VAG-DSG: \u0391\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf \u03c0\u03b5\u03c1\u03af\u03b2\u03bb\u03b7\u03bc\u03b1 \u03bc\u03b7\u03c7\u03b1\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03c0\u03af\u03b5\u03c3\u03b7\u03c2 \u03ae \u03c4\u03b7\u03bd \u03b5\u03bd\u03b9\u03c3\u03c7\u03c5\u03bc\u03ad\u03bd\u03b7 \u03c0\u03bb\u03ac\u03ba\u03b1 \u03c3\u03c5\u03c3\u03c3\u03c9\u03c1\u03b5\u03c5\u03c4\u03ae.",default_cause1:"\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b5\u03be\u03b1\u03c1\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 / \u03b1\u03bd\u03c4\u03af\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03ba\u03b1\u03bb\u03c9\u03b4\u03af\u03c9\u03c3\u03b7\u03c2",default_cause2:"\u039c\u03b7\u03c7\u03b1\u03bd\u03b9\u03ba\u03ae \u03c6\u03b8\u03bf\u03c1\u03ac \u03ae \u03c5\u03c0\u03bf\u03b2\u03ac\u03b8\u03bc\u03b9\u03c3\u03b7 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1",default_action:"\u03a0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf \u03c0\u03c4\u03ce\u03c3\u03b7\u03c2 \u03c4\u03ac\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1\u03c2 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c0\u03bf\u03bb\u03cd\u03bc\u03b5\u03c4\u03c1\u03bf."},ev:{loading:"\u03a6\u03cc\u03c1\u03c4\u03c9\u03c3\u03b7 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7\u03c2 EV...",back:"\u03a0\u03af\u03c3\u03c9",title:"\u0394\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03cc\u03c2 \u03c0\u03af\u03bd\u03b1\u03ba\u03b1\u03c2 EV & \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2",sohTitle:"\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c5\u03b3\u03b5\u03af\u03b1\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2",socAndPack:"\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c7\u03c1\u03ad\u03c9\u03c3\u03b7\u03c2: {{soc}}% | \u03a4\u03ac\u03c3\u03b7 \u03c0\u03b1\u03ba\u03ad\u03c4\u03bf\u03c5: {{voltage}} V",insulationTitle:"\u039c\u03cc\u03bd\u03c9\u03c3\u03b7 & \u0398\u03b5\u03c1\u03bc\u03b9\u03ba\u03ae \u0391\u03c3\u03c6\u03ac\u03bb\u03b5\u03b9\u03b1",insulationResistance:"\u0391\u03bd\u03c4\u03af\u03c3\u03c4\u03b1\u03c3\u03b7 \u03bc\u03cc\u03bd\u03c9\u03c3\u03b7\u03c2",cellDeltaVoltage:"\u0394\u03ad\u03bb\u03c4\u03b1 \u03a4\u03ac\u03c3\u03b7\u03c2 \u039a\u03c5\u03c8\u03ad\u03bb\u03b7\u03c2",maxCellTemp:"\u039c\u03ad\u03b3\u03b9\u03c3\u03c4\u03b7 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03ba\u03c5\u03c8\u03ad\u03bb\u03b7\u03c2",minCellTemp:"\u0395\u03bb\u03ac\u03c7\u03b9\u03c3\u03c4\u03b7 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03ba\u03c5\u03c8\u03ad\u03bb\u03b7\u03c2",cellDistribution:"\u039a\u03b1\u03c4\u03b1\u03bd\u03bf\u03bc\u03ae \u03a4\u03ac\u03c3\u03b7\u03c2 \u039a\u03c5\u03c8\u03ad\u03bb\u03b7\u03c2",cellIndex:"\u039a\u03b5\u03bb\u03bb\u03af #{{id}}",deviationWarning:"\u03a5\u03c8\u03b7\u03bb\u03ae \u03b1\u03c0\u03cc\u03ba\u03bb\u03b9\u03c3\u03b7",passportTitle:"\u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03cc \u03b4\u03b9\u03b1\u03b2\u03b1\u03c4\u03ae\u03c1\u03b9\u03bf \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03b9\u03ce\u03bd \u0395\u0395",passportId:"\u03a4\u03b1\u03c5\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b4\u03b9\u03b1\u03b2\u03b1\u03c4\u03b7\u03c1\u03af\u03bf\u03c5: {{id}}",nominalCapacity:"\u039f\u03bd\u03bf\u03bc\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae \u03c7\u03c9\u03c1\u03b7\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1: {{val}} kWh",remainingCapacity:"\u03a5\u03c0\u03cc\u03bb\u03bf\u