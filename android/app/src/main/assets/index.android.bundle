events automatic engine shutoff after 30 minutes idle."},ev_battery_preheat_manual_switch:{name:"EV Battery Pre-Heating Manual Switch",desc:"Allows manual battery pre-heating to 25\xb0C before DC fast charging without navigation route."},ev_v2l_power_output_expand:{name:"V2L 220V Outlet Power Expansion",desc:"Expands V2L external 220V AC household power outlet limit from 2.2 kW to 3.6 kW."},ev_one_pedal_regen_force_level3:{name:"One-Pedal Drive Maximum Regenerative Braking Default",desc:"Sets maximum regenerative braking as default on vehicle start."},byd_soc_max_charge_target_limit:{name:"BYD Battery Health Protection Max Charge Limit",desc:"Sets max AC/DC charge cutoff limit to 80% or 90% to extend Blade Battery lifespan."},byd_dmi_forced_pure_ev_speed_override:{name:"BYD DM-i Pure EV Mode Gasoline Engine Override",desc:"Inhibits gasoline engine start in EV mode up to 130 km/h even during full throttle acceleration."},byd_vtol_v2v_rescue_charge_mode:{name:"BYD VTOL Rescue Charge Mode",desc:"Unlocks external AC power output to charge stranded electric vehicles on road."},hyundai_ipedal_memory_lock:{name:"Hyundai / Kia i-PEDAL One-Pedal Drive Memory Lock",desc:"Prevents i-PEDAL one-pedal stop mode from dropping back to Level 3 after shifting to Reverse."},hyundai_utility_mode_12v_saver:{name:"Utility Camping Mode High-Voltage 12V Saver",desc:"Powers 220V V2L outlet directly from HV traction battery to prevent auxiliary 12V battery drain."},hyundai_phev_no_ice_climate_start:{name:"PHEV EV Mode Climate Heating Gasoline Engine Suppression",desc:"Forces heat pump / PTC electric heater for cabin climate without starting gasoline engine."},vag_taycan_ess_sound_profile_swap:{name:"Electric Sport Sound Taycan / RS e-tron Profile",desc:"Changes electric driving sound profile to Porsche Taycan GTS or Audi RS e-tron GT sound generator."},vag_meb_daily_charge_target_menu:{name:"MEB Battery Daily 80% / Trip 100% Quick Charge Bar",desc:"Adds quick toggle bar on MIB screen to switch between 80% daily battery care and 100% trip charge."},vag_gte_generator_charge_reserve:{name:"GTE / E-Mode Engine Generator Battery Force Charge",desc:"Forces combustion engine to act as generator to recharge high-voltage battery up to 80% while driving."},bmw_hans_zimmer_iconic_sounds_m:{name:"Hans Zimmer IconicSounds Electric M-Performance Sound Engine",desc:"Unlocks Hans Zimmer acoustic M-Performance electric acceleration sound profiles on i4 and iX."},bmw_phev_max_edrive_140kmh:{name:"PHEV MAX eDrive Pure Electric Speed Ceiling",desc:"Increases max pure electric speed ceiling on 330e / 530e Plug-in hybrids to 140 km/h."},bmw_ac_charging_current_limit_menu:{name:"AC Home Charger Maximum Current Limit Selector",desc:"Adds AC home charging current limiter to prevent home circuit overload."},toyota_hybrid_ev_mode_override:{name:"Toyota / Lexus EV Mode Throttle Override Suppression",desc:"Prevents gasoline engine from forced start during acceleration when EV mode button is active."},toyota_hybrid_battery_fan_speed_boost:{name:"Toyota / Lexus High-Voltage Battery Cooling Fan Boost",desc:"Increases hybrid traction battery cooling fan speed by +30% to prevent thermal degradation in hot climates."},tesla_sentry_high_bitrate_video:{name:"Tesla Sentry Mode High-Bitrate Continuous Dashcam Recording",desc:"Increases Sentry Mode camera video recording bitrate for crystal-clear license plate visibility."},tesla_cabin_overheat_threshold_30c:{name:"Tesla Cabin Overheat Protection Temperature Threshold",desc:"Lowers cabin overheat protection climate trigger temperature from 40\xb0C to 30\xb0C for interior preservation."},bmwmotorrad_quickshifter_pro_readapt:{name:"Shift Assistant Pro Re-Adaptation",desc:"Resets shift sensor learning parameters and initiates quickshifter recalibration."},bmwmotorrad_esa_zero_point_calib:{name:"Dynamic ESA Suspension Zero-Point Calibration",desc:"Calibrates electronic suspension load and travel sensors to factory zero."},bmwmotorrad_abs_pro_cor