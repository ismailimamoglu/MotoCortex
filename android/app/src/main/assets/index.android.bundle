0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u0928\u0942\u0928\u0940 \u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0923 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902\u0964",success:"\u0938\u092b\u0932\u0924\u093e",error:"\u0924\u094d\u0930\u0941\u091f\u093f",tokenError:"\u091f\u094b\u0915\u0928 \u0924\u094d\u0930\u0941\u091f\u093f",tokenErrorMsg:"SGW \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932.",offlineActive:"\u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092c\u093e\u092f\u092a\u093e\u0938 \u0938\u0915\u094d\u0930\u093f\u092f",description:"Description"},evBms:{title:"\u0908\u0935\u0940 \u092c\u0940\u090f\u092e\u090f\u0938 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915\u094d\u0938",subtitle:"\u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0914\u0930 \u092c\u0948\u091f\u0930\u0940 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f (SOH / SOC) ({{brand}})",sohLabel:"\u092c\u0948\u091f\u0930\u0940 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f (SOH):",capacityRetained:"\u0915\u094d\u0937\u092e\u0924\u093e \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u0940 \u0917\u0908",socLabel:"\u091a\u093e\u0930\u094d\u091c \u0938\u094d\u0924\u0930 (SOC):",remainingCharge:"\u0936\u0947\u0937 \u092a\u094d\u0930\u092d\u093e\u0930",cellBalance:"\u0938\u0947\u0932 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092c\u0948\u0932\u0947\u0902\u0938 (16\u090f\u0938 \u092a\u0948\u0915)",optimalBalance:"\u0907\u0937\u094d\u091f\u0924\u092e \u0938\u0902\u0924\u0941\u0932\u0928 (<30mV \u0921\u0947\u0932\u094d\u091f\u093e)",mildImbalance:"\u0939\u0932\u094d\u0915\u0947 \u0905\u0938\u0902\u0924\u0941\u0932\u0928 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e",thermalStatus:"\u0925\u0930\u094d\u092e\u0932 \u0938\u094d\u0925\u093f\u0924\u093f \u0914\u0930 \u092a\u0948\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940",packTemp:"\u092a\u0948\u0915 \u0924\u093e\u092a\u092e\u093e\u0928:",packVoltage:"\u092a\u0948\u0915 \u0935\u094b\u0932\u094d\u091f\u0947\u091c:",chargeCycles:"\u091a\u093e\u0930\u094d\u091c \u091a\u0915\u094d\u0930:",cycles:"\u091a\u0915\u094d\u0930"},serviceReset:{title:"\u0938\u0930\u094d\u0935\u093f\u0938 \u0914\u0930 \u0930\u0916\u0930\u0916\u093e\u0935 \u0930\u0940\u0938\u0947\u091f",subtitle:"\u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0930\u0916\u0930\u0916\u093e\u0935 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u091a\u0941\u0928\u0947\u0902 ({{make}})",preCheckTitle:"\u092a\u0942\u0930\u094d\u0935-\u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u091a\u0947\u0915\u0932\u093f\u0938\u094d\u091f",preCheckIgnition:"\u0935\u093e\u0939\u0928 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0938\u094d\u0935\u093f\u091a \u091a\u093e\u0932\u0942 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",preCheckEngine:"\u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f (0 \u0906\u0930\u092a\u0940\u090f\u092e)\u0964",preCheckBattery:"\u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c 12.2V \u0938\u0947 \u090a\u092a\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",selectRoutine:"\u0938\u0930\u094d\u0935\u093f\u0938 \u0930\u0942\u091f\u0940\u0928 \u091a\u0941\u0928\u0947\u0902",intervalReset:"\u0938\u0947\u0935\u093e \u0930\u0916\u0930\u0916\u093e\u0935 \u0905\u0902\u0924\u0930\u093e\u0932 \u0930\u0940\u0938\u0947\u091f",intervalTitle:"\u0938\u0947\u0935\u093e \u0905\u0902\u0924\u0930\u093e\u0932 \u0938\u0902\u0915\u0947\u0924\u0915 \u0932\u093e\u0907\u091f \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0947\u0902",intervalSubtitle:"\u0921\u0948\u0936 \u0938\u0947\u0935\u093e \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0905\u0917\u0932\u093e \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u0905\u0902\u0924\u0930\u093e\u0932 \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964",tpsReset:"\u0925\u094d\u0930\u0949\u091f\u0932 \u092a\u094b\u091c\u0940\u0936\u0928 \u0938\u0947\u0902\u0938\u0930 (\u091f\u0940\u092a\u0940\u090f\u0938) \u0930\u0940\u0938\u0947\u091f",tpsTitle:"\u0925\u094d\u0930\u0949\u091f\u0932 \u092a\u094b\u091c\u0940\u0936\u0928 \u0938\u0947\u0902\u0938\u0930 (\u091f\u0940\u092a\u0940\u090f\u0938) \u0905\u0928\u0941\u0915\u0942\u0932\u0928",tpsSubtitle:"\u0936\u0942\u0928\u094d\u092f-\u0925\u094d\u0930\u0949\u091f\u0932 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u0938\u094d\u091f\u0949\u092a \u092a\u0949\u0907\u0902\u091f \u0915\u094b \u092a\u0941\u0928\u0903 \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964",absBleed:"\u090f\u092c\u0940\u090f\u0938 \u092c\u094d\u0932\u0940\u0921\u093f\u0902\u0917 \u090f\u0935\u0902 \u0935\u093e\u0932\u094d\u0935 \u092a\u0930\u0940\u0915\u094d\u0937\u0923",absTitle:"\u090f\u092c\u0940\u090f\u0938 \u0939\u093e\u0907\u0921\u094d\u0930\u094b\u0932\u093f\u0915 \u092a\u0902\u092a \u092c\u094d\u0932\u0940\u0921 \u091f\u0947\u0938\u094d\u091f",absSubtitle:"\u092c\u094d\u0930\u0947\u0915 \u0932\u093e\u0907\u0928\u094b\u0902 \u0938\u0947 \u0939\u0935\u093e \u0915\u0947 \u092c\u0941\u0932\u092c\u0941\u0932\u0947 \u0915\u094b \u0936\u0941\u0926\u094d\u0927 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0907\u0915\u093f\u0932 \u090f\u092c\u0940\u090f\u0938 \u0938\u094b\u0932\u0928\u0949\u0907\u0921 \u0935\u093e\u0932\u094d\u0935\u0964",ecuRejected:"\u0908\u0938\u0940\u092f\u0942 \u0928\u0947 \u0930\u0940\u0938\u0947\u091f \u0915\u092e\u093e\u0902\u0921 \u0915\u094b \u0916\u093e\u0930\u093f\u091c \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942 \u0939\u0948 \u0914\u0930 \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u0939\u0948\u0964"},aiDoctor:{analyzing:"\u090f\u0906\u0908 \u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0947 \u0938\u093e\u0925 \u0921\u0940\u091f\u0940\u0938\u0940 \u0915\u094b\u0921 \u0914\u0930 \u0907\u0902\u091c\u0928 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923...",healthImpact:"\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u094d\u0915\u094b\u0930 \u092a\u094d\u0930\u092d\u093e\u0935: {{score}}/100",drivingSafety:"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928",causes:"\u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u0915\u093e\u0930\u0923",recommendedAction:"\u0905\u0928\u0941\u0936\u0902\u0938\u093f\u0924 \u092f\u093e\u0902\u0924\u094d\u0930\u093f\u0915 \u0915\u094d\u0930\u093f\u092f\u093e",estimatedCost:"\u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924 \u0918\u091f\u0915/\u092e\u0930\u092e\u094d\u092e\u0924 \u0932\u093e\u0917\u0924",noFaultsTitle:"\u0938\u093f\u0938\u094d\u091f\u092e \u0907\u0937\u094d\u091f\u0924\u092e - \u0915\u094b\u0908 \u0926\u094b\u0937 \u0915\u094b\u0921 \u0928\u0939\u0940\u0902 \u092a\u093e\u092f\u093e \u0917\u092f\u093e",noFaultsSummary:"\u0908\u0938\u0940\u092f\u0942 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u094b\u0921 \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0902\u091c\u0928 \u092a\u0948\u0930\u093e\u092e\u0940\u091f\u0930 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092a\u0930\u093f\u091a\u093e\u0932\u0928 \u0938\u0940\u092e\u093e \u0915\u0947 \u092d\u0940\u0924\u0930 \u0939\u0948\u0902\u0964",stepMaintain:"\u0928\u093f\u092f\u092e\u093f\u0924 \u0924\u0947\u0932 \u0914\u0930 \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0938\u0947\u0935\u093e \u0905\u0902\u0924\u0930\u093e\u0932 \u092c\u0928\u093e\u090f \u0930\u0916\u0947\u0902\u0964",stepCheckVoltage:"\u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u092c\u0948\u091f\u0930\u0940 \u0930\u0947\u0938\u094d\u091f\u093f\u0902\u0917 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964",safeDrive:"\u0928\u093f\u092f\u092e\u093f\u0924 \u0938\u0902\u091a\u093e\u0932\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924.",misfireTitle:"\u0907\u0902\u091c\u0928 \u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u092e\u0947\u0902 \u0916\u0930\u093e\u092c\u0940 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e",misfireSummary:"\u090f\u0915 \u092f\u093e \u0905\u0927\u093f\u0915 \u0938\u093f\u0932\u0947\u0902\u0921\u0930\u094b\u0902 \u092e\u0947\u0902 \u0938\u0915\u094d\u0930\u093f\u092f \u092e\u093f\u0938\u092b\u093e\u092f\u0930 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e\u0964 \u092c\u093f\u0928\u093e \u091c\u0932\u093e \u0939\u0941\u0906 \u0908\u0902\u0927\u0928 \u0909\u0924\u094d\u092a\u094d\u0930\u0947\u0930\u0915 \u0915\u0928\u0935\u0930\u094d\u091f\u0930 \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0938\u0947 \u0938\u094d\u0925\u093e\u092f\u0940 \u0915\u094d\u0937\u0924\u093f \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",causeSparkPlug:"\u0918\u093f\u0938\u093e \u0939\u0941\u0906 \u092f\u093e \u0917\u0902\u0926\u093e \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u092a\u094d\u0932\u0917",causeIgnitionCoil:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0915\u0949\u0907\u0932 \u092f\u093e \u0924\u093e\u0930 \u0915\u093e \u0916\u093c\u0930\u093e\u092c \u0939\u094b\u0928\u093e",causeFuelInjector:"\u092c\u0902\u0926 \u092f\u093e \u0926\u094b\u0937\u092a\u0942\u0930\u094d\u0923 \u0908\u0902\u0927\u0928 \u0907\u0902\u091c\u0947\u0915\u094d\u091f\u0930",stepInspectPlugs:"\u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u092a\u094d\u0932\u0917 \u0915\u093e \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0917\u0948\u092a \u0915\u0930\u0947\u0902\u0964",stepSwapCoils:"\u0926\u094b\u0937 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u0923 \u0915\u0947 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0947 \u0932\u093f\u090f \u0938\u093f\u0932\u0947\u0902\u0921\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0915\u0949\u0907\u0932\u094d\u0938 \u0915\u094b \u0938\u094d\u0935\u0948\u092a \u0915\u0930\u0947\u0902\u0964",stepFuelPressure:"\u0908\u0902\u0927\u0928 \u0930\u0947\u0932 \u0926\u092c\u093e\u0935 \u0915\u094b \u092e\u093e\u092a\u0947\u0902\u0964",criticalDrive:"\u092d\u093e\u0930\u0940 \u0925\u094d\u0930\u0949\u091f\u0932 \u0915\u0947 \u0924\u0939\u0924 \u0932\u0902\u092c\u0940 \u0926\u0942\u0930\u0940 \u0924\u0915 \u0917\u093e\u0921\u093c\u0940 \u0928 \u091a\u0932\u093e\u090f\u0902\u0964 \u0938\u0947\u0935\u093e \u0915\u0947 \u0932\u093f\u090f \u0924\u0941\u0930\u0902\u0924 \u0921\u094d\u0930\u093e\u0907\u0935 \u0915\u0930\u0947\u0902\u0964",o2Title:"\u0911\u0915\u094d\u0938\u0940\u091c\u0928 (O2) \u0938\u0947\u0902\u0938\u0930 \u0938\u0930\u094d\u0915\u093f\u091f \u0915\u0940 \u0916\u0930\u093e\u092c\u0940",o2Summary:"\u0935\u093e\u092f\u0941-\u0908\u0902\u0927\u0928 \u092e\u093f\u0936\u094d\u0930\u0923 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0916\u093c\u0930\u093e\u092c \u0939\u094b \u0917\u0908 \u0939\u0948\u0964 \u0907\u0902\u091c\u0928 \u0924\u0947\u091c \u092f\u093e \u0927\u0940\u092e\u0940 \u0917\u0924\u093f \u0938\u0947 \u091a\u0932 \u0938\u0915\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0908\u0902\u0927\u0928 \u0926\u0915\u094d\u0937\u0924\u093e \u0915\u092e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",causeO2Heater:"O2 \u0938\u0947\u0902\u0938\u0930 \u0939\u0940\u091f\u093f\u0902\u0917 \u0924\u0924\u094d\u0935 \u0915\u0940 \u0935\u093f\u092b\u0932\u0924\u093e",causeExhaustLeak:"\u0938\u0947\u0902\u0938\u0930 \u0915\u0947 \u0905\u092a\u0938\u094d\u091f\u094d\u0930\u0940\u092e \u092e\u0947\u0902 \u090f\u0917\u094d\u091c\u0949\u0938\u094d\u091f \u092e\u0948\u0928\u093f\u092b\u094b\u0932\u094d\u0921 \u0932\u0940\u0915",causeHarness:"\u0915\u094d\u0937\u0924\u093f\u0917\u094d\u0930\u0938\u094d\u0924 \u0935\u093e\u092f\u0930\u093f\u0902\u0917 \u0939\u093e\u0930\u094d\u0928\u0947\u0938 \u0915\u0928\u0947\u0915\u094d\u091f\u0930",stepCheckWiring:"\u092a\u093f\u0918\u0932\u0928\u0947 \u092f\u093e \u0918\u093f\u0938\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f O2 \u0938\u0947\u0902\u0938\u0930 \u0935\u093e\u092f\u0930\u093f\u0902\u0917 \u0939\u093e\u0930\u094d\u0928\u0947\u0938 \u0915\u093e \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902\u0964",stepCleanSensor:"\u092f\u0926\u093f \u092a\u094d\u0930\u0924\u093f\u0930\u094b\u0927 \u092e\u093e\u0928\u0915 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0939\u0948 \u0924\u094b O2 \u0938\u0947\u0902\u0938\u0930 \u091f\u093f\u092a \u0915\u094b \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902 \u092f\u093e \u0938\u0947\u0902\u0938\u0930 \u092c\u0926\u0932\u0947\u0902\u0964",warningDrive:"\u092e\u0930\u092e\u094d\u092e\u0924 \u0915\u0940 \u0926\u0941\u0915\u093e\u0928 \u0924\u0915 \u092e\u0927\u094d\u092f\u092e \u0917\u0924\u093f \u0938\u0947 \u0917\u093e\u0921\u093c\u0940 \u091a\u0932\u093e\u0928\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964",genericTitle:"\u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0915\u094b\u0921 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 ({{codes}})",genericSummary:"\u0938\u0915\u094d\u0930\u093f\u092f \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u094b\u0921 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e: {{codes}}\u0964 \u0938\u093f\u0938\u094d\u091f\u092e \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0940 \u0905\u0928\u0941\u0936\u0902\u0938\u093e \u0915\u0940 \u0917\u0908.",causeGeneric1:"\u0938\u0947\u0902\u0938\u0930 \u0938\u0930\u094d\u0915\u093f\u091f \u0905\u092a\u0947\u0915\u094d\u0937\u093f\u0924 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u0938\u0940\u092e\u093e \u0938\u0947 \u092c\u093e\u0939\u0930 \u0939\u0948",causeGeneric2:"\u0922\u0940\u0932\u093e \u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092f\u093e \u091c\u093c\u092e\u0940\u0928\u0940 \u0916\u0930\u093e\u092c\u0940",stepGeneric1:"\u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092b\u093c\u094d\u0930\u0940\u091c\u093c \u092b\u093c\u094d\u0930\u0947\u092e \u0921\u0947\u091f\u093e \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0947\u0902\u0964",stepGeneric2:"\u0939\u093e\u0930\u094d\u0928\u0947\u0938 \u0915\u0928\u0947\u0915\u094d\u091f\u0930\u094d\u0938 \u0915\u093e \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0921\u0940\u091f\u0940\u0938\u0940 \u0915\u094b\u0921 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902\u0964",reportTitle:"\u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0915\u094b\u0921 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923",healthImpactTitle:"\u0907\u0902\u091c\u0928 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u094d\u0915\u094b\u0930 \u092a\u094d\u0930\u092d\u093e\u0935",freeTrialBadge:" \u0906\u092a \u0905\u092a\u0928\u0947 1 \u092e\u0941\u092b\u093c\u094d\u0924 \u090f\u0906\u0908 \u0928\u093f\u0926\u093e\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902",modalTitle:"Modal Title",modalSubtitle:"Modal Subtitle"},dtcRisk:{safeTitle:" \u0921\u094d\u0930\u093e\u0907\u0935 \u0915\u0947 \u0932\u093f\u090f \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924",safeDesc:"\u092f\u0939 \u0916\u0930\u093e\u092c\u0940 \u0938\u0940\u0927\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b \u0916\u0924\u0930\u0947 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0921\u093e\u0932\u0924\u0940 \u0939\u0948\u0964 \u0906\u092a \u0938\u0930\u094d\u0935\u093f\u0938 \u0924\u0915 \u0927\u0940\u092e\u0940 \u0917\u0924\u093f \u0938\u0947 \u0917\u093e\u0921\u093c\u0940 \u091a\u0932\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",warningTitle:" \u091a\u0947\u0924\u093e\u0935\u0928\u0940: \u0938\u0930\u094d\u0935\u093f\u0938 \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948",warningDesc:"\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092e\u0947\u0902 \u0915\u092e\u0940 \u0914\u0930 \u0905\u0927\u093f\u0915 \u0909\u0924\u094d\u0938\u0930\u094d\u091c\u0928 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u091c\u0932\u094d\u0926 \u0939\u0940 \u0915\u093f\u0938\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u0947\u0935\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092a\u0930 \u091c\u093e\u090f\u0902\u0964",criticalTitle:" \u0917\u0902\u092d\u0940\u0930: \u0924\u0941\u0930\u0902\u0924 \u0917\u093e\u0921\u093c\u0940 \u0930\u094b\u0915\u0947\u0902 / \u0938\u0947\u0935\u093e \u0932\u0947\u0902",criticalDesc:"\u0917\u0902\u092d\u0940\u0930 \u092f\u093e\u0902\u0924\u094d\u0930\u093f\u0915 \u092f\u093e \u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u091c\u094b\u0916\u093f\u092e! \u0907\u0902\u091c\u0928 \u092f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0923\u093e\u0932\u093f\u092f\u094b\u0902 \u0915\u094b \u0928\u0941\u0915\u0938\u093e\u0928 \u092a\u0939\u0941\u0902\u091a \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u0930\u0902\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0941\u0915\u0947\u0902\u0964"},dtcDetail:{descTitle:"\u0928\u0948\u0926\u093e\u0928\u093f\u0915 \u0916\u0930\u093e\u092c\u0940 \u0915\u094b\u0921 \u0935\u093f\u0935\u0930\u0923",possibleCausesTitle:"\u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u092e\u0942\u0932 \u0915\u093e\u0930\u0923 \u0914\u0930 \u092e\u0930\u092e\u094d\u092e\u0924 \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936",cause1:"\u0938\u0947\u0902\u0938\u0930 \u0938\u0930\u094d\u0915\u093f\u091f \u092f\u093e \u0935\u093e\u092f\u0930\u093f\u0902\u0917 \u0939\u093e\u0930\u094d\u0928\u0947\u0938 \u092e\u0947\u0902 \u0922\u0940\u0932\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092f\u093e \u091c\u0902\u0917",cause2:"\u0918\u091f\u0915 \u092e\u0947\u0902 \u092f\u093e\u0902\u0924\u094d\u0930\u093f\u0915 \u0918\u093f\u0938\u093e\u0935 \u092f\u093e \u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u0926\u094b\u0937",cause3:"\u092e\u0932\u094d\u091f\u0940\u092e\u0940\u091f\u0930 \u0938\u0947 \u0935\u094b\u0932\u094d\u091f\u0947\u091c/\u092a\u094d\u0930\u0924\u093f\u0930\u094b\u0927 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902 \u092f\u093e \u0918\u091f\u0915 \u092c\u0926\u0932\u0947\u0902",recommendedAction:"\u0905\u0928\u0941\u0936\u0902\u0938\u093f\u0924 \u0915\u0926\u092e",tsbTitle:"\u0924\u0915\u0928\u0940\u0915\u0940 \u0938\u0947\u0935\u093e \u092c\u0941\u0932\u0947\u091f\u093f\u0928 (\u091f\u0940\u090f\u0938\u092c\u0940)",aiDoctorBtn:"AI DOCTOR \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923",backToDetail:"\u0916\u0930\u093e\u092c\u0940 \u0935\u093f\u0935\u0930\u0923 \u092a\u0930 \u0935\u093e\u092a\u0938 \u091c\u093e\u090f\u0902"},dtcCategory:{powertrain:"\u0907\u0902\u091c\u0928 / \u092a\u093e\u0935\u0930\u091f\u094d\u0930\u0947\u0928",chassis:"\u091a\u0947\u0938\u093f\u0938 / \u092c\u094d\u0930\u0947\u0915 \u0938\u093f\u0938\u094d\u091f\u092e",body:"\u092c\u0949\u0921\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u094d\u0938",network:"\u0928\u0947\u091f\u0935\u0930\u094d\u0915 / CAN \u092c\u0938 \u0938\u093f\u0938\u094d\u091f\u092e"},guidedDiag:{p0102_cause1:"\u0917\u0902\u0926\u093e \u092f\u093e \u0916\u0930\u093e\u092c MAF \u0938\u0947\u0902\u0938\u0930",p0102_cause2:"\u0907\u0902\u091f\u0947\u0915 \u0932\u0940\u0915 / \u0935\u0948\u0915\u094d\u092f\u0942\u092e \u0932\u0940\u0915",p0102_cause3:"\u0935\u093e\u092f\u0930\u093f\u0902\u0917 \u0939\u093e\u0930\u094d\u0928\u0947\u0938 \u0915\u094d\u0937\u0924\u093f",p0102_action:"\u0915\u0902\u091f\u0948\u0915\u094d\u091f \u0915\u094d\u0932\u0940\u0928\u0930 \u0938\u0947 MAF \u0938\u0947\u0902\u0938\u0930 \u0938\u093e\u092b \u0915\u0930\u0947\u0902 \u092f\u093e \u090f\u092f\u0930 \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0939\u093e\u0909\u0938\u093f\u0902\u0917 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964",p0102_tsb:"TSB-2023-09: MAF \u092c\u0926\u0932\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u090f\u092f\u0930 \u0907\u0902\u091f\u0947\u0915 \u0939\u094b\u0938 \u0915\u094d\u0932\u0948\u0902\u092a \u091f\u0949\u0930\u094d\u0915 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964",p0171_cause1:"\u0935\u0948\u0915\u094d\u092f\u0942\u092e \u0928\u0932\u0940 \u0930\u093f\u0938\u093e\u0935/\u0907\u0928\u091f\u0947\u0915 \u0930\u093f\u0938\u093e\u0935",p0171_cause2:"\u0915\u092e\u091c\u094b\u0930 \u0908\u0902\u0927\u0928 \u092a\u0902\u092a / \u0915\u092e \u0926\u092c\u093e\u0935",p0171_cause3:"\u0916\u093c\u0930\u093e\u092c O2 \u0938\u0947\u0902\u0938\u0930 1",p0171_action:"\u0907\u0928\u091f\u0947\u0915 \u092e\u0948\u0928\u093f\u092b\u094b\u0932\u094d\u0921 \u092a\u0930 \u0927\u0941\u0906\u0902 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0908\u0902\u0927\u0928 \u091f\u094d\u0930\u093f\u092e (\u090f\u0932\u091f\u0940\u090f\u092b\u091f\u0940) \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964",p0171_tsb:"\u091f\u0940\u090f\u0938\u092c\u0940-2022-14: \u0926\u0930\u093e\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0940\u0938\u0940\u0935\u0940 \u0935\u093e\u0932\u094d\u0935 \u0921\u093e\u092f\u093e\u092b\u094d\u0930\u093e\u092e \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902\u0964",p0420_cause1:"\u0909\u0924\u094d\u092a\u094d\u0930\u0947\u0930\u0915 \u0915\u0928\u0935\u0930\u094d\u091f\u0930 \u0926\u0915\u094d\u0937\u0924\u093e \u092e\u0947\u0902 \u0917\u093f\u0930\u093e\u0935\u091f",p0420_cause2:"\u0930\u093f\u092f\u0930 \u0921\u093e\u0909\u0928\u0938\u094d\u091f\u094d\u0930\u0940\u092e O2 \u0938\u0947\u0902\u0938\u0930 \u092e\u0947\u0902 \u0916\u0930\u093e\u092c\u0940",p0420_cause3:"\u0915\u0928\u0935\u0930\u094d\u091f\u0930 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0928\u093f\u0915\u093e\u0938 \u0930\u093f\u0938\u093e\u0935",p0420_action:"\u0905\u092a\u0938\u094d\u091f\u094d\u0930\u0940\u092e \u092c\u0928\u093e\u092e \u0921\u093e\u0909\u0928\u0938\u094d\u091f\u094d\u0930\u0940\u092e O2 \u0938\u0947\u0902\u0938\u0930 \u0924\u0930\u0902\u0917\u094b\u0902 \u0915\u0940 \u0924\u0941\u0932\u0928\u093e \u0915\u0930\u0947\u0902 \u092f\u093e \u0909\u0924\u094d\u092a\u094d\u0930\u0947\u0930\u0915 \u0915\u0928\u0935\u0930\u094d\u091f\u0930 \u0924\u093e\u092a\u092e\u093e\u0928 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964",p0300_cause1:"\u0918\u093f\u0938\u093e \u0939\u0941\u0906 \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u092a\u094d\u0932\u0917/\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0915\u0949\u0907\u0932",p0300_cause2:"\u092d\u0930\u093e \u0939\u0941\u0906 \u0908\u0902\u0927\u0928 \u0907\u0902\u091c\u0947\u0915\u094d\u091f\u0930",p0300_cause3:"\u0915\u092e \u0907\u0902\u091c\u0928 \u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u093