454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u0434\u043b\u044f \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430 ELM327/OBD2 \u0456 \u043f\u043e\u0442\u043e\u043a\u043e\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445 CAN-bus/K-Line.",locLabel:"\u0414\u043e\u0437\u0432\u0456\u043b \u043d\u0430 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f",locSub:"\u0410\u0440\u0445\u0456\u0442\u0435\u043a\u0442\u0443\u0440\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 Android \u0454 \u043e\u0431\u043e\u0432\u2019\u044f\u0437\u043a\u043e\u0432\u043e\u044e \u0434\u043b\u044f \u043f\u043e\u0448\u0443\u043a\u0443 \u043f\u043e\u0431\u043b\u0438\u0437\u0443 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457\u0432 Bluetooth \u0456\u0437 \u043d\u0438\u0437\u044c\u043a\u0438\u043c \u0435\u043d\u0435\u0440\u0433\u043e\u0441\u043f\u043e\u0436\u0438\u0432\u0430\u043d\u043d\u044f\u043c. \u041c\u0438 \u043d\u0435 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0454\u043c\u043e \u0432\u0430\u0448\u0435 \u0432\u043e\u0434\u0456\u043d\u043d\u044f.",grantBtn:"\u0414\u041e\u0417\u0412\u041e\u041b\u0418\u0422\u0418 \u0406 \u041f\u0420\u041e\u0414\u041e\u0412\u0416\u0418\u0422\u0418",skipBtn:"\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u043d\u0430\u0440\u0430\u0437\u0456 (\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0456\u0439\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c)",deniedDesc:"\u0414\u0435\u044f\u043a\u0438\u043c \u0434\u043e\u0437\u0432\u043e\u043b\u0430\u043c \u0431\u0443\u043b\u043e \u0432\u0456\u0434\u043c\u043e\u0432\u043b\u0435\u043d\u043e. Cortex OBD2 Diagnostic Scanner \u043c\u043e\u0436\u0435 \u043d\u0435 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u0430\u0431\u043e \u0443\u0441\u043f\u04