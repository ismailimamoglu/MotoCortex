3surare",desc:"Afi\u0219eaz\u0103 unghiul de virare, temperatura uleiului, temperatura lichidului de r\u0103cire \u0219i indicatori de altitudine pe ecranul MIB."},vag_easy_entry_driver_seat:{name:"Scaun electric cu intrare u\u0219oar\u0103 automat\u0103",desc:"Mut\u0103 electric scaunul \u0219oferului cu 5 cm la deschiderea u\u0219ii pentru a intra u\u0219or \xeen vehicul."},vag_hba_memory_state:{name:"Re\u021binerea memoriei de asisten\u021b\u0103 pentru faza lung\u0103 (HBA).",desc:"\xce\u0219i aminte\u0219te starea de asisten\u021b\u0103 pentru faza lung\u0103 ON pe parcursul ciclurilor de repornire a contactului."},vag_battery_soc_display:{name:"Afi\u0219aj starea de \xeenc\u0103rcare a bateriei (% SOC).",desc:"Afi\u0219eaz\u0103 procentul exact de \xeenc\u0103rcare a bateriei (% SOC) pe grupul de instrumente atunci c\xe2nd butonul de deplasare este ap\u0103sat."},bmw_idrive7_m_animation:{name:"Anima\u021bie de pornire iDrive 7/8 M-Performance",desc:"Schimb\u0103 grafica de pornire a ecranului iDrive \xeen anima\u021bia logo-ului M-Performance sau M-GmbH."},bmw_bowers_wilkins_audio_profiles:{name:"Deblocarea motorului de sunet 3D Bowers & Wilkins",desc:"Deblocheaz\u0103 profilurile audio Bowers & Wilkins Concert, Studio \u0219i Stage DSP pe sistemele HiFi."},bmw_hitch_zoom_camera:{name:"Camer\u0103 invers\u0103, remorc\u0103, modul zoom",desc:"Deblocheaz\u0103 modul de zoom de aliniere a c\xe2rligului de remorc\u0103 de sus \xeen jos pe vizualizarea invers\u0103 a camerei."},bmw_secure_idle_protection:{name:"Protec\u021bie securizat\u0103 de blocare a vitezelor la motor la ralanti",desc:"Bloceaz\u0103 transmisia \xeen Parcare dac\u0103 \u0219oferul p\u0103r\u0103se\u0219te vehiculul \xeen func\u021biune cu telecomanda."},bmw_seatbelt_handover_mute:{name:"Dezactivarea bra\u021bului de predare a centurii de siguran\u021b\u0103 electrice Coupe",desc:"Dezactiveaz\u0103 bra\u021bul motorizat de prelungire a centurii de siguran\u021b\u0103 pe Seria 4 \u0219i Seria 2 Coupe."},bmw_auto_heat_threshold_5c:{name:"Temperatura automat\u0103 de \xeenc\u0103lzire a scaunului \u0219i a volanului (+5\xb0C)",desc:"Declan\u0219eaz\u0103 \xeenc\u0103lzirea automat\u0103 a scaunelor \u0219i a volanului atunci c\xe2nd temperatura ambiental\u0103 scade sub 5\xb0C."},mercedes_amg_track_pace_unlock:{name:"MBUX AMG Track Pace Telemetrie \u0219i Lap Timer",desc:"Deblocheaz\u0103 cronometrarea turului, telemetria accelera\u021biei \u0219i graficele G-force pe ecranul MBUX."},mercedes_drive_mode_last_memory:{name:"Dynamic Select Last Drive Mode Memory",desc:"\xce\u0219i aminte\u0219te ultimul mod de conducere selectat (Individual / Sport) la repornirea vehiculului."},mercedes_proximity_360_camera_auto:{name:"Senzor de proximitate Vizualizare automat\u0103 a camerei la 360\xb0",desc:"Comut\u0103 automat ecranul la camera 360 atunci c\xe2nd senzorii frontali detecteaz\u0103 un obstacol < 50 cm."},ford_sync_climate_screen_unlock:{name:"Pagina de control al climatiz\u0103rii cu ecran tactil SYNC3 / SYNC4",desc:"Activeaz\u0103 controlul climatiz\u0103rii, scaunul \xeenc\u0103lzit \u0219i pagina cu ecran tactil pentru direc\u021bia fluxului de aer."},ford_turn_signal_5_flashes:{name:"Semnal de schimbare a benzii cu o singur\u0103 atingere (5 clipiri)",desc:"M\u0103re\u0219te durata semnalului de direc\u021bie pentru schimbarea benzii cu o singur\u0103 atingere de la 3 la 5 clipiri."},ford_auto_engine_shutdown_disable:{name:"Oprire automat\u0103 a motorului la ralanti de 30 de minute",desc:"\xcempiedic\u0103 oprirea automat\u0103 a motorului dup\u0103 30 de minute de mers \xeen gol (pentru utilizarea \xeen camping/priz\u0103)."},ev_battery_preheat_manual_switch:{name:"Comutator manual pentru pre\xeenc\u0103lzirea bateriei EV (preg\u0103tire pentru \xeenc\u0103rcare rapid\u0103 \xeen curent continuu)",desc:"Permite pre\xeenc\u0103lzirea manual\u0103 a bateriei la 25\xb0C \xeenainte de \xeenc\u0103rcarea rapid\u0103 DC f\u0103r\u0103 rut\u0103 de navigare."},ev_v2l_power_output_expand:{name:"V2L (vehicul la \xeenc\u0103rcare) 220V extindere a puterii prizei (3,6 kW)",desc:"Extinde limita de priz\u0103 extern\u0103 V2L de 220 V AC de la 2,2 kW la 3,6 kW."},ev_one_pedal_regen_force_level3:{name:"Fr\xe2nare regenerativ\u0103 maxim\u0103 cu o singur\u0103 pedal\u0103 implicit\u0103",desc:"Seteaz\u0103 fr\xe2narea regenerativ\u0103 maxim\u0103 (modul de oprire cu o singur\u0103 pedal\u0103) ca implicit\u0103 la pornirea vehiculului."},byd_soc_max_charge_target_limit:{name:"Limita maxim\u0103 de \xeenc\u0103rcare pentru protec\u021bia s\u0103n\u0103t\u0103\u021bii bateriei BYD (80% / 90%)",desc:"Seteaz\u0103 limita maxim\u0103 de \xeentrerupere a \xeenc\u0103rc\u0103rii AC/DC la 80% sau 90% pentru a prelungi durata de via\u021b\u0103 a bateriei Blade."},byd_dmi_forced_pure_ev_speed_override:{name:"Anularea motorului pe benzin\u0103 BYD DM-i Pure EV",desc:"Inhib\u0103 pornirea motorului pe benzin\u0103 \xeen modul EV p\xe2n\u0103 la 130 km/h chiar \u0219i \xeen timpul accelera\u021biei maxime."},byd_vtol_v2v_rescue_charge_mode:{name:"Modul de \xeenc\u0103rcare de salvare BYD VTOL (vehicul la vehicul).",desc:"Deblocheaz\u0103 ie\u0219irea extern\u0103 de curent alternativ pentru a \xeenc\u0103rca vehiculele electrice blocate pe drum."},hyundai_ipedal_memory_lock:{name:"Blocare memorie Hyundai / Kia i-PEDAL cu o singur\u0103 pedal\u0103",desc:"\xcempiedic\u0103 modul de oprire cu o singur\u0103 pedal\u0103 i-PEDAL s\u0103 scad\u0103 \xeenapoi la nivelul 3 dup\u0103 trecerea la invers."},hyundai_utility_mode_12v_saver:{name:"Mod de camping utilitar Economizor de 12 V de \xeenalt\u0103 tensiune",desc:"Alimenteaz\u0103 o priz\u0103 V2L de 220 V direct de la bateria de trac\u021biune HV pentru a preveni desc\u0103rcarea bateriei auxiliare de 12 V."},hyundai_phev_no_ice_climate_start:{name:"Modul PHEV EV Climatizare \xcenc\u0103lzire Suprimare motor pe benzin\u0103",desc:"For\u021beaz\u0103 pompa de c\u0103ldur\u0103 / \xeenc\u0103lzire electric\u0103 PTC pentru clima cabin\u0103 f\u0103r\u0103 pornirea motorului pe benzin\u0103."},vag_taycan_ess_sound_profile_swap:{name:"Electric Sport Sound (ESS) Taycan / RS e-tron Profile",desc:"Schimb\u0103 profilul de sunet al condusului electric la generatorul de sunet Porsche Taycan GTS sau Audi RS e-tron GT."},vag_meb_daily_charge_target_menu:{name:"Baterie MEB Zilnic 80% / Trip 100% Bar\u0103 de \xeenc\u0103rcare rapid\u0103",desc:"Adaug\u0103 bar\u0103 de comutare rapid\u0103 pe ecranul MIB pentru a comuta \xeentre 80% \xeengrijire zilnic\u0103 a bateriei \u0219i 100% \xeenc\u0103rcare de c\u0103l\u0103torie."},vag_gte_generator_charge_reserve:{name:"\xcenc\u0103rcare for\u021b\u0103 a bateriei generatorului de motor GTE / E-Mode (80%)",desc:"For\u021beaz\u0103 motorul cu ardere s\u0103 ac\u021bioneze ca generator pentru a re\xeenc\u0103rca bateria de \xeenalt\u0103 tensiune p\xe2n\u0103 la 80% \xeen timpul conducerii."},bmw_hans_zimmer_iconic_sounds_m:{name:"Motor de sunet electric M-Performance IconicSounds Hans Zimmer",desc:"Deblocheaz\u0103 profilele sonore de accelera\u021bie electric\u0103 M-Performance acustic\u0103 Hans Zimmer pe i4 \u0219i iX."},bmw_phev_max_edrive_140kmh:{name:"Plafon de vitez\u0103 pur electric PHEV MAX eDrive (140 km/h)",desc:"M\u0103re\u0219te plafonul maxim de vitez\u0103 pur electric\u0103 la 330e / 530e hibride plug-in la 140 km/h."},bmw_ac_charging_current_limit_menu:{name:"Selector de limit\u0103 de curent maxim al \xeenc\u0103rc\u0103torului de acas\u0103 AC (6A - 32A)",desc:"Adaug\u0103 un limitator de curent de \xeenc\u0103rcare AC acas\u0103 (6A / 10A / 16A / 32A) pentru a preveni supra\xeenc\u0103rcarea circuitului de acas\u0103."},toyota_hybrid_ev_mode_override:{name:"Suprimarea anul\u0103rii accelera\u021biei \xeen mod Toyota / Lexus EV",desc:"\xcempiedic\u0103 pornirea for\u021bat\u0103 a motorului pe benzin\u0103 \xeen timpul acceler\u0103rii c\xe2nd butonul pentru modul EV este activ."},toyota_hybrid_battery_fan_speed_boost:{name:"Ventilator de r\u0103cire a bateriei de \xeenalt\u0103 tensiune Toyota / Lexus (+30%)",desc:"M\u0103re\u0219te viteza ventilatorului de r\u0103cire a bateriei de trac\u021biune hibrid\u0103 cu +30% pentru a preveni degradarea termic\u0103 \xeen climatele calde."},tesla_sentry_high_bitrate_video:{name:"\xcenregistrare continu\u0103 \xeen modul Tesla Sentry cu debit ridicat de bi\u021bi",desc:"M\u0103re\u0219te rata de bi\u021bi de \xeenregistrare video a camerei \xeen modul Sentry pentru o vizibilitate clar\u0103 a pl\u0103cu\u021bei de \xeenmatriculare."},tesla_cabin_overheat_threshold_30c:{name:"Pragul de temperatur\u0103 de protec\u021bie \xeempotriva supra\xeenc\u0103lzirii cabinei Tesla (30\xb0C)",desc:"Reduce temperatura de declan\u0219are a climatului de protec\u021bie \xeempotriva supra\xeenc\u0103lzirii cabinei de la 40\xb0C la 30\xb0C pentru conservarea interioar\u0103."},bmwmotorrad_quickshifter_pro_readapt:{name:"Readaptare Shift Assistant Pro",desc:"Reseteaz\u0103 parametrii de \xeenv\u0103\u021bare a senzorului de schimbare \u0219i ini\u021biaz\u0103 recalibrarea ma\u0219inii de schimbare rapid\u0103."},bmwmotorrad_esa_zero_point_calib:{name:"Calibrare la punctul zero al suspensiei ESA dinamice",desc:"Calibreaz\u0103 senzorii electronici de sarcin\u0103 \u0219i de deplasare a suspensiei la zero din fabric\u0103."},bmwmotorrad_abs_pro_cornering_toggle:{name:"Pragul de interven\u021bie al modului de viraj ABS Pro",desc:"Regleaz\u0103 sensibilitatea de interven\u021bie ABS \xeen func\u021bie de unghiul de \xeenclinare pentru utilizarea pe pist\u0103."},bmwmotorrad_service_interval_reset:{name:"Resetare memento anual \u0219i la distan\u021b\u0103",desc:"Reseteaz\u0103 indicatorul de service al grupului de instrumente \u0219i seteaz\u0103 intervalul personalizat."},bmwmotorrad_headlight_pro_cornering:{name:"Faruri Pro Adaptive Viraj Sensibilitate la lumina",desc:"Regleaz\u0103 pragul unghiului de \xeenclinare pentru activarea adaptiv\u0103 a farurilor \xeen viraje."},bmwmotorrad_keyless_ride_range_extend:{name:"Extensie de raz\u0103 de detectare a telecomenzii f\u0103r\u0103 cheie",desc:"Optimizeaz\u0103 intervalul de semnal al transponderului pentru detectarea aprinderii f\u0103r\u0103 cheie."},bmwmotorrad_reverse_assist_sensitivity:{name:"Sensibilitatea motorului electric de asisten\u021b\u0103 invers\u0103",desc:"Regleaz\u0103 fin tura\u021bia \u0219i limita de cuplu a motorului demarorului electric de ac\u021bionare invers\u0103."},ducati_riding_mode_custom_profile:{name:"Creator de profil personalizat pentru modul de c\u0103l\u0103torie",desc:"Deblocheaz\u0103 combina\u021bii personalizate pentru profilurile Race, Sport, Touring \u0219i Urban."},ducati_ohlins_suspension_mapping:{name:"Maparea suspensiei \xd6hlins Smart EC 2.0 semi-activ\u0103",desc:"Regleaz\u0103 fin curba de amortizare \u0219i preset\u0103ri de rigiditate pentru suspensia electronic\u0103."},ducati_dashboard_lap_timer_gps:{name:"Tabloul de bord TFT Lap Timer & GPS Sector Splits",desc:"Deblocheaz\u0103 cronometrul turei pe pist\u0103 \u0219i afi\u0219ajul divizat pe sector pe grupul de instrumente."},ducati_engine_brake_control_ebc:{name:"Reglarea nivelului de control al fr\xe2nei motorului (EBC).",desc:"Regleaz\u0103 cuplul de decelerare al ro\u021bii din spate \xeen timpul fr\xe2n\u0103rii la intrarea \xeen viraje grele."},ducati_cruise_control_retrofit_enable:{name:"Activare retrofit control croazier\u0103",desc:"Activeaz\u0103 marcajul software ECU pentru comutatoarele electronice pentru controlul vitezei de croazier\u0103 montate ulterior."},ducati_exhaust_valve_sound_map:{name:"Harta RPM de deschidere a servovalvei de evacuare",desc:"Regleaz\u0103 pragul de deschidere a supapei de evacuare acustic\u0103 pentru o not\u0103 de evacuare \xeembun\u0103t\u0103\u021bit\u0103."},ducati_pit_lane_limiter_config:{name:"Pragul limitatorului de vitez\u0103 al benzilor",desc:"Permite comutarea limitatorului de vitez\u0103 a benzii de boxe la 60 km/h pe comutatoarele ghidonului."},ducati_desmo_service_light_reset:{name:"Resetarea luminii de service pentru supapa de ulei \u0219i desmo",desc:"\u0218terge avertismentul de memento de service al supapei desmodromice de pe grupul de instrumente."},ktm_quickshifter_plus_delay_tuning:{name:"Quickshifter+ Shift Cut Time & Delay Fine-Tuning",desc:"Personalizeaz\u0103 durata de t\u0103iere a aprinderii per treapt\u0103 de vitez\u0103 pentru schimburi f\u0103r\u0103 \xeentreruperi sus/jos."},ktm_rally_offroad_abs_tc_unlock:{name:"Deblocare mod Rally/Off-Road ABS \u0219i TC",desc:"Dezactiveaz\u0103 ABS-ul din spate \u0219i deblocheaz\u0103 reglarea alunec\u0103rii \xeen 9 trepte \xeen modul Rally."},ktm_my_ktm_connectivity_unlock:{name:"Activarea modulului meu de conectivitate KTM / Husqvarna",desc:"Activeaz\u0103 navigarea prin Bluetooth \u0219i rutarea pas cu pas pe afi\u0219ajul TFT."},ktm_cruise_control_retrofit_enable:{name:"Deblocare software de adaptare a controlului croazierului",desc:"Activeaz\u0103 func\u021bia de control al vitezei de croazier\u0103 dup\u0103 instalarea setului de comutare pe ghidon."},ktm_clutch_pull_map_switch_gesture:{name:"Comutarea h\u0103r\u021bii cu gesturi de tragere-ambrei",desc:"Permite comutarea rapid\u0103 a h\u0103r\u021bii prin executarea gestului manetei ambreiajului la pornire."},yamaha_quickshifter_cut_time_adjust:{name:"Timp de t\u0103iere \u0219i sensibilitate a aprinderii Quickshifter",desc:"Regleaz\u0103 pragul de \xeenc\u0103rcare a senzorului de schimbare rapid\u0103 \u0219i \xeent\xe2rzierea \xeentreruperii sc\xe2nteii."},yamaha_ride_by_wire_throttle_map:{name:"Selector de presetare a h\u0103r\u021bii de accelera\u021bie Ride-by-Wire",desc:"Comut\u0103 \xeentre h\u0103r\u021bile de accelera\u021bie A-Mode (agresiv), STD \u0219i B-Mode (Smooth)."},yamaha_tft_track_theme_unlock:{name:"Aspect de afi\u0219are a piesei TFT \u0219i deblocare a luminii Shift",desc:"Deblocheaz\u0103 aspectul grupului de \u0219enile R1/MT-09 SP \u0219i luminile programabile pentru schimbarea RPM."},yamaha_launch_control_sensitivity:{name:"Sistemul de control al lans\u0103rii (LCS) Rev Ceiling",desc:"Configura\u021bi controlul de lansare men\u021bin\xe2nd RPM (gam\u0103 de la 8.000 la 10.000 RPM)."},yamaha_heated_grips_accessory_enable:{name:"Integrarea meniului TFT cu m\xe2nere \xeenc\u0103lzite autentice",desc:"Activeaz\u0103 comenzile de prindere \xeenc\u0103lzit\u0103 \u0219i indicatorul de temperatur\u0103 pe ecranul TFT."},honda_hstc_wheelie_control_fine_tune:{name:"Reglare fin\u0103 HSTC Traction & Wheelie Control",desc:"Regleaz\u0103 raportul de alunecare Honda Selectable Torque Control \u0219i toleran\u021ba de ridicare a ro\u021bii din fa\u021b\u0103."},honda_bi_directional_quickshifter_enable:{name:"Deblocare bidirec\u021bional\u0103 a ma\u0219inii de schimbare rapid\u0103",desc:"Activeaz\u0103 codarea auto-blipper \u0219i sus/jos quickshifter \xeen memoria ECU."},honda_service_reminder_custom_interval:{name:"Personalizator de distan\u021b\u0103 pentru memento de service ulei",desc:"Seteaz\u0103 intervalul de kilometraj personalizat pentru schimbarea uleiului pe tabloul digital."},honda_track_abs_rear_disable:{name:"Dezactivarea ro\u021bilor din spate ABS pe cale",desc:"Dezactiveaz\u0103 canalul ABS al ro\u021bii din spate, p\u0103str\xe2nd \xeen acela\u0219i timp ABS la viraje fa\u021b\u0103 pentru zilele de pist\u0103."},honda_cold_start_idle_enrichment:{name:"\xcembog\u0103\u021birea combustibilului cu pornire la rece \u0219i RPM \u021bint\u0103 la ralanti",desc:"Regleaz\u0103 viteza ini\u021bial\u0103 de ralanti la \xeenc\u0103lzire pentru sistemele de evacuare aftermarket."},harley_custom_throttle_curve_editor:{name:"Editor personalizat de curbe de r\u0103spuns la accelera\u021bie",desc:"Regleaz\u0103 progresia accelera\u021biei Milwaukee-Eight / Revolution Max ride-by-wire."},harley_security_alarm_sensitivity:{name:"Sistem de securitate inteligent de proximitate \u0219i sensibilitate la \xeenclinare",desc:"Regleaz\u0103 sensibilitatea senzorului de mi\u0219care \u0219i \xeent\xe2rzierea de armare a telecomenzii hands-free."},harley_boom_box_gts_hidden_diagnostics:{name:"Bum! Meniu de diagnostic ascuns pentru Infotainment Box GTS",desc:"Deblocheaz\u0103 afi\u0219ajele de telemetrie de inginerie, temperatura motorului \u0219i manometrele de presiune a uleiului."},harley_rdrs_defensive_system_tune:{name:"Sensibilitatea controlului alunec\u0103rii cu drag-cuplu RDRS",desc:"Ajusteaz\u0103 fin Reflex Defensive Rider System atenuarea alunec\u0103rii ro\u021bilor din spate \xeen timpul trecerii trepte de vitez\u0103."},byd_avas_low_speed_siren_mute:{name:"Siren\u0103 de avertizare pentru pietoni AVAS de vitez\u0103 redus\u0103 EV",desc:"Dezactiveaz\u0103 sau coboar\u0103 sirena sistemului acustic extern de alert\u0103 a vehiculului sub 30 km/h."},byd_ev_battery_preheat_manual_switch:{name:"Comutator manual de pre\xeenc\u0103lzire a bateriei EV",desc:"Permite condi\u021bionarea termic\u0103 manual\u0103 a bateriei \xeenainte de \xeenc\u0103rcarea rapid\u0103 DC."},byd_v2l_220v_outlet_power_expansion:{name:"V2L (vehicul la \xeenc\u0103rcare) 220V extindere a puterii prizei (3,6 kW)",desc:"Extinde plafonul extern de putere de desc\u0103rcare V2L de la 2,2 kW la 3,6 kW maxim."},byd_one_pedal_regen_default_max:{name:"Ac\u021bionare cu o singur\u0103 pedal\u0103 Fr\xe2nare regenerativ\u0103 Implicit Max",desc:"Bloceaz\u0103 fr\xe2narea cu regenerare ridicat\u0103 ca implicit\u0103 persistent\u0103 la pornirea vehiculului."},mg_ismart_connectivity_unlock:{name:"Conectivitate i-SMART \u0219i deblocare prin telemetrie de la distan\u021b\u0103",desc:"Permite controlul climatului de la distan\u021b\u0103 \u0219i func\u021biile de urm\u0103rire a st\u0103rii vehiculului."},mg_mg4_xpower_launch_control_enable:{name:"Modul de control al lans\u0103rii MG4 XPower cu dublu motor",desc:"Deblocheaz\u0103 3,8 s, 0-100 km/h, modul de accelerare pentru controlul lans\u0103rii."},mg_battery_preheat_manual_trigger:{name:"Precondi\u021bionare manual\u0103 a bateriei cu \xeenc\u0103rcare rapid\u0103",desc:"For\u021beaz\u0103 elementele de \xeenc\u0103lzire a bateriei de \xeenalt\u0103 tensiune ON pentru ratele de \xeenc\u0103rcare DC de v\xe2rf."},xpeng_xngp_adas_region_unlock:{name:"Deblocare regiune XNGP Autonomous Driving Assistant",desc:"Permite asisten\u021b\u0103 avansat\u0103 pentru pilot ghidat\u0103 de naviga\u021bie \xeen regiunile deblocate."},xpeng_ambient_lighting_music_sync:{name:"Iluminare ambiental\u0103 cu ritm reactiv la muzic\u0103",desc:"Sincronizeaz\u0103 impulsurile de iluminare ambiental\u0103 cu LED-uri din cabin\u0103 cu b\u0103t\u0103ile de bas ale sistemului audio."},xpeng_rear_camera_trailer_hitch_view:{name:"Modul de cuplare a camerei la 360\xb0 \u0219i suprapunere la sol",desc:"Adaug\u0103 grila de aliniere a c\xe2rligului de \xeenalt\u0103 rezolu\u021bie la camera de rezerv\u0103."},nio_battery_swap_interval_reminder:{name:"Modul de precondi\u021bionare al sta\u021biei de schimb de energie",desc:"Coboar\u0103 automat \u0219tifturile de blocare a bateriei \u0219i pachetele de precondi\u021bii \xeenainte de schimbare."},nio_nomi_assistant_custom_voice_phrases:{name:"NOMI AI Companion Personalizare \u0219i Wake Words",desc:"Deblocheaz\u0103 anima\u021bii personalizate cu avatar \u0219i fraze de salut personalizate pentru NOMI."},nio_sentry_watchdog_continuous_recording:{name:"NIO Sentry Mode 4K Camera Buffer Recording",desc:"Permite \xeenregistrarea camerei surround cu vitez\u0103 mare de bi\u021bi pe unitatea USB c\xe2nd este parcat."},xiaomi_su7_hyperos_driver_profile_sync:{name:"Sincronizarea ecosistemului profilului driverului Xiaomi SU7 HyperOS",desc:"Sincronizeaz\u0103 automat preset\u0103rile pentru scaun, oglind\u0103 \u0219i climat prin Bluetooth al telefonului Xiaomi."},xiaomi_su7_boost_mode_throttle_curve:{name:"Modul Boost 20 de secunde Overboost Power Deblocare",desc:"Prelunge\u0219te dur