\u0435\u0441\u043a\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435",estimatedCost:"\u041e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u043e\u0447\u043d\u0430\u044f \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430/\u0440\u0435\u043c\u043e\u043d\u0442\u0430",noFaultsTitle:"\u041e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u2014 \u043a\u043e\u0434\u044b \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 \u043d\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u044b",noFaultsSummary:"\u0422\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044f \u042d\u0411\u0423 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0434\u043e\u0432 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439. \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0447\u0438\u0445 \u043f\u0440\u0435\u0434\u0435\u043b\u043e\u0432.",stepMaintain:"\u0421\u043e\u0431\u043b\u044e\u0434\u0430\u0439\u0442\u0435 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b \u0437\u0430\u043c\u0435\u043d\u044b \u043c\u0430\u0441\u043b\u0430 \u0438 \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432.",stepCheckVoltage:"\u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0439\u0442\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u043e\u044f \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430.",safeDrive:"\u0411\u0435\u0437\u043e\u043f\u0430\u0441\u0435\u043d \u0434\u043b\u044f \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0439 \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438.",misfireTitle:"\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d \u043f\u0440\u043e\u043f\u0443\u0441\u043a \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0432 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f",misfireSummary:"\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u044b \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0432 \u043e\u0434\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430\u0445. \u041d\u0435\u0441\u0433\u043e\u0440\u0435\u0432\u0448\u0435\u0435 \u0442\u043e\u043f\u043b\u0438\u0432\u043e \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043f\u0430\u0441\u0442\u044c \u0432 \u043a\u0430\u0442\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043a \u043d\u0435\u043e\u0431\u0440\u0430\u0442\u0438\u043c\u043e\u043c\u0443 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044e.",causeSparkPlug:"\u0418\u0437\u043d\u043e\u0448\u0435\u043d\u043d\u0430\u044f \u0438\u043b\u0438 \u0437\u0430\u0433\u0440\u044f\u0437\u043d\u0435\u043d\u043d\u0430\u044f \u0441\u0432\u0435\u0447\u0430 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f",causeIgnitionCoil:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u043a\u0430\u0442\u0443\u0448\u043a\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0438\u043b\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0430",causeFuelInjector:"\u0417\u0430\u0441\u043e\u0440\u0435\u043d\u043d\u0430\u044f \u0438\u043b\u0438 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u0430\u044f \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u0430\u044f \u0444\u043e\u0440\u0441\u0443\u043d\u043a\u0430",stepInspectPlugs:"\u041e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0438 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u0441\u0432\u0435\u0447\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f.",stepSwapCoils:"\u041f\u043e\u043c\u0435\u043d\u044f\u0439\u0442\u0435 \u043c\u0435\u0441\u0442\u0430\u043c\u0438 \u043a\u0430\u0442\u0443\u0448\u043a\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u043c\u0435\u0436\u0434\u0443 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430\u043c\u0438, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438.",stepFuelPressure:"\u0418\u0437\u043c\u0435\u0440\u044c\u0442\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u043e\u0439 \u0440\u0430\u043c\u043f\u0435.",criticalDrive:"\u041d\u0435 \u0435\u0437\u0434\u0438\u0442\u0435 \u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0441 \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0433\u0430\u0437\u043e\u043c. \u041d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435\u0441\u044c \u0432 \u0441\u0435\u0440\u0432\u0438\u0441.",o2Title:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u0446\u0435\u043f\u0438 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430",o2Summary:"\u0423\u0445\u0443\u0434\u0448\u0438\u043b\u0430\u0441\u044c \u043e\u0431\u0440\u0430\u0442\u043d\u0430\u044f \u0441\u0432\u044f\u0437\u044c \u0442\u043e\u043f\u043b\u0438\u0432\u043e\u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0439 \u0441\u043c\u0435\u0441\u0438. \u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430 \u043e\u0431\u0435\u0434\u043d\u0435\u043d\u043d\u043e\u0439 \u0438\u043b\u0438 \u043e\u0431\u0435\u0434\u043d\u0435\u043d\u043d\u043e\u0439 \u0441\u043c\u0435\u0441\u0438, \u0447\u0442\u043e \u0441\u043d\u0438\u0436\u0430\u0435\u0442 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u043e\u043f\u043b\u0438\u0432\u0430.",causeO2Heater:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2",causeExhaustLeak:"\u0423\u0442\u0435\u0447\u043a\u0430 \u0432 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u043e\u043c \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u043e\u0440\u0435 \u043f\u0435\u0440\u0435\u0434 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u043c",causeHarness:"\u041f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0440\u0430\u0437\u044a\u0435\u043c \u0436\u0433\u0443\u0442\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u043e\u0432",stepCheckWiring:"\u041e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0436\u0433\u0443\u0442 \u043f\u0440\u043e\u0432\u043e\u0434\u043e\u0432 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2 \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u043f\u043b\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0438\u0437\u043d\u0430\u0448\u0438\u0432\u0430\u043d\u0438\u044f.",stepCleanSensor:"\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u0435 \u043d\u0430\u043a\u043e\u043d\u0435\u0447\u043d\u0438\u043a \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2 \u0438\u043b\u0438 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u0434\u0430\u0442\u0447\u0438\u043a, \u0435\u0441\u043b\u0438 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438.",warningDrive:"\u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e \u0435\u0445\u0430\u0442\u044c \u0432 \u0440\u0435\u043c\u043e\u043d\u0442\u043d\u0443\u044e \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0443\u044e \u043d\u0430 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438.",genericTitle:"\u0410\u043d\u0430\u043b\u0438\u0437 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0434\u0430",genericSummary:"\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u044b \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u043a\u043e\u0434\u044b \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438: {{codes}}. \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u044b.",causeGeneric1:"\u0426\u0435\u043f\u044c \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0432\u043d\u0435 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u043e\u0433\u043e \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f",causeGeneric2:"\u041e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u043e\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0437\u0430\u043c\u044b\u043a\u0430\u043d\u0438\u0435 \u043d\u0430 \u0437\u0435\u043c\u043b\u044e",stepGeneric1:"\u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0437\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0441\u0442\u043e\u043f-\u043a\u0430\u0434\u0440\u0430.",stepGeneric2:"\u0421\u043e\u0442\u0440\u0438\u0442\u0435 \u043a\u043e\u0434\u044b DTC \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0440\u0430\u0437\u044a\u0435\u043c\u043e\u0432 \u0436\u0433\u0443\u0442\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u043e\u0432.",reportTitle:"\u0410\u043d\u0430\u043b\u0438\u0437 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0434\u0430",healthImpactTitle:"\u0412\u041b\u0418\u042f\u041d\u0418\u0415 \u041d\u0410 \u0421\u041e\u0421\u0422\u041e\u042f\u041d\u0418\u0415 \u0414\u0412\u0418\u0413\u0410\u0422\u0415\u041b\u042f",freeTrialBadge:"\u0412\u042b \u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0415\u0422\u0415 1 \u0411\u0415\u0421\u041f\u041b\u0410\u0422\u041d\u0423\u042e \u0418\u0418-\u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0423",modalTitle:"Modal Title",modalSubtitle:"Modal Subtitle"},dtcRisk:{safeTitle:"\u0411\u0415\u0417\u041e\u041f\u0410\u0421\u041d\u041e \u0414\u041b\u042f \u0415\u0417\u0414\u042b",safeDesc:"\u042d\u0442\u0430 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u043d\u0435 \u0443\u0433\u0440\u043e\u0436\u0430\u0435\u0442 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0441 \u0443\u043c\u0435\u0440\u0435\