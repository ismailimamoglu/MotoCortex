lyNotice:"\u0420\u0456\u0447\u043d\u0430 \u043f\u0456\u0434\u043f\u0438\u0441\u043a\u0430 \u0437 \u043c\u043e\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",aiDoctorLimitTitle:"\u041b\u0406\u041c\u0406\u0422 AI DOCTOR \u0414\u041e\u0421\u042f\u0413\u041d\u0423\u0422\u041e",aiDoctorLimitDesc:"\u0412\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043b\u0438 1 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0443 \u0406\u0406-\u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0434\u0432\u0438\u0433\u0443\u043d\u0430. \u041e\u043d\u043e\u0432\u0456\u0442\u044c\u0441\u044f \u0434\u043e PRO \u0434\u043b\u044f \u043d\u0435\u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043e\u0433\u043e \u0406\u0406-\u0430\u043d\u0430\u043b\u0456\u0437\u0443."},connection:{logoSub:"v7PRO",adapter:"\u041f\u0415\u0420\u0415\u0425\u041e\u0414\u041d\u0418\u041a",ecu:"ECU",online:"\u041e\u041d\u041b\u0410\u0419\u041d",connecting:"\u041f\u0406\u0414\u041a\u041b\u042e\u0427\u0415\u041d\u041d\u042f",scanDevices:"\u041f\u041e\u0428\u0423\u041a \u041f\u0420\u0418\u0421\u0422\u0420\u041e\u0407\u0412",connectLast:"\u041f\u0406\u0414\u041a\u041b\u042e\u0427\u0418\u0422\u0418 \u0414\u041e \u041a\u0406\u041d\u0426\u0415\u0412\u041e\u0413\u041e \u041f\u0420\u0418\u0421\u0422\u0420\u041e\u042e",enableBt:"\u0423\u0412\u0406\u041c\u041a\u041d\u0423\u0422\u0418 BLUETOOTH",scanning:"\u0421\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f...",foundDevices:"\u0417\u041d\u0410\u0419\u0414\u0415\u041d\u0406 \u041f\u0420\u0418\u0421\u0422\u0420\u041e\u0407 OBD2",unknownDevice:"\u041d\u0435\u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439",scanHint:"\u0421\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u043d\u0430\u0439\u0442\u0438 \u0441\u043f\u0430\u0440\