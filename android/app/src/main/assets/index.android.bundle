8\u092e\u0930\u093e \u0907\u0928\u094d\u092b\u094d\u0930\u093e\u0930\u0947\u0921 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",desc:"\u0917\u0939\u0930\u0947 \u0927\u094d\u0930\u0941\u0935\u0940\u0915\u0943\u0924 \u0927\u0942\u092a \u0915\u093e \u091a\u0936\u094d\u092e\u093e \u092a\u0939\u0928\u0928\u0947 \u0935\u093e\u0932\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0902\u0916\u094b\u0902 \u0915\u0940 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0938\u0940\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_soft_close_door_retrofit_coding:{name:"\u092a\u093e\u0935\u0930 \u0938\u0949\u092b\u094d\u091f-\u0915\u094d\u0932\u094b\u091c\u093c \u0921\u094b\u0930 \u0935\u0948\u0915\u094d\u092f\u0942\u092e \u090f\u0915\u094d\u091a\u0941\u090f\u091f\u0930 \u0915\u094b\u0921\u093f\u0902\u0917",desc:"\u092c\u0949\u0921\u0940 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u092e\u0947\u0902 \u092a\u093e\u0935\u0930 \u0921\u094b\u0930 \u0932\u0948\u091a \u092a\u0941\u0932-\u0907\u0928 \u090f\u0915\u094d\u091a\u0941\u090f\u091f\u0930\u094d\u0938 \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_digital_speedometer_display_enable:{name:"\u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u092a\u0940\u0921\u094b\u092e\u0940\u091f\u0930 \u0938\u0947\u0902\u091f\u0930 \u0917\u0947\u091c \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947",desc:"\u090f\u0928\u093e\u0932\u0949\u0917 \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u090f\u0932\u0938\u0940\u0921\u0940 \u092e\u0947\u0902 \u092c\u0921\u093c\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u092a\u0940\u0921 \u0930\u0940\u0921\u0906\u0909\u091f \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"},toyota_walk_away_auto_lock_sensitivity:{name:"\u0935\u0949\u0915-\u0905\u0935\u0947 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u0911\u091f\u094b \u0921\u094b\u0930 \u0932\u0949\u0915\u093f\u0902\u0917 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",desc:"\u0926\u0942\u0930 \u091c\u093e\u0928\u0947 \u092a\u0930 \u0926\u0930\u0935\u093e\u091c\u0947 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0926\u0942\u0930\u0940 \u0938\u0940\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_jbl_3d_eq_audio_profile_unlock:{name:"\u091c\u0947\u092c\u0940\u090f\u0932 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u0930\u093e\u0909\u0902\u0921 \u0938\u093e\u0909\u0902\u0921 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u0930\u094d\u0935\u094d\u0938",desc:"\u091c\u0947\u092c\u0940\u090f\u0932 \u0911\u0921\u093f\u092f\u094b \u0939\u0947\u0921 \u092f\u0942\u0928\u093f\u091f \u092e\u0947\u0902 3\u0921\u0940 \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u0939\u0949\u0932 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_ev_mode_throttle_override_suppression:{name:"\u0908\u0935\u0940 \u092e\u094b\u0921 \u092a\u094d\u092f\u094b\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0925\u094d\u0930\u0949\u091f\u0932 \u0932\u093f\u092e\u093f\u091f \u0938\u092a\u094d\u0930\u0947\u0936\u0928",desc:"\u092e\u0927\u094d\u092f\u092e \u0908\u0935\u0940 \u0924\u094d\u0935\u0930\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0917\u0948\u0938\u094b\u0932\u0940\u0928 \u0907\u0902\u091c\u0928 \u0915\u094b \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u093e \u0939\u0948\u0964"},ford_sync3_engineering_diagnostics_page:{name:"SYNC3 / SYNC4 \u091f\u091a\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930\u093f\u0902\u0917 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u094d\u0915\u094d\u0930\u0940\u0928",desc:"SYNC \u092a\u0930 \u0930\u0949 \u091c\u0940\u092a\u0940\u090f\u0938, \u090f\u092a\u0940\u0906\u0908\u090f\u092e \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0914\u0930 \u0911\u0921\u093f\u092f\u094b \u092b\u094d\u0930\u0940\u0915\u094d\u0935\u0947\u0902\u0938\u0940 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ford_rear_seat_entertainment_unlock:{name:"\u0930\u093f\u092f\u0930 \u0938\u0940\u091f \u090f\u091a\u0921\u0940\u090f\u092e\u0906\u0908 / \u0935\u0940\u0921\u093f\u092f\u094b \u092e\u0928\u094b\u0930\u0902\u091c\u0928 \u0911\u0921\u093f\u092f\u094b \u092a\u093e\u0938-\u0925\u094d\u0930\u0942",desc:"\u092a\u093f\u091b\u0932\u0940 \u0938\u0940\u091f \u0915\u0940 \u092e\u0928\u094b\u0930\u0902\u091c\u0928 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u092c\u093f\u0928 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0911\u0921\u093f\u092f\u094b \u0938\u094d\u091f\u094d\u0930\u0940\u092e\u093f\u0902\u0917 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ford_bambi_mode_fog_light_expansion:{name:"\u092c\u093e\u0902\u092c\u0940 \u092e\u094b\u0921 \u0939\u093e\u0908 \u092c\u0940\u092e + \u092b\u0949\u0917 \u0932\u093e\u0907\u091f \u090f\u0915 \u0938\u093e\u0925 \u0930\u094b\u0936\u0928\u0940",desc:"\u0939\u093e\u0908 \u092c\u0940\u092e \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b\u0928\u0947 \u092a\u0930 \u092d\u0940 \u0938\u093e\u092e\u0928\u0947 \u0915\u0940 \u092b\u0949\u0917 \u0932\u093e\u0907\u091f \u0915\u094b \u091a\u093e\u0932\u0942 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},ford_auto_engine_idle_shutdown_30min_override:{name:"30-\u092e\u093f\u0928\u091f \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0911\u091f\u094b \u0907\u0902\u091c\u0928 \u0936\u091f\u0921\u093e\u0909\u0928 \u0905\u0915\u094d\u0937\u092e",desc:"\u092a\u093e\u0930\u094d\u0915 \u092e\u0947\u0902 30 \u092e\u093f\u0928\u091f \u0915\u0947 \u092c\u093e\u0926 \u0907\u0902\u091c\u0928 \u0915\u094b \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u093e \u0939\u0948\u0964"},hyundai_n_grin_shift_retrofit_enable:{name:"\u090f\u0928 \u0917\u094d\u0930\u093f\u0928 \u0936\u093f\u092b\u094d\u091f (\u090f\u0928\u091c\u0940\u090f\u0938) 20-\u0938\u0947\u0915\u0902\u0921 \u0913\u0935\u0930\u092c\u0942\u0938\u094d\u091f \u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u0905\u0928\u0932\u0949\u0915",desc:"\u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u0902 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0935\u094d\u0939\u0940\u0932 \u090f\u0928\u091c\u0940\u090f\u0938 \u092c\u091f\u0928 \u0913\u0935\u0930\u092c\u0942\u0938\u094d\u091f \u092b\u093c\u0902\u0915\u094d\u0936\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},hyundai_smart_tailgate_approach_distance:{name:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0939\u0948\u0902\u0921\u094d\u0938-\u092b\u093c\u094d\u0930\u0940 \u091f\u0947\u0932\u0917\u0947\u091f \u0905\u092a\u094d\u0930\u094b\u091a \u092a\u094d\u0930\u0949\u0915\u094d\u0938\u093f\u092e\u093f\u091f\u0940 \u0938\u0947\u0902\u0938\u093f\u0902\u0917",desc:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u091f\u0947\u0932\u0917\u0947\u091f \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0916\u0941\u0932\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0916\u0921\u093c\u0947 \u0939\u094b\u0928\u0947 \u092e\u0947\u0902 \u0926\u0947\u0930\u0940 \u0915\u093e \u0938\u092e\u092f (3s \u0938\u0947 1s) \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},hyundai_digital_cluster_n_performance_theme:{name:"\u090f\u0928 \u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u0921\u093f\u091c\u093f\u091f\u0932 \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0917\u0947\u091c \u0932\u0947\u0906\u0909\u091f",desc:"\u092e\u093e\u0928\u0915 \u090f\u0932\u0938\u0940\u0921\u0940 \u0921\u0948\u0936 \u092a\u0930 \u090f\u0928-\u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u0930\u0947\u0921 \u0936\u093f\u092b\u094d\u091f-\u0907\u0902\u0921\u093f\u0915\u0947\u091f\u0930 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0932\u0947\u0906\u0909\u091f \u0932\u093e\u0917\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},stellantis_scr_adblue_warning_threshold_adjust:{name:"\u090f\u0938\u0938\u0940\u0906\u0930 \u090f\u0921\u092c\u094d\u0932\u0942 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0942\u0930\u0940 \u0938\u0940\u092e\u093e \u0938\u092e\u093e\u092f\u094b\u091c\u0928",desc:"\u092a\u0939\u0932\u0947 AdBlue \u0930\u0940\u092b\u093f\u0932 \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0942\u0930\u0940 \u0915\u094b 2400 \u0915\u093f\u092e\u0940 \u0938\u0947 1000 \u0915\u093f\u092e\u0940 \u0924\u0915 \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},stellantis_jeep_trail_rated_offroad_pages:{name:"\u091c\u0940\u092a \u092f\u0942\u0915\u0928\u0947\u0915\u094d\u091f \u091f\u094d\u0930\u0947\u0932-\u0930\u0947\u091f\u0947\u0921 \u0911\u092b-\u0930\u094b\u0921 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u092a\u0947\u091c",desc:"\u092f\u0942\u0915\u0928\u0947\u0915\u094d\u091f \u092a\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u091f\u094d\u0930\u0947\u0928 \u092a\u093f\u091a, \u0930\u094b\u0932, \u0935\u094d\u0939\u0940\u0932 \u0906\u0930\u094d\u091f\u093f\u0915\u094d\u092f\u0942\u0932\u0947\u0936\u0928 \u0914\u0930 \u0915\u0942\u0932\u0947\u0902\u091f \u091f\u0947\u092e\u094d\u092a \u092a\u0947\u091c \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},stellantis_peugeot_icockpit_3d_color_schemes:{name:"\u092a\u094d\u092f\u0942\u091c\u093c\u094b 3\u0921\u0940 \u0906\u0908-\u0915\u0949\u0915\u092a\u093f\u091f \u0915\u0938\u094d\u091f\u092e \u0915\u0932\u0930 \u0938\u094d\u0915\u0940\u092e \u092a\u0948\u0932\u0947\u091f",desc:"3\u0921\u0940 \u0939\u094b\u0932\u094b\u0917\u094d\u0930\u093e\u092b\u093f\u0915 \u0921\u093f\u091c\u093f\u091f\u0932 \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0915\u0947 \u0932\u093f\u090f \u0915\u0949\u092a\u0930 \u0914\u0930 \u0915\u094d\u0935\u093e\u0930\u094d\u091f\u094d\u091c \u0930\u0902\u0917 \u0925\u0940\u092e \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},gm_super_cruise_follow_distance_adjust:{name:"\u0938\u0941\u092a\u0930 \u0915\u094d\u0930\u0942\u091c\u093c \u0939\u0948\u0902\u0921\u094d\u0938-\u092b\u093c\u094d\u0930\u0940 \u092b\u093c\u0949\u0932\u094b\u0907\u0902\u0917 \u0921\u093f\u0938\u094d\u091f\u0947\u0902\u0938 \u0911\u092b\u093c\u0938\u0947\u091f",desc:"\u0938\u094d\u0935\u093e\u092f\u0924\u094d\u0924 \u0938\u0941\u092a\u0930 \u0915\u094d\u0930\u0942\u091c\u093c \u0939\u093e\u0908\u0935\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0917\u0948\u092a \u0938\u094d\u092a\u0947\u0938\u093f\u0902\u0917 \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},gm_instrument_hud_calibration_reset:{name:"\u0939\u0947\u0921-\u0905\u092a \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 (\u090f\u091a\u092f\u0942\u0921\u0940) \u0938\u094d\u0925\u093f\u0924\u093f \u0914\u0930 \u091d\u0941\u0915\u093e\u0935 \u0936\u0942\u0928\u094d\u092f-\u092c\u093f\u0902\u0926\u0941 \u0905\u0902\u0936\u093e\u0902\u0915\u0928",desc:"\u0935\u093f\u0902\u0921-\u0936\u0940\u0932\u094d\u0921 HUD \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f\u0930 \u091b\u0935\u093f \u0915\u094b\u0923 \u0914\u0930 \u0936\u0942\u0928\u094d\u092f-\u0938\u094d\u0924\u0930\u0940\u092f \u0915\u094d\u0937\u093f\u0924\u093f\u091c \u0938\u0902\u0930\u0947\u0916\u0923 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},gm_afm_v8_cylinder_lock_no_v4_drop:{name:"\u090f\u090f\u092b\u090f\u092e/\u0921\u0940\u090f\u092b\u090f\u092e \u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f\u0915\u0930\u0923 \u0913\u0935\u0930\u0930\u093e\u0907\u0921 (\u0939\u092e\u0947\u0936\u093e \u0935\u09408 \u092e\u094b\u0921)",desc:"\u0907\u0902\u091c\u0928 \u0915\u094b 8-\u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u092e\u094b\u0921 \u092e\u0947\u0902 \u091a\u093e\u0932\u0942 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0915\u094d\u0930\u093f\u092f \u0908\u0902\u0927\u0928 \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u0921\u094d\u0930\u0949\u092a \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},dodge_ram_truck_fog_lights_with_high_beam:{name:"\u0939\u093e\u0908 \u092c\u0940\u092e \u0915\u0947 \u0938\u093e\u0925 \u0930\u0948\u092e \u091f\u094d\u0930\u0915 \u092b\u0949\u0917 \u0932\u093e\u0907\u091f\u094d\u0938 (\u0939\u093e\u0908-\u0932\u094b-\u092b\u0949\u0917 \u0915\u0949\u092e\u094d\u092c\u094b)",desc:"\u0939\u093e\u0908 \u092c\u0940\u092e \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u0947 \u092a\u0930 \u092b\u0949\u0917 \u0932\u093e\u0907\u091f \u0915\u094b \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u093e \u0939\u0948\u0964"},toyota_keyless_window_down:{name:"\u091f\u094b\u092f\u094b\u091f\u093e \u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u094b\u092c \u0935\u093f\u0902\u0921\u094b \u0916\u0941\u0932\u0940 (\u0905\u0928\u0932\u0949\u0915 \u0926\u092c\u093e\u090f \u0930\u0916\u0947\u0902)",desc:"\u0930\u093f\u092e\u094b\u091f \u092b\u093c\u0949\u092c \u092a\u0930 \u0905\u0928\u0932\u0949\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u090f \u0930\u0916\u0928\u0947 \u092a\u0930 \u0938\u092d\u0940 \u092a\u093e\u0935\u0930 \u0935\u093f\u0902\u0921\u094b \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964"},toyota_seatbelt_chime_disable:{name:"\u091f\u094b\u092f\u094b\u091f\u093e \u092a\u0948\u0938\u0947\u0902\u091c\u0930 \u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u0905\u0932\u093e\u0930\u094d\u092e \u092e\u094d\u092f\u0942\u091f (\u092a\u093e\u0930\u094d\u0915/\u0911\u092b-\u0930\u094b\u0921)",desc:"\u092f\u093e\u0924\u094d\u0930\u0940 \u0938\u0940\u091f \u092e\u0947\u0902 \u0932\u0917\u093e\u0924\u093e\u0930 \u0927\u094d\u0935\u0928\u093f\u0915 \u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091d\u0902\u0915\u093e\u0930 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},honda_walkaway_auto_lock:{name:"\u0939\u094b\u0902\u0921\u093e \u0935\u0949\u0915-\u0905\u0935\u0947 \u0911\u091f\u094b \u0921\u094b\u0930 \u0932\u0949\u0915",desc:"\u091c\u092c \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 2.5 \u092e\u0940\u091f\u0930 \u0935\u093e\u0939\u0928 \u0924\u094d\u0930\u093f\u091c\u094d\u092f\u093e \u091b\u094b\u0921\u093c\u0924\u0940 \u0939\u0948 \u0924\u094b \u0938\u092d\u0940 \u0926\u0930\u0935\u093e\u091c\u0947 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},volvo_speed_limiter_unlock:{name:"\u0935\u094b\u0932\u094d\u0935\u094b 180 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0938\u094d\u092a\u0940\u0921 \u0932\u093f\u092e\u093f\u091f\u0930 \u092c\u0922\u093c\u093e\u092f\u093e \u0917\u092f\u093e",desc:"\u091f\u094d\u0930\u0948\u0915/\u0911\u091f\u094b\u092c\u093e\u0928 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u090f 180 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0938\u094d\u092a\u0940\u0921 \u0915\u0948\u092a \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},byd_v2l_3kw_power_unlock:{name:"BYD \u0935\u093e\u0939\u0928-\u0938\u0947-\u0932\u094b\u0921 (V2L) 3.6kW AC \u0906\u0909\u091f\u092a\u0941\u091f \u092e\u094b\u0921",desc:"\u0915\u0948\u092e\u094d\u092a\u093f\u0902\u0917 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0939\u0930\u0940 220V/3.6kW V2L AC \u0921\u093f\u0938\u094d\u091a\u093e\u0930\u094d\u091c \u092a\u094b\u0930\u094d\u091f \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},xiaomi_su7_drift_mode_unlock:{name:"Xiaomi SU7 \u091f\u094d\u0930\u0948\u0915 \u0921\u094d\u0930\u093f\u092b\u094d\u091f \u092e\u094b\u0921 \u0914\u0930 \u0930\u093f\u092f\u0930-\u091f\u0949\u0930\u094d\u0915 \u092c\u093e\u092f\u0938",desc:"100% \u0930\u093f\u092f\u0930 \u092e\u094b\u091f\u0930 \u091f\u0949\u0930\u094d\u0915 \u092c\u093e\u092f\u0938 \u0914\u0930 \u0908\u090f\u0938\u0938\u0940 \u091f\u094d\u0930\u0948\u0915 \u0921\u094d\u0930\u093f\u092b\u094d\u091f \u092e\u094b\u0921 \u0915\u094b \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_oil_service_reset:{name:"Oil Change Service Reset (Flexible Interval)",desc:"Resets instrument cluster oil change interval counter to factory 15,000 km / 365 days."},vag_epb_service_mode:{name:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092c\u094d\u0930\u0947\u0915 (\u0908\u092a\u0940\u092c\u0940) \u092c\u094d\u0930\u0947\u0915 \u092a\u0948\u0921 \u0938\u0930\u094d\u0935\u093f\u0938 \u092e\u094b\u0921",desc:"\u0930\u093f\u092f\u0930 \u092c\u094d\u0930\u0947\u0915 \u092a\u0948\u0921 \u0914\u0930 \u0930\u094b\u091f\u0930 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u0928 \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u092f\u0930 \u0908\u092a\u0940\u092c\u0940 \u0915\u0948\u0932\u093f\u092a\u0930 \u092a\u093f\u0938\u094d\u091f\u0928 \u0915\u094b \u0935\u093e\u092a\u0938 \u0932\u0947\u0924\u093e \u0939\u0948\u0964"},bmw_bms_battery_registration:{name:"\u0907\u0902\u091f\u0947\u0932\u093f\u091c\u0947\u0902\u091f \u092c\u0948\u091f\u0930\u0940 \u0938\u0947\u0902\u0938\u0930 (\u0906\u0908\u092c\u0940\u090f\u0938) \u092c\u0948\u091f\u0930\u0940 \u092a\u0902\u091c\u0940\u0915\u0930\u0923",desc:"\u0921\u0940\u090f\u092e\u0908/\u0921\u0940\u0921\u0940\u0908 \u0907\u0902\u091c\u0928 \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u092e\u0947\u0902 \u0928\u090f 12\u0935\u0940 \u090f\u091c\u0940\u090f\u092e/\u0932\u0940\u0921-\u090f\u0938\u093f\u0921 \u092c\u0948\u091f\u0930\u0940 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u0928 \u0915\u094b \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_motorrad_service_indicator_reset:{name:"\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942 \u092e\u094b\u091f\u0930\u0930\u093e\u0921 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0938\u0947\u0935\u093e \u0914\u0930 \u0924\u0947\u0932 \u0938\u0902\u0915\u0947\u0924\u0915 \u0930\u0940\u0938\u0947\u091f",desc:"\u091f\u0940\u090f\u092b\u091f\u0940 \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092a\u0930 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0938\u0947\u0935\u093e \u0924\u093f\u0925\u093f \u0914\u0930 10,000 \u0915\u093f\u092e\u0940 \u0926\u0942\u0930\u0940 \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_desmo_service_reset:{name:"\u0921\u0941\u0915\u093e\u091f\u0940 \u0921\u0947\u0938\u094d\u092e\u094b \u0935\u093e\u0932\u094d\u0935 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u0938\u093e\u092b\u093c",desc:"15,000/30,000 \u0915\u093f\u092e\u0940 \u0915\u0940 \u0938\u0947\u0935\u093e \u0915\u0947 \u092c\u093e\u0926 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092a\u0930 \u0921\u0947\u0938\u094d\u092e\u094b\u0938\u0930\u094d\u0935\u093f\u0938 \u0930\u093f\u0902\u091a \u0906\u0907\u0915\u0928 \u0938\u093e\u092b\u093c \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},byd_bms_isolation_self_test:{name:"BYD \u092c\u094d\u0932\u0947\u0921 \u092c\u0948\u091f\u0930\u0940 \u0939\u093e\u0908-\u0935\u094b\u0932\u094d\u091f\u0947\u091c \u0906\u0907\u0938\u094b\u0932\u0947\u0936\u0928 \u0938\u0947\u0932\u094d\u092b-\u091f\u0947\u0938\u094d\u091f",desc:"\u092c\u0940\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u0909\u091a\u094d\u091a-\u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092a\u094d\u0930\u0923\u093e\u0932\u0940 (400V/800V) \u0930\u093f\u0938\u093e\u0935 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0930\u094b\u0927 \u0928\u093f\u0926\u093e\u0928 \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_drl_brightness_multi:{name:"\u0926\u093f\u0928 \u0915\u0947 \u0938\u092e\u092f \u091a\u0932\u0928\u0947 \u0935\u093e\u0932\u0940 \u0930\u094b\u0936\u0928\u0940 (\u0921\u0940\u0906\u0930\u090f\u0932) \u091a\u092e\u0915 \u0938\u092e\u093e\u092f\u094b\u091c\u0928",desc:"\u0932\u094b-\u092c\u0940\u092e/\u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092e\u094b\u0921 \u0915\u0947 \u0932\u093f\u090f \u090f\u0932\u0908\u0921\u0940 \u0921\u0940\u0906\u0930\u090f\u0932 \u0924\u0940\u0935\u094d\u0930\u0924\u093e \u0938\u094d\u0924\u0930 \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"},bmw_comfort_turn_signal_cycles:{name:"\u0935\u0928-\u091f\u091a \u0915\u092e\u094d\u092b\u0930\u094d\u091f \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u092a\u0932\u094d\u0938 \u0915\u093e\u0909\u0902\u091f",desc:"\u091a\u0941\u0928\u0947\u0902 \u0915\u093f \u091f\u0930\u094d\u0928 \u0907\u0902\u0921\u093f\u0915\u0947\u091f\u0930 \u0932\u0940\u0935\u0930 \u0915\u0947 \u0924\u094d\u0935\u0930\u093f\u0924 \u091f\u0948\u092a \u092a\u0930 \u0915\u093f\u0924\u0928\u0940 \u092a\u0932\u0915\u0947\u0902 \u091d\u092a\u0915\u0924\u0940 \u0939\u0948\u0902\u0964"},bmw_oil_service_reset:{name:"\u0938\u0940\u092c\u0940\u090f\u0938 \u0907\u0902\u091c\u0928 \u0911\u092f\u0932 \u0930\u0940\u0938\u0947\u091f (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0938\u094d\u0925\u093f\u0924\u093f \u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0947\u0935\u093e (\u0938\u0940\u092c\u0940\u090f\u0938) \u0924\u0947\u0932 \u091c\u0940\u0935\u0928 \u092a\u094d\u0930\u0924\u093f\u0936\u0924 \u0915\u094b 100% \u092a\u0930 \u0935\u093e\u092a\u0938 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},generic_oil_service_reset:{name:"\u092f\u0942\u0928\u093f\u0935\u0930\u094d\u0938\u0932 \u0911\u092f\u0932 \u092e\u0947\u0902\u091f\u0947\u0928\u0947\u0902\u0938 \u0907\u0902\u0921\u093f\u0915\u0947\u091f\u0930 \u0930\u0940\u0938\u0947\u091f",desc:"\u0938\u092e\u0930\u094d\u0925\u093f\u0924 OBD2/UDS ECUs \u092e\u0947\u0902 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0911\u092f\u0932 \u0930\u0916\u0930\u0916\u093e\u0935 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0932\u093e\u0907\u091f \u0915\u094b \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_epb_pad_change:{name:"\u0908\u092a\u0940\u092c\u0940 \u092c\u094d\u0930\u0947\u0915 \u092a\u0948\u0921 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u092e\u094b\u0921 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0930\u093f\u092f\u0930 \u092c\u094d\u0930\u0947\u0915 \u092a\u0948\u0921 \u0938\u0930\u094d\u0935\u093f\u0938\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092c\u094d\u0930\u0947\u0915 \u0915\u0948\u0932\u0940\u092a\u0930\u094d\u0938 \u0915\u094b \u0935\u093e\u092a\u0938 \u0932\u0947\u0924\u093e \u0939\u0948\u0964"},bmw_epb_pad_change:{name:"\u0908\u092a\u0940\u092c\u0940 \u092c\u094d\u0930\u0947\u0915 \u0938\u0930\u094d\u0935\u093f\u0938 \u092e\u094b\u0921 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0930\u093f\u092f\u0930 \u092a\u0948\u0921 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u0928 \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092c\u094d\u0930\u0947\u0915 \u090f\u0915\u094d\u091a\u0941\u090f\u091f\u0930 \u0915\u094b \u0938\u0947\u0935\u093e \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0916\u094b\u0932\u0924\u093e \u0939\u0948\u0964"},mb_epb_pad_change:{name:"\u0908\u092a\u0940\u092c\u0940 \u092a\u0948\u0921 \u092b\u093f\u091f\u093f\u0902\u0917 \u092e\u094b\u0921 (\u092e\u0930\u094d\u0938\u093f\u0921\u0940\u091c-\u092c\u0947\u0902\u091c)",desc:"\u092c\u094d\u0930\u0947\u0915 \u0938\u0930\u094d\u0935\u093f\u0938 \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092c\u094d\u0930\u0947\u0915 \u0938\u094d\u092a\u093f\u0902\u0921\u0932 \u0915\u094b \u0935\u0930\u094d\u0915\u0936\u0949\u092a \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u091c\u093e\u0930\u0940 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_dpf_regen:{name:"\u0921\u0940\u092a\u0940\u090f\u092b \u0938\u0947\u0935\u093e \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u0928 \u091f\u094d\u0930\u093f\u0917\u0930 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0938\u094d\u0925\u093f\u0930 \u0921\u0940\u091c\u093c\u0932 \u092a\u093e\u0930\u094d\u091f\u093f\u0915\u0941\u0932\u0947\u091f \u092b\u093c\u093f\u0932\u094d\u091f\u0930 (\u0921\u0940\u092a\u0940\u090f\u092b) \u0915\u093e\u0932\u093f\u0916 \u091c\u0932\u093e\u0928\u0947 \u0915\u093e \u091a\u0915\u094d\u0930 \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_dpf_regen:{name:"\u0921\u0940\u092a\u0940\u090f\u092b \u092b\u094b\u0930\u094d\u0938\u094d\u0921 \u0930\u0940\u091c\u0947\u0928\u0930\u0947\u0936\u0928 \u091f\u094d\u0930\u093f\u0917\u0930 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0938\u0915\u094d\u0930\u093f\u092f \u092a\u093e\u0930\u094d\u091f\u093f\u0915\u0941\u0932\u0947\u091f \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u0928 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f DDE ECU \u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},psa_dpf_regen:{name:"\u0921\u0940\u092a\u0940\u090f\u092b \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 (\u092a\u094d\u092f\u0942\u091c\u093c\u094b/\u0938\u093f\u091f\u094d\u0930\u094b\u090f\u0928)",desc:"\u090f\u091a\u0921\u0940\u0906\u0908 \u0921\u0940\u091c\u0932 \u0907\u0902\u091c\u0928 \u0908\u0938\u0940\u092f\u0942 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093f\u0930 \u0921\u0940\u092a\u0940\u090f\u092b \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u0928 \u0915\u094b \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_bms_battery_register:{name:"\u092c\u0940\u090f\u092e\u090f\u0938 \u092c\u0948\u091f\u0930\u0940 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u092a\u0902\u091c\u0940\u0915\u0930\u0923 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0921\u0940\u090f\u092e\u0908/\u0921\u0940\u0921\u0940\u0908 \u0907\u0902\u091f\u0947\u0932\u093f\u091c\u0947\u0902\u091f \u092c\u0948\u091f\u0930\u0940 \u0938\u0947\u0902\u0938\u0930 \u0915\u0947 \u0938\u093e\u0925 \u0928\u0908 \u092c\u0948\u091f\u0930\u0940 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u0928 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},mb_bms_battery_register:{name:"\u092c\u0948\u091f\u0930\u0940 \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0914\u0930 \u0930\u0940\u0938\u0947\u091f (\u092e\u0930\u094d\u0938\u093f\u0921\u0940\u091c-\u092c\u0947\u0902\u091c)",desc:"\u0928\u0908 \u092c\u0948\u091f\u0930\u0940 \u0907\u0902\u0938\u094d\u091f\u093e\u0932\u0947\u0936\u0928 \u0915\u0947 \u092c\u093e\u0926 \u090f\u0938\u090f\u090f\u092e \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u092e\u0947\u0902 \u092c\u0948\u091f\u0930\u0940 \u090f\u091c\u093f\u0902\u0917 \u0915\u093e\u0909\u0902\u091f\u0930 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_sas_calibrate:{name:"\u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u090f\u0902\u0917\u0932 \u0938\u0947\u0902\u0938\u0930 (\u090f\u0938\u090f\u090f\u0938) \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u0936\u0928 (\u0935\u0940\u090f\u091c\u0940)",desc:"ABS/ESP ECU \u0915\u0947 \u0932\u093f\u090f G85 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u090f\u0902\u0917\u0932 \u0938\u0947\u0902\u0938\u0930 \u0936\u0942\u0928\u094d\u092f-\u092c\u093f\u0902\u0926\u0941 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_sas_calibrate:{name:"\u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0915\u094b\u0923 \u0936\u0942\u0928\u094d\u092f \u092c\u093f\u0902\u0926\u0941 \u0905\u0902\u0936\u093e\u0902\u0915\u0928 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0938\u094d\u0915\u093f\u0921 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u0902 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u090f\u0902\u0917\u0932 \u0938\u0947\u0902\u0938\u0930 \u0915\u093e \u0936\u0942\u0928\u094d\u092f \u092c\u093f\u0902\u0926\u0941 \u0905\u0902\u0936\u093e\u0902\u0915\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},generic_tba_adapt:{name:"\u0925\u094d\u0930\u0949\u091f\u0932 \u092c\u0949\u0921\u0940 \u0938\u0902\u0930\u0947\u0916\u0923 \u0914\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u0928",desc:"\u0907\u0902\u091c\u0928 \u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u0902 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0925\u094d\u0930\u0949\u091f\u0932 \u092c\u0949\u0921\u0940 \u0938\u094d\u091f\u0949\u092a \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0930\u0942\u091f\u0940\u0928 \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},epb_service_reset:{name:"\u092f\u0942\u0928\u093f\u0935\u0930\u094d\u0938\u0932 \u0908\u092a\u0940\u092c\u0940 \u0930\u0916\u0930\u0916\u093e\u0935 \u0930\u0940\u0938\u0947\u091f",desc:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u093e\u0930\u094d\u0915 \u092c\u094d\u0930\u0947\u0915 \u0915\u0948\u0932\u093f\u092a\u0930 \u0935\u093f\u092f\u0930 \u0915\u093e\u0909\u0902\u091f\u0930 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u090f\u092f\u0930 \u0917\u0948\u092a \u0915\u094b \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_dsg_reset:{name:"\u0921\u0940\u090f\u0938\u091c\u0940 \u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u092c\u0947\u0938\u093f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0930\u0940\u0938\u0947\u091f (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0921\u0940\u090f\u0938\u091c\u0940/\u090f\u0938-\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u091a \u090f\u0902\u0917\u0947\u091c\u092e\u0947\u0902\u091f \u092a\u0949\u0907\u0902\u091f \u0914\u0930 \u0936\u093f\u092b\u094d\u091f \u0935\u093e\u0932\u094d\u0935 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_zf_reset:{name:"ZF 8HP \u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0930\u0940\u0938\u0947\u091f (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0908\u091c\u0940\u090f\u0938 \u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0936\u093f\u092b\u094d\u091f \u0938\u092e\u092f \u0914\u0930 \u0926\u092c\u093e\u0935 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u092e\u0942\u0932\u094d\u092f\u094b\u0902 \u0915\u094b \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_brake_fluid_reset:{name:"\u092c\u094d\u0930\u0947\u0915 \u0926\u094d\u0930\u0935 \u0938\u0947\u0935\u093e \u0905\u0902\u0924\u0930\u093e\u0932 \u0930\u0940\u0938\u0947\u091f (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0938\u094d\u0925\u093f\u0924\u093f \u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0947\u0935\u093e (\u0938\u0940\u092c\u0940\u090f\u0938) 2-\u0935\u0930\u094d\u0937\u0940\u092f \u092c\u094d\u0930\u0947\u0915 \u0926\u094d\u0930\u0935 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u091f\u093e\u0907\u092e\u0930 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ford_injector_code:{name:"\u0907\u0902\u091c\u0947\u0915\u094d\u091f\u0930 \u0938\u0941\u0927\u093e\u0930 \u0915\u093e\u0930\u0915 \u0915\u094b\u0921\u093f\u0902\u0917 (\u092b\u094b\u0930\u094d\u0921)",desc:"\u092a\u0940\u0938\u0940\u090f\u092e \u092e\u0947\u0902 \u0921\u0940\u091c\u0932 \u0907\u0902\u091c\u0947\u0915\u094d\u091f\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f 16-\u0935\u0930\u094d\u0923 \u0935\u093e\u0932\u0947 IQA \u0915\u094b\u0921 \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_injector_code:{name:"\u0908\u0902\u0927\u0928 \u0907\u0902\u091c\u0947\u0915\u094d\u091f\u0930 \u092a\u094d\u0930\u0935\u093e\u0939 \u0926\u0930 \u0915\u094b\u0921\u093f\u0902\u0917 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0921\u0940\u090f\u092e\u0908 \u092e\u0947\u0902 \u092c\u0926\u0932\u0947 \u0917\u090f \u0908\u0902\u0927\u0928 \u0907\u0902\u091c\u0947\u0915\u094d\u091f\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090a\u0930\u094d\u091c\u093e \u0905\u0902\u0936\u093e\u0902\u0915\u0928 \u092e\u093e\u0928 \u0932\u093f\u0916\u0924\u093e \u0939\u0948\u0964"},generic_headlight_aim:{name:"\u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0911\u091f\u094b-\u0932\u0947\u0935\u0932\u093f\u0902\u0917 \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u0936\u0928",desc:"\u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u0911\u091f\u094b-\u0932\u0947\u0935\u0932\u093f\u0902\u0917 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u092e\u094b\u091f\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0938\u0902\u0926\u0930\u094d\u092d \u0936\u0942\u0928\u094d\u092f \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_12v_battery_reg:{name:"12V \u0938\u0939\u093e\u092f\u0915 \u092c\u0948\u091f\u0930\u0940 \u092a\u0902\u091c\u0940\u0915\u0930\u0923 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u092a\u0940\u0938\u0940\u092f\u0942 \u092e\u0947\u0902 \u0938\u0939\u093e\u092f\u0915 \u090f\u091c\u0940\u090f\u092e \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0930/\u0938\u092a\u094b\u0930\u094d\u091f \u092c\u0948\u091f\u0930\u0940 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u0928 \u0915\u094b \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_comfort_turn_signal:{name:"\u0915\u092e\u094d\u092b\u0930\u094d\u091f \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u092c\u094d\u0932\u093f\u0902\u0915 \u0915\u093e\u0909\u0902\u091f (\u0935\u0940\u090f\u091c\u0940)",desc:"3, 4, \u0914\u0930 5 \u092b\u094d\u0932\u0948\u0936 \u0915\u0947 \u092c\u0940\u091a \u0932\u0947\u0928 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092c\u094d\u0932\u093f\u0902\u0915\u0930 \u091a\u0915\u094d\u0930 \u0917\u0923\u0928\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_coming_home_duration:{name:"\u0918\u0930 \u0906\u0928\u0947/\u091b\u094b\u0921\u093c\u0928\u0947 \u0915\u0940 \u092a\u094d\u0930\u0915\u093e\u0936 \u0905\u0935\u0927\u093f (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0935\u093e\u0939\u0928 \u0932\u0949\u0915\u093f\u0902\u0917 (10s - 60s) \u0915\u0947 \u092c\u093e\u0926 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0930\u094b\u0936\u0928\u0940 \u091f\u093e\u0907\u092e\u0930 \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_remote_windows:{name:"\u0930\u093f\u092e\u094b\u091f \u0938\u0941\u0935\u093f\u0927\u093e \u0935\u093f\u0902\u0921\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0930\u093f\u092e\u094b\u091f \u0915\u0940 \u092b\u093c\u0949\u092c \u0932\u0949\u0928\u094d\u0917 \u092a\u094d\u0930\u0947\u0938 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u093e\u0935\u0930 \u0935\u093f\u0902\u0921\u094b \u0916\u094b\u0932\u0928\u0947 \u0914\u0930 \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964"},vag_auto_lock_15kmh:{name:"15 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u092a\u0930 \u0911\u091f\u094b \u0921\u094b\u0930 \u0932\u0949\u0915 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u091c\u092c \u0935\u093e\u0939\u0928 \u0915\u0940 \u0917\u0924\u093f 15 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u091c\u093e\u0924\u0940 \u0939\u0948 \u0924\u094b \u0938\u092d\u0940 \u0926\u0930\u0935\u093e\u091c\u0947 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},vag_sfd_unlock_prep:{name:"\u090f\u0938\u090f\u092b\u0921\u0940 \u0917\u0947\u091f\u0935\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u094d\u0925\u093f\u0924\u093f \u0924\u0948\u092f\u093e\u0930\u0940 (\u0935\u0940\u090f\u091c\u0940 2020+)",desc:"\u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 \u0921\u0940\u0906\u0908\u0921\u0940 \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u092e\u0915\u094d\u092f\u0942\u092c\u0940-\u0908\u0935\u094b \u090f\u0938\u090f\u092b\u0921\u0940 \u0917\u0947\u091f\u0935\u0947 \u091f\u094b\u0915\u0928 \u0938\u0924\u094d\u0930 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_asd_deactivate:{name:"\u0938\u0915\u094d\u0930\u093f\u092f \u0927\u094d\u0935\u0928\u093f \u0921\u093f\u091c\u093c\u093e\u0907\u0928 (\u090f\u090f\u0938\u0921\u0940) \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f\u0915\u0930\u0923 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0915\u0947\u092c\u093f\u0928 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092c\u091c\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u093f\u0902\u0925\u0947\u091f\u093f\u0915 \u0907\u0902\u091c\u0928 \u0927\u094d\u0935\u0928\u093f \u0915\u094b \u092e\u094d\u092f\u0942\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_comfort_turn_signal:{name:"\u0915\u092e\u094d\u092b\u0930\u094d\u091f \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u0915\u093e\u0909\u0902\u091f (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0935\u0928-\u091f\u091a \u0907\u0902\u0921\u093f\u0915\u0947\u091f\u0930 \u092a\u0932\u094d\u0938 \u0915\u093e\u0909\u0902\u091f (1 \u0938\u0947 5 \u092c\u094d\u0932\u093f\u0902\u0915) \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_mirror_fold_lock:{name:"\u0915\u092e\u094d\u092b\u0930\u094d\u091f \u090f\u0915\u094d\u0938\u0947\u0938 \u092e\u093f\u0930\u0930 \u092b\u094b\u0932\u094d\u0921 \u0911\u0928 \u0932\u0949\u0915 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0935\u093e\u0939\u0928 \u0932\u0949\u0915 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0924\u0941\u0930\u0902\u0924 \u0938\u093e\u0907\u0921 \u092e\u093f\u0930\u0930 \u0915\u094b \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092e\u094b\u0921\u093c \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},toyota_coming_home_duration:{name:"\u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0938\u094c\u091c\u0928\u094d\u092f \u0935\u093f\u0932\u0902\u092c / \u0915\u092e\u093f\u0902\u0917-\u0939\u094b\u092e (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0936\u091f\u0921\u093e\u0909\u0928 (30s-120s) \u0915\u0947 \u092c\u093e\u0926 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u092c\u0902\u0926 \u0935\u093f\u0932\u0902\u092c \u091f\u093e\u0907\u092e\u0930 \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_lane_change_flash:{name:"\u0932\u0947\u0928-\u091a\u0947\u0902\u091c \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u092b\u094d\u0932\u0948\u0936 \u0915\u093e\u0909\u0902\u091f (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u090f\u0915-\u0938\u094d\u092a\u0930\u094d\u0936 \u0932\u0947\u0928 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092c\u094d\u0932\u093f\u0902\u0915\u0930 \u091a\u0915\u094d\u0930 \u0917\u0923\u0928\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_remote_window_close:{name:"\u0930\u093f\u092e\u094b\u091f \u092a\u093e\u0935\u0930 \u0935\u093f\u0902\u0921\u094b \u0915\u094d\u0932\u094b\u091c\u0930 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0930\u093f\u092e\u094b\u091f \u0932\u0949\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u0915\u0930 \u0938\u092d\u0940 \u092a\u093e\u0935\u0930 \u0935\u093f\u0902\u0921\u094b \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},toyota_autolock_behavior:{name:"\u0911\u091f\u094b \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0932\u0949\u0915\u093f\u0902\u0917 \u091f\u094d\u0930\u093f\u0917\u0930 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948 (\u092a\u0940 \u092c\u0928\u093e\u092e \u0935\u093e\u0939\u0928 \u0915\u0940 \u0917\u0924\u093f> 20 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0938\u0947 \u092c\u093e\u0939\u0930 \u0936\u093f\u092b\u094d\u091f)\u0964"},toyota_approach_welcome_lights:{name:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u0926\u0943\u0937\u094d\u091f\u093f\u0915\u094b\u0923 \u0938\u094d\u0935\u093e\u0917\u0924 \u0930\u094b\u0936\u0928\u0940 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u091c\u092c \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u0935\u093e\u0939\u0928 \u0915\u0947 \u092a\u093e\u0938 \u092a\u0939\u0941\u0902\u091a\u0924\u0940 \u0939\u0948 \u0924\u094b \u0906\u0902\u0924\u0930\u093f\u0915 \u092a\u0941\u0921\u0932/\u0915\u0947\u092c\u093f\u0928 \u0932\u093e\u0907\u091f \u091a\u093e\u0932\u0942 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"},hyundai_autolock_behavior:{name:"\u0911\u091f\u094b \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 (\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906)",desc:"\u0936\u093f\u092b\u094d\u091f \u092f\u093e \u0917\u0924\u093f \u092a\u0930 \u0926\u0930\u0935\u093e\u091c\u0947 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092a\u0940 \u092f\u093e \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0911\u092b \u092a\u0930 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},hyundai_window_remote:{name:"\u0930\u093f\u092e\u094b\u091f \u0935\u093f\u0902\u0921\u094b \u0916\u094b\u0932\u0947\u0902/\u092c\u0902\u0926 \u0915\u0930\u0947\u0902 (\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906)",desc:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u094b\u092c \u092c\u091f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0935\u093f\u0902\u0921\u094b\u091c\u093c \u0915\u094b \u090a\u092a\u0930/\u0928\u0940\u091a\u0947 \u0930\u094b\u0932 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964"},hyundai_sport_mode_memory:{name:"\u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921 \u091a\u092f\u0928 \u092e\u0947\u092e\u094b\u0930\u0940 (\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906)",desc:"\u0907\u0902\u091c\u0928 \u092a\u0941\u0928\u0930\u093e\u0930\u0902\u092d \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0905\u0902\u0924\u093f\u092e \u091a\u092f\u0928\u093f\u0924 \u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921 (\u0938\u094d\u092a\u094b\u0930\u094d\u091f/\u0907\u0915\u094b) \u092f\u093e\u0926 \u0930\u0939\u0924\u093e \u0939\u0948\u0964"},tesla_charge_limit_custom:{name:"\u092c\u0948\u091f\u0930\u0940 \u091a\u093e\u0930\u094d\u091c \u0938\u0940\u092e\u093e \u0905\u0928\u0941\u0915\u0942\u0932\u0928 (\u091f\u0947\u0938\u094d\u0932\u093e)",desc:"\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u090f\u091a\u0935\u0940 \u092c\u0948\u091f\u0930\u0940 \u091a\u093e\u0930\u094d\u091c \u0938\u0940\u092e\u093e \u092a\u094d\u0930\u0924\u093f\u0936\u0924 (80% \u0926\u0948\u0928\u093f\u0915 / 100% \u091f\u094d\u0930\u093f\u092a) \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},tesla_mirror_fold_lock:{name:"\u0935\u0949\u0915-\u0905\u0935\u0947 \u0932\u0949\u0915 \u092a\u0930 \u092e\u093f\u0930\u0930 \u0911\u091f\u094b-\u092b\u094b\u0932\u094d\u0921 (\u091f\u0947\u0938\u094d\u0932\u093e)",desc:"\u092b\u093c\u094b\u0928 \u0915\u0940 \u0935\u0949\u0915-\u0905\u0935\u0947 \u0932\u0949\u0915 \u091f\u094d\u0930\u093f\u0917\u0930 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0938\u093e\u0907\u0921 \u092e\u093f\u0930\u0930 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092e\u0941\u0921\u093c \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},nissan_coming_home:{name:"\u0938\u094c\u091c\u0928\u094d\u092f \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0911\u092b \u0921\u093f\u0932\u0947 (\u0928\u093f\u0938\u093e\u0928)",desc:"\u0928\u093f\u0938\u093e\u0928 \u0935\u093e\u0939\u0928 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 30 \u0938\u0947\u0915\u0902\u0921 \u0924\u0915 \u0939\u0947\u0921\u0932\u093e\u0907\u091f\u094d\u0938 \u0915\u094b \u0930\u094b\u0936\u0928 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},nissan_lane_change_flash:{name:"\u091f\u0948\u092a-\u091f\u0942-\u092a\u093e\u0938 \u0932\u0947\u0928 \u091a\u0947\u0902\u091c \u092b\u094d\u0932\u0948\u0936 \u0915\u093e\u0909\u0902\u091f (\u0928\u093f\u0938\u093e\u0928)",desc:"\u0932\u093e\u0907\u091f \u0921\u0902\u0920\u0932 \u091f\u0948\u092a \u092a\u0930 \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u0907\u0902\u0921\u093f\u0915\u0947\u091f\u0930 \u092a\u0932\u094d\u0938 \u0915\u093e\u0909\u0902\u091f \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},nissan_autolock_behavior:{name:"\u0917\u0924\u093f-\u0928\u093f\u0930\u094d\u092d\u0930 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0932\u0949\u0915 (\u0928\u093f\u0938\u093e\u0928)",desc:"\u091c\u092c \u0935\u093e\u0939\u0928 24 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0924\u093e \u0939\u0948 \u0924\u094b \u0938\u092d\u0940 \u0926\u0930\u0935\u093e\u091c\u0947 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},nissan_window_remote:{name:"\u0930\u093f\u092e\u094b\u091f \u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u092a\u093e\u0935\u0930 \u0935\u093f\u0902\u0921\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 (\u0928\u093f\u0938\u093e\u0928)",desc:"\u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u0905\u0928\u0932\u0949\u0915 \u092c\u091f\u0928 \u0915\u094b \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0924\u0915 \u0926\u092c\u093e\u0928\u0947 \u0938\u0947 \u0938\u093e\u092e\u0928\u0947 \u0915\u0940 \u0916\u093f\u0921\u093c\u0915\u093f\u092f\u093e\u0902 \u0916\u0941\u0932\u0924\u0940/\u092c\u0902\u0926 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964"},nissan_seatbelt_chime_mute:{name:"\u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0911\u0921\u093f\u092f\u094b \u091a\u093e\u0907\u092e \u0938\u092a\u094d\u0930\u0947\u0938 (\u0928\u093f\u0938\u093e\u0928)",desc:"\u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0906\u0907\u0915\u0928 \u0930\u0916\u0924\u0947 \u0938\u092e\u092f \u092c\u093e\u0930-\u092c\u093e\u0930 \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0918\u0902\u091f\u0940 \u0915\u094b \u092e\u094d\u092f\u0942\u091f \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},porsche_sport_chrono_launch:{name:"\u0938\u094d\u092a\u094b\u0930\u094d\u091f \u0915\u094d\u0930\u094b\u0928\u094b \u0932\u0949\u0928\u094d\u091a \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0930\u093f\u0938\u094d\u092a\u093e\u0902\u0938 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 (\u092a\u094b\u0930\u094d\u0936)",desc:"\u092a\u0940\u0921\u0940\u0915\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0932\u0949\u0928\u094d\u091a \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0906\u0930\u092a\u0940\u090f\u092e \u0925\u094d\u0930\u0947\u0936\u094b\u0932\u094d\u0921 \u0914\u0930 \u0915\u094d\u0932\u091a \u092c\u093e\u0907\u091f \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},porsche_pasm_default:{name:"\u092a\u0940\u090f\u090f\u0938\u090f\u092e \u0938\u0938\u094d\u092a\u0947\u0902\u0936\u0928 \u092e\u094b\u0921 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0905\u092a \u092a\u094d\u0930\u0940\u0938\u0947\u091f (\u092a\u094b\u0930\u094d\u0936)",desc:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u092a\u0930 PASM \u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u0928\u093f\u0932\u0902\u092c\u0928 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0915\u0920\u094b\u0930\u0924\u093e \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},porsche_exhaust_flap:{name:"\u0938\u094d\u092a\u094b\u0930\u094d\u091f \u090f\u0917\u094d\u091c\u0949\u0938\u094d\u091f \u092b\u094d\u0932\u0948\u092a \u0915\u0949\u0928\u094d\u0938\u094d\u091f\u0947\u0902\u091f \u0913\u092a\u0928 \u0913\u0935\u0930\u0930\u093e\u0907\u0921 (\u092a\u094b\u0930\u094d\u0936)",desc:"\u0938\u092d\u0940 \u0906\u0930\u092a\u0940\u090f\u092e \u0930\u0947\u0902\u091c\u094b\u0902 \u092e\u0947\u0902 \u0938\u0915\u094d\u0930\u093f\u092f \u0928\u093f\u0915\u093e\u0938 \u0935\u093e\u0932\u094d\u0935\u094b\u0902 \u0915\u094b 100% \u0916\u0941\u0932\u093e \u0930\u0939\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0927\u094d\u092f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},audi_drive_select_memory:{name:"\u0911\u0921\u0940 \u0921\u094d\u0930\u093e\u0907\u0935 \u091a\u092f\u0928 \u092e\u094b\u0921 \u092e\u0947\u092e\u094b\u0930\u0940 \u0930\u093f\u091f\u0947\u0902\u0936\u0928 (\u0911\u0921\u0940)",desc:"\u092a\u0941\u0928\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0928\u0947 \u092a\u0930 \u0905\u0902\u0924\u093f\u092e \u0938\u0915\u094d\u0930\u093f\u092f \u0921\u094d\u0930\u093e\u0907\u0935 \u091a\u092f\u0928 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 (\u0921\u093e\u092f\u0928\u093e\u092e\u093f\u0915/\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924) \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},audi_virtual_cockpit_themes:{name:"\u0911\u0921\u0940 \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0915\u0949\u0915\u092a\u093f\u091f \u090f\u0938/\u0906\u0930\u090f\u0938 \u0938\u094d\u092a\u094b\u0930\u094d\u091f \u0917\u094d\u0930\u093e\u092b\u093f\u0915 \u0932\u0947\u0906\u0909\u091f (\u0911\u0921\u0940)",desc:"\u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0915\u0949\u0915\u092a\u093f\u091f \u092a\u0930 \u090f\u0938/\u0906\u0930\u090f\u0938 \u0938\u0947\u0902\u091f\u094d\u0930\u0932 \u091f\u0948\u0915\u094b\u092e\u0940\u091f\u0930 \u0932\u0947\u0906\u0909\u091f \u0935\u093f\u0915\u0932\u094d\u092a \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_scandinavian_drl:{name:"\u0938\u094d\u0915\u0948\u0902\u0921\u093f\u0928\u0947\u0935\u093f\u092f\u093e\u0908 \u0921\u0940\u0906\u0930\u090f\u0932 \u092e\u094b\u0921 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u092b\u094d\u0930\u0902\u091f \u0921\u0940\u0906\u0930\u090f\u0932 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0940\u091b\u0947 \u0915\u0940 \u091f\u0947\u0932 \u0932\u093e\u0907\u091f\u094d\u0938 \u0915\u094b \u0932\u0917\u093e\u0924\u093e\u0930 \u0930\u094b\u0936\u0928 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},vag_mirror_dip_reverse:{name:"\u092a\u0948\u0938\u0947\u0902\u091c\u0930 \u092e\u093f\u0930\u0930 \u0921\u093f\u092a \u0907\u0928 \u0930\u093f\u0935\u0930\u094d\u0938 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0930\u093f\u0935\u0930\u094d\u0938 \u0917\u093f\u092f\u0930 \u0932\u0917\u0947 \u0939\u094b\u0928\u0947 \u092a\u0930 \u092f\u093e\u0924\u094d\u0930\u0940 \u0938\u093e\u0907\u0921 \u0915\u0947 \u0936\u0940\u0936\u0947 \u0915\u094b \u0928\u0940\u091a\u0947 \u0915\u0940 \u0913\u0930 \u091d\u0941\u0915\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},vag_dynamic_turn_signal:{name:"\u0917\u0924\u093f\u0936\u0940\u0932/\u0905\u0928\u0941\u0915\u094d\u0930\u092e\u093f\u0915 \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u092e\u094b\u0921 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0938\u0902\u0917\u0924 \u0930\u093f\u092f\u0930 \u0932\u093e\u0907\u091f \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u092a\u0930 \u0935\u094d\u092f\u093e\u092a\u0915 \u0917\u0924\u093f\u0936\u0940\u0932 \u090f\u0932\u0908\u0921\u0940 \u092c\u094d\u0932\u093f\u0902\u0915\u0930 \u092a\u0948\u091f\u0930\u094d\u0928 \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_seatbelt_warning_duration:{name:"\u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091d\u0902\u0915\u093e\u0930 \u0905\u0935\u0927\u093f \u0938\u092e\u093e\u092f\u094b\u091c\u0928 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u092c\u093e\u0930-\u092c\u093e\u0930 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091d\u0902\u0915\u093e\u0930 \u091f\u093e\u0907\u092e\u0930 \u0915\u094b \u091b\u094b\u091f\u093e \u092f\u093e \u0926\u092c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},vag_sunroof_remote:{name:"\u0938\u0928\u0930\u0942\u092b \u0930\u093f\u092e\u094b\u091f \u0915\u092e\u094d\u092b\u0930\u094d\u091f \u0915\u0902\u091f\u094d\u0930\u094b\u0932 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0930\u093f\u092e\u094b\u091f \u0915\u0940 \u092b\u093c\u0949\u092c \u0939\u094b\u0932\u094d\u0921 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u0948\u0928\u094b\u0930\u092e\u093f\u0915 \u0938\u0928\u0930\u0942\u092b \u0915\u094b \u0916\u094b\u0932\u0928\u0947 \u0914\u0930 \u091d\u0941\u0915\u093e\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},vag_acc_distance_preset:{name:"\u090f\u0938\u0940\u0938\u0940 \u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u0915\u094d\u0930\u0942\u091c \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0905\u0928\u0941\u0935\u0930\u094d\u0924\u0940 \u0926\u0942\u0930\u0940 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u092a\u0930 \u0926\u0942\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0930\u0921\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_infotainment_startup_logo:{name:"\u0907\u0928\u094d\u092b\u094b\u091f\u0947\u0928\u092e\u0947\u0902\u091f \u092c\u0942\u091f \u0917\u094d\u0930\u093e\u092b\u093f\u0915 \u0932\u094b\u0917\u094b (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0907\u0928\u094d\u092b\u094b\u091f\u0947\u0928\u092e\u0947\u0902\u091f \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0905\u092a \u0938\u094d\u092a\u094d\u0932\u0948\u0936 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0932\u094b\u0917\u094b (\u0906\u0930-\u0932\u093e\u0907\u0928, \u091c\u0940\u091f\u0940\u0906\u0908, \u0906\u0930\u090f\u0938) \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_ambient_color_cycle:{name:"\u0907\u0902\u091f\u0940\u0930\u093f\u092f\u0930 \u090f\u092e\u094d\u092c\u093f\u090f\u0902\u091f \u0932\u093e\u0907\u091f \u0915\u0932\u0930 \u0938\u094d\u092a\u0947\u0915\u094d\u091f\u094d\u0930\u092e \u0905\u0928\u0932\u0949\u0915 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0935\u093e\u0939\u0928 \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0928\u0942 \u092e\u0947\u0902 \u092a\u0930\u093f\u0935\u0947\u0936 \u092a\u094d\u0930\u0915\u093e\u0936 \u092a\u0948\u0932\u0947\u091f \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u0915\u093e \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_service_interval_custom:{name:"\u0915\u0938\u094d\u091f\u092e \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u090f\u0935\u0902 \u0938\u0947\u0935\u093e \u0926\u0942\u0930\u0940 \u0938\u0940\u092e\u093e (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0905\u0917\u0932\u0940 \u0938\u0947\u0935\u093e \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0915\u0947 \u0932\u093f\u090f \u0915\u0938\u094d\u091f\u092e \u0915\u093f\u092e\u0940 \u0914\u0930 \u0926\u093f\u0928 \u0915\u0947 \u0932\u0915\u094d\u0937\u094d\u092f \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_door_handle_lights_reverse:{name:"\u092c\u093e\u0939\u0930\u0940 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0947 \u0939\u0948\u0902\u0921\u0932 \u0915\u0940 \u0932\u093e\u0907\u091f\u0947\u0902 \u0930\u093f\u0935\u0930\u094d\u0938 \u092e\u0947\u0902 \u091a\u093e\u0932\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902 (VAG)",desc:"\u091c\u092e\u0940\u0928 \u092a\u0930 \u0926\u0943\u0936\u094d\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u0940\u091b\u0947 \u092e\u0941\u0921\u093c\u0928\u0947 \u092a\u0930 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0947 \u0939\u0948\u0902\u0921\u0932 \u090f\u0932\u0908\u0921\u0940 \u092a\u094b\u0916\u0930 \u0930\u094b\u0936\u0928\u0940 \u0915\u094b \u0930\u094b\u0936\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_msport_exhaust_burble:{name:"\u090f\u092e-\u0938\u094d\u092a\u094b\u0930\u094d\u091f \u090f\u0917\u094d\u091c\u0949\u0938\u094d\u091f \u092c\u0930\u094d\u092c\u0932 \u0914\u0930 \u092a\u0949\u092a \u0907\u0902\u091f\u0947\u0902\u0938\u093f\u091f\u0940 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0938\u094d\u092a\u094b\u0930\u094d\u091f \u092e\u094b\u0921 \u092e\u0947\u0902 \u0913\u0935\u0930\u0930\u0928 \u092c\u0930\u094d\u092c\u0932 \u0927\u094d\u0935\u0928\u093f \u0915\u0940 \u0906\u0915\u094d\u0930\u093e\u092e\u0915\u0924\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_welcome_light_sequence:{name:"\u0935\u0947\u0932\u0915\u092e \u0932\u093e\u0907\u091f \u0938\u0940\u0915\u094d\u0935\u0947\u0902\u0938 \u090f\u0928\u093f\u092e\u0947\u0936\u0928 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u090f\u0932\u0908\u0921\u0940 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0914\u0930 \u090f\u0902\u091c\u0947\u0932 \u0906\u0907\u091c\u093c \u0915\u0947 \u0938\u094d\u0935\u093e\u0917\u0924 \u0905\u092d\u093f\u0935\u093e\u0926\u0928 \u0915\u094d\u0930\u092e \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_service_history_menu:{name:"\u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u0947\u0935\u093e \u0907\u0924\u093f\u0939\u093e\u0938 \u092e\u0947\u0928\u0942 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0938\u0947\u0902\u091f\u094d\u0930\u0932 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092a\u0930 \u0906\u0908\u0921\u094d\u0930\u093e\u0907\u0935 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u0930\u094d\u0935\u093f\u0938 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092c\u0941\u0915 \u092e\u0947\u0928\u0942 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_hud_speed_display:{name:"\u0939\u0947\u0921-\u0905\u092a \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u092a\u0940\u0921\u094b\u092e\u0940\u091f\u0930 \u0913\u0935\u0930\u0932\u0947 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0939\u0947\u0921-\u0905\u092a \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092a\u0930 \u0930\u0940\u092f\u0932-\u091f\u093e\u0907\u092e \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u092a\u0940\u0921 \u0930\u0940\u0921\u0906\u0909\u091f \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_cornering_lights_fog:{name:"\u092b\u0949\u0917 \u0932\u0948\u0902\u092a \u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u0907\u0932\u094d\u092f\u0942\u092e\u093f\u0928\u0947\u0936\u0928 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u092f\u093e \u0932\u094b-\u0938\u094d\u092a\u0940\u0921 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u090f\u0902\u0917\u0932 \u092a\u0930 \u092b\u094d\u0930\u0902\u091f \u092b\u0949\u0917 \u0932\u093e\u0907\u091f \u091a\u093e\u0932\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_easy_entry_steering:{name:"\u0906\u0938\u093e\u0928 \u092a\u094d\u0930\u0935\u0947\u0936 \u0911\u091f\u094b-\u0930\u093f\u091f\u094d\u0930\u0948\u0915\u094d\u091f\u093f\u0902\u0917 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0915\u0949\u0932\u092e (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0906\u0938\u093e\u0928 \u0928\u093f\u0915\u093e\u0938 \u0915\u0947 \u0932\u093f\u090f \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0935\u094d\u0939\u0940\u0932 \u0915\u094b \u090a\u092a\u0930 \u0915\u0940 \u0913\u0930 \u0916\u0940\u0902\u091a\u0924\u093e \u0939\u0948\u0964"},bmw_bluetooth_audio_enable:{name:"\u0909\u0928\u094d\u0928\u0924 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0911\u0921\u093f\u092f\u094b \u0938\u094d\u091f\u094d\u0930\u0940\u092e\u093f\u0902\u0917 \u0905\u0928\u0932\u0949\u0915 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"iDrive HU_ENTRYNAV \u092e\u0947\u0902 A2DP \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0935\u093e\u092f\u0930\u0932\u0947\u0938 \u0938\u0902\u0917\u0940\u0924 \u0938\u094d\u091f\u094d\u0930\u0940\u092e\u093f\u0902\u0917 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_door_handle_lights_reverse:{name:"\u092c\u093e\u0939\u0930\u0940 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0947 \u0939\u0948\u0902\u0921\u0932 \u092a\u0941\u0921\u0932 \u0932\u093e\u0907\u091f\u094d\u0938 \u0930\u093f\u0935\u0930\u094d\u0938 \u092e\u0947\u0902 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0930\u093f\u0935\u0930\u094d\u0938 \u0917\u093f\u092f\u0930 \u0932\u0917\u0947 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0947 \u0939\u0948\u0902\u0921\u0932 \u090f\u0932\u0908\u0921\u0940 \u0915\u094b \u0930\u094b\u0936\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_auto_headlight_threshold:{name:"\u0911\u091f\u094b \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u090f\u092e\u094d\u092c\u093f\u090f\u0902\u091f \u0932\u093e\u0907\u091f \u0938\u0947\u0902\u0938\u0930 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0938\u0915\u094d\u0930\u093f\u092f\u0923 \u0915\u0947 \u0932\u093f\u090f \u0917\u094b\u0927\u0942\u0932\u093f \u0938\u0902\u0927\u094d\u092f\u093e \u0938\u0940\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_turn_signal_click_volume:{name:"\u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u0911\u0921\u093f\u092f\u094b \u0915\u094d\u0932\u093f\u0915\u0930 \u0938\u094d\u092a\u0940\u0915\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u0930\u093f\u0932\u0947 \u0915\u094d\u0932\u093f\u0915 \u091a\u093e\u0907\u092e \u0935\u0949\u0932\u094d\u092f\u0942\u092e (\u0928\u093f\u092e\u094d\u0928, \u092e\u0927\u094d\u092f\u092e, \u0909\u091a\u094d\u091a) \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_smart_key_approach_lights:{name:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u092a\u094d\u0930\u0949\u0915\u094d\u0938\u093f\u092e\u093f\u091f\u0940 \u0935\u0947\u0932\u0915\u092e \u092a\u0941\u0921\u0932 \u0932\u093e\u0907\u091f\u094d\u0938 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u091c\u092c \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u0935\u093e\u0939\u0928 \u0915\u0947 \u092a\u093e\u0938 \u0906\u0924\u0940 \u0939\u0948 \u0924\u094b \u0926\u0930\u094d\u092a\u0923 \u092a\u0941\u0921\u0932 \u0932\u093e\u0907\u091f \u091a\u093e\u0932\u0942 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"},toyota_rear_hatch_behavior:{name:"\u092a\u093e\u0935\u0930 \u091f\u0947\u0932\u0917\u0947\u091f \u0932\u093f\u092b\u094d\u091f\u0917\u0947\u091f \u0913\u092a\u0928/\u0915\u094d\u0932\u094b\u091c\u093c \u0911\u092a\u0930\u0947\u0936\u0928 \u0932\u0949\u091c\u093f\u0915 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0930\u093f\u092e\u094b\u091f \u0914\u0930 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092a\u093e\u0935\u0930 \u0939\u0948\u091a \u092c\u091f\u0928 \u092a\u094d\u0930\u0947\u0938 \u0905\u0935\u0927\u093f \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_open_windows_smart_key:{name:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u0930\u093f\u092e\u094b\u091f \u0935\u093f\u0902\u0921\u094b \u0930\u094b\u0932-\u0921\u093e\u0909\u0928 \u0932\u0949\u0928\u094d\u0917 \u092a\u094d\u0930\u0947\u0938 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0930\u093f\u092e\u094b\u091f \u0905\u0928\u0932\u0949\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u0915\u0930 \u0938\u092d\u0940 \u0935\u093f\u0902\u0921\u094b \u0916\u094b\u0932\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},toyota_interior_light_dim_timer:{name:"\u0906\u0902\u0924\u0930\u093f\u0915 \u0915\u0947\u092c\u093f\u0928 \u0932\u093e\u0907\u091f \u0911\u091f\u094b-\u0921\u093f\u092e\u093f\u0902\u0917 \u0911\u092b \u0921\u093f\u0932\u0947 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0926\u0930\u0935\u093e\u091c\u093e \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0906\u0902\u0924\u0930\u093f\u0915 \u0917\u0941\u0902\u092c\u0926 \u0932\u093e\u0907\u091f \u0936\u091f\u0921\u093e\u0909\u0928 \u091f\u093e\u0907\u092e\u0930 \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_panic_alarm_remote:{name:"\u0930\u093f\u092e\u094b\u091f \u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u092a\u0948\u0928\u093f\u0915 \u0905\u0932\u093e\u0930\u094d\u092e \u0938\u093e\u092f\u0930\u0928 \u092b\u093c\u0902\u0915\u094d\u0936\u0928 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0930\u093f\u092e\u094b\u091f \u0915\u0940 \u0939\u094b\u0932\u094d\u0921 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0935\u093e\u0939\u0928 \u0939\u0949\u0930\u094d\u0928 \u092a\u0948\u0928\u093f\u0915 \u0905\u0932\u093e\u0930\u094d\u092e \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u092f\u093e \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_eco_drive_indicator:{name:"\u0908\u0938\u0940\u0913 \u0921\u094d\u0930\u093e\u0907\u0935 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u091c\u094b\u0928 \u0938\u0902\u0915\u0947\u0924\u0915 \u0932\u093e\u0907\u091f (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092a\u0930 \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923-\u0905\u0928\u0941\u0915\u0942\u0932 \u090f\u0915\u094d\u0938\u0947\u0932\u0947\u0930\u0947\u0936\u0928 \u092c\u093e\u0930 \u0914\u0930 \u0938\u0902\u0915\u0947\u0924\u0915 \u0932\u093e\u0907\u091f \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964"},hyundai_coming_home_duration:{name:"\u090f\u0938\u094d\u0915\u0949\u0930\u094d\u091f \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u092c\u0902\u0926 \u0935\u093f\u0932\u0902\u092c \u091f\u093e\u0907\u092e\u0930 (\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906)",desc:"\u0935\u093e\u0939\u0928 \u0915\u0947 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0932\u094b \u092c\u0940\u092e \u0939\u0947\u0921\u0932\u093e\u0907\u091f\u094d\u0938 \u0915\u094b \u0930\u094b\u0936\u0928 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},hyundai_drl_menu_toggle:{name:"\u0926\u093f\u0928 \u0915\u0947 \u0938\u092e\u092f \u091a\u0932\u0928\u0947 \u0935\u093e\u0932\u0940 \u0932\u093e\u0907\u091f\u0947\u0902 \u092e\u0947\u0928\u0942 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 (\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906)",desc:"\u0909\u092a\u0915\u0930\u0923 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u092e\u0947\u0902 \u0921\u0940\u0906\u0930\u090f\u0932 \u091a\u093e\u0932\u0942/\u092c\u0902\u0926 \u0938\u0947\u091f\u093f\u0902\u0917 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"},hyundai_welcome_sequence:{name:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0941\u0902\u091c\u0940 \u092a\u094d\u0930\u0949\u0915\u094d\u0938\u093f\u092e\u093f\u091f\u0940 \u0935\u0947\u0932\u0915\u092e \u0932\u093e\u0907\u091f \u0914\u0930 \u092e\u093f\u0930\u0930 \u0905\u0928\u092b\u094b\u0932\u094d\u0921 (\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906)",desc:"\u092a\u093e\u0938 \u0906\u0928\u0947 \u092a\u0930 \u092c\u093f\u091c\u0932\u0940 \u0915\u0947 \u0926\u0930\u094d\u092a\u0923 \u0916\u094b\u0932 \u0926\u0947\u0924\u093e \u0939\u0948 \u0914\u0930 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0947 \u0939\u0948\u0902\u0921\u0932 \u0915\u094b \u0930\u094b\u0936\u0928 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},hyundai_interior_light_delay:{name:"\u0915\u0947\u092c\u093f\u0928 \u0907\u0902\u091f\u0940\u0930\u093f\u092f\u0930 \u0930\u0942\u092e \u0932\u0948\u0902\u092a \u0911\u091f\u094b-\u0915\u091f \u0921\u093f\u0932\u0947 (\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906)",desc:"\u092c\u0948\u091f\u0930\u0940 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0902\u0924\u0930\u093f\u0915 \u0932\u093e\u0907\u091f\u0947\u0902 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u091f\u093e\u0907\u092e\u0930 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},hyundai_heat_pump_efficiency:{name:"\u0908\u0935\u0940 \u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f \u0939\u0940\u091f \u092a\u0902\u092a \u0925\u0930\u094d\u092e\u0932 \u0926\u0915\u094d\u0937\u0924\u093e \u092e\u094b\u0921 (\u0939\u0941\u0902\u0921\u0908/\u0915\u093f\u0906)",desc:"\u0920\u0902\u0921 \u0915\u0947 \u092e\u094c\u0938\u092e \u092e\u0947\u0902 \u0908\u0935\u0940 \u0939\u0940\u091f \u092a\u0902\u092a \u090a\u0930\u094d\u091c\u093e \u0916\u092a\u0924 \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},tesla_track_mode_params:{name:"\u091f\u094d\u0930\u0948\u0915 \u092e\u094b\u0921 \u0938\u094d\u0925\u093f\u0930\u0924\u093e \u0914\u0930 \u091f\u0949\u0930\u094d\u0915 \u092c\u093e\u092f\u0938 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 (\u091f\u0947\u0938\u094d\u0932\u093e)",desc:"\u092b\u094d\u0930\u0902\u091f/\u0930\u093f\u092f\u0930 \u092e\u094b\u091f\u0930 \u0921\u094d\u0930\u093e\u0907\u0935 \u092a\u0942\u0930\u094d\u0935\u093e\u0917\u094d\u0930\u0939 \u0914\u0930 \u0938\u094d\u0925\u093f\u0930\u0924\u093e \u0939\u0938\u094d\u0924\u0915\u094d\u0937\u0947\u092a \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},tesla_regen_brake_strength:{name:"\u092a\u0941\u0928\u0930\u094d\u092f\u094b\u091c\u0940 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u092a\u093e\u0935\u0930 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 (\u091f\u0947\u0938\u094d\u0932\u093e)",desc:"\u0924\u094d\u0935\u0930\u0915 \u092a\u0947\u0921\u0932 \u0932\u093f\u092b\u094d\u091f-\u0911\u092b \u090a\u0930\u094d\u091c\u093e \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0924\u0940\u0935\u094d\u0930\u0924\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},tesla_walkaway_door_lock:{name:"\u0935\u0949\u0915-\u0905\u0935\u0947 \u092b\u093c\u094b\u0928 \u0915\u0941\u0902\u091c\u0940 \u0911\u091f\u094b \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0932\u0949\u0915 (\u091f\u0947\u0938\u094d\u0932\u093e)",desc:"\u0926\u0930\u0935\u093e\u091c\u0947 \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948 \u0914\u0930 \u092b\u094b\u0928 \u0915\u0940 \u091a\u093e\u092c\u0940 \u0926\u0942\u0930 \u091c\u093e\u0928\u0947 \u092a\u0930 \u0939\u0949\u0930\u094d\u0928 \u092c\u091c\u093e\u0915\u0930 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},tesla_acceleration_boost_unlock:{name:"\u092a\u0949\u0935\u0930\u091f\u094d\u0930\u0947\u0928 \u090f\u0915\u094d\u0938\u0947\u0932\u0947\u0930\u0947\u0936\u0928 \u092c\u0942\u0938\u094d\u091f \u0921\u094d\u0930\u093e\u0907\u0935 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 (\u091f\u0947\u0938\u094d\u0932\u093e)",desc:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u092e\u094b\u091f\u0930 \u0907\u0928\u094d\u0935\u0930\u094d\u091f\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b 0-100 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0915\u0940 \u0917\u0924\u093f \u0938\u0947 \u0924\u0947\u091c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},tesla_interior_ambient_color:{name:"\u0915\u0947\u092c\u093f\u0928 \u092b\u0941\u091f\u0935\u0947\u0932 \u090f\u092e\u094d\u092c\u093f\u090f\u0902\u091f \u0932\u093e\u0907\u091f\u093f\u0902\u0917 \u0915\u0932\u0930 \u092a\u094d\u0930\u0940\u0938\u0947\u091f (\u091f\u0947\u0938\u094d\u0932\u093e)",desc:"\u090f\u0932\u0908\u0921\u0940 \u092b\u0941\u091f\u0935\u0947\u0932 \u092a\u0930\u093f\u0935\u0947\u0936 \u092a\u094d\u0930\u0915\u093e\u0936 \u0906\u0930\u091c\u0940\u092c\u0940 \u0930\u0902\u0917 \u092a\u0948\u0932\u0947\u091f \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},audi_matrix_led_animation:{name:"\u092e\u0948\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u090f\u0932\u0908\u0921\u0940 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0921\u093e\u092f\u0928\u093e\u092e\u093f\u0915 \u0935\u0947\u0932\u0915\u092e \u0932\u093e\u0907\u091f \u0921\u093e\u0902\u0938 (\u0911\u0921\u0940)",desc:"\u0935\u093e\u0939\u0928 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0917\u0924\u093f\u0936\u0940\u0932 \u092a\u094d\u0930\u0915\u093e\u0936 \u0915\u094b\u0930\u093f\u092f\u094b\u0917\u094d\u0930\u093e\u092b\u0940 \u092c\u091c\u093e\u0924\u093e \u0939\u0948\u0964"},audi_mmi_startup_screen:{name:"\u090f\u092e\u090f\u092e\u0906\u0908 \u091f\u091a \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092c\u0942\u091f \u0917\u094d\u0930\u093e\u092b\u093c\u093f\u0915 \u0925\u0940\u092e (\u0911\u0921\u0940)",desc:"\u090f\u092e\u090f\u092e\u0906\u0908 \u0938\u0947\u0902\u091f\u094d\u0930\u0932 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092c\u0942\u091f \u090f\u0928\u0940\u092e\u0947\u0936\u0928 (\u090f\u0938/\u0906\u0930\u090f\u0938/\u0908-\u091f\u094d\u0930\u0949\u0928) \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},audi_drive_select_efficiency:{name:"\u0911\u0921\u0940 \u0921\u094d\u0930\u093e\u0907\u0935 \u0938\u0947\u0932\u0947\u0915\u094d\u091f (\u0911\u0921\u0940) \u092e\u0947\u0902 \u0926\u0915\u094d\u0937\u0924\u093e \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932",desc:"\u0921\u094d\u0930\u093e\u0907\u0935 \u091a\u092f\u0928 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u092e\u0947\u0902 \u0908\u0902\u0927\u0928-\u092c\u091a\u0924 \u0926\u0915\u094d\u0937\u0924\u093e \u092e\u094b\u0921 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},audi_laptimer_boost_display:{name:"\u0932\u0948\u092a \u091f\u093e\u0907\u092e\u0930 \u0914\u0930 \u091f\u0930\u094d\u092c\u094b \u092c\u093e\u0930 \u092a\u094d\u0930\u0947\u0936\u0930 \u0917\u0947\u091c \u0913\u0935\u0930\u0932\u0947 (\u0911\u0921\u0940)",desc:"\u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0915\u0949\u0915\u092a\u093f\u091f \u092a\u0930 \u091f\u094d\u0930\u0948\u0915 \u0932\u0948\u092a \u091f\u093e\u0907\u092e\u0930 \u0914\u0930 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u091f\u0930\u094d\u092c\u094b \u092c\u0942\u0938\u094d\u091f \u0917\u0947\u091c \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},audi_needle_sweep_gauge:{name:"\u0938\u094d\u092a\u094b\u0930\u094d\u091f \u0917\u0947\u091c \u0938\u0941\u0908 \u0938\u094d\u0935\u0940\u092a \u0938\u0924\u094d\u092f\u093e\u092a\u0928 (\u0911\u0921\u0940)",desc:"\u092a\u094d\u0930\u093e\u0930\u0902\u092d \u092e\u0947\u0902 \u092a\u0942\u0930\u094d\u0923 \u091f\u0948\u0915\u094b\u092e\u0940\u091f\u0930 \u0914\u0930 \u0938\u094d\u092a\u0940\u0921\u094b\u092e\u0940\u091f\u0930 \u0938\u0941\u0908 \u0938\u094d\u0935\u0940\u092a \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},skoda_coming_home_lights:{name:"\u0918\u0930 \u091b\u094b\u0921\u093c\u0928\u093e/\u0918\u0930 \u0906\u0928\u093e \u0932\u093e\u0907\u091f\u093f\u0902\u0917 \u091f\u093e\u0907\u092e\u0930 (\u0938\u094d\u0915\u094b\u0921\u093e)",desc:"\u0935\u093e\u0939\u0928 \u0915\u0947 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0930\u094b\u0936\u0928\u0940 \u091f\u093e\u0907\u092e\u0930 \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},skoda_comfort_turn_signal:{name:"\u0915\u092e\u094d\u092b\u0930\u094d\u091f \u0907\u0902\u0921\u093f\u0915\u0947\u091f\u0930 \u092a\u0932\u094d\u0938 \u0915\u093e\u0909\u0902\u091f \u090f\u0921\u091c\u0938\u094d\u091f\u092e\u0947\u0902\u091f (\u0938\u094d\u0915\u094b\u0921\u093e)",desc:"3 \u0914\u0930 5 \u092b\u094d\u0932\u0948\u0936 \u0915\u0947 \u092c\u0940\u091a \u0935\u0928-\u091f\u091a \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u092c\u094d\u0932\u093f\u0902\u0915 \u0915\u093e\u0909\u0902\u091f \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},cupra_sport_display_menu:{name:"\u0915\u092a\u0930\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0909\u092a\u0915\u0930\u0923 \u0914\u0930 \u091c\u0940-\u092e\u0940\u091f\u0930 \u092e\u0947\u0928\u0942 (\u0915\u094d\u092f\u0942\u092a\u094d\u0930\u093e)",desc:"\u091c\u0940-\u092b\u094b\u0930\u094d\u0938 \u092e\u0940\u091f\u0930, \u0915\u093f\u0932\u094b\u0935\u093e\u091f \u092a\u093e\u0935\u0930 \u0917\u0947\u091c \u0914\u0930 \u0924\u0947\u0932 \u0924\u093e\u092a\u092e\u093e\u0928 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},cupra_virtual_cockpit_copper:{name:"\u0915\u0949\u092a\u0930 \u0925\u0940\u092e \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u090f\u0915\u094d\u0938\u0947\u0902\u091f \u0917\u094d\u0930\u093e\u092b\u093c\u093f\u0915\u094d\u0938 (\u0915\u092a\u094d\u0930\u093e)",desc:"\u0917\u0947\u091c \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092a\u0930 \u0938\u093f\u0917\u094d\u0928\u0947\u091a\u0930 \u0915\u092a\u0930\u093e \u0915\u0949\u092a\u0930 \u092e\u0947\u091f\u093e\u0932\u093f\u0915 \u090f\u0915\u094d\u0938\u0947\u0902\u091f \u0925\u0940\u092e \u0932\u093e\u0917\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_brake_disc_drying:{name:"\u092c\u093e\u0930\u093f\u0936 \u092e\u0947\u0902 \u092c\u094d\u0930\u0947\u0915 \u0921\u093f\u0938\u094d\u0915 \u0915\u094b \u092a\u094b\u0902\u091b\u0928\u0947/\u0938\u0941\u0916\u093e\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u094d\u092f (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0938\u0942\u0916\u0947 \u0930\u094b\u091f\u0930\u094d\u0938 \u092a\u0930 \u0917\u0940\u0932\u0947 \u092e\u094c\u0938\u092e \u092e\u0947\u0902 \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0948\u0921 \u0926\u092c\u093e\u0935 \u0932\u093e\u0917\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_tourist_mode_lights:{name:"\u092a\u0930\u094d\u092f\u091f\u0915 \u092e\u094b\u0921 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u092c\u0940\u092e \u092a\u0948\u091f\u0930\u094d\u0928 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0935\u093f\u0926\u0947\u0936 \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u092c\u0940\u092e \u092a\u0948\u091f\u0930\u094d\u0928 \u0915\u094b \u090f\u0932\u090f\u091a\u0921\u0940 \u0914\u0930 \u0906\u0930\u090f\u091a\u0921\u0940 \u0915\u0947 \u092c\u0940\u091a \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_hood_warning_mute:{name:"\u092c\u094b\u0928\u091f \u0913\u092a\u0928 \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u091a\u093e\u0907\u092e \u092e\u094d\u092f\u0942\u091f (\u0935\u0940\u090f\u091c\u0940)",desc:"\u091c\u092c \u0939\u0941\u0921 \u0916\u094b\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0924\u094b \u0932\u0917\u093e\u0924\u093e\u0930 \u0909\u092a\u0915\u0930\u0923 \u0915\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091d\u0902\u0915\u093e\u0930 \u0915\u094b \u0926\u092c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},vag_emergency_brake_hazard:{name:"\u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0916\u0924\u0930\u093e \u092b\u094d\u0932\u0948\u0936\u0930 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0915\u0920\u094b\u0930 \u090f\u092c\u0940\u090f\u0938 \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u094d\u091f\u0949\u092a \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0916\u0924\u0930\u0928\u093e\u0915 \u0932\u093e\u0907\u091f\u0947\u0902 \u0924\u0947\u091c\u0940 \u0938\u0947 \u091a\u092e\u0915\u0924\u0940 \u0939\u0948\u0902\u0964"},vag_sunroof_comfort_open:{name:"\u0938\u0928\u0930\u0942\u092b \u091f\u093f\u0932\u094d\u091f / \u0913\u092a\u0928 \u0930\u093f\u092e\u094b\u091f \u0915\u092e\u094d\u092b\u0930\u094d\u091f \u0915\u0940 \u092b\u094b\u092c \u0932\u0949\u091c\u093f\u0915 (\u0935\u0940\u090f\u091c\u0940)",desc:"\u0938\u0928\u0930\u0942\u092b \u0915\u094b \u091d\u0941\u0915\u093e\u0928\u0947 \u092f\u093e \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u092e\u094b\u091f \u0915\u0940 \u0939\u094b\u0932\u094d\u0921 \u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_ecopro_display_variant:{name:"\u0908\u0938\u0940\u0913 \u092a\u094d\u0930\u094b \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0917\u0947\u091c \u0938\u094d\u091f\u093e\u0907\u0932\u093f\u0902\u0917 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0928\u0940\u0932\u0947 \u0908\u0938\u0940\u0913 \u092a\u094d\u0930\u094b \u0926\u0915\u094d\u0937\u0924\u093e \u0917\u0947\u091c \u0917\u094d\u0930\u093e\u092b\u093f\u0915 \u0925\u0940\u092e \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_volume_bar_hud:{name:"\u0939\u0947\u0921-\u0905\u092a \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0911\u0921\u093f\u092f\u094b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0932\u0947\u0935\u0932 \u092c\u093e\u0930 \u0913\u0935\u0930\u0932\u0947 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0938\u0940\u0927\u0947 HUD \u092a\u094d\u0930\u0915\u094d\u0937\u0947\u092a\u0923 \u092a\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092c\u093e\u0930 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964"},bmw_anti_dazzle_mirror:{name:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u094b\u0915\u094d\u0930\u094b\u092e\u093f\u0915 \u090f\u0902\u091f\u0940-\u0921\u0948\u091c\u093c\u0932 \u092e\u093f\u0930\u0930 \u0921\u093f\u092e\u093f\u0902\u0917 \u0938\u0947\u0902\u0938\u093f\u091f\u093f\u0935\u093f\u091f\u0940 (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u093f\u092f\u0930\u0935\u094d\u092f\u0942 \u092e\u093f\u0930\u0930 \u0921\u093f\u092e\u093f\u0902\u0917 \u092b\u094b\u091f\u094b-\u0938\u0947\u0902\u0938\u0930 \u0925\u094d\u0930\u0947\u0936\u094b\u0932\u094d\u0921 \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_camera_pdc_warning_mute:{name:"\u092a\u0940\u0921\u0940\u0938\u0940 \u0914\u0930 \u0938\u0930\u093e\u0909\u0902\u0921 \u0935\u094d\u092f\u0942 \u0938\u094d\u092a\u0940\u0921 \u0915\u091f-\u0911\u092b \u0938\u094d\u092a\u0940\u0921 \u090f\u0921\u091c\u0938\u094d\u091f\u092e\u0947\u0902\u091f (\u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942)",desc:"\u0935\u093e\u0939\u0928 \u0915\u0940 \u0917\u0924\u093f \u0938\u0940\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u093f\u0938 \u092a\u0930 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0915\u0948\u092e\u0930\u0947 \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},toyota_pcs_distance_preset:{name:"\u092a\u0942\u0930\u094d\u0935-\u091f\u0915\u0930\u093e\u0935 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 (\u092a\u0940\u0938\u0940\u090f\u0938) \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0942\u0930\u0940 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u0930\u0921\u093e\u0930 \u0906\u0917\u0947 \u091f\u0915\u0930\u093e\u0935 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0942\u0930\u0940 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_bsm_timing:{name:"\u092c\u094d\u0932\u093e\u0907\u0902\u0921 \u0938\u094d\u092a\u0949\u091f \u092e\u0949\u0928\u093f\u091f\u0930 (\u092c\u0940\u090f\u0938\u090f\u092e) \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0938\u092e\u092f (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u092c\u094d\u0932\u093e\u0907\u0902\u0921 \u0938\u094d\u092a\u0949\u091f \u0938\u093e\u0907\u0921 \u092e\u093f\u0930\u0930 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092a\u094d\u0930\u0915\u093e\u0936 \u0930\u094b\u0936\u0928\u0940 \u0938\u092e\u092f \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_ac_noise_reduction:{name:"\u090f/\u0938\u0940 \u0915\u0902\u092a\u094d\u0930\u0947\u0938\u0930 \u092c\u094d\u0932\u094b\u0905\u0930 \u0936\u094b\u0930 \u0915\u091f\u094c\u0924\u0940 \u092e\u094b\u0921 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0915\u0947\u092c\u093f\u0928 \u0915\u0940 \u0936\u093e\u0902\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0905\u0927\u093f\u0915\u0924\u092e \u090f\u092f\u0930 \u0915\u0902\u0921\u0940\u0936\u0928\u093f\u0902\u0917 \u092c\u094d\u0932\u094b\u0905\u0930 \u092a\u0902\u0916\u0947 \u0915\u0940 \u0917\u0924\u093f \u0915\u094b \u0938\u0940\u092e\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_sflow_control:{name:"\u090f\u0938-\u092b\u094d\u0932\u094b \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f \u0938\u093f\u0902\u0917\u0932-\u0911\u0915\u094d\u092f\u0942\u092a\u0947\u0902\u091f \u092e\u094b\u0921 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u0935\u091c\u0928 \u0938\u0947\u0902\u0938\u0930 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u092d\u0930\u0940 \u0939\u0941\u0908 \u0938\u0940\u091f\u094b\u0902 \u092a\u0930 \u090f/\u0938\u0940 \u090f\u092f\u0930\u092b\u094d\u0932\u094b \u0915\u094b \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},toyota_relock_timeout:{name:"\u0930\u093f\u092e\u094b\u091f \u0905\u0928\u0932\u0949\u0915 \u0915\u0947 \u092c\u093e\u0926 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u092a\u0941\u0928\u0903 \u0932\u0949\u0915 \u0935\u093f\u0932\u0902\u092c \u091f\u093e\u0907\u092e\u0930 (\u091f\u094b\u092f\u094b\u091f\u093e)",desc:"\u092f\u0926\u093f \u0915\u094b\u0908 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0928\u0939\u0940\u0902 \u0916\u0941\u0932\u093e \u0939\u0948 \u0924\u094b \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0947 \u0911\u091f\u094b-\u0930\u0940\u0932\u0949\u0915 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0915\u0941\u091b \u0938\u0947\u0915\u0902\u0921 \u092a\u0939\u0932\u0947 \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 (30s-120s)\u0964"},lexus_mark_levinson_audio_profile:{name:"\u092e\u093e\u0930\u094d\u0915 \u0932\u0947\u0935\u093f\u0902\u0938\u0928 \u0938\u0930\u093e\u0909\u0902\u0921 \u0938\u093e\u0909\u0902\u0921 \u0921\u0940\u090f\u0938\u092a\u0940 \u0911\u0921\u093f\u092f\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 (\u0932\u0947\u0915\u094d\u0938\u0938)",desc:"\u092e\u093e\u0930\u094d\u0915 \u0932\u0947\u0935\u093f\u0902\u0938\u0928 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u0947 \u0932\u093f\u090f 3\u0921\u0940 \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u0927\u094d\u0935\u0928\u093f\u0915 \u091f\u094d\u092f\u0942\u0928\u093f\u0902\u0917 \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},lexus_ev_mode_beeper_mute:{name:"\u0915\u092e \u0917\u0924\u093f \u0935\u093e\u0932\u0947 \u092a\u0948\u0926\u0932 \u092f\u093e\u0924\u094d\u0930\u0940 \u0908\u0935\u0940 \u0927\u094d\u0935\u0928\u093f\u0915 \u0905\u0932\u0930\u094d\u091f \u092c\u0940\u092a\u0930 \u092e\u094d\u092f\u0942\u091f (\u0932\u0947\u0915\u094d\u0938\u0938)",desc:"\u0915\u092e \u0917\u0924\u093f \u0935\u093e\u0932\u0947 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u092e\u094b\u0921 \u0938\u093f\u0902\u0925\u0947\u091f\u093f\u0915 \u092c\u093e\u0939\u0930\u0940 \u091d\u0902\u0915\u093e\u0930 \u0915\u094b \u0926\u092c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},lexus_easy_access_seat:{name:"\u0906\u0938\u093e\u0928 \u092a\u0939\u0941\u0902\u091a \u0935\u093e\u0932\u093e \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0935\u094d\u0939\u0940\u0932 \u0914\u0930 \u092a\u093e\u0935\u0930 \u0938\u0940\u091f \u0938\u094d\u0932\u093e\u0907\u0921-\u092c\u0948\u0915 (\u0932\u0947\u0915\u094d\u0938\u0938)",desc:"\u0906\u0938\u093e\u0928 \u092a\u094d\u0930\u0935\u0947\u0936/\u0928\u093f\u0915\u093e\u0938 \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0940 \u0938\u0940\u091f \u0915\u094b \u092a\u0940\u091b\u0947 \u0915\u0940 \u0913\u0930 \u0916\u093f\u0938\u0915\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0935\u094d\u0939\u0940\u0932 \u0915\u094b \u0926\u0942\u0930 \u091d\u0941\u0915\u093e\u0924\u093e \u0939\u0948\u0964"},nissan_epower_regen_mode:{name:"\u0908-\u092a\u093e\u0935\u0930 \u0935\u0928-\u092a\u0947\u0921\u0932 \u0930\u0940\u091c\u0947\u0928\u0930\u0947\u091f\u093f\u0935 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u092e\u094b\u0921 (\u0928\u093f\u0938\u093e\u0928)",desc:"\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0908-\u092a\u0947\u0921\u0932 \u092a\u0941\u0928\u0930\u094d\u092f\u094b\u091c\u0940 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u092e\u0902\u0926\u0940 \u0938\u094d\u0924\u0930 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},nissan_propilot_assist_timing:{name:"\u092a\u094d\u0930\u094b\u092a\u093e\u092f\u0932\u091f \u0932\u0947\u0928 \u0938\u0947\u0902\u091f\u0930\u093f\u0902\u0917 \u0905\u0938\u093f\u0938\u094d\u091f \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0938\u0947\u0902\u0938\u093f\u091f\u093f\u0935\u093f\u091f\u0940 (\u0928\u093f\u0938\u093e\u0928)",desc:"ProPILOT \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0939\u0938\u094d\u0924\u0915\u094d\u0937\u0947\u092a \u0924\u0940\u0915\u094d\u0937\u094d\u0923\u0924\u093e \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},nissan_intelligent_around_view:{name:"\u0915\u092e \u0917\u0924\u093f \u092a\u0930 \u0905\u0930\u093e\u0909\u0902\u0921 \u0935\u094d\u092f\u0942 \u092e\u0949\u0928\u093f\u091f\u0930 \u0911\u091f\u094b-\u092a\u0949\u092a-\u0905\u092a (\u0928\u093f\u0938\u093e\u0928)",desc:"\u091c\u092c \u092b\u094d\u0930\u0902\u091f \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0938\u0947\u0902\u0938\u0930 \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0924\u093e \u0939\u0948 \u0924\u094b 360-\u0921\u093f\u0917\u094d\u0930\u0940 \u0915\u0948\u092e\u0930\u093e \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u091f\u094d\u0930\u093f\u0917\u0930 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},mazda_g_vectoring_display:{name:"\u091c\u0940-\u0935\u0947\u0915\u094d\u091f\u0930\u093f\u0902\u0917 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092a\u094d\u0932\u0938 \u0921\u093e\u092f\u0928\u0947\u092e\u093f\u0915 \u0935\u093f\u091c\u093c\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930 (\u092e\u093e\u091c\u093c\u094d\u0926\u093e)",desc:"\u0909\u092a\u0915\u0930\u0923 \u092a\u0948\u0928\u0932 \u092a\u0930 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u091c\u0940\u0935\u0940\u0938\u0940+ \u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u091f\u0949\u0930\u094d\u0915 \u0935\u0947\u0915\u094d\u091f\u0930\u093f\u0902\u0917 \u0917\u094d\u0930\u093e\u092b \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP \u092c\u094d\u0930\u0947\u0915 \u090f\u0928\u0930\u094d\u091c\u0940 \u0930\u093f\u0915\u0935\u0930\u0940 \u0915\u0948\u092a\u0947\u0938\u093f\u091f\u0930 \u092e\u0940\u091f\u0930 (\u092e\u093e\u091c\u093c\u094d\u0926\u093e)",desc:"\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0915\u0948\u092a\u0947\u0938\u093f\u091f\u0930 \u091a\u093e\u0930\u094d\u091c \u0914\u0930 \u0921\u093f\u0938\u094d\u091a\u093e\u0930\u094d\u091c \u0938\u094d\u0925\u093f\u0924\u093f \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964"},mazda_smart_city_brake_sens:{name:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0938\u093f\u091f\u0940 \u092c\u094d\u0930\u0947\u0915 \u0938\u092a\u094b\u0930\u094d\u091f (\u090f\u0938\u0938\u0940\u092c\u0940\u090f\u0938) \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e (\u092e\u093e\u091c\u093c\u094d\u0926\u093e)",desc:"\u0915\u092e \u0917\u0924\u093f \u0935\u093e\u0932\u0940 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0938\u0947\u0902\u0938\u0930 \u0930\u0947\u0902\u091c \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},subaru_eyesight_distance_preset:{name:"\u0906\u0908\u0938\u093e\u0907\u091f \u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u0915\u094d\u0930\u0942\u091c\u093c \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0926\u0942\u0930\u0940 (\u0938\u0941\u092c\u093e\u0930\u0942)",desc:"\u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0905\u092a \u092a\u0930 \u0938\u094d\u091f\u0940\u0930\u093f\u092f\u094b \u0915\u0948\u092e\u0930\u093e \u0921\u093f\u092b\u0949\u0932\u094d\u091f \u0915\u094d\u0930\u0942\u091c\u093c \u0917\u0948\u092a \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},subaru_xmode_auto_engage:{name:"\u090f\u0915\u094d\u0938-\u092e\u094b\u0921 \u0911\u092b-\u0930\u094b\u0921 \u091f\u094d\u0930\u0948\u0915\u094d\u0936\u0928 \u0911\u091f\u094b-\u090f\u0902\u0917\u0947\u091c \u0925\u094d\u0930\u0947\u0936\u094b\u0932\u094d\u0921 (\u0938\u0941\u092c\u093e\u0930\u0942)",desc:"\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0926\u094b\u0939\u0930\u0947 \u092b\u093c\u0902\u0915\u094d\u0936\u0928 \u090f\u0915\u094d\u0938-\u092e\u094b\u0921 \u0938\u0915\u094d\u0930\u093f\u092f\u0923 \u0915\u0947 \u0932\u093f\u090f \u0935\u094d\u0939\u0940\u0932 \u0938\u094d\u0932\u093f\u092a \u0925\u094d\u0930\u0947\u0936\u094b\u0932\u094d\u0921 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},subaru_steering_responsive_headlights:{name:"\u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0930\u093f\u0938\u094d\u092a\u0949\u0928\u094d\u0938\u093f\u0935 \u0939\u0947\u0921\u0932\u093e\u0907\u091f\u094d\u0938 (\u090f\u0938\u0906\u0930\u090f\u091a) \u091f\u0949\u0917\u0932 (\u0938\u0941\u092c\u093e\u0930\u0942)",desc:"\u0926\u093f\u0936\u093e\u0924\u094d\u092e\u0915 \u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0915\u0941\u0902\u0921\u093e \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u092f\u093e \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},genesis_sport_plus_mode:{name:"\u0938\u094d\u092a\u094b\u0930\u094d\u091f+ \u092a\u093e\u0935\u0930\u091f\u094d\u0930\u0947\u0928 \u0914\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0938\u0938\u094d\u092a\u0947\u0902\u0936\u0928 \u092e\u094b\u0921 (\u0909\u0924\u094d\u092a\u0924\u094d\u0924\u093f)",desc:"\u091f\u094d\u0930\u0948\u0915-\u0909\u0928\u094d\u092e\u0941\u0916 \u0908\u090f\u0938\u0938\u0940 \u0911\u092b \u0914\u0930 \u0915\u0920\u094b\u0930 \u0921\u0948\u092e\u094d\u092a\u0930 \u092e\u0948\u092a\u093f\u0902\u0917 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},genesis_ambient_active_light:{name:"\u0938\u0915\u094d\u0930\u093f\u092f \u092a\u0930\u093f\u0935\u0947\u0936 \u092a\u094d\u0930\u0915\u093e\u0936 \u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921 \u0938\u093f\u0902\u0915 (\u0909\u0924\u094d\u092a\u0924\u094d\u0924\u093f)",desc:"\u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0906\u0902\u0924\u0930\u093f\u0915 \u092a\u0930\u093f\u0935\u0947\u0936 \u092a\u094d\u0930\u0915\u093e\u0936 \u0915\u093e \u0930\u0902\u0917 \u0917\u0924\u093f\u0936\u0940\u0932 \u0930\u0942\u092a \u0938\u0947 \u092c\u0926\u0932\u0924\u093e \u0939\u0948\u0964"},volvo_city_safety_warning:{name:"\u0936\u0939\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u094d\u0935\u093e\u092f\u0924\u094d\u0924 \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e (\u0935\u094b\u0932\u094d\u0935\u094b)",desc:"\u0930\u0921\u093e\u0930 \u0914\u0930 \u0932\u093f\u0921\u093e\u0930 \u091f\u0915\u0930\u093e\u0935 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0938\u092e\u092f (\u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915/\u0938\u093e\u092e\u093e\u0928\u094d\u092f) \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},chery_ar_navigation_hud:{name:"HUD (\u091a\u0947\u0930\u0940) \u092a\u0930 AR \u0928\u0947\u0935\u093f\u0917\u0947\u0936\u0928 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u0936\u0928 \u0913\u0935\u0930\u0932\u0947",desc:"\u0935\u093f\u0902\u0921\u0936\u0940\u0932\u094d\u0921 \u092a\u0930 3\u0921\u0940 \u0938\u0902\u0935\u0930\u094d\u0927\u093f\u0924 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915\u0924\u093e \u0928\u0947\u0935\u093f\u0917\u0947\u0936\u0928 \u0924\u0940\u0930 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},jlr_terrain_response_preset:{name:"\u091f\u0947\u0930\u0947\u0928 \u0930\u093f\u0938\u094d\u092a\u093e\u0902\u0938 \u0911\u091f\u094b \u0911\u092b-\u0930\u094b\u0921 \u092e\u094b\u0921 \u092a\u094d\u0930\u0940\u0938\u0947\u091f (\u091c\u0947\u090f\u0932\u0906\u0930)",desc:"\u0905\u0902\u0924\u093f\u092e \u092d\u0942\u092d\u093e\u0917 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0924\u0939 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 (\u0918\u093e\u0938/\u092c\u091c\u0930\u0940/\u092c\u0930\u094d\u092b) \u092f\u093e\u0926 \u0939\u0948\u0964"},jlr_adaptive_dynamics_firm:{name:"\u090f\u0921\u0947\u092a\u094d\u091f\u093f\u0935 \u0921\u093e\u092f\u0928\u0947\u092e\u093f\u0915\u094d\u0938 \u0921\u0948\u092e\u094d\u092a\u0930 \u092b\u0930\u094d\u092e\u0928\u0947\u0938 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 (\u091c\u0947\u090f\u0932\u0906\u0930)",desc:"\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0936\u0949\u0915 \u0905\u0935\u0936\u094b\u0937\u0915 \u092d\u093f\u0917\u094b\u0928\u093e \u0915\u0920\u094b\u0930\u0924\u093e \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},jlr_wading_sensor_alert:{name:"\u0935\u0947\u0921 \u0938\u0947\u0902\u0938\u093f\u0902\u0917 \u0921\u0947\u092a\u094d\u0925 \u0935\u093e\u0930\u094d\u0928\u093f\u0902\u0917 \u091a\u093e\u0907\u092e \u0925\u094d\u0930\u0947\u0936\u094b\u0932\u094d\u0921 (\u091c\u0947\u090f\u0932\u0906\u0930)",desc:"\u0905\u0932\u094d\u091f\u094d\u0930\u093e\u0938\u094b\u0928\u093f\u0915 \u091c\u0932 \u0917\u0939\u0930\u093e\u0908 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091d\u0902\u0915\u093e\u0930 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},alfa_dna_dynamic_memory:{name:"\u0905\u0932\u094d\u092b\u093c\u093e \u0921\u0940\u090f\u0928\u090f \u091a\u092f\u0928\u0915\u0930\u094d\u0924\u093e \u0921\u093e\u092f\u0928\u093e\u092e\u093f\u0915 \u092e\u094b\u0921 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0905\u092a \u092e\u0947\u092e\u094b\u0930\u0940 (\u0905\u0932\u094d\u092b\u093c\u093e \u0930\u094b\u092e\u093f\u092f\u094b)",desc:"\u092a\u0941\u0928\u0930\u093e\u0930\u0902\u092d \u0915\u0947 \u092c\u093e\u0926 \u0921\u093e\u092f\u0928\u093e\u092e\u093f\u0915 \u092e\u094b\u0921 \u0925\u094d\u0930\u0949\u091f\u0932 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},alfa_q4_torque_split:{name:"Q4 \u0911\u0932-\u0935\u094d\u0939\u0940\u0932 \u0921\u094d\u0930\u093e\u0907\u0935 \u0930\u0940\u092f\u0932-\u091f\u093e\u0907\u092e \u091f\u0949\u0930\u094d\u0915 \u0938\u094d\u092a\u094d\u0932\u093f\u091f \u0917\u094d\u0930\u093e\u092b\u093c (\u0905\u0932\u094d\u092b\u093c\u093e \u0930\u094b\u092e\u093f\u092f\u094b)",desc:"\u0909\u092a\u0915\u0930\u0923 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092a\u0930 AWD \u092b\u094d\u0930\u0902\u091f/\u0930\u093f\u092f\u0930 \u092a\u093e\u0935\u0930 \u0938\u094d\u092a\u094d\u0932\u093f\u091f \u092a\u094d\u0930\u0924\u093f\u0936\u0924 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964"},li_auto_range_extender_mode:{name:"\u0906\u0930\u0908\u0935\u0940 \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u092c\u0948\u091f\u0930\u0940 \u091a\u093e\u0930\u094d\u091c \u0930\u093f\u091f\u0947\u0902\u0936\u0928 \u0932\u0947\u0935\u0932 (\u0932\u0940 \u0911\u091f\u094b)",desc:"\u0906\u0902\u0924\u0930\u093f\u0915 \u0926\u0939\u0928 \u0907\u0902\u091c\u0928 \u091c\u0928\u0930\u0947\u091f\u0930 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0938\u0940\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},li_auto_cinema_seat_position:{name:"\u0925\u093f\u090f\u091f\u0930/\u0938\u093f\u0928\u0947\u092e\u093e \u092e\u094b\u0921 \u090f\u0930\u094d\u0917\u094b\u0928\u094b\u092e\u093f\u0915 \u0938\u0940\u091f \u0938\u094d\u0925\u093f\u0924\u093f (\u0932\u0940 \u0911\u091f\u094b)",desc:"\u0938\u093f\u0928\u0947\u092e\u093e \u092e\u094b\u0921 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b\u0928\u0947 \u092a\u0930 \u092a\u0940\u091b\u0947 \u0915\u0940 \u0938\u0940\u091f\u094b\u0902 \u0915\u094b \u091d\u0941\u0915\u093e \u0926\u0947\u0924\u093e \u0939\u0948 \u0914\u0930 \u092a\u0948\u0930\u094b\u0902 \u0915\u0947 \u0906\u0930\u093e\u092e \u0915\u094b \u0916\u094b\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},zeekr_drift_mode_torque:{name:"\u0921\u0941\u0905\u0932 \u092e\u094b\u091f\u0930 \u092a\u0930\u092b\u0949\u0930\u094d\u092e\u0947\u0902\u0938 \u0921\u094d\u0930\u093f\u092b\u094d\u091f \u092e\u094b\u0921 \u0930\u093f\u092f\u0930 \u092c\u093e\u092f\u0938 (\u091c\u093c\u0940\u0915\u0930)",desc:"\u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u092c\u0939\u093e\u0935 \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u092f\u0930 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u092e\u094b\u091f\u0930 \u0915\u094b 100% \u091f\u0949\u0930\u094d\u0915 \u092d\u0947\u091c\u0924\u093e \u0939\u0948\u0964"},zeekr_ambient_beat_sync:{name:"\u090f\u092e\u094d\u092c\u093f\u090f\u0902\u091f \u0932\u093e\u0907\u091f\u093f\u0902\u0917 \u092e\u094d\u092f\u0942\u091c\u093f\u0915 \u0930\u093f\u0926\u092e \u092c\u0940\u091f \u0938\u093f\u0902\u0915 (\u091c\u093c\u0940\u0915\u0930)",desc:"\u092c\u091c\u093e\u090f \u0917\u090f \u0938\u0902\u0917\u0940\u0924 \u0915\u0940 \u0927\u0941\u0928\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0906\u0902\u0924\u0930\u093f\u0915 \u0915\u0947\u092c\u093f\u0928 \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u0915\u094b \u0938\u094d\u092a\u0902\u0926\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},tata_drive_mode_voice:{name:"\u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921 \u0938\u094d\u0935\u093f\u091a \u0935\u0949\u092f\u0938 \u0905\u0928\u093e\u0909\u0902\u0938\u092e\u0947\u0902\u091f (\u091f\u093e\u091f\u093e)",desc:"\u0921\u094d\u0930\u093e\u0907\u0935 \u092e\u094b\u0921 (\u0938\u093f\u091f\u0940/\u0938\u094d\u092a\u094b\u0930\u094d\u091f/\u0907\u0915\u094b) \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0911\u0921\u093f\u092f\u094b \u0935\u0949\u092f\u0938 \u092a\u0941\u0937\u094d\u091f\u093f\u0915\u0930\u0923 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},mahindra_zip_zap_zoom_custom:{name:"\u091c\u093c\u093f\u092a/\u091c\u093c\u0948\u092a/\u091c\u093c\u0942\u092e \u092a\u093e\u0935\u0930\u091f\u094d\u0930\u0947\u0928 \u0925\u094d\u0930\u0949\u091f\u0932 \u0930\u093f\u0938\u094d\u092a\u093e\u0902\u0938 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 (\u092e\u0939\u093f\u0902\u0926\u094d\u0930\u093e)",desc:"\u091c\u093c\u093f\u092a, \u091c\u0948\u092a \u0914\u0930 \u091c\u093c\u0942\u092e \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u092e\u094b\u0921 \u0915\u0947 \u0932\u093f\u090f \u0924\u094d\u0935\u0930\u0923 \u0935\u0915\u094d\u0930 \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},fun_cyberpunk_cluster_theme:{name:"\u0938\u093e\u0907\u092c\u0930\u092a\u0902\u0915 2077 \u0928\u093f\u092f\u0949\u0928 \u0917\u094d\u0930\u093e\u092b\u093f\u0915 \u0915\u0949\u0915\u092a\u093f\u091f \u0925\u0940\u092e",desc:"\u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0926\u0940 \u0928\u093f\u092f\u0949\u0928 \u0938\u093f\u092f\u093e\u0928 \u0914\u0930 \u090f\u092e\u094d\u092c\u0930 \u0921\u093f\u091c\u093f\u091f\u0932 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0917\u0947\u091c \u0938\u094d\u091f\u093e\u0907\u0932 \u0932\u093e\u0917\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},fun_exhaust_flame_sound_effect:{name:"\u0938\u094d\u091f\u0940\u0930\u093f\u092f\u094b \u0938\u093f\u0938\u094d\u091f\u092e \u092a\u0949\u092a \u0914\u0930 \u092c\u0948\u0902\u0917 \u090f\u0917\u094d\u091c\u0949\u0938\u094d\u091f \u0938\u093e\u0909\u0902\u0921 \u090f\u092b\u090f\u0915\u094d\u0938",desc:"\u0915\u0947\u092c\u093f\u0928 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u0925\u093e\u0930\u094d\u0925\u0935\u093e\u0926\u0940 V8 \u090f\u0917\u094d\u091c\u0949\u0938\u094d\u091f \u092a\u0949\u092a \u0914\u0930 \u092c\u0948\u0902\u0917 \u0911\u0921\u093f\u092f\u094b \u092a\u094d\u0930\u092d\u093e\u0935 \u091a\u0932\u093e\u0924\u093e \u0939\u0948\u0964"},fun_matrix_light_show_welcome:{name:"\u0915\u0938\u094d\u091f\u092e \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u092e\u0948\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u090f\u0932\u0908\u0921\u0940 \u0921\u093e\u0902\u0938 \u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948",desc:"\u0939\u0947\u0921\u0932\u093e\u0907\u091f\u094d\u0938 \u0914\u0930 \u0938\u0902\u0915\u0947\u0924\u0915\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0932\u092f\u092c\u0926\u094d\u0927 \u0932\u093e\u0907\u091f \u0936\u094b \u0915\u094b\u0930\u093f\u092f\u094b\u0917\u094d\u0930\u093e\u092b\u0940 \u092c\u091c\u093e\u0924\u093e \u0939\u0948\u0964"},fun_stealth_fighter_display:{name:"\u0938\u094d\u091f\u0940\u0932\u094d\u0925 \u092b\u093e\u0907\u091f\u0930 \u0928\u093e\u0907\u091f \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u092e\u093f\u0928\u093f\u092e\u0932\u093f\u0938\u094d\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092e\u094b\u0921",desc:"\u0915\u093e\u0932\u0940 \u0930\u093e\u0924 \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u092a\u0940\u0921\u094b\u092e\u0940\u091f\u0930 \u0915\u094b \u091b\u094b\u0921\u093c\u0915\u0930 \u0938\u092d\u0940 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0932\u093e\u0907\u091f\u0947\u0902 \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{name:"Retarder & Jake Brake Downshift Aggressiveness",desc:"Adjusts retarder torque blending curve and automatic transmission downshifting response under braking."},man_ecas_dock_level_memory:{name:"ECAS Air Suspension Loading Dock Height Memory",desc:"Stores and recalls customized pneumatic air suspension height level presets for loading docks."},daf_stationary_dpf_regen_trigger:{name:"Stationary DPF Forced Soot Regeneration",desc:"Initiates stationary diesel particulate filter thermal soot burn routine in parked position."},ford_trucks_reverse_buzzer_night_mode:{name:"Reverse Acoustic Alarm Night Quiet Mode",desc:"Attenuates reverse backup horn alarm volume for quiet night distribution in residential areas."},cummins_ecm_fleet_speed_limiter:{name:"Cummins Engine Road Speed Limiter (RSL)",desc:"Programs maximum allowable road vehicle speed in Cummins ECM parameter tables."}},codeBtn:"\u0915\u094b\u0921 \u0915\u0930\u0947\u0902",removeBtn:"\u0939\u091f\u093e\u090f\u0902",unsupportedTitle:"\u0935\u093e\u0939\u0928 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948",unsupportedMsg:"\u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0915\u0947 \u0908\u0938\u0940\u092f\u0942 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",layoutChart:"\u0917\u094d\u0930\u093e\u092b\u093c",selectBrand:"\u0935\u093e\u0939\u0928 \u092c\u094d\u0930\u093e\u0902\u0921 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902",selectCategory:"\u0936\u094d\u0930\u0947\u0923\u0940 \u091a\u0941\u0928\u0947\u0902",selectMakeTitle:"\u0935\u093e\u0939\u0928 \u092c\u094d\u0930\u093e\u0902\u0921 \u091a\u0941\u0928\u0947\u0902",sele