:" \u0648\u062d\u062f\u0629 \u062a\u062d\u0643\u0645 OBD \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 (TX / RX)",userId:"\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645",userInfo:" \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0645\u0633\u0624\u0648\u0644",devModeAlert:"\u062a\u0645 \u062a\u0639\u0637\u064a\u0644 \u0645\u0641\u062a\u0627\u062d \u0645\u0637\u0648\u0631 Secret PRO \u0641\u064a \u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0625\u0646\u062a\u0627\u062c.",invalidCmdError:"\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0623\u0645\u0631 OBD \u0635\u0627\u0644\u062d (\u0645\u062b\u0644 01 0C \u0623\u0648 AT Z)",noLogsInfo:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0633\u062c\u0644\u0627\u062a \u0633\u062c\u0644 \u0644\u0644\u0645\u0634\u0627\u0631\u0643\u0629.",logsLoading:"\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0633\u062c\u0644\u0627\u062a...",calculating:"\u062c\u0627\u0631\u064d \u0627\u0644\u062d\u0633\u0627\u0628...",secretProTitle:"\u0645\u0641\u062a\u0627\u062d PRO \u0627\u0644\u0633\u0631\u064a (DEV)",secretProActive:"\u062d\u0627\u0644\u0629 \u0648\u0636\u0639 \u062a\u0631\u062e\u064a\u0635 PRO: \u0646\u0634\u0637 (\u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0645\u0641\u062a\u0648\u062d\u0629)",secretProInactive:"\u062d\u0627\u0644\u0629 \u0648\u0636\u0639 \u062a\u0631\u062e\u064a\u0635 PRO: \u063a\u064a\u0631 \u0646\u0634\u0637 (\u0645\u0639\u0637\u0644)",logsTruncated:"... [\u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0645\u0642\u0637\u0648\u0639\u0629] ...",noLogsFound:"\u0644\u0645 \u064a\u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0623\u064a \u0633\u062c\u0644\u0627\u062a.",logsReadErr:"\u0644\u0627 \u064a\u0645\u0643\u0646 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0633\u062c\u0644\u0627\u062a:",unknown:"\u0645\u062c\u0647\u0648\u0644",deviceNo