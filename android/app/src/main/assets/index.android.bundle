ease connect a charger or start the engine.",items:{vag_staging_needle_sweep:{name:"Gauge Staging / Needle Sweep",desc:"Sweeps instrument needles to maximum upon ignition start."},vag_acoustic_lock_confirmation:{name:"Acoustic Lock Confirmation Chirp",desc:"Emits a short horn confirmation chirp upon key fob locking."},vag_american_parking_lights:{name:"US Style Parking Lights",desc:"Illuminates front turn signals continuously at 20% dimming with parking lights."},vag_drl_menu_toggle:{name:"Daytime Running Lights Menu Toggle",desc:"Enables DRL ON/OFF checkbox in infotainment vehicle settings menu."},vag_tear_wiping:{name:"Windshield Tear Wiping",desc:"Executes an additional final wipe 5 seconds after windshield washer use."},vag_emergency_brake_flashing:{name:"Emergency Brake Hazard Flashing",desc:"Rapidly flashes brake lights and hazards under heavy emergency braking."},vag_cornering_lights:{name:"Cornering Fog Lights",desc:"Illuminates cornering fog light on steering wheel rotation side."},vag_comfort_mirror_folding:{name:"Key Fob Comfort Mirror Folding",desc:"Automatically folds side mirrors when lock button is held on key fob."},vag_lap_timer:{name:"Instrument Cluster Lap Timer",desc:"Unlocks track lap timer display tab in instrument cluster screen."},vag_refuel_quantity:{name:"Refuel Quantity Display",desc:"Displays exact volume in liters required for a full fuel refuel."},bmw_start_stop_memory:{name:"Auto Start-Stop Memory Mode",desc:"Remembers last Auto Start-Stop state across vehicle restarts."},bmw_digital_speedometer:{name:"Digital Speedometer Display",desc:"Adds instant digital speed numerical display option to cluster screen."},bmw_sport_displays:{name:"Sport Displays",desc:"Enables live horsepower and torque dynamic dials in iDrive screen."},bmw_acoustic_lock_sound:{name:"Acoustic Lock/Unlock Sound",desc:"Emits alarm system chirps when locking or unlocking the vehicle."},bmw_mirror_fold_delay_zero:{name:"Instant Mirror Folding",desc:"Folds side mirrors instantly upon lock button press without holding delay."},bmw_tpms_tire_temperature:{name:"Tire Pressure & Temperature Display",desc:"Displays real-time tire temperature alongside pressure in TPMS screen."},renault_trip_computer_enable:{name:"On-Board Trip Computer Enable",desc:"Unlocks average fuel consumption and range trip computer displays."},renault_external_temp_display:{name:"External Temperature Display",desc:"Enables ambient outdoor temperature reading in instrument cluster."},renault_automatic_tailgate:{name:"Key Fob Trunk Release",desc:"Fully pops trunk latch mechanism upon holding key fob trunk button."},renault_alarm_chirp:{name:"Alarm Lock Confirmation Chirp",desc:"Sounds horn confirmation chirp upon vehicle door locking."},renault_shift_indicator:{name:"Gear Shift Indicator",desc:"Activates eco-driving shift UP/DOWN arrows in instrument cluster."},ford_double_horn_honk_disable:{name:"Disable Double Horn Honk on Door Close",desc:"Disables double horn honk when closing door with engine running."},ford_auto_door_locking:{name:"Auto Door Locking at 20 km/h",desc:"Automatically locks all doors when vehicle speed exceeds 20 km/h."},ford_tpms_psi_display:{name:"Numerical Tire Pressure Display",desc:"Displays exact numerical PSI/BAR pressure per tire in instrument screen."},ford_sync_climate_screen:{name:"SYNC Screen Climate Controls",desc:"Adds climate control and seat heating touchscreen menu to SYNC display."},stellantis_power_windows_remote:{name:"Key Fob Remote Window Roll Up/Down",desc:"Rolls up or down all power windows when holding lock/unlock buttons."},stellantis_cornering_fogs:{name:"Cornering Fog Lights Enable",desc:"Illuminates cornering fog lamp during low-speed turns."},vag_traffic_sign_recognition:{name:"Traffic Sign Recognition",desc:"Displays camera-detected speed signs in instrument cluster and HUD."},vag_ambient_color_palette_30:{name:"30-Color Ambient Lighting Palette",desc:"Unlocks 30 RGB interior lighting color picker in MIB infotainment menu."},vag_seatbelt_warning_mute:{name:"Seatbelt Chime Deactivation",desc:"Disables unbuckled seatbelt acoustic chime in instrument cluster."},bmw_alpina_cluster_theme:{name:"Alpina Digital Dash Layout",desc:"Applies blue Alpina signature theme to digital instrument cluster."},bmw_video_in_motion:{name:"Video In Motion",desc:"Unlocks USB video playback on iDrive screen while driving."},bmw_sport_plus_mode_unlock:{name:"Sport+ Driving Mode Enable",desc:"Enables Sport+ high-performance dynamic driving mode in DEC selector."},mercedes_amg_menu_unlock:{name:"AMG Performance Telemetry Menu",desc:"Displays AMG oil temp, transmission temp, lap timer, and G-meter."},mercedes_agility_mode_enable:{name:"Agility Transmission Mode",desc:"Unlocks ultra-responsive Agility shift program in 7G/9G-Tronic transmission."},mercedes_drl_brightness_boost:{name:"Daytime Running Lights 100% Intensity",desc:"Increases LED daytime running lights output to 100% full brightness."},mercedes_alarm_lock_chirp:{name:"Acoustic Locking Horn Chirp",desc:"Emits short horn chirp notification when central locking is engaged."},mercedes_dpf_adblue_gauge:{name:"DPF Soot & AdBlue Level Gauge",desc:"Displays exact DPF soot mass percentage and remaining AdBlue range in IC."},renault_rs_monitor_enable:{name:"Renault Sport RS Monitor Telemetry",desc:"Enables live G-force, turbo boost, and oil temp telemetry on R-Link."},renault_duster_mirror_fold:{name:"Duster Auto Mirror Folding on Lock",desc:"Folds side mirrors automatically via BCM central locking command."},ford_bambi_mode_fog_light:{name:"Bambi Mode",desc:"Allows fog lights to remain ON when high beam headlights are activated."},ford_st_rs_boot_animation:{name:"ST/RS Performance SYNC Boot Screen",desc:"Changes SYNC touchscreen startup splash animation to ST / RS logo."},toyota_reverse_beep_mute:{name:"Reverse Gear Continuous Cabin Beep Mute",desc:"Mutes continuous reverse gear chime inside cabin to a single beep."},toyota_remote_window_drop:{name:"Key Fob Remote Window Roll Down",desc:"Rolls down all power windows when holding key fob unlock button."},toyota_auto_lock_shift_p:{name:"Auto Lock Doors on Gear Shift",desc:"Automatically locks all doors when shifting out of Park position."},peugeot_icockpit_theme_unlock:{name:"Peugeot 3D i-Cockpit Performance Theme",desc:"Unlocks Copper and Track Red color display themes on 3D digital cluster."},jeep_offroad_pages_enable:{name:"Jeep Uconnect Off-Road Pages",desc:"Enables pitch/roll angle gauges, wheel articulation, and 4x4 lock status."},hyundai_smart_welcome_mirror:{name:"Smart Key Approach Welcome Mirror Unfold",desc:"Automatically unfolds side mirrors when approaching vehicle with smart key."},hyundai_one_touch_turn_7_flashes:{name:"One-Touch Lane Change Signal",desc:"Sets one-touch lane change blinker duration to 7 flashes."},hyundai_svm_camera_speed_extend:{name:"360\xb0 Surround Camera Speed Extension",desc:"Keeps 360-degree parking camera active up to 20 km/h forward speed."},hyundai_n_performance_exhaust_flap:{name:"N-Performance Exhaust Flap Default OPEN",desc:"Sets active exhaust valve default position to OPEN on engine start."},vag_rain_closing_sunroof:{name:"Rain Closing",desc:"Automatically closes sunroof and windows when rain is detected while parked."},bmw_launch_control_unlock:{name:"Launch Control Unlock",desc:"Unlocks factory launch control acceleration program in transmission ECU."},mercedes_ambient_64_multi_zone:{name:"64-Color Multi-Zone Ambient Profile",desc:"Unlocks dynamic multi-zone color cycle animation in MBUX interior lighting."},ford_trailer_brake_activation:{name:"Trailer Brake Controller Enable",desc:"Enables integrated trailer brake controller menu in instrument cluster."},gm_afm_dfm_cylinder_deactivation_disable:{name:"AFM/DFM V8 Cylinder Lock",desc:"Locks engine in 8-cylinder mode permanently to prevent V4 vibration."},gm_remote_start_time_extend:{name:"Remote Start Duration Extension",desc:"Extends factory key fob remote engine start run time from 10 to 20 minutes."},dodge_srt_performance_pages:{name:"SRT Performance Pages & Drive Modes",desc:"Unlocks Uconnect 0-100 acceleration timers, G-force meter, and launch control."},ram_bambi_mode_fog:{name:"RAM Truck Fog Lights with High Beam",desc:"Allows RAM fog lights to remain active alongside high beam headlights."},byd_avas_pedestrian_siren_mute:{name:"AVAS EV Low-Speed Siren Mute",desc:"Mutes low-speed artificial electric motor siren below 30 km/h."},chery_isa_overspeed_chime_mute:{name:"ISA Overspeed Warning Chime Deactivation",desc:"Disables continuous 80/120 km/h overspeed warning beep on Tiggo/MG models."},mg_ev_battery_preconditioning_toggle:{name:"EV Fast-Charge Battery Pre-Heating Manual Switch",desc:"Enables manual battery pre-heating switch before DC fast charging."},chery_dms_fatigue_camera_mute:{name:"Driver Monitoring Camera Sensitivity Reduction",desc:"Reduces over-sensitive eye-tracking fatigue warnings on steering column."},honda_walk_away_auto_lock:{name:"Walk-Away Auto Door Lock",desc:"Automatically locks all doors when driver steps 2 meters away with key fob."},subaru_avh_auto_hold_memory:{name:"Auto Vehicle Hold Memory Mode",desc:"Remembers AVH brake hold ON/OFF state across ignition cycles."},volvo_start_stop_default_off:{name:"Auto Start-Stop Default OFF Mode",desc:"Sets Start-Stop engine shutoff system default state to OFF upon vehicle start."},volvo_polestar_digital_theme:{name:"Polestar Blue Digital Cluster Theme",desc:"Unlocks Polestar signature blue dynamic gauge theme in Volvo driver display."},vag_virtual_cockpit_r_theme:{name:"Virtual Cockpit R / S / Cupra Performance Themes",desc:"Unlocks R-Line, S-Line, and Cupra central tachometer performance themes in digital cockpit."},vag_sound_symposer_mute:{name:"Sound Symposer Fake Engine Noise Deactivation",desc:"Deactivates cabin speaker fake engine sound generator for pure exhaust note."},vag_wireless_carplay_enable:{name:"Wireless Apple CarPlay & Android Auto Activation",d