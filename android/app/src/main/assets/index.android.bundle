or ELM327 adapter for safe coding.",vehiclePids:"VEHICLE SENSOR CHECKLIST",checklistPrompt:"The standard live sensor parameters supported by your vehicle's ECU are listed below. Sensors without a checkmark are not supported by your vehicle.",supportedBadge:" SUPPORTED",unsupportedBadge:" UNSUPPORTED"},sensor:{rpm:"Engine RPM",speed:"Vehicle Speed",coolant:"Coolant Temperature",throttle:"Throttle Position",voltage:"Battery Voltage",maf:"Mass Air Flow (MAF)",iat:"Intake Air Temp (IAT)",load:"Engine Load",fuel:"Fuel Level",boost:"Turbo Boost Pressure",widebandAfr:"Wideband O2 / AFR Ratio",oilTemp:"Engine Oil Temperature",transTemp:"Transmission Temperature",catalystTemp:"Catalyst Temperature",ethanol:"Ethanol Fuel %",timingAdvance:"Ignition Timing Advance",baro:"Barometric Pressure"},dashboard:{limitReached:"Selection Limit",limitReachedDesc:"You can select a maximum of {{limit}} sensors with this protocol.",customizeSubtitleKLine:"K-Line protocol connected. You can select a maximum of {{limit}} sensors.",customizeSubtitleCAN:"CAN-Bus protocol connected. You can select a maximum of {{limit}} sensors.",unit:"Unit",selectDevice:"TAP TO SELECT DEVICE",connectedDevice:"CONNECTED DEVICE",noConnection:"No connection yet",batteryLow:"LOW BATTERY VOLTAGE!",batteryLowDesc:"Battery voltage is at {{voltage}}. Start vehicle or charge. ECU communication may be lost at low voltage.",batteryWarn:"BATTERY GETTING WEAK",batteryWarnDesc:"Battery voltage {{voltage}}. Be careful during long operations.",rpm:"Engine RPM",speed:"Vehicle Speed",temp:"TEMP",throttle:"Throttle Position",status:"RPM STATUS",statusHigh:"HIGH",statusNormal:"NORMAL",statusLow:"LOW",battery:"BATTERY",load:"LOAD",intake:"INTAKE AIR",manifold:"MANIFOLD kPa",customizeTitle:"DASHBOARD SETTINGS",customizeSubtitle:"Select the sensors you want to see on screen (Max 8).",layoutType:"Layout Style",layoutGrid:"GRID",layoutList:"LIST",layoutGauge:"GAUGE",layoutChart:"CHART",customizeButton:"CUSTOMIZE DASHBOARD",coolant:"Engine Coolant Temp",voltage:"Battery Voltage",engineLoad:"Engine Load",intakeAirTemp:"Intake Air Temp",manifoldPressure:"Manifold Pressure (MAP)",ambientTemp:"Ambient Temp",oilTemp:"Engine Oil Temp",mafFlow:"MAF Air Flow Rate",timingAdvance:"Timing Advance",fuelLevel:"Fuel Level",catalystTemp:"Catalyst Temp",obdTerminalTitle:"OBD HEALTH & TERMINAL",adapterClone:"CLONE ADAPTER",adapterOriginal:"ORIGINAL",adapterCloneShort:"CLONE",adapterOriginalShort:"ORIGINAL",pidLabel:"PID: {{pid}}",adblue:"AdBlue Level",egt:"Exhaust Gas Temp (EGT)",nox:"NOx Sensor Value",torque:"Engine Torque",selectedSensorsCount:"{{count}} / {{max}} Sensors Selected"},expertise:{historyFound:"VEHICLE HISTORY FOUND!",historyFoundDesc:"This vehicle has {{count}} previous records. You can review the history below.",viewHistory:"VIEW HISTORY \u203a",manualVin:"VIN (MANUAL INPUT)",manualVinDesc:"If the vehicle ECU does not share the VIN automatically, you can type it here.",vinPlaceholder:"Type VIN...",startScan:"START DIAGNOSTIC SCAN",scanning:"SCANNING...",vehicleIdentity:"VEHICLE IDENTITY & MILEAGE",vin:"VIN",odometer:"Original Mileage",distSinceCleared:"Dist Since Cleared",milDist:"Dist with MIL On",dtcTitle:"DIAGNOSTIC TROUBLE CODES (DTC)",dtcClean:"NO TROUBLE CODES \u2014 CLEAN",extraActions:"EXTRA ACTIONS",garageTitle:"GARAGE & PAST RECORDS",share:"SHARE",saveVehicle:"SAVE THIS VEHICLE",noRecords:"No saved vehicles yet.",clean:"CLEAN",faults:"FAULTS",vinRequired:"VIN Required",vinRequiredDesc:"VIN must be detected automatically or entered manually to save a record.",missingInfo:"Missing Info",missingInfoDesc:"Please fill in the Make and Model fields.",saved:"Saved ",savedDesc:"Diagnostic result added to garage.",connRequired:"Connection Required",connRequiredDesc:"Please connect to the vehicle first to start this operation.",chronicFaultsTitle:"Statistical Chronic Faults",chronicFaultsObs:"{{code}} (Observation: {{days}} Unique Days / Total: {{total}} Times)",chronicFaultsPending:"Collecting Data Pool / Analyzing Statistics",notScanned:"Not Scanned",notScannedDesc:"Please press the scan button on the top right to read diagnostic codes.",scanFailed:"SCAN FAILED",errTimeout:"Error: Connection Timeout\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error\nECU trouble codes could not be read.",scannedSystems:"SCANNED SYSTEMS",moduleEngine:"Engine Control Unit (ECU)",moduleAbs:"Anti-lock Braking System (ABS)",moduleTcm:"Transmission Control Module (TCM)",moduleBcm:"Body Control Module (BCM)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" SAFETY WARNING",safetyWarningDesc:"During this operation:\n\n\u2022 Ignition must be ON\n\u2022 Engine must be OFF\n\u2022 Do not start the vehicle\n\nDo you want to continue?",step1:"Step 1: Clear Trouble Codes",step1Desc:"All saved Trouble Codes (DTC) and Check Engine light will be cleared. Fuel trim values will be reset.\n\nThis action cannot be undone!",step2:"Step 2: ECU Hard Reset",step2Desc:"An electrical reset (Hard Reset) will be sent to the engine brain. Functions like battery disconnect/reconnect.\n\n Ineffective on unsupported ECUs. Will not cause harm.",clearCodes:"Clear Codes",ecuReset:"Clear DTCs",finish:"Skip (Finish)",completed:"Completed ",completedDesc:"Service operations completed successfully. You may restart the vehicle.",hardResetDesc:"All service operations completed successfully.\n\n\u2022 Trouble codes cleared\n\u2022 Fuel trims reset\n\u2022 ECU reset\n\nYou may restart the vehicle."},info:{desc:"Professional motorcycle and vehicle diagnostic application.\nCompatible with all vehicles.",upgrade:" Upgrade to Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"Early Access ",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner is currently in development. As an early user, all pro features are unlocked for you. Your feedback is very valuable!",helpGuide:"HELP & GUIDE",language:" Dil / Language / Bahasa",support:"SUPPORT CENTER",supportSubject:"Cortex OBD2 Diagnostic Scanner Support Ticket",shareWithFriend:"SHARE WITH A FRIEND",shareMessageText:"Discover vehicle ECU fault codes & live sensor telemetry with Cortex OBD2 Diagnostic Scanner!\n\nDownload Now:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/",thanks:"Thank You!",thanksDesc:"Thank you for your feedback. You can leave us a review on the Play Store.",sections:{featureCoding:{title:"HIDDEN FEATURE UNLOCK & UDS CODING",content:"Powered by our ISO 14229 UDS Protocol Engine, safely toggle features like US Parking Lights, Needle Sweep, Horn Ack Lock, Comfort Windows, and DRL settings for VAG, BMW, Renault, and Dacia vehicles."},multiEcu:{title:"MULTI-ECU ALL MODULE SCANNING",content:"Scan and clear fault codes beyond the Engine ECU \u2014 including ABS, Airbag, Automatic Transmission (TCU), Instrument Cluster, Climate Control (HVAC), and Body Control Modules (BCM)."},advancedDiagnostics:{title:"DCT ADAPTATION, DPF & HP POWER GAUGE",content:"\u2022 DCT / DSG Clutch Kiss Point Learning & Adaptation Reset\n\u2022 DPF Soot Load (%/g) & Exhaust Regeneration Temp Monitoring\n\u2022 Real-time Short/Long Term Fuel Trims (STFT/LTFT) & Lambda Analysis\n\u2022 Dynamic Horsepower (HP) & Torque (Nm) Live Telemetry Graph"},demoMode:{title:"DEMO MODE (SIMULATION)",content:"Test and explore the app without physical OBD2 hardware. Experience full CAN-Bus and UDS diagnostic features with realistic real-time telemetry simulation."},live:{title:"LIVE MONITORING SENSORS",content:"Monitor RPM, Speed, Engine Temperature, Throttle Position, Battery Voltage, Engine Load, Intake Air Temperature, and Manifold Pressure (MAP) in real-time.\n\nValues refresh 1-5 times per second depending on Bluetooth speed. You can interact directly with the vehicle via UDS / OBD commands in the terminal."},expertise:{title:"DIAGNOSTICS & WARRANTY",content:"The app uses ECU codes to detect faults. VIN and recorded mileage are retrieved.\n\nAdditionally, distance traveled with the Check Engine light is calculated to determine hitstorical faults. Reports can be shared via PDF or messaging platforms."},tests:{title:"BATTERY / PERFORMANCE TESTS",content:"Battery test consists of 3 stages: Resting, Cranking, and Idle Charge tests to measure battery/regulator health.\n\nPerformance test measures 0-60 and 0-100 km/h acceleration values with 50ms margin of error using your phone's processor and vehicle's live speed data."},hardware:{title:"HARDWARE COMPATIBILITY",content:"ELM327 Bluetooth (v1.5) is recommended. Some advanced codes may not work with low-quality v2.1 CLONE hardware. Get highest speed with premium adapters like vLinker and OBDLink."},warnings:{title:"IMPORTANT WARNINGS",content:"\u2022 Ignition must be ON, Engine must be OFF during trouble code clearing or ECU Reset.\n\u2022 Do not send Reset to a running vehicle.\n\u2022 Not every vehicle may support all sensors, unsupported sensors show \"--\"."},onboarding:{title:"LEGAL PERMISSIONS & ANONYMOUS TELEMETRY",content:"To improve application quality and vehicle compatibility, completely anonymized engine parameters and diagnostic trouble codes (excluding personal data and VIN) captured during diagnostics may be analyzed on our secure servers. By proceeding, you agree to these anonymous telemetry terms.\n\nBluetooth and Location permissions are required to establish a connection with your motorcycle's ECU."}},reconfigurePermissions:"Re-run Onboarding & Legal Terms"},report:{title:"MotoCortex \u2014 ECU & Vehicle Appraisal Report",subtitle:"Comprehensive Second-Hand Diagnostic & Telemetry Inspection",vehicleInfo:"Vehicle Identification & ECU Metadata",healthScore:"Overall ECU Health Score",dtcSection:"Diagnostic Trouble Codes (DTC Audit)",telemetrySection:"Live Telemetry & Sensor Snapshot",maintenanceSection:"Ak\u0131ll\u0131 Garaj Service & Maintenance History",aiSection:"AI Doctor Overall Condition Analysis",noFaults:"No active or historical fault codes stored in ECU memory.",noMaintenance:"No recorded service entries in Ak\u0131ll\u0131 Garaj.",disclaimer:"Disclaimer: This report is generated by MotoCortex diagnostic software. Physical inspection by a certified technician is recommended prior to vehicle acquisition.",shareTitle:"Share MotoCortex Appraisal Report",vehicleIdentity:"Vehicle Identity",vin:"VIN",odometer:"Odometer",milDist:"Distance Traveled with MIL ON",distSinceCleared:"Distance Since Codes Cleared",dtcCount:" FAULT CODES ({{count}} found)",sensorData:"Live Sensor Data",noData:"No Data Available",proApp:"Cortex OBD2 Diagnostic Scanner",date:"Report Date",vinNotFound:"VIN Not Found / Unable to Read",noDtcs:"No Diagnostic Fault Codes Found",speed:"Vehicle Speed",coolant:"Engine Coolant Temp",throttle:"Throttle Position",engineLoad:"Calculated Engine Load",intakeAir:"Intake Air Temp",manifold:"Intake Manifold Absolute Pressure",voltage:"Control Module Voltage",shareMessage:"Cortex OBD2 Diagnostic Report"},battery:{title:"BATTERY & CRANKING TEST",ready:"Ready to start the test.",restingStatus:"Ignition on, engine off... Reading battery voltage...",crankingStatus:"START THE ENGINE NOW! (5 seconds measurement)",chargingStatus:"Engine idling... Reading charging voltage...",doneStatus:"Test completed!",voltageError:"Voltage could not be read. Check the connection.",start:"START TEST",retry:"RETRY TEST",procedure:"TEST PROCEDURE",steps:{1:"1. Ignition on, engine off \u2192 Resting voltage measured",2:"2. Start the engine when \"START THE ENGINE NOW\" appears",3:"3. Lowest voltage during startup is recorded (5s)",4:"4. Charging/regulator voltage measured with engine running"},warning:"Do not disconnect Bluetooth during the test.",resting:"RESTING",cranking:"CRANKING",charging:"CHARGING",instantV:"CURRENT VOLTAGE",evaluation:"EVALUATION",verdicts:{full:"Battery: Fully charged",good:"Battery: Good condition",weak:"Battery: Weakening",empty:"Battery: Weak / Discharged",crankNormal:"Cranking: Normal drop",crankLow:"Cranking: Low voltage",crankCritical:"Cranking: Critical drop",regNormal:"Charging: Regulator normal",regLow:"Charging: Low charge",regHigh:"Charging: Overcharging",regFail:"Charging: Regulator faulty"},verdictLocked:"Upgrade to PRO to view detailed battery assessment report and cranking analysis graph."},freeze:{title:"FREEZE FRAME",snapshot:"FAULT SNAPSHOT",desc:"Reads engine parameters at the moment the Check Engine light turned on. This data provides critical info for diagnosis.",noDtcs:"No fault codes stored. Freeze Frame data may not be available.",read:"READ FREEZE FRAME",loading:"Querying Mode 02...",noData:"No freeze frame data found. Vehicle may not support this feature.",error:"Data read error",values:" VALUES RECORDED AT FAULT TIME",retry:"READ AGAIN",techInfo:"TECHNICAL INFO",techDesc:"\u2022 OBD-II Mode 02: Freeze Frame Data\n\u2022 PID 020C00: RPM at fault\n\u2022 PID 020D00: Speed at fault\n\u2022 PID 020500: Coolant temp at fault\n\nThis data belongs to the last fault code. Clearing codes will also clear freeze frame data.",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"PERFORMANCE TEST",seconds:"SECONDS",speed:"KM/H",idle:"Press the button and prepare to move.",ready:"READY! Start driving...",readyDesc:"Timer starts when speed > 0.",measuring:"MEASURING...",done:"TEST COMPLETED",start:"START TEST",stop:"STOP",reset:"RESET",howItWorks:"HOW IT WORKS?",howDesc:"1. Press \"Start Test\" button\n2. Vehicle must be stationary (Speed = 0)\n3. Timer starts automatically when you move\n4. 0-60 km/h and 0-100 km/h times are recorded\n\n Perform this test in a safe area!",sec:"sec"},dtc:{P0113:"Intake Air Temperature Sensor 1 Circuit High Input (IAT)",P0102:"Mass or Volume Air Flow (MAF) Circuit Low Input",P0300:"Random / Multiple Cylinder Misfire Detected",P0171:"System Too Lean (Bank 1 Fuel Trim)",P0420:"Catalyst System Efficiency Below Threshold (Bank 1)",P0560:"System Voltage Malfunction",P0562:"System Voltage Low",P0700:"Transmission Control System Malfunction (MIL Request)",P0715:"Input/Turbine Speed Sensor A Circuit Malfunction",P0750:"Shift Solenoid A Malfunction",P0814:"Transmission Range Display Circuit Malfunction",U0100:"Lost Communication With Engine Control Module (ECM/PCM)",U0121:"Lost Communication With Anti-Lock Brake System (ABS) Module",U0140:"Lost Communication With Body Control Module (BCM)",C0035:"Left Front Wheel Speed Sensor Circuit Malfunction",C0040:"Right Front Wheel Speed Sensor Circuit Malfunction",C0110:"ABS Pump Motor Circuit Malfunction",C0121:"Brake Pressure Sensor Circuit Malfunction",B0001:"Driver Front Stage 1 Deployment Control Circuit",B0010:"Passenger Front Stage 1 Deployment Control",B0020:"Left Side Airbag Deployment Control",B1000:"Body Control Module (BCM) Hardware Fault",B1325:"Device Power Supply Circuit Low Voltage",generalFault:"General Fault"},vehicleSelect:{connectionSection:"OBD Device Connection",title:"SELECT YOUR VEHICLE FOR DIAGNOSTIC ACCURACY",subtitle:"Please provide vehicle details for correct fault identification and protocol matching.",brand:"BRAND",selectBrand:"Select Brand...",searchBrand:"Search Brand...",searchLanguage:"Search Language...",customBrandPlaceholder:"e.g. Triumph, CFMoto, Kia...",model:"MODEL",selectModel:"Select Model...",searchModel:"Search Model...",customModelPlaceholder:"e.g. CBR600, Golf, Focus...",year:"MODEL YEAR",selectYear:"Select Year...",customYearPlaceholder:"e.g. 2018",disconnect:"DISCONNECT",confirm:"CONTINUE",errorBrand:"Please select or type a brand.",errorModel:"Please select or type a model.",errorYear:"Please select or type a valid year (e.g. 2018).",noResults:"No results found",selectVehiclePrompt:"PLEASE SELECT VEHICLE FIRST",selectedVehicle:"SELECTED VEHICLE",changeVehicle:"CHANGE",newVehicle:"Add New Vehicle",noVehicleTitle:"VEHICLE DETECTION REQUIRED",noVehicleDesc:"Vehicle identity will be automatically discovered via OBD-II connection. Please pair and connect to your device below.",titleMenu:"Vehicle & Connection",registeredVehiclesLabel:"REGISTERED VEHICLES",viewRegisteredList:"View Registered Vehicles",registeredVehicles:"MY REGISTERED VEHICLES",registeredVehiclesButton:"MY REGISTERED VEHICLES",connectDevice:"CONNECT TO OBD2 DEVICE",deleteConfirm:"Are you sure you want to delete this vehicle from registered vehicles?",noRegisteredVehicles:"No registered vehicles found.",selectVehicle:"SELECT",mismatchTitle:"Vehicle Mismatch",mismatchDesc:"The connected vehicle's manufacturer is detected as \"{{make}}\" from the VIN. However, your selected vehicle is \"{{selected}}\".\n\nWould you like to cancel the current selection and redefine it with the correct brand ({{make}})?",operations:{clearDtc:"Trouble Codes Cleared",fuelAdaptation:"Fuel Adaptation Reset",ecuReset:"ECU Reset"}},brands:{other:"Other",alfa_romeo:"Alfa Romeo",aprilia:"Aprilia",aston_martin:"Aston Martin",audi:"Audi",bajaj:"Bajaj",benelli:"Benelli",bmw_car:"BMW (Car)",bmw_moto:"BMW (Motorcycle)",cfmoto:"CFMoto",chery:"Chery / MG",chevrolet:"Chevrolet",citroen:"Citro\xebn",cupra:"Cupra",dacia:"Dacia",ducati:"Ducati",fiat:"Fiat",ford:"Ford",harley:"Harley-Davidson",hero:"Hero",honda_car:"Honda (Car)",honda_moto:"Honda (Motorcycle)",husqvarna:"Husqvarna",hyundai:"Hyundai / Kia",indian:"Indian",jeep:"Jeep",kawasaki:"Kawasaki",kia:"Kia",ktm:"KTM",kuba:"Kuba",kymco:"Kymco",land_rover:"Land Rover",lexus:"Lexus",mazda:"Mazda",mercedes:"Mercedes-Benz",mg:"MG",mitsubishi:"Mitsubishi",mondial:"Mondial",mv_agusta:"MV Agusta",nissan:"Nissan",opel:"Opel",peugeot:"Peugeot",peugeot_car:"Peugeot (Car)",peugeot_moto:"Peugeot (Motorcycle)",porsche:"Porsche",renault:"Renault / Dacia",rks:"RKS",seat:"Seat",skoda:"Skoda",subaru:"Subaru",suzuki_car:"Suzuki (Car)",suzuki_moto:"Suzuki (Motorcycle)",sym:"Sym",tesla:"Tesla",togg:"Togg",volkswagen:"Volkswagen / VAG",bmw:"BMW / MINI",gm:"GM / Chevrolet / GMC",dodge:"Dodge / RAM / Jeep",byd:"BYD EV",toyota:"Toyota / Lexus / Honda",stellantis:"Stellantis / Fiat",volvo:"Volvo / Polestar",yuki:"Yuki",tvs:"TVS",vespa:"Vespa",triumph:"Triumph"},permissions:{headerSubtitle:"PERMISSION GATEWAY",cardTitle:"Hardware Access Required",cardDesc:"To improve application quality and vehicle compatibility, completely anonymized engine parameters and diagnostic trouble codes (excluding personal data and VIN) captured during diagnostics may be analyzed on our secure servers. By proceeding, you agree to these anonymous telemetry terms.",btLabel:"Bluetooth (BLE)",btSub:"Used exclusively to pair and stream live CAN-bus/K-Line metrics from your ELM327/OBD2 adapter.",locLabel:"Fine Location",locSub:"Required by Android system architecture to discover low-energy Bluetooth beacons nearby. We do not track your drives.",grantBtn:"GRANT & CONTINUE",skipBtn:"Skip for now (Demo Mode)",deniedDesc:"Some permissions were denied. Cortex OBD2 Diagnostic Scanner may not be able to scan or connect to OBD2 devices successfully.",proceedAnyway:"Proceed Anyway",openSettings:"Open Settings",langTitle:"Select Language",nextBtn:"CONTINUE",langDesc:"Please select your preferred language to customize your diagnostics experience.",langSelectSub:"LANGUAGE GATEWAY",telemetryLabel:"Diagnostic Telemetry (Opt-In)",telemetrySub:"Share anonymous protocol and error logs to improve vehicle compatibility.",restartOnboarding:"Restart Initial Setup (Language & Permissions)"},obdTerminal:{title:"OBD HEALTH & TERMINAL",terminalTitle:"OBD TERMINAL",terminalPlaceholder:"Type command below to send to ECU (e.g. 010C, ATRV)",inputPlaceholder:"Enter command...",sendButton:"SEND",statsTitle:"OBD HEALTH STATISTICS",connectionProtocol:"Connection Protocol:",none:"None",hardwareQualityScore:"Hardware Quality Score:",original:"Original",clone:"Clone",requestResponseCount:"Request / Response Count:",timeoutCount:"Timeout Count:",recoveryCount:"Recovery Count (Recovery):",diagnosticLogTitle:"DIAGNOSTIC LOG",clearButton:"CLEAR",shareButton:"SHARE",noLogs:"No diagnostic logs found.",noShareSupport:"Sharing features are not available on this device."},disconnectShort:"DISC",dtcContext:{powertrain:"This fault may affect fuel economy and engine performance. Unlock full diagnosis \u2192",cooling:"Critical cooling hazard detected. View detailed repair steps \u2192",ignition:"Ignition system issue detected. View detailed repair steps \u2192",chassis:"Chassis safety system alert. Unlock PRO for full analysis \u2192",body:"Body electronics fault found. Upgrade for complete diagnostics \u2192",network:"Communication network error. PRO unlocks full troubleshooting \u2192",fallback:"Unlock detailed fault analysis, repair costs & risk assessment \u2192"},perfTeaser:{limitTitle:"Daily Limit Reached",limitDesc:"You have reached the daily limit of 3 free 0-60 km/h tests. Upgrade to PRO for unlimited tests and 0-100 km/h measurements."},sandbox:{title:"Sandbox Telemetry Control",connectionStatus:"Connection Status:",ecuStatus:"ECU Status:",fps:"UI Performance: {{fps}} FPS",stressBtnStart:"Start 20Hz Stress",stressBtnStop:"Stop Telemetry Loop",stopDisconnect:"Stop / Disconnect",discoveredDevices:"DISCOVERED DEVICES",connect:"CONNECT",scanning:"Scanning...",scan:"Scan Devices",rpm:"Engine RPM",speed:"Vehicle Speed",coolant:"Coolant Temp",throttle:"Throttle Position",notConnected:"Not Connected",connected:"Connected",connecting:"Connecting...",error:"Error",openSandbox:"DIAG",advancedTerminal:"Advanced Connection Terminal (DIAG)",terminalTitle:"Live Terminal & Bus Monitor",pause:"PAUSE",resume:"RESUME",share:"SHARE",clear:"CLEAR",clearDtcs:"CLEAR DTC",dtcTitle:"DTC DIAGNOSTICS & FAULT CODES",noDtcs:"NO DTC CODES FOUND IN ECU",readDtcs:"READ DTC",sendDtcs:"SEND"},hiddenFeatures:{title:"Hidden Features",btnLabel:"Unlock Hidden Features",unsupported:"This OBD2 adapter does not support unlocking hidden features.",unsupportedDesc:"Original ELM327 v2.1 or higher is required. Clone adapters are not supported.",notConnected:"Please connect to a vehicle first.",notConnectedDesc:"OBD2 device must be connected.",warning:"These changes may affect your vehicle's warranty.",confirmTitle:"Confirmation Required",confirmMsg:"Changing this feature affects ECU controller settings. Do you want to proceed?",confirmOk:"Continue",confirmCancel:"Cancel",categoryLighting:"Lighting",categorySound:"Sound & Alerts",categoryDisplay:"Instrument Cluster",categoryDriving:"Driving",featureDrl:"Daytime Running Lights (DRL)",featureRearFog:"Rear Fog Light Override",featureDoorChime:"Disable Door Chime",featureParkingAlert:"Handbrake Acoustic Alert",featureRpmWarning:"RPM Limit Warning",featureFuelSensitivity:"Fuel Gauge Sensitivity",featureStartStop:"Start-Stop Disabled by Default",featureSportMemory:"Sport Mode Memory",enabled:"Enabled",disabled:"Disabled",writeSuccess:"Feature updated successfully.",writeError:"Write error. Please try again.",simulationBanner:"Simulation Mode \u2014 Actual writing to ECU is not active yet",closeBtn:"Close",disclaimerTitle:"LIABILITY DISCLAIMER",disclaimerFeature:"Feature",disclaimerBody:"Changing this feature directly affects your vehicle's factory settings and ECU software. Please read the following risks carefully:\n\n\u2022 Incorrect application may void your vehicle warranty.\n\u2022 Some changes may cause permanent faults or unexpected electrical errors.\n\u2022 While the operation may be reversible, some ECU modules may require a factory reset.\n\u2022 The user is solely responsible for any material or immaterial damage resulting from the use of this feature.\n\u2022 Cortex OBD2 Diagnostic Scanner cannot be held responsible for any malfunction or damage caused by these changes.\n\nYou must confirm that you have read and understood this warning.",checkboxTitle:"CONFIRMATION REQUIRED",check1:"I have read this warning and understand that my vehicle warranty may be affected.",check2:"I acknowledge that Cortex OBD2 Diagnostic Scanner is not responsible for any faults or damages resulting from this operation.",check3:"I wish to make this change knowingly and of my own free will, accepting all risks.",disclaimerCancel:"CANCEL",disclaimerContinue:"CONTINUE",unsupportedTitle:"Not Supported",unsupportedMsg:"The connected OBD2 device does not yet support this feature.\n\nA compatible ELM327 v2.1+ adapter is required for hidden feature writing. Clone or standard adapters cannot process these commands.",unsupportedOk:"OK"},secretDebug:{title:"MOTO CORTEX DEV PANEL",logFileSize:"Black Box / File Size:",dtcCloudSync:" DTC CLOUD SYNCHRONIZATION",lastSync:"Last Sync",syncNow:"Sync Now",developerTools:"DEVELOPER TOOLS",trialResetSuccess:"Free Trial counter reset successfully!",crashTestTitle:"Crash Test",crashTestDesc:"The application will now crash intentionally. Confirm to verify Crashlytics integration.",crashButton:"Crash",crashTest:"Crash Test"},features:{headerCategory:"Hidden Features & Coding",title:"UNLOCK HIDDEN FEATURES & UDS CODING",subTitle:"ISO 14229 UDS Long Coding & Adaptation Engine",batteryVoltage:"BATTERY VOLTAGE",voltageReady:" Safe (Ready for ECU Coding Write)",voltageLocked:" Low Voltage (Coding Locked, Read Active)",locked:"LOCKED",ready:"READY",vehicleMatched:"{{make}} \u2014 MATCHED",demoModeVehicle:"DEMO MODE: {{make}}",waitingVehicle:"WAITING FOR CONNECTED VEHICLE",activeFeaturesCount:"{{count}} vehicle-specific OEM features active",demoFeaturesCount:"{{count}} demo features listed",connectForFeaturesNote:"Connect to an OBD2 device to list vehicle-specific features",allMarks:"ALL MARKS",writeBtn:"WRITE",catLighting:"LIGHTING",catSound:"SOUND & ALERTS",catDisplay:"INSTRUMENTS",catComfort:"COMFORT",catSafety:"SAFETY",catMotorcycle:"MOTORCYCLE ECU",catRetrofit:"RETROFIT & HARDWARE",catEv:"EV & BATTERY",catAdas:"ADAS CALIBRATION",catEasterEgg:"EASTER EGGS",catService:"SERVICE & MAINTENANCE",catPerformance:"PERFORMANCE",segmentAll:"ALL MAKES",segmentEuroPremium:" European Premium",segmentEuroVolume:" European Volume",segmentAsian:" Asian",segmentAmerican:" American",segmentChineseEv:" Chinese EV",segmentMotorcycle:" Motorcycle",expertModeTitle:"Expert Mode (Raw DID Hex Editor)",expertSafetyNote:"For advanced users only. In case of incorrect coding, use 'Restore Factory Settings' below to revert to original state.",expertDidPlaceholder:"DID Hex (e.g. 0501)",expertValPlaceholder:"Value Hex (e.g. 01)",writeRawPayload:"WRITE RAW UDS PAYLOAD",restoreFactoryBtn:"RESTORE FACTORY SETTINGS",restoreFactoryTitle:"RESTORE FACTORY SETTINGS",enterDidFirst:"Please enter the DID Hex code to restore (e.g. 0501).",restoreConfirmMsg:"Revert to original factory state for DID 0x{{didHex}}?",restoreAction:"RESTORE FACTORY",enterValidHex:"Please enter valid DID and Value Hex strings.",detailTitle:"Feature Details & One-Click Coding",prePostValues:"Pre / Post Payload Preview",selectOption:"Select Coding Option:",oneClickActivate:"ONE-CLICK ACTIVATE",cloneLockedBanner:" Clone Adapter Detected \u2014 Coding Locked (Read-Only Mode)",cloneAlertTitle:" Clone OBD2 Adapter Detected",cloneAlertMsg:"Your connected OBD2 adapter was flagged as a counterfeit clone adapter lacking strict timing accuracy required for ECU writing.\n\nYou can browse and search all features, but coding write operations are locked to protect your vehicle. Please connect a genuine ELM327 v2.1+ or vLinker adapter for writing.",riskLow:"LOW RISK",riskMedium:"MEDIUM RISK",riskHigh:"HIGH RISK",sfdProtected:"SFD Protected ECU",legalDisclaimerUsLights:" Note: Continuous US parking lights may not be street legal in some European jurisdictions.",legalDisclaimerVim:" Note: Video playback while driving is intended for passenger use only.",safetyAlertTitle:" Low Battery Voltage Alert",allMakes:"ALL MAKES",techEcuSpecs:"TECHNICAL ECU SPECIFICATIONS & PAYLOAD PREVIEW",targetEcuHeaderLabel:"Target ECU Header:",udsDidLabel:"UDS Data Identifier (DID):",bitPositionLabel:"Bit Position:",targetPayloadLabel:"Target UDS Payload:",byteBitValue:"Byte {{byte}}, Bit {{bit}}",items:{vag_oil_service_reset:{name:"Oil Service Interval Reset (VAG)",desc:"Resets oil change service counter and inspection interval for VAG vehicles."},bmw_oil_service_reset:{name:"CBS Engine Oil Reset (BMW)",desc:"Resets Condition Based Service (CBS) oil life percentage back to 100%."},generic_oil_service_reset:{name:"Universal Oil Maintenance Indicator Reset",desc:"Clears dashboard oil maintenance warning light across supported OBD2/UDS ECUs."},vag_epb_pad_change:{name:"EPB Brake Pad Replacement Mode (VAG)",desc:"Retracts electronic parking brake calipers for rear brake pad servicing."},bmw_epb_pad_change:{name:"EPB Brake Service Mode (BMW)",desc:"Opens parking brake actuator to service position for rear pad replacement."},mb_epb_pad_change:{name:"EPB Pad Fitting Mode (Mercedes-Benz)",desc:"Releases parking brake spindle to workshop position for brake service."},vag_dpf_regen:{name:"DPF Service Regeneration Trigger (VAG)",desc:"Initiates stationary Diesel Particulate Filter (DPF) soot burn-off cycle."},bmw_dpf_regen:{name:"DPF Forced Regeneration Trigger (BMW)",desc:"Requests DDE ECU to start active particulate filter regeneration routine."},psa_dpf_regen:{name:"DPF Regeneration Request (Peugeot/Citro\xebn)",desc:"Triggers stationary DPF regeneration for HDi diesel engine ECUs."},bmw_bms_battery_register:{name:"BMS Battery Replacement Registration (BMW)",desc:"Registers new battery replacement with DME/DDE Intelligent Battery Sensor."},mb_bms_battery_register:{name:"Battery Registration & Reset (Mercedes-Benz)",desc:"Resets battery aging counter in SAM module after new battery installation."},vag_sas_calibrate:{name:"Steering Angle Sensor (SAS) Calibration (VAG)",desc:"Calibrates G85 steering angle sensor zero-point position for ABS/ESP ECU."},toyota_sas_calibrate:{name:"Steering Angle Zero Point Calibration (Toyota)",desc:"Performs zero point calibration of steering angle sensor in Skid Control ECU."},generic_tba_adapt:{name:"Throttle Body Alignment & Adaptation",desc:"Executes electronic throttle body stop learning routine in engine ECU."},epb_service_reset:{name:"Universal EPB Maintenance Reset",desc:"Resets electronic park brake caliper wear counter and calibrates air gap."},vag_dsg_reset:{name:"DSG Transmission Basic Settings Reset (VAG)",desc:"Resets clutch engagement points and shift valve adaptations for DSG/S-Tronic."},bmw_zf_reset:{name:"ZF 8HP Transmission Adaptation Reset (BMW)",desc:"Clears EGS transmission shift time and pressure adaptation values."},bmw_brake_fluid_reset:{name:"Brake Fluid Service Interval Reset (BMW)",desc:"Resets Condition Based Service (CBS) 2-year brake fluid change timer."},ford_injector_code:{name:"Injector Correction Factor Coding (Ford)",desc:"Programs 16-character IQA codes for diesel injectors into PCM."},bmw_injector_code:{name:"Fuel Injector Flow Rate Coding (BMW)",desc:"Writes energy calibration values for replaced fuel injectors into DME."},generic_headlight_aim:{name:"Headlight Auto-Leveling Calibration",desc:"Sets reference zero position for adaptive auto-leveling headlight motors."},bmw_12v_battery_reg:{name:"12V Auxiliary Battery Registration (BMW)",desc:"Registers auxiliary AGM starter/support battery replacement in PCU."},vag_comfort_turn_signal:{name:"Comfort Turn Signal Blink Count (VAG)",desc:"Adjusts lane change blinker cycle count between 3, 4, and 5 flashes."},vag_coming_home_duration:{name:"Coming/Leaving Home Light Duration (VAG)",desc:"Configures headlight illumination timer after vehicle locking (10s - 60s)."},vag_remote_windows:{name:"Remote Convenience Window Control (VAG)",desc:"Enables opening and closing power windows via remote key fob long press."},vag_auto_lock_15kmh:{name:"Auto Door Lock at 15 km/h (VAG)",desc:"Automatically locks all doors when vehicle speed reaches 15 km/h."},vag_sfd_unlock_prep:{name:"SFD Gateway Protection Status Prep (VAG 2020+)",desc:"Prepares MQB-evo SFD gateway token session for writing protected DIDs."},bmw_asd_deactivate:{name:"Active Sound Design (ASD) Deactivation (BMW)",desc:"Mutes synthetic engine sound played through cabin speakers."},bmw_comfort_turn_signal:{name:"Comfort Turn Signal Count (BMW)",desc:"Sets one-touch indicator pulse count (1 to 5 blinks)."},bmw_mirror_fold_lock:{name:"Comfort Access Mirror Fold on Lock (BMW)",desc:"Automatically folds side mirrors immediately upon locking vehicle."},toyota_coming_home_duration:{name:"Headlight Courtesy Delay / Coming-Home (Toyota)",desc:"Configures headlight off delay timer after ignition shutdown (30s-120s)."},toyota_lane_change_flash:{name:"Lane-Change Turn Signal Flash Count (Toyota)",desc:"Adjusts one-touch lane change blinker cycle count."},toyota_remote_window_close:{name:"Remote Power Window Closure (Toyota)",desc:"Allows closing all power windows by holding remote lock button."},toyota_autolock_behavior:{name:"Auto Door Lock/Unlock Customization (Toyota)",desc:"Sets door locking trigger (Shift out of P vs Vehicle Speed > 20 km/h)."},toyota_approach_welcome_lights:{name:"Smart Key Approach Welcome Lights (Toyota)",desc:"Turns on interior puddle/cabin lights when smart key approaches vehicle."},hyundai_autolock_behavior:{name:"Auto Door Lock/Unlock Behavior (Hyundai/Kia)",desc:"Automatically locks doors on shift or speed and unlocks on P or Ignition Off."},hyundai_window_remote:{name:"Remote Window Open/Close (Hyundai/Kia)",desc:"Enables rolling windows up/down using smart key fob buttons."},hyundai_sport_mode_memory:{name:"Drive Mode Select Memory (Hyundai/Kia)",desc:"Remembers last selected Drive Mode (Sport/Eco) after engine restart."},tesla_charge_limit_custom:{name:"Battery Charge Limit Customization (Tesla)",desc:"Sets default HV battery charge limit percentage (80% Daily / 100% Trip)."},tesla_mirror_fold_lock:{name:"Mirror Auto-Fold on Walk-Away Lock (Tesla)",desc:"Automatically folds side mirrors when phone key walk-away lock triggers."},nissan_coming_home:{name:"Courtesy Headlight Off Delay (Nissan)",desc:"Keeps headlights illuminated for 30 seconds after exiting Nissan vehicle."},nissan_lane_change_flash:{name:"Tap-to-Pass Lane Change Flash Count (Nissan)",desc:"Sets turn signal indicator pulse count on light stalk tap."},nissan_autolock_behavior:{name:"Speed-Dependent Automatic Door Lock (Nissan)",desc:"Locks all doors automatically when vehicle reaches 24 km/h."},nissan_window_remote:{name:"Remote Key Fob Power Window Control (Nissan)",desc:"Opens/closes front windows via key fob unlock button long press."},nissan_seatbelt_chime_mute:{name:"Seatbelt Warning Audio Chime Suppress (Nissan)",desc:"Mutes repetitive seatbelt warning chime while keeping cluster icon."},porsche_sport_chrono_launch:{name:"Sport Chrono Launch Control Response Profile (Porsche)",desc:"Optimizes PDK transmission launch control RPM threshold & clutch bite."},porsche_pasm_default:{name:"PASM Suspension Mode Startup Preset (Porsche)",desc:"Sets PASM adaptive suspension default stiffness on ignition start."},porsche_exhaust_flap:{name:"Sport Exhaust Flap Constant Open Override (Porsche)",desc:"Forces active exhaust valves to stay 100% open across all RPM ranges."},audi_drive_select_memory:{name:"Audi Drive Select Mode Memory Retention (Audi)",desc:"Retains last active Drive Select profile (Dynamic/Individual) upon restart."},audi_virtual_cockpit_themes:{name:"Audi Virtual Cockpit S/RS Sport Graphic Layout (Audi)",desc:"Unlocks S/RS central tachometer layout options on Virtual Cockpit."},vag_epb_service_mode:{name:"Electronic Parking Brake (EPB) Brake Pad Service Mode",desc:"Retracts rear EPB caliper pistons for rear brake pad and rotor replacement."},bmw_bms_battery_registration:{name:"Intelligent Battery Sensor (IBS) Battery Registration",desc:"Registers new 12V AGM/Lead-acid battery replacement in DME/DDE engine management."},bmw_motorrad_service_indicator_reset:{name:"BMW Motorrad Annual Service & Oil Indicator Reset",desc:"Clears annual service date and 10,000 km distance reminder on TFT instrument cluster."},ducati_desmo_service_reset:{name:"Ducati Desmo Valve Service Reminder Clear",desc:"Clears Desmoservice wrench icon on dashboard after 15,000 / 30,000 km service."},byd_bms_isolation_self_test:{name:"BYD Blade Battery High-Voltage Isolation Self-Test",desc:"Executes high-voltage system (400V/800V) leakage & resistance diagnostics in BMS."},vag_drl_brightness_multi:{name:"Daytime Running Lights (DRL) Brightness Adjustment",desc:"Adjust LED DRL intensity level for low-beam / parking mode."},bmw_comfort_turn_signal_cycles:{name:"One-Touch Comfort Turn Signal Pulse Count",desc:"Select how many blinks occur on quick tap of turn indicator lever."},vag_staging_needle_sweep:{name:"Gauge Staging / Needle Sweep",desc:"Sweeps instrument needles to maximum upon ignition start."},vag_acoustic_lock_confirmation:{name:"Acoustic Lock Confirmation Chirp",desc:"Emits a short horn confirmation chirp upon key fob locking."},vag_american_parking_lights:{name:"US Style Parking Lights",desc:"Illuminates front turn signals continuously at 20% dimming with parking lights."},vag_drl_menu_toggle:{name:"Daytime Running Lights (DRL) Menu Toggle",desc:"Enables DRL ON/OFF checkbox in infotainment vehicle settings menu."},vag_tear_wiping:{name:"Windshield Tear Wiping",desc:"Executes an additional final wipe 5 seconds after windshield washer use."},vag_emergency_brake_flashing:{name:"Emergency Brake Hazard Flashing",desc:"Rapidly flashes brake lights and hazards under heavy emergency braking."},vag_cornering_lights:{name:"Cornering Fog Lights",desc:"Illuminates cornering fog light on steering wheel rotation side."},vag_comfort_mirror_folding:{name:"Key Fob Comfort Mirror Folding",desc:"Automatically folds side mirrors when lock button is held on key fob."},vag_lap_timer:{name:"Instrument Cluster Lap Timer",desc:"Unlocks track lap timer display tab in instrument cluster screen."},vag_refuel_quantity:{name:"Refuel Quantity Display",desc:"Displays exact volume in liters required for a full fuel refuel."},bmw_start_stop_memory:{name:"Auto Start-Stop Memory Mode",desc:"Remembers last Auto Start-Stop state (OFF/ON) across vehicle restarts."},bmw_digital_speedometer:{name:"Digital Speedometer Display",desc:"Adds instant digital speed numerical display option to cluster screen."},bmw_sport_displays:{name:"Sport Displays (HP & Nm Gauges)",desc:"Enables live horsepower and torque dynamic dials in iDrive screen."},bmw_acoustic_lock_sound:{name:"Acoustic Lock/Unlock Sound",desc:"Emits alarm system chirps when locking or unlocking the vehicle."},bmw_mirror_fold_delay_zero:{name:"Instant Mirror Folding (0.0s Delay)",desc:"Folds side mirrors instantly upon lock button press without holding delay."},bmw_tpms_tire_temperature:{name:"Tire Pressure & Temperature Display",desc:"Displays real-time tire temperature alongside pressure in TPMS screen."},renault_trip_computer_enable:{name:"On-Board Trip Computer Enable",desc:"Unlocks average fuel consumption and range trip computer displays."},renault_external_temp_display:{name:"External Temperature Display",desc:"Enables ambient outdoor temperature reading in instrument cluster."},renault_automatic_tailgate:{name:"Key Fob Trunk Release",desc:"Fully pops trunk latch mechanism upon holding key fob trunk button."},renault_alarm_chirp:{name:"Alarm Lock Confirmation Chirp",desc:"Sounds horn confirmation chirp upon vehicle door locking."},renault_shift_indicator:{name:"Gear Shift Indicator (GSI)",desc:"Activates eco-driving shift UP/DOWN arrows in instrument cluster."},ford_double_horn_honk_disable:{name:"Disable Double Horn Honk on Door Close",desc:"Disables double horn honk when closing door with engine running."},ford_auto_door_locking:{name:"Auto Door Locking at 20 km/h",desc:"Automatically locks all doors when vehicle speed exceeds 20 km/h."},ford_tpms_psi_display:{name:"Numerical Tire Pressure Display",desc:"Displays exact numerical PSI/BAR pressure per tire in instrument screen."},ford_sync_climate_screen:{name:"SYNC Screen Climate Controls",desc:"Adds climate control and seat heating touchscreen menu to SYNC display."},stellantis_power_windows_remote:{name:"Key Fob Remote Window Roll Up/Down",desc:"Rolls up or down all power windows when holding lock/unlock buttons."},stellantis_cornering_fogs:{name:"Cornering Fog Lights Enable",desc:"Illuminates cornering fog lamp during low-speed turns."},vag_traffic_sign_recognition:{name:"Traffic Sign Recognition (VZE)",desc:"Displays camera-detected speed signs in instrument cluster and HUD."},vag_ambient_color_palette_30:{name:"30-Color Ambient Lighting Palette",desc:"Unlocks 30 RGB interior lighting color picker in MIB infotainment menu."},vag_seatbelt_warning_mute:{name:"Seatbelt Chime Deactivation",desc:"Disables unbuckled seatbelt acoustic chime in instrument cluster."},bmw_alpina_cluster_theme:{name:"Alpina Digital Dash Layout",desc:"Applies blue Alpina signature theme to digital instrument cluster."},bmw_video_in_motion:{name:"Video In Motion (VIM)",desc:"Unlocks USB video playback on iDrive screen while driving."},bmw_sport_plus_mode_unlock:{name:"Sport+ Driving Mode Enable",desc:"Enables Sport+ high-performance dynamic driving mode in DEC selector."},mercedes_amg_menu_unlock:{name:"AMG Performance Telemetry Menu",desc:"Displays AMG oil temp, transmission temp, lap timer, and G-meter."},mercedes_agility_mode_enable:{name:"Agility (A) Transmission Mode",desc:"Unlocks ultra-responsive Agility shift program in 7G/9G-Tronic transmission."},mercedes_drl_brightness_boost:{name:"Daytime Running Lights 100% Intensity",desc:"Increases LED daytime running lights output to 100% full brightness."},mercedes_alarm_lock_chirp:{name:"Acoustic Locking Horn Chirp",desc:"Emits short horn chirp notification when central locking is engaged."},mercedes_dpf_adblue_gauge:{name:"DPF Soot & AdBlue Level Gauge",desc:"Displays exact DPF soot mass percentage and remaining AdBlue range in IC."},renault_rs_monitor_enable:{name:"Renault Sport RS Monitor Telemetry",desc:"Enables live G-force, turbo boost, and oil temp telemetry on R-Link."},renault_duster_mirror_fold:{name:"Duster Auto Mirror Folding on Lock",desc:"Folds side mirrors automatically via BCM central locking command."},ford_bambi_mode_fog_light:{name:"Bambi Mode (High Beams + Fog Lights)",desc:"Allows fog lights to remain ON when high beam headlights are activated."},ford_st_rs_boot_animation:{name:"ST/RS Performance SYNC Boot Screen",desc:"Changes SYNC touchscreen startup splash animation to ST / RS logo."},toyota_reverse_beep_mute:{name:"Reverse Gear Continuous Cabin Beep Mute",desc:"Mutes continuous reverse gear chime inside cabin to a single beep."},toyota_remote_window_drop:{name:"Key Fob Remote Window Roll Down",desc:"Rolls down all power windows when holding key fob unlock button."},toyota_auto_lock_shift_p:{name:"Auto Lock Doors on Gear Shift (P -> D)",desc:"Automatically locks all doors when shifting out of Park position."},peugeot_icockpit_theme_unlock:{name:"Peugeot 3D i-Cockpit Performance Theme",desc:"Unlocks Copper and Track Red color display themes on 3D digital cluster."},jeep_offroad_pages_enable:{name:"Jeep Uconnect Off-Road Pages",desc:"Enables pitch/roll angle gauges, wheel articulation, and 4x4 lock status."},hyundai_smart_welcome_mirror:{name:"Smart Key Approach Welcome Mirror Unfold",desc:"Automatically unfolds side mirrors when approaching vehicle with smart key."},hyundai_one_touch_turn_7_flashes:{name:"One-Touch Lane Change Signal (7 Flashes)",desc:"Sets one-touch lane change blinker duration to 7 flashes."},hyundai_svm_camera_speed_extend:{name:"360\xb0 Surround Camera Speed Extension (20 km/h)",desc:"Keeps 360-degree parking camera active up to 20 km/h forward speed."},hyundai_n_performance_exhaust_flap:{name:"N-Performance Exhaust Flap Default OPEN",desc:"Sets active exhaust valve default position to OPEN on engine start."},vag_rain_closing_sunroof:{name:"Rain Closing (Regenschlie\xdfen)",desc:"Automatically closes sunroof and windows when rain is detected while parked."},bmw_launch_control_unlock:{name:"Launch Control Unlock",desc:"Unlocks factory launch control acceleration program in transmission ECU."},mercedes_ambient_64_multi_zone:{name:"64-Color Multi-Zone Ambient Profile",desc:"Unlocks dynamic multi-zone color cycle animation in MBUX interior lighting."},ford_trailer_brake_activation:{name:"Trailer Brake Controller (TBC) Enable",desc:"Enables integrated trailer brake controller menu in instrument cluster."},gm_afm_dfm_cylinder_deactivation_disable:{name:"AFM/DFM V8 Cylinder Lock (No V4 Drop)",desc:"Locks engine in 8-cylinder mode permanently to prevent V4 vibration."},gm_remote_start_time_extend:{name:"Remote Start Duration Extension (20 Mins)",desc:"Extends factory key fob remote engine start run time from 10 to 20 minutes."},dodge_srt_performance_pages:{name:"SRT Performance Pages & Drive Modes",desc:"Unlocks Uconnect 0-100 acceleration timers, G-force meter, and launch control."},ram_bambi_mode_fog:{name:"RAM Truck Fog Lights with High Beam",desc:"Allows RAM fog lights to remain active alongside high beam headlights."},byd_avas_pedestrian_siren_mute:{name:"AVAS EV Low-Speed Siren Mute",desc:"Mutes low-speed artificial electric motor siren below 30 km/h."},chery_isa_overspeed_chime_mute:{name:"ISA Overspeed Warning Chime Deactivation",desc:"Disables continuous 80/120 km/h overspeed warning beep on Tiggo/MG models."},mg_ev_battery_preconditioning_toggle:{name:"EV Fast-Charge Battery Pre-Heating Manual Switch",desc:"Enables manual battery pre-heating switch before DC fast charging."},chery_dms_fatigue_camera_mute:{name:"Driver Monitoring (DMS) Camera Sensitivity Reduction",desc:"Reduces over-sensitive eye-tracking fatigue warnings on steering column."},honda_walk_away_auto_lock:{name:"Walk-Away Auto Door Lock",desc:"Automatically locks all doors when driver steps 2 meters away with key fob."},subaru_avh_auto_hold_memory:{name:"Auto Vehicle Hold (AVH) Memory Mode",desc:"Remembers AVH brake hold ON/OFF state across ignition cycles."},volvo_start_stop_default_off:{name:"Auto Start-Stop Default OFF Mode",desc:"Sets Start-Stop engine shutoff system default state to OFF upon vehicle start."},volvo_polestar_digital_theme:{name:"Polestar Blue Digital Cluster Theme",desc:"Unlocks Polestar signature blue dynamic gauge theme in Volvo driver display."},vag_virtual_cockpit_r_theme:{name:"Virtual Cockpit R / S / Cupra Performance Themes",desc:"Unlocks R-Line, S-Line, and Cupra central tachometer performance themes in digital cockpit."},vag_sound_symposer_mute:{name:"Sound Symposer Fake Engine Noise Deactivation",desc:"Deactivates cabin speaker fake engine sound generator for pure exhaust note."},vag_wireless_carplay_enable:{name:"Wireless Apple CarPlay & Android Auto Activation",desc:"Enables 5GHz Wi-Fi wireless Apple CarPlay and Android Auto on MIB2.5/MIB3 units."},vag_offroad_telemetry_menu:{name:"MIB Offroad Telemetry & Gauge Display",desc:"Displays steering angle, oil temp, coolant temp, and altitude gauges on MIB screen."},vag_easy_entry_driver_seat:{name:"Automatic Easy Entry Power Seat Back-step",desc:"Moves electric driver seat back 5 cm upon door opening for easy vehicle entry."},vag_hba_memory_state:{name:"High-Beam Assist (HBA) Memory Retention",desc:"Remembers High-Beam Assist ON status across ignition restart cycles."},vag_battery_soc_display:{name:"Battery State of Charge (% SOC) Display",desc:"Shows exact battery charge percentage (% SOC) on instrument cluster when trip button is held."},bmw_idrive7_m_animation:{name:"iDrive 7 / 8 M-Performance Startup Animation",desc:"Changes iDrive screen boot graphic to M-Performance or M-GmbH logo animation."},bmw_bowers_wilkins_audio_profiles:{name:"Bowers & Wilkins 3D Sound Engine Unlock",desc:"Unlocks Bowers & Wilkins Concert, Studio, and Stage DSP audio profiles on HiFi systems."},bmw_hitch_zoom_camera:{name:"Reverse Camera Trailer Hitch Zoom Mode",desc:"Unlocks top-down trailer hitch alignment zoom mode on reverse camera view."},bmw_secure_idle_protection:{name:"Secure Idle Engine Shift-Lock Protection",desc:"Locks transmission in Park if driver leaves running vehicle with key fob."},bmw_seatbelt_handover_mute:{name:"Coupe Electric Seatbelt Handover Arm Deactivation",desc:"Disables motorized seatbelt extender arm on 4 Series and 2 Series Coupes."},bmw_auto_heat_threshold_5c:{name:"Automatic Seat & Steering Wheel Heating Temperature (+5\xb0C)",desc:"Triggers automatic seat and steering wheel heating when ambient temp drops below 5\xb0C."},mercedes_amg_track_pace_unlock:{name:"MBUX AMG Track Pace Telemetry & Lap Timer",desc:"Unlocks lap timing, acceleration telemetry, and G-force graphs on MBUX screen."},mercedes_drive_mode_last_memory:{name:"Dynamic Select Last Drive Mode Memory",desc:"Remembers last selected Drive Mode (Individual / Sport) across vehicle restart."},mercedes_proximity_360_camera_auto:{name:"Proximity Sensor Auto 360\xb0 Camera View",desc:"Automatically switches screen to 360 camera when front sensors detect obstacle < 50 cm."},ford_sync_climate_screen_unlock:{name:"SYNC3 / SYNC4 Touchscreen Climate Control Page",desc:"Enables climate control, heated seat, and airflow direction touchscreen page."},ford_turn_signal_5_flashes:{name:"One-Touch Lane Change Signal (5 Flashes)",desc:"Increases one-touch lane change turn signal duration from 3 to 5 flashes."},ford_auto_engine_shutdown_disable:{name:"30-Minute Idle Auto Engine Shutdown Override",desc:"Prevents automatic engine shutoff after 30 minutes idle (for camping/power outlet use)."},ev_battery_preheat_manual_switch:{name:"EV Battery Pre-Heating Manual Switch (Fast DC Charge Prep)",desc:"Allows manual battery pre-heating to 25\xb0C before DC fast charging without navigation route."},ev_v2l_power_output_expand:{name:"V2L (Vehicle-to-Load) 220V Outlet Power Expansion (3.6 kW)",desc:"Expands V2L external 220V AC household power outlet limit from 2.2 kW to 3.6 kW."},ev_one_pedal_regen_force_level3:{name:"One-Pedal Drive Maximum Regenerative Braking Default",desc:"Sets maximum regenerative braking (One-Pedal stop mode) as default on vehicle start."},byd_soc_max_charge_target_limit:{name:"BYD Battery Health Protection Max Charge Limit (80% / 90%)",desc:"Sets max AC/DC charge cutoff limit to 80% or 90% to extend Blade Battery lifespan."},byd_dmi_forced_pure_ev_speed_override:{name:"BYD DM-i Pure EV Mode Gasoline Engine Override",desc:"Inhibits gasoline engine start in EV mode up to 130 km/h even during full throttle acceleration."},byd_vtol_v2v_rescue_charge_mode:{name:"BYD VTOL (Vehicle-to-Vehicle) Rescue Charge Mode",desc:"Unlocks external AC power output to charge stranded electric vehicles on road."},hyundai_ipedal_memory_lock:{name:"Hyundai / Kia i-PEDAL One-Pedal Drive Memory Lock",desc:"Prevents i-PEDAL one-pedal stop mode from dropping back to Level 3 after shifting to Reverse."},hyundai_utility_mode_12v_saver:{name:"Utility Camping Mode High-Voltage 12V Saver",desc:"Powers 220V V2L outlet directly from HV traction battery to prevent auxiliary 12V battery drain."},hyundai_phev_no_ice_climate_start:{name:"PHEV EV Mode Climate Heating Gasoline Engine Suppression",desc:"Forces heat pump / PTC electric heater for cabin climate without starting gasoline engine."},vag_taycan_ess_sound_profile_swap:{name:"Electric Sport Sound (ESS) Taycan / RS e-tron Profile",desc:"Changes electric driving sound profile to Porsche Taycan GTS or Audi RS e-tron GT sound generator."},vag_meb_daily_charge_target_menu:{name:"MEB Battery Daily 80% / Trip 100% Quick Charge Bar",desc:"Adds quick toggle bar on MIB screen to switch between 80% daily battery care and 100% trip charge."},vag_gte_generator_charge_reserve:{name:"GTE / E