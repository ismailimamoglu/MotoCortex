\u043c\u0435\u0441\u0442\u0435!",sec:"\u0441\u0435\u043a"},dtc:{P0102:"\u0414\u0430\u0442\u0447\u0438\u043a \u0440\u0430\u0441\u0445\u043e\u0434\u0430 \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u2014 \u043d\u0438\u0437\u043a\u0438\u0439 \u0432\u0445\u043e\u0434\u043d\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b",P0113:"\u0414\u0430\u0442\u0447\u0438\u043a \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u2014 \u0432\u044b\u0441\u043e\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435",P0171:"\u041d\u0438\u0437\u043a\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b",P0300:"\u0421\u043b\u0443\u0447\u0430\u0439\u043d\u0430\u044f/\u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u043e\u0432",P0420:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u0430\u0442\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u0430 \u2014 \u043d\u0438\u0437\u043a\u0438\u0439 \u041a\u041f\u0414",P0700:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u0440\u043e\u0431\u043a\u043e\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u2014 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c",P0715:"\u0414\u0430\u0442\u0447\u0438\u043a \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0442\u0443\u0440\u0431\u0438\u043d\u044b \u2014 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u0446\u0435\u043f\u0438",P0560:"\u041d\