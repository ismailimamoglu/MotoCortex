oltage':'\u5bf9\u7535\u6e90\u77ed\u8def','Range/Performance':'\u8303\u56f4/\u6027\u80fd\u5f02\u5e38','Circuit Low':'\u7535\u8def\u7535\u538b\u8fc7\u4f4e','Circuit High':'\u7535\u8def\u7535\u538b\u8fc7\u9ad8','Circuit Malfunction':'\u7535\u8def\u6545\u969c','Mass or Volume Air Flow':'\u7a7a\u6c14\u6d41\u91cf\u8ba1 (MAF)','Manifold Absolute Pressure':'\u8fdb\u6c14\u6b67\u7ba1\u7edd\u5bf9\u538b\u529b (MAP)','Engine Coolant Temperature':'\u53d1\u52a8\u673a\u51b7\u5374\u6db2\u6e29\u5ea6','Intake Air Temperature':'\u8fdb\u6c14\u6e29\u5ea6','Throttle Position':'\u8282\u6c14\u95e8\u4f4d\u7f6e','Camshaft Position':'\u51f8\u8f6e\u8f74\u4f4d\u7f6e','Crankshaft Position':'\u66f2\u8f74\u4f4d\u7f6e','Oxygen Sensor':'\u6c27\u4f20\u611f\u5668 (O2)','Catalyst System Efficiency Below Threshold':'\u4e09\u5143\u50ac\u5316\u8f6c\u5316\u5668\u6548\u7387\u4f4e\u4e8e\u9608\u503c','Fuel Rail Pressure':'\u71c3\u6cb9\u5bfc\u8f68\u538b\u529b','Cylinder Misfire Detected':'\u68c0\u6d4b\u5230\u6c14\u7f38\u7f3a\u706b','Random/Multiple Cylinder Misfire':'\u968f\u673a/\u591a\u7f38\u7f3a\u706b','Transmission Control System':'\u53d8\u901f\u5668\u63a7\u5236\u7cfb\u7edf','Lost Communication With':'\u901a\u4fe1\u4e22\u5931:','Invalid Data Received From':'\u63a5\u6536\u5230\u65e0\u6548\u6570\u636e:','Wheel Speed Sensor':'\u8f6e\u901f\u4f20\u611f\u5668','Brake Pressure Sensor':'\u5239\u8f66\u538b\u529b\u4f20\u611f\u5668','Airbag Control Module':'\u5b89\u5168\u6c14\u56ca\u63a7\u5236\u6a21\u5757','ABS Control Module':'ABS\u63a7\u5236\u6a21\u5757'},ar:{'Glow Plug Module Control Circuit':'\u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0648\u062d\u062f\u0629 \u0634\u0645\u0639\u0629 \u0627\u0644\u062a\u0648\u0647\u062c','Glow Plug Circuit':'\u062f\u0627\u0626\u0631\u0629 \u0634\u0645\u0639\u0629 \u0627\u0644\u062a\u0648\u0647\u062c','Glow Plug':'\u0634\u0645\u0639\u0629 \u0627\u0644\u062a\u0648\u0647\u062c','Control Circuit':'\u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u062a\u062d\u0643\u0645','Open Circuit':'\u062f\u0627\u0626\u0631\u0629 \u0645\u0641\u062a\u0648\u062d\u0629','Short to Ground':'\u0645\u0627\u0633 \u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0628\u0627\u0644\u0623\u0631\u0636\u064a','Short to Voltage':'\u0645\u0627\u0633 \u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0628\u0627\u0644\u0645\u0648\u062c\u0628','Range/Performance':'\u0627\u0644\u0646\u0637\u0627\u0642/\u0627\u0644\u0623\u062f\u0627\u0621','Circuit Low':'\u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u062f\u0627\u0626\u0631\u0629 \u0645\u0646\u062e\u0641\u0636\u0629','Circuit High':'\u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u062f\u0627\u0626\u0631\u0629 \u0645\u0631\u062a\u0641\u0639\u0629','Circuit Malfunction':'\u0639\u0637\u0644 \u0641\u064a \u0627\u0644\u062f\u0627\u0626\u0631\u0629','Mass or Volume Air Flow':'\u062d\u0633\u0627\u0633 \u062a\u062f\u0641\u0642 \u0643\u062a\u0644\u0629 \u0627\u0644\u0647\u0648\u0627\u0621 (MAF)','Manifold Absolute Pressure':'\u062d\u0633\u0627\u0633 \u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u0645\u0637\u0644\u0642 \u0644\u0644\u0645\u062c\u0645\u0639 (MAP)','Engine Coolant Temperature':'\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0633\u0627\u0626\u0644 \u062a\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u062d\u0631\u0643','Intake Air Temperature':'\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0647\u0648\u0627\u0621 \u0627\u0644\u0633\u062d\u0628','Throttle Position':'\u0645\u0648\u0636\u0639 \u0635\u0645\u0627\u0645 \u0627\u0644\u062e\u0627\u0646\u0642','Camshaft Position':'\u0645\u0648\u0642\u0639 \u0639\u0645\u0648\u062f \u0627\u0644\u0643\u0627\u0645\u0627\u062a','Crankshaft Position':'\u0645\u0648\u0642\u0639 \u0639\u0645\u0648\u062f \u0627\u0644\u0643\u0631\u0646\u0643','Oxygen Sensor':'\u062d\u0633\u0627\u0633 \u0627\u0644\u0623\u0643\u0633\u062c\u064a\u0646','Catalyst System Efficiency Below Threshold':'\u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u0648\u0644 \u0627\u0644\u062d\u0641\u0627\u0632 \u0623\u0642\u0644 \u0645\u0646 \u0627\u0644\u062d\u062f \u0627\u0644\u0645\u0633\u0645\u0648\u062d','Fuel Rail Pressure':'\u0636\u063a\u0637 \u0633\u0643\u0629 \u0627\u0644\u0648\u0642\u0648\u062f','Cylinder Misfire Detected':'\u0627\u0643\u062a\u0634\u0627\u0641 \u062e\u0644\u0644 \u0641\u064a \u0625\u0634\u0639\u0627\u0644 \u0627\u0644\u0623\u0633\u0637\u0648\u0627\u0646\u0629','Random/Multiple Cylinder Misfire':'\u062e\u0644\u0644 \u0625\u0634\u0639\u0627\u0644 \u0639\u0634\u0648\u0627\u0626\u064a/\u0645\u062a\u0639\u062f\u062f \u0641\u064a \u0627\u0644\u0623\u0633\u0637\u0648\u0627\u0646\u0627\u062a','Transmission Control System':'\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629','Lost Communication With':'\u0641\u0642\u062f\u0627\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0645\u0639','Invalid Data Received From':'\u0628\u064a\u0627\u0646\u0627\u062a \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 \u0645\u0633\u062a\u0644\u0645\u0629 \u0645\u0646','Wheel Speed Sensor':'\u062d\u0633\u0627\u0633 \u0633\u0631\u0639\u0629 \u0627\u0644\u0639\u062c\u0644\u0629','Brake Pressure Sensor':'\u062d\u0633\u0627\u0633 \u0636\u063a\u0637 \u0627\u0644\u0641\u0631\u0627\u0645\u0644','Airbag Control Module':'\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0648\u0633\u0627\u0626\u062f \u0627\u0644\u0647\u0648\u0627\u0626\u064a\u0629','ABS Control Module':'\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0646\u0638\u0627\u0645 ABS'},hi:{'Glow Plug Module Control Circuit':'\u0917\u094d\u0932\u094b \u092a\u094d\u0932\u0917 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0938\u0930\u094d\u0915\u093f\u091f','Glow Plug Circuit':'\u0917\u094d\u0932\u094b \u092a\u094d\u0932\u0917 \u0938\u0930\u094d\u0915\u093f\u091f','Glow Plug':'\u0917\u094d\u0932\u094b \u092a\u094d\u0932\u0917','Control Circuit':'\u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0938\u0930\u094d\u0915\u093f\u091f','Open Circuit':'\u0913\u092a\u0928 \u0938\u0930\u094d\u0915\u093f\u091f (\u091f\u0942\u091f\u093e \u0939\u0941\u0906)','Short to Ground':'\u0936\u0949\u0930\u094d\u091f \u091f\u0942 \u0917\u094d\u0930\u093e\u0909\u0902\u0921 (\u0905\u0930\u094d\u0925 \u0936\u0949\u0930\u094d\u091f)','Short to Voltage':'\u0936\u0949\u0930\u094d\u091f \u091f\u0942 \u0935\u094b\u0932\u094d\u091f\u0947\u091c','Range/Performance':'\u0930\u0947\u0902\u091c/\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0938\u092e\u0938\u094d\u092f\u093e','Circuit Low':'\u0938\u0930\u094d\u0915\u093f\u091f \u0915\u092e \u0938\u093f\u0917\u094d\u0928\u0932','Circuit High':'\u0938\u0930\u094d\u0915\u093f\u091f \u0909\u091a\u094d\u091a \u0938\u093f\u0917\u094d\u0928\u0932','Circuit Malfunction':'\u0938\u0930\u094d\u0915\u093f\u091f \u0916\u0930\u093e\u092c\u0940','Mass or Volume Air Flow':'\u092e\u093e\u0938 \u090f\u092f\u0930 \u092b\u094d\u0932\u094b \u0938\u0947\u0902\u0938\u0930 (MAF)','Manifold Absolute Pressure':'\u092e\u0948\u0928\u093f\u092b\u094b\u0932\u094d\u0921 \u090f\u092c\u094d\u0938\u094b\u0932\u094d\u092f\u0942\u091f \u092a\u094d\u0930\u0947\u0936\u0930 (MAP)','Engine Coolant Temperature':'\u0907\u0902\u091c\u0928 \u0915\u0942\u0932\u0947\u0902\u091f \u0924\u093e\u092a\u092e\u093e\u0928','Intake Air Temperature':'\u0907\u0928\u091f\u0947\u0915 \u090f\u092f\u0930 \u0924\u093e\u092a\u092e\u093e\u0928','Throttle Position':'\u0925\u094d\u0930\u0949\u091f\u0932 \u0938\u094d\u0925\u093f\u0924\u093f','Camshaft Position':'\u0915\u0948\u092e\u0936\u093e\u092b\u094d\u091f \u0938\u094d\u0925\u093f\u0924\u093f','Crankshaft Position':'\u0915\u094d\u0930\u0948\u0902\u0915\u0936\u093e\u092b\u094d\u091f \u0938\u094d\u0925\u093f\u0924\u093f','Oxygen Sensor':'\u0911\u0915\u094d\u0938\u0940\u091c\u0928 \u0938\u0947\u0902\u0938\u0930 (O2)','Catalyst System Efficiency Below Threshold':'\u0915\u0948\u091f\u0947\u0932\u093f\u091f\u093f\u0915 \u0915\u0928\u094d\u0935\u0930\u094d\u091f\u0930 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u092e','Fuel Rail Pressure':'\u092b\u094d\u092f\u0942\u0932 \u0930\u0947\u0932 \u0926\u092c\u093e\u0935','Cylinder Misfire Detected':'\u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u092e\u093f\u0938\u092b\u093e\u092f\u0930 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e','Random/Multiple Cylinder Misfire':'\u0930\u0948\u0902\u0921\u092e/\u092e\u0932\u094d\u091f\u0940\u092a\u0932 \u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u092e\u093f\u0938\u092b\u093e\u092f\u0930','Transmission Control System':'\u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092a\u094d\u0930\u0923\u093e\u0932\u0940','Lost Communication With':'\u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u091a\u093e\u0930 \u091f\u0942\u091f \u0917\u092f\u093e:','Invalid Data Received From':'\u0938\u0947 \u0905\u092e\u093e\u0928\u094d\u092f \u0921\u0947\u091f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0941\u0906:','Wheel Speed Sensor':'\u0935\u094d\u0939\u0940\u0932 \u0938\u094d\u092a\u0940\u0921 \u0938\u0947\u0902\u0938\u0930','Brake Pressure Sensor':'\u092c\u094d\u0930\u0947\u0915 \u092a\u094d\u0930\u0947\u0936\u0930 \u0938\u0947\u0902\u0938\u0930','Airbag Control Module':'\u090f\u092f\u0930\u092c\u0948\u0917 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u0949\u0921\u094d\u092f\u0942\u0932','ABS Control Module':'ABS \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u0949\u0921\u094d\u092f\u0942\u0932'},el:{'Glow Plug Module Control Circuit':'\u039a\u03cd\u03ba\u03bb\u03c9\u03bc\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1\u03c2 \u03c0\u03c1\u03bf\u03b8\u03b5\u03c1\u03bc\u03b1\u03bd\u03c4\u03ae\u03c1\u03b1','Control Circuit':'\u039a\u03cd\u03ba\u03bb\u03c9\u03bc\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5','Open Circuit':'\u0391\u03bd\u03bf\u03b9\u03ba\u03c4\u03cc \u03ba\u03cd\u03ba\u03bb\u03c9\u03bc\u03b1','Short to Ground':'\u0392\u03c1\u03b1\u03c7\u03c5\u03ba\u03cd\u03ba\u03bb\u03c9\u03bc\u03b1 \u03c3\u03c4\u03b7 \u03b3\u03b5\u03af\u03c9\u03c3\u03b7','Short to Voltage':'\u0392\u03c1\u03b1\u03c7\u03c5\u03ba\u03cd\u03ba\u03bb\u03c9\u03bc\u03b1 \u03c3\u03c4\u03b7\u03bd \u03c4\u03ac\u03c3\u03b7','Range/Performance':'\u0395\u03cd\u03c1\u03bf\u03c2/\u0391\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7','Circuit Low':'\u03a7\u03b1\u03bc\u03b7\u03bb\u03cc \u03c3\u03ae\u03bc\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2','Circuit High':'\u03a5\u03c8\u03b7\u03bb\u03cc \u03c3\u03ae\u03bc\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2','Circuit Malfunction':'\u0394\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ba\u03c5\u03ba\u03bb\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2','Mass or Volume Air Flow':'\u0391\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03bc\u03ac\u03b6\u03b1\u03c2 \u03b1\u03ad\u03c1\u03b1 (MAF)','Engine Coolant Temperature':'\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03c8\u03c5\u03ba\u03c4\u03b9\u03ba\u03bf\u03cd \u03c5\u03b3\u03c1\u03bf\u03cd','Oxygen Sensor':'\u0391\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03bf\u03be\u03c5\u03b3\u03cc\u03bd\u03bf\u03c5 (Lambda)','Transmission Control System':'\u03a3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03ba\u03b9\u03b2\u03c9\u03c4\u03af\u03bf\u03c5 \u03c4\u03b1\u03c7\u03c5\u03c4\u03ae\u03c4\u03c9\u03bd','Lost Communication With':'\u0391\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1 \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1\u03c2 \u03bc\u03b5','Wheel Speed Sensor':'\u0391\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c4\u03c1\u03bf\u03c7\u03bf\u03cd','Airbag Control Module':'\u039c\u03bf\u03bd\u03ac\u03b4\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 \u03b1\u03b5\u03c1\u03cc\u03c3\u03b1\u03ba\u03bf\u03c5','ABS Control Module':'\u039c\u03bf\u03bd\u03ac\u03b4\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 ABS'},nl:{'Glow Plug Module Control Circuit':'Regelcircuit gloeibougiemodule','Control Circuit':'Regelcircuit','Open Circuit':'Open circuit','Short to Ground':'Kortsluiting naar massa','Short to Voltage':'Kortsluiting naar spanning','Range/Performance':'Bereik/Prestaties','Circuit Low':'Circuit laag signaal','Circuit High':'Circuit hoog signaal','Circuit Malfunction':'Storing in circuit','Mass or Volume Air Flow':'Luchtmassameter (MAF)','Engine Coolant Temperature':'Koelvloeistoftemperatuur','Oxygen Sensor':'Lambdasonde (O2)','Transmission Control System':'Transmissieregelsysteem','Lost Communication With':'Communicatie verloren met','Wheel Speed Sensor':'Wielsnelheidssensor','Airbag Control Module':'Airbag-regelmodule','ABS Control Module':'ABS-regelmodule'},sv:{'Glow Plug Module Control Circuit':'Styrkrets f\xf6r gl\xf6dstiftsmodul','Control Circuit':'Styrkrets','Open Circuit':'\xd6ppen krets','Short to Ground':'Kortslutning till jord','Short to Voltage':'Kortslutning till sp\xe4nning','Range/Performance':'Omr\xe5de/Prestanda','Circuit Low':'Krets l\xe5g signal','Circuit High':'Krets h\xf6g signal','Circuit Malfunction':'Kretsfunktionsfel','Mass or Volume Air Flow':'Luftmassem\xe4tare (MAF)','Engine Coolant Temperature':'Motorkylv\xe4tsketemperatur','Oxygen Sensor':'Syresensor (Lambdasond)','Transmission Control System':'V\xe4xell\xe5dsstyrsystem','Lost Communication With':'F\xf6rlorad kommunikation med','Wheel Speed Sensor':'Hjulhastighetssensor','Airbag Control Module':'Krockkuddsstyrmodul','ABS Control Module':'ABS-styrmodul'},pl:{'Glow Plug Module Control Circuit':'Obw\xf3d sterowania modu\u0142em \u015bwiec \u017carowych','Control Circuit':'Obw\xf3d sterowania','Open Circuit':'Przerwany obw\xf3d (otwarty)','Short to Ground':'Zwarcie do masy','Short to Voltage':'Zwarcie do plusa','Range/Perform