evice:"\u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e",scanHint:"\u0421\u043a\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438 \u0441\u043e\u043f\u0440\u044f\u0436\u0435\u043d\u043d\u044b\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 OBD.",ecuWait:"\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a \u042d\u0411\u0423...",ecuNoResponse:"\u042d\u0411\u0423 \u043d\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u0435.",retry:"\u041f\u041e\u041f\u0420\u041e\u0411\u0423\u0419\u0422\u0415 \u0415\u0429\u0415 \u0420\u0410\u0417",disconnect:"\u041e\u0422\u041a\u041b\u042e\u0427\u0418\u0422\u042c",disconnectShort:"\u041e\u0422\u041a\u041b.",connectLabel:"\u041f\u041e\u0414\u041a\u041b\u042e\u0427\u0418\u0422\u042c",error:"\u041e\u0428\u0418\u0411\u041a\u0410 \u0421\u041e\u0415\u0414\u0418\u041d\u0415\u041d\u0418\u042f",bluetoothOffDesc:"Bluetooth \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435 Bluetooth \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445.",permissionDesc:"\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 Bluetooth \u043e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u043e. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u0435 \u044d\u0442\u043e \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f.",safeModeActive:"\u0411\u0415\u0417\u041e\u041f\u0410\u0421\u041d\u042b\u0419 \u0420\u0415\u0416\u0418\u041c \u0410\u041a\u0422\u0418\u0412\u0415\u041d: \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d 