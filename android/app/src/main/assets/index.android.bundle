902\u0917",desc:"\u0915\u094d\u0930\u093f\u0938\u094d\u091f\u0932-\u0915\u094d\u0932\u093f\u092f\u0930 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u092a\u094d\u0932\u0947\u091f \u0926\u0943\u0936\u094d\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u0947\u0902\u091f\u094d\u0930\u0940 \u092e\u094b\u0921 \u0915\u0948\u092e\u0930\u093e \u0935\u0940\u0921\u093f\u092f\u094b \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u092c\u093f\u091f\u0930\u0947\u091f \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964"},tesla_cabin_overheat_threshold_30c:{name:"\u091f\u0947\u0938\u094d\u0932\u093e \u0915\u0947\u092c\u093f\u0928 \u0913\u0935\u0930\u0939\u0940\u091f \u092a\u094d\u0930\u094b\u091f\u0947\u0915\u094d\u0936\u0928 \u0924\u093e\u092a\u092e\u093e\u0928 \u0938\u0940\u092e\u093e (30\xb0C)",desc:"\u0906\u0902\u0924\u0930\u093f\u0915 \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u092c\u093f\u0928 \u0915\u0947 \u0905\u0924\u093f \u0924\u093e\u092a \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u091c\u0932\u0935\u093e\u092f\u0941 \u091f\u094d\u0930\u093f\u0917\u0930 \u0924\u093e\u092a\u092e\u093e\u0928 \u0915\u094b 40\xb0C \u0938\u0947 30\xb0C \u0924\u0915 \u0915\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmwmotorrad_quickshifter_pro_readapt:{name:"\u0936\u093f\u092b\u094d\u091f \u0905\u0938\u093f\u0938\u094d\u091f\u0947\u0902\u091f \u092a\u094d\u0930\u094b \u092a\u0941\u0928\u0903 \u0905\u0928\u0941\u0915\u0942\u0932\u0928",desc:"\u0936\u093f\u092b\u094d\u091f \u0938\u0947\u0902\u0938\u0930 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u092a\u0948\u0930\u093e\u092e\u0940\u091f\u0930\u094d\u0938 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u094d\u0935\u093f\u0915\u0936\u093f\u092b\u094d\u091f\u0930 \u0930\u0940\u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u0936\u0928 \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmwmotorrad_esa_zero_point_calib:{name:"\u0921\u093e\u092f\u0928\u0947\u092e\u093f\u0915 \u0908\u090f\u0938\u090f \u0938\u0938\u094d\u092a\u0947\u0902\u0936\u0928 \u091c\u0940\u0930\u094b-\u092a\u094d\u0935\u093e\u0907\u0902\u091f \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u0936\u0928",desc:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0938\u0938\u094d\u092a\u0947\u0902\u0936\u0928 \u0932\u094b\u0921 \u0914\u0930 \u091f\u094d\u0930\u0948\u0935\u0932 \u0938\u0947\u0902\u0938\u0930 \u0915\u094b \u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0936\u0942\u0928\u094d\u092f \u092a\u0930 \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmwmotorrad_abs_pro_cornering_toggle:{name:"\u090f\u092c\u0940\u090f\u0938 \u092a\u094d\u0930\u094b \u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u092e\u094b\u0921 \u0907\u0902\u091f\u0930\u0935\u0947\u0902\u0936\u0928 \u0925\u094d\u0930\u0947\u0936\u094b\u0932\u094d\u0921",desc:"\u091f\u094d\u0930\u0948\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u090f \u0932\u0940\u0928-\u090f\u0902\u0917\u0932 \u0928\u093f\u0930\u094d\u092d\u0930 \u090f\u092c\u0940\u090f\u0938 \u0939\u0938\u094d\u0924\u0915\u094d\u0937\u0947\u092a \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmwmotorrad_service_interval_reset:{name:"\u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u090f\u0935\u0902 \u0926\u0942\u0930\u0938\u094d\u0925 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u0930\u0940\u0938\u0947\u091f",desc:"\u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0938\u0930\u094d\u0935\u093f\u0938 \u0907\u0902\u0921\u093f\u0915\u0947\u091f\u0930 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u0938\u094d\u091f\u092e \u0905\u0902\u0924\u0930\u093e\u0932 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmwmotorrad_headlight_pro_cornering:{name:"\u0939\u0947\u0921\u0932\u093e\u0907\u091f \u092a\u094d\u0930\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u092a\u094d\u0930\u0915\u093e\u0936 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",desc:"\u0905\u0928\u0941\u0915\u0942\u0932\u0940 \u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u0939\u0947\u0921\u0932\u093e\u0907\u091f \u0938\u0915\u094d\u0930\u093f\u092f\u0923 \u0915\u0947 \u0932\u093f\u090f \u0932\u0940\u0928 \u0915\u094b\u0923 \u0938\u0940\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmwmotorrad_keyless_ride_range_extend:{name:"\u092c\u093f\u0928\u093e \u091a\u093e\u092c\u0940 \u0935\u093e\u0932\u0940 \u0930\u093e\u0907\u0921 \u092b\u093c\u0949\u092c \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0930\u0947\u0902\u091c \u090f\u0915\u094d\u0938\u091f\u0947\u0902\u0936\u0928",desc:"\u092c\u093f\u0928\u093e \u091a\u093e\u092c\u0940 \u0915\u0947 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0938\u0947\u0902\u0938\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u0902\u0921\u0930 \u0938\u093f\u0917\u094d\u0928\u0932 \u0930\u0947\u0902\u091c \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmwmotorrad_reverse_assist_sensitivity:{name:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0930\u093f\u0935\u0930\u094d\u0938 \u0905\u0938\u093f\u0938\u094d\u091f \u092e\u094b\u091f\u0930 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",desc:"\u0930\u093f\u0935\u0930\u094d\u0938 \u0921\u094d\u0930\u093e\u0907\u0935 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0930 \u092e\u094b\u091f\u0930 \u0915\u0940 \u0917\u0924\u093f \u0914\u0930 \u091f\u0949\u0930\u094d\u0915 \u0938\u0940\u092e\u093e \u0915\u094b \u092b\u093e\u0907\u0928-\u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_riding_mode_custom_profile:{name:"\u0930\u093e\u0907\u0921\u093f\u0902\u0917 \u092e\u094b\u0921 \u0915\u0938\u094d\u091f\u092e \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0928\u093f\u0930\u094d\u092e\u093e\u0924\u093e",desc:"\u0930\u0947\u0938, \u0938\u094d\u092a\u094b\u0930\u094d\u091f, \u091f\u0942\u0930\u093f\u0902\u0917 \u0914\u0930 \u0936\u0939\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u0947 \u0932\u093f\u090f \u0915\u0938\u094d\u091f\u092e \u0938\u0902\u092f\u094b\u091c\u0928 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_ohlins_suspension_mapping:{name:"\u0913\u0939\u0932\u093f\u0928\u094d\u0938 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0908\u0938\u0940 2.0 \u0938\u0947\u092e\u0940-\u090f\u0915\u094d\u091f\u093f\u0935 \u0938\u0938\u094d\u092a\u0947\u0902\u0936\u0928 \u092e\u0948\u092a\u093f\u0902\u0917",desc:"\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0938\u0938\u094d\u092a\u0947\u0902\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u0921\u0902\u092a\u093f\u0902\u0917 \u0915\u0930\u094d\u0935 \u0914\u0930 \u0915\u0920\u094b\u0930\u0924\u093e \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0915\u094b \u092b\u093e\u0907\u0928-\u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_dashboard_lap_timer_gps:{name:"\u091f\u0940\u090f\u092b\u091f\u0940 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0932\u0948\u092a \u091f\u093e\u0907\u092e\u0930 \u0914\u0930 \u091c\u0940\u092a\u0940\u090f\u0938 \u0938\u0947\u0915\u094d\u091f\u0930 \u0938\u094d\u092a\u094d\u0932\u093f\u091f\u094d\u0938",desc:"\u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092a\u0930 \u091f\u094d\u0930\u0948\u0915 \u0932\u0948\u092a \u091f\u093e\u0907\u092e\u0930 \u0914\u0930 \u0938\u0947\u0915\u094d\u091f\u0930 \u0938\u094d\u092a\u094d\u0932\u093f\u091f \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_engine_brake_control_ebc:{name:"\u0907\u0902\u091c\u0928 \u092c\u094d\u0930\u0947\u0915 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 (\u0908\u092c\u0940\u0938\u0940) \u0938\u094d\u0924\u0930 \u0938\u092e\u093e\u092f\u094b\u091c\u0928",desc:"\u0939\u093e\u0930\u094d\u0921 \u0915\u0949\u0930\u094d\u0928\u0930 \u090f\u0902\u091f\u094d\u0930\u0940 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0930\u093f\u092f\u0930 \u0935\u094d\u0939\u0940\u0932 \u0921\u0947\u0938\u0947\u0932\u0947\u0930\u0947\u0936\u0928 \u091f\u0949\u0930\u094d\u0915 \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_cruise_control_retrofit_enable:{name:"\u0915\u094d\u0930\u0942\u091c\u093c \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093c\u093f\u091f \u0938\u0915\u094d\u0930\u093f\u092f\u0923",desc:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093c\u093f\u091f\u0947\u0921 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0915\u094d\u0930\u0942\u091c\u093c \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0938\u094d\u0935\u093f\u091a \u0915\u0947 \u0932\u093f\u090f \u0908\u0938\u0940\u092f\u0942 \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u092b\u093c\u094d\u0932\u0948\u0917 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_exhaust_valve_sound_map:{name:"\u0928\u093f\u0915\u093e\u0938 \u0938\u0930\u094d\u0935\u094b \u0935\u093e\u0932\u094d\u0935 \u0916\u094b\u0932\u0928\u0947 \u0935\u093e\u0932\u093e \u0906\u0930\u092a\u0940\u090f\u092e \u092e\u093e\u0928\u091a\u093f\u0924\u094d\u0930",desc:"\u0909\u0928\u094d\u0928\u0924 \u0928\u093f\u0915\u093e\u0938 \u0928\u094b\u091f \u0915\u0947 \u0932\u093f\u090f \u0927\u094d\u0935\u0928\u093f\u0915 \u0928\u093f\u0915\u093e\u0938 \u0935\u093e\u0932\u094d\u0935 \u0916\u094b\u0932\u0928\u0947 \u0915\u0940 \u0938\u0940\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_pit_lane_limiter_config:{name:"\u092a\u093f\u091f \u0932\u0947\u0928 \u0938\u094d\u092a\u0940\u0921 \u0932\u093f\u092e\u093f\u091f\u0930 \u0925\u094d\u0930\u0947\u0936\u094b\u0932\u094d\u0921",desc:"\u0939\u0948\u0902\u0921\u0932\u092c\u093e\u0930 \u0938\u094d\u0935\u093f\u091a \u092a\u0930 60 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u092a\u093f\u091f \u0932\u0947\u0928 \u0938\u094d\u092a\u0940\u0921 \u0932\u093f\u092e\u093f\u091f\u0930 \u091f\u0949\u0917\u0932 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ducati_desmo_service_light_reset:{name:"\u0924\u0947\u0932 \u0914\u0930 \u0921\u0947\u0938\u094d\u092e\u094b \u0935\u093e\u0932\u094d\u0935 \u0938\u0930\u094d\u0935\u093f\u0938 \u0932\u093e\u0907\u091f \u0930\u0940\u0938\u0947\u091f",desc:"\u0909\u092a\u0915\u0930\u0923 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092a\u0930 \u0921\u0947\u0938\u094d\u092e\u094b\u0921\u094d\u0930\u094b\u092e\u093f\u0915 \u0935\u093e\u0932\u094d\u0935 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ktm_quickshifter_plus_delay_tuning:{name:"\u0915\u094d\u0935\u093f\u0915\u0936\u093f\u092b\u094d\u091f\u0930+ \u0936\u093f\u092b\u094d\u091f \u0915\u091f \u091f\u093e\u0907\u092e \u0914\u0930 \u0935\u093f\u0932\u0902\u092c \u092b\u093e\u0907\u0928-\u091f\u094d\u092f\u0942\u0928\u093f\u0902\u0917",desc:"\u0928\u093f\u0930\u094d\u092c\u093e\u0927 \u0905\u092a/\u0921\u093e\u0909\u0928 \u0936\u093f\u092b\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0924\u093f \u0917\u093f\u092f\u0930 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0915\u091f \u0905\u0935\u0927\u093f \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ktm_rally_offroad_abs_tc_unlock:{name:"\u0930\u0948\u0932\u0940/\u0911\u092b-\u0930\u094b\u0921 \u090f\u092c\u0940\u090f\u0938 \u0914\u0930 \u091f\u0940\u0938\u0940 \u092e\u094b\u0921 \u0905\u0928\u0932\u0949\u0915",desc:"\u0930\u093f\u092f\u0930 \u090f\u092c\u0940\u090f\u0938 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0930\u0948\u0932\u0940 \u092e\u094b\u0921 \u092e\u0947\u0902 9-\u0938\u094d\u091f\u0947\u091c \u0938\u094d\u0932\u093f\u092a \u0938\u092e\u093e\u092f\u094b\u091c\u0928 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ktm_my_ktm_connectivity_unlock:{name:"\u092e\u0947\u0930\u093e \u0915\u0947\u091f\u0940\u090f\u092e/\u0939\u0941\u0938\u094d\u0915\u094d\u0935\u0930\u094d\u0928\u093e \u0915\u0928\u0947\u0915\u094d\u091f\u093f\u0935\u093f\u091f\u0940 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0938\u0915\u094d\u0930\u093f\u092f\u0923",desc:"\u091f\u0940\u090f\u092b\u091f\u0940 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092a\u0930 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0928\u0947\u0935\u093f\u0917\u0947\u0936\u0928 \u0914\u0930 \u091f\u0930\u094d\u0928-\u092c\u093e\u092f-\u091f\u0930\u094d\u0928 \u0930\u0942\u091f\u093f\u0902\u0917 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ktm_cruise_control_retrofit_enable:{name:"\u0915\u094d\u0930\u0942\u091c\u093c \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u0905\u0928\u0932\u0949\u0915",desc:"\u0939\u0948\u0902\u0921\u0932\u092c\u093e\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u093f\u091f \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0915\u094d\u0930\u0942\u091c\u093c \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092b\u093c\u0902\u0915\u094d\u0936\u0928 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},ktm_clutch_pull_map_switch_gesture:{name:"\u0915\u094d\u0932\u091a-\u092a\u0941\u0932 \u091c\u0947\u0938\u094d\u091a\u0930 \u092e\u0948\u092a \u0938\u094d\u0935\u093f\u091a\u093f\u0902\u0917",desc:"\u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0905\u092a \u092a\u0930 \u0915\u094d\u0932\u091a \u0932\u0940\u0935\u0930 \u091c\u0947\u0938\u094d\u091a\u0930 \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0915\u0947 \u0924\u0947\u091c\u0940 \u0938\u0947 \u092e\u093e\u0928\u091a\u093f\u0924\u094d\u0930 \u0938\u094d\u0935\u093f\u091a\u093f\u0902\u0917 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},yamaha_quickshifter_cut_time_adjust:{name:"\u0915\u094d\u0935\u093f\u0915\u0936\u093f\u092b\u094d\u091f\u0930 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0915\u091f-\u091f\u093e\u0907\u092e \u0914\u0930 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",desc:"\u0915\u094d\u0935\u093f\u0915\u0936\u093f\u092b\u094d\u091f\u0930 \u0938\u0947\u0902\u0938\u0930 \u0932\u094b\u0921 \u0925\u094d\u0930\u0947\u0936\u094b\u0932\u094d\u0921 \u0914\u0930 \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u0930\u0941\u0915\u093e\u0935\u091f \u0935\u093f\u0932\u0902\u092c \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},yamaha_ride_by_wire_throttle_map:{name:"\u0930\u093e\u0907\u0921-\u092c\u093e\u092f-\u0935\u093e\u092f\u0930 \u0925\u094d\u0930\u0949\u091f\u0932 \u092e\u0948\u092a \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u092f\u0928\u0915\u0930\u094d\u0924\u093e",desc:"\u090f-\u092e\u094b\u0921 (\u0906\u0915\u094d\u0930\u093e\u092e\u0915), \u090f\u0938\u091f\u0940\u0921\u0940, \u0914\u0930 \u092c\u0940-\u092e\u094b\u0921 (\u0938\u094d\u092e\u0942\u0925) \u0925\u094d\u0930\u0949\u091f\u0932 \u092e\u093e\u0928\u091a\u093f\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u094d\u0935\u093f\u091a\u0964"},yamaha_tft_track_theme_unlock:{name:"\u091f\u0940\u090f\u092b\u091f\u0940 \u091f\u094d\u0930\u0948\u0915 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0932\u0947\u0906\u0909\u091f \u0914\u0930 \u0936\u093f\u092b\u094d\u091f \u0932\u093e\u0907\u091f \u0905\u0928\u0932\u0949\u0915",desc:"R1/MT-09 SP \u091f\u094d\u0930\u0948\u0915 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0932\u0947\u0906\u0909\u091f \u0914\u0930 \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e\u0947\u092c\u0932 \u0936\u093f\u092b\u094d\u091f RPM \u0932\u093e\u0907\u091f\u094d\u0938 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},yamaha_launch_control_sensitivity:{name:"\u0932\u0949\u0928\u094d\u091a \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0938\u093f\u0938\u094d\u091f\u092e (\u090f\u0932\u0938\u0940\u090f\u0938) \u0930\u0947\u0935 \u0938\u0940\u0932\u093f\u0902\u0917",desc:"\u0932\u0949\u0928\u094d\u091a \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0939\u094b\u0932\u094d\u0921\u093f\u0902\u0917 RPM (8,000 \u0938\u0947 10,000 RPM \u0930\u0947\u0902\u091c) \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},yamaha_heated_grips_accessory_enable:{name:"\u0905\u0938\u0932\u0940 \u0939\u0940\u091f\u0947\u0921 \u0917\u094d\u0930\u093f\u092a\u094d\u0938 \u091f\u0940\u090f\u092b\u091f\u0940 \u092e\u0947\u0928\u0942 \u090f\u0915\u0940\u0915\u0930\u0923",desc:"\u091f\u0940\u090f\u092b\u091f\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0917\u0930\u094d\u092e \u092a\u0915\u0921\u093c \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0914\u0930 \u0924\u093e\u092a\u092e\u093e\u0928 \u0917\u0947\u091c \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},honda_hstc_wheelie_control_fine_tune:{name:"\u090f\u091a\u090f\u0938\u091f\u0940\u0938\u0940 \u091f\u094d\u0930\u0948\u0915\u094d\u0936\u0928 \u0914\u0930 \u0935\u094d\u0939\u0940\u0932\u0940 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092b\u093e\u0907\u0928-\u091f\u094d\u092f\u0942\u0928\u093f\u0902\u0917",desc:"\u0939\u094b\u0902\u0921\u093e \u0938\u0947\u0932\u0947\u0915\u094d\u091f\u0947\u092c\u0932 \u091f\u0949\u0930\u094d\u0915 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0938\u094d\u0932\u093f\u092a \u0905\u0928\u0941\u092a\u093e\u0924 \u0914\u0930 \u092b\u094d\u0930\u0902\u091f \u0935\u094d\u0939\u0940\u0932 \u0932\u093f\u092b\u094d\u091f \u091f\u0949\u0932\u0930\u0947\u0902\u0938 \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},honda_bi_directional_quickshifter_enable:{name:"\u0926\u094d\u0935\u093f-\u0926\u093f\u0936\u093e\u0924\u094d\u092e\u0915 \u0915\u094d\u0935\u093f\u0915\u0936\u093f\u092b\u094d\u091f\u0930 \u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u0905\u0928\u0932\u0949\u0915",desc:"\u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u0947\u0902 \u0911\u091f\u094b-\u092c\u094d\u0932\u093f\u092a\u0930 \u0914\u0930 \u0905\u092a/\u0921\u093e\u0909\u0928 \u0915\u094d\u0935\u093f\u0915\u0936\u093f\u092b\u094d\u091f\u0930 \u0915\u094b\u0921\u093f\u0902\u0917 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},honda_service_reminder_custom_interval:{name:"\u0924\u0947\u0932 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u0926\u0942\u0930\u0940 \u0915\u0938\u094d\u091f\u092e\u093e\u0907\u091c\u093c\u0930",desc:"\u0921\u093f\u091c\u093f\u091f\u0932 \u0921\u0948\u0936 \u092a\u0930 \u0915\u0938\u094d\u091f\u092e \u0924\u0947\u0932 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092e\u093e\u0907\u0932\u0947\u091c \u0905\u0902\u0924\u0930\u093e\u0932 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},honda_track_abs_rear_disable:{name:"\u090f\u092c\u0940\u090f\u0938 \u0930\u093f\u092f\u0930-\u0935\u094d\u0939\u0940\u0932 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f\u0915\u0930\u0923 \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u0930\u0947\u0902",desc:"\u091f\u094d\u0930\u0948\u0915 \u0915\u0947 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092b\u094d\u0930\u0902\u091f \u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u090f\u092c\u0940\u090f\u0938 \u0915\u094b \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u0924\u0947 \u0939\u0941\u090f \u0930\u093f\u092f\u0930 \u0935\u094d\u0939\u0940\u0932 \u090f\u092c\u0940\u090f\u0938 \u091a\u0948\u0928\u0932 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},honda_cold_start_idle_enrichment:{name:"\u0915\u094b\u0932\u094d\u0921-\u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0908\u0902\u0927\u0928 \u0938\u0902\u0935\u0930\u094d\u0927\u0928 \u0914\u0930 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0932\u0915\u094d\u0937\u094d\u092f \u0906\u0930\u092a\u0940\u090f\u092e",desc:"\u0906\u092b\u094d\u091f\u0930\u092e\u093e\u0930\u094d\u0915\u0947\u091f \u0928\u093f\u0915\u093e\u0938 \u092a\u094d\u0930\u0923\u093e\u0932\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u0935\u093e\u0930\u094d\u092e-\u0905\u092a \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0917\u0924\u093f \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},harley_custom_throttle_curve_editor:{name:"\u0915\u0938\u094d\u091f\u092e \u0925\u094d\u0930\u0949\u091f\u0932 \u0930\u093f\u0938\u094d\u092a\u093e\u0902\u0938 \u0915\u0930\u094d\u0935 \u0938\u0902\u092a\u093e\u0926\u0915",desc:"\u092e\u093f\u0932\u094d\u0935\u094c\u0915\u0940-\u0906\u0920/\u0930\u093f\u0935\u0949\u0932\u094d\u092f\u0942\u0936\u0928 \u092e\u0948\u0915\u094d\u0938 \u0930\u093e\u0907\u0921-\u092c\u093e\u092f-\u0935\u093e\u092f\u0930 \u0925\u094d\u0930\u0949\u091f\u0932 \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},harley_security_alarm_sensitivity:{name:"\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0928\u093f\u0915\u091f\u0924\u093e \u0914\u0930 \u091d\u0941\u0915\u093e\u0935 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",desc:"\u092e\u094b\u0936\u0928 \u0938\u0947\u0902\u0938\u0930 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e \u0914\u0930 \u0939\u0948\u0902\u0921\u094d\u0938-\u092b\u093c\u094d\u0930\u0940 \u092b\u093c\u0949\u092c \u0906\u0930\u094d\u092e\u093f\u0902\u0917 \u0935\u093f\u0932\u0902\u092c \u0915\u094b \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},harley_boom_box_gts_hidden_diagnostics:{name:"\u092c\u0942\u092e! \u092c\u0949\u0915\u094d\u0938 \u091c\u0940\u091f\u0940\u090f\u0938 \u0907\u0902\u092b\u094b\u091f\u0947\u0928\u092e\u0947\u0902\u091f \u0939\u093f\u0921\u0928 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u092e\u0947\u0928\u0942",desc:"\u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930\u093f\u0902\u0917 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947, \u0907\u0902\u091c\u0928 \u0924\u093e\u092a\u092e\u093e\u0928 \u0914\u0930 \u0924\u0947\u0932 \u0926\u092c\u093e\u0935 \u0917\u0947\u091c \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},harley_rdrs_defensive_system_tune:{name:"\u0906\u0930\u0921\u0940\u0906\u0930\u090f\u0938 \u0921\u094d\u0930\u0948\u0917-\u091f\u0949\u0930\u094d\u0915 \u0938\u094d\u0932\u093f\u092a \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",desc:"\u0921\u093e\u0909\u0928\u0936\u093f\u092b\u094d\u091f \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0930\u093f\u092b\u094d\u0932\u0947\u0915\u094d\u0938 \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0930\u093e\u0907\u0921\u0930 \u0938\u093f\u0938\u094d\u091f\u092e \u0930\u093f\u092f\u0930-\u0935\u094d\u0939\u0940\u0932 \u0938\u094d\u0932\u093f\u092a \u0936\u092e\u0928 \u0915\u094b \u092b\u093e\u0907\u0928-\u091f\u094d\u092f\u0942\u0928\u094d\u0938 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},byd_avas_low_speed_siren_mute:{name:"AVAS \u0932\u094b-\u0938\u094d\u092a\u0940\u0921 \u0908\u0935\u0940 \u092a\u0948\u0926\u0932 \u092f\u093e\u0924\u094d\u0930\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0938\u093e\u092f\u0930\u0928 \u092e\u094d\u092f\u0942\u091f",desc:"\u092c\u093e\u0939\u0930\u0940 \u0927\u094d\u0935\u0928\u093f\u0915 \u0935\u093e\u0939\u0928 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0938\u093e\u092f\u0930\u0928 \u0915\u094b 30 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0938\u0947 \u0915\u092e \u092f\u093e \u0915\u092e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},byd_ev_battery_preheat_manual_switch:{name:"\u092e\u0948\u0928\u0941\u0905\u0932 \u0908\u0935\u0940 \u092c\u0948\u091f\u0930\u0940 \u092a\u094d\u0930\u0940-\u0939\u0940\u091f\u093f\u0902\u0917 \u091f\u0949\u0917\u0932",desc:"\u0921\u0940\u0938\u0940 \u092b\u093e\u0938\u094d\u091f \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0948\u0928\u0941\u0905\u0932 \u092c\u0948\u091f\u0930\u0940 \u0925\u0930\u094d\u092e\u0932 \u0915\u0902\u0921\u0940\u0936\u0928\u093f\u0902\u0917 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},byd_v2l_220v_outlet_power_expansion:{name:"V2L (\u0935\u093e\u0939\u0928-\u0938\u0947-\u0932\u094b\u0921) 220V \u0906\u0909\u091f\u0932\u0947\u091f \u092a\u093e\u0935\u0930 \u0935\u093f\u0938\u094d\u0924\u093e\u0930 (3.6 \u0915\u093f\u0932\u094b\u0935\u093e\u091f)",desc:"\u092c\u093e\u0939\u0930\u0940 V2L \u0921\u093f\u0938\u094d\u091a\u093e\u0930\u094d\u091c \u092a\u093e\u0935\u0930 \u0938\u0940\u0932\u093f\u0902\u0917 \u0915\u094b 2.2 \u0915\u093f\u0932\u094b\u0935\u093e\u091f \u0938\u0947 \u0905\u0927\u093f\u0915\u0924\u092e 3.6 \u0915\u093f\u0932\u094b\u0935\u093e\u091f \u0924\u0915 \u0935\u093f\u0938\u094d\u0924\u093e\u0930\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},byd_one_pedal_regen_default_max:{name:"\u0935\u0928-\u092a\u0947\u0921\u0932 \u0921\u094d\u0930\u093e\u0907\u0935 \u0930\u0940\u091c\u0928\u0930\u0947\u091f\u093f\u0935 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0921\u093f\u092b\u0949\u0932\u094d\u091f \u092e\u0948\u0915\u094d\u0938",desc:"\u0935\u093e\u0939\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0905\u092a \u092a\u0930 \u0932\u0917\u093e\u0924\u093e\u0930 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0909\u091a\u094d\u091a \u092a\u0941\u0928\u0930\u094d\u092f\u094b\u091c\u0940 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0915\u094b \u0932\u0949\u0915 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},mg_ismart_connectivity_unlock:{name:"\u0906\u0908-\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0915\u0928\u0947\u0915\u094d\u091f\u093f\u0935\u093f\u091f\u0940 \u0914\u0930 \u0930\u093f\u092e\u094b\u091f \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0905\u0928\u0932\u0949\u0915",desc:"\u0926\u0942\u0930\u0938\u094d\u0925 \u091c\u0932\u0935\u093e\u092f\u0941 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0914\u0930 \u0935\u093e\u0939\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},mg_mg4_xpower_launch_control_enable:{name:"MG4 XPower \u0921\u0941\u0905\u0932-\u092e\u094b\u091f\u0930 \u0932\u0949\u0928\u094d\u091a \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u094b\u0921",desc:"3.8s 0-100 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0932\u0949\u0928\u094d\u091a \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0924\u094d\u0935\u0930\u0923 \u092e\u094b\u0921 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},mg_battery_preheat_manual_trigger:{name:"\u092e\u0948\u0928\u0941\u0905\u0932 \u092b\u093e\u0938\u094d\u091f-\u091a\u093e\u0930\u094d\u091c \u092c\u0948\u091f\u0930\u0940 \u092a\u094d\u0930\u0940-\u0915\u0902\u0921\u0940\u0936\u0928\u093f\u0902\u0917",desc:"\u0905\u0927\u093f\u0915\u0924\u092e \u0921\u0940\u0938\u0940 \u091a\u093e\u0930\u094d\u091c \u0926\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u093e\u0908-\u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092c\u0948\u091f\u0930\u0940 \u0939\u0940\u091f\u093f\u0902\u0917 \u0924\u0924\u094d\u0935\u094b\u0902 \u0915\u094b \u091a\u093e\u0932\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},xpeng_xngp_adas_region_unlock:{name:"XNGP \u0938\u094d\u0935\u093e\u092f\u0924\u094d\u0924 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0938\u0939\u093e\u092f\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0905\u0928\u0932\u0949\u0915",desc:"\u0905\u0928\u0932\u0949\u0915 \u0915\u093f\u090f \u0917\u090f \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u0909\u0928\u094d\u0928\u0924 \u0928\u0947\u0935\u093f\u0917\u0947\u0936\u0928-\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u092a\u093e\u092f\u0932\u091f \u0938\u0939\u093e\u092f\u0924\u093e \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},xpeng_ambient_lighting_music_sync:{name:"\u0938\u0902\u0917\u0940\u0924-\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u0936\u0940\u0932 \u0932\u092f \u092a\u0930\u093f\u0935\u0947\u0936 \u092a\u094d\u0930\u0915\u093e\u0936",desc:"\u0911\u0921\u093f\u092f\u094b \u0938\u093f\u0938\u094d\u091f\u092e \u092c\u093e\u0938 \u092c\u0940\u091f\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0915\u0947\u092c\u093f\u0928 \u090f\u0932\u0908\u0921\u0940 \u092a\u0930\u093f\u0935\u0947\u0936 \u092a\u094d\u0930\u0915\u093e\u0936 \u0926\u093e\u0932\u094b\u0902 \u0915\u094b \u0938\u093f\u0902\u0915\u094d\u0930\u0928\u093e\u0907\u091c\u093c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},xpeng_rear_camera_trailer_hitch_view:{name:"360\xb0 \u0915\u0948\u092e\u0930\u093e \u0939\u093f\u091a \u0914\u0930 \u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u0913\u0935\u0930\u0932\u0947 \u092e\u094b\u0921",desc:"\u092c\u0948\u0915\u0905\u092a \u0915\u0948\u092e\u0930\u0947 \u092e\u0947\u0902 \u0909\u091a\u094d\u091a-\u0930\u093f\u091c\u093c\u0949\u0932\u094d\u092f\u0942\u0936\u0928 \u0939\u093f\u091a \u0938\u0902\u0930\u0947\u0916\u0923 \u0917\u094d\u0930\u093f\u0921 \u0913\u0935\u0930\u0932\u0947 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"},nio_battery_swap_interval_reminder:{name:"\u092a\u093e\u0935\u0930 \u0938\u094d\u0935\u0948\u092a \u0938\u094d\u091f\u0947\u0936\u0928 \u092a\u094d\u0930\u0940-\u0915\u0902\u0921\u0940\u0936\u0928\u093f\u0902\u0917 \u092e\u094b\u0921",desc:"\u0938\u094d\u0935\u0948\u092a \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092c\u0948\u091f\u0930\u0940 \u0932\u0949\u0915 \u092a\u093f\u0928 \u0914\u0930 \u092a\u094d\u0930\u0940-\u0915\u0902\u0921\u0940\u0936\u0928 \u092a\u0948\u0915 \u0915\u094b \u0915\u092e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},nio_nomi_assistant_custom_voice_phrases:{name:"NOMI AI \u0915\u0902\u092a\u0947\u0928\u093f\u092f\u0928 \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915\u0930\u0923 \u0914\u0930 \u0935\u0947\u0915 \u0935\u0930\u094d\u0921\u094d\u0938",desc:"NOMI \u0915\u0947 \u0932\u093f\u090f \u0915\u0938\u094d\u091f\u092e \u0905\u0935\u0924\u093e\u0930 \u090f\u0928\u093f\u092e\u0947\u0936\u0928 \u0914\u0930 \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915\u0943\u0924 \u0905\u092d\u093f\u0935\u093e\u0926\u0928 \u0935\u093e\u0915\u094d\u092f\u093e\u0902\u0936\u094b\u0902 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},nio_sentry_watchdog_continuous_recording:{name:"\u090f\u0928\u0906\u0908\u0913 \u0938\u0947\u0902\u091f\u094d\u0930\u0940 \u092e\u094b\u0921 4\u0915\u0947 \u0915\u0948\u092e\u0930\u093e \u092c\u092b\u0930 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917",desc:"\u092a\u093e\u0930\u094d\u0915 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u092a\u0930 \u092f\u0942\u090f\u0938\u092c\u0940 \u0921\u094d\u0930\u093e\u0907\u0935 \u092a\u0930 \u0939\u093e\u0908-\u092c\u093f\u091f\u0930\u0947\u091f \u0938\u0930\u093e\u0909\u0902\u0921 \u0915\u0948\u092e\u0930\u093e \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},xiaomi_su7_hyperos_driver_profile_sync:{name:"Xiaomi SU7 \u0939\u093e\u0907\u092a\u0930OS \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0907\u0915\u094b\u0938\u093f\u0938\u094d\u091f\u092e \u0938\u093f\u0902\u0915",desc:"Xiaomi \u092b\u093c\u094b\u0928 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0940\u091f, \u0926\u0930\u094d\u092a\u0923 \u0914\u0930 \u091c\u0932\u0935\u093e\u092f\u0941 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0915\u094b \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0938\u093f\u0902\u0915\u094d\u0930\u094b\u0928\u093e\u0907\u091c\u093c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},xiaomi_su7_boost_mode_throttle_curve:{name:"\u092c\u0942\u0938\u094d\u091f \u092e\u094b\u0921 20-\u0938\u0947\u0915\u0902\u0921 \u0913\u0935\u0930\u092c\u0942\u0938\u094d\u091f \u092a\u093e\u0935\u0930 \u0905\u0928\u0932\u0949\u0915",desc:"\u092a\u0942\u0930\u094d\u0923 \u0925\u094d\u0930\u0949\u091f\u0932 \u0924\u094d\u0935\u0930\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0905\u0927\u093f\u0915\u0924\u092e \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u093f\u0915 \u092e\u094b\u091f\u0930 \u0913\u0935\u0930\u092c\u0942\u0938\u094d\u091f \u0905\u0935\u0927\u093f \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964"},xiaomi_su7_drift_mode_torque_vectoring:{name:"\u0921\u094d\u0930\u093f\u092b\u094d\u091f \u092e\u094b\u0921 \u0906\u0930\u0921\u092c\u094d\u0932\u094d\u092f\u0942\u0921\u0940 \u091f\u0949\u0930\u094d\u0915 \u0935\u0947\u0915\u094d\u091f\u0930\u093f\u0902\u0917 \u0906\u0935\u0902\u091f\u0928",desc:"\u091f\u094d\u0930\u0948\u0915\u094d\u0936\u0928 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0930\u093f\u092f\u0930 \u090f\u0915\u094d\u0938\u0932 \u0915\u094b 100% \u092e\u094b\u091f\u0930 \u091f\u0949\u0930\u094d\u0915 \u0906\u0935\u0902\u091f\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},chery_isa_overspeed_warning_chime_off:{name:"\u0906\u0908\u090f\u0938\u090f \u0907\u0902\u091f\u0947\u0932\u093f\u091c\u0947\u0902\u091f \u0938\u094d\u092a\u0940\u0921 \u0905\u0938\u093f\u0938\u094d\u091f \u0935\u093e\u0930\u094d\u0928\u093f\u0902\u0917 \u091a\u093e\u0907\u092e \u092e\u094d\u092f\u0942\u091f",desc:"\u091c\u094d\u091e\u093e\u0924 \u0917\u0924\u093f \u0938\u0940\u092e\u093e \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0932\u0917\u093e\u0924\u093e\u0930 \u0927\u094d\u0935\u0928\u093f\u0915 \u091d\u0902\u0915\u093e\u0930 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},chery_driver_monitoring_camera_sensitivity:{name:"\u0921\u0940\u090f\u092e\u090f\u0938 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0925\u0915\u093e\u0928 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0948\u092e\u0930\u093e \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",desc:"\u0906\u0902\u0924\u0930\u093f\u0915 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0948\u092e\u0930\u0947 \u0938\u0947 \u091d\u0942\u0920\u0940-\u0938\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u0935\u094d\u092f\u093e\u0915\u0941\u0932\u0924\u093e \u0905\u0932\u0930\u094d\u091f \u0915\u094b \u0915\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},retrofit_parking_sensor_coding:{name:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u092b\u094d\u0930\u0902\u091f/\u0930\u093f\u092f\u0930 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0921\u093f\u0938\u094d\u091f\u0947\u0902\u0938 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 (\u092a\u0940\u0921\u0940\u0938\u0940) \u0915\u094b\u0921\u093f\u0902\u0917",desc:"\u0917\u0947\u091f\u0935\u0947 \u0907\u0902\u0938\u094d\u091f\u093e\u0932\u0947\u0936\u0928 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0906\u092b\u094d\u091f\u0930\u092e\u093e\u0930\u094d\u0915\u0947\u091f \u092f\u093e \u0913\u0908\u090f\u092e \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0938\u0947\u0902\u0938\u0930 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},retrofit_360_camera_activation:{name:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f 360\xb0 \u090f\u0930\u093f\u092f\u093e \u0935\u094d\u092f\u0942 \u0938\u0930\u093e\u0909\u0902\u0921 \u0915\u0948\u092e\u0930\u093e \u0938\u093f\u0938\u094d\u091f\u092e",desc:"\u0938\u0930\u093e\u0909\u0902\u0921 \u0935\u094d\u092f\u0942 \u0915\u0948\u092e\u0930\u093e \u0915\u0902\u091f\u094d\u0930\u094b\u0932\u0930 \u0915\u094b \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0907\u0902\u092b\u094b\u091f\u0947\u0928\u092e\u0947\u0902\u091f \u092e\u0947\u0902 \u0915\u0948\u092e\u0930\u093e \u0935\u094d\u092f\u0942 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"},retrofit_led_license_plate_light_coding:{name:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u090f\u0932\u0908\u0921\u0940 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u092a\u094d\u0932\u0947\u091f \u0914\u0930 \u091f\u0947\u0932 \u0932\u093e\u0907\u091f \u0924\u094d\u0930\u0941\u091f\u093f \u0930\u0926\u094d\u0926",desc:"\u090f\u0932\u0908\u0921\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0917\u0932\u0924 \u0932\u0948\u0902\u092a \u0906\u0909\u091f \u091a\u0947\u0924\u093e\u0935\u0928\u093f\u092f\u094b\u0902 \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0932\u094d\u0921 \u092c\u0932\u094d\u092c \u091a\u0947\u0915 \u092e\u0949\u0928\u093f\u091f\u0930\u093f\u0902\u0917 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},retrofit_dash_cam_sentry_integration:{name:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u0921\u0948\u0936 \u0915\u0948\u092e \u0938\u0924\u0924 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u092a\u093e\u0935\u0930 \u0914\u0930 \u0938\u0947\u0902\u091f\u094d\u0930\u0940 \u092e\u094b\u0921",desc:"\u0928\u093f\u0930\u0902\u0924\u0930 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u092c\u0949\u0921\u0940 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u091f\u0930\u094d\u092e\u093f\u0928\u0932 30 \u092a\u093e\u0935\u0930 \u0932\u093e\u0907\u0928 \u0915\u094b \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},retrofit_heated_windshield_activation:{name:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u0939\u0940\u091f\u0947\u0921 \u0935\u093f\u0902\u0921\u0936\u0940\u0932\u094d\u0921 \u090f\u0932\u093f\u092e\u0947\u0902\u091f \u0915\u094b\u0921\u093f\u0902\u0917",desc:"\u0935\u093f\u0902\u0921\u0936\u0940\u0932\u094d\u0921 \u0921\u093f\u092b\u094d\u0930\u0949\u0938\u094d\u091f \u0939\u0940\u091f\u0930 \u0930\u093f\u0932\u0947 \u0906\u0909\u091f\u092a\u0941\u091f \u0914\u0930 \u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f\u094d\u0930\u094b\u0928\u093f\u0915 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092c\u091f\u0928 \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},retrofit_wireless_charger_module_coding:{name:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u0915\u094d\u092f\u0942\u0908 \u0935\u093e\u092f\u0930\u0932\u0947\u0938 \u0938\u094d\u092e\u093e\u0930\u094d\u091f\u092b\u093c\u094b\u0928 \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917 \u092a\u0948\u0921 \u090f\u0915\u0940\u0915\u0930\u0923",desc:"\u0935\u093e\u092f\u0930\u0932\u0947\u0938 \u091a\u093e\u0930\u094d\u091c\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u090f\u0932\u0908\u0921\u0940 \u0914\u0930 \u092b\u094b\u0928 \u0915\u0947 \u092a\u0940\u091b\u0947 \u091b\u0942\u091f\u0947 \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u092a\u0949\u092a\u0905\u092a \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},retrofit_acc_radar_module_coding:{name:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f \u090f\u0921\u0947\u092a\u094d\u091f\u093f\u0935 \u0915\u094d\u0930\u0942\u091c\u093c \u0915\u0902\u091f\u094d\u0930\u094b\u0932 (\u090f\u0938\u0940\u0938\u0940) \u092b\u094d\u0930\u0902\u091f \u0930\u0921\u093e\u0930 \u092e\u0949\u0921\u094d\u092f\u0942\u0932",desc:"\u0930\u0947\u091f\u094d\u0930\u094b\u092b\u093f\u091f\u0947\u0921 \u092b\u094d\u0930\u0902\u091f \u0921\u093f\u0938\u094d\u091f\u0947\u0902\u0938 \u0930\u0921\u093e\u0930 \u092f\u0942\u0928\u093f\u091f \u0915\u094b CAN \u092c\u0938 \u0935\u093e\u0939\u0928 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u092e\u0947\u0902 \u090f\u0928\u0915\u094b\u0921 \u0915\u0930\u0924\u09