atif maximum \xe0 une p\xe9dale par d\xe9faut",desc:"D\xe9finit le freinage r\xe9g\xe9n\xe9ratif maximum (mode d'arr\xeat \xe0 une p\xe9dale) par d\xe9faut au d\xe9marrage du v\xe9hicule."},byd_soc_max_charge_target_limit:{name:"Limite de charge maximale de protection de la sant\xe9 de la batterie BYD (80 % / 90 %)",desc:"D\xe9finit la limite maximale de coupure de charge AC/DC \xe0 80 % ou 90 % pour prolonger la dur\xe9e de vie de la batterie Blade."},byd_dmi_forced_pure_ev_speed_override:{name:"Remplacement du moteur \xe0 essence en mode BYD DM-i Pure EV",desc:"Emp\xeache le d\xe9marrage du moteur \xe0 essence en mode EV jusqu'\xe0 130 km/h, m\xeame lors d'une acc\xe9l\xe9ration \xe0 plein r\xe9gime."},byd_vtol_v2v_rescue_charge_mode:{name:"Mode de charge de secours BYD VTOL (v\xe9hicule \xe0 v\xe9hicule)",desc:"D\xe9bloque la sortie d'alimentation CA externe pour recharger les v\xe9hicules \xe9lectriques bloqu\xe9s sur la route."},hyundai_ipedal_memory_lock:{name:"Verrouillage de la m\xe9moire de conduite \xe0 une p\xe9dale Hyundai / Kia i-PEDAL",desc:"Emp\xeache le mode d'arr\xeat \xe0 une p\xe9dale de l'i-PEDAL de revenir au niveau 3 apr\xe8s le passage en marche arri\xe8re."},hyundai_utility_mode_12v_saver:{name:"Mode de camping utilitaire \xc9conomiseur haute tension 12 V",desc:"Alimente la prise V2L 220 V directement \xe0 partir de la batterie de traction HV pour \xe9viter la d\xe9charge de la batterie auxiliaire 12 V."},hyundai_phev_no_ice_climate_start:{name:"Suppression du moteur \xe0 essence du chauffage climatique du mode PHEV EV",desc:"Pompe \xe0 chaleur / chauffage \xe9lectrique PTC pour le climat de l'habitacle sans d\xe9marrer le moteur \xe0 essence."},vag_taycan_ess_sound_profile_swap:{name:"Profil Taycan / RS e-tron avec son \xe9lectrique sport (ESS)",desc:"Modifie le profil sonore de la conduite \xe9lectrique en g\xe9n\xe9rateur de sons Porsche Taycan GTS ou Audi RS e-tron GT."},vag_meb_daily_charge_target_menu:{name:"Batterie MEB quotidienne 80 