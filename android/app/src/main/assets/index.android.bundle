c \uc5d4\uc9c4 \uc18c\ub9ac \uc0dd\uc131\uae30\ub97c \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},vag_wireless_carplay_enable:{name:"\ubb34\uc120 Apple CarPlay \ubc0f Android \uc790\ub3d9 \ud65c\uc131\ud654",desc:"MIB2.5/MIB3 \uc7a5\uce58\uc5d0\uc11c 5GHz Wi-Fi \ubb34\uc120 Apple CarPlay \ubc0f Android Auto\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},vag_offroad_telemetry_menu:{name:"MIB \uc624\ud504\ub85c\ub4dc \uc6d0\uaca9 \uce21\uc815 \ubc0f \uac8c\uc774\uc9c0 \ub514\uc2a4\ud50c\ub808\uc774",desc:"MIB \ud654\uba74\uc5d0 \uc870\ud5a5 \uac01\ub3c4, \uc624\uc77c \uc628\ub3c4, \ub0c9\uac01\uc218 \uc628\ub3c4 \ubc0f \uace0\ub3c4 \uac8c\uc774\uc9c0\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4."},vag_easy_entry_driver_seat:{name:"\uc790\ub3d9 \uc774\uc9c0 \uc5d4\ud2b8\ub9ac \ud30c\uc6cc \uc2dc\ud2b8 \ubc31\uc2a4\ud15d",desc:"\ub3c4\uc5b4 \uc5f4\ub9bc \uc2dc \uc804\ub3d9 \uc6b4\uc804\uc11d\uc744 5cm \ub4a4\ub85c \uc774\ub3d9\uc2dc\ucf1c \ucc28\ub7c9\uc5d0 \uc27d\uac8c \ud0d1\uc2b9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},vag_hba_memory_state:{name:"\ud558\uc774\ube54 \ubcf4\uc870(HBA) \uba54\ubaa8\ub9ac \uc720\uc9c0",desc:"\uc810\ud654 \uc7ac\uc2dc\uc791 \uc8fc\uae30 \uc804\ubc18\uc5d0 \uac78\uccd0 \ud558\uc774\ube54 \uc5b4\uc2dc\uc2a4\ud2b8 ON \uc0c1\ud0dc\ub97c \uae30\uc5b5\ud569\ub2c8\ub2e4."},vag_battery_soc_display:{name:"\ubc30\ud130\ub9ac \ucda9\uc804 \uc0c1\ud0dc(% SOC) \ud45c\uc2dc",desc:"\ud2b8\ub9bd \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uc788\uc73c\uba74 \uacc4\uae30\ud310\uc5d0 \uc815\ud655\ud55c \ubc30\ud130\ub9ac \ucda9\uc804\uc728(% SOC)\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4."},bmw_idrive7_m_animation:{name:"iDrive 7/8 M-\uc131\ub2a5 \uc2dc\ub3d9 \uc560\ub2c8\uba54\uc774\uc158",desc:"iDrive \ud654\uba74 \ubd80\ud305 \uadf8\ub798\ud53d\uc744 M-Performance \ub610\ub294 M-GmbH \ub85c\uace0 \uc560\ub2c8\uba54\uc774\uc158\uc73c\ub85c \ubcc0\uacbd\ud569\ub2c8\ub2e4."},bmw_bowers_wilkins_audio_profiles:{name:"Bowers & Wilkins 3D \uc0ac\uc6b4\ub4dc \uc5d4\uc9c4 \uc7a0\uae08 \ud574\uc81c",desc:"HiFi \uc2dc\uc2a4\ud15c\uc5d0\uc11c Bowers & Wilkins \ucf58\uc11c\ud2b8, \uc2a4\ud29c\ub514\uc624 \ubc0f \ubb34\ub300 DSP \uc624\ub514\uc624 \ud504\ub85c\ud544\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},bmw_hitch_zoom_camera:{name:"\ub9ac\ubc84\uc2a4 \uce74\uba54\ub77c \ud2b8\ub808\uc77c\ub7ec \ud788\uce58 \uc90c \ubaa8\ub4dc",desc:"\ud6c4\ubc29 \uce74\uba54\ub77c \ubcf4\uae30\uc5d0\uc11c \ud558\ud5a5\uc2dd \ud2b8\ub808\uc77c\ub7ec \ud788\uce58 \uc815\ub82c \ud655\ub300/\ucd95\uc18c \ubaa8\ub4dc\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},bmw_secure_idle_protection:{name:"\uc548\uc804\ud55c \uc720\ud734 \uc5d4\uc9c4 Shift-Lock \ubcf4\ud638",desc:"\uc6b4\uc804\uc790\uac00 \uc804\uc790\uc5f4\uc1e0\ub97c \ub4e4\uace0 \ub2ec\ub9ac\ub294 \ucc28\ub7c9\uc744 \ub5a0\ub0a0 \uacbd\uc6b0 \uc8fc\ucc28 \ubaa8\ub4dc\uc5d0\uc11c \ubcc0\uc18d\uae30\ub97c \uc7a0\uae09\ub2c8\ub2e4."},bmw_seatbelt_handover_mute:{name:"\ucfe0\ud398 \uc804\uc790 \uc548\uc804\ubca8\ud2b8 \ud578\ub4dc\uc624\ubc84 \uc554 \ube44\ud65c\uc131\ud654",desc:"4 \uc2dc\ub9ac\uc988 \ubc0f 2 \uc2dc\ub9ac\uc988 \ucfe0\ud398\uc5d0\uc11c \uc804\ub3d9\uc2dd \uc548\uc804\ubca8\ud2b8 \uc5f0\uc7a5 \uc554\uc744 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},bmw_auto_heat_threshold_5c:{name:"\uc790\ub3d9 \uc2dc\ud2b8 \ubc0f \uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \uac00\uc5f4 \uc628\ub3c4(+5\xb0C)",desc:"\uc8fc\ubcc0 \uc628\ub3c4\uac00 5\xb0C \ubbf8\ub9cc\uc73c\ub85c \ub5a8\uc5b4\uc9c0\uba74 \uc790\ub3d9 \uc2dc\ud2b8 \ubc0f \uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \uac00\uc5f4\uc774 \uc2dc\uc791\ub429\ub2c8\ub2e4."},mercedes_amg_track_pace_unlock:{name:"MBUX AMG \ud2b8\ub799 \ud398\uc774\uc2a4 \uc6d0\uaca9 \uce21\uc815 \ubc0f \ub7a9 \ud0c0\uc774\uba38",desc:"MBUX \ud654\uba74\uc5d0\uc11c \ub7a9 \ud0c0\uc774\ubc0d, \uac00\uc18d \uc6d0\uaca9 \uce21\uc815 \ubc0f G-force \uadf8\ub798\ud504\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},mercedes_drive_mode_last_memory:{name:"\ub3d9\uc801 \uc120\ud0dd \ub9c8\uc9c0\ub9c9 \uc8fc\ud589 \ubaa8\ub4dc \uba54\ubaa8\ub9ac",desc:"\ucc28\ub7c9 \uc7ac\uc2dc\ub3d9 \uc2dc \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc120\ud0dd\ud55c \uc8fc\ud589 \ubaa8\ub4dc(\uac1c\uc778/\uc2a4\ud3ec\uce20)\ub97c \uae30\uc5b5\ud569\ub2c8\ub2e4."},mercedes_proximity_360_camera_auto:{name:"\uadfc\uc811 \uc13c\uc11c \uc790\ub3d9 360\xb0 \uce74\uba54\ub77c \ubdf0",desc:"\uc804\ubc29 \uc13c\uc11c\uac00 50cm \ubbf8\ub9cc\uc758 \uc7a5\uc560\ubb3c\uc744 \uac10\uc9c0\ud558\uba74 \uc790\ub3d9\uc73c\ub85c \ud654\uba74\uc744 360 \uce74\uba54\ub77c\ub85c \uc804\ud658\ud569\ub2c8\ub2e4."},ford_sync_climate_screen_unlock:{name:"SYNC3 / SYNC4 \ud130\uce58\uc2a4\ud06c\ub9b0 \uc628\ub3c4 \uc870\uc808 \ud398\uc774\uc9c0",desc:"\uc628\ub3c4 \uc870\uc808, \uc5f4\uc120 \uc2dc\ud2b8, \uacf5\uae30 \ud750\ub984 \ubc29\ud5a5 \ud130\uce58\uc2a4\ud06c\ub9b0 \ud398\uc774\uc9c0\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ford_turn_signal_5_flashes:{name:"\uc6d0\ud130\uce58 \ucc28\uc120 \ubcc0\uacbd \uc2e0\ud638(5\ud68c \uc810\uba78)",desc:"\uc6d0\ud130\uce58 \ucc28\uc120 \ubcc0\uacbd \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \uae5c\ubc15\uc784 \uc2dc\uac04\uc774 3\ud68c\uc5d0\uc11c 5\ud68c\ub85c \ub298\uc5b4\ub0a9\ub2c8\ub2e4."},ford_auto_engine_shutdown_disable:{name:"30\ubd84 \uacf5\ud68c\uc804 \uc790\ub3d9 \uc5d4\uc9c4 \ucc28\ub2e8 \ubb34\uc2dc",desc:"30\ubd84 \uacf5\ud68c\uc804 \ud6c4 \uc790\ub3d9 \uc5d4\uc9c4 \ucc28\ub2e8\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4(\ucea0\ud551/\uc804\uc6d0 \ucf58\uc13c\ud2b8 \uc0ac\uc6a9 \uc2dc)."},ev_battery_preheat_manual_switch:{name:"EV \ubc30\ud130\ub9ac \uc608\uc5f4 \uc218\ub3d9 \uc2a4\uc704\uce58(\ube60\ub978 DC \ucda9\uc804 \uc900\ube44)",desc:"\ud0d0\uc0c9 \uacbd\ub85c \uc5c6\uc774 DC \uace0\uc18d \ucda9\uc804 \uc804\uc5d0 \ubc30\ud130\ub9ac\ub97c 25\xb0C\uae4c\uc9c0 \uc218\ub3d9\uc73c\ub85c \uc608\uc5f4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},ev_v2l_power_output_expand:{name:"V2L(Vehicle-to-Load) 220V \ucf58\uc13c\ud2b8 \uc804\ub825 \ud655\uc7a5(3.6kW)",desc:"V2L \uc678\ubd80 220V AC \uac00\uc815\uc6a9 \uc804\uc6d0 \ucf58\uc13c\ud2b8 \uc81c\ud55c\uc744 2.2kW\uc5d0\uc11c 3.6kW\ub85c \ud655\uc7a5\ud569\ub2c8\ub2e4."},ev_one_pedal_regen_force_level3:{name:"1\ud398\ub2ec \ub4dc\ub77c\uc774\ube0c \ucd5c\ub300 \ud68c\uc0dd \uc81c\ub3d9 \uae30\ubcf8\uac12",desc:"\ucc28\ub7c9 \uc2dc\ub3d9 \uc2dc \ucd5c\ub300 \ud68c\uc0dd \uc81c\ub3d9(\uc6d0\ud398\ub2ec \uc815\uc9c0 \ubaa8\ub4dc)\uc744 \uae30\ubcf8\uac12\uc73c\ub85c \uc124\uc815\ud569\ub2c8\ub2e4."},byd_soc_max_charge_target_limit:{name:"BYD \ubc30\ud130\ub9ac \uc0c1\ud0dc \ubcf4\ud638 \ucd5c\ub300 \ucda9\uc804 \ud55c\ub3c4(80% / 90%)",desc:"\ube14\ub808\uc774\ub4dc \ubc30\ud130\ub9ac \uc218\uba85\uc744 \uc5f0\uc7a5\ud558\ub824\uba74 \ucd5c\ub300 AC/DC \ucda9\uc804 \ucc28\ub2e8 \uc81c\ud55c\uc744 80% \ub610\ub294 90%\ub85c \uc124\uc815\ud569\ub2c8\ub2e4."},byd_dmi_forced_pure_ev_speed_override:{name:"BYD DM-i \uc21c\uc218 EV \ubaa8\ub4dc \uac00\uc194\ub9b0 \uc5d4\uc9c4 \uc624\ubc84\ub77c\uc774\ub4dc",desc:"\ud480 \uc2a4\ub85c\ud2c0 \uac00\uc18d \uc911\uc5d0\ub3c4 \ucd5c\ub300 130km/h\uae4c\uc9c0 EV \ubaa8\ub4dc\uc5d0\uc11c \uac00\uc194\ub9b0 \uc5d4\uc9c4 \uc2dc\ub3d9\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4."},byd_vtol_v2v_rescue_charge_mode:{name:"BYD VTOL(\ucc28\ub7c9 \ub300 \ucc28\ub7c9) \uad6c\uc870 \ucda9\uc804 \ubaa8\ub4dc",desc:"\ub3c4\ub85c\uc5d0 \uace0\ub9bd\ub41c \uc804\uae30 \uc790\ub3d9\ucc28\ub97c \ucda9\uc804\ud558\uae30 \uc704\ud574 \uc678\ubd80 AC \uc804\uc6d0 \ucd9c\ub825\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},hyundai_ipedal_memory_lock:{name:"\ud604\ub300/\uae30\uc544 i-PEDAL \uc6d0\ud398\ub2ec \ub4dc\ub77c\uc774\ube0c \uba54\ubaa8\ub9ac \uc7a0\uae08 \uc7a5\uce58",desc:"i-PEDAL \uc6d0\ud398\ub2ec \uc815\uc9c0 \ubaa8\ub4dc\uac00 \ud6c4\uc9c4 \ubaa8\ub4dc\ub85c \uc804\ud658\ub41c \ud6c4 \ub808\ubca8 3\uc73c\ub85c \ub3cc\uc544\uac00\ub294 \uac83\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4."},hyundai_utility_mode_12v_saver:{name:"\uc720\ud2f8\ub9ac\ud2f0 \ucea0\ud551 \ubaa8\ub4dc \uace0\uc804\uc555 12V \uc138\uc774\ubc84",desc:"\ubcf4\uc870 12V \ubc30\ud130\ub9ac \uc18c\ubaa8\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 HV \uacac\uc778 \ubc30\ud130\ub9ac\uc5d0\uc11c \uc9c1\uc811 220V V2L \ucf58\uc13c\ud2b8\uc5d0 \uc804\uc6d0\uc744 \uacf5\uae09\ud569\ub2c8\ub2e4."},hyundai_phev_no_ice_climate_start:{name:"PHEV EV \ubaa8\ub4dc \uae30\ud6c4 \ub09c\ubc29 \uac00\uc194\ub9b0 \uc5d4\uc9c4 \uc5b5\uc81c",desc:"\uac00\uc194\ub9b0 \uc5d4\uc9c4\uc744 \uc2dc\ub3d9\ud558\uc9c0 \uc54a\uace0\ub3c4 \uac1d\uc2e4 \uc628\ub3c4\uc5d0 \ub9de\uac8c \ud788\ud2b8 \ud38c\ud504/PTC \uc804\uae30 \ud788\ud130\ub97c \uc791\ub3d9\ud569\ub2c8\ub2e4."},vag_taycan_ess_sound_profile_swap:{name:"\uc77c\ub809\ud2b8\ub9ad \uc2a4\ud3ec\uce20 \uc0ac\uc6b4\ub4dc(ESS) Taycan / RS e-tron \ud504\ub85c\ud544",desc:"\uc804\uae30 \uc8fc\ud589 \uc0ac\uc6b4\ub4dc \ud504\ub85c\ud544\uc744 Porsche Taycan GTS \ub610\ub294 Audi RS e-tron GT \uc0ac\uc6b4\ub4dc \uc81c\ub108\ub808\uc774\ud130\ub85c \ubcc0\uacbd\ud569\ub2c8\ub2e4."},vag_meb_daily_charge_target_menu:{name:"MEB \ubc30\ud130\ub9ac \uc77c\uc77c 80% / \ud2b8\ub9bd 100% \uae09\uc18d \ucda9\uc804 \ubc14",desc:"MIB \ud654\uba74\uc5d0 \ube60\ub978 \ud1a0\uae00 \ubc14\ub97c \ucd94\uac00\ud558\uc5ec \uc77c\uc77c \ubc30\ud130\ub9ac \uad00\ub9ac 80%\uc640 \uc5ec\ud589 \ucda9\uc804 100% \uc0ac\uc774\ub97c \uc804\ud658\ud569\ub2c8\ub2e4."},vag_gte_generator_charge_reserve:{name:"GTE/E-Mode \uc5d4\uc9c4 \ubc1c\uc804\uae30 \ubc30\ud130\ub9ac \uac15\uc81c \ucda9\uc804(80%)",desc:"\uc5f0\uc18c \uc5d4\uc9c4\uc744 \ubc1c\uc804\uae30\ub85c \uc791\ub3d9\uc2dc\ucf1c \uc8fc\ud589 \uc911\uc5d0 \uace0\uc804\uc555 \ubc30\ud130\ub9ac\ub97c \ucd5c\ub300 80%\uae4c\uc9c0 \uc7ac\ucda9\uc804\ud569\ub2c8\ub2e4."},bmw_hans_zimmer_iconic_sounds_m:{name:"Hans Zimmer IconicSounds Electric M-Performance \uc0ac\uc6b4\ub4dc \uc5d4\uc9c4",desc:"i4 \ubc0f iX\uc5d0\uc11c Hans Zimmer \uc74c\ud5a5 M-Performance \uc804\uae30 \uac00\uc18d \uc0ac\uc6b4\ub4dc \ud504\ub85c\ud544\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},bmw_phev_max_edrive_140kmh:{name:"PHEV MAX eDrive \uc21c\uc218 \uc804\uae30 \uc18d\ub3c4 \uc0c1\ud55c\uc120(140km/h)",desc:"330e/530e \ud50c\ub7ec\uadf8\uc778 \ud558\uc774\ube0c\ub9ac\ub4dc\uc758 \ucd5c\ub300 \uc21c\uc218 \uc804\uae30 \uc18d\ub3c4 \ud55c\ub3c4\ub97c 140km/h\ub85c \ub298\ub9bd\ub2c8\ub2e4."},bmw_ac_charging_current_limit_menu:{name:"AC \uac00\uc815\uc6a9 \ucda9\uc804\uae30 \ucd5c\ub300 \uc804\ub958 \uc81c\ud55c \uc120\ud0dd\uae30(6A - 32A)",desc:"AC \ud648 \ucda9\uc804 \uc804\ub958 \uc81c\ud55c\uae30(6A/10A/16A/32A)\ub97c \ucd94\uac00\ud558\uc5ec \ud648 \ud68c\ub85c \uacfc\ubd80\ud558\ub97c \ubc29\uc9c0\ud569\ub2c8\ub2e4."},toyota_hybrid_ev_mode_override:{name:"Toyota/Lexus EV \ubaa8\ub4dc \uc2a4\ub85c\ud2c0 \uc624\ubc84\ub77c\uc774\ub4dc \uc5b5\uc81c",desc:"EV \ubaa8\ub4dc \ubc84\ud2bc\uc774 \ud65c\uc131\ud654\ub41c \uacbd\uc6b0 \uac00\uc18d \uc911 \uac00\uc194\ub9b0 \uc5d4\uc9c4\uc774 \uac15\uc81c \uc2dc\ub3d9\ub418\ub294 \uac83\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4."},toyota_hybrid_battery_fan_speed_boost:{name:"Toyota / Lexus \uace0\uc804\uc555 \ubc30\ud130\ub9ac \ub0c9\uac01 \ud32c \ubd80\uc2a4\ud2b8(+30%)",desc:"\ub354\uc6b4 \uae30\ud6c4\uc5d0\uc11c \uc5f4 \uc800\ud558\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ud558\uc774\ube0c\ub9ac\ub4dc \uacac\uc778 \ubc30\ud130\ub9ac \ub0c9\uac01 \ud32c \uc18d\ub3c4\ub97c +30% \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4."},tesla_sentry_high_bitrate_video:{name:"Tesla Sentry \ubaa8\ub4dc \ub192\uc740 \ube44\ud2b8\uc728 \uc5f0\uc18d \ub300\uc2dc\ucea0 \ub179\ud654",desc:"\uc120\uba85\ud55c \ubc88\ud638\ud310 \uac00\uc2dc\uc131\uc744 \uc704\ud574 \uac10\uc2dc \ubaa8\ub4dc \uce74\uba54\ub77c \ube44\ub514\uc624 \ub179\ud654 \ube44\ud2b8 \uc804\uc1a1\ub960\uc744 \ub192\uc785\ub2c8\ub2e4."},tesla_cabin_overheat_threshold_30c:{name:"Tesla \uce90\ube48 \uacfc\uc5f4 \ubcf4\ud638 \uc628\ub3c4 \uc784\uacc4\uac12(30\xb0C)",desc:"\ub0b4\ubd80 \ubcf4\uc874\uc744 \uc704\ud574 \uac1d\uc2e4 \uacfc\uc5f4 \ubcf4\ud638 \uae30\ud6c4 \ud2b8\ub9ac\uac70 \uc628\ub3c4\ub97c 40\xb0C\uc5d0\uc11c 30\xb0C\ub85c \ub0ae\ucda5\ub2c8\ub2e4."},bmwmotorrad_quickshifter_pro_readapt:{name:"Shift Assistant Pro \uc7ac\uc801\uc751",desc:"\ubcc0\uc18d \uc13c\uc11c \ud559\uc2b5 \ub9e4\uac1c\ubcc0\uc218\ub97c \uc7ac\uc124\uc815\ud558\uace0 \ud035\uc2dc\ud504\ud130 \uc7ac\ubcf4\uc815\uc744 \uc2dc\uc791\ud569\ub2c8\ub2e4."},bmwmotorrad_esa_zero_point_calib:{name:"\ub3d9\uc801 ESA \uc11c\uc2a4\ud39c\uc158 \uc601\uc810 \uad50\uc815",desc:"\uc804\uc790 \uc11c\uc2a4\ud39c\uc158 \ud558\uc911 \ubc0f \uc774\ub3d9 \uc13c\uc11c\ub97c \uacf5\uc7a5 0\uc73c\ub85c \uad50\uc815\ud569\ub2c8\ub2e4."},bmwmotorrad_abs_pro_cornering_toggle:{name:"ABS \ud504\ub85c \ucf54\ub108\ub9c1 \ubaa8\ub4dc \uac1c\uc785 \uc784\uacc4\uac12",desc:"\ud2b8\ub799 \uc0ac\uc6a9\uc744 \uc704\ud574 \uae30\uc6b8\uae30 \uac01\ub3c4\uc5d0 \ub530\ub978 ABS \uac1c\uc785 \uac10\ub3c4\ub97c \uc870\uc815\ud569\ub2c8\ub2e4."},bmwmotorrad_service_interval_reset:{name:"\uc5f0\uac04 \ubc0f \uc7a5\uac70\ub9ac \uc11c\ube44\uc2a4 \uc54c\ub9bc \uc7ac\uc124\uc815",desc:"\uacc4\uae30\ud310 \uc11c\ube44\uc2a4 \ud45c\uc2dc\uae30\ub97c \uc7ac\uc124\uc815\ud558\uace0 \uc0ac\uc6a9\uc790 \uc815\uc758 \uac04\uaca9\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."},bmwmotorrad_headlight_pro_cornering:{name:"Headlight Pro \uc801\uc751\ud615 \ucf54\ub108\ub9c1 \ube5b \uac10\ub3c4",desc:"\uc801\uc751\ud615 \ucf54\ub108\ub9c1 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \ud65c\uc131\ud654\ub97c \uc704\ud574 \uae30\uc6b8\uae30 \uac01\ub3c4 \uc784\uacc4\uac12\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},bmwmotorrad_keyless_ride_range_extend:{name:"\ubb34\ud0a4 \ud0d1\uc2b9 \uc804\uc790\uc2dc\uacc4 \uac10\uc9c0 \ubc94\uc704 \ud655\uc7a5",desc:"\ud0a4\ub9ac\uc2a4 \uc810\ud654 \uac10\uc9c0\ub97c \uc704\ud574 \ud2b8\ub79c\uc2a4\ud3f0\ub354 \uc2e0\ud638 \ubc94\uc704\ub97c \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4."},bmwmotorrad_reverse_assist_sensitivity:{name:"\uc804\uae30 \ud6c4\uc9c4 \ubcf4\uc870 \ubaa8\ud130 \uac10\ub3c4",desc:"\uc5ed\ubc29\ud5a5 \uad6c\ub3d9 \uc804\uae30 \uc2a4\ud0c0\ud130 \ubaa8\ud130 \uc18d\ub3c4 \ubc0f \ud1a0\ud06c \uc81c\ud55c\uc744 \ubbf8\uc138 \uc870\uc815\ud569\ub2c8\ub2e4."},ducati_riding_mode_custom_profile:{name:"\ub77c\uc774\ub529 \ubaa8\ub4dc \ub9de\ucda4\ud615 \ud504\ub85c\ud544 \uc0dd\uc131\uae30",desc:"\ub808\uc774\uc2a4, \uc2a4\ud3ec\uce20, \ud22c\uc5b4\ub9c1 \ubc0f \ub3c4\uc2dc \ud504\ub85c\ud544\uc5d0 \ub300\ud55c \uc0ac\uc6a9\uc790 \uc815\uc758 \uc870\ud569\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},ducati_ohlins_suspension_mapping:{name:"\xd6hlins Smart EC 2.0 \uc138\ubbf8\uc561\ud2f0\ube0c \uc11c\uc2a4\ud39c\uc158 \ub9e4\ud551",desc:"\uc804\uc790 \uc11c\uc2a4\ud39c\uc158\uc5d0 \ub300\ud55c \ub310\ud551 \uace1\uc120 \ubc0f \uac15\uc131 \uc0ac\uc804 \uc124\uc815\uc744 \ubbf8\uc138 \uc870\uc815\ud569\ub2c8\ub2e4."},ducati_dashboard_lap_timer_gps:{name:"TFT \ub300\uc2dc\ubcf4\ub4dc \ub7a9 \ud0c0\uc774\uba38 \ubc0f GPS \uc139\ud130 \ubd84\ud560",desc:"\uacc4\uae30\ud310\uc758 \ud2b8\ub799 \ub7a9 \ud0c0\uc774\uba38 \ubc0f \uc139\ud130 \ubd84\ud560 \ub514\uc2a4\ud50c\ub808\uc774\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},ducati_engine_brake_control_ebc:{name:"\uc5d4\uc9c4 \ube0c\ub808\uc774\ud06c \uc81c\uc5b4(EBC) \ub808\ubca8 \uc870\uc815",desc:"\ud558\ub4dc \ucf54\ub108 \uc9c4\uc785 \uc81c\ub3d9 \uc911 \ub4b7\ubc14\ud034 \uac10\uc18d \ud1a0\ud06c\ub97c \uc870\uc815\ud569\ub2c8\ub2e4."},ducati_cruise_control_retrofit_enable:{name:"\ud06c\ub8e8\uc988 \ucee8\ud2b8\ub864 \uac1c\uc870 \ud65c\uc131\ud654",desc:"\uc0c8\ub85c \uc7a5\ucc29\ub41c \uc804\uc790 \ud06c\ub8e8\uc988 \ucee8\ud2b8\ub864 \uc2a4\uc704\uce58\uc5d0 \ub300\ud574 ECU \uc18c\ud504\ud2b8\uc6e8\uc5b4 \ud50c\ub798\uadf8\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ducati_exhaust_valve_sound_map:{name:"\ubc30\uae30 \uc11c\ubcf4 \ubc38\ube0c \uc5f4\ub9bc RPM \ub9f5",desc:"\ud5a5\uc0c1\ub41c \ubc30\uae30 \ub178\ud2b8\ub97c \uc704\ud574 \uc74c\ud5a5 \ubc30\uae30 \ubc38\ube0c \uac1c\ubc29 \uc784\uacc4\uac12\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},ducati_pit_lane_limiter_config:{name:"\ud53c\ud2b8 \ub808\uc778 \uc18d\ub3c4 \uc81c\ud55c\uae30 \uc784\uacc4\uac12",desc:"\ud578\ub4e4\ubc14 \uc2a4\uc704\uce58\uc5d0\uc11c 60km/h \ud53c\ud2b8 \ub808\uc778 \uc18d\ub3c4 \uc81c\ud55c \uc7a5\uce58 \ud1a0\uae00\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ducati_desmo_service_light_reset:{name:"\uc624\uc77c \ubc0f \ub370\uc2a4\ubaa8 \ubc38\ube0c \uc11c\ube44\uc2a4 \ud45c\uc2dc\ub4f1 \uc7ac\uc124\uc815",desc:"\uacc4\uae30\ud310\uc758 \ub370\uc2a4\ubaa8\ub4dc\ub85c\ubbf9 \ubc38\ube0c \uc11c\ube44\uc2a4 \uc54c\ub9bc \uacbd\uace0\ub97c \uc9c0\uc6c1\ub2c8\ub2e4."},ktm_quickshifter_plus_delay_tuning:{name:"Quickshifter+ Shift Cut \uc2dc\uac04 \ubc0f \uc9c0\uc5f0 \ubbf8\uc138 \uc870\uc815",desc:"\uc6d0\ud65c\ud55c \uc5c5/\ub2e4\uc6b4 \ubcc0\uc18d\uc744 \uc704\ud574 \uae30\uc5b4\ub2f9 \uc810\ud654 \ucc28\ub2e8 \uc2dc\uac04\uc744 \ub9de\ucda4\ud654\ud569\ub2c8\ub2e4."},ktm_rally_offroad_abs_tc_unlock:{name:"\ub7a0\ub9ac/\uc624\ud504\ub85c\ub4dc ABS \ubc0f TC \ubaa8\ub4dc \uc7a0\uae08 \ud574\uc81c",desc:"\ud6c4\ubc29 ABS\ub97c \ube44\ud65c\uc131\ud654\ud558\uace0 \ub7a0\ub9ac \ubaa8\ub4dc\uc5d0\uc11c 9\ub2e8\uacc4 \uc2ac\ub9bd \uc870\uc815\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},ktm_my_ktm_connectivity_unlock:{name:"\ub0b4 KTM/Husqvarna \uc5f0\uacb0 \ubaa8\ub4c8 \ud65c\uc131\ud654",desc:"TFT \ub514\uc2a4\ud50c\ub808\uc774\uc5d0\uc11c Bluetooth \ud0d0\uc0c9 \ubc0f \ub2e8\uacc4\ubcc4 \ub77c\uc6b0\ud305\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ktm_cruise_control_retrofit_enable:{name:"\ud06c\ub8e8\uc988 \ucee8\ud2b8\ub864 \uac1c\uc870 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uc7a0\uae08 \ud574\uc81c",desc:"\ud578\ub4e4\ubc14 \uc2a4\uc704\uce58 \ud0a4\ud2b8\ub97c \uc124\uce58\ud55c \ud6c4 \ud06c\ub8e8\uc988 \ucee8\ud2b8\ub864 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ktm_clutch_pull_map_switch_gesture:{name:"\ud074\ub7ec\uce58 \ud480 \uc81c\uc2a4\ucc98 \ub9f5 \uc804\ud658",desc:"\uc2dc\ub3d9 \uc2dc \ud074\ub7ec\uce58 \ub808\ubc84 \uc81c\uc2a4\ucc98\ub97c \uc2e4\ud589\ud558\uc5ec \uc2e0\uc18d\ud55c \uc9c0\ub3c4 \uc804\ud658\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."},yamaha_quickshifter_cut_time_adjust:{name:"\ud035\uc2dc\ud504\ud130 \uc810\ud654 \ucef7\ud0c0\uc784 \ubc0f \uac10\ub3c4",desc:"\ud035\uc2dc\ud504\ud130 \uc13c\uc11c \ubd80\ud558 \uc784\uacc4\uac12\uacfc \uc2a4\ud30c\ud06c \uc911\ub2e8 \uc9c0\uc5f0\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},yamaha_ride_by_wire_throttle_map:{name:"Ride-by-Wire \uc2a4\ub85c\ud2c0 \ub9f5 \uc0ac\uc804 \uc124\uc815 \uc120\ud0dd\uae30",desc:"A \ubaa8\ub4dc(\uacf5\uaca9\uc801), STD \ubc0f B \ubaa8\ub4dc(\ubd80\ub4dc\ub7ec\uc6b4) \uc2a4\ub85c\ud2c0 \ub9f5 \uac04\uc744 \uc804\ud658\ud569\ub2c8\ub2e4."},yamaha_tft_track_theme_unlock:{name:"TFT \ud2b8\ub799 \ub514\uc2a4\ud50c\ub808\uc774 \ub808\uc774\uc544\uc6c3 \ubc0f \uc2dc\ud504\ud2b8 \ub77c\uc774\ud2b8 \uc7a0\uae08 \ud574\uc81c",desc:"R1/MT-09 SP \ud2b8\ub799 \ud074\ub7ec\uc2a4\ud130 \ub808\uc774\uc544\uc6c3 \ubc0f \ud504\ub85c\uadf8\ub798\ubc0d \uac00\ub2a5\ud55c \ubcc0\uc18d RPM \uc870\uba85\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},yamaha_launch_control_sensitivity:{name:"\ubc1c\uc0ac \uc81c\uc5b4 \uc2dc\uc2a4\ud15c(LCS) \uac1c\uc815 \ud55c\ub3c4",desc:"RPM\uc744 \uc720\uc9c0\ud558\ub294 \ubc1c\uc0ac \uc81c\uc5b4\ub97c \uad6c\uc131\ud569\ub2c8\ub2e4(8,000~10,000RPM \ubc94\uc704)."},yamaha_heated_grips_accessory_enable:{name:"\uc815\ud488 \uc5f4\uc120 \uadf8\ub9bd TFT \uba54\ub274 \ud1b5\ud569",desc:"TFT \ud654\uba74\uc5d0\uc11c \uc5f4\uc120 \uadf8\ub9bd \ucee8\ud2b8\ub864\uacfc \uc628\ub3c4 \uac8c\uc774\uc9c0\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},honda_hstc_wheelie_control_fine_tune:{name:"HSTC \ud2b8\ub799\uc158 \ubc0f \uc70c\ub9ac \ucee8\ud2b8\ub864 \ubbf8\uc138 \uc870\uc815",desc:"Honda \uc120\ud0dd \uac00\ub2a5 \ud1a0\ud06c \uc81c\uc5b4 \uc2ac\ub9bd \ube44\uc728\uacfc \uc55e\ubc14\ud034 \ub9ac\ud504\ud2b8 \uacf5\ucc28\ub97c \uc870\uc815\ud569\ub2c8\ub2e4."},honda_bi_directional_quickshifter_enable:{name:"\uc591\ubc29\ud5a5 \ud035\uc2dc\ud504\ud130 \uac1c\uc870 \uc7a0\uae08 \ud574\uc81c",desc:"ECU \uba54\ubaa8\ub9ac\uc5d0\uc11c \uc790\ub3d9 \ube14\ub9ac\ud37c \ubc0f \uc5c5/\ub2e4\uc6b4 \ud035\uc2dc\ud504\ud130 \ucf54\ub529\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},honda_service_reminder_custom_interval:{name:"\uc624\uc77c \uc11c\ube44\uc2a4 \uc54c\ub9bc \uac70\ub9ac \ub9de\ucda4\uc124\uc815 \ub3c4\uad6c",desc:"\ub514\uc9c0\ud138 \ub300\uc2dc\ubcf4\ub4dc\uc5d0\uc11c \ub9de\ucda4\ud615 \uc624\uc77c \uad50\ud658 \ub9c8\uc77c\ub9ac\uc9c0 \uac04\uaca9\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."},honda_track_abs_rear_disable:{name:"ABS \ub4b7\ubc14\ud034 \ube44\ud65c\uc131\ud654 \ucd94\uc801",desc:"\ud2b8\ub799 \ub370\uc774 \ub3d9\uc548 \uc804\uba74 \ucf54\ub108\ub9c1 ABS\ub97c \uc720\uc9c0\ud558\uba74\uc11c \ub4b7\ubc14\ud034 ABS \ucc44\ub110\uc744 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},honda_cold_start_idle_enrichment:{name:"\ub0c9\uac04 \uc2dc\ub3d9 \uc5f0\ub8cc \ub18d\ucd95 \ubc0f \uc720\ud734 \ubaa9\ud45c RPM",desc:"\uc560\ud504\ud130\ub9c8\ucf13 \ubc30\uae30 \uc2dc\uc2a4\ud15c\uc758 \ucd08\uae30 \uc608\uc5f4 \uc720\ud734 \uc18d\ub3c4\ub97c \uc870\uc815\ud569\ub2c8\ub2e4."},harley_custom_throttle_curve_editor:{name:"\ub9de\ucda4\ud615 \uc2a4\ub85c\ud2c0 \uc751\ub2f5 \uace1\uc120 \ud3b8\uc9d1\uae30",desc:"Milwaukee-Eight/Revolution Max \ub77c\uc774\ub4dc \ubc14\uc774 \uc640\uc774\uc5b4 \uc2a4\ub85c\ud2c0 \uc9c4\ud589\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},harley_security_alarm_sensitivity:{name:"\uc2a4\ub9c8\ud2b8 \ubcf4\uc548 \uc2dc\uc2a4\ud15c \uadfc\uc811\uc131 \ubc0f \uae30\uc6b8\uae30 \uac10\ub3c4",desc:"\ubaa8\uc158 \uc13c\uc11c \uac10\ub3c4\uc640 \ud578\uc988\ud504\ub9ac \ud3ec\ube0c \ubb34\uc7a5 \uc9c0\uc5f0\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},harley_boom_box_gts_hidden_diagnostics:{name:"\ubd90! Box GTS \uc778\ud3ec\ud14c\uc778\uba3c\ud2b8 \uc228\uaca8\uc9c4 \uc9c4\ub2e8 \uba54\ub274",desc:"\uc5d4\uc9c0\ub2c8\uc5b4\ub9c1 \uc6d0\uaca9 \uce21\uc815 \ub514\uc2a4\ud50c\ub808\uc774, \uc5d4\uc9c4 \uc628\ub3c4 \ubc0f \uc624\uc77c \uc555\ub825 \uac8c\uc774\uc9c0\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},harley_rdrs_defensive_system_tune:{name:"RDRS \ub4dc\ub798\uadf8 \ud1a0\ud06c \uc2ac\ub9bd \uc81c\uc5b4 \uac10\ub3c4",desc:"\uc800\ub2e8 \ubcc0\uc18d \uc911 \ubc18\uc0ac \ubc29\uc5b4 \ub77c\uc774\ub354 \uc2dc\uc2a4\ud15c \ub4b7\ubc14\ud034 \ubbf8\ub044\ub7ec\uc9d0 \uc644\ud654\ub97c \ubbf8\uc138 \uc870\uc815\ud569\ub2c8\ub2e4."},byd_avas_low_speed_siren_mute:{name:"AVAS \uc800\uc18d EV \ubcf4\ud589\uc790 \uacbd\uace0 \uc0ac\uc774\ub80c \uc74c\uc18c\uac70",desc:"30km/h \ubbf8\ub9cc\uc5d0\uc11c \uc678\ubd80 \uc74c\ud5a5 \ucc28\ub7c9 \uacbd\uace0 \uc2dc\uc2a4\ud15c \uc0ac\uc774\ub80c\uc744 \uc74c\uc18c\uac70\ud558\uac70\ub098 \ub0ae\ucda5\ub2c8\ub2e4."},byd_ev_battery_preheat_manual_switch:{name:"\uc218\ub3d9 EV \ubc30\ud130\ub9ac \uc608\uc5f4 \ud1a0\uae00",desc:"DC \uace0\uc18d \ucda9\uc804 \uc804\uc5d0 \uc218\ub3d9 \ubc30\ud130\ub9ac \uc5f4 \uc870\uc808\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},byd_v2l_220v_outlet_power_expansion:{name:"V2L(Vehicle-to-Load) 220V \ucf58\uc13c\ud2b8 \uc804\ub825 \ud655\uc7a5(3.6kW)",desc:"\uc678\ubd80 V2L \ubc29\uc804 \uc804\ub825 \ud55c\ub3c4\ub97c 2.2kW\uc5d0\uc11c \ucd5c\ub300 3.6kW\ub85c \ud655\uc7a5\ud569\ub2c8\ub2e4."},byd_one_pedal_regen_default_max:{name:"1\ud398\ub2ec \ub4dc\ub77c\uc774\ube0c \ud68c\uc0dd \uc81c\ub3d9 \uae30\ubcf8 \ucd5c\ub300",desc:"\ucc28\ub7c9 \uc2dc\ub3d9 \uc2dc \ub192\uc740 \ud68c\uc0dd \uc81c\ub3d9\uc744 \uc9c0\uc18d\uc801\uc778 \uae30\ubcf8\uac12\uc73c\ub85c \uc7a0\uae09\ub2c8\ub2e4."},mg_ismart_connectivity_unlock:{name:"i-SMART \uc5f0\uacb0 \ubc0f \uc6d0\uaca9 \uc6d0\uaca9 \uce21\uc815 \uc7a0\uae08 \ud574\uc81c",desc:"\uc6d0\uaca9 \uc2e4\ub0b4 \uc628\ub3c4 \uc870\uc808 \ubc0f \ucc28\ub7c9 \uc0c1\ud0dc \ucd94\uc801 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},mg_mg4_xpower_launch_control_enable:{name:"MG4 XPower \ub4c0\uc5bc \ubaa8\ud130 \uc2e4\ud589 \uc81c\uc5b4 \ubaa8\ub4dc",desc:"3.8\ucd08 0-100km/h \ubc1c\uc0ac \uc81c\uc5b4 \uac00\uc18d \ubaa8\ub4dc\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},mg_battery_preheat_manual_trigger:{name:"\uc218\ub3d9 \uace0\uc18d \ucda9\uc804 \ubc30\ud130\ub9ac \uc0ac\uc804 \ucee8\ub514\uc154\ub2dd",desc:"\ucd5c\ub300 DC \ucda9\uc804 \uc18d\ub3c4\ub97c \uc704\ud574 \uace0\uc804\uc555 \ubc30\ud130\ub9ac \uac00\uc5f4 \uc694\uc18c\ub97c \uac15\uc81c\ub85c \ucf2d\ub2c8\ub2e4."},xpeng_xngp_adas_region_unlock:{name:"XNGP \uc790\uc728\uc8fc\ud589 \ubcf4\uc870 \uc9c0\uc5ed \uc7a0\uae08 \ud574\uc81c",desc:"\uc7a0\uae08 \ud574\uc81c\ub41c \uc9c0\uc5ed\uc5d0\uc11c \uace0\uae09 \ub0b4\ube44\uac8c\uc774\uc158 \uc548\ub0b4 \uc870\uc885\uc0ac \uc9c0\uc6d0\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},xpeng_ambient_lighting_music_sync:{name:"\uc74c\uc545 \ubc18\uc751\ud615 \ub9ac\ub4ec \uc8fc\ubcc0 \uc870\uba85",desc:"\uc2e4\ub0b4 LED \uc8fc\ubcc0 \uc870\uba85 \ud384\uc2a4\ub97c \uc624\ub514\uc624 \uc2dc\uc2a4\ud15c \ubca0\uc774\uc2a4 \ube44\ud2b8\uc640 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4."},xpeng_rear_camera_trailer_hitch_view:{name:"360\xb0 \uce74\uba54\ub77c \ud788\uce58 \ubc0f \uc9c0\uba74 \uc624\ubc84\ub808\uc774 \ubaa8\ub4dc",desc:"\ubc31\uc5c5 \uce74\uba54\ub77c\uc5d0 \uace0\ud574\uc0c1\ub3c4 \ud788\uce58 \uc815\ub82c \uadf8\ub9ac\ub4dc \uc624\ubc84\ub808\uc774\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4."},nio_battery_swap_interval_reminder:{name:"\uc804\uc6d0 \uad50\ud658 \uc2a4\ud14c\uc774\uc158 \uc0ac\uc804 \uc870\uc808 \ubaa8\ub4dc",desc:"\uad50\uccb4\ud558\uae30 \uc804\uc5d0 \ubc30\ud130\ub9ac \uc7a0\uae08 \ud540\uacfc \uc0ac\uc804 \uc870\uac74 \ud329\uc744 \uc790\ub3d9\uc73c\ub85c \ub0b4\ub9bd\ub2c8\ub2e4."},nio_nomi_assistant_custom_voice_phrases:{name:"NOMI AI \ub3d9\ubc18\uc790 \uac1c\uc778\ud654 \ubc0f \uae68\uc6b0\uae30 \ub2e8\uc5b4",desc:"NOMI\uc5d0 \ub300\ud55c \ub9de\ucda4\ud615 \uc544\ubc14\ud0c0 \uc560\ub2c8\uba54\uc774\uc158\uacfc \uac1c\uc778\ud654\ub41c \uc778\uc0ac\ub9d0 \ubb38\uad6c\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},nio_sentry_watchdog_continuous_recording:{name:"NIO \uac10\uc2dc \ubaa8\ub4dc 4K \uce74\uba54\ub77c \ubc84\ud37c \ub179\ud654",desc:"\uc8fc\ucc28 \uc2dc USB \ub4dc\ub77c\uc774\ube0c\uc5d0 \ub192\uc740 \ube44\ud2b8 \uc804\uc1a1\ub960\uc758 \uc11c\ub77c\uc6b4\ub4dc \uce74\uba54\ub77c \ub179\ud654\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4."},xiaomi_su7_hyperos_driver_profile_sync:{name:"Xiaomi SU7 HyperOS \ub4dc\ub77c\uc774\ubc84 \ud504\ub85c\ud544 \uc0dd\ud0dc\uacc4 \ub3d9\uae30\ud654",desc:"Xiaomi \uc804\ud654 Bluetooth\ub97c \ud1b5\ud574 \uc88c\uc11d, \uac70\uc6b8 \ubc0f \uc628\ub3c4 \uc0ac\uc804 \uc124\uc815\uc744 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4."},xiaomi_su7_boost_mode_throttle_curve:{name:"\ubd80\uc2a4\ud2b8 \ubaa8\ub4dc 20\ucd08 \uc624\ubc84\ubd80\uc2a4\ud2b8 \uc804\uc6d0 \uc7a0\uae08 \ud574\uc81c",desc:"\ud480 \uc2a4\ub85c\ud2c0 \uac00\uc18d \uc911\uc5d0 \ucd5c\ub300 \uc804\uae30 \ubaa8\ud130 \uc624\ubc84\ubd80\uc2a4\ud2b8 \uc9c0\uc18d \uc2dc\uac04\uc744 \uc5f0\uc7a5\ud569\ub2c8\ub2e4."},xiaomi_su7_drift_mode_torque_vectoring:{name:"\ub4dc\ub9ac\ud504\ud2b8 \ubaa8\ub4dc RWD \ud1a0\ud06c \ubca1\ud130\ub9c1 \ud560\ub2f9",desc:"\ud2b8\ub799\uc158 \ucee8\ud2b8\ub864\uc774 \ud574\uc81c\ub41c \uc0c1\ud0dc\uc5d0\uc11c \ub9ac\uc5b4 \uc561\uc2ac\uc5d0 100% \ubaa8\ud130 \ud1a0\ud06c\ub97c \ud560\ub2f9\ud569\ub2c8\ub2e4."},chery_isa_overspeed_warning_chime_off:{name:"ISA \uc9c0\ub2a5\ud615 \uc18d\ub3c4 \ubcf4\uc870 \uacbd\uace0 \ucc28\uc784 \uc74c\uc18c\uac70",desc:"\uac10\uc9c0\ub41c \uc18d\ub3c4 \uc81c\ud55c\uc744 \ucd08\uacfc\ud558\uba74 \uc9c0\uc18d\uc801\uc778 \uc74c\ud5a5 \ucc28\uc784\uc774 \ube44\ud65c\uc131\ud654\ub429\ub2c8\ub2e4."},chery_driver_monitoring_camera_sensitivity:{name:"DMS \uc6b4\uc804\uc790 \ud53c\ub85c \ubaa8\ub2c8\ud130\ub9c1 \uce74\uba54\ub77c \uac10\ub3c4",desc:"\ub0b4\ubd80 \ubaa8\ub2c8\ud130\ub9c1 \uce74\uba54\ub77c\uc758 \uc624\ud0d0 \uc8fc\uc758 \uc0b0\ub9cc \uacbd\uace0\ub97c \uc904\uc785\ub2c8\ub2e4."},retrofit_parking_sensor_coding:{name:"\uc804\uba74/\ud6c4\uba74 \uc8fc\ucc28 \uac70\ub9ac \uc81c\uc5b4(PDC) \ucf54\ub529 \uac1c\uc870",desc:"\uac8c\uc774\ud2b8\uc6e8\uc774 \uc124\uce58 \ubaa9\ub85d\uc5d0 \uc560\ud504\ud130\ub9c8\ucf13 \ub610\ub294 OEM \uc8fc\ucc28 \uc13c\uc11c \ubaa8\ub4c8\uc744 \ub4f1\ub85d\ud569\ub2c8\ub2e4."},retrofit_360_camera_activation:{name:"360\xb0 \uc601\uc5ed \ubdf0 \uc11c\ub77c\uc6b4\ub4dc \uce74\uba54\ub77c \uc2dc\uc2a4\ud15c \uac1c\uc870",desc:"\uc11c\ub77c\uc6b4\ub4dc \ubdf0 \uce74\uba54\ub77c \ucee8\ud2b8\ub864\ub7ec\ub97c \ud65c\uc131\ud654\ud558\uace0 \uc778\ud3ec\ud14c\uc778\uba3c\ud2b8\uc5d0 \uce74\uba54\ub77c \ubdf0\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4."},retrofit_led_license_plate_light_coding:{name:"LED \ubc88\ud638\ud310 \ubc0f \ud6c4\ubbf8\ub4f1 \uac1c\uc870 \uc624\ub958 \ucde8\uc18c",desc:"LED\ub97c \ud1b5\ud55c \uc798\ubabb\ub41c \ub7a8\ud504 \uaebc\uc9d0 \uacbd\uace0\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc800\uc628 \uc804\uad6c \uc810\uac80 \ubaa8\ub2c8\ud130\ub9c1\uc744 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},retrofit_dash_cam_sentry_integration:{name:"\uac1c\uc870 \ub300\uc2dc\ucea0 \uc5f0\uc18d \uc810\ud654 \uc804\uc6d0 \ubc0f \uac10\uc2dc \ubaa8\ub4dc",desc:"\uc0c1\uc2dc \uc8fc\ucc28 \ub179\ud654\ub97c \uc704\ud55c \ucc28\uccb4 \uc81c\uc5b4 \ubaa8\ub4c8 \ub2e8\uc790 30 \uc804\ub825\uc120\uc744 \uad6c\uc131\ud569\ub2c8\ub2e4."},retrofit_heated_windshield_activation:{name:"\uac00\uc5f4\uc2dd \uc55e\uc720\ub9ac \uc694\uc18c \ucf54\ub529 \uac1c\uc870",desc:"\uc55e\uc720\ub9ac \uc131\uc5d0 \uc81c\uac70 \ud788\ud130 \ub9b4\ub808\uc774 \ucd9c\ub825 \ubc0f \ud074\ub77c\uc774\ub9c8\ud2b8\ub85c\ub2c9 \ud654\uba74 \ubc84\ud2bc\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},retrofit_wireless_charger_module_coding:{name:"Qi \ubb34\uc120 \uc2a4\ub9c8\ud2b8\ud3f0 \ucda9\uc804 \ud328\ub4dc \ud1b5\ud569 \uac1c\uc870",desc:"\ubb34\uc120 \ucda9\uc804\uae30 \uc0c1\ud0dc LED \ubc0f \ud734\ub300\uc804\ud654 \ubc29\uce58 \uc54c\ub9bc \ud31d\uc5c5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},retrofit_acc_radar_module_coding:{name:"\uac1c\uc870 \uc801\uc751\ud615 \ud06c\ub8e8\uc988 \ucee8\ud2b8\ub864(ACC) \uc804\ubc29 \ub808\uc774\ub354 \ubaa8\ub4c8",desc:"\uac1c\uc870\ub41c \uc804\ubc29 \uac70\ub9ac \ub808\uc774\ub354 \uc7a5\uce58\ub97c CAN \ubc84\uc2a4 \ucc28\ub7c9 \ub124\ud2b8\uc6cc\ud06c\ub85c \uc778\ucf54\ub529\ud569\ub2c8\ub2e4."},retrofit_traffic_sign_camera_activation:{name:"\uac1c\uc870 \uad50\ud1b5 \ud45c\uc9c0 \uc778\uc2dd \uc55e \uc720\ub9ac \uce74\uba54\ub77c \ucf54\ub529",desc:"\uac1c\uc870\ub41c \uc804\uba74 \uc720\ub9ac \uce74\uba54\ub77c\uc5d0\uc11c VZE \uae30\ud638 \uc778\uc2dd \ucc98\ub9ac\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},retrofit_heated_steering_wheel_coding:{name:"\uac1c\uc870 \uc5f4\uc120 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \ubaa8\ub4c8 \ud65c\uc131\ud654",desc:"\uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \uac00\uc5f4 \uc694\uc18c \ucd9c\ub825 \ubc0f \uc790\ub3d9 \uc628\ub3c4 \ud2b8\ub9ac\uac70\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},retrofit_fatigue_camera_calibration:{name:"\uac1c\uc870 \uc6b4\uc804\uc790 \ud53c\ub85c \ubaa8\ub2c8\ud130\ub9c1 \uce74\uba54\ub77c \ud1b5\ud569",desc:"\uc2a4\ud2f0\uc5b4\ub9c1 \uceec\ub7fc \uc124\uce58 \ud6c4 \uc6b4\uc804\uc790 \ubaa8\ub2c8\ud130\ub9c1 \uc801\uc678\uc120 \uce74\uba54\ub77c \uc13c\uc11c\ub97c \uad50\uc815\ud569\ub2c8\ub2e4."},retrofit_trailer_hitch_module_coding:{name:"\uac1c\uc870 \uacac\uc778 \ubc14 \ubc0f \ud2b8\ub808\uc77c\ub7ec \uc804\uae30 \ubaa8\ub4c8 \ud1b5\ud569",desc:"\ud2b8\ub808\uc77c\ub7ec \ud754\ub4e4\ub9bc \uc644\ud654\ub97c \uc704\ud574 \ud2b8\ub808\uc77c\ub7ec \ubaa8\ub4c8\uc744 ESP \uc548\uc815\uc131 \uc2dc\uc2a4\ud15c\uc73c\ub85c \uc778\ucf54\ub529\ud569\ub2c8\ub2e4."},retrofit_power_tailgate_trunk_kit_coding:{name:"\uac1c\uc870 \ud30c\uc6cc \ud14c\uc77c\uac8c\uc774\ud2b8 \ubc0f \ubc1c \uc81c\uc2a4\ucc98 \uc13c\uc11c \ud1b5\ud569",desc:"\uc804\uae30 \ud2b8\ub801\ud06c \uad6c\ub3d9 \ubaa8\ud130 \ubc0f \ubc94\ud37c \ud0a5 \uc13c\uc11c \ucf54\ub529\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."},easteregg_urban_joke_light_show:{name:"\ub3c4\uc2dc \ub18d\ub2f4 \uad50\ub300 \ud6c4\ubbf8\ub4f1 \uc1fc",desc:"\ucc28\ub7c9\uc744 \uc7a0\uae00 \ub54c \ud6c4\ubbf8\ub4f1\uacfc \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1\uc774 \uad50\ub300\ub85c \uae5c\ubc15\uc774\ub3c4\ub85d \uad6c\uc131\ud569\ub2c8\ub2e4."},easteregg_custom_boot_greeting_text:{name:"\ub514\uc9c0\ud138 \ud074\ub7ec\uc2a4\ud130\uc758 \uc0ac\uc6a9\uc790 \uc815\uc758 \ubd80\ud305 \uc778\uc0ac\ub9d0 \ud14d\uc2a4\ud2b8",desc:"\uc2dc\ub3d9\uc744 \ucf1c\uba74 \uacc4\uae30\ud310 \ud654\uba74\uc5d0 \ub9de\ucda4\ud615 \ud658\uc601 \uba54\uc2dc\uc9c0\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4."},easteregg_cluster_mini_game_mode:{name:"\uacc4\uae30\ud310 \uc228\uaca8\uc9c4 \ubbf8\ub2c8\uac8c\uc784 \uba54\ub274",desc:"\uc8fc\ucc28 \uc2dc \ub514\uc2a4\ud50c\ub808\uc774\uc5d0 \ud45c\uc2dc\ub418\ub294 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \ubc84\ud2bc\uc73c\ub85c \uc81c\uc5b4\ub418\ub294 \ubcf5\uace0\ud48d \ubbf8\ub2c8 \uac8c\uc784\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},easteregg_custom_horn_melody_package:{name:"\ub9de\ucda4\ud615 \uc5b4\ucfe0\uc2a4\ud2f1 \ud638\ub978 \ud658\uc601 \uba5c\ub85c\ub514",desc:"\uc790\ub3d9\ucc28 \uc7a0\uae08\uc744 \ud574\uc81c\ud560 \ub54c \uacbd\uc801\uc744 \ud1b5\ud574 \uc9e7\uc740 \ub9ac\ub4ec\uc758 \uc091\uc091\uac70\ub9ac\ub294 \ud328\ud134\uc744 \uc7ac\uc0dd\ud569\ub2c8\ub2e4."},easteregg_welcome_lighting_door_sequence:{name:"LED \uc6f0\ucef4 \ub77c\uc774\ud2b8 \ub3c4\uc5b4 \uc2dc\ud000\uc2a4 \ucd94\uc801",desc:"\uc678\ubd80 \ub3c4\uc5b4 \ud578\ub4e4\uc5d0 \uc810\uc9c4\uc801\uc778 LED \ucd94\uc801 \uc560\ub2c8\uba54\uc774\uc158\uc744 \uc2e4\ud589\ud569\ub2c8\ub2e4."},easteregg_developer_service_menu_shortcut:{name:"\uac1c\ubc1c\uc790 \ubc0f \uc11c\ube44\uc2a4 \uc9c4\ub2e8 \ud654\uba74 \ubc14\ub85c\uac00\uae30",desc:"\uc228\uaca8\uc9c4 \uc5d4\uc9c0\ub2c8\uc5b4\ub9c1 \uc9c4\ub2e8 \ud654\uba74\uc5d0 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub294 \ud035 \uc81c\uc2a4\ucc98 \ubc14\ub85c\uac00\uae30\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},easteregg_seasonal_cluster_theme_effect:{name:"\uacc4\uc808\ubcc4 \uae30\uc0c1 \ud074\ub7ec\uc2a4\ud130 \ud14c\ub9c8 \uc624\ubc84\ub808\uc774(\ub208\uc1a1\uc774/\ube44)",desc:"\uaca8\uc6b8\uc5d0 \ud074\ub7ec\uc2a4\ud130\ub97c \uce21\uc815\ud558\uae30 \uc704\ud574 \uc560\ub2c8\uba54\uc774\uc158 \ub208\uc1a1\uc774 \ub610\ub294 \ube44 \uc785\uc790 \ubc30\uacbd\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4."},easteregg_valet_mode_prank_warning_message:{name:"\ubc1c\ub81b \ubaa8\ub4dc \uc7a5\ub09c \uc18d\ub3c4 \uc81c\ud55c \ud31d\uc5c5 \uacbd\uace0",desc:"\ubc1c\ub81b \ubaa8\ub4dc\uac00 \ucd08\uacfc\ub418\uba74 \ub300\uc2dc\ubcf4\ub4dc\uc5d0 \uc720\uba38\ub7ec\uc2a4\ud558\uac8c \uc5c4\uaca9\ud55c \uacbd\uace0 \uba54\uc2dc\uc9c0\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4."},adas_lane_keep_assist_gentle_curve:{name:"\ucc28\uc120 \uc720\uc9c0 \ubcf4\uc870(LKA) \ubd80\ub4dc\ub7ec\uc6b4 \uc870\ud5a5 \uac1c\uc785 \uace1\uc120",desc:"\uc810\uc9c4\uc801\uc778 \ud1a0\ud06c \uac1c\uc785\uc744 \uc801\uc6a9\ud558\uc5ec \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \uc7a1\uc544\ub2f9\uae40\uc744 \uc644\ud654\ud569\ub2c8\ub2e4."},adas_lka_last_state_memory_mode:{name:"\ucc28\uc120 \uc720\uc9c0 \ubcf4\uc870 \ub9c8\uc9c0\ub9c9 \uc0c1\ud0dc \uba54\ubaa8\ub9ac \uc7a0\uae08",desc:"\uc810\ud654\uac00 \ub2e4\uc2dc \uc2dc\uc791\ub420 \ub54c\ub9c8\ub2e4 LKA\uac00 \uc790\ub3d9\uc73c\ub85c \ub2e4\uc2dc \ucf1c\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4."},adas_acc_default_follow_distance:{name:"\uc801\uc751\ud615 \ud06c\ub8e8\uc988 \ucee8\ud2b8\ub864(ACC) \uae30\ubcf8 \uac70\ub9ac \uc0ac\uc804 \uc124\uc815",desc:"ACC\uac00 \ucf1c\uc9c8 \ub54c\ub9c8\ub2e4 \uae30\ubcf8 \uac04\uaca9 \uc124\uc815(1~4\ubc14)\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."},adas_acc_speed_step_adjustment:{name:"ACC \ud06c\ub8e8\uc988 \uc18d\ub3c4 \uc99d\ubd84 \ub2e8\uacc4 \uc120\ud0dd\uae30(+5 / +10km/h)",desc:"\uc9e7\uac8c \ub204\ub974\ub294 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \uc18d\ub3c4 \ubc84\ud2bc \ub2e8\uacc4\ub97c 1km/h\uc5d0\uc11c 5km/h\ub85c \ubcc0\uacbd\ud569\ub2c8\ub2e4."},adas_matrix_led_glare_free_high_beam_unlock:{name:"\ub9e4\ud2b8\ub9ad\uc2a4 LED \ub208\ubd80\uc2ec \ubc29\uc9c0 \uc801\uc751\ud615 \ud558\uc774\ube54 \ub208\ubd80\uc2ec \uc2e4\ub4dc",desc:"\ubd81\ubbf8 \ucc28\ub7c9\uc758 \uc720\ub7fd \uc0ac\uc591 \uc801\uc751\ud615 \ube54 \ud615\uc131 \ud558\uc774\ube54\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},adas_traffic_jam_assist_follow_fine_tune:{name:"\uad50\ud1b5 \uccb4\uc99d \uc9c0\uc6d0 \uc815\uc9c0 \ubc0f \uc774\ub3d9 \uc7ac\uac1c \uc9c0\uc5f0",desc:"\uc790\ub3d9 \uc815\uc9c0 \ud6c4 \uc7ac\uc2dc\uc791 \uae30\uac04\uc744 3\ucd08\uc5d0\uc11c 15\ucd08\ub85c \uc5f0\uc7a5\ud569\ub2c8\ub2e4."},adas_rear_radar_blind_spot_zero_point_reset:{name:"\ud6c4\ubc29 \uc0ac\uac01\uc9c0\ub300 \ub808\uc774\ub354 \uc601\uc810 \uac01\ub3c4 \uad50\uc815",desc:"\ubc94\ud37c \uc81c\uac70 \ub610\ub294 \uc218\ub9ac \ud6c4 \ud6c4\uba74 \ubc94\ud37c \ub808\uc774\ub354 \ubc29\uc704\uac01\uc744 \uc7ac\ubcf4\uc815\ud569\ub2c8\ub2e4."},adas_surround_camera_stitching_recalib:{name:"\uc11c\ub77c\uc6b4\ub4dc \ubdf0 \uce74\uba54\ub77c \ub3d9\uc801 \uc774\ubbf8\uc9c0 \uc2a4\ud2f0\uce6d \uc815\ub82c",desc:"\ub3c4\ub85c \uc8fc\ud589 \uc911\uc5d0 \ub3d9\uc801 \uce74\uba54\ub77c \uc774\ubbf8\uc9c0 \uc2a4\ud2f0\uce6d \ubcf4\uc815\uc744 \uc2e4\ud589\ud569\ub2c8\ub2e4."},adas_steering_angle_sensor_zero_point_reset:{name:"\uc870\ud5a5\uac01 \uc13c\uc11c(SAS) \uc601\uc810 \uad50\uc815",desc:"\ud720 \uc5bc\ub77c\uc778\uba3c\ud2b8 \uc11c\ube44\uc2a4 \ud6c4 \uc2a4\ud2f0\uc5b4\ub9c1 \uc911\uc2ec \uac01\ub3c4\ub97c 0.0\xb0\ub85c \uc7ac\uc124\uc815\ud569\ub2c8\ub2e4."},adas_cross_traffic_alert_sensitivity_adjust:{name:"\ud6c4\ubc29 \uad50\ucc28 \uad50\ud1b5 \uacbd\uace0(RCTA) \uac10\uc9c0 \ubc94\uc704",desc:"\ud6c4\uc9c4\ud558\ub294 \ub3d9\uc548 \uc811\uadfc\ud558\ub294 \ucc28\ub7c9\uc5d0 \ub300\ud55c \uce21\uba74 \ub808\uc774\ub354 \uac10\uc9c0 \uac70\ub9ac\uac00 \ub298\uc5b4\ub0a9\ub2c8\ub2e4."},adas_aeb_emergency_braking_threshold_preview:{name:"\uc790\ub3d9\uae34\uae09\uc81c\ub3d9(AEB) \uacbd\uace0 \ud6a8\ub2a5",desc:"\uc804\ubc29 \ucda9\ub3cc \uacbd\uace0\uc5d0 \ub300\ud55c \uc870\uae30 \uacbd\uace0 \ubc0f \ub2a6\uc740 \uacbd\uace0 \ucc28\uc784 \ud0c0\uc774\ubc0d\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},adas_night_vision_camera_alignment:{name:"\uc801\uc678\uc120 \uc57c\uac04 \ud22c\uc2dc\uacbd \uc5f4\ud654\uc0c1 \uce74\uba54\ub77c \ub300\uc0c1 \uc815\ub82c",desc:"\uc801\uc678\uc120 \uce74\uba54\ub77c \ubc1b\uce68\ub300 \uc815\ub82c \ud655\uc778 \uc21c\uc11c\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4."},adas_dms_driver_monitoring_ir_threshold:{name:"DMS \uc6b4\uc804\uc790 \uc8fc\uc758 \uce74\uba54\ub77c \uc801\uc678\uc120 \uac10\ub3c4",desc:"\uc5b4\ub450\uc6b4 \ud3b8\uad11 \uc120\uae00\ub77c\uc2a4\ub97c \ucc29\uc6a9\ud55c \uc6b4\uc804\uc790\uc758 \uc2dc\uc120 \ucd94\uc801 \uc784\uacc4\uac12\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},toyota_soft_close_door_retrofit_coding:{name:"\uc804\ub3d9 \uc18c\ud504\ud2b8 \ud074\ub85c\uc988 \ub3c4\uc5b4 \uc9c4\uacf5 \uc561\ucd94\uc5d0\uc774\ud130 \ucf54\ub529",desc:"\ucc28\uccb4 \uc81c\uc5b4 \ubaa8\ub4c8\uc5d0\uc11c \ud30c\uc6cc \ub3c4\uc5b4 \ub798\uce58 \ud480\uc778 \uc561\ucd94\uc5d0\uc774\ud130\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},toyota_digital_speedometer_display_enable:{name:"\ub514\uc9c0\ud138 \uc18d\ub3c4\uacc4 \uc13c\ud130 \uac8c\uc774\uc9c0 \ub514\uc2a4\ud50c\ub808\uc774",desc:"\uc544\ub0a0\ub85c\uadf8 \uacc4\uae30\ud310 LCD\uc5d0 \ub300\ud615 \ub514\uc9c0\ud138 \uc18d\ub3c4 \ud310\ub3c5 \uae30\ub2a5\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4."},toyota_walk_away_auto_lock_sensitivity:{name:"Walk-Away \uc2a4\ub9c8\ud2b8 \ud0a4 \uc790\ub3d9 \ub3c4\uc5b4 \uc7a0\uae08 \uac10\ub3c4",desc:"\uba40\uc5b4\uc9c8 \ub54c \ubb38\uc774 \uc790\ub3d9\uc73c\ub85c \uc7a0\uae30\uae30 \uc804\uc5d0 \uac70\ub9ac \uc784\uacc4\uac12\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},toyota_jbl_3d_eq_audio_profile_unlock:{name:"JBL \ud504\ub9ac\ubbf8\uc5c4 \uc11c\ub77c\uc6b4\ub4dc \uc0ac\uc6b4\ub4dc \uc774\ud004\ub77c\uc774\uc800 \uace1\uc120",desc:"JBL \uc624\ub514\uc624 \ud5e4\ub4dc \uc720\ub2db\uc5d0\uc11c 3D \ucf58\uc11c\ud2b8 \ud640 \uc774\ud004\ub77c\uc774\uc800 \ud504\ub85c\ud544\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},toyota_ev_mode_throttle_override_suppression:{name:"EV \ubaa8\ub4dc \uc21c\uc218 \uc804\uae30 \uc2a4\ub85c\ud2c0 \uc81c\ud55c \uc5b5\uc81c",desc:"\uc801\ub2f9\ud55c EV \uac00\uc18d \uc911\uc5d0 \uac00\uc194\ub9b0 \uc5d4\uc9c4\uc774 \ucf1c\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4."},ford_sync3_engineering_diagnostics_page:{name:"SYNC3 / SYNC4 \ud130\uce58\uc2a4\ud06c\ub9b0 \uc5d4\uc9c0\ub2c8\uc5b4\ub9c1 \uc9c4\ub2e8 \ud654\uba74",desc:"SYNC\uc5d0\uc11c \uc6d0\uc2dc GPS, APIM \ud14c\uc2a4\ud2b8 \ubc0f \uc624\ub514\uc624 \uc8fc\ud30c\uc218 \uc9c4\ub2e8 \ud654\uba74\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ford_rear_seat_entertainment_unlock:{name:"\ub4b7\uc88c\uc11d HDMI / \ube44\ub514\uc624 \uc5d4\ud130\ud14c\uc778\uba3c\ud2b8 \uc624\ub514\uc624 \ud328\uc2a4\uc2a4\ub8e8",desc:"\ub4b7\uc88c\uc11d \uc5d4\ud130\ud14c\uc778\uba3c\ud2b8 \ud654\uba74\uc744 \uc704\ud55c \uc2e4\ub0b4 \ud5e4\ub4dc\ud3f0 \uc624\ub514\uc624 \uc2a4\ud2b8\ub9ac\ubc0d\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},ford_bambi_mode_fog_light_expansion:{name:"\ubc24\ube44 \ubaa8\ub4dc \ud558\uc774\ube54 + \uc548\uac1c\ub4f1 \ub3d9\uc2dc \uc870\uba85",desc:"\ud558\uc774\ube54 \ud5e4\ub4dc\ub77c\uc774\ud2b8\uac00 \ud65c\uc131\ud654\ub41c \uacbd\uc6b0\uc5d0\ub3c4 \uc804\ubc29 \uc548\uac1c\ub4f1\uc758 \uc804\uc6d0\uc744 \ucf1c\uc9c4 \uc0c1\ud0dc\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4."},ford_auto_engine_idle_shutdown_30min_override:{name:"30\ubd84 \uacf5\ud68c\uc804 \uc790\ub3d9 \uc5d4\uc9c4 \ucc28\ub2e8 \ube44\ud65c\uc131\ud654",desc:"\uc8fc\ucc28 30\ubd84 \ud6c4 \uc5d4\uc9c4\uc774 \uc790\ub3d9\uc73c\ub85c \uaebc\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4."},hyundai_n_grin_shift_retrofit_enable:{name:"N Grin Shift(NGS) 20\ucd08 \uc624\ubc84\ubd80\uc2a4\ud2b8 \uac1c\uc870 \uc7a0\uae08 \ud574\uc81c",desc:"ECU\uc5d0\uc11c \uc2a4\ud2f0\uc5b4\ub9c1 \ud720 NGS \ubc84\ud2bc \uc624\ubc84\ubd80\uc2a4\ud2b8 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},hyundai_smart_tailgate_approach_distance:{name:"\uc2a4\ub9c8\ud2b8 \ud578\uc988\ud504\ub9ac \ud14c\uc77c\uac8c\uc774\ud2b8 \uc811\uadfc \uadfc\uc811 \uac10\uc9c0",desc:"\uc2a4\ub9c8\ud2b8 \ud14c\uc77c\uac8c\uc774\ud2b8\uac00 \uc790\ub3d9\uc73c\ub85c \uc5f4\ub9b4 \ub54c\uae4c\uc9c0\uc758 \ub300\uae30 \uc2dc\uac04(3\ucd08~1\ucd08)\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},hyundai_digital_cluster_n_performance_theme:{name:"N Performance \ub514\uc9c0\ud138 \uacc4\uae30\ud310 \uac8c\uc774\uc9c0 \ub808\uc774\uc544\uc6c3",desc:"\ud45c\uc900 LCD \ub300\uc2dc\ubcf4\ub4dc\uc5d0 N-Performance \ube68\uac04\uc0c9 \ubcc0\uc18d \ud45c\uc2dc \ud074\ub7ec\uc2a4\ud130 \ub808\uc774\uc544\uc6c3\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4."},stellantis_scr_adblue_warning_threshold_adjust:{name:"SCR AdBlue \uacbd\uace0 \uac70\ub9ac \uc784\uacc4\uac12 \uc870\uc815",desc:"\uccab \ubc88\uc9f8 AdBlue \ub9ac\ud544 \uc54c\ub9bc \uacbd\uace0 \uac70\ub9ac\ub97c 2400km\uc5d0\uc11c 1000km\ub85c \uc870\uc815\ud569\ub2c8\ub2e4."},stellantis_jeep_trail_rated_offroad_pages:{name:"Jeep Uconnect Trail \ub4f1\uae09 \uc624\ud504\ub85c\ub4dc \uc6d0\uaca9 \uce21\uc815 \ud398\uc774\uc9c0",desc:"Uconnect\uc5d0\uc11c \ub4dc\ub77c\uc774\ube0c\ud2b8\ub808\uc778 \ud53c\uce58, \ub864, \ud720 \uad00\uc808 \ubc0f \ub0c9\uac01\uc218 \uc628\ub3c4 \ud398\uc774\uc9c0\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},stellantis_peugeot_icockpit_3d_color_schemes:{name:"\ud478\uc870 3D i-Cockpit \ub9de\ucda4\ud615 \uc0c9\uc0c1 \uad6c\uc131\ud45c \ud314\ub808\ud2b8",desc:"3D \ud640\ub85c\uadf8\ub7a8 \ub514\uc9c0\ud138 \uacc4\uae30\ud310\uc5d0 \ub300\ud55c \uad6c\ub9ac \ubc0f \uc11d\uc601 \uc0c9\uc0c1 \ud14c\ub9c8\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},gm_super_cruise_follow_distance_adjust:{name:"\uc288\ud37c \ud06c\ub8e8\uc988 \ud578\uc988\ud504\ub9ac \ucd94\uc801 \uac70\ub9ac \uc624\ud504\uc14b",desc:"\uc790\uc728 \uc288\ud37c \ud06c\ub8e8\uc988 \uace0\uc18d\ub3c4\ub85c \uc8fc\ud589 \uc911 \uac04\uaca9 \uac04\uaca9\uc744 \ub9de\ucda4 \uc124\uc815\ud569\ub2c8\ub2e4."},gm_instrument_hud_calibration_reset:{name:"\ud5e4\ub4dc\uc5c5 \ub514\uc2a4\ud50c\ub808\uc774(HUD) \uc704\uce58 \ubc0f \uae30\uc6b8\uae30 \uc601\uc810 \uad50\uc815",desc:"\uc55e \uc720\ub9ac HUD \ud504\ub85c\uc81d\ud130 \uc774\ubbf8\uc9c0 \uac01\ub3c4\uc640 0 \ub808\ubca8 \uc218\ud3c9 \uc815\ub82c\uc744 \uc7ac\uc124\uc815\ud569\ub2c8\ub2e4."},gm_afm_v8_cylinder_lock_no_v4_drop:{name:"AFM/DFM \uc2e4\ub9b0\ub354 \ube44\ud65c\uc131\ud654 \ubb34\uc2dc(\ud56d\uc0c1 V8 \ubaa8\ub4dc)",desc:"\uc5d4\uc9c4\uc774 8\uae30\ud1b5 \ubaa8\ub4dc\uc5d0\uc11c \uacc4\uc18d \uc791\ub3d9\ud558\ub3c4\ub85d \ud65c\uc131 \uc5f0\ub8cc \uad00\ub9ac \uc2e4\ub9b0\ub354 \ub4dc\ub86d\uc744 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},dodge_ram_truck_fog_lights_with_high_beam:{name:"RAM \ud2b8\ub7ed \uc548\uac1c\ub4f1(\ud558\uc774\ube54 \ud3ec\ud568)(\ud558\uc774-\ub85c\uc6b0-\ud3ec\uadf8 \ucf64\ubcf4)",desc:"\uc0c1\ud5a5\ub4f1\uc744 \ucf30\uc744 \ub54c \uc548\uac1c\ub4f1\uc774 \uc790\ub3d9\uc73c\ub85c \uaebc\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4."},toyota_keyless_window_down:{name:"Toyota \uc804\uc790\uc5f4\uc1e0 \ucc3d\ubb38 \uc5f4\uae30(\uc7a0\uae08 \ud574\uc81c \uc720\uc9c0)",desc:"\uc6d0\uaca9 \uc804\uc790\uc2dc\uacc4\uc758 UNLOCK \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uc788\uc73c\uba74 \ubaa8\ub4e0 \uc804\ub3d9 \ucc3d\ubb38\uc774 \ub0b4\ub824\uac11\ub2c8\ub2e4."},toyota_seatbelt_chime_disable:{name:"Toyota \uc2b9\uac1d\uc6a9 \uc548\uc804\ubca8\ud2b8 \uc54c\ub78c \uc74c\uc18c\uac70(\uc8fc\ucc28/\uc624\ud504\ub85c\ub4dc)",desc:"\uc870\uc218\uc11d\uc758 \uc9c0\uc18d\uc801\uc778 \uc74c\ud5a5 \uc548\uc804\ubca8\ud2b8 \uacbd\uace0\uc74c\uc744 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},honda_walkaway_auto_lock:{name:"\ud63c\ub2e4 \uc6cc\ud06c\uc5b4\uc6e8\uc774 \uc790\ub3d9 \ub3c4\uc5b4\ub85d",desc:"\uc2a4\ub9c8\ud2b8\ud0a4\uac00 \ucc28\ub7c9 \ubc18\uacbd 2.5m\ub97c \ubc97\uc5b4\ub098\uba74 \ubaa8\ub4e0 \ub3c4\uc5b4\uac00 \uc790\ub3d9\uc73c\ub85c \uc7a0\uae41\ub2c8\ub2e4."},volvo_speed_limiter_unlock:{name:"\ubcfc\ubcf4 180km/h \uacf5\uc7a5 \uc18d\ub3c4 \uc81c\ud55c \uc7a5\uce58 \ud655\uc7a5",desc:"\ud2b8\ub799/\uc544\uc6b0\ud1a0\ubc18 \uc131\ub2a5 \uc0ac\uc6a9\uc744 \uc704\ud574 \uacf5\uc7a5 \uc18d\ub3c4 \uc81c\ud55c\uc744 180km/h\ub85c \uc870\uc815\ud569\ub2c8\ub2e4."},byd_v2l_3kw_power_unlock:{name:"BYD \ucc28\ub7c9-\ubd80\ud558(V2L) 3.6kW AC \ucd9c\ub825 \ubaa8\ub4dc",desc:"\ucea0\ud551 \uae30\uae30\uc6a9 \uc678\ubd80 220V/3.6kW V2L AC \ubc29\uc804 \ud3ec\ud2b8\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},xiaomi_su7_drift_mode_unlock:{name:"Xiaomi SU7 \ud2b8\ub799 \ub4dc\ub9ac\ud504\ud2b8 \ubaa8\ub4dc \ubc0f \ud6c4\ubc29 \ud1a0\ud06c \ubc14\uc774\uc5b4\uc2a4",desc:"100% \ud6c4\ubc29 \ubaa8\ud130 \ud1a0\ud06c \ubc14\uc774\uc5b4\uc2a4 \ubc0f ESC \ud2b8\ub799 \ub4dc\ub9ac\ud504\ud2b8 \ubaa8\ub4dc\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},vag_oil_service_reset:{name:"Oil Change Service Reset (Flexible Interval)",desc:"Resets instrument cluster oil change interval counter to factory 15,000 km / 365 days."},vag_epb_service_mode:{name:"\uc804\uc790\uc2dd \uc8fc\ucc28 \ube0c\ub808\uc774\ud06c(EPB) \ube0c\ub808\uc774\ud06c \ud328\ub4dc \uc11c\ube44\uc2a4 \ubaa8\ub4dc",desc:"\ud6c4\ubc29 \ube0c\ub808\uc774\ud06c \ud328\ub4dc \ubc0f \ub85c\ud130 \uad50\uccb4\ub97c \uc704\ud574 \ud6c4\ubc29 EPB \uce98\ub9ac\ud37c \ud53c\uc2a4\ud1a4\uc744 \ud6c4\ud1f4\uc2dc\ud0b5\ub2c8\ub2e4."},bmw_bms_battery_registration:{name:"\uc9c0\ub2a5\ud615 \ubc30\ud130\ub9ac \uc13c\uc11c(IBS) \ubc30\ud130\ub9ac \ub4f1\ub85d",desc:"DME/DDE \uc5d4\uc9c4 \uad00\ub9ac\uc5d0 \uc0c8\ub85c\uc6b4 12V AGM/\ub0a9\uc0b0 \ubc30\ud130\ub9ac \uad50\uccb4\ub97c \ub4f1\ub85d\ud569\ub2c8\ub2e4."},bmw_motorrad_service_indicator_reset:{name:"BMW Motorrad \uc5f0\uac04 \uc11c\ube44\uc2a4 \ubc0f \uc624\uc77c \ud45c\uc2dc\uae30 \uc7ac\uc124\uc815",desc:"TFT \uacc4\uae30\ud310\uc5d0\uc11c \uc5f0\uac04 \uc11c\ube44\uc2a4 \ub0a0\uc9dc\uc640 10,000km \uac70\ub9ac \uc54c\ub9bc\uc744 \uc9c0\uc6c1\ub2c8\ub2e4."},ducati_desmo_service_reset:{name:"Ducati Desmo \ubc38\ube0c \uc11c\ube44\uc2a4 \uc54c\ub9bc \uc9c0\uc6b0\uae30",desc:"15,000/30,000km \uc11c\ube44\uc2a4 \ud6c4 \ub300\uc2dc\ubcf4\ub4dc\uc5d0\uc11c Desmoservice \ub80c\uce58 \uc544\uc774\ucf58\uc744 \uc9c0\uc6c1\ub2c8\ub2e4."},byd_bms_isolation_self_test:{name:"BYD \ube14\ub808\uc774\ub4dc \ubc30\ud130\ub9ac \uace0\uc804\uc555 \uc808\uc5f0 \uc790\uccb4 \ud14c\uc2a4\ud2b8",desc:"BMS\uc5d0\uc11c \uace0\uc804\uc555 \uc2dc\uc2a4\ud15c(400V/800V) \ub204\uc124 \ubc0f \uc800\ud56d \uc9c4\ub2e8\uc744 \uc218\ud589\ud569\ub2c8\ub2e4."},vag_drl_brightness_multi:{name:"\uc8fc\uac04 \uc8fc\ud589\ub4f1(DRL) \ubc1d\uae30 \uc870\uc815",desc:"\ud558\ud5a5\ub4f1/\uc8fc\ucc28 \ubaa8\ub4dc\uc5d0 \ub300\ud55c LED DRL \uac15\ub3c4 \uc218\uc900\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},bmw_comfort_turn_signal_cycles:{name:"\uc6d0\ud130\uce58 \ucef4\ud3ec\ud2b8 \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \ud384\uc2a4 \uc218",desc:"\ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \ub808\ubc84\ub97c \ube60\ub974\uac8c \ud0ed\ud560 \ub54c \uae5c\ubc15\uc774\ub294 \ud69f\uc218\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4."},bmw_oil_service_reset:{name:"CBS \uc5d4\uc9c4 \uc624\uc77c \uc7ac\uc124\uc815(BMW)",desc:"\uc0c1\ud0dc \uae30\ubc18 \uc11c\ube44\uc2a4(CBS) \uc624\uc77c \uc218\uba85 \ube44\uc728\uc744 \ub2e4\uc2dc 100%\ub85c \uc7ac\uc124\uc815\ud569\ub2c8\ub2e4."},generic_oil_service_reset:{name:"\ubc94\uc6a9 \uc624\uc77c \uc720\uc9c0 \uad00\ub9ac \ud45c\uc2dc\uae30 \uc7ac\uc124\uc815",desc:"\uc9c0\uc6d0\ub418\ub294 OBD2/UDS ECU \uc804\uccb4\uc5d0\uc11c \ub300\uc2dc\ubcf4\ub4dc \uc624\uc77c \uc720\uc9c0 \uad00\ub9ac \uacbd\uace0\ub4f1\uc744 \uc9c0\uc6c1\ub2c8\ub2e4."},vag_epb_pad_change:{name:"EPB \ube0c\ub808\uc774\ud06c \ud328\ub4dc \uad50\uccb4 \ubaa8\ub4dc(VAG)",desc:"\ud6c4\ubc29 \ube0c\ub808\uc774\ud06c \ud328\ub4dc \uc815\ube44\ub97c \uc704\ud574 \uc804\uc790\uc2dd \uc8fc\ucc28 \ube0c\ub808\uc774\ud06c \uce98\ub9ac\ud37c\ub97c \uc9d1\uc5b4\ub123\uc2b5\ub2c8\ub2e4."},bmw_epb_pad_change:{name:"EPB \ube0c\ub808\uc774\ud06c \uc11c\ube44\uc2a4 \ubaa8\ub4dc(BMW)",desc:"\ud6c4\uba74 \ud328\ub4dc \uad50\uccb4\ub97c \uc704\ud574 \uc8fc\ucc28 \ube0c\ub808\uc774\ud06c \uc561\ucd94\uc5d0\uc774\ud130\ub97c \uc11c\ube44\uc2a4 \uc704\uce58\ub85c \uc5fd\ub2c8\ub2e4."},mb_epb_pad_change:{name:"EPB \ud328\ub4dc \ud53c\ud305 \ubaa8\ub4dc(\uba54\ub974\uc138\ub370\uc2a4-\ubca4\uce20)",desc:"\ube0c\ub808\uc774\ud06c \uc11c\ube44\uc2a4\ub97c \uc704\ud574 \uc8fc\ucc28 \ube0c\ub808\uc774\ud06c \uc2a4\ud540\ub4e4\uc744 \uc791\uc5c5\uc7a5 \uc704\uce58\ub85c \ud574\uc81c\ud569\ub2c8\ub2e4."},vag_dpf_regen:{name:"DPF \uc11c\ube44\uc2a4 \uc7ac\uc0dd \ud2b8\ub9ac\uac70(VAG)",desc:"\uace0\uc815\uc2dd \ub514\uc824 \ubbf8\ub9bd\uc790 \ud544\ud130(DPF) \uadf8\uc744\uc74c \uc5f0\uc18c \uc0ac\uc774\ud074\uc744 \uc2dc\uc791\ud569\ub2c8\ub2e4."},bmw_dpf_regen:{name:"DPF \uac15\uc81c \uc7ac\uc0dd \ud2b8\ub9ac\uac70(BMW)",desc:"\ud65c\uc131 \ubbf8\ub9bd\uc790 \ud544\ud130 \uc7ac\uc0dd \ub8e8\ud2f4\uc744 \uc2dc\uc791\ud558\ub3c4\ub85d DDE ECU\uc5d0 \uc694\uccad\ud569\ub2c8\ub2e4."},psa_dpf_regen:{name:"DPF \uc7ac\uc0dd \uc694\uccad (\ud478\uc870/\uc2dc\ud2b8\ub85c\uc5e5)",desc:"HDi \ub514\uc824 \uc5d4\uc9c4 ECU\uc5d0 \ub300\ud55c \uace0\uc815 DPF \uc7ac\uc0dd\uc744 \ud2b8\ub9ac\uac70\ud569\ub2c8\ub2e4."},bmw_bms_battery_register:{name:"BMS \ubc30\ud130\ub9ac \uad50\uccb4 \ub4f1\ub85d(BMW)",desc:"DME/DDE \uc9c0\ub2a5\ud615 \ubc30\ud130\ub9ac \uc13c\uc11c\uc5d0 \uc0c8 \ubc30\ud130\ub9ac \uad50\uccb4\ub97c \ub4f1\ub85d\ud569\ub2c8\ub2e4."},mb_bms_battery_register:{name:"\ubc30\ud130\ub9ac \ub4f1\ub85d \ubc0f \uc7ac\uc124\uc815(\uba54\ub974\uc138\ub370\uc2a4-\ubca4\uce20)",desc:"\uc0c8 \ubc30\ud130\ub9ac \uc124\uce58 \ud6c4 SAM \ubaa8\ub4c8\uc758 \ubc30\ud130\ub9ac \ub178\ud654 \uce74\uc6b4\ud130\ub97c \uc7ac\uc124\uc815\ud569\ub2c8\ub2e4."},vag_sas_calibrate:{name:"\uc870\ud5a5\uac01 \uc13c\uc11c(SAS) \uad50\uc815(VAG)",desc:"ABS/ESP ECU\uc5d0 \ub300\ud55c G85 \uc870\ud5a5 \uac01\ub3c4 \uc13c\uc11c \uc601\uc810 \uc704\uce58\ub97c \uad50\uc815\ud569\ub2c8\ub2e4."},toyota_sas_calibrate:{name:"\uc870\ud5a5 \uac01\ub3c4 \uc601\uc810 \ubcf4\uc815(Toyota)",desc:"Skid Control ECU\uc5d0\uc11c \uc870\ud5a5\uac01 \uc13c\uc11c\uc758 \uc601\uc810 \uad50\uc815\uc744 \uc218\ud589\ud569\ub2c8\ub2e4."},generic_tba_adapt:{name:"\uc2a4\ub85c\ud2c0 \ubc14\ub514 \uc815\ub82c \ubc0f \uc801\uc751",desc:"\uc5d4\uc9c4 ECU\uc5d0\uc11c \uc804\uc790 \uc2a4\ub85c\ud2c0 \ubc14\ub514 \uc815\uc9c0 \ud559\uc2b5 \ub8e8\ud2f4\uc744 \uc2e4\ud589\ud569\ub2c8\ub2e4."},epb_service_reset:{name:"\ubc94\uc6a9 EPB \uc720\uc9c0\ubcf4\uc218 \uc7ac\uc124\uc815",desc:"\uc804\uc790\uc2dd \uc8fc\ucc28 \ube0c\ub808\uc774\ud06c \uce98\ub9ac\ud37c \ub9c8\ubaa8 \uce74\uc6b4\ud130\ub97c \uc7ac\uc124\uc815\ud558\uace0 \uacf5\uadf9\uc744 \ubcf4\uc815\ud569\ub2c8\ub2e4."},vag_dsg_reset:{name:"DSG \uc804\uc1a1 \uae30\ubcf8 \uc124\uc815 \uc7ac\uc124\uc815(VAG)",desc:"DSG/S-Tronic\uc5d0 \ub300\ud55c \ud074\ub7ec\uce58 \uacb0\ud569 \uc9c0\uc810\uacfc \ubcc0\uc18d \ubc38\ube0c \uc801\uc751\uc744 \uc7ac\uc124\uc815\ud569\ub2c8\ub2e4."},bmw_zf_reset:{name:"ZF 8HP \ubcc0\uc18d\uae30 \uc801\uc751 \uc7ac\uc124\uc815(BMW)",desc:"EGS \ubcc0\uc18d\uae30 \ubcc0\uc18d \uc2dc\uac04 \ubc0f \uc555\ub825 \uc801\uc751 \uac12\uc744 \uc9c0\uc6c1\ub2c8\ub2e4."},bmw_brake_fluid_reset:{name:"\ube0c\ub808\uc774\ud06c\uc561 \uc11c\ube44\uc2a4 \uac04\uaca9 \uc7ac\uc124\uc815(BMW)",desc:"\uc0c1\ud0dc \uae30\ubc18 \uc11c\ube44\uc2a4(CBS) 2\ub144 \ube0c\ub808\uc774\ud06c\uc561 \uad50\ud658 \ud0c0\uc774\uba38\ub97c \uc7ac\uc124\uc815\ud569\ub2c8\ub2e4."},ford_injector_code:{name:"\uc778\uc81d\ud130 \ubcf4\uc815 \uacc4\uc218 \ucf54\ub529(Ford)",desc:"PCM\uc5d0 \ub514\uc824 \uc778\uc81d\ud130\uc6a9 16\uc790 IQA \ucf54\ub4dc\ub97c \ud504\ub85c\uadf8\ub798\ubc0d\ud569\ub2c8\ub2e4."},bmw_injector_code:{name:"\uc5f0\ub8cc \ubd84\uc0ac\uae30 \uc720\ub7c9 \ucf54\ub529(BMW)",desc:"\uad50\uccb4\ub41c \uc5f0\ub8cc \ubd84\uc0ac \uc7a5\uce58\uc758 \uc5d0\ub108\uc9c0 \uad50\uc815 \uac12\uc744 DME\uc5d0 \uae30\ub85d\ud569\ub2c8\ub2e4."},generic_headlight_aim:{name:"\ud5e4\ub4dc\ub77c\uc774\ud2b8 \uc790\ub3d9 \ub808\ubca8\ub9c1 \ubcf4\uc815",desc:"\uc801\uc751\ud615 \uc790\ub3d9 \ub808\ubca8\ub9c1 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \ubaa8\ud130\uc5d0 \ub300\ud55c \uae30\uc900 \uc601\uc810 \uc704\uce58\ub97c \uc124\uc815\ud569\ub2c8\ub2e4."},bmw_12v_battery_reg:{name:"12V \ubcf4\uc870\ubc30\ud130\ub9ac \ub4f1\ub85d(BMW)",desc:"PCU\uc5d0 \ubcf4\uc870 AGM \uc2a4\ud0c0\ud130/\uc9c0\uc6d0 \ubc30\ud130\ub9ac \uad50\uccb4\ub97c \ub4f1\ub85d\ud569\ub2c8\ub2e4."},vag_comfort_turn_signal:{name:"\ud3b8\uc758 \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \uae5c\ubc15\uc784 \ud69f\uc218(VAG)",desc:"\ucc28\uc120 \ubcc0\uacbd \uae5c\ubc15\uc784 \uc8fc\uae30 \ud69f\uc218\ub97c 3, 4, 5\ubc88 \uae5c\ubc15\uc774\ub3c4\ub85d \uc870\uc815\ud569\ub2c8\ub2e4."},vag_coming_home_duration:{name:"\uc9d1\uc73c\ub85c \ub4e4\uc5b4\uc624\uace0 \ub098\uac08 \ub54c \uc870\uba85 \uc9c0\uc18d \uc2dc\uac04(VAG)",desc:"\ucc28\ub7c9 \uc7a0\uae08 \ud6c4 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \uc870\uba85 \ud0c0\uc774\uba38\ub97c \uad6c\uc131\ud569\ub2c8\ub2e4(10\ucd08~60\ucd08)."},vag_remote_windows:{name:"\uc6d0\uaca9 \ud3b8\uc758 \ucc3d \uc81c\uc5b4(VAG)",desc:"\uc6d0\uaca9 \ud0a4 \ud3ec\ube0c\ub97c \uae38\uac8c \ub20c\ub7ec \ud30c\uc6cc \uc708\ub3c4\uc6b0\ub97c \uc5f4\uace0 \ub2eb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},vag_auto_lock_15kmh:{name:"15km/h \uc18d\ub3c4\uc5d0\uc11c \uc790\ub3d9 \ub3c4\uc5b4 \uc7a0\uae08 \uc7a5\uce58(VAG)",desc:"\ucc28\ub7c9 \uc18d\ub3c4\uac00 15km/h\uc5d0 \ub3c4\ub2ec\ud558\uba74 \ubaa8\ub4e0 \ub3c4\uc5b4\uac00 \uc790\ub3d9\uc73c\ub85c \uc7a0\uae41\ub2c8\ub2e4."},vag_sfd_unlock_prep:{name:"SFD \uac8c\uc774\ud2b8\uc6e8\uc774 \ubcf4\ud638 \uc0c1\ud0dc \uc900\ube44(VAG 2020+)",desc:"\ubcf4\ud638\ub41c DID\ub97c \uc4f0\uae30 \uc704\ud574 MQB-evo SFD \uac8c\uc774\ud2b8\uc6e8\uc774 \ud1a0\ud070 \uc138\uc158\uc744 \uc900\ube44\ud569\ub2c8\ub2e4."},bmw_asd_deactivate:{name:"\uc561\ud2f0\ube0c \uc0ac\uc6b4\ub4dc \ub514\uc790\uc778(ASD) \ube44\ud65c\uc131\ud654(BMW)",desc:"\uc2e4\ub0b4 \uc2a4\ud53c\ucee4\ub97c \ud1b5\ud574 \uc7ac\uc0dd\ub418\ub294 \ud569\uc131 \uc5d4\uc9c4 \uc18c\ub9ac\ub97c \uc74c\uc18c\uac70\ud569\ub2c8\ub2e4."},bmw_comfort_turn_signal:{name:"\ucef4\ud3ec\ud2b8 \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \uc218(BMW)",desc:"\uc6d0\ud130\uce58 \ud45c\uc2dc \ud384\uc2a4 \uc218(1~5\ubc88 \uae5c\ubc15\uc784)\ub97c \uc124\uc815\ud569\ub2c8\ub2e4."},bmw_mirror_fold_lock:{name:"\ucef4\ud3ec\ud2b8 \uc561\uc138\uc2a4 \ubbf8\ub7ec \uc811\uc774\uc2dd \uc7a0\uae08\uc7a5\uce58(BMW)",desc:"\ucc28\ub7c9\uc744 \uc7a0\uadf8\ub294 \uc989\uc2dc \uc0ac\uc774\ub4dc\ubbf8\ub7ec\ub97c \uc790\ub3d9\uc73c\ub85c \uc811\uc2b5\ub2c8\ub2e4."},toyota_coming_home_duration:{name:"\ud5e4\ub4dc\ub77c\uc774\ud2b8 \ubc30\ub824 \uc9c0\uc5f0/\uadc0\uac00(\ub3c4\uc694\ud0c0)",desc:"\uc810\ud654 \ucc28\ub2e8 \ud6c4 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \uaebc\uc9d0 \uc9c0\uc5f0 \ud0c0\uc774\uba38\ub97c \uad6c\uc131\ud569\ub2c8\ub2e4(30\ucd08~120\ucd08)."},toyota_lane_change_flash:{name:"\ucc28\uc120 \ubcc0\uacbd \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \ud50c\ub798\uc2dc \ud69f\uc218(\ub3c4\uc694\ud0c0)",desc:"\uc6d0\ud130\uce58 \ucc28\uc120 \ubcc0\uacbd \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \uc8fc\uae30 \ud69f\uc218\ub97c \uc870\uc815\ud569\ub2c8\ub2e4."},toyota_remote_window_close:{name:"\uc6d0\uaca9 \ud30c\uc6cc \uc708\ub3c4\uc6b0 \ud3d0\uc1c4(\ub3c4\uc694\ud0c0)",desc:"\uc6d0\uaca9 \uc7a0\uae08 \ubc84\ud2bc\uc744 \ub20c\ub7ec \ubaa8\ub4e0 \uc804\ub3d9 \ucc3d\ubb38\uc744 \ub2eb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},toyota_autolock_behavior:{name:"\uc790\ub3d9 \ub3c4\uc5b4 \uc7a0\uae08/\uc7a0\uae08 \ud574\uc81c \uc0ac\uc6a9\uc790 \uc815\uc758(Toyota)",desc:"\ub3c4\uc5b4 \uc7a0\uae08 \ud2b8\ub9ac\uac70\ub97c \uc124\uc815\ud569\ub2c8\ub2e4(P\uc5d0\uc11c \ubc97\uc5b4\ub098 \ucc28\ub7c9 \uc18d\ub3c4 > 20km/h)."},toyota_approach_welcome_lights:{name:"\uc2a4\ub9c8\ud2b8 \ud0a4 \uc811\uadfc \uc6f0\ucef4 \ub77c\uc774\ud2b8 (Toyota)",desc:"\uc2a4\ub9c8\ud2b8 \ud0a4\uac00 \ucc28\ub7c9\uc5d0 \uc811\uadfc\ud558\uba74 \ub0b4\ubd80 \uc6c5\ub369\uc774/\uc2e4\ub0b4 \uc870\uba85\uc774 \ucf1c\uc9d1\ub2c8\ub2e4."},hyundai_autolock_behavior:{name:"\uc790\ub3d9 \ub3c4\uc5b4 \uc7a0\uae08/\uc7a0\uae08 \ud574\uc81c \ub3d9\uc791(\ud604\ub300/\uae30\uc544)",desc:"\ubcc0\uc18d \ub610\ub294 \uc18d\ub3c4 \uc870\uc808 \uc2dc \uc790\ub3d9\uc73c\ub85c \ub3c4\uc5b4\ub97c \uc7a0\uadf8\uace0 P \ub610\ub294 \uc810\ud654 \ub044\uae30 \uc2dc \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4."},hyundai_window_remote:{name:"\uc6d0\uaca9 \ucc3d \uc5f4\uae30/\ub2eb\uae30(\ud604\ub300/\uae30\uc544)",desc:"\uc2a4\ub9c8\ud2b8 \ud0a4 \ub9ac\ubaa8\ucee8 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucc3d\uc744 \uc704/\uc544\ub798\ub85c \uad74\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},hyundai_sport_mode_memory:{name:"\ub4dc\ub77c\uc774\ube0c \ubaa8\ub4dc \uc120\ud0dd \uba54\ubaa8\ub9ac(\ud604\ub300/\uae30\uc544)",desc:"\uc5d4\uc9c4 \uc7ac\uc2dc\ub3d9 \ud6c4 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc120\ud0dd\ud55c \uc8fc\ud589 \ubaa8\ub4dc(\uc2a4\ud3ec\uce20/\uc5d0\ucf54)\ub97c \uae30\uc5b5\ud569\ub2c8\ub2e4."},tesla_charge_limit_custom:{name:"\ubc30\ud130\ub9ac \ucda9\uc804 \ud55c\ub3c4 \uc0ac\uc6a9\uc790 \uc815\uc758(Tesla)",desc:"\uae30\ubcf8 HV \ubc30\ud130\ub9ac \ucda9\uc804 \ud55c\ub3c4 \ube44\uc728\uc744 \uc124\uc815\ud569\ub2c8\ub2e4(\uc77c\uc77c 80% / \uc6b4\ud589 100%)."},tesla_mirror_fold_lock:{name:"Walk-Away Lock\uc758 \ubbf8\ub7ec \uc790\ub3d9 \uc811\uae30(Tesla)",desc:"\ud734\ub300\ud3f0 \ud0a4 \uc7a0\uae08 \uc7a5\uce58\uac00 \uc791\ub3d9\ud558\uba74 \uc0ac\uc774\ub4dc \ubbf8\ub7ec\uac00 \uc790\ub3d9\uc73c\ub85c \uc811\ud799\ub2c8\ub2e4."},nissan_coming_home:{name:"\ubb34\ub8cc \ud5e4\ub4dc\ub77c\uc774\ud2b8 \uaebc\uc9d0 \uc9c0\uc5f0(Nissan)",desc:"Nissan \ucc28\ub7c9\uc5d0\uc11c \ud558\ucc28\ud55c \ud6c4 30\ucd08 \ub3d9\uc548 \ud5e4\ub4dc\ub77c\uc774\ud2b8\uac00 \ucf1c\uc9c4 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4."},nissan_lane_change_flash:{name:"\ud0ed\ud558\uc5ec \ud1b5\uacfc \ucc28\uc120 \ubcc0\uacbd \ud50c\ub798\uc2dc \ud69f\uc218(Nissan)",desc:"\ub77c\uc774\ud2b8 \ub808\ubc84 \ud0ed\uc758 \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \ud384\uc2a4 \uc218\ub97c \uc124\uc815\ud569\ub2c8\ub2e4."},nissan_autolock_behavior:{name:"\uc18d\ub3c4 \uc758\uc874\ud615 \uc790\ub3d9 \ub3c4\uc5b4\ub85d(\ub2db\uc0b0)",desc:"\ucc28\ub7c9 \uc18d\ub3c4\uac00 24km/h\uc5d0 \ub3c4\ub2ec\ud558\uba74 \ubaa8\ub4e0 \ub3c4\uc5b4\uac00 \uc790\ub3d9\uc73c\ub85c \uc7a0\uae41\ub2c8\ub2e4."},nissan_window_remote:{name:"\uc6d0\uaca9 \uc804\uc790\uc5f4\uc1e0 \ud30c\uc6cc \uc708\ub3c4\uc6b0 \uc81c\uc5b4(Nissan)",desc:"\uc804\uc790\uc5f4\uc1e0 \uc7a0\uae08 \ud574\uc81c \ubc84\ud2bc\uc744 \uae38\uac8c \ub20c\ub7ec \uc804\uba74 \ucc3d\ubb38\uc744 \uc5f4\uac70\ub098 \ub2eb\uc2b5\ub2c8\ub2e4."},nissan_seatbelt_chime_mute:{name:"\uc548\uc804\ubca8\ud2b8 \uacbd\uace0 \uc624\ub514\uc624 \ucc28\uc784 \uc5b5\uc81c(Nissan)",desc:"\ud074\ub7ec\uc2a4\ud130 \uc544\uc774\ucf58\uc744 \uc720\uc9c0\ud558\uba74\uc11c \ubc18\ubcf5\uc801\uc778 \uc548\uc804\ubca8\ud2b8 \uacbd\uace0\uc74c\uc744 \uc74c\uc18c\uac70\ud569\ub2c8\ub2e4."},porsche_sport_chrono_launch:{name:"\uc2a4\ud3ec\uce20 \ud06c\ub85c\ub178 \ub7f0\uce58 \ucee8\ud2b8\ub864 \ubc18\uc751 \ud504\ub85c\ud544(\ud3ec\ub974\uc250)",desc:"PDK \ubcc0\uc18d\uae30 \ubc1c\uc0ac \uc81c\uc5b4 RPM \uc784\uacc4\uac12 \ubc0f \ud074\ub7ec\uce58 \ubc14\uc774\ud2b8\ub97c \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4."},porsche_pasm_default:{name:"PASM \uc11c\uc2a4\ud39c\uc158 \ubaa8\ub4dc \uc2dc\ub3d9 \ud504\ub9ac\uc14b(\ud3ec\ub974\uc250)",desc:"\uc810\ud654 \uc2dc\uc791 \uc2dc PASM \uc801\uc751\ud615 \uc11c\uc2a4\ud39c\uc158 \uae30\ubcf8 \uac15\uc131\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."},porsche_exhaust_flap:{name:"\uc2a4\ud3ec\uce20 \ubc30\uae30 \ud50c\ub7a9 \uc0c1\uc2dc \uac1c\ubc29 \uc624\ubc84\ub77c\uc774\ub4dc(\ud3ec\ub974\uc250)",desc:"\ud65c\uc131 \ubc30\uae30 \ubc38\ube0c\uac00 \ubaa8\ub4e0 RPM \ubc94\uc704\uc5d0\uc11c 100% \uc5f4\ub9b0 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4."},audi_drive_select_memory:{name:"\uc544\uc6b0\ub514 \ub4dc\ub77c\uc774\ube0c \uc120\ud0dd \ubaa8\ub4dc \uba54\ubaa8\ub9ac \ubcf4\uc720(Audi)",desc:"\uc7ac\uc2dc\ub3d9 \uc2dc \ub9c8\uc9c0\ub9c9 \ud65c\uc131 \ub4dc\ub77c\uc774\ube0c \uc120\ud0dd \ud504\ub85c\ud544(\ub3d9\uc801/\uac1c\ubcc4)\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4."},audi_virtual_cockpit_themes:{name:"\uc544\uc6b0\ub514 \uac00\uc0c1 \uc870\uc885\uc11d S/RS \uc2a4\ud3ec\uce20 \uadf8\ub798\ud53d \ub808\uc774\uc544\uc6c3(Audi)",desc:"Virtual Cockpit\uc5d0\uc11c S/RS \uc911\uc559 \ud0c0\ucf54\ubbf8\ud130 \ub808\uc774\uc544\uc6c3 \uc635\uc158\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},vag_scandinavian_drl:{name:"\uc2a4\uce78\ub514\ub098\ube44\uc544 DRL \ubaa8\ub4dc(VAG)",desc:"\ud6c4\ubc29 \ud14c\uc77c \ub77c\uc774\ud2b8\ub294 \uc804\ubc29 DRL\uacfc \ud568\uaed8 \uc9c0\uc18d\uc801\uc73c\ub85c \ucf1c\uc838 \uc788\uc2b5\ub2c8\ub2e4."},vag_mirror_dip_reverse:{name:"VAG(\ub3d9\uc2b9\uc790 \ubbf8\ub7ec \ub525 \uc778 \uc5ed\ubc29\ud5a5)",desc:"\ud6c4\uc9c4 \uae30\uc5b4\ub97c \ub123\uc73c\uba74 \uc870\uc218\uc11d \uc0ac\uc774\ub4dc \ubbf8\ub7ec\uac00 \uc544\ub798\ucabd\uc73c\ub85c \uae30\uc6b8\uc5b4\uc9d1\ub2c8\ub2e4."},vag_dynamic_turn_signal:{name:"\ub2e4\uc774\ub0b4\ubbf9/\uc21c\ucc28 \ubc29\ud5a5\uc9c0\uc2dc\ub4f1 \ubaa8\ub4dc(VAG)",desc:"\ud638\ud658\ub418\ub294 \ud6c4\ubc29 \uc870\uba85 \ubaa8\ub4c8\uc5d0\uc11c \uc2a4\uc704\ud504 \ub3d9\uc801 LED \uae5c\ubc15\uc774 \ud328\ud134\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},vag_seatbelt_warning_duration:{name:"\uc548\uc804\ubca8\ud2b8 \uacbd\uace0\uc74c \uc9c0\uc18d \uc2dc\uac04 \uc870\uc815(VAG)",desc:"\ubc18\ubcf5\ub418\ub294 \uc548\uc804\ubca8\ud2b8 \uacbd\uace0 \ucc28\uc784 \ud0c0\uc774\uba38\ub97c \uc904\uc774\uac70\ub098 \uc5b5\uc81c\ud569\ub2c8\ub2e4."},vag_sunroof_remote:{name:"\uc120\ub8e8\ud504 \uc6d0\uaca9 \ucef4\ud3ec\ud2b8 \ucee8\ud2b8\ub864(VAG)",desc:"\uc6d0\uaca9 \ud0a4\ud640\ub4dc\ub97c \ud1b5\ud574 \ud30c\ub178\ub77c\ub9c8 \uc120\ub8e8\ud504\ub97c \uc5f4\uace0 \uae30\uc6b8\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."},vag_acc_distance_preset:{name:"ACC \uc801\uc751\ud615 \uc21c\ud56d \uae30\ubcf8 \ucd94\uc801 \uac70\ub9ac(VAG)",desc:"\uc810\ud654 \uc2dc\uc791 \uc2dc \uae30\ubcf8 \ub808\uc774\ub354 \ucd94\uc801 \uac70\ub9ac \ud504\ub85c\ud544\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."},vag_infotainment_startup_logo:{name:"\uc778\ud3ec\ud14c\uc778\uba3c\ud2b8 \ubd80\ud2b8 \uadf8\ub798\ud53d \ub85c\uace0(VAG)",desc:"\uc778\ud3ec\ud14c\uc778\uba3c\ud2b8 \uc2dc\uc791 \uc2a4\ud50c\ub798\uc2dc \ud654\uba74 \ub85c\uace0(R-Line, GTI, RS)\ub97c \uc0ac\uc6a9\uc790 \uc815\uc758\ud569\ub2c8\ub2e4."},vag_ambient_color_cycle:{name:"\uc2e4\ub0b4 \uc8fc\ubcc0\uad11 \uc0c9\uc0c1 \uc2a4\ud399\ud2b8\ub7fc \uc7a0\uae08 \ud574\uc81c(VAG)",desc:"\ucc28\ub7c9 \uc124\uc815 \uba54\ub274\uc5d0\uc11c \uc8fc\ubcc0 \uc870\uba85 \ud314\ub808\ud2b8 \uc635\uc158\uc744 \ud655\uc7a5\ud569\ub2c8\ub2e4."},vag_service_interval_custom:{name:"\ub9de\ucda4\ud615 \uac80\uc0ac \ubc0f \uc11c\ube44\uc2a4 \uac70\ub9ac \uc784\uacc4\uac12(VAG)",desc:"\ub2e4\uc74c \uc11c\ube44\uc2a4 \uacbd\uace0\uc5d0 \ub300\ud55c \uc0ac\uc6a9\uc790 \uc815\uc758 km \ubc0f \ub0a0\uc9dc \ubaa9\ud45c\ub97c \uad6c\uc131\ud569\ub2c8\ub2e4."},vag_door_handle_lights_reverse:{name:"\uc678\ubd80 \ub3c4\uc5b4 \ud578\ub4e4 \uc870\uba85\uc774 \uc5ed\ubc29\ud5a5\uc73c\ub85c \ucf1c\uc9d0(VAG)",desc:"\uc9c0\uc0c1 \uac00\uc2dc\uc131\uc744 \uc704\ud574 \ud6c4\uc9c4 \uc2dc \ub3c4\uc5b4 \ud578\ub4e4 LED \ud37c\ub4e4 \uc870\uba85\uc744 \ucf1c\uc90d\ub2c8\ub2e4."},bmw_msport_exhaust_burble:{name:"M-\uc2a4\ud3ec\uce20 \ubc30\uae30\ubc84\ube14 \ubc0f \ud31d \uac15\ub3c4(BMW)",desc:"\uc2a4\ud3ec\uce20 \ubaa8\ub4dc\uc5d0\uc11c \uc624\ubc84\ub7f0 \ubc84\ube14 \uc0ac\uc6b4\ub4dc \uacf5\uaca9\uc131\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},bmw_welcome_light_sequence:{name:"\ud658\uc601 \uc870\uba85 \uc2dc\ud000\uc2a4 \uc560\ub2c8\uba54\uc774\uc158(BMW)",desc:"LED \ud5e4\ub4dc\ub77c\uc774\ud2b8\uc640 Angel Eyes \ud658\uc601 \uc778\uc0ac\ub9d0 \uc2dc\ud000\uc2a4\ub97c \uc0ac\uc6a9\uc790 \uc815\uc758\ud569\ub2c8\ub2e4."},bmw_service_history_menu:{name:"\ub514\uc9c0\ud138 \uc11c\ube44\uc2a4 \ub0b4\uc5ed \uba54\ub274 \ud65c\uc131\ud654(BMW)",desc:"\uc911\uc559 \ub514\uc2a4\ud50c\ub808\uc774\uc5d0\uc11c iDrive \ub514\uc9c0\ud138 \uc11c\ube44\uc2a4 \uae30\ub85d\ubd80 \uba54\ub274\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},bmw_hud_speed_display:{name:"\ud5e4\ub4dc\uc5c5 \ub514\uc2a4\ud50c\ub808\uc774 \ub514\uc9c0\ud138 \uc18d\ub3c4\uacc4 \uc624\ubc84\ub808\uc774(BMW)",desc:"\uc2e4\uc2dc\uac04 \ub514\uc9c0\ud138 \uc18d\ub3c4 \ud310\ub3c5\uac12\uc744 \ud5e4\ub4dc\uc5c5 \ub514\uc2a4\ud50c\ub808\uc774\uc5d0 \ud22c\uc0ac\ud569\ub2c8\ub2e4."},bmw_cornering_lights_fog:{name:"\uc548\uac1c\ub4f1 \ucf54\ub108\ub9c1 \uc870\uba85(BMW)",desc:"\ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \ub610\ub294 \uc800\uc18d \uc870\ud5a5 \uac01\ub3c4\uc5d0\uc11c \uc804\ubc29 \uc548\uac1c\ub4f1\uc744 \ucf2d\ub2c8\ub2e4."},bmw_easy_entry_steering:{name:"\uc774\uc9c0 \uc5d4\ud2b8\ub9ac \uc790\ub3d9 \ubcf5\uadc0 \uc2a4\ud2f0\uc5b4\ub9c1 \uce7c\ub7fc(BMW)",desc:"\uc27d\uac8c \ud558\ucc28\ud560 \uc218 \uc788\ub3c4\ub85d \uc5d4\uc9c4 \uc815\uc9c0 \uc2dc \uc804\ub3d9 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720\uc744 \uc704\ucabd\uc73c\ub85c \uc811\uc2b5\ub2c8\ub2e4."},bmw_bluetooth_audio_enable:{name:"\ud5a5\uc0c1\ub41c Bluetooth \uc624\ub514\uc624 \uc2a4\ud2b8\ub9ac\ubc0d \uc7a0\uae08 \ud574\uc81c(BMW)",desc:"iDrive HU_ENTRYNAV\uc5d0\uc11c A2DP Bluetooth \ubb34\uc120 \uc74c\uc545 \uc2a4\ud2b8\ub9ac\ubc0d\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},bmw_door_handle_lights_reverse:{name:"\uc678\ubd80 \ub3c4\uc5b4 \ud578\ub4e4 \ud37c\ub4e4 \ub77c\uc774\ud2b8(\ud6c4\uc9c4)(BMW)",desc:"\ud6c4\uc9c4 \uae30\uc5b4\ub97c \ub123\uc73c\uba74 \ub3c4\uc5b4 \ud578\ub4e4 LED\uac00 \ucf1c\uc9d1\ub2c8\ub2e4."},toyota_auto_headlight_threshold:{name:"\uc790\ub3d9 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \uc8fc\ubcc0\uad11 \uc13c\uc11c \uac10\ub3c4(Toyota)",desc:"\uc790\ub3d9 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \ud65c\uc131\ud654\ub97c \uc704\ud574 \ud669\ud63c\uc758 \ud669\ud63c \uc784\uacc4\uac12\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},toyota_turn_signal_click_volume:{name:"\ud134\uc2dc\uadf8\ub110 \uc624\ub514\uc624 \ud074\ub9ac\ucee4 \uc2a4\ud53c\ucee4 \ubcfc\ub968 (\ub3c4\uc694\ud0c0)",desc:"\ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \ub9b4\ub808\uc774 \ud074\ub9ad \ucc28\uc784 \ubcfc\ub968(\ub0ae\uc74c, \uc911\uac04, \ub192\uc74c)\uc744 \uad6c\uc131\ud569\ub2c8\ub2e4."},toyota_smart_key_approach_lights:{name:"\uc2a4\ub9c8\ud2b8 \ud0a4 \uadfc\uc811 \uc6f0\ucef4 \ud37c\ub4e4 \ub77c\uc774\ud2b8(Toyota)",desc:"\uc2a4\ub9c8\ud2b8\ud0a4\uac00 \ucc28\ub7c9\uc5d0 \uc811\uadfc\ud558\uba74 \ubbf8\ub7ec \ud37c\ub4e4\ub77c\uc774\ud2b8\uac00 \ucf1c\uc9d1\ub2c8\ub2e4."},toyota_rear_hatch_behavior:{name:"\ud30c\uc6cc \ud14c\uc77c\uac8c\uc774\ud2b8 \ub9ac\ud504\ud2b8\uac8c\uc774\ud2b8 \uc5f4\ub9bc/\ub2eb\ud798 \uc791\ub3d9 \ub85c\uc9c1(Toyota)",desc:"\uc6d0\uaca9 \ubc0f \ub300\uc2dc\ubcf4\ub4dc \ud30c\uc6cc \ud574\uce58 \ubc84\ud2bc\uc744 \ub204\ub974\ub294 \uc2dc\uac04\uc744 \uad6c\uc131\ud569\ub2c8\ub2e4."},toyota_open_windows_smart_key:{name:"\uc2a4\ub9c8\ud2b8 \ud0a4 \uc6d0\uaca9 \ucc3d \ub864\ub2e4\uc6b4 \uae38\uac8c \ub204\ub974\uae30 (Toyota)",desc:"\uc6d0\uaca9 \uc7a0\uae08 \ud574\uc81c \ubc84\ud2bc\uc744 \ub20c\ub7ec \ubaa8\ub4e0 \ucc3d\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},toyota_interior_light_dim_timer:{name:"\uc2e4\ub0b4 \uc2e4\ub0b4 \uc870\uba85 \uc790\ub3d9 \ubc1d\uae30 \uc870\uc808 \uaebc\uc9d0 \uc9c0\uc5f0(Toyota)",desc:"\ub3c4\uc5b4 \ud3d0\uc1c4 \ud6c4 \ub0b4\ubd80 \ub3d4 \uc870\uba85 \uc885\ub8cc \ud0c0\uc774\uba38\ub97c \uc870\uc815\ud569\ub2c8\ub2e4."},toyota_panic_alarm_remote:{name:"\uc6d0\uaca9 \uc804\uc790\ud0a4 \ud328\ub2c9 \uc54c\ub78c \uc0ac\uc774\ub80c \uae30\ub2a5(Toyota)",desc:"\uc6d0\uaca9 \ud0a4 \ud640\ub4dc\ub97c \ud1b5\ud574 \ucc28\ub7c9 \uacbd\uc801 \ud328\ub2c9 \uacbd\ubcf4\ub97c \ud65c\uc131\ud654 \ub610\ub294 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},toyota_eco_drive_indicator:{name:"ECO \ub4dc\ub77c\uc774\ube0c \ud074\ub7ec\uc2a4\ud130 \uad6c\uc5ed \ud45c\uc2dc\ub4f1(\ub3c4\uc694\ud0c0)",desc:"\ud074\ub7ec\uc2a4\ud130\uc5d0 \uce5c\ud658\uacbd \uac00\uc18d\ubc14 \ubc0f \ud45c\uc2dc\ub4f1\uc744 \ud45c\uc2dc\ud569\ub2c8\ub2e4."},hyundai_coming_home_duration:{name:"\uc5d0\uc2a4\ucf54\ud2b8 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \uaebc\uc9d0 \uc9c0\uc5f0 \ud0c0\uc774\uba38(\ud604\ub300/\uae30\uc544)",desc:"\ucc28\ub7c9 \ud558\ucc28 \ud6c4\uc5d0\ub3c4 \ud558\ud5a5\ub4f1 \ud5e4\ub4dc\ub77c\uc774\ud2b8\ub97c \uacc4\uc18d \ucf1c\uc90d\ub2c8\ub2e4."},hyundai_drl_menu_toggle:{name:"\uc8fc\uac04\uc8fc\ud589\ub4f1 \uba54\ub274 \uc81c\uc5b4(\ud604\ub300/\uae30\uc544)",desc:"\uacc4\uae30\ud310 \uc0ac\uc6a9\uc790 \uc635\uc158\uc5d0 DRL ON/OFF \uc124\uc815\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4."},hyundai_welcome_sequence:{name:"\uc2a4\ub9c8\ud2b8\ud0a4 \uadfc\uc811 \uc6f0\ucef4 \ub77c\uc774\ud2b8 & \ubbf8\ub7ec \ud3bc\uce68 (\ud604\ub300/\uae30\uc544)",desc:"\uc811\uadfc \uc2dc \ud30c\uc6cc \ubbf8\ub7ec\ub97c \ud3bc\uce58\uace0 \ub3c4\uc5b4 \ud578\ub4e4\uc744 \ucf1c\uc90d\ub2c8\ub2e4."},hyundai_interior_light_delay:{name:"\uc2e4\ub0b4 \uc2e4\ub0b4 \ub7a8\ud504 \uc790\ub3d9 \ucc28\ub2e8 \uc9c0\uc5f0(\ud604\ub300/\uae30\uc544)",desc:"\ubc30\ud130\ub9ac \uc808\uc57d\uc744 \uc704\ud574 \uc2e4\ub0b4 \uc870\uba85\uc774 \uc790\ub3d9\uc73c\ub85c \uaebc\uc9c0\uae30 \uc804\uc5d0 \ud0c0\uc774\uba38\ub97c \uc124\uc815\ud569\ub2c8\ub2e4."},hyundai_heat_pump_efficiency:{name:"EV \uacf5\uc870 \ud788\ud2b8\ud38c\ud504 \uc5f4\ud6a8\uc728 \ubaa8\ub4dc(\ud604\ub300/\uae30\uc544)",desc:"\ucd94\uc6b4 \uaca8\uc6b8 \ub0a0\uc528\uc5d0 EV \ud788\ud2b8\ud38c\ud504 \uc5d0\ub108\uc9c0 \uc18c\ube44\ub97c \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4."},tesla_track_mode_params:{name:"\ud2b8\ub799 \ubaa8\ub4dc \uc548\uc815\uc131 \ubc0f \ud1a0\ud06c \ubc14\uc774\uc5b4\uc2a4 \ud504\ub85c\ud544(Tesla)",desc:"\uc804\ubc29/\ud6c4\ubc29 \ubaa8\ud130 \uad6c\ub3d9 \ubc14\uc774\uc5b4\uc2a4 \ubc0f \uc548\uc815\uc131 \uac1c\uc785\uc744 \uad6c\uc131\ud569\ub2c8\ub2e4."},tesla_regen_brake_strength:{name:"\ud68c\uc0dd \uc81c\ub3d9\ub825 \ud504\ub85c\ud544(Tesla)",desc:"\uac00\uc18d \ud398\ub2ec \ub9ac\ud504\ud2b8 \uc624\ud504 \uc5d0\ub108\uc9c0 \ud68c\uc218 \uac15\ub3c4\ub97c \uc870\uc815\ud569\ub2c8\ub2e4."},tesla_walkaway_door_lock:{name:"\uc6cc\ud06c\uc5b4\uc6e8\uc774 \uc804\ud654 \ud0a4 \uc790\ub3d9 \ub3c4\uc5b4\ub85d(Tesla)",desc:"\uc804\ud654 \ud0a4\uac00 \uba40\uc5b4\uc9c0\uba74 \ubb38\uc744 \uc7a0\uadf8\uace0 \uacbd\uc801 \uc18c\ub9ac\ub85c \ud655\uc778\ud569\ub2c8\ub2e4."},tesla_acceleration_boost_unlock:{name:"\ud30c\uc6cc\ud2b8\ub808\uc778 \uac00\uc18d \ubd80\uc2a4\ud2b8 \ub4dc\ub77c\uc774\ube0c \ud504\ub85c\ud544(Tesla)",desc:"\ub354 \ube60\ub978 0~100km/h \uc18d\ub3c4\uc5d0 \ub300\ud55c \uc804\uae30 \ubaa8\ud130 \uc778\ubc84\ud130 \uc751\ub2f5\uc744 \uc120\uba85\ud558\uac8c \ud569\ub2c8\ub2e4."},tesla_interior_ambient_color:{name:"\uc2e4\ub0b4 \ubc1c\ubc11 \uacf5\uac04 \uc8fc\ubcc0 \uc870\uba85 \uc0c9\uc0c1 \uc0ac\uc804 \uc124\uc815(Tesla)",desc:"LED \ubc1c\ubc11 \uc8fc\ubcc0 \uc870\uba85 RGB \uc0c9\uc0c1 \ud314\ub808\ud2b8\ub97c \uc0ac\uc6a9\uc790 \uc815\uc758\ud569\ub2c8\ub2e4."},audi_matrix_led_animation:{name:"\ub9e4\ud2b8\ub9ad\uc2a4 LED \ud5e4\ub4dc\ub77c\uc774\ud2b8 \ub2e4\uc774\ub0b4\ubbf9 \uc6f0\ucef4 \ub77c\uc774\ud2b8 \ub304\uc2a4(Audi)",desc:"\ucc28\ub7c9 \uc7a0\uae08 \ud574\uc81c \uc2dc \uc5ed\ub3d9\uc801\uc778 \uc870\uba85 \uc548\ubb34\ub97c \uc7ac\uc0dd\ud569\ub2c8\ub2e4."},audi_mmi_startup_screen:{name:"MMI \ud130\uce58 \uc2a4\ud06c\ub9b0 \ubd80\ud305 \uadf8\ub798\ud53d \ud14c\ub9c8(Audi)",desc:"MMI \uc911\uc559 \ud654\uba74 \ubd80\ud305 \uc560\ub2c8\uba54\uc774\uc158(S/RS/e-tron)\uc744 \uc0ac\uc6a9\uc790 \uc815\uc758\ud569\ub2c8\ub2e4."},audi_drive_select_efficiency:{name:"\uc544\uc6b0\ub514 \ub4dc\ub77c\uc774\ube0c \uc140\ub809\ud2b8(Audi)\uc758 \ud6a8\uc728\uc131 \uc8fc\ud589 \ud504\ub85c\ud544",desc:"Drive Select \uc635\uc158\uc5d0\uc11c \uc5f0\ub8cc \uc808\uc57d \ud6a8\uc728\uc131 \ubaa8\ub4dc\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},audi_laptimer_boost_display:{name:"\ub7a9 \ud0c0\uc774\uba38 \ubc0f \ud130\ubcf4 \ubc14 \uc555\ub825 \uac8c\uc774\uc9c0 \uc624\ubc84\ub808\uc774(Audi)",desc:"Virtual Cockpit\uc5d0 \ud2b8\ub799 \ub7a9 \ud0c0\uc774\uba38\uc640 \uc2e4\uc2dc\uac04 \ud130\ubcf4 \ubd80\uc2a4\ud2b8 \uac8c\uc774\uc9c0\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4."},audi_needle_sweep_gauge:{name:"\uc2a4\ud3ec\uce20 \uac8c\uc774\uc9c0 \ub2c8\ub4e4 \uc2a4\uc715 \uac80\uc99d(Audi)",desc:"\uc2dc\uc791 \uc2dc \uc804\uccb4 \ud0c0\ucf54\ubbf8\ud130 \ubc0f \uc18d\ub3c4\uacc4 \ubc14\ub298 \uc2a4\uc715 \ud14c\uc2a4\ud2b8\ub97c \uc218\ud589\ud569\ub2c8\ub2e4."},skoda_coming_home_lights:{name:"\ucd9c\ud1f4\uadfc/\uadc0\uac00 \uc870\uba85 \ud0c0\uc774\uba38(Skoda)",desc:"\ucc28\ub7c9 \ud558\ucc28 \ud6c4 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \uc870\uba85 \ud0c0\uc774\uba38\ub97c \uad6c\uc131\ud569\ub2c8\ub2e4."},skoda_comfort_turn_signal:{name:"\ud3b8\uc548\ud568 \ud45c\uc2dc\uae30 \ud384\uc2a4 \uc218 \uc870\uc815(Skoda)",desc:"\uc6d0\ud130\uce58 \ubc29\ud5a5 \uc9c0\uc2dc\ub4f1 \uae5c\ubc15\uc784 \ud69f\uc218\ub97c 3~5\ud68c \uae5c\ubc15\uc784\uc73c\ub85c \uc124\uc815\ud569\ub2c8\ub2e4."},cupra_sport_display_menu:{name:"Cupra Performance Instrument \ubc0f G-Meter \uba54\ub274(Cupra)",desc:"G-force \ubbf8\ud130, kW \uc804\ub825 \uac8c\uc774\uc9c0 \ubc0f \uc624\uc77c \uc628\ub3c4 \ud45c\uc2dc\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},cupra_virtual_cockpit_copper:{name:"Copper \ud14c\ub9c8 \ub300\uc2dc\ubcf4\ub4dc \uc561\uc13c\ud2b8 \uadf8\ub798\ud53d(Cupra)",desc:"\uac8c\uc774\uc9c0 \ud074\ub7ec\uc2a4\ud130\uc5d0 \uc2dc\uadf8\ub2c8\ucc98 Cupra \uad6c\ub9ac \uae08\uc18d \uc561\uc13c\ud2b8 \ud14c\ub9c8\ub97c \uc801\uc6a9\ud569\ub2c8\ub2e4."},vag_brake_disc_drying:{name:"\ube57\uc18d\uc5d0\uc11c \ube0c\ub808\uc774\ud06c \ub514\uc2a4\ud06c \ub2e6\uae30/\uac74\uc870 \uae30\ub2a5(VAG)",desc:"\uc2b5\ud55c \ub0a0\uc528\uc5d0 \uac74\uc870\ud55c \ub85c\ud130\uc5d0 \ucd5c\uc18c\ud55c\uc758 \ud328\ub4dc \uc555\ub825\uc744 \uc8fc\uae30\uc801\uc73c\ub85c \uc801\uc6a9\ud569\ub2c8\ub2e4."},vag_tourist_mode_lights:{name:"\ud22c\uc5b4\ub9ac\uc2a4\ud2b8 \ubaa8\ub4dc \ud5e4\ub4dc\ub77c\uc774\ud2b8 \ube54 \ud328\ud134(VAG)",desc:"\ud574\uc678 \uc8fc\ud589 \uc2dc \ud5e4\ub4dc\ub77c\uc774\ud2b8 \ube54 \ud328\ud134\uc744 LHD\uc640 RHD\ub85c \uc804\ud658\ud569\ub2c8\ub2e4."},vag_hood_warning_mute:{name:"\ubcf4\ub2db \uac1c\ubc29\ud615 \uacc4\uae30 \ucc28\uc784 \uc74c\uc18c\uac70(VAG)",desc:"\ud6c4\ub4dc\uac00 \ud480\ub838\uc744 \ub54c \uc9c0\uc18d\uc801\uc778 \uacc4\uae30 \uacbd\uace0\uc74c\uc744 \uc5b5\uc81c\ud569\ub2c8\ub2e4."},vag_emergency_brake_hazard:{name:"\ube44\uc0c1 \uc81c\ub3d9 \uc790\ub3d9 \uc704\ud5d8 \uc810\uba78 \uc7a5\uce58(VAG)",desc:"\ud558\ub4dc ABS \ube44\uc0c1 \uc815\uc9c0 \uc911\uc5d0 \uc704\ud5d8 \ud45c\uc2dc\ub4f1\uc774 \ube60\ub974\uac8c \uae5c\ubc15\uc785\ub2c8\ub2e4."},vag_sunroof_comfort_open:{name:"\uc120\ub8e8\ud504 \ud2f8\ud2b8/\uac1c\ubc29\ud615 VAG(Remote Comfort Key Fob Logic)",desc:"\uc120\ub8e8\ud504\ub97c \uae30\uc6b8\uc774\uac70\ub098 \uc644\uc804\ud788 \uc5f4\ub3c4\ub85d \uc6d0\uaca9 \ud0a4 \ud640\ub4dc \ub3d9\uc791\uc744 \uad6c\uc131\ud569\ub2c8\ub2e4."},bmw_ecopro_display_variant:{name:"ECO PRO \uacc4\uae30\ud310 \uac8c\uc774\uc9c0 \uc2a4\ud0c0\uc77c\ub9c1(BMW)",desc:"\ud30c\ub780\uc0c9 ECO PRO \ud6a8\uc728 \uac8c\uc774\uc9c0 \uadf8\ub798\ud53d \ud14c\ub9c8\ub97c \uc0ac\uc6a9\uc790 \uc815\uc758\ud569\ub2c8\ub2e4."},bmw_volume_bar_hud:{name:"\ud5e4\ub4dc\uc5c5 \ub514\uc2a4\ud50c\ub808\uc774 \uc624\ub514\uc624 \ubcfc\ub968 \ub808\ubca8 \ubc14 \uc624\ubc84\ub808\uc774(BMW)",desc:"HUD \ud22c\uc601\uc5d0 \ubcfc\ub968 \ubcc0\uacbd \ub9c9\ub300\ub97c \uc9c1\uc811 \ud45c\uc2dc\ud569\ub2c8\ub2e4."},bmw_anti_dazzle_mirror:{name:"\uc804\uae30\ubcc0\uc0c9 \ub208\ubd80\uc2ec \ubc29\uc9c0 \ubbf8\ub7ec \ub514\ubc0d \uac10\ub3c4(BMW)",desc:"\uc790\ub3d9 \ubc31\ubbf8\ub7ec \ubc1d\uae30 \uc870\uc808 \ud3ec\ud1a0 \uc13c\uc11c \uc784\uacc4\uac12\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},bmw_camera_pdc_warning_mute:{name:"PDC \ubc0f \uc11c\ub77c\uc6b4\ub4dc \ubdf0 \uc18d\ub3c4 \ucc28\ub2e8 \uc18d\ub3c4 \uc870\uc815(BMW)",desc:"\uc8fc\ucc28 \uce74\uba54\ub77c\uac00 \uaebc\uc9c0\ub294 \ucc28\ub7c9 \uc18d\ub3c4 \uc784\uacc4\uac12\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},toyota_pcs_distance_preset:{name:"\ucda9\ub3cc \uc804 \uc2dc\uc2a4\ud15c(PCS) \uae30\ubcf8 \uacbd\uace0 \uac70\ub9ac(Toyota)",desc:"\ucd08\uae30 \ub808\uc774\ub354 \uc804\ubc29 \ucda9\ub3cc \uacbd\uace0 \uac70\ub9ac \uac10\ub3c4\ub97c \uc124\uc815\ud569\ub2c8\ub2e4."},toyota_bsm_timing:{name:"\uc0ac\uac01\uc9c0\ub300 \ubaa8\ub2c8\ud130(BSM) \uacbd\uace0 \uacbd\uace0 \ud0c0\uc774\ubc0d(Toyota)",desc:"\uc0ac\uac01\uc9c0\ub300 \uc0ac\uc774\ub4dc\ubbf8\ub7ec \uacbd\uace0\ub4f1 \uc810\ub4f1 \ud0c0\uc774\ubc0d\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},toyota_ac_noise_reduction:{name:"A/C \uc555\ucd95\uae30 \uc1a1\ud48d\uae30 \uc18c\uc74c \uac10\uc18c \ubaa8\ub4dc(\ub3c4\uc694\ud0c0)",desc:"\uac1d\uc2e4\uc758 \uc815\uc219\ud568\uc744 \uc704\ud574 \ucd5c\ub300 \uc5d0\uc5b4\ucee8 \uc1a1\ud48d\uae30 \ud32c \uc18d\ub3c4\ub97c \uc81c\ud55c\ud569\ub2c8\ub2e4."},toyota_sflow_control:{name:"S-Flow \uc2a4\ub9c8\ud2b8 \uc628\ub3c4 \uc870\uc808 1\uc778 \ud0d1\uc2b9 \ubaa8\ub4dc(\ub3c4\uc694\ud0c0)",desc:"\ubb34\uac8c \uc13c\uc11c\ub97c \uae30\ubc18\uc73c\ub85c \uc5d0\uc5b4\ucee8 \uacf5\uae30 \ud750\ub984\uc744 \uc88c\uc11d\uc5d0\ub9cc \uc9d1\uc911\uc2dc\ud0b5\ub2c8\ub2e4."},toyota_relock_timeout:{name:"\uc6d0\uaca9 \uc7a0\uae08 \ud574\uc81c \ud6c4 \uc790\ub3d9 \uc7ac\uc7a0\uae08 \uc9c0\uc5f0 \ud0c0\uc774\uba38(Toyota)",desc:"\ubb38\uc774 \uc5f4\ub9ac\uc9c0 \uc54a\uc740 \uacbd\uc6b0 \ubb38\uc774 \uc790\ub3d9\uc73c\ub85c \ub2e4\uc2dc \uc7a0\uae30\uae30 \uc804\uc5d0 \ucd08\ub97c \uc870\uc815\ud569\ub2c8\ub2e4(30\ucd08~120\ucd08)."},lexus_mark_levinson_audio_profile:{name:"Mark Levinson \uc11c\ub77c\uc6b4\ub4dc \uc0ac\uc6b4\ub4dc DSP \uc624\ub514\uc624 \ud504\ub85c\ud544(Lexus)",desc:"Mark Levinson \ud504\ub9ac\ubbf8\uc5c4 \uc2a4\ud53c\ucee4\uc5d0 \ub300\ud55c 3D \uacf5\uac04 \uc74c\ud5a5 \ud29c\ub2dd\uc744 \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4."},lexus_ev_mode_beeper_mute:{name:"\uc800\uc18d \ubcf4\ud589\uc790 EV \uc74c\ud5a5 \uacbd\uace0\uc74c \uc74c\uc18c\uac70(Lexus)",desc:"\uc800\uc18d \uc804\uae30 \ubaa8\ub4dc \ud569\uc131 \uc678\ubd80 \ucc28\uc784\ubca8\uc744 \uc5b5\uc81c\ud569\ub2c8\ub2e4."},lexus_easy_access_seat:{name:"\uc27d\uac8c \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720 \ubc0f \ud30c\uc6cc \uc2dc\ud2b8 \uc2ac\ub77c\uc774\ub4dc\ubc31(Lexus)",desc:"\uc6b4\uc804\uc11d\uc744 \ub4a4\ub85c \ubc00\uace0 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720\uc744 \uae30\uc6b8\uc5ec\uc11c \uc27d\uac8c \uc2b9\ud558\ucc28\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},nissan_epower_regen_mode:{name:"e-POWER 1\ud398\ub2ec \ud68c\uc0dd \uc81c\ub3d9 \ubaa8\ub4dc(\ub2db\uc0b0)",desc:"\uae30\ubcf8 e-\ud398\ub2ec \ud68c\uc0dd \uc81c\ub3d9 \uac10\uc18d \uc218\uc900\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."},nissan_propilot_assist_timing:{name:"ProPILOT \ucc28\uc120 \uc13c\ud130\ub9c1 \ubcf4\uc870 \uc870\ud5a5 \uac10\ub3c4(Nissan)",desc:"ProPILOT \uc870\ud5a5 \uac1c\uc785 \uc120\uba85\ub3c4\ub97c \uad6c\uc131\ud569\ub2c8\ub2e4."},nissan_intelligent_around_view:{name:"\uc5b4\ub77c\uc6b4\ub4dc \ubdf0 \ubaa8\ub2c8\ud130 \uc800\uc18d \uc790\ub3d9 \ud31d\uc5c5 (\ub2db\uc0b0)",desc:"\uc804\ubc29 \uc8fc\ucc28 \uc13c\uc11c\uac00 \uc7a5\uc560\ubb3c\uc744 \uac10\uc9c0\ud558\uba74 360\ub3c4 \uce74\uba54\ub77c \ub514\uc2a4\ud50c\ub808\uc774\ub97c \uc791\ub3d9\ud569\ub2c8\ub2e4."},mazda_g_vectoring_display:{name:"G-\ubca1\ud130\ub9c1 \ucee8\ud2b8\ub864 \ud50c\ub7ec\uc2a4 \ub2e4\uc774\ub098\ubbf9 \ube44\uc8fc\uc5bc\ub77c\uc774\uc800(Mazda)",desc:"\uacc4\uae30\ud310\uc5d0 \uc2e4\uc2dc\uac04 GVC+ \ucf54\ub108\ub9c1 \ud1a0\ud06c \ubca1\ud130\ub9c1 \uadf8\ub798\ud504\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4."},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP \ube0c\ub808\uc774\ud06c \uc5d0\ub108\uc9c0 \ud68c\uc218 \ucee4\ud328\uc2dc\ud130 \ubbf8\ud130(Mazda)",desc:"\ucd95\uc804\uae30\uc758 \ucda9\uc804 \ubc0f \ubc29\uc804 \uc0c1\ud0dc\ub97c \uc911\uc559 \ud654\uba74\uc5d0 \ud45c\uc2dc\ud569\ub2c8\ub2e4."},mazda_smart_city_brake_sens:{name:"\uc2a4\ub9c8\ud2b8 \uc2dc\ud2f0 \ube0c\ub808\uc774\ud06c \uc9c0\uc6d0(SCBS) \uac10\ub3c4(Mazda)",desc:"\uc800\uc18d \uc790\ub3d9 \ube44\uc0c1 \uc81c\ub3d9 \uc13c\uc11c \ubc94\uc704\ub97c \uc124\uc815\ud569\ub2c8\ub2e4."},subaru_eyesight_distance_preset:{name:"EyeSight \uc801\uc751\ud615 \ud06c\ub8e8\uc988 \ucee8\ud2b8\ub864 \uae30\ubcf8 \uac70\ub9ac(\uc2a4\ubc14\ub8e8)",desc:"\uc2dc\uc791 \uc2dc \uc2a4\ud14c\ub808\uc624 \uce74\uba54\ub77c \uae30\ubcf8 \ud06c\ub8e8\uc988 \uac04\uaca9 \ud504\ub85c\ud544\uc744 \uad6c\uc131\ud569\ub2c8\ub2e4."},subaru_xmode_auto_engage:{name:"X \ubaa8\ub4dc \uc624\ud504\ub85c\ub4dc \ud2b8\ub799\uc158 \uc790\ub3d9 \uacb0\ud569 \uc784\uacc4\uac12(\uc2a4\ubc14\ub8e8)",desc:"\uc790\ub3d9 \uc774\uc911 \uae30\ub2a5 X-Mode \ud65c\uc131\ud654\ub97c \uc704\ud55c \ud720 \ubbf8\ub044\ub7ec\uc9d0 \uc784\uacc4\uac12\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."},subaru_steering_responsive_headlights:{name:"\uc2a4\ud2f0\uc5b4\ub9c1 \ubc18\uc751\ud615 \ud5e4\ub4dc\ub77c\uc774\ud2b8(SRH) \ud1a0\uae00(\uc2a4\ubc14\ub8e8)",desc:"\ubc29\ud5a5 \uc801\uc751\ud615 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \ud68c\uc804\uc744 \ud65c\uc131\ud654\ud558\uac70\ub098 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},genesis_sport_plus_mode:{name:"Sport+ \ud30c\uc6cc\ud2b8\ub808\uc778 \ubc0f \uc804\uc790 \uc11c\uc2a4\ud39c\uc158 \ubaa8\ub4dc(\uc81c\ub124\uc2dc\uc2a4)",desc:"\ud2b8\ub799 \uc9c0\ud5a5 ESC OFF \ubc0f \uac15\ud654\ub41c \ub310\ud37c \ub9e4\ud551\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."},genesis_ambient_active_light:{name:"\ud65c\uc131 \uc8fc\ubcc0 \uc870\uba85 \ub4dc\ub77c\uc774\ube0c \ubaa8\ub4dc \ub3d9\uae30\ud654(\uc81c\ub124\uc2dc\uc2a4)",desc:"\uc8fc\ud589 \ubaa8\ub4dc\uc5d0 \ub530\ub77c \uc2e4\ub0b4 \uc8fc\ubcc0 \uc870\uba85 \uc0c9\uc0c1\uc744 \ub3d9\uc801\uc73c\ub85c \ubcc0\uacbd\ud569\ub2c8\ub2e4."},volvo_city_safety_warning:{name:"\ub3c4\uc2dc \uc548\uc804 \uc790\uc728 \ube44\uc0c1 \uacbd\uace0 \uac10\ub3c4(\ubcfc\ubcf4)",desc:"\ub808\uc774\ub354 \ubc0f \ub77c\uc774\ub354 \ucda9\ub3cc \uacbd\uace0 \uc54c\ub9bc \ud0c0\uc774\ubc0d(\uc870\uae30/\uc77c\ubc18)\uc744 \uad6c\uc131\ud569\ub2c8\ub2e4."},chery_ar_navigation_hud:{name:"HUD\uc758 AR \ub0b4\ube44\uac8c\uc774\uc158 \ud22c\uc601 \uc624\ubc84\ub808\uc774(Chery)",desc:"3D \uc99d\uac15 \ud604\uc2e4 \ub0b4\ube44\uac8c\uc774\uc158 \ud654\uc0b4\ud45c\ub97c \uc55e \uc720\ub9ac\uc5d0 \ud22c\uc0ac\ud569\ub2c8\ub2e4."},jlr_terrain_response_preset:{name:"\uc9c0\ud615 \ubc18\uc751 \uc790\ub3d9 \uc624\ud504\ub85c\ub4dc \ubaa8\ub4dc \ud504\ub9ac\uc14b(JLR)",desc:"\ub9c8\uc9c0\ub9c9 \uc9c0\ud615 \ubc18\uc751 \ud45c\uba74 \ud504\ub85c\ud544(\uc794\ub514/\uc790\uac08/\ub208)\uc744 \uae30\uc5b5\ud569\ub2c8\ub2e4."},jlr_adaptive_dynamics_firm:{name:"\uc801\uc751\ud615 \uc5ed\ud559 \ub310\ud37c \uacac\uace0\uc131 \ud504\ub85c\ud544(JLR)",desc:"\uae30\ubcf8 \uc804\uc790 \ucda9\uaca9 \ud761\uc218 \uc7a5\uce58 \uac10\uc1e0 \uac15\uc131\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."},jlr_wading_sensor_alert:{name:"\ub3c4\uac15 \uac10\uc9c0 \uae4a\uc774 \uacbd\uace0 \ucc28\uc784 \uc784\uacc4\uac12(JLR)",desc:"\ucd08\uc74c\ud30c \uc218\uc2ec \uacbd\uace0 \ucc28\uc784 \uac10\ub3c4\ub97c \uad6c\uc131\ud569\ub2c8\ub2e4."},alfa_dna_dynamic_memory:{name:"Alfa DNA \uc120\ud0dd\uae30 \ub3d9\uc801 \ubaa8\ub4dc \uc2dc\uc791 \uba54\ubaa8\ub9ac(Alfa Romeo)",desc:"\ub2e4\uc2dc \uc2dc\uc791\ud55c \ud6c4\uc5d0\ub3c4 \ub3d9\uc801 \ubaa8\ub4dc \uc2a4\ub85c\ud2c0 \uc751\ub2f5\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4."},alfa_q4_torque_split:{name:"Q4 \uc0ac\ub95c\uad6c\ub3d9 \uc2e4\uc2dc\uac04 \ud1a0\ud06c \ubd84\ud560 \uadf8\ub798\ud504(\uc54c\ud30c\ub85c\uba54\uc624)",desc:"\uacc4\uae30\ud310\uc5d0 AWD \uc804\ubc29/\ud6c4\ubc29 \ub3d9\ub825 \ubd84\ubc30 \ube44\uc728\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4."},li_auto_range_extender_mode:{name:"REV \ubc1c\uc804\uae30 \ubc30\ud130\ub9ac \ucda9\uc804 \uc720\uc9c0 \uc218\uc900(Li \uc790\ub3d9)",desc:"\ub0b4\uc5f0\uae30\uad00 \ubc1c\uc804\uae30 \uc2dc\ub3d9 \uc784\uacc4\uac12\uc744 \uc870\uc815\ud569\ub2c8\ub2e4."},li_auto_cinema_seat_position:{name:"\uadf9\uc7a5/\uc2dc\ub124\ub9c8 \ubaa8\ub4dc \uc778\uccb4\uacf5\ud559\uc801 \uc88c\uc11d \uc704\uce58(Li Auto)",desc:"\uc2dc\ub124\ub9c8 \ubaa8\ub4dc\uac00 \ud65c\uc131\ud654\ub418\uba74 \ub4b7\uc88c\uc11d\uc744 \ub4a4\ub85c \uc816\ud788\uace0 \ub2e4\ub9ac \ubc1b\uce68\ub300\ub97c \ud3bc\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},zeekr_drift_mode_torque:{name:"\ub4c0\uc5bc \ubaa8\ud130 \uc131\ub2a5 \ub4dc\ub9ac\ud504\ud2b8 \ubaa8\ub4dc \ud6c4\uba74 \ubc14\uc774\uc5b4\uc2a4(Zeekr)",desc:"\ub4dc\ub9ac\ud504\ud2b8 \uc81c\uc5b4\ub97c \uc704\ud574 \ud6c4\ubc29 \uc804\uae30 \ubaa8\ud130\uc5d0 100% \ud1a0\ud06c\ub97c \ubcf4\ub0c5\ub2c8\ub2e4."},zeekr_ambient_beat_sync:{name:"\uc8fc\ubcc0 \uc870\uba85 \uc74c\uc545 \ub9ac\ub4ec \ube44\ud2b8 \ub3d9\uae30\ud654(Zeekr)",desc:"\uc7ac\uc0dd\ub418\ub294 \uc74c\uc545 \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \uc2e4\ub0b4 \uc870\uba85\uc744 \uc9c4\ub3d9\uc2dc\ud0b5\ub2c8\ub2e4."},tata_drive_mode_voice:{name:"\uc8fc\ud589\ubaa8\ub4dc \uc804\ud658 \uc74c\uc131\uc548\ub0b4(\ud0c0\ud0c0)",desc:"\uc8fc\ud589 \ubaa8\ub4dc(\uc2dc\ud2f0/\uc2a4\ud3ec\uce20/\uc5d0\ucf54) \uc804\ud658 \uc2dc \uc624\ub514\uc624 \uc74c\uc131 \ud655\uc778\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."},mahindra_zip_zap_zoom_custom:{name:"Zip/Zap/Zoom \ud30c\uc6cc\ud2b8\ub808\uc778 \uc2a4\ub85c\ud2c0 \ubc18\uc751 \ud504\ub85c\ud544(Mahindra)",desc:"Zip, Zap \ubc0f Zoom \uc6b4\uc804 \ubaa8\ub4dc\uc5d0 \ub300\ud55c \uac00\uc18d \uace1\uc120\uc744 \uc0ac\uc6a9\uc790 \uc815\uc758\ud569\ub2c8\ub2e4."},fun_cyberpunk_cluster_theme:{name:"Cyberpunk 2077 \ub124\uc628 \uadf8\ub798\ud53d \uc870\uc885\uc11d \ud14c\ub9c8",desc:"\ubbf8\ub798 \uc9c0\ud5a5\uc801\uc778 \ub124\uc628 \uccad\ub85d\uc0c9 \ubc0f \ud638\ubc15\uc0c9 \ub514\uc9c0\ud138 \ub300\uc2dc\ubcf4\ub4dc \uac8c\uc774\uc9c0 \uc2a4\ud0c0\uc77c\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4."},fun_exhaust_flame_sound_effect:{name:"\uc2a4\ud14c\ub808\uc624 \uc2dc\uc2a4\ud15c \ud31d \uc564 \ubc45 \ubc30\uae30\uc74c FX",desc:"\uc2e4\ub0b4 \uc2a4\ud53c\ucee4\ub97c \ud1b5\ud574 \uc0ac\uc2e4\uc801\uc778 V8 \ubc30\uae30 \ud31d & \ubc45 \uc624\ub514\uc624 \ud6a8\uacfc\ub97c \uc7ac\uc0dd\ud569\ub2c8\ub2e4."},fun_matrix_light_show_welcome:{name:"\ub9de\ucda4\ud615 \ud5e4\ub4dc\ub77c\uc774\ud2b8 \ub9e4\ud2b8\ub9ad\uc2a4 LED \ub304\uc2a4 \ud658\uc601",desc:"\ud5e4\ub4dc\ub77c\uc774\ud2b8\uc640 \ud45c\uc2dc\ub4f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub9ac\ub4dc\ubbf8\uceec\ud55c \ub77c\uc774\ud2b8 \uc1fc \uc548\ubb34\ub97c \uc7ac\uc0dd\ud569\ub2c8\ub2e4."},fun_stealth_fighter_display:{name:"\uc2a4\ud154\uc2a4 \ud30c\uc774\ud130 \uc57c\uac04 \uc6b4\uc804 \ubbf8\ub2c8\uba40\ub9ac\uc2a4\ud2b8 \ud074\ub7ec\uc2a4\ud130 \ubaa8\ub4dc",desc:"\uce60\ud751 \uac19\uc740 \uc57c\uac04 \uc8fc\ud589\uc744 \uc704\ud574 \uc18d\ub3c4\uacc4\ub97c \uc81c\uc678\ud55c \ubaa8\ub4e0 \ud074\ub7ec\uc2a4\ud130 \uc870\uba85\uc744 \ub055\ub2c8\ub2e4."},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{name:"Retarder & Jake Brake Downshift Aggressiveness",desc:"Adjusts retarder torque blending curve and automatic transmission downshifting response under braking."},man_ecas_dock_level_memory:{name:"ECAS Air Suspension Loading Dock Height Memory",desc:"Stores and recalls customized pneumatic air suspension height level presets for loading docks."},daf_stationary_dpf_regen_trigger:{name:"Stationary DPF Forced Soot Regeneration",desc:"Initiates stationary diesel particulate filter thermal soot burn routine in parked position."},ford_trucks_reverse_buzzer_night_mode:{name:"Reverse Acoustic Alarm Night Quiet Mode",desc:"Attenuates reverse backup horn alarm volume for quiet night distribution in residential areas."},cummins_ecm_fleet_speed_limiter:{name:"Cummins Engine Road Speed Limiter (RSL)",desc:"Programs maximum allowable road vehicle speed in Cummins ECM parameter tables."}},codeBtn:"\ucf54\ub529",removeBtn:"\uc81c\uac70",unsupportedTitle:"\uc9c0\uc6d0\ub418\uc9c0 \uc54a\ub294 \ucc28\ub7c9",unsupportedMsg:"\uc774 \uae30\ub2