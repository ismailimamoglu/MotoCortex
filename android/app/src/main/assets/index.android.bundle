\u0648\u0628",cardDesc:"\u0645\u0646 \u0623\u062c\u0644 \u062a\u062d\u0633\u064a\u0646 \u062c\u0648\u062f\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u062a\u0648\u0627\u0641\u0642 \u0627\u0644\u0633\u064a\u0627\u0631\u0629\u061b \u064a\u0645\u0643\u0646 \u062a\u062d\u0644\u064a\u0644 \u0645\u0639\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0643 \u0648\u0623\u0643\u0648\u0627\u062f \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0645\u062c\u0647\u0648\u0644\u0629 \u0627\u0644\u0645\u0635\u062f\u0631 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0623\u062b\u0646\u0627\u0621 \u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 (\u062f\u0648\u0646 \u0627\u062d\u062a\u0648\u0627\u0621 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0648\u0631\u0642\u0645 \u0627\u0644\u0647\u064a\u0643\u0644) \u0639\u0644\u0649 \u062e\u0648\u0627\u062f\u0645\u0646\u0627 \u0627\u0644\u0622\u0645\u0646\u0629. \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0641\u0625\u0646\u0643 \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0634\u0631\u0648\u0637 \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0627\u0644\u0645\u062c\u0647\u0648\u0644\u0629 \u0647\u0630\u0647.",btLabel:"\u0628\u0644\u0648\u062a\u0648\u062b (\u0628\u0644\u064a\u0647)",btSub:"\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647 \u0641\u0642\u0637 \u0644\u0644\u0627\u0642\u062a\u0631\u0627\u0646 \u0645\u0639 \u0645\u062d\u0648\u0644 ELM327/OBD2 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0648\u0628\u062b \u0628\u064a\u0627\u0646\u0627\u062a CAN-bus/K-Line \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629.",locLabel:"\u0625\u0630\u0646 \u0627\u0644\u0645\u0648\u0642\u0639",locSub:"\u0645\u0646 \u0627\u0644\u0636\u0631\u0648\u0631\u064a \u0648\u0641\u0642\u064b\u0627 \u0644\u0628\u0646\u064a\u0629 \u0646\u0638\u0627\u0645 Android \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0623\u062c\u0647\u0632\u0629 Bluetooth \u0645\u0646\u062e\u0641\u0636\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0642\u0631\u064a\u0628\u0629. \u0646\u062d\u0646 \u0644\u0627 \u0646\u062a\u062a\u0628\u0639 \u0642\u064a\u0627\u062f\u062a\u0643.",grantBtn:"\u0627\u0644\u0633\u0645\u0627\u062d \u0648\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629",skipBtn:"\u062a\u062e\u0637\u064a \u0627\u0644\u0622\u0646 (\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a)",deniedDesc:"\u062a\u0645 \u0631\u0641\u0636 \u0628\u0639\u0636 \u0627\u0644\u062a\u0635\u0627\u0631\u064a\u062d. \u0642\u062f \u0644\u0627 \u064a\u062a\u0645\u0643\u0646 Cortex OBD2 Diagnostic Scanner \u0645\u0646 \u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0633\u062d \u0627\u0644\u0636\u0648\u0626\u064a \u0623\u0648 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0623\u062c\u0647\u0632\u0629 obd2 \u0628\u0646\u062c\u0627\u062d.",proceedAnyway:"\u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0639\u0644\u0649 \u0623\u064a \u062d\u0627\u0644",openSettings:"\u0627\u0641\u062a\u062d \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a",langTitle:"\u0627\u062e\u062a\u0631 \u0627\u0644\u0644\u063a\u0629",nextBtn:"\u0645\u062a\u0627\u0628\u0639\u0629",langDesc:"\u064a\u0631\u062c\u0649 \u0627\u062e\u062a\u064a\u0627\u0631 \u0644\u063a\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629.",langSelectSub:"\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0644\u063a\u0629",telemetryLabel:"\u0627\u0644\u0642\u064a\u0627\u0633 \u0627\u0644\u062a\u0634\u062e\u064a\u0635\u064a \u0639\u0646 \u0628\u0639\u062f (\u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643)",telemetrySub:"\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0627\u0644\u0645\u062c\u0647\u0648\u0644 \u0648\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0644\u062a\u062d\u0633\u064a\u0646 \u062a\u0648\u0627\u0641\u0642 \u0627\u0644\u0633\u064a\u0627\u0631\u0629.",restartOnboarding:"\u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0623\u0648\u0644\u064a (\u0627\u0644\u0644\u063a\u0629 \u0648\u0627\u0644\u0623\u0630\u0648\u0646\u0627\u062a)"},disclaimer:"\u062c\u0645\u064a\u0639 \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u0634\u0639\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0647\u064a \u0645\u0644\u0643 \u0644\u0623\u0635\u062d\u0627\u0628\u0647\u0627. \u062c\u0645\u064a\u0639 \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0648\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0647\u064a \u0644\u0623\u063a\u0631\u0627\u0636 \u0627\u0644\u062a\u0639\u0631\u064a\u0641 \u0641\u0642\u0637. \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0648\u0627\u0644\u0634\u0639\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0644\u0627 \u064a\u0639\u0646\u064a \u0623\u064a \u062a\u0623\u064a\u064a\u062f \u0623\u0648 \u0631\u0639\u0627\u064a\u0629.",hiddenFeatures:{title:"\u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u062e\u0641\u064a\u0629",btnLabel:"\u0641\u062a\u062d \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u062e\u0641\u064a\u0629",unsupported:"\u0647\u0630\u0627 \u0627\u0644\u0645\u062d\u0648\u0644 OBD2 \u0644\u0627 \u064a\u062f\u0639\u0645 \u0641\u062a\u062d \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u062e\u0641\u064a\u0629.",unsupportedDesc:"\u064a\u0644\u0632\u0645 ELM327 \u0627\u0644\u0623\u0635\u0644\u064a v2.1 \u0623\u0648 \u0623\u0639\u0644\u0649. \u0627\u0644\u0645\u062d\u0648\u0644\u0627\u062a \u0627\u0644\u0645\u0642\u0644\u062f\u0629 \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\u0629.",notConnected:"\u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0645\u0631\u0643\u0628\u0629 \u0623\u0648\u0644\u0627\u064b.",notConnectedDesc:"\u064a\u062c\u0628 \u062a\u0648\u0635\u064a\u0644 \u062c\u0647\u0627\u0632 OBD2.",warning:"\u0642\u062f \u062a\u0624\u062b\u0631 \u0647\u0630\u0647 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0639\u0644\u0649 \u0636\u0645\u0627\u0646 \u0645\u0631\u0643\u0628\u062a\u0643.",confirmTitle:"\u0645\u0637\u0644\u0648\u0628 \u062a\u0623\u0643\u064a\u062f",confirmMsg:"\u062a\u063a\u064a\u064a\u0631 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u064a\u0624\u062b\u0631 \u0639\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f",confirmOk:"\u0645\u062a\u0627\u0628\u0639\u0629",confirmCancel:"\u0625\u0644\u063a\u0627\u0621",categoryLighting:"\u0627\u0644\u0625\u0636\u0627\u0621\u0629",categorySound:"\u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a",categoryDisplay:"\u0644\u0648\u062d\u0629 \u0627\u0644\u0623\u062c\u0647\u0632\u0629",categoryDriving:"\u0627\u0644\u0642\u064a\u0627\u062f\u0629",featureDrl:"\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0646\u0647\u0627\u0631 (DRL)",featureRearFog:"\u062a\u062c\u0627\u0648\u0632 \u0636\u0648\u0621 \u0627\u0644\u0636\u0628\u0627\u0628 \u0627\u0644\u062e\u0644\u0641\u064a",featureDoorChime:"\u062a\u0639\u0637\u064a\u0644 \u0646\u063a\u0645\u0629 \u0627\u0644\u0628\u0627\u0628",featureParkingAlert:"\u062a\u0646\u0628\u064a\u0647 \u0635\u0648\u062a\u064a \u0644\u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u064a\u062f",featureRpmWarning:"\u062a\u062d\u0630\u064a\u0631 \u062d\u062f \u0627\u0644\u062f\u0648\u0631\u0627\u0646",featureFuelSensitivity:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0645\u0642\u064a\u0627\u0633 \u0627\u0644\u0648\u0642\u0648\u062f",featureStartStop:"Start-Stop \u0645\u0639\u0637\u0644 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0627\u064b",featureSportMemory:"\u0630\u0627\u0643\u0631\u0629 \u0648\u0636\u0639 Sport",enabled:"\u0645\u0641\u0639\u0651\u0644",disabled:"\u0645\u0639\u0637\u0651\u0644",writeSuccess:"\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u064a\u0632\u0629 \u0628\u0646\u062c\u0627\u062d.",writeError:"\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628\u0629. \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",simulationBanner:"\u0648\u0636\u0639 \u0627\u0644\u0645\u062d\u0627\u0643\u0627\u0629 \u2014 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0641\u064a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u063a\u064a\u0631 \u0646\u0634\u0637\u0629 \u0628\u0639\u062f",closeBtn:"\u0625\u063a\u0644\u0627\u0642",unsupportedOk:"OK",disclaimerTitle:"\u0625\u062e\u0644\u0627\u0621 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629",disclaimerFeature:"\u0645\u064a\u0632\u0629",disclaimerBody:"\u064a\u0624\u062b\u0631 \u062a\u063a\u064a\u064a\u0631 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0628\u0634\u0643\u0644 \u0645\u0628\u0627\u0634\u0631 \u0639\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0635\u0646\u0639 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0633\u064a\u0627\u0631\u062a\u0643 \u0648\u0628\u0631\u0646\u0627\u0645\u062c \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629. \u064a\u0631\u062c\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0628\u0639\u0646\u0627\u064a\u0629:\n\n\u2022 \u0642\u062f \u064a\u0624\u062f\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u063a\u064a\u0631 \u0627\u0644\u0635\u062d\u064a\u062d \u0625\u0644\u0649 \u0625\u0628\u0637\u0627\u0644 \u0636\u0645\u0627\u0646 \u0633\u064a\u0627\u0631\u062a\u0643.\n\u2022 \u0642\u062f \u062a\u0624\u062f\u064a \u0628\u0639\u0636 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0625\u0644\u0649 \u062d\u062f\u0648\u062b \u0623\u0639\u0637\u0627\u0644 \u062f\u0627\u0626\u0645\u0629 \u0623\u0648 \u0623\u062e\u0637\u0627\u0621 \u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639\u0629.\n\u2022 \u0641\u064a \u062d\u064a\u0646 \u0623\u0646 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0642\u062f \u062a\u0643\u0648\u0646 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0639\u0643\u0633\u060c \u0625\u0644\u0627 \u0623\u0646 \u0628\u0639\u0636 \u0648\u062d\u062f\u0627\u062a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0642\u062f \u062a\u062a\u0637\u0644\u0628 \u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0627\u0644\u0645\u0635\u0646\u0639.\n\u2022 \u064a\u062a\u062d\u0645\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u062d\u062f\u0647 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0623\u064a \u0636\u0631\u0631 \u0645\u0627\u062f\u064a \u0623\u0648 \u063a\u064a\u0631 \u0645\u0627\u062f\u064a \u0646\u0627\u062a\u062c \u0639\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629.\n\u2022 \u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u062d\u0645\u064a\u0644 Cortex Obd2 Diagnostic Scanner \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0623\u064a \u062e\u0644\u0644 \u0623\u0648 \u0636\u0631\u0631 \u0646\u0627\u062a\u062c \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a.\n\n\u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646\u0643 \u0642\u0631\u0623\u062a \u0647\u0630\u0627 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0648\u0641\u0647\u0645\u062a\u0647.",checkboxTitle:"\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0645\u0637\u0644\u0648\u0628",check1:"\u0644\u0642\u062f \u0642\u0631\u0623\u062a \u0647\u0630\u0627 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0648\u0623\u062f\u0631\u0643\u062a \u0623\u0646 \u0636\u0645\u0627\u0646 \u0633\u064a\u0627\u0631\u062a\u064a \u0642\u062f \u064a\u062a\u0623\u062b\u0631.",check2:"\u0623\u0642\u0631 \u0628\u0623\u0646 Cortex Obd2 Diagnostic Scanner \u0644\u064a\u0633 \u0645\u0633\u0624\u0648\u0644\u0627\u064b \u0639\u0646 \u0623\u064a \u0623\u062e\u0637\u0627\u0621 \u0623\u0648 \u0623\u0636\u0631\u0627\u0631 \u0646\u0627\u062a\u062c\u0629 \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629.",check3:"\u0623\u0631\u063a\u0628 \u0641\u064a \u0625\u062c\u0631\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u062a\u063a\u064a\u064a\u0631 \u0628\u0645\u0639\u0631\u0641\u0629 \u0648\u0625\u0631\u0627\u062f\u062a\u064a \u0627\u0644\u062d\u0631\u0629\u060c \u0645\u062a\u0642\u0628\u0644\u064b\u0627 \u0643\u0627\u0641\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u0631.",disclaimerCancel:"\u064a\u0644\u063a\u064a",disclaimerContinue:"\u064a\u0643\u0645\u0644",unsupportedTitle:"\u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\u0629",unsupportedMsg:"\u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\u0629 \u0645\u0646 \u0642\u0628\u0644 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0644\u0644\u0645\u0631\u0643\u0628\u0629."},disconnectShort:"\u0642\u0637\u0639",obdTerminal:{title:"\u0641\u062a\u062d \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062e\u0641\u064a\u0629 \u0648\u062a\u0634\u0641\u064a\u0631 UDS",terminalTitle:"\u0645\u062d\u0637\u0629 \u0623\u0648\u0628\u062f",terminalPlaceholder:"\u0627\u0643\u062a\u0628 \u0627\u0644\u0623\u0645\u0631 \u0623\u062f\u0646\u0627\u0647 \u0644\u0625\u0631\u0633\u0627\u0644\u0647 \u0625\u0644\u0649 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 010C\u060c ATRV)",inputPlaceholder:"\u0623\u062f\u062e\u0644 \u0627\u0644\u0623\u0645\u0631...",sendButton:"\u064a\u0631\u0633\u0644",statsTitle:"\u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0627\u0644\u0635\u062d\u0629 \u0623\u0648 \u0628\u064a \u062f\u064a",connectionProtocol:"\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644:",none:"\u0644\u0627 \u0623\u062d\u062f",hardwareQualityScore:"\u0646\u0642\u0627\u0637 \u062c\u0648\u062f\u0629 \u0627\u0644\u0623\u062c\u0647\u0632\u0629:",original:"\u0625\u0628\u062f\u0627\u0639\u064a",clone:"\u0627\u0633\u062a\u0646\u0633\u0627\u062e",requestResponseCount:"\u0639\u062f\u062f \u0627\u0644\u0637\u0644\u0628\u0627\u062a/\u0627\u0644\u0631\u062f\u0648\u062f:",timeoutCount:"\u0639\u062f\u062f \u0627\u0644\u0645\u0647\u0644\u0629:",recoveryCount:"\u0639\u062f\u062f \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f (\u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f):",diagnosticLogTitle:"\u0633\u062c\u0644 \u0627\u0644\u062a\u0634\u062e\u064a\u0635",clearButton:"\u0648\u0627\u0636\u062d",shareButton:"\u064a\u0634\u0627\u0631\u0643",noLogs:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0633\u062c\u0644\u0627\u062a \u062a\u0634\u062e\u064a\u0635\u064a\u0629.",noShareSupport:"\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632."},dtcContext:{powertrain:"\u0642\u062f \u064a\u0624\u062b\u0631 \u0647\u0630\u0627 \u0627\u0644\u062e\u0644\u0644 \u0639\u0644\u0649 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0641\u064a \u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0648\u0642\u0648\u062f \u0648\u0623\u062f\u0627\u0621 \u0627\u0644\u0645\u062d\u0631\u0643. \u0641\u062a\u062d \u0627\u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0643\u0627\u0645\u0644 \u2192",cooling:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u062e\u0637\u0631 \u0627\u0644\u062a\u0628\u0631\u064a\u062f \u0627\u0644\u062d\u0631\u062c. \u0639\u0631\u0636 \u062e\u0637\u0648\u0627\u062a \u0627\u0644\u0625\u0635\u0644\u0627\u062d \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a\u0629 \u2192",ignition:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0646\u0638\u0627\u0645 \u0627\u0644\u0625\u0634\u0639\u0627\u0644. \u0639\u0631\u0636 \u062e\u0637\u0648\u0627\u062a \u0627\u0644\u0625\u0635\u0644\u0627\u062d \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a\u0629 \u2192",chassis:"\u062a\u0646\u0628\u064a\u0647 \u0646\u0638\u0627\u0645 \u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0647\u064a\u0643\u0644. \u0641\u062a\u062d PRO \u0644\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0643\u0627\u0645\u0644 \u2192",body:"\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u062e\u0637\u0623 \u0641\u064a \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0627\u062a \u0627\u0644\u062c\u0633\u0645. \u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0643\u0627\u0645\u0644 \u2192",network:"\u062e\u0637\u0623 \u0641\u064a \u0634\u0628\u0643\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a. \u064a\u0641\u062a\u062d PRO \u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0648\u0625\u0635\u0644\u0627\u062d\u0647\u0627 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u2192",fallback:"\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a \u0644\u0644\u0623\u062e\u0637\u0627\u0621 \u0648\u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u0625\u0635\u0644\u0627\u062d \u0648\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u2192"},perfTeaser:{limitTitle:"\u062a\u0645 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062d\u062f \u0627\u0644\u064a\u0648\u0645\u064a",limitDesc:"\u0644\u0642\u062f \u0648\u0635\u0644\u062a \u0625\u0644\u0649 \u0627\u0644\u062d\u062f \u0627\u0644\u064a\u0648\u0645\u064a \u0648\u0647\u0648 3 \u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0645\u062c\u0627\u0646\u064a\u0629 \u0644\u0644\u0633\u0631\u0639\u0629 \u0645\u0646 0 \u0625\u0644\u0649 60 \u0643\u0645/\u0633\u0627\u0639\u0629. \u0642\u0645 \u0628\u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0625\u0644\u0649 PRO \u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f\u0629 \u0648\u0642\u064a\u0627\u0633\u0627\u062a 0-100 \u0643\u0645/\u0633\u0627\u0639\u0629."},sandbox:{title:"\u0641\u062a\u062d \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062e\u0641\u064a\u0629 \u0648\u062a\u0634\u0641\u064a\u0631 UDS",connectionStatus:"\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644:",ecuStatus:"\u062d\u0627\u0644\u0629 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629:",fps:"\u0623\u062f\u0627\u0621 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645: {{fps}} \u0625\u0637\u0627\u0631\u064b\u0627 \u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a\u0629",stressBtnStart:"\u0628\u062f\u0621 \u0627\u0644\u0625\u062c\u0647\u0627\u062f 20 \u0647\u0631\u062a\u0632",stressBtnStop:"\u0625\u064a\u0642\u0627\u0641 \u062d\u0644\u0642\u0629 \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f",stopDisconnect:"\u062a\u0648\u0642\u0641 / \u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644",discoveredDevices:"\u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u0643\u062a\u0634\u0641\u0629",connect:"\u064a\u062a\u0635\u0644",scanning:"\u0645\u0633\u062d...",scan:"\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u0633\u062d",rpm:"\u0639\u062f\u062f \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0643 \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629",speed:"\u0633\u0631\u0639\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629",coolant:"\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0628\u0631\u064a\u062f",throttle:"\u0645\u0648\u0642\u0641 \u062e\u0646\u0642",notConnected:"\u063a\u064a\u0631 \u0645\u062a\u0635\u0644",connected:"\u0645\u062a\u0635\u0644",connecting:"\u062c\u0627\u0631\u064d \u0627\u0644\u0627\u062a\u0635\u0627\u0644...",error:"\u062e\u0637\u0623",openSandbox:"\u062f\u064a\u0627\u062c",advancedTerminal:"\u0645\u062d\u0637\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 (DIAG)",terminalTitle:"\u0645\u062d\u0637\u0629 \u062d\u064a\u0629 \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u062d\u0627\u0641\u0644\u0627\u062a",pause:"\u064a\u0648\u0642\u0641",resume:"\u0633\u064a\u0631\u0629 \u0630\u0627\u062a\u064a\u0629",share:"\u064a\u0634\u0627\u0631\u0643",clear:"\u0648\u0627\u0636\u062d",clearDtcs:"\u0645\u0633\u062d DTC",dtcTitle:"\u062a\u0634\u062e\u064a\u0635 DTC \u0648\u0623\u0643\u0648\u0627\u062f \u0627\u0644\u0623\u0639\u0637\u0627\u0644",noDtcs:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0623\u0643\u0648\u0627\u062f DTC \u0641\u064a ECU",readDtcs:"\u