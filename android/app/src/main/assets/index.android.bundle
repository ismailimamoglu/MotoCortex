al:{name:"Penyesuaian Jumlah Pulsa Indikator Kenyamanan (Skoda)",desc:"Mengatur jumlah kedipan lampu sein sekali sentuh antara 3 dan 5 kedipan."},cupra_sport_display_menu:{name:"Instrumen Pertunjukan Cupra & Menu G-Meter (Cupra)",desc:"Membuka pengukur G-force, pengukur daya kW, dan tampilan suhu oli."},cupra_virtual_cockpit_copper:{name:"Grafik Aksen Dasbor Tema Tembaga (Cupra)",desc:"Menerapkan tema aksen metalik tembaga Cupra yang khas untuk mengukur cluster."},vag_brake_disc_drying:{name:"Fungsi Penyeka/Pengeringan Cakram Rem Saat Hujan (VAG)",desc:"Secara berkala menerapkan tekanan bantalan minimal dalam cuaca basah ke rotor kering."},vag_tourist_mode_lights:{name:"Pola Sinar Lampu Depan Mode Turis (VAG)",desc:"Mengalihkan pola pancaran lampu depan antara LHD dan RHD untuk berkendara ke luar negeri."},vag_hood_warning_mute:{name:"Bonnet Instrumen Terbuka Lonceng Bisu (VAG)",desc:"Menekan bunyi peringatan instrumen yang terus-menerus saat tudung dibuka."},vag_emergency_brake_hazard:{name:"Flasher Bahaya Otomatis Pengereman Darurat (VAG)",desc:"Menyalakan lampu hazard dengan cepat saat berhenti darurat ABS secara paksa."},vag_sunroof_comfort_open:{name:"Logika Fob Kunci Nyaman Miring / Terbuka Sunroof (VAG)",desc:"Mengonfigurasi tindakan menahan tombol jarak jauh untuk memiringkan atau membuka sunroof sepenuhnya."},bmw_ecopro_display_variant:{name:"Penataan Pengukur Cluster Instrumen ECO PRO (BMW)",desc:"Menyesuaikan tema grafis pengukur efisiensi ECO PRO biru."},bmw_volume_bar_hud:{name:"Tampilan Head-Up Hamparan Bilah Tingkat Volume Audio (BMW)",desc:"Menampilkan bilah perubahan volume langsung pada proyeksi HUD."},bmw_anti_dazzle_mirror:{name:"Sensitivitas Peredupan Cermin Anti Silau Elektrokromik (BMW)",desc:"Menyesuaikan ambang sensor foto peredupan kaca spion otomatis."},bmw_camera_pdc_warning_mute:{name:"Penyesuaian Kecepatan Cut-off Kecepatan Tampilan PDC & Sekitar (BMW)",desc:"Menyesuaikan ambang batas kecepatan kendaraan saat kamera parkir dimatikan."},