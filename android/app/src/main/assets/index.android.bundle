strian_siren_mute:{name:"\u0643\u062a\u0645 \u0635\u0648\u062a \u0635\u0641\u0627\u0631\u0629 \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0645\u0646\u062e\u0641\u0636 \u0627\u0644\u0633\u0631\u0639\u0629 \u0645\u0646 AVAS EV",desc:"\u064a\u0643\u062a\u0645 \u0635\u0641\u0627\u0631\u0629 \u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0645\u0646\u062e\u0641\u0636 \u0627\u0644\u0633\u0631\u0639\u0629 \u0623\u0642\u0644 \u0645\u0646 30 \u0643\u0645/\u0633\u0627\u0639\u0629."},chery_isa_overspeed_chime_mute:{name:"\u0625\u0644\u063a\u0627\u0621 \u062a\u0646\u0634\u064a\u0637 \u0646\u063a\u0645\u0629 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0632\u0627\u0626\u062f\u0629 ISA",desc:"\u062a\u0639\u0637\u064a\u0644 \u0635\u0641\u0627\u0631\u0629 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0627\u0644\u0645\u0633\u062a\u0645\u0631\u0629 \u0645\u0646 \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0632\u0627\u0626\u062f\u0629 \u0627\u0644\u0628\u0627\u0644\u063a\u0629 80/120 \u0643\u0645/\u0633\u0627\u0639\u0629 \u0641\u064a \u0637\u0631\u0627\u0632\u0627\u062a Tiggo/MG."},mg_ev_battery_preconditioning_toggle:{name:"\u0628\u0637\u0627\u0631\u064a\u0629 EV \u0633\u0631\u064a\u0639\u0629 \u0627\u0644\u0634\u062d\u0646\u060c \u0645\u0641\u062a\u0627\u062d \u064a\u062f\u0648\u064a \u0644\u0644\u062a\u0633\u062e\u064a\u0646 \u0627\u0644\u0645\u0633\u0628\u0642",desc:"\u062a\u0645\u0643\u064a\u0646 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062a\u0633\u062e\u064a\u0646 \u0627\u0644\u0645\u0633\u0628\u0642 \u0644\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u064a\u062f\u0648\u064a\u064b\u0627 \u0642\u0628\u0644 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0633\u0631\u064a\u0639 \u0628\u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u0645\u0631."},chery_dms_fatigue_camera_mute:{name:"\u062a\u0642\u0644\u064a\u0644 \u062d\u0633\u0627\u0633\u064a\u0629 \u0643\u0627\u0645\u064a\u0631\u0627 \u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0633\u0627\u0626\u0642 (DMS).",desc:"\u064a\u0642\u0644\u0644 \u0645\u0646 \u062a\u062d\u0630\u064a\u0631\u0627\u062a \u0625\u062c\u0647\u0627\u062f \u062a\u062a\u0628\u0639 \u0627\u0644\u0639\u064a\u0646 \u0627\u0644\u0645\u0641\u0631\u0637\u0629 \u0627\u0644\u062d\u0633\u0627\u0633\u064a\u0629 \u0639\u0644\u0649 \u0639\u0645\u0648\u062f \u0627\u0644\u062a\u0648\u062c\u064a\u0647."},honda_walk_away_auto_lock:{name:"\u0627\u0644\u0645\u0634\u064a \u0628\u0639\u064a\u062f\u0627 \u0642\u0641\u0644 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a",desc:"\u064a\u062a\u0645 \u0642\u0641\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f\u0645\u0627 \u064a\u0628\u062a\u0639\u062f \u0627\u0644\u0633\u0627\u0626\u0642 \u0645\u0633\u0627\u0641\u0629 \u0645\u062a\u0631\u064a\u0646 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0633\u0644\u0633\u0644\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d."},subaru_avh_auto_hold_memory:{name:"\u0648\u0636\u0639 \u0630\u0627\u0643\u0631\u0629 \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a (AVH).",desc:"\u064a\u062a\u0630\u0643\u0631 \u062d\u0627\u0644\u0629 \u062a\u0634\u063a\u064a\u0644/\u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0641\u0631\u0627\u0645\u0644 AVH \u0639\u0628\u0631 \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0625\u0634\u0639\u0627\u0644."},volvo_start_stop_default_off:{name:"\u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a - \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0644\u0646\u0638\u0627\u0645 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 Start-Stop \u0639\u0644\u0649 OFF \u0639\u0646\u062f \u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},volvo_polestar_digital_theme:{name:"Polestar \u0627\u0644\u0623\u0632\u0631\u0642 \u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0643\u062a\u0644\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629",desc:"\u064a\u0641\u062a\u062d \u0633\u0645\u0629 \u0627\u0644\u0645\u0642\u064a\u0627\u0633 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a \u0627\u0644\u0623\u0632\u0631\u0642 \u0627\u0644\u0645\u0645\u064a\u0632 \u0644\u0640 Polestar \u0641\u064a \u0634\u0627\u0634\u0629 \u0639\u0631\u0636 \u0633\u0627\u0626\u0642 \u0641\u0648\u0644\u0641\u0648."},vag_virtual_cockpit_r_theme:{name:"\u0633\u0645\u0627\u062a \u0623\u062f\u0627\u0621 \u0642\u0645\u0631\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 R/S/Cupra",desc:"\u064a\u0641\u062a\u062d \u0645\u0648\u0636\u0648\u0639\u0627\u062a \u0623\u062f\u0627\u0621 \u0645\u0642\u064a\u0627\u0633 \u0633\u0631\u0639\u0629 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u0645\u0631\u0643\u0632\u064a R-Line \u0648S-Line \u0648Cupra \u0641\u064a \u0642\u0645\u0631\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629."},vag_sound_symposer_mute:{name:"\u0628\u0631\u0646\u0627\u0645\u062c Sound Symposer \u0644\u0625\u0644\u063a\u0627\u0621 \u062a\u0646\u0634\u064a\u0637 \u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0648\u0647\u0645\u064a",desc:"\u064a\u0642\u0648\u0645 \u0628\u0625\u0644\u063a\u0627\u0621 \u062a\u0646\u0634\u064a\u0637 \u0645\u0648\u0644\u062f \u0635\u0648\u062a \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0648\u0647\u0645\u064a \u0644\u0645\u0643\u0628\u0631 \u0635\u0648\u062a \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0639\u0627\u062f\u0645 \u0646\u0642\u064a\u0629."},vag_wireless_carplay_enable:{name:"\u0627\u0644\u062a\u0646\u0634\u064a\u0637 \u0627\u0644\u0644\u0627\u0633\u0644\u0643\u064a \u0644\u0640 Apple CarPlay \u0648Android Auto",desc:"\u062a\u0645\u0643\u064a\u0646 \u0627\u062a\u0635\u0627\u0644 Wi-Fi \u0627\u0644\u0644\u0627\u0633\u0644\u0643\u064a \u0628\u062a\u0631\u062f\u062f 5 \u062c\u064a\u062c\u0627\u0647\u0631\u062a\u0632 \u0645\u0646 Apple CarPlay \u0648Android Auto \u0639\u0644\u0649 \u0648\u062d\u062f\u0627\u062a MIB2.5/MIB3."},vag_offroad_telemetry_menu:{name:"MIB \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0644\u0644\u0637\u0631\u0642 \u0627\u0644\u0648\u0639\u0631\u0629 \u0648\u0639\u0631\u0636 \u0627\u0644\u0645\u0642\u064a\u0627\u0633",desc:"\u064a\u0639\u0631\u0636 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0648\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0632\u064a\u062a \u0648\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0628\u0631\u064a\u062f \u0648\u0645\u0642\u0627\u064a\u064a\u0633 \u0627\u0644\u0627\u0631\u062a\u0641\u0627\u0639 \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 MIB."},vag_easy_entry_driver_seat:{name:"\u0646\u0638\u0627\u0645 \u062f\u062e\u0648\u0644 \u0622\u0644\u064a \u0633\u0647\u0644 \u0644\u0644\u0645\u0642\u0639\u062f \u0627\u0644\u062e\u0644\u0641\u064a",desc:"\u064a\u062d\u0631\u0643 \u0645\u0642\u0639\u062f \u0627\u0644\u0633\u0627\u0626\u0642 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0625\u0644\u0649 \u0627\u0644\u062e\u0644\u0641 \u0628\u0645\u0642\u062f\u0627\u0631 5 \u0633\u0645 \u0639\u0646\u062f \u0641\u062a\u062d \u0627\u0644\u0628\u0627\u0628 \u0644\u0