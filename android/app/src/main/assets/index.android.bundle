3c3\u03b7, \u03ac\u03c1\u03b8\u03c1\u03c9\u03c3\u03b7 \u03c4\u03c1\u03bf\u03c7\u03bf\u03cd \u03ba\u03b1\u03b9 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03c8\u03c5\u03ba\u03c4\u03b9\u03ba\u03bf\u03cd \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03bc\u03b5\u03c4\u03ac\u03b4\u03bf\u03c3\u03b7\u03c2 \u03c3\u03c4\u03bf Uconnect."},stellantis_peugeot_icockpit_3d_color_schemes:{name:"\u03a0\u03b1\u03bb\u03ad\u03c4\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03bc\u03ad\u03bd\u03c9\u03bd \u03c7\u03c1\u03c9\u03bc\u03ac\u03c4\u03c9\u03bd Peugeot 3D i-Cockpit",desc:"\u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c7\u03c1\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b8\u03ad\u03bc\u03b1\u03c4\u03b1 \u03c7\u03b1\u03bb\u03ba\u03bf\u03cd \u03ba\u03b1\u03b9 \u03c7\u03b1\u03bb\u03b1\u03b6\u03af\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03c1\u03b9\u03c3\u03b4\u03b9\u03ac\u03c3\u03c4\u03b1\u03c4\u03bf \u03bf\u03bb\u03bf\u03b3\u03c1\u03b1\u03c6\u03b9\u03ba\u03cc \u03c8\u03b7\u03c6\u03b9\u03b1\u03ba\u03cc \u03c4\u03b1\u03bc\u03c0\u03bb\u03cc \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd."},gm_super_cruise_follow_distance_adjust:{name:"Super Cruise Hands-Free \u039c\u03b5\u03c4\u03b1\u03c4\u03cc\u03c0\u03b9\u03c3\u03b7 \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03b5\u03af",desc:"\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03b9 \u03c4\u03bf \u03ba\u03b5\u03bd\u03cc \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b1\u03c5\u03c4\u03cc\u03bd\u03bf\u03bc\u03b7 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf\u03bd \u03b1\u03c5\u03c4\u03bf\u03ba\u03b9\u03bd\u03b7\u03c4\u03cc\u03b4\u03c1\u03bf\u03bc\u03bf Super Cruise."},gm_instrument_hud_calibration_reset:{name:"\u0392\u03b1\u03b8\u03bc\u03bf\u03bd\u03cc\u03bc\u03b7\u03c3\u03b7 \u03b8\u03ad\u03c3\u03b7\u03c2 & \u03ba\u03bb\u03af\u03c3\u03b7\u03c2 \u03bc\u03b7\u03b4\u03b5\u03bd\u03b9\u03ba\u03bf\u03cd \u03c3\u03b7\u03bc\u03b5\u03af\u03bf\u03c5 Head-Up Display (HUD).",desc:"\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03b7 \u03b3\u03c9\u03bd\u03af\u03b1 \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ad\u03b1 HUD \u03c4\u03bf\u03c5 \u03c0\u03b1\u03c1\u03bc\u03c0\u03c1\u03af\u03b6 \u03ba\u03b1\u03b9 \u03c4\u03b7 \u03c3\u03c4\u03bf\u03af\u03c7\u03b9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03bf\u03c1\u03af\u03b6\u03bf\u03bd\u03c4\u03b1 \u03bc\u03b7\u03b4\u03b5\u03bd\u03b9\u03ba\u03bf\u03cd \u03b5\u03c0\u03b9\u03c0\u03ad\u03b4\u03bf\u03c5."},gm_afm_v8_cylinder_lock_no_v4_drop:{name:"\u03a0\u03b1\u03c1\u03ac\u03ba\u03b1\u03bc\u03c8\u03b7 \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03ba\u03c5\u03bb\u03af\u03bd\u03b4\u03c1\u03bf\u03c5 AFM / DFM (\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 Always V8)",desc:"\u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7\u03bd \u03c0\u03c4\u03ce\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03c5\u03bb\u03af\u03bd\u03b4\u03c1\u03bf\u03c5 Active Fuel Management \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03b5\u03b9 \u03bd\u03b1 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bf \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03c3\u03b5 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 8 \u03ba\u03c5\u03bb\u03af\u03bd\u03b4\u03c1\u03c9\u03bd."},dodge_ram_truck_fog_lights_with_high_beam:{name:"RAM \u03a0\u03c1\u03bf\u03b2\u03bf\u03bb\u03b5\u03af\u03c2 \u03bf\u03bc\u03af\u03c7\u03bb\u03b7\u03c2 \u03c6\u03bf\u03c1\u03c4\u03b7\u03b3\u03bf\u03cd \u03bc\u03b5 \u03bc\u03b5\u03b3\u03ac\u03bb\u03b7 \u03c3\u03ba\u03ac\u03bb\u03b1 (\u03a3\u03c5\u03bd\u03b4\u03c5\u03b1\u03c3\u03bc\u03cc\u03c2 \u03c5\u03c8\u03b7\u03bb\u03ae\u03c2-\u03c7\u03b1\u03bc\u03b7\u03bb\u03ae\u03c2 \u03bf\u03bc\u03af\u03c7\u03bb\u03b7\u03c2)",desc:"\u0391\u03c0\u03bf\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03c6\u03ce\u03c4\u03c9\u03bd \u03bf\u03bc\u03af\u03c7\u03bb\u03b7\u03c2 \u03cc\u03c4\u03b1\u03bd \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03bc\u03b5\u03b3\u03ac\u03bb\u03b7\u03c2 \u03c3\u03ba\u03ac\u03bb\u03b1\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03b1."},toyota_keyless_window_down:{name:"\u0391\u03bd\u03bf\u03b9\u03c7\u03c4\u03cc \u03c0\u03b1\u03c1\u03ac\u03b8\u03c5\u03c1\u03bf \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba \u03c4\u03b7\u03c2 Toyota (\u039e\u03b5\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03bc\u03b5 \u03b1\u03bd\u03b1\u03bc\u03bf\u03bd\u03ae)",desc:"\u039a\u03b1\u03c4\u03b5\u03b2\u03ac\u03b6\u03b5\u03b9 \u03cc\u03bb\u03b1 \u03c4\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ac \u03c0\u03b1\u03c1\u03ac\u03b8\u03c5\u03c1\u03b1 \u03cc\u03c4\u03b1\u03bd \u03ba\u03c1\u03b1\u03c4\u03ac\u03c4\u03b5 \u03c0\u03b1\u03c4\u03b7\u03bc\u03ad\u03bd\u03bf \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af UNLOCK \u03c3\u03c4\u03bf \u03c4\u03b7\u03bb\u03b5\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03ae\u03c1\u03b9\u03bf."},toyota_seatbelt_chime_disable:{name:"\u03a3\u03af\u03b3\u03b1\u03c3\u03b7 \u03c3\u03c5\u03bd\u03b1\u03b3\u03b5\u03c1\u03bc\u03bf\u03cd \u03b6\u03ce\u03bd\u03b7\u03c2 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03b1\u03c2 \u03b5\u03c0\u03b9\u03b2\u03b1\u03c4\u03ce\u03bd Toyota (\u03a3\u03c4\u03ac\u03b8\u03bc\u03b5\u03c5\u03c3\u03b7/\u0395\u03ba\u03c4\u03cc\u03c2 \u03b4\u03c1\u03cc\u03bc\u03bf\u03c5)",desc:"\u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b7\u03bd \u03b5\u03c0\u03af\u03bc\u03bf\u03bd\u03b7 \u03b1\u03ba\u03bf\u03c5\u03c3\u03c4\u03b9\u0