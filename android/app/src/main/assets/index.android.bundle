lth Fighter Night Driving Minimalist Cluster Mode",desc:"Turns off all cluster lights except speedometer for pitch-black night driving."},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts."},merc_agility_manual_mode_unlock:{name:"Agility & Manual Transmission Mode",desc:"Enables hidden Agility and True Manual driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency during hard emergency braking."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / E