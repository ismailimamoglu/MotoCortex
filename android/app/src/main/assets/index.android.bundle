03c1\u03b1\u03c3\u03af\u03b1 \u03ba\u03b1\u03cd\u03c3\u03b7\u03c2, \u03ba\u03af\u03bd\u03b4\u03c5\u03bd\u03bf\u03c2 \u03ba\u03c1\u03bf\u03cd\u03c3\u03b7\u03c2).",causesTitle:"\u03a0\u03b9\u03b8\u03b1\u03bd\u03ad\u03c2 \u03b1\u03b9\u03c4\u03af\u03b5\u03c2:",actionTitle:"\u03a0\u03c1\u03bf\u03c4\u03b5\u03b9\u03bd\u03cc\u03bc\u03b5\u03bd\u03b7 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1:",causeNormal:"System operates within ideal range (-5% to +5%). No faults.",actionNormal:"\u03a3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c4\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae \u03c3\u03c5\u03bd\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7.",causeVacuumLeak:"\u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ad\u03c2 \u03ba\u03b5\u03bd\u03bf\u03cd, \u03c3\u03c7\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03b9 \u03c3\u03c9\u03bb\u03ae\u03bd\u03b5\u03c2 \u03ae \u03c6\u03bb\u03ac\u03bd\u03c4\u03b6\u03b1 \u03c0\u03bf\u03bb\u03bb\u03b1\u03c0\u03bb\u03ae\u03c2 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2",causeDirtyMaf:"\u0392\u03c1\u03ce\u03bc\u03b9\u03ba\u03bf \u03ae \u03b5\u03bb\u03b1\u03c4\u03c4\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 MAF (Mass Air Flow).",causeLowFuelPressure:"\u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03c0\u03af\u03b5\u03c3\u03b7 \u03b1\u03bd\u03c4\u03bb\u03af\u03b1\u03c2 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u03ae \u03b2\u03bf\u03c5\u03bb\u03c9\u03bc\u03ad\u03bd\u03bf \u03c6\u03af\u03bb\u03c4\u03c1\u03bf \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5",causeCloggedInjectors:"\u0392\u03bf\u03c5\u03bb\u03c9\u03bc\u03ad\u03bd\u03b1 \u03ae \u03b2\u03c1\u03ce\u03bc\u03b9\u03ba\u03b1 \u03bc\u03c0\u03b5\u03ba \u03c8\u03b5\u03ba\u03b1\u03c3\u03bc\u03bf\u03cd \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5",actionCriticalLean:"\u03a0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae \u03ba\u03b1\u03c0\u03bd\u03bf\u03cd \u03b3\u03b9\u03b1 \u03b4\u03b9\u03b1\u03c1\u03c1\u03bf\u03ad\u03c2 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03b8\u03b1\u03c1\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 MAF.",causeMinorVacuumLeak:"\u039c\u03b9\u03ba\u03c1\u03ae \u03b4\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae \u03b1\u03ad\u03c1\u03b1 \u03ae \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1\u03c2 \u03b3\u03ae\u03c1\u03b1\u03bd\u03c3\u03b7\u03c2 O2",actionMildLean:"\u0395\u03bb\u03ad\u03b3\u03be\u03c4\u03b5 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b1 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03cd O2 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03c3\u03c9\u03bb\u03ae\u03bd\u03b5\u03c2 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2.",causeLeakingInjector:"\u0394\u03b9\u03b1\u03c1\u03c1\u03bf\u03ae/\u03b1\u03bd\u03bf\u03b9\u03c7\u03c4\u03cc \u03bc\u03c0\u03b5\u03ba \u03c8\u03b5\u03ba\u03b1\u03c3\u03bc\u03bf\u03cd \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5",causeStuckEvapPurgeVal:"\u0392\u03b1\u03bb\u03b2\u03af\u03b4\u03b1 \u03b5\u03be\u03b1\u03ad\u03c1\u03c9\u03c3\u03b7\u03c2 \u03b4\u03bf\u03c7\u03b5\u03af\u03bf\u03c5 EVAP \u03c0\u03bf\u03c5 \u03ad\u03c7\u03b5\u03b9 \u03ba\u03bf\u03bb\u03bb\u03ae\u03c3\u03b5\u03b9 \u03b1\u03bd\u03bf\u03b9\u03c7\u03c4\u03ae",causeDirtyAirFilter:"\u03a3\u03bf\u03b2\u03b1\u03c1\u03ac \u03b2\u03c1\u03ce\u03bc\u03b9\u03ba\u03bf \u03c6\u03af\u03bb\u03c4\u03c1\u03bf \u03b1\u03ad\u03c1\u03b1 (\u03c0\u03b5\u03c1\u03b9\u03bf\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae)",causeHighFuelPressure:"\u03a5\u03c8\u03b7\u03bb\u03ae \u03c0\u03af\u03b5\u03c3\u03b7 \u03c1\u03ac\u03b3\u03b1\u03c2 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 (\u03b5\u03bb\u03b1\u03c4\u03c4\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c2 \u03c1\u03c5\u03b8\u03bc\u03b9\u03c3\u03c4\u03a