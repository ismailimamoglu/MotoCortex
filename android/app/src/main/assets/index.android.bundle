u043e\u0432\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f (\u041c\u043e\u0432\u0430 \u0442\u0430 \u0434\u043e\u0437\u0432\u043e\u043b\u0438)"},disclaimer:"\u0423\u0441\u0456 \u043d\u0430\u0437\u0432\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0456\u0432, \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0438 \u0442\u0430 \u0431\u0440\u0435\u043d\u0434\u0438 \u0454 \u0432\u043b\u0430\u0441\u043d\u0456\u0441\u0442\u044e \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0445 \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0456\u0432. \u0423\u0441\u0456 \u043d\u0430\u0437\u0432\u0438 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0439, \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0456\u0432 \u0456 \u043f\u043e\u0441\u043b\u0443\u0433, \u044f\u043a\u0456 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0432 \u0446\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0456, \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0456 \u043b\u0438\u0448\u0435 \u0434\u043b\u044f \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0446\u0438\u0445 \u043d\u0430\u0437\u0432, \u043b\u043e\u0433\u043e\u0442\u0438\u043f\u0456\u0432 \u0456 \u0431\u0440\u0435\u043d\u0434\u0456\u0432 \u043d\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u0454 \u0436\u043e\u0434\u043d\u043e\u0457 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438 \u0447\u0438 \u0441\u043f\u043e\u043d\u0441\u043e\u0440\u0441\u0442\u0432\u0430.",hiddenFeatures:{title:"\u041f\u0420\u0418\u0425\u041e\u0412\u0410\u041d\u0406 \u0424\u0423\u041d\u041a\u0426\u0406\u0407",btnLabel:"\u0420\u041e\u0417\u0411\u041b\u041e\u041a\u0423\u0412\u0410\u0422\u0418 \u041f\u0420\u0418\u0425\u041e\u0412\u0410\u041d\u0406 \u0424\u0423\u041d\u041a\u0426\u0406\u0407",unsupported:"\u0426\u0435\u0439 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 OBD2 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0456\u0439.",unsupportedDesc:"\u041f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0438\u0439 ELM327 v2.1 \u0430\u0431\u043e \u0432\u0438\u0449\u0435. \u041a\u043b\u043e\u043d\u0438 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c\u0441\u044f.",notConnected:"\u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0456\u0442\u044c\u0441\u044f \u0434\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f.",notConnectedDesc:"\u041f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 OBD2 \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u0431\u0443\u0442\u0438 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439.",warning:"\u0426\u0456 \u0437\u043c\u0456\u043d\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u043f\u043b\u0438\u043d\u0443\u0442\u0438 \u043d\u0430 \u0433\u0430\u0440\u0430\u043d\u0442\u0456\u044e \u0432\u0430\u0448\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f.",confirmTitle:"\u041f\u043e\u0442\u0440\u0456\u0431\u043d\u0435 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f",confirmMsg:"\u0417\u043c\u0456\u043d\u0430 \u0446\u0456\u0454\u0457 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0415\u0411\u0423. \u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?",confirmOk:"\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438",confirmCancel:"\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438",categoryLighting:"\u041e\u0421\u0412\u0406\u0422\u041b\u0415\u041d\u041d\u042f",categorySound:"\u0417\u0412\u0423\u041a \u0406 \u041f\u041e\u041f\u0415\u0420\u0415\u0414\u0416\u0415\u041d\u041d\u042f",categoryDisplay:"\u041f\u0420\u0418\u041b\u0410\u0414\u041e\u0412\u0410 \u041f\u0410\u041d\u0415\u041b\u042c",categoryDriving:"\u0412\u041e\u0414\u0406\u041d\u041d\u042f",featureDrl:"\u0414\u0435\u043d\u043d\u0456 \u0445\u043e\u0434\u043e\u0432\u0456 \u0432\u043e\u0433\u043d\u0456 (\u0414\u0425\u0412)",featureRearFog:"Override \u0437\u0430\u0434\u043d\u0456\u0445 \u043f\u0440\u043e\u0442\u0438\u0442\u0443\u043c\u0430\u043d\u043d\u0438\u0445 \u0444\u0430\u0440",featureDoorChime:"\u0412\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u0437\u0432\u0443\u043a \u0434\u0432\u0435\u0440\u0435\u0439",featureParkingAlert:"\u0417\u0432\u0443\u043a\u043e\u0432\u0430 \u0441\u0438\u0433\u043d\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f \u0440\u0443\u0447\u043d\u043e\u0433\u043e \u0433\u0430\u043b\u044c\u043c\u0430",featureRpmWarning:"\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f \u043b\u0456\u043c\u0456\u0442\u0443 \u043e\u0431\u0435\u0440\u0442\u0456\u0432",featureFuelSensitivity:"\u0427\u0443\u0442\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043f\u0430\u043b\u0438\u0432\u0430",featureStartStop:"Start-Stop \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0438\u0439",featureSportMemory:"\u041f\u0430\u043c'\u044f\u0442\u044c \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0443",enabled:"\u0423\u0412\u0406\u041c\u041a\u041d\u0415\u041d\u041e",disabled:"\u0412\u0418\u041c\u041a\u041d\u0415\u041d\u041e",writeSuccess:"\u0424\u0443\u043d\u043a\u0446\u0456\u044e \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043e.",writeError:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0437\u0430\u043f\u0438\u0441\u0443. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u043d\u043e\u0432\u0443.",simulationBanner:"\u0420\u0415\u0416\u0418\u041c \u0421\u0418\u041c\u0423\u041b\u042f\u0426\u0406\u0407 \u2014 \u0420\u0435\u0430\u043b\u044c\u043d\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0434\u043e \u0415\u0411\u0423 \u0449\u0435 \u043d\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439",closeBtn:"\u0417\u0410\u041a\u0420\u0418\u0422\u0418",unsupportedOk:"OK",disclaimerTitle:"\u0412\u0406\u0414\u041c\u041e\u0412\u0410 \u0412\u0406\u0414 \u0412\u0406\u0414\u041f\u041e\u0412\u0406\u0414\u0410\u041b\u042c\u041d\u041e\u0421\u0422\u0406",disclaimerFeature:"\u041e\u0441\u043e\u0431\u043b\u0438\u0432\u0456\u0441\u0442\u044c",disclaimerBody:"\u0417\u043c\u0456\u043d\u0430 \u0446\u0456\u0454\u0457 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0437\u0430\u0432\u043e\u0434\u0441\u044c\u043a\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0442\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f ECU. \u0423\u0432\u0430\u0436\u043d\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456 \u0440\u0438\u0437\u0438\u043a\u0438:\n\n\u2022 \u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0435 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u043e\u0436\u0435 \u043f\u0440\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0434\u043e \u0432\u0442\u0440\u0430\u0442\u0438 \u0433\u0430\u0440\u0430\u043d\u0442\u0456\u0457 \u043d\u0430 \u0432\u0430\u0448 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c.\n\u2022 \u0414\u0435\u044f\u043a\u0456 \u0437\u043c\u0456\u043d\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0441\u043f\u0440\u0438\u0447\u0438\u043d\u0438\u0442\u0438 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u0456 \u0437\u0431\u043e\u0457 \u0430\u0431\u043e \u043d\u0435\u0441\u043f\u043e\u0434\u0456\u0432\u0430\u043d\u0456 \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u0456 \u043f\u043e\u043c\u0438\u043b\u043a\u0438.\n\u2022 \u0425\u043e\u0447\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u044f \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043e\u0431\u043e\u0440\u043e\u0442\u043d\u043e\u044e, \u0434\u0435\u044f\u043a\u0456 \u043c\u043e\u0434\u0443\u043b\u0456 ECU \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043c\u0430\u0433\u0430\u0442\u0438 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0432\u043e\u0434\u0441\u044c\u043a\u0438\u0445 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c.\n\u2022 \u041a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u043d\u0435\u0441\u0435 \u0432\u0438\u043a\u043b\u044e\u0447\u043d\u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u043b\u044c\u043d\u0456\u0441\u0442\u044c \u0437\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u044c\u043d\u0456 \u0430\u0431\u043e \u043d\u0435\u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u044c\u043d\u0456 \u0437\u0431\u0438\u0442\u043a\u0438, \u0441\u043f\u0440\u0438\u0447\u0438\u043d\u0435\u043d\u0456 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f\u043c \u0446\u0456\u0454\u0457 \u0444\u0443\u043d\u043a\u0446\u0456\u0457.\n\u2022 Cortex OBD2 Diagnostic Scanner \u043d\u0435 \u043d\u0435\u0441\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0456 \u0437\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0443 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u0430\u0431\u043e \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043d\u044f, \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u043d\u0456 \u0446\u0438\u043c\u0438 \u0437\u043c\u0456\u043d\u0430\u043c\u0438.\n\n\u0412\u0438 \u043f\u043e\u0432\u0438\u043d\u043d\u0456 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438, \u0449\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b\u0438 \u0442\u0430 \u0437\u0440\u043e\u0437\u0443\u043c\u0456\u043b\u0438 \u0446\u0435 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f.",checkboxTitle:"\u041f\u041e\u0422\u0420\u0406\u0411\u041d\u0415 \u041f\u0406\u0414\u0422\u0412\u0415\u0420\u0414\u0416\u0415\u041d\u041d\u042f",check1:"\u042f \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0432 \u0446\u0435 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u0440\u043e\u0437\u0443\u043c\u0456\u044e, \u0449\u043e \u0446\u0435 \u043c\u043e\u0436\u0435 \u0432\u043f\u043b\u0438\u043d\u0443\u0442\u0438 \u043d\u0430 \u0433\u0430\u0440\u0430\u043d\u0442\u0456\u044e \u043d\u0430 \u043c\u0456\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c.",check2:"\u042f \u0432\u0438\u0437\u043d\u0430\u044e, \u0449\u043e \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0438\u0439 \u0441\u043a\u0430\u043d\u0435\u0440 Cortex OBD2 \u043d\u0435 \u043d\u0435\u0441\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0456 \u0437\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0456 \u0447\u0438 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043d\u044f, \u0441\u043f\u0440\u0438\u0447\u0438\u043d\u0435\u043d\u0456 \u0446\u0456\u0454\u044e \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0454\u044e.",check3:"\u042f \u0445\u043e\u0447\u0443 \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0446\u044e \u0437\u043c\u0456\u043d\u0443 \u0441\u0432\u0456\u0434\u043e\u043c\u043e \u0442\u0430 \u0437 \u0432\u043b\u0430\u0441\u043d\u043e\u0457 \u0432\u043e\u043b\u0456, \u043f\u0440\u0438\u0439\u043c\u0430\u044e\u0447\u0438 \u043d\u0430 \u0441\u0435\u0431\u0435 \u0432\u0441\u0456 \u0440\u0438\u0437\u0438\u043a\u0438.",disclaimerCancel:"\u0421\u041a\u0410\u0421\u0423\u0412\u0410\u0422\u0418",disclaimerContinue:"\u041f\u0420\u041e\u0414\u041e\u0412\u0416\u0423\u0419\u0422\u0415",unsupportedTitle:"\u041d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f",unsupportedMsg:"\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 OBD2 \u0449\u0435 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u0446\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u044e.\n\n\u0414\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0443 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0456\u0439 \u043f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u0441\u0443\u043c\u0456\u0441\u043d\u0438\u0439 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 ELM327 v2.1+. \u041a\u043b\u043e\u043d \u0430\u0431\u043e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0456 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438 \u043d\u0435 \u043c\u043e\u0436\u0443\u0442\u044c \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u0442\u0438 \u0446\u0456 \u043a\u043e\u043c\u0430\u043d\u0434\u0438."},disconnectShort:"\u0412\u0406\u0414\u041a\u041b.",obdTerminal:{title:"OBD HEALTH & TERMINAL",terminalTitle:"OBD \u0422\u0415\u0420\u041c\u0406\u041d\u0410\u041b",terminalPlaceholder:"\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0434\u043e ECU (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, 010C, ATRV)",inputPlaceholder:"\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u043a\u043e\u043c\u0430\u043d\u0434\u0443...",sendButton:"\u041d\u0410\u0414\u0406\u0421\u041b\u0410\u0422\u0418",statsTitle:"\