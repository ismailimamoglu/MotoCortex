915\u094b\u0921 \u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090a\u092a\u0930 \u0926\u093e\u0908\u0902 \u0913\u0930 \u0938\u094d\u0915\u0948\u0928 \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902\u0964",scanFailed:"\u0938\u094d\u0915\u0948\u0928 \u0935\u093f\u092b\u0932",errTimeout:"Error: Connection Timeout (TIMEOUT)\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost (CONNECTION_LOST)\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\n(HARDWARE_FATAL_RECOVERY_FAILED)\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error (ERROR_UNABLE_TO_READ)\nECU trouble codes could not be read.",scannedSystems:"\u0938\u094d\u0915\u0948\u0928 \u0915\u0940 \u0917\u0908 \u092a\u094d\u0930\u0923\u093e\u0932\u093f\u092f\u093e\u0901",moduleEngine:"\u0907\u0902\u091c\u0928 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0907\u0915\u093e\u0908 (\u0908\u0938\u0940\u092f\u0942)",moduleAbs:"\u090f\u0902\u091f\u0940-\u0932\u0949\u0915 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e (ABS)",moduleTcm:"\u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 (\u091f\u0940\u0938\u0940\u090f\u092e)",moduleBcm:"\u0936\u093e\u0930\u0940\u0930\u093f\u0915 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 (\u092c\u0940\u0938\u0940\u090f\u092e)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091a\u0947\u0924\u093e\u0935\u0928\u0940",safetyWarningDesc:"\u0907\u0938 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928: \u2022 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u2022 \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u2022 \u0935\u093e\u0939\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0928 \u0915\u0930\u0947\u0902 \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",step1:"\u091a\u0930\u0923 1: \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u092e\u093f\u091f\u093e\u090f\u0901",step1Desc:"\u0938\u092d\u0940 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0926\u094b\u0937 \u0915\u094b\u0921 (\u0921\u0940\u091f\u0940\u0938\u0940) \u0914\u0930 \u091a\u0947\u0915 \u0907\u0902\u091c\u0928 \u0932\u093e\u0907\u091f \u0915\u094b \u0938\u093e\u092b\u093c \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0908\u0902\u0927\u0928 \u091f\u094d\u0930\u093f\u092e \u092e\u093e\u0928 \u0930\u0940\u0938\u0947\u091f \u0915\u0930 \u0926\u093f\u090f \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u0907\u0938 \u090f\u0915\u094d\u0936\u0928 \u0915\u094b \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e!",step2:"\u091a\u0930\u0923 2: \u0908\u0938\u0940\u092f\u0942 \u0939\u093e\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f",step2Desc:"\u0907\u0902\u091c\u0928 \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930 \u092a\u0930 \u090f\u0915 \u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u0930\u0940\u0938\u0947\u091f (\u0939\u093e\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f) \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0939 \u092c\u0948\u091f\u0930\u0940 \u0915\u094b \u0939\u091f\u093e\u0928\u0947 \u0914\u0930 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0928\u0947 \u091c\u0948\u0938\u093e \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0917\u0948\u0930-\u0938\u0939\u093e\u092f\u0915 \u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u0902 \u0905\u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0939\u0948\u0964 \u0907\u0938\u0938\u0947 \u0915\u094b\u0908 \u0928\u0941\u0915\u0938\u093e\u0928 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e.",clearCodes:"\u0915\u094b\u0921 \u0939\u091f\u093e\u090f\u0902",ecuReset:"\u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902",finish:"\u091b\u094b\u0921\u093c\u0947\u0902 (\u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902)",completed:"\u092a\u0942\u0930\u094d\u0923 ",completedDesc:"\u0938\u0947\u0935\u093e \u0938\u0902\u091a\u093e\u0932\u0928 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0942\u0930\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948. \u0906\u092a \u0935\u093e\u0939\u0928 \u0915\u094b \u092a\u0941\u0928\u0903 \u0906\u0930\u0902\u092d \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902.",hardResetDesc:"\u0938\u092d\u0940 \u0938\u0947\u0935\u093e \u0915\u093e\u0930\u094d\u092f \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0942\u0930\u0947 \u0915\u0930 \u0932\u093f\u090f \u0917\u090f \u0939\u0948\u0902. \u2022 \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0938\u093e\u092b\u093c \u0915\u0930 \u0926\u093f\u090f \u0917\u090f \u2022 \u0908\u0902\u0927\u0928 \u091f\u094d\u0930\u093f\u092e\u094d\u0938 \u0930\u0940\u0938\u0947\u091f \u2022 \u0908\u0938\u0940\u092f\u0942 \u0930\u0940\u0938\u0947\u091f \u0906\u092a \u0935\u093e\u0939\u0928 \u0915\u094b \u092a\u0941\u0928\u0903 \u0906\u0930\u0902\u092d \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902."},info:{desc:"\u092a\u0947\u0936\u0947\u0935\u0930 \u092e\u094b\u091f\u0930\u0938\u093e\u0907\u0915\u093f\u0932 \u0914\u0930 \u0935\u093e\u0939\u0928 \u0928\u093f\u0926\u093e\u0928 \u0905\u0928\u0941\u092a\u094d\u0930\u092f\u094b\u0917\u0964 \u0938\u092d\u0940 \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0917\u0924.",upgrade:" \u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u092a\u094d\u0930\u094b \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902",upgradeAlert:"\u0936\u0940\u0918\u094d\u0930 \u092a\u0939\u0941\u0902\u091a ",upgradeAlertDesc:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0935\u093f\u0915\u093e\u0938 \u092e\u0947\u0902 \u0939\u0948\u0964 \u091a\u0942\u0901\u0915\u093f \u0906\u092a \u0939\u092e\u093e\u0930\u0947 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0939\u0948\u0902, \u0938\u092d\u0940 \u092a\u094d\u0930\u094b \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0905\u092c \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0939\u092e\u093e\u0930\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u092e\u0942\u0932\u094d\u092f\u0935\u093e\u0928 \u0939\u0948!",helpGuide:"\u0938\u0939\u093e\u092f\u0924\u093e \u090f\u0935\u0902 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928",language:" \u092d\u093e\u0937\u093e/\u092d\u093e\u0937\u093e/\u092c\u0939\u093e\u0938\u093e",support:"\u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930",supportSubject:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0938\u092e\u0930\u094d\u0925\u0928 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e",thanks:"\u0927\u0928\u094d\u092f\u0935\u093e\u0926!",thanksDesc:"\u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u093e \u0927\u0928\u094d\u092f\u0935\u093e\u0926\u0964 \u0906\u092a \u0939\u092e\u0947\u0902 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0930 \u092a\u0930 \u090f\u0915 \u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u091b\u094b\u0921\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",sections:{live:{title:"\u0932\u093e\u0907\u0935 \u092e\u0949\u0928\u093f\u091f\u0930\u093f\u0902\u0917 \u0938\u0947\u0902\u0938\u0930",content:"\u0906\u092a \u0924\u0941\u0930\u0902\u0924 \u0906\u0930\u092a\u0940\u090f\u092e, \u0917\u0924\u093f, \u0907\u0902\u091c\u0928 \u0924\u093e\u092a\u092e\u093e\u0928, \u0925\u094d\u0930\u0949\u091f\u0932 \u0938\u094d\u0925\u093f\u0924\u093f, \u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c, \u0907\u0902\u091c\u0928 \u0932\u094b\u0921, \u0938\u0947\u0935\u0928 \u0935\u093e\u092f\u0941 \u0924\u093e\u092a\u092e\u093e\u0928 \u0914\u0930 \u092e\u0948\u0928\u093f\u092b\u094b\u0932\u094d\u0921 \u092a\u094d\u0930\u0947\u0936\u0930 (\u090f\u092e\u090f\u092a\u0940) \u0915\u0940 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0917\u0924\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092e\u093e\u0928 \u092a\u094d\u0930\u0924\u093f \u0938\u0947\u0915\u0902\u0921 1-5 \u092c\u093e\u0930 \u0924\u093e\u091c\u093c\u093e \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u091f\u0930\u094d\u092e\u093f\u0928\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u0942\u0921\u0940\u090f\u0938/\u0913\u092c\u0940\u0921\u0940 \u0915\u092e\u093e\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u0939\u0928 \u092e\u0947\u0902 \u0938\u0940\u0927\u0947 \u0939\u0938\u094d\u0924\u0915\u094d\u0937\u0947\u092a \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},expertise:{title:"\u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0914\u0930 \u0935\u093e\u0930\u0902\u091f\u0940",content:"\u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u094b\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0908\u0938\u0940\u092f\u0942 (\u092c\u094d\u0930\u0947\u0928) \u0915\u094b\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0935\u093e\u0939\u0928 \u092a\u0930 \u0926\u0930\u094d\u091c \u0935\u0940\u0906\u0908\u090f\u0928 \u0928\u0902\u092c\u0930 (\u0935\u0940\u0906\u0908\u090f\u0928) \u0914\u0930 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u093e\u0907\u0932\u0947\u091c \u0915\u094b \u0915\u0948\u092a\u094d\u091a\u0930 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924, \u092a\u093f\u091b\u0932\u0940 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u094b\u0902 \u0915\u093e \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u092f\u0939 \u0917\u0923\u0928\u093e \u0915\u0930\u0915\u0947 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u093e\u0939\u0928 \u0928\u0947 \u091a\u0947\u0915 \u0907\u0902\u091c\u0928 \u0932\u093e\u0907\u091f \u0915\u0947 \u0938\u093e\u0925 \u0915\u093f\u0924\u0928\u0940 \u0926\u0942\u0930 \u0924\u0915 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0940 \u0939\u0948\u0964 \u092a\u0930\u093f\u0923\u093e\u092e\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092a\u0940\u0921\u0940\u090f\u092b \u0914\u0930 \u092e\u0948\u0938\u0947\u091c\u093f\u0902\u0917 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092e\u0947\u0902 \u0938\u093e\u091d\u093e \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964"},tests:{title:"\u092c\u0948\u091f\u0930\u0940/\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923",content:"\u092c\u0948\u091f\u0930\u0940 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0947 3 \u091a\u0930\u0923 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902: \u0906\u0930\u093e\u092e, \u0915\u094d\u0930\u0948\u0902\u0915\u093f\u0902\u0917 \u0914\u0930 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u091a\u093e\u0930\u094d\u091c \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0906\u092a\u0915\u0940 \u092c\u0948\u091f\u0930\u0940/\u0928\u093f\u092f\u093e\u092e\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u094b \u092e\u093e\u092a\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u0947 \u092a\u094d\u0930\u094b\u0938\u0947\u0938\u0930 \u0914\u0930 \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0938\u0947 \u0924\u093e\u0924\u094d\u0915\u093e\u0932\u093f\u0915 \u0917\u0924\u093f \u0921\u0947\u091f\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947, 50 \u090f\u092e\u090f\u0938 \u0915\u0940 \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u0947 \u092e\u093e\u0930\u094d\u091c\u093f\u0928 \u0915\u0947 \u0938\u093e\u0925 0-60 \u0914\u0930 0-100 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0924\u094d\u0935\u0930\u0923 \u092e\u093e\u0928 \u092e\u093e\u092a\u0924\u093e \u0939\u0948\u0964"},hardware:{title:"\u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u0924\u093e",content:"ELM327 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 (v1.5) \u0905\u0928\u0941\u0936\u0902\u0938\u093f\u0924 \u0939\u0948\u0964 \u0915\u0941\u091b \u0909\u0928\u094d\u0928\u0924 \u0915\u094b\u0921 v2.1 \u0915\u094d\u0932\u094b\u0928 \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0916\u0930\u093e\u092c \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0935\u093e\u0932\u0947 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u092a\u0930 \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u094b vLinker \u0914\u0930 OBDLink \u091c\u0948\u0938\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0915\u0947 \u0938\u093e\u0925 \u0938\u092c\u0938\u0947 \u0924\u0947\u091c\u093c \u0917\u0924\u093f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964"},warnings:{title:"\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u091a\u0947\u0924\u093e\u0935\u0928\u093f\u092f\u093e\u0901",content:"\u2022 \u092b\u0949\u0932\u094d\u091f \u0915\u094b\u0921 \u0939\u091f\u093e\u0928\u0947 \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092f\u093e \u0908\u0938\u0940\u092f\u0942 \u0930\u0940\u0938\u0947\u091f \u092b\u093c\u0902\u0915\u094d\u0936\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942 \u0914\u0930 \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u2022 \u0915\u093f\u0938\u0940 \u091a\u093e\u0932\u0942 \u0935\u093e\u0939\u0928 \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0928 \u092d\u0947\u091c\u0947\u0902\u0964 \u2022 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0935\u093e\u0939\u0928 \u0938\u092d\u0940 \u0938\u0947\u0902\u0938\u0930\u094b\u0902 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e, \u0905\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0938\u0947\u0902\u0938\u0930 \"--\" \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0947\u0902\u0917\u0947\u0964"},onboarding:{title:"\u0915\u093e\u0928\u0942\u0928\u0940 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u0914\u0930 \u0905\u0928\u093e\u092e \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940",content:"\u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0914\u0930 \u0935\u093e\u0939\u0928 \u0905\u0928\u0941\u0915\u0942\u0932\u0924\u093e \u092e\u0947\u0902 \u0938\u0941\u0927\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f; \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0905\u091c\u094d\u091e\u093e\u0924 \u0907\u0902\u091c\u0928 \u092a\u0948\u0930\u093e\u092e\u0940\u091f\u0930 \u0914\u0930 \u0917\u0932\u0924\u0940 \u0928\u093f\u0926\u093e\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0917\u0932\u0924\u0940 \u0915\u094b\u0921 (\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0914\u0930 \u091a\u0947\u0938\u093f\u0938 \u0928\u0902\u092c\u0930 \u0915\u0947 \u092c\u093f\u0928\u093e) \u0915\u093e \u0939\u092e\u093e\u0930\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0930\u094d\u0935\u0930 \u092a\u0930 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u091c\u093e\u0930\u0940 \u0930\u0916\u0915\u0930 \u0906\u092a \u0907\u0928 \u0905\u0928\u093e\u092e \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092e\u094b\u091f\u0930\u0938\u093e\u0907\u0915\u093f\u0932 \u0915\u0947 \u0908\u0938\u0940\u092f\u0942 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u091a\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0914\u0930 \u0938\u094d\u0925\u093e\u0928 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"},featureCoding:{title:"\u091b\u093f\u092a\u0940 \u0939\u0941\u0908 \u0938\u0941\u0935\u093f\u0927\u093e \u0905\u0928\u0932\u0949\u0915 \u0914\u0930 \u092f\u0942\u0921\u0940\u090f\u0938 \u0915\u094b\u0921\u093f\u0902\u0917",content:"\u0939\u092e\u093e\u0930\u0947 \u0906\u0908\u090f\u0938\u0913 14229 \u092f\u0942\u0921\u0940\u090f\u0938 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0907\u0902\u091c\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u091a\u093e\u0932\u093f\u0924, \u0935\u0940\u090f\u091c\u0940, \u092c\u0940\u090f\u092e\u0921\u092c\u094d\u0932\u094d\u092f\u0942, \u0930\u0947\u0928\u0949\u0932\u094d\u091f \u0914\u0930 \u0921\u0947\u0938\u093f\u092f\u093e \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u090f\u0938 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0932\u093e\u0907\u091f\u094d\u0938, \u0928\u0940\u0921\u0932 \u0938\u094d\u0935\u0940\u092a, \u0939\u0949\u0930\u094d\u0928 \u090f\u0915 \u0932\u0949\u0915, \u0915\u092e\u094d\u092b\u0930\u094d\u091f \u0935\u093f\u0902\u0921\u094b\u091c \u0914\u0930 \u0921\u0940\u0906\u0930\u090f\u0932 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091c\u0948\u0938\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u091f\u0949\u0917\u0932 \u0915\u0930\u0947\u0902\u0964"},multiEcu:{title:"\u092e\u0932\u094d\u091f\u0940-\u0908\u0938\u0940\u092f\u0942 \u0938\u092d\u0940 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0938\u094d\u0915\u0948\u0928\u093f\u0902\u0917",content:"\u090f\u092c\u0940\u090f\u0938, \u090f\u092f\u0930\u092c\u0948\u0917, \u0911\u091f\u094b\u092e\u0948\u091f\u093f\u0915 \u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 (\u091f\u0940\u0938\u0940\u092f\u0942), \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930, \u0915\u094d\u0932\u093e\u0907\u092e\u0947\u091f \u0915\u0902\u091f\u094d\u0930\u094b\u0932 (\u090f\u091a\u0935\u0940\u090f\u0938\u0940), \u0914\u0930 \u092c\u0949\u0921\u0940 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 (\u092c\u0940\u0938\u0940\u090f\u092e) \u0938\u0939\u093f\u0924 \u0907\u0902\u091c\u0928 \u0908\u0938\u0940\u092f\u0942 \u0938\u0947 \u092a\u0930\u0947 \u0917\u0932\u0924\u0940 \u0915\u094b\u0921 \u0915\u094b \u0938\u094d\u0915\u0948\u0928 \u0914\u0930 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902\u0964"},advancedDiagnostics:{title:"\u0921\u0940\u0938\u0940\u091f\u0940 \u0905\u0928\u0941\u0915\u0942\u0932\u0928, \u0921\u0940\u092a\u0940\u090f\u092b \u0914\u0930 \u090f\u091a\u092a\u0940 \u092a\u093e\u0935\u0930 \u0917\u0947\u091c",content:"\u2022 \u0921\u0940\u0938\u0940\u091f\u0940/\u0921\u0940\u090f\u0938\u091c\u0940 \u0915\u094d\u0932\u091a \u0915\u093f\u0938 \u092a\u094d\u0935\u093e\u0907\u0902\u091f \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0914\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0930\u0940\u0938\u0947\u091f\n\u2022 \u0921\u0940\u092a\u0940\u090f\u092b \u0938\u0942\u091f \u0932\u094b\u0921 (%/\u091c\u0940) \u0914\u0930 \u0928\u093f\u0915\u093e\u0938 \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u0928 \u0924\u093e\u092a\u092e\u093e\u0928 \u0928\u093f\u0917\u0930\u093e\u0928\u0940\n\u2022 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u0932\u0918\u0941/\u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0908\u0902\u0927\u0928 \u091f\u094d\u0930\u093f\u092e\u094d\u0938 (\u090f\u0938\u091f\u0940\u090f\u092b\u091f\u0940/\u090f\u0932\u091f\u0940\u090f\u092b\u091f\u0940) \u0914\u0930 \u0932\u0948\u092e\u094d\u092c\u094d\u0921\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923\n\u2022 \u0921\u093e\u092f\u0928\u0947\u092e\u093f\u0915 \u0939\u0949\u0930\u094d\u0938\u092a\u093e\u0935\u0930 (\u090f\u091a\u092a\u0940) \u0914\u0930 \u091f\u0949\u0930\u094d\u0915 (\u090f\u0928\u090f\u092e) \u0932\u093e\u0907\u0935 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0917\u094d\u0930\u093e\u092b\u093c"},demoMode:{title:"\u0921\u0947\u092e\u094b \u092e\u094b\u0921 (\u0938\u093f\u092e\u0941\u0932\u0947\u0936\u0928)",content:"\u092d\u094c\u0924\u093f\u0915 OBD2 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0915\u0947 \u092c\u093f\u0928\u093e \u0910\u092a \u0915\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0909\u0938\u0915\u093e \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0930\u0947\u0902\u0964 \u092f\u0925\u093e\u0930\u094d\u0925\u0935\u093e\u0926\u0940 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0938\u093f\u092e\u0941\u0932\u0947\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0942\u0930\u094d\u0923 \u0915\u0948\u0928-\u092c\u0938 \u0914\u0930 \u092f\u0942\u0921\u0940\u090f\u0938 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0915\u0930\u0947\u0902\u0964"}},reconfigurePermissions:"\u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u0914\u0930 \u0915\u093e\u0928\u0942\u0928\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0947\u0902",shareWithFriend:"\u092e\u093f\u0924\u094d\u0930 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902",shareMessageText:"Cortex OBD2 Diagnostic Scanner \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u0939\u0928 ECU \u092b\u0949\u0932\u094d\u091f \u0915\u094b\u0921 \u0914\u0930 \u0932\u093e\u0907\u0935 \u0938\u0947\u0902\u0938\u0930 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0916\u094b\u091c\u0947\u0902!\n\n\u0905\u092d\u0940 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:" \u2550\u2550\u2550 \u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u2550\u2550\u2550 ",vehicleIdentity:" \u0935\u093e\u0939\u0928 \u0906\u0908\u0921\u0940",vin:"\u091a\u0947\u0938\u093f\u0938 \u0928\u0902\u092c\u0930 (VIN)",odometer:"\u0926\u0942\u0930\u0940 (\u0915\u093f\u092e\u0940)",milDist:"\u0907\u0902\u091c\u0928 \u0932\u093e\u0907\u091f \u091a\u093e\u0932\u0942",distSinceCleared:"\u0924\u094d\u0930\u0941\u091f\u093f \u0938\u093e\u092b\u093c \u0915\u0940 \u0917\u0908",dtcCount:" \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 ({{count}}\u092e\u093e\u0924\u094d\u0930\u093e)",sensorData:" \u0932\u093e\u0907\u0935 \u0938\u0947\u0902\u0938\u0930 \u0921\u0947\u091f\u093e",noData:"\u0921\u0947\u091f\u093e \u092a\u0922\u093c\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932",proApp:"Cortex OBD2 Diagnostic Scanner v7 PRO \u0915\u0947 \u0938\u093e\u0925 \u0938\u094d\u0915\u0948\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964",date:"\u0926\u093f\u0928\u093e\u0902\u0915",vinNotFound:"\u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u091a\u0932\u093e",noDtcs:"\u0915\u094b\u0908 \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0928\u0939\u0940\u0902 - \u0938\u093e\u092b\u093c",speed:"\u0917\u0924\u093f",coolant:"\u0907\u0902\u091c\u0928 \u0915\u093e \u0924\u093e\u092a\u092e\u093e\u0928",throttle:"\u0917\u0948\u0938",engineLoad:"\u0907\u0902\u091c\u0928 \u0932\u094b\u0921",intakeAir:"\u0939\u0935\u093e \u0915\u093e \u0938\u0947\u0935\u0928",manifold:"\u0905\u0928\u0947\u0915 \u0917\u0941\u0928\u093e",voltage:"\u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c",shareMessage:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 OBD2 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u0940 \u091c\u0947\u092c \u0938\u0947 \u0905\u092a\u0928\u0940 \u092e\u094b\u091f\u0930\u0938\u093e\u0907\u0915\u093f\u0932 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u090f\u0902! \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902: https://cortexobd2.app",subtitle:"\u0935\u094d\u092f\u093e\u092a\u0915 \u0938\u0947\u0915\u0947\u0902\u0921-\u0939\u0948\u0902\u0921 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u090f\u0935\u0902 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923",vehicleInfo:"\u0935\u093e\u0939\u0928 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u091f\u093e\u0921\u0947\u091f\u093e",healthScore:"\u0938\u092e\u0917\u094d\u0930 \u0908\u0938\u0940\u092f\u0942 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u094d\u0915\u094b\u0930",dtcSection:"\u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u091f\u094d\u0930\u092c\u0932 \u0915\u094b\u0921 (\u0921\u0940\u091f\u0940\u0938\u0940 \u0911\u0921\u093f\u091f)",telemetrySection:"\u0932\u093e\u0907\u0935 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0914\u0930 \u0938\u0947\u0902\u0938\u0930 \u0938\u094d\u0928\u0948\u092a\u0936\u0949\u091f",maintenanceSection:"Ak\u0131ll\u0131 Garaj \u0938\u0947\u0935\u093e \u0914\u0930 \u0930\u0916\u0930\u0916\u093e\u0935 \u0907\u0924\u093f\u0939\u093e\u0938",aiSection:"\u090f\u0906\u0908 \u0921\u0949\u0915\u094d\u091f\u0930 \u0938\u092e\u0917\u094d\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923",noFaults:"\u0908\u0938\u0940\u092f\u0942 \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f \u092f\u093e \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0926\u094b\u0937 \u0915\u094b\u0921 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",noMaintenance:"Ak\u0131ll\u0131 Garaj \u092e\u0947\u0902 \u0915\u094b\u0908 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0940 \u0917\u0908 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f\u092f\u093e\u0901 \u0928\u0939\u0940\u0902\u0964",disclaimer:"\u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0923: \u092f\u0939 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0924\u0948\u092f\u093e\u0930 \u0915\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0935\u093e\u0939\u0928 \u0905\u0927\u093f\u0917\u094d\u0930\u0939\u0923 \u0938\u0947 \u092a\u0939\u0932\u0947 \u090f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0924\u0915\u0928\u0940\u0936\u093f\u092f\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u092d\u094c\u0924\u093f\u0915 \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0940 \u0938\u093f\u092b\u093e\u0930\u093f\u0936 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",shareTitle:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902"},battery:{title:"\u092c\u0948\u091f\u0930\u0940 \u090f\u0935\u0902 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u093f\u0902\u0917 \u092a\u0930\u0940\u0915\u094d\u0937\u0923",ready:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930.",restingStatus:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942, \u0907\u0902\u091c\u0928 \u092c\u0902\u0926... \u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092a\u0922\u093c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",crankingStatus:"\u0905\u092d\u0940 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0930! (\u092e\u093e\u092a 5 \u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e)",chargingStatus:"\u0907\u0902\u091c\u0928 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0939\u0948... \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092a\u0922\u093c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",doneStatus:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u0942\u0930\u093e \u0939\u0941\u0906!",voltageError:"\u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092a\u0922\u093c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e. \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902.",start:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902",retry:"\u0926\u094b\u092c\u093e\u0930\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902",procedure:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e",steps:{1:"1. \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942, \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u2192 \u0930\u0947\u0938\u094d\u091f \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092e\u093e\u092a\u093e \u091c\u093e\u0924\u093e \u0939\u0948",2:"2. \u091c\u092c \"\u0905\u092d\u0940 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902\" \u0938\u0902\u0926\u0947\u0936 \u092a\u094d\u0930\u0915\u091f \u0939\u094b, \u0924\u094b \u0907\u0902\u091c\u0928 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902\u0964",3:"3. \u0938\u092c\u0938\u0947 \u0915\u092e \u0935\u094b\u0932\u094d\u091f\u0947\u091c 5 \u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",4:"4. \u0907\u0902\u091c\u0928 \u091a\u0932\u0928\u0947 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u091a\u093e\u0930\u094d\u091c/\u0930\u0947\u0917\u0941\u0932\u0947\u091f\u0930 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092e\u093e\u092a\u093e \u091c\u093e\u0924\u093e \u0939\u0948"},warning:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u094b \u0921\u093f\u0938\u094d\u0915\u0928\u0947\u0915\u094d\u091f \u0928 \u0915\u0930\u0947\u0902\u0964",resting:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e",cranking:"\u0917\u093e\u0928",charging:"\u091a\u093e\u0930\u094d\u091c \u0915\u0930\u0928\u093e",instantV:"\u0924\u094d\u0935\u0930\u093f\u0924 \u0935\u094b\u0932\u094d\u091f\u0947\u091c",evaluation:"\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928",verdicts:{full:"\u092c\u0948\u091f\u0930\u0940: \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u091a\u093e\u0930\u094d\u091c",good:"\u092c\u0948\u091f\u0930\u0940: \u0905\u091a\u094d\u091b\u0940 \u0938\u094d\u0925\u093f\u0924\u093f",weak:"\u092c\u0948\u091f\u0930\u0940: \u0915\u092e\u091c\u093c\u094b\u0930 \u0939\u094b\u0928\u093e",empty:"\u092c\u0948\u091f\u0930\u0940: \u0915\u092e\u091c\u093c\u094b\u0930/\u0916\u093c\u0930\u093e\u092c",crankNormal:"\u092a\u094d\u0930\u093e\u0930\u0902\u092d: \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0917\u093f\u0930\u093e\u0935\u091f",crankLow:"\u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0930: \u0915\u092e \u0935\u094b\u0932\u094d\u091f\u0947\u091c",crankCritical:"\u0917\u093e\u0928: \u0917\u0902\u092d\u0940\u0930 \u0917\u093f\u0930\u093e\u0935\u091f",regNormal:"\u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917: \u0930\u0947\u0917\u0941\u0932\u0947\u091f\u0930 \u0938\u093e\u092e\u093e\u0928\u094d\u092f",regLow:"\u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917: \u0915\u092e \u091a\u093e\u0930\u094d\u091c",regHigh:"\u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917: \u0913\u0935\u0930\u091a\u093e\u0930\u094d\u091c",regFail:"\u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917: \u0930\u0947\u0917\u0941\u0932\u0947\u091f\u0930 \u0916\u093c\u0930\u093e\u092c \u0939\u0948"},verdictLocked:"\u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u092c\u0948\u091f\u0930\u0940 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0914\u0930 \u0915\u094d\u0930\u0948\u0902\u0915\u093f\u0902\u0917 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0917\u094d\u0930\u093e\u092b\u093c \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f PRO \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902\u0964"},freeze:{title:"\u092b\u093c\u094d\u0930\u0940\u091c\u093c \u092b\u093c\u094d\u0930\u0947\u092e",snapshot:"\u0935\u093f\u092b\u0932\u0924\u093e \u0938\u094d\u092e\u0943\u0924\u093f",desc:"\u091c\u092c \u091a\u0947\u0915 \u0907\u0902\u091c\u0928 \u0915\u0940 \u0932\u093e\u0907\u091f \u091c\u0932\u0924\u0940 \u0939\u0948 \u0924\u094b \u092f\u0939 \u0907\u0902\u091c\u0928 \u092e\u093e\u092a\u0926\u0902\u0921\u094b\u0902 \u0915\u094b \u092a\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0921\u0947\u091f\u093e \u0926\u094b\u0937 \u0928\u093f\u0926\u093e\u0928 \u092e\u0947\u0902 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",noDtcs:"\u0915\u094b\u0908 \u0917\u0932\u0924\u0940 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948. \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u094b\u0908 \u092b\u093c\u094d\u0930\u0940\u091c\u093c \u092b\u093c\u094d\u0930\u0947\u092e \u0921\u0947\u091f\u093e \u0928 \u0939\u094b.",read:"\u091c\u092e\u0947 \u0939\u0941\u090f \u0921\u0947\u091f\u093e \u092a\u0922\u093c\u0947\u0902",loading:"\u092e\u094b\u0921 02 \u092a\u0930 \u092a\u0942\u091b\u0924\u093e\u091b \u0915\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948...",noData:"\u0915\u094b\u0908 \u091c\u092e\u0947 \u0939\u0941\u090f \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e. \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u093e\u0939\u0928 \u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928 \u0915\u0930\u0947.",error:"\u0921\u0947\u091f\u093e \u092a\u0922\u093c\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f",values:"\u0905\u0938\u092b\u0932\u0924\u093e \u0915\u0947 \u0938\u092e\u092f \u092c\u091a\u093e\u090f \u0917\u090f \u092e\u0942\u0932\u094d\u092f",retry:"\u0926\u094b\u092c\u093e\u0930\u093e \u092a\u0922\u093c\u0947\u0902",techInfo:"\u0924\u0915\u0928\u0940\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940",techDesc:"\u2022 OBD-II \u092e\u094b\u0921 02: \u092b\u093c\u094d\u0930\u0947\u092e \u0921\u0947\u091f\u093e \u092b\u093c\u094d\u0930\u0940\u091c\u093c \u0915\u0930\u0947\u0902 \u2022 \u092a\u0940\u0906\u0908\u0921\u0940 020\u0938\u094000: \u0906\u0930\u092a\u0940\u090f\u092e \u092e\u0947\u0902 \u0916\u0930\u093e\u092c\u0940 \u2022 \u092a\u0940\u0906\u0908\u0921\u0940 020\u0921\u094000: \u0917\u0932\u0924\u0940 \u092a\u0930 \u0917\u0924\u093f \u2022 \u092a\u0940\u0906\u0908\u0921\u0940 020500: \u0916\u0930\u093e\u092c\u0940 \u0915\u0947 \u0938\u092e\u092f \u0920\u0902\u0921\u093e \u092a\u093e\u0928\u0940 \u0915\u093e \u0924\u093e\u092a\u092e\u093e\u0928 \u092f\u0947 \u0921\u0947\u091f\u093e \u0905\u0902\u0924\u093f\u092e \u0917\u0932\u0924\u0940 \u0915\u094b\u0921 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0939\u0948\u0902\u0964 \u091c\u092c \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0938\u093e\u092b\u093c \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092b\u093c\u094d\u0930\u0940\u091c\u093c \u092b\u093c\u094d\u0930\u0947\u092e \u0921\u0947\u091f\u093e \u092d\u0940 \u0938\u093e\u092b\u093c \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923",seconds:"\u0938\u0947\u0915\u0902\u0921",speed:"\u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e",idle:"\u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902 \u0914\u0930 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u094b \u091c\u093e\u090f\u0902\u0964",ready:"\u0924\u0948\u092f\u093e\u0930! \u0935\u093e\u0939\u0928 \u091a\u0932\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902...",readyDesc:"\u0917\u0924\u093f > 0 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0915\u093e\u0909\u0902\u091f\u0930 \u091a\u093e\u0932\u0942 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964",measuring:"\u092e\u093e\u092a \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",done:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u0942\u0930\u093e \u0939\u094b \u0917\u092f\u093e",start:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902",stop:"\u0930\u0941\u0915\u0947\u0902",reset:"\u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0947\u0902",howItWorks:"\u092f\u0939 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948?",howDesc:"1. \"\u092a\u094d\u0930\u093e\u0930\u0902\u092d \u092a\u0930\u0940\u0915\u094d\u0937\u0923\" \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0901 2. \u0935\u093e\u0939\u0928 \u0938\u094d\u0925\u093f\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f (\u0917\u0924\u093f = 0) 3. \u091c\u092c \u0906\u092a \u091a\u0932\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0915\u094d\u0930\u094b\u0928\u094b \u0936\u0941\u0930\u0942 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 4. 60 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0914\u0930 100 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0915\u093e \u0917\u0941\u091c\u0930\u0928\u0947 \u0915\u093e \u0938\u092e\u092f \u0926\u0930\u094d\u091c \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u092f\u0939 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0926\u0947\u0902!",sec:"\u0938\u0947\u0915\u0902\u0921"},dtc:{P0102:"\u0935\u093e\u092f\u0941 \u092a\u094d\u0930\u0935\u093e\u0939 \u0938\u0947\u0902\u0938\u0930 (\u090f\u092e\u090f\u090f\u092b) - \u0915\u092e \u0907\u0928\u092a\u0941\u091f",P0113:"\u0938\u0947\u0935\u0928 \u0935\u093e\u092f\u0941 \u0924\u093e\u092a\u092e\u093e\u0928 \u0938\u0947\u0902\u0938\u0930 - \u0909\u091a\u094d\u091a \u0935\u094b\u0932\u094d\u091f\u0947\u091c",P0171:"\u0908\u0902\u0927\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0915\u092e (\u092c\u0948\u0902\u0915 1)",P0300:"\u092f\u093e\u0926\u0943\u091a\u094d\u091b\u093f\u0915/\u090f\u0915\u093e\u0927\u093f\u0915 \u0938\u093f\u0932\u0947\u0902\u0921\u0930 \u092b\u093e\u092f\u0930\u093f\u0902\u0917 \u0924\u094d\u0930\u0941\u091f\u093f",P0420:"\u0915\u0948\u091f\u0947\u0932\u093f\u091f\u093f\u0915 \u0915\u0928\u094d\u0935\u0930\u094d\u091f\u0930 \u0938\u093f\u0938\u094d\u091f\u092e (\u092c\u09401) - \u0915\u092e \u0926\u0915\u094d\u0937\u0924\u093e",P0700:"\u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0938\u093f\u0938\u094d\u091f\u092e - \u0916\u0930\u093e\u092c\u0940",P0715:"\u091f\u0930\u094d\u092c\u093e\u0907\u0928 \u0938\u094d\u092a\u0940\u0921 \u0938\u0947\u0902\u0938\u0930 - \u0938\u0930\u094d\u0915\u093f\u091f \u0916\u0930\u093e\u092c\u0940",P0560:"\u0938\u093f\u0938\u094d\u091f\u092e \u0935\u094b\u0932\u094d\u091f\u0947\u091c - \u0916\u0930\u093e\u092c\u0940",P0562:"\u0938\u093f\u0938\u094d\u091f\u092e \u0935\u094b\u0932\u094d\u091f\u0947\u091c - \u0915\u092e",U0100:"\u0907\u0902\u091c\u0928 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 (\u0908\u0938\u0940\u090f\u092e/\u092a\u0940\u0938\u0940\u090f\u092e) \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u091f\u0942\u091f \u0917\u092f\u093e",U0121:"\u090f\u0902\u091f\u0940-\u0932\u0949\u0915 \u092c\u094d\u0930\u0947\u0915 \u0938\u093f\u0938\u094d\u091f\u092e (\u090f\u092c\u0940\u090f\u0938) \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u091f\u0942\u091f \u0917\u092f\u093e",C0035:"\u0932\u0947\u092b\u094d\u091f \u092b\u094d\u0930\u0902\u091f \u0935\u094d\u0939\u0940\u0932 \u0938\u094d\u092a\u0940\u0921 \u0938\u0947\u0902\u0938\u0930 \u0938\u0930\u094d\u0915\u093f\u091f \u0915\u0940 \u0916\u0930\u093e\u092c\u0940",B0001:"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092b\u094d\u0930\u0902\u091f \u0938\u094d\u091f\u0947\u091c 1 \u092a\u0930\u093f\u0928\u093f\u092f\u094b\u091c\u0928 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0938\u0930\u094d\u0915\u093f\u091f",P0750:"\u0936\u093f\u092b\u094d\u091f \u0938\u094b\u0932\u0947\u0928\u0949\u0907\u0921 \u090f \u0915\u0940 \u0916\u0930\u093e\u092c\u0940",P0814:"\u091f\u094d\u0930\u093e\u0902\u0938\u092e\u093f\u0936\u0928 \u0930\u0947\u0902\u091c \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0938\u0930\u094d\u0915\u093f\u091f \u0916\u0930\u093e\u092c\u0940",U0140:"\u0936\u093e\u0930\u0940\u0930\u093f\u0915 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 (\u092c\u0940\u0938\u0940\u090f\u092e) \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u092a\u0930\u094d\u0915 \u091f\u0942\u091f \u0917\u092f\u093e",C0040:"\u0926\u093e\u092f\u093e\u0902 \u092b\u094d\u0930\u0902\u091f \u0935\u094d\u0939\u0940\u0932 \u0938\u094d\u092a\u0940\u0921 \u0938\u0947\u0902\u0938\u0930 \u0938\u0930\u094d\u0915\u093f\u091f \u0916\u0930\u093e\u092c\u0940",C0110:"\u090f\u092c\u0940\u090f\u0938 \u092a\u0902\u092a \u092e\u094b\u