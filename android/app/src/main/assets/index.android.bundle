8\u093f\u0915 \u0926\u094b\u0937 \u0915\u094b\u0921 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",noMaintenance:"Ak\u0131ll\u0131 Garaj \u092e\u0947\u0902 \u0915\u094b\u0908 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0940 \u0917\u0908 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f\u092f\u093e\u0901 \u0928\u0939\u0940\u0902\u0964",disclaimer:"\u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0923: \u092f\u0939 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0924\u0948\u092f\u093e\u0930 \u0915\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0935\u093e\u0939\u0928 \u0905\u0927\u093f\u0917\u094d\u0930\u0939\u0923 \u0938\u0947 \u092a\u0939\u0932\u0947 \u090f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0924\u0915\u0928\u0940\u0936\u093f\u092f\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u092d\u094c\u0924\u093f\u0915 \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0940 \u0938\u093f\u092b\u093e\u0930\u093f\u0936 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",shareTitle:"\u092e\u094b\u091f\u094b\u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902"},battery:{title:"\u092c\u0948\u091f\u0930\u0940 \u090f\u0935\u0902 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u093f\u0902\u0917 \u092a\u0930\u0940\u0915\u094d\u0937\u0923",ready:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930.",restingStatus:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942, \u0907\u0902\u091c\u0928 \u092c\u0902\u0926... \u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092a\u0922\u093c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",crankingStatus:"\u0905\u092d\u0940 \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0930!",chargingStatus:"\u0907\u0902\u091c\u0928 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0939\u0948... \u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092a\u0922\u093c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",doneStatus:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u0942\u0930\u093e \u0939\u0941\u0906!",voltageError:"\u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092a\u0922\u093c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e. \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902.",start:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902",retry:"\u0926\u094b\u092c\u093e\u0930\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0947\u0902",procedure:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e",steps:{1:"1. \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942, \u0907\u0902\u091c\u0928 \u092c\u0902\u0926 \u2192 \u0930\u0947\u0938\u094d\u091f \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092e\u093e\u092a\u093e \u091c\u093e\u0924\u093e \u0939\u0948",2:"2. \u091c\u092c \"\u0905\u092d\u0940 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902\" \u0938\u0902\u0926\u0947\u0936 \u092a\u094d\u0930\u0915\u091f \u0939\u094b, \u0924\u094b \u0907\u0902\u091c\u0928 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902\u0964",3:"3. \u0938\u092c\u0938\u0947 \u0915\u092e \u0935\u094b\u0932\u094d\u091f\u0947\u091c 5 \u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",4:"4. \u0907\u0902\u091c\u0928 \u091a\u0932\u0928\u0947 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u091a\u093e\u0930\u094d\u091c/\u0930\u0947\u0917\u0941\u0932\u0947\u091f\u0930 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u092e\u093e\u092a\u093e \u091c\u093e\u0924\u093e \u0939\u0948"},warning:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u094b \u0921\u093f\u0938\u094d\u0915\u0928\u0947\u0915\u094d\u091f \u0928 \u0915\u0930\u0947\u0902\u0964",resting:"\u0935\u093f\u0936\u094d\u0930\u093e\u092e",cranking:"\u0917\u093e\u0928",charging:"\u091a\u093e\u0930\u094d\u091c \u0915\u0930\u0928\u093e",instantV:"\u0924\u094d\u0935\u0930\u093f\u0924 \u0935\u094b\u0932\u094d\u091f\u0947\u091c",evaluation:"\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928",verdicts:{full:"\u092c\u0948\u091f\u0930\u0940: \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u091a\u093e\u0930\u094d\u091c",good:"\u092c\u0948\u091f\u0930\u0940: \u0905\u091a\u094d\u091b\u0940 \u0938\u094d\u0925\u093f\u0924\u093f",weak:"\u092c\u0948\u091f\u0930\u0940: \u0915\u092e\u091c\u093c\u094b\u0930 \u0939\u094b\u0928\u093e",empty:"\u092c\u0948\u091f\u0930\u0940: \u0915\u092e\u091c\u093c\u094b\u0930/\u0916\u093c\u0930\u093e\u092c",crankNormal:"\u092a\u094d\u0930\u093e\u0930\u0902\u092d: \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0917\u093f\u0930\u093e\u0935\u091f",crankLow:"\u0938\u094d\u091f\u093e\u0930\u094d\u091f\u0930: \u0915\u092e \u0935\u094b\u0932\u094d\u091f\u0947\u091c",crankCritical:"\u0917\u093e\u0928: \u0917\u0902\u092d\u0940\u0930 \u0917\u093f\u0930\u093e\u0935\u091f",regNormal:"\u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917: \u0930\u0947\u0917\u0941\u0932\u0947\u091f\u0930 \u0938\u093e\u092e\u093e\u0928\u094d\u092f",regLow:"\u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917: \u0915\u092e \u091a\u093e\u0930\u094d\u091c",regHigh:"\u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917: \u0913\u0935\u0930\u091a\u093e\u0930\u094d\u091c",regFail:"\u091a\u093e\u0930\u094d\u091c\u093f\u0902\u0917: \u0930\u0947\u0917\u0941\u0932\u0947\u091f\u0930 \u0916\u093c\u0930\u093e\u092c \u0939\u0948"},verdictLocked:"\u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u092c\u0948\u091f\u0930\u0940 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0914\u0930 \u0915\u094d\u0930\u0948\u0902\u0915\u093f\u0902\u0917 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0917\u094d\u0930\u093e\u092b\u093c \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f PRO \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902\u0964"},freeze:{title:"\u092b\u093c\u094d\u0930\u0940\u091c\u093c \u092b\u093c\u094d\u0930\u0947\u092e",snapshot:"\u0935\u093f\u092b\u0932\u0924\u093e \u0938\u094d\u092e\u0943\u0924\u093f",desc:"\u091c\u092c \u091a\u0947\u0915 \u0907\u0902\u091c\u0928 \u0915\u0940 \u0932\u093e\u0907\u091f \u091c\u0932\u0924\u0940 \u0939\u0948 \u0924\u094b \u092f\u0939 \u0907\u0902\u091c\u0928 \u092e\u093e\u092a\u0926\u0902\u0921\u094b\u0902 \u0915\u094b \u092a\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0921\u0947\u091f\u093e \u0926\u094b\u0937 \u0928\u093f\u0926\u093e\u0928 \u092e\u0947\u0902 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",noDtcs:"\u0915\u094b\u0908 \u0917\u0932\u0924\u0940 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948. \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u094b\u0908 \u092b\u093c\u094d\u0930\u0940\u091c\u093c \u092b\u093c\u094d\u0930\u0947\u092e \u0921\u0947\u091f\u093e \u0928 \u0939\u094b.",read:"\u091c\u092e\u0947 \u0939\u0941\u090f \u0921\u0947\u091f\u093e \u092a\u0922\u093c\u0947\u0902",loading:"\u092e\u094b\u0921 02 \u092a\u0930 \u092a\u0942\u091b\u0924\u093e\u091b \u0915\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948...",noData:"\u0915\u094b\u0908 \u091c\u092e\u0947 \u0939\u0941\u090f \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e. \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u093e\u0939\u0928 \u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928 \u0915\u0930\u0947.",error:"\u0921\u0947\u091f\u093e \u092a\u0922\u093c\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f",values:"\u0905\u0938\u092b\u0932\u0924\u093e \u0915\u0947 \u0938\u092e\u092f \u092c\u091a\u093e\u090f \u0917\u090f \u092e\u0942\u0932\u094d\u092f",retry:"\u0926\u094b\u092c\u093e\u0930\u093e \u092a\u0922\u093c\u0947\u0902",techInfo:"\u0924\u0915\u0928\u0940\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940",techDesc:"\u2022 OBD-II \u092e\u094b\u0921 02: \u092b\u093c\u094d\u0930\u0947\u092e \u0921\u0947\u091f\u093e \u092b\u093c\u094d\u0930\u0940\u091c\u093c \u0915\u0930\u0947\u0902 \u2022 \u092a\u0940\u0906\u0908\u0921\u0940 020\u0938\u094000: \u0906\u0930\u092a\u0940\u090f\u092e \u092e\u0947\u0902 \u0916\u0930\u093e\u092c\u0940 \u2022 \u092a\u0940\u0906\u0908\u0921\u0940 020\u0921\u094000: \u0917\u0932\u0924\u0940 \u092a\u0930 \u0917\u0924\u093f \u2022 \u092a\u0940\u0906\u0908\u0921\u0940 020500: \u0916\u0930\u093e\u092c\u0940 \u0915\u0947 \u0938\u092e\u092f \u0920\u0902\u0921\u093e \u092a\u093e\u0928\u0940 \u0915\u093e \u0924\u093e\u092a\u092e\u093e\u0928 \u092f\u0947 \u0921\u0947\u091f\u093e \u0905\u0902\u0924\u093f\u092e \u0917\u0932\u0924\u0940 \u0915\u094b\u0921 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0939\u0948\u0902\u0964 \u091c\u092c \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0938\u093e\u092b\u093c \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092b\u093c\u094d\u0930\u0940\u091c\u093c \u092b\u093c\u094d\u0930\u0947\u092e \u0921\u0947\u091f\u093e \u092d\u0940 \u0938\u093e\u092b\u093c \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923",seconds:"\u0938\u0947\u0915\u0902\u0921",speed:"\u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e",idle:"\u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902 \u0914\u0930 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u094b \u091c\u093e\u090f\u0902\u0964",ready:"\u0924\u0948\u092f\u093e\u0930! \u0935\u093e\u0939\u0928 \u091a\u0932\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902...",readyDesc:"\u0917\u0924\u093f > 0 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0915\u093e\u0909\u0902\u091f\u0930 \u091a\u093e\u0932\u0942 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964",measuring:"\u092e\u093e\u092a \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",done:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u0942\u0930\u093e \u0939\u094b \u0917\u092f\u093e",start:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902",stop:"\u0930\u0941\u0915\u0947\u0902",reset:"\u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0947\u0902",howItWorks:"\u092f\u0939 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948?",howDesc:"1. \"\u092a\u094d\u0930\u093e\u0930\u0902\u092d \u092a\u0930\u0940\u0915\u094d\u0937\u0923\" \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0901 2. \u0935\u093e\u0939\u0928 \u0938\u094d\u0925\u093f\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f 3. \u091c\u092c \u0906\u092a \u091a\u0932\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0915\u094d\u0930\u094b\u0928\u