e:"\u0422\u0435\u0441\u0442 \u043d\u0430 \u043f\u0440\u043e\u043a\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u044f \u0433\u0456\u0434\u0440\u0430\u0432\u043b\u0456\u0447\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u043e\u0441\u0430 ABS",absSubtitle:"\u0412\u043c\u0438\u043a\u0430\u0454 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0456\u0442\u043d\u0456 \u043a\u043b\u0430\u043f\u0430\u043d\u0438 ABS \u0434\u043b\u044f \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f \u0431\u0443\u043b\u044c\u0431\u0430\u0448\u043e\u043a \u043f\u043e\u0432\u0456\u0442\u0440\u044f \u0437 \u0433\u0430\u043b\u044c\u043c\u0456\u0432\u043d\u0438\u0445 \u043b\u0456\u043d\u0456\u0439.",ecuRejected:"ECU \u0432\u0456\u0434\u0445\u0438\u043b\u0438\u0432 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e, \u0430 \u0434\u0432\u0438\u0433\u0443\u043d \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e."},aiDoctor:{analyzing:"\u0410\u043d\u0430\u043b\u0456\u0437 \u043a\u043e\u0434\u0456\u0432 DTC \u0456 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u0457 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e AI Doctor...",healthImpact:"\u0412\u043f\u043b\u0438\u0432 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0430 \u0437\u0434\u043e\u0440\u043e\u0432\u2019\u044f: {{score}}/100",drivingSafety:"\u041a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e \u0437 \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u0432\u043e\u0434\u0456\u043d\u043d\u044f",causes:"\u0419\u043c\u043e\u0432\u0456\u0440\u043d\u0456 \u043f\u0440\u0438\u0447\u0438\u043d\u0438",recommendedAction:"\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0430 \u043c\u0435\u0445\u0430\u043d\u0456\u0447\u043d\u0430 \u0434\u0456\u044f",estimatedCost:"\u041e\u0440\u0456\u0454\u043d\u0442\u043e\u0432\u043d\u0430 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430/\u0440\u0435\u043c\u043e\u043d\u0442\u0443",noFaultsTitle:"\u041e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u2014 \u043a\u043e\u0434\u0456\u0432 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 \u043d\u0435 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043e",noFaultsSummary:"\u0422\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u044f ECU \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0445 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0438\u0445 \u043a\u043e\u0434\u0456\u0432 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439. \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0432 \u043c\u0435\u0436\u0430\u0445 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0438\u0445 \u0440\u043e\u0431\u043e\u0447\u0438\u0445 \u043f\u043e\u0440\u043e\u0433\u0456\u0432.",stepMaintain:"\u0414\u043e\u0442\u0440\u0438\u043c\u0443\u0439\u0442\u0435\u0441\u044f \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u0438\u0445 \u0456\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0456\u0432 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u0430\u0441\u043b\u0430 \u0442\u0430 \u0444\u0456\u043b\u044c\u0442\u0440\u0430.",stepCheckVoltage:"\u041f\u0435\u0440\u0456\u043e\u0434\u0438\u0447\u043d\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0439\u0442\u0435 \u043d\u0430\u043f\u0440\u0443\u0433\u0443 \u0432 \u0441\u0442\u0430\u043d\u0456 \u0441\u043f\u043e\u043a\u043e\u044e \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430.",safeDrive:"\u0411\u0435\u0437\u043f\u0435\u0447\u043d\u0438\u0439 \u0434\u043b\u044f \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0457 \u0435\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0456\u0457.",misfireTitle:"\u0412\u0438\u044f\u0432\u043b\u0435\u043d\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u043a \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0446\u0438\u043b\u0456\u043d\u0434\u0440\u0430 \u0434\u0432\u0438\u0433\u0443\u043d\u0430",misfireSummary:"\u0410\u043a\u0442\u0438\u0432\u043d\u0456 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0438 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u0456 \u0432 \u043e\u0434\u043d\u043e\u043c\u0443 \u0430\u0431\u043e \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0446\u0438\u043b\u0456\u043d\u0434\u0440\u0430\u0445. \u041d\u0435\u0437\u0433\u043e\u0440\u0456\u043b\u0435 \u043f\u0430\u043b\u0438\u0432\u043e \u043c\u043e\u0436\u0435 \u043f\u043e\u0442\u0440\u0430\u043f\u0438\u0442\u0438 \u0432 \u043a\u0430\u0442\u0430\u043b\u0456\u0442\u0438\u0447\u043d\u0438\u0439 \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0456\u0437\u0430\u0442\u043e\u0440, \u0441\u043f\u0440\u0438\u0447\u0438\u043d\u0438\u0432\u0448\u0438 \u043d\u0435\u0437\u0432\u043e\u0440\u043e\u0442\u043d\u0435 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043d\u044f.",causeSparkPlug:"\u0417\u043d\u043e\u0448\u0435\u043d\u0430 \u0430\u0431\u043e \u0437\u0430\u0431\u0440\u0443\u0434\u043d\u0435\u043d\u0430 \u0441\u0432\u0456\u0447\u043a\u0430 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f",causeIgnitionCoil:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043a\u043e\u0442\u0443\u0448\u043a\u0438 \u0430\u0431\u043e \u0434\u0440\u043e\u0442\u0443 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f",causeFuelInjector:"\u0417\u0430\u0431\u0438\u0442\u0430 \u0430\u0431\u043e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0430 \u043f\u0430\u043b\u0438\u0432\u043d\u0430 \u0444\u043e\u0440\u0441\u0443\u043d\u043a\u0430",stepInspectPlugs:"\u041e\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u0441\u0432\u0456\u0447\u043a\u0438 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u044c.",stepSwapCoils:"\u041f\u043e\u043c\u0456\u043d\u044f\u0439\u0442\u0435 \u043a\u043e\u0442\u0443\u0448\u043a\u0438 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u043c\u0456\u0436 \u0446\u0438\u043b\u0456\u043d\u0434\u0440\u0430\u043c\u0438, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0456.",stepFuelPressure:"\u0412\u0438\u043c\u0456\u0440\u044f\u0439\u0442\u0435 \u0442\u0438\u0441\u043a \u0432 \u043f\u0430\u043b\u0438\u0432\u043d\u0456\u0439 \u0440\u0430\u043c\u043f\u0456.",criticalDrive:"\u041d\u0435 \u0457\u0437\u0434\u0456\u0442\u044c \u043d\u0430 \u0434\u043e\u0432\u0433\u0456 \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u0456 \u043f\u0456\u0434 \u0441\u0438\u043b\u044c\u043d\u0438\u043c \u0433\u0430\u0437\u043e\u043c. \u041d\u0435\u0433\u0430\u0439\u043d\u043e \u0432\u0435\u0437\u0456\u0442\u044c \u0432 \u0441\u0435\u0440\u0432\u0456\u0441.",o2Title:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043a\u0438\u0441\u043d\u044e.",o2Summary:"\u041f\u043e\u0433\u0456\u0440\u0448\u0443\u0454\u0442\u044c\u0441\u044f \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u0438\u0439 \u0437\u0432'\u044f\u0437\u043e\u043a \u043f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u043e-\u043f\u0430\u043b\u0438\u0432\u043d\u043e\u0457 \u0441\u0443\u043c\u0456\u0448\u0456. \u0414\u0432\u0438\u0433\u0443\u043d \u043c\u043e\u0436\u0435 \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u043d\u0430 \u0437\u0431\u0430\u0433\u0430\u0447\u0435\u043d\u043e\u043c\u0443 \u0430\u0431\u043e \u0431\u0456\u0434\u043d\u043e\u043c\u0443 \u0440\u0456\u0432\u043d\u0456, \u0437\u043d\u0438\u0436\u0443\u044e\u0447\u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u043f\u0430\u043b\u0438\u0432\u0430.",causeO2Heater:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043d\u0430\u0433\u0440\u0456\u0432\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2",causeExhaustLeak:"\u0412\u0438\u0442\u0456\u043a \u0432\u0438\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u043a\u0442\u043e\u0440\u0430 \u043f\u0435\u0440\u0435\u0434 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u043c",causeHarness:"\u041f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u0438\u0439 \u0440\u043e\u0437'\u0454\u043c \u0434\u0436\u0433\u0443\u0442\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0456\u0432",stepCheckWiring:"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0434\u0436\u0433\u0443\u0442 \u043f\u0440\u043e\u0432\u043e\u0434\u0456\u0432 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2 \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u043e\u043f\u043b\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u0437\u043d\u043e\u0448\u0435\u043d\u043d\u044f.",stepCleanSensor:"\u041e\u0447\u0438\u0441\u0442\u0456\u0442\u044c \u043d\u0430\u043a\u043e\u043d\u0435\u0447\u043d\u0438\u043a \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2 \u0430\u0431\u043e \u0437\u0430\u043c\u0456\u043d\u0456\u0442\u044c \u0434\u0430\u0442\u0447\u0438\u043a, \u044f\u043a\u0449\u043e \u043e\u043f\u0456\u0440 \u043d\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u0432\u0438\u043c\u043e\u0433\u0430\u043c.",warningDrive:"\u0411\u0435\u0437\u043f\u0435\u0447\u043d\u043e \u0457\u0445\u0430\u0442\u0438 \u0434\u043e \u0440\u0435\u043c\u043e\u043d\u0442\u043d\u043e\u0457 \u043c\u0430\u0439\u0441\u0442\u0435\u0440\u043d\u0456 \u043d\u0430 \u043f\u043e\u043c\u0456\u0440\u043d\u0456\u0439 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456.",genericTitle:"\u0410\u043d\u0430\u043b\u0456\u0437 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u0434\u0443",genericSummary:"\u0412\u0438\u044f\u0432\u043b\u0435\u043d\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u0456 \u043a\u043e\u0434\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439: {{codes}}. \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u043c\u043e\u043d\u0456\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u0438.",causeGeneric1:"\u041b\u0430\u043d\u0446\u044e\u0433 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043f\u043e\u0437\u0430 \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043d\u0438\u043c \u0434\u0456\u0430\u043f\u0430\u0437\u043e\u043d\u043e\u043c \u043d\u0430\u043f\u0440\u0443\u0433\u0438",causeGeneric2:"\u041f\u043e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0435 \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u0435 \u0437\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u0437\u0430\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043d\u0430 \u0437\u0435\u043c\u043b\u044e",stepGeneric1:"\u0412\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0435 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0437\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0434\u0430\u043d\u0456 \u0441\u0442\u043e\u043f-\u043a\u0430\u0434\u0440\u0443.",stepGeneric2:"\u041e\u0447\u0438\u0441\u0442\u0456\u0442\u044c \u043a\u043e\u0434\u0438 DTC \u043f\u0456\u0441\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u0440\u043e\u0437\u2019\u0454\u043c\u0456\u0432 \u0434\u0436\u0433\u0443\u0442\u0430.",reportTitle:"\u0410\u043d\u0430\u043b\u0456\u0437 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u0434\u0443",healthImpactTitle:"\u0412\u041f\u041b\u0418\u0412 \u041d\u0410 \u041e\u0426\u0406\u041d\u041a\u0423 \u0417\u0414\u041e\u0420\u041e\u0412'\u042f \u0414\u0412\u0418\u0413\u0423\u041d\u0410",freeTrialBadge:"\u0412\u0418 \u0412\u0418\u041a\u041e\u0420\u0418\u0421\u0422\u041e\u0412\u0423\u0404\u0422\u0415 1 \u0411\u0415\u0417\u041a\u041e\u0428\u0422\u041e\u0412\u041d\u0423 \u0406\u0406-\u0414\u0406\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0423",modalTitle:"Modal Title",modalSubtitle:"Modal Subtitle"},dtcRisk:{safeTitle:"\u0411\u0415\u0417\u041f\u0415\u0427\u041d\u041e \u0414\u041b\u042f \u0407\u0417\u0414\u0418",safeDesc:"\u0426\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043d\u0435 \u0437\u0430\u0433\u0440\u043e\u0436\u0443\u0454 \u0431\u0435\u0437\u043f\u0435\u0446\u0456 \u043f\u0440\u044f\u043c\u043e. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0432\u0430\u0442\u0438 \u0440\u0443\u0445 \u0437 \u043f\u043e\u043c\u0456\u0440\u043d\u043e\u044e \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044e \u0434\u043e \u0430\u0432\u0442\u043e\u0441\u0435\u0440\u0432\u0456\u0441\u0443.",warningTitle:"\u0423\u0412\u0410\u0413\u0410: \u041f\u041e\u0422\u0420\u0406\u0411\u041d\u0410 \u041f\u0415\u0420\u0415\u0412\u0406\u0420\u041a\u0410 \u0412 \u0421\u0415\u0420\u0412\u0406\u0421\u0406",warningDesc:"\u041c\u043e\u0436\u043b\u0438\u0432\u0435 \u0437\u043d\u0438\u0436\u0435\u043d\u043d\u044f \u043f\u043e\u0442\u0443\u0436\u043d\u043e\u0441\u0442\u0456 \u0442\u0430 \u043f\u0456\u0434\u0432\u0438\u0449\u0435\u043d\u0456 \u0432\u0438\u043a\u0438\u0434\u0438. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0437\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f \u0434\u043e \u0430\u0432\u0442\u043e\u0441\u0435\u0440\u0432\u0456\u0441\u0443 \u043d\u0430\u0439\u0431\u043b\u0438\u0436\u0447\u0438\u043c \u0447\u0430\u0441\u043e\u043c.",criticalTitle:"\u041a\u0420\u0418\u0422\u0418\u0427\u041d\u041e: \u0417\u0423\u041f\u0418\u041d\u0406\u0422\u042c \u0420\u0423\u0425 / \u0421\u0415\u0420\u0412\u0406\u0421 \u041d\u0415\u0414\u0410\u0419\u041d\u041e",criticalDesc:"\u041a\u0440\u0438\u0442\u0438\u0447\u043d\u0430 \u0437\u0430\u0433\u0440\u043e\u0437\u0430 \u043f\u043e\u043b\u043e\u043c\u043a\u0438! \u0414\u0432\u0438\u0433\u0443\u043d \u0430\u0431\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0431\u0443\u0442\u0438 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u0456. \u041d\u0435\u0433\u0430\u0439\u043d\u043e \u0437\u0443\u043f\u0438\u043d\u0456\u0442\u044c\u0441\u044f \u0443 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456."},dtcDetail:{descTitle:"\u041e\u041f\u0418\u0421 \u041a\u041e\u0414\u0423 \u041d\u0415\u0418\u0421\u041f\u0420\u0410\u0412\u041d\u041e\u0421\u0422\u0406",possibleCausesTitle:"\u041c\u041e\u0416\u041b\u0418\u0412\u0406 \u041f\u0420\u0418\u0427\u0418\u041d\u0418 \u0422\u0410 \u0406\u041d\u0421\u0422\u0420\u0423\u041a\u0426\u0406\u0407 \u0417 \u0420\u0415\u041c\u041e\u041d\u0422\u0423",cause1:"\u041f\u043e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0435 \u0437\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u043a\u043e\u0440\u043e\u0437\u0456\u044f \u0432 \u043b\u0430\u043d\u0446\u044e\u0437\u0456 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0430\u0431\u043e \u0434\u0436\u0433\u0443\u0442\u0456 \u043f\u0440\u043e\u0432\u043e\u0434\u0456\u0432",cause2:"\u041c\u0435\u0445\u0430\u043d\u0456\u0447\u043d\u0438\u0439 \u0437\u043d\u043e\u0441 \u0430\u0431\u043e \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430",cause3:"\u0412\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 \u043d\u0430\u043f\u0440\u0443\u0433\u0438/\u043e\u043f\u043e\u0440\u0443 \u043c\u0443\u043b\u044c\u0442\u0438\u043c\u0435\u0442\u0440\u043e\u043c \u0430\u0431\u043e \u0437\u0430\u043c\u0456\u043d\u0456\u0442\u044c \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442",recommendedAction:"\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0430 \u0434\u0456\u044f",tsbTitle:"\u0411\u042e\u041b\u0415\u0422\u0415\u041d\u042c \u0422\u0415\u0425\u041d\u0406\u0427\u041d\u041e\u0413\u041e \u0421\u0415\u0420\u0412\u0406\u0421\u0423",aiDoctorBtn:"\u0415\u041a\u0421\u041f\u0415\u0420\u0422\u041d\u0418\u0419 \u0410\u041d\u0410\u041b\u0406\u0417 AI DOCTOR",backToDetail:"\u041d\u0410\u0417\u0410\u0414 \u0414\u041e \u0414\u0415\u0422\u0410\u041b\u0415\u0419 \u041f\u041e\u041c\u0418\u041b\u041a\u0418"},dtcCategory:{powertrain:"\u0414\u0412\u0418\u0413\u0423\u041d / \u0422\u0420\u0410\u041d\u0421\u041c\u0406\u0421\u0406\u042f",chassis:"\u0428\u0410\u0421\u0406 / \u0413\u0410\u041b\u042c\u041c\u0406\u0412\u041d\u0410 \u0421\u0418\u0421\u0422\u0415\u041c\u0410",body:"\u041a\u0423\u0417\u041e\u0412\u041d\u0410 \u0415\u041b\u0415\u041a\u0422\u0420\u041e\u041d\u0406\u041a\u0410",network:"\u041c\u0415\u0420\u0415\u0416\u0410 / \u0421\u0418\u0421\u0422\u0415\u041c\u0410 CAN-\u0428\u0418\u041d\u0418"},guidedDiag:{p0102_cause1:"\u0417\u0430\u0431\u0440\u0443\u0434\u043d\u0435\u043d\u0438\u0439 \u0430\u0431\u043e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0438\u0439 \u0434\u0430\u0442\u0447\u0438\u043a MAF",p0102_cause2:"\u0412\u0438\u0442\u0456\u043a \u0443 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u043c\u0443 \u043a\u043e\u043b\u0435\u043a\u0442\u043e\u0440\u0456 / \u0412\u0430\u043a\u0443\u0443\u043c\u043d\u0438\u0439 \u0432\u0438\u0442\u0456\u043a",p0102_cause3:"\u041f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u043a\u0438 \u0430\u0431\u043e \u043e\u043a\u0438\u0441\u043b\u0435\u043d\u043d\u044f",p0102_action:"\u041e\u0447\u0438\u0441\u0442\u0456\u0442\u044c \u0434\u0430\u0442\u0447\u0438\u043a MAF \u043e\u0447\u0438\u0441\u043d\u0438\u043a\u043e\u043c \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0456\u0432 \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043a\u043e\u0440\u043f\u0443\u0441 \u043f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u043e\u0433\u043e \u0444\u0456\u043b\u044c\u0442\u0440\u0430.",p0102_tsb:"TSB-2023-09: \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0437\u0430\u0442\u044f\u0436\u043a\u0443 \u0445\u043e\u043c\u0443\u0442\u0456\u0432 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u043f\u0430\u0442\u0440\u0443\u0431\u043a\u0430 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043c\u0456\u043d\u043e\u044e MAF.",p0171_cause1:"\u0412\u0438\u0442\u0456\u043a \u0432\u0430\u043a\u0443\u0443\u043c\u043d\u043e\u0433\u043e \u0448\u043b\u0430\u043d\u0433\u0430 / \u0432\u0438\u0442\u0456\u043a \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u043e\u0442\u0432\u043e\u0440\u0443",p0171_cause2:"\u0421\u043b\u0430\u0431\u043a\u0438\u0439 \u043f\u0430\u043b\u0438\u0432\u043d\u0438\u0439 \u043d\u0430\u0441\u043e\u0441 / \u043d\u0438\u0437\u044c\u043a\u0438\u0439 \u0442\u0438\u0441\u043a",p0171_cause3:"\u0417\u0430\u0431\u0440\u0443\u0434\u043d\u0435\u043d\u0438\u0439 \u0434\u0430\u0442\u0447\u0438\u043a O2 1",p0171_action:"\u0412\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 \u0434\u0438\u043c\u0443 \u043d\u0430 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u043c\u0443 \u043a\u043e\u043b\u0435\u043a\u0442\u043e\u0440\u0456 \u0442\u0430 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0442\u0440\u0438\u0432\u0430\u043b\u0443 \u043a\u043e\u0440\u0435\u043a\u0446\u0456\u044e \u043f\u0430\u043b\u0438\u0432\u0430.",p0171_tsb:"TSB-2022-14: \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0434\u0456\u0430\u0444\u0440\u0430\u0433\u043c\u0443 \u043a\u043b\u0430\u043f\u0430\u043d\u0430 PCV \u043d\u0430 \u043d\u0430\u044f\u0432\u043d\u0456\u0441\u0442\u044c \u0440\u043e\u0437\u0440\u0438\u0432\u0456\u0432.",p0420_cause1:"\u0417\u043d\u0438\u0436\u0435\u043d\u043d\u044f \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456 \u043a\u0430\u0442\u0430\u043b\u0456\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0456\u0437\u0430\u0442\u043e\u0440\u0430",p0420_cause2:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u0437\u0430\u0434\u043d\u044c\u043e\u0433\u043e \u043d\u0438\u0436\u043d\u044c\u043e\u0433\u043e \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2",p0420_cause3:"\u0412\u0438\u0442\u0456\u043a \u0432\u0438\u0445\u043b\u043e\u043f\u0443 \u043f\u0435\u0440\u0435\u0434 \u043a\u043e\u043d\u0432\u0435\u0440\u0442\u043e\u0440\u043e\u043c",p0420_action:"\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u0441\u0438\u0433\u043d\u0430\u043b\u0438 \u0441\u0435\u043d\u0441\u043e\u0440\u0430 O2 \u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0442\u0430 \u043d\u0438\u0436\u043d\u044c\u043e\u0433\u043e \u043f\u043e\u0442\u043e\u043a\u0456\u0432 \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043a\u0430\u0442\u0430\u043b\u0456\u0437\u0430\u0442\u043e\u0440\u0430.",p0300_cause1:"\u0417\u043d\u043e\u0448\u0435\u043d\u0430 \u0441\u0432\u0456\u0447\u043a\u0430 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f/\u043a\u043e\u0442\u0443\u0448\u043a\u0430 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f",p0300_cause2:"\u0417\u0430\u0431\u0438\u0442\u0430 \u043f\u0430\u043b\u0438\u0432\u043d\u0430 \u0444\u043e\u0440\u0441\u0443\u043d\u043a\u0430",p0300_cause3:"\u041d\u0438\u0437\u044c\u043a\u0430 \u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0456\u044f \u0432 \u0446\u0438\u043b\u0456\u043d\u0434\u0440\u0430\u0445 \u0434\u0432\u0438\u0433\u0443\u043d\u0430",p0300_action:"\u041f\u043e\u043c\u0456\u043d\u044f\u0439\u0442\u0435 \u043a\u043e\u0442\u0443\u0448\u043a\u0443 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0441\u0443\u0441\u0456\u0434\u043d\u0456\u0439 \u0446\u0438\u043b\u0456\u043d\u0434\u0440 \u0456 \u0441\u043f\u043e\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0439\u0442\u0435, \u0447\u0438 \u043d\u0435 \u0432\u0438\u043d\u0438\u043a\u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f.",p17bf_cause1:"\u0412\u0438\u0442\u0456\u043a \u0433\u0456\u0434\u0440\u0430\u0432\u043b\u0456\u0447\u043d\u043e\u0433\u043e \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 \u043c\u0435\u0445\u0430\u0442\u0440\u043e\u043d\u043d\u043e\u0433\u043e \u0442\u0438\u0441\u043a\u0443",p17bf_cause2:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0456\u0442\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u043f\u0430\u043d\u0430",p17bf_cause3:"\u041d\u0438\u0437\u044c\u043a\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c \u0440\u0456\u0434\u0438\u043d\u0438 / \u0414\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0456\u044f \u0440\u0456\u0434\u0438\u043d\u0438",p17bf_action:"\u0412\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 \u0442\u0438\u0441\u043a\u0443 DCT Mechatronic \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043a\u043e\u0440\u043f\u0443\u0441 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430.",p17bf_tsb:"TSB-VAG-DSG: \u0417\u0430\u043c\u0456\u043d\u0456\u0442\u044c \u043a\u043e\u0440\u043f\u0443\u0441