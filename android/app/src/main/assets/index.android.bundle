0fc\u306e\u57fa\u6e96\u30bc\u30ed\u4f4d\u7f6e\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},bmw_12v_battery_reg:{name:"12V \u88dc\u52a9\u30d0\u30c3\u30c6\u30ea\u30fc\u767b\u9332 (BMW)",desc:"\u88dc\u52a9 AGM \u30b9\u30bf\u30fc\u30bf\u30fc/\u30b5\u30dd\u30fc\u30c8 \u30d0\u30c3\u30c6\u30ea\u30fc\u4ea4\u63db\u3092 PCU \u306b\u767b\u9332\u3057\u307e\u3059\u3002"},vag_comfort_turn_signal:{name:"\u30b3\u30f3\u30d5\u30a9\u30fc\u30c8\u30bf\u30fc\u30f3\u30b7\u30b0\u30ca\u30eb\u70b9\u6ec5\u56de\u6570 (VAG)",desc:"\u8eca\u7dda\u5909\u66f4\u30a6\u30a4\u30f3\u30ab\u30fc\u306e\u30b5\u30a4\u30af\u30eb\u6570\u3092 3 \u56de\u30014 \u56de\u30015 \u56de\u306e\u70b9\u6ec5\u306e\u9593\u3067\u8abf\u6574\u3057\u307e\u3059\u3002"},vag_coming_home_duration:{name:"\u5e30\u5b85/\u5e30\u5b85\u30e9\u30a4\u30c8\u6301\u7d9a\u6642\u9593 (VAG)",desc:"\u8eca\u4e21\u30ed\u30c3\u30af\u5f8c\u306e\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u70b9\u706f\u30bf\u30a4\u30de\u30fc\u3092\u8a2d\u5b9a\u3057\u307e\u3059 (10 \u79d2 - 60 \u79d2)\u3002"},vag_remote_windows:{name:"\u30ea\u30e2\u30fc\u30c8 \u30b3\u30f3\u30d3\u30cb\u30a8\u30f3\u30b9 \u30a6\u30a3\u30f3\u30c9\u30a6 \u30b3\u30f3\u30c8\u30ed\u30fc\u30eb (VAG)",desc:"\u30ea\u30e2\u30fc\u30c8\u30ad\u30fc\u30d5\u30a9\u30d6\u306e\u9577\u62bc\u3057\u306b\u3088\u308b\u30d1\u30ef\u30fc\u30a6\u30a3\u30f3\u30c9\u30a6\u306e\u958b\u9589\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002"},vag_auto_lock_15kmh:{name:"15 km/h \u3067\u306e\u81ea\u52d5\u30c9\u30a2\u30ed\u30c3\u30af (VAG)",desc:"\u8eca\u901f\u304c15km/h\u306b\u9054\u3059\u308b\u3068\u3059\u3079\u3066\u306e\u30c9\u30a2\u3092\u81ea\u52d5\u7684\u306b\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002"},vag_sfd_unlock_prep:{name:"SFD \u30b2\u30fc\u30c8\u30a6\u30a7\u30a4\u4fdd\u8b77\u30b9\u30c6\u30fc\u30bf\u30b9\u306e\u6e96\u5099 (VAG 2020+)",desc:"\u4fdd\u8b77\u3055\u308c\u305f DID \u3092\u66f8\u304d\u8fbc\u3080\u305f\u3081\u306e MQB-evo SFD \u30b2\u30fc\u30c8\u30a6\u30a7\u30a4 \u30c8\u30fc\u30af\u30f3 \u30bb\u30c3\u30b7\u30