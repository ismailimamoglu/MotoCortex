e07\u0e08\u0e23\u0e40\u0e1b\u0e34\u0e14 (\u0e2a\u0e32\u0e22\u0e02\u0e32\u0e14)','Short to Ground':'\u0e25\u0e31\u0e14\u0e27\u0e07\u0e08\u0e23\u0e25\u0e07\u0e01\u0e23\u0e32\u0e27\u0e14\u0e4c','Short to Voltage':'\u0e25\u0e31\u0e14\u0e27\u0e07\u0e08\u0e23\u0e01\u0e31\u0e1a\u0e44\u0e1f\u0e1a\u0e27\u0e01','Range/Performance':'\u0e0a\u0e48\u0e27\u0e07/\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e01\u0e32\u0e23\u0e17\u0e33\u0e07\u0e32\u0e19','Circuit Low':'\u0e2a\u0e31\u0e0d\u0e0d\u0e32\u0e13\u0e27\u0e07\u0e08\u0e23\u0e15\u0e48\u0e33','Circuit High':'\u0e2a\u0e31\u0e0d\u0e0d\u0e32\u0e13\u0e27\u0e07\u0e08\u0e23\u0e2a\u0e39\u0e07','Circuit Malfunction':'\u0e27\u0e07\u0e08\u0e23\u0e17\u0e33\u0e07\u0e32\u0e19\u0e1c\u0e34\u0e14\u0e1b\u0e01\u0e15\u0e34','Mass or Volume Air Flow':'\u0e40\u0e0b\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c\u0e21\u0e27\u0e25\u0e2d\u0e32\u0e01\u0e32\u0e28 (MAF)','Engine Coolant Temperature':'\u0e2d\u0e38\u0e13\u0e2b\u0e20\u0e39\u0e21\u0e34\u0e19\u0e49\u0e33\u0e2b\u0e25\u0e48\u0e2d\u0e40\u0e22\u0e47\u0e19\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e22\u0e19\u0e15\u0e4c','Oxygen Sensor':'\u0e2d\u0e2d\u0e01\u0e0b\u0e34\u0e40\u0e08\u0e19\u0e40\u0e0b\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c (O2)','Transmission Control System':'\u0e23\u0e30\u0e1a\u0e1a\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e40\u0e01\u0e35\u0e22\u0e23\u0e4c','Lost Communication With':'\u0e02\u0e32\u0e14\u0e01\u0e32\u0e23\u0e2a\u0e37\u0e48\u0e2d\u0e2a\u0e32\u0e23\u0e01\u0e31\u0e1a','Wheel Speed Sensor':'\u0e40\u0e0b\u0e19\u0e40\u0e0b\u0e2d\u0e23\u0e4c\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e25\u0e49\u0e2d','Airbag Control Module':'\u0e42\u0e21\u0e14\u0e39\u0e25\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e16\u0e38\u0e07\u0e25\u0e21\u0e19\u0e34\u0e23\u0e20\u0e31\u0e22','ABS Control Module':'\u0e42\u0e21\u0e14\u0e39\u0e25\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21 ABS'},uk:{'Glow Plug Module Control Circuit':'\u041b\u0430\u043d\u0446\u044e\u0433 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u043e\u0434\u0443\u043b\u0435\u043c \u0441\u0432\u0456\u0447\u043e\u043a \u0440\u043e\u0437\u0436\u0430\u0440\u044e\u0432\u0430\u043d\u043d\u044f','Control Circuit':'\u041b\u0430\u043d\u0446\u044e\u0433 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f','Open Circuit':'\u041e\u0431\u0440\u0456\u0432 \u043b\u0430\u043d\u0446\u044e\u0433\u0430','Short to Ground':'\u041a\u043e\u0440\u043e\u0442\u043a\u0435 \u0437\u0430\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043d\u0430 \u043c\u0430\u0441\u0443','Short to Voltage':'\u041a\u043e\u0440\u043e\u0442\u043a\u0435 \u0437\u0430\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043d\u0430 \u043f\u043b\u044e\u0441','Range/Performance':'\u0414\u0456\u0430\u043f\u0430\u0437\u043e\u043d/\u0420\u043e\u0431\u043e\u0447\u0456 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438','Circuit Low':'\u041d\u0438\u0437\u044c\u043a\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c \u0441\u0438\u0433\u043d\u0430\u043b\u0443 \u0432 \u043b\u0430\u043d\u0446\u044e\u0437\u0456','Circuit High':'\u0412\u0438\u0441\u043e\u043a\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c \u0441\u0438\u0433\u043d\u0430\u043b\u0443 \u0432 \u043b\u0430\u043d\u0446\u044e\u0437\u0456','Circuit Malfunction':'\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430','Mass or Volume Air Flow':'\u0414\u0430\u0442\u0447\u0438\u043a \u043c\u0430\u0441\u043e\u0432\u043e\u0457 \u0432\u0438\u0442\u0440\u0430\u0442\u0438 \u043f\u043e\u0432\u0456\u0442\u0440\u044f (MAF)','Engine Coolant Temperature':'\u0414\u0430\u0442\u0447\u0438\u043a \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0438 \u043e\u0445\u043e\u043b\u043e\u0434\u0436\u0443\u044e\u0447\u043e\u0457 \u0440\u0456\u0434\u0438\u043d\u0438','Oxygen Sensor':'\u0414\u0430\u0442\u0447\u0438\u043a \u043a\u0438\u0441\u043d\u044e (\u041b\u044f\u043c\u0431\u0434\u0430-\u0437\u043e\u043d\u0434)','Transmission Control System':'\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0440\u0430\u043d\u0441\u043c\u0456\u0441\u0456\u0454\u044e','Lost Communication With':'\u0412\u0442\u0440\u0430\u0442\u0430 \u0437\u0432\'\u044f\u0437\u043a\u0443 \u0437 \u0431\u043b\u043e\u043a\u043e\u043c','Wheel Speed Sensor':'\u0414\u0430\u0442\u0447\u0438\u043a \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u043a\u043e\u043b\u0435\u0441\u0430 (ABS)','Airbag Control Module':'\u0411\u043b\u043e\u043a \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0434\u0443\u0448\u043a\u0430\u043c\u0438 \u0431\u0435\u0437\u043f\u0435\u043a\u0438','ABS Control Module':'\u0411\u043b\u043e\u043a \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f ABS'},hu:{'Glow Plug Module Control Circuit':'Izz\xedt\xf3gyertya modul vez\xe9rl\u0151\xe1ramk\xf6r','Control Circuit':'Vez\xe9rl\u0151\xe1ramk\xf6r','Open Circuit':'Szakadt \xe1ramk\xf6r','Short to Ground':'Testz\xe1rlat','Short to Voltage':'Pozit\xedv z\xe1rlat','Range/Performance':'Tartom\xe1ny/Teljes\xedtm\xe9ny','Circuit Low':'\xc1ramk\xf6r alacsony jel','Circuit High':'\xc1ramk\xf6r magas jel','Circuit Malfunction':'\xc1ramk\xf6ri hiba','Mass or Volume Air Flow':'L\xe9gt\xf6megm\xe9r\u0151 (MAF)','Engine Coolant Temperature':'H\u0171t\u0151folyad\xe9k h\u0151m\xe9rs\xe9klet','Oxygen Sensor':'Oxig\xe9nszenzor (Lambdaszonda)','Transmission Control System':'Sebess\xe9gv\xe1lt\xf3 vez\xe9rl\u0151rendszer','Lost Communication With':'Megszakadt a kommunik\xe1ci\xf3 ezzel:','Wheel Speed Sensor':'Ker\xe9kfordulatsz\xe1m-\xe9rz\xe9kel\u0151','Airbag Control Module':'L\xe9gzs\xe1k vez\xe9rl\u0151modul','ABS Control Module':'ABS vez\xe9rl\u0151modul'}};function P(o,n){var l=C(o)||'';if(!l)return'';var s=n.split('-')[0].toLowerCase();if('en'===s)return l;var u=S[s];if(!u)return l;var c=l;for(var P of Object.entries(u)){var k=(0,t.default)(P,2),M=k[0],h=k[1],A=new RegExp(M,'gi');c=c.