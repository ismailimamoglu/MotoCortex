436\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439",latency:"\u0417\u0430\u0442\u0440\u0438\u043c\u043a\u0430",protocol:"\u0410\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b",featureSupport:"\u041c\u0410\u0422\u0420\u0418\u0426\u042f \u0424\u0423\u041d\u041a\u0426\u0406\u0419 \u041f\u0420\u041e\u0413\u0420\u0410\u041c\u0418",matrixReadCodes:"\u0427\u0438\u0442\u0430\u043d\u043d\u044f \u0442\u0430 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f \u043a\u043e\u0434\u0456\u0432 \u043f\u043e\u043c\u0438\u043b\u043e\u043a",matrixLiveSensors:"\u041c\u043e\u043d\u0456\u0442\u043e\u0440\u0438\u043d\u0433 \u0434\u0430\u0442\u0447\u0438\u043a\u0456\u0432 \u0443 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0430\u0441\u0456",matrixBattery:"\u0422\u0435\u0441\u0442 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 / \u043d\u0430\u043f\u0440\u0443\u0433\u0438",matrixHighSpeed:"\u0412\u0438\u0441\u043e\u043a\u043e\u0448\u0432\u0438\u0434\u043a\u0456\u0441\u043d\u0430 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u044f",matrixCoding:"\u041a\u043e\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0456\u0457 \u0415\u0411\u0423",active:"\u0410\u043a\u0442\u0438\u0432\u043d\u0438\u0439",degraded:"\u0417\u043d\u0438\u0436\u0435\u043d\u0438\u0439",locked:"\u0417\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0438\u0439",warning:"\u0411\u041b\u041e\u041a\u0423\u0412\u0410\u041d\u041d\u042f \u0411\u0415\u0417\u041f\u0415\u041a\u0418:",lockExplain:"\u0412\u0430\u0448 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u044f\u043a \u043a\u043b\u043e\u043d\u043e\u0432\u0430\u043d\u0438\u0439/\u043f\u0456\u0434\u0440\u043e\u0431\u043b\u0435\u043d\u0438\u0439 \u0447\u0456\u043f. \u041e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u043a\u043b\u043e\u043d\u043e\u0432\u0430\u043d\u0456 \u0430\u0434\u0430\u043