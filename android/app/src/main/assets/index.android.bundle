u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445. Bluetooth \u043d\u0435 \u0432\u043c\u0438\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u043d\u0430 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445 iOS.",iosBleOnly:"\u041f\u0440\u0438\u043c\u0456\u0442\u043a\u0430: \u041f\u0440\u0438\u0441\u0442\u0440\u043e\u0457 iOS \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c \u043b\u0438\u0448\u0435 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438 OBD2 BLE (Bluetooth Low Energy). \u041a\u043b\u0430\u0441\u0438\u0447\u043d\u0456 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438 Bluetooth \u043d\u0435 \u043c\u043e\u0436\u0443\u0442\u044c \u0431\u0443\u0442\u0438 \u0441\u043a\u0430\u043d\u043e\u0432\u0430\u043d\u0456.",androidClassicHint:"\u041f\u0440\u0438\u043c\u0456\u0442\u043a\u0430: \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0456 (\u043a\u043b\u0430\u0441\u0438\u0447\u043d\u0456) \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438 Bluetooth OBD2 \u043c\u0430\u044e\u0442\u044c \u0431\u0443\u0442\u0438 \u0437\u2019\u0454\u0434\u043d\u0430\u043d\u0456 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 Android Bluetooth, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u0432\u043e\u043d\u0438 \u0437\u2019\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f.",deviceNotPairedTitle:"\u041f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0440\u043e\u0437\u2019\u0454\u0434\u043d\u0430\u043d\u0438\u0439",deviceNotPairedDesc:"\u041f\u0435\u0440\u0448 \u043d\u0456\u0436 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0430\u0442\u0438 \u043a\u043b\u0430\u0441\u0438\u0447\u043d\u0456 Bluetooth-\u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438 OBD2, \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043f\u0430\u0440\u0443 \u0437 \u043d\u0438\u043c\u0438 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 Bluetooth \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443. \u0412\u0438 \u043f\u0435\u0440\u0435\u0439\u0434\u0435\u0442\u0435 \u0434\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u0438.",unsupportedDeviceTitle:"\u041d\u0435\u0441\u0443\u043c\u0456\u0441\u043d\u0435 \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f",unsupportedDeviceDesc:"\u041f\u0440\u0438\u0441\u0442\u0440\u0456\u0439, \u044f\u043a\u0438\u0439 \u0432\u0438 \u043d\u0430\u043c\u0430\u0433\u0430\u0454\u0442\u0435\u0441\u044f \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0438, \u043d\u0435 \u0454 \u0441\u0443\u043c\u0456\u0441\u043d\u0438\u043c \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u043e\u043c OBD2 \u0430\u0431\u043e \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0456 \u0441\u043b\u0443\u0436\u0431\u0438.",sendButton:"\u041d\u0410\u0414\u0406\u0421\u041b\u0410\u0422\u0418",connectDevice:"\u041f\u0406\u0414\u041a\u041b\u042e\u0427\u0418\u0422\u0418\u0421\u042f \u0414\u041e OBD2 \u041f\u0420\u0418\u0421\u0422\u0420\u041e\u042e",adapterApproved:"\u0410\u0414\u0410\u041f\u0422\u0415\u0420 \u0417\u0410\u0422\u0412\u0415\u0420\u0414\u0416\u0415\u041d\u041e. \u0410\u041d\u0410\u041b\u0406\u0417 \u041c\u041e\u0416\u041b\u0418\u0412\u041e\u0421\u0422\u0415\u0419... [2/5]",protocolNegotiating:"\u041f\u0420\u041e\u0422\u041e\u041a\u041e\u041b \u0421\u041a\u0410\u041d\u0423\u0412\u0410\u041d\u041d\u042f \u0422\u0410 \u041f\u0420\u041e\u0411\u0423\u0414\u0416\u0415\u041d\u041d\u042f... [3/5]",ecuDetected:"\u0415\u0411\u0423 \u0412\u0418\u042f\u0412\u041b\u0415\u041d\u041e, \u041f\u0415\u0420\u0415\u0412\u0406\u0420\u041a\u0410... [4/5]",ecuResponding:"\u0415\u0411\u0423 \u0412\u0406\u0414\u041f\u041e\u0412\u0406\u0414\u0410\u0412, \u041f\u0406\u0414\u041a\u041b\u042e\u0427\u0415\u041d\u041d\u042f \u0417\u0410\u0412\u0415\u0420\u0428\u0410\u0404\u0422\u042c\u0421\u042f... [5/5]",protocolScanningHint:"(\u041f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0435 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438\u0445 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0456\u0432 SP5, SP3, SP6, SP7...)",protocolFailed:" \u0421\u0423\u041c\u0406\u0421\u041d\u0418\u0419 \u041f\u0420\u041e\u0422\u041e\u041a\u041e\u041b \u041d\u0415 \u0417\u041d\u0410\u0419\u0414\u0415\u041d\u041e! (\u0432\u0438\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u043d\u043e SP5, SP3, SP4, SP6, SP7)",ecuNotFound:" \u0415\u0411\u0423 \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0406\u041b\u042f \u041d\u0415 \u0412\u0406\u0414\u041f\u041e\u0412\u0406\u0414\u0410\u0404!",hardwareCapabilityScore:"\u041e\u0446\u0456\u043d\u043a\u0430 \u0430\u043f\u0430\u0440\u0430\u0442\u043d\u0438\u0445 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430: {{score}}/100",hardwareFatal:"\u041a\u0440\u0438\u0442\u0438\u0447\u043d\u0430 \u043f\u043e\u043c\u0438\u043b\u043a\u0430: \u0432\u0430\u0448\u0435 \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f \u0454 \u043f\u0456\u0434\u0440\u043e\u0431\u043b\u0435\u043d\u0438\u043c \u043a\u043b\u043e\u043d\u043e\u043c, \u044f\u043a\u0438\u0439 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0438 \u0441\u0442\u0430\u0440\u0456\u0448\u0438\u0445 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u0445 \u0437\u0430\u0441\u043e\u0431\u0456\u0432. \u041d\u0435 \u0432\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0438\u0441\u044f \u0434\u043e \u0415\u0411\u0423 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0440\u0438\u0434\u0431\u0430\u0439\u0442\u0435 \u044f\u043a\u0456\u0441\u043d\u0438\u0439 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 (v1.5 \u0430\u0431\u043e \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0438\u0439).",progressFormat:"{{progress}}%",btDisabled:"Bluetooth \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e",btDisabledDesc:"\u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c Bluetooth \u0434\u043b\u044f \u043f\u043e\u0448\u0443\u043a\u0443 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0456\u0432 OBD2.",btDescIos:"\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0447\u0435\u0440\u0435\u0437 BLE OBD2 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438 (Veepeak, vLinker).",btDescAndroid:"\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0447\u0435\u0440\u0435\u0437 Classic Bluetooth \u0430\u0431\u043e BLE \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438.",wifiDesc:"\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0434\u043e Wi-Fi \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0456\u0432 (\u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 192.168.0.10).",wifiGuide:"\u0414\u043b\u044f \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0434\u043e Wi-Fi \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430 \u0437\u0430\u0439\u0434\u0456\u0442\u044c \u0443 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f Wi-Fi \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0456 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043c\u0435\u0440\u0435\u0436\u0443 OBD-\u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430 (\u043d\u0430\u043f\u0440. OBDII, V-LINK). \u041f\u043e\u0442\u0456\u043c \u043f\u043e\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f \u0441\u044e\u0434\u0438.",openWifiSettings:"\u0412\u0406\u0414\u041a\u0420\u0418\u0422\u0418 \u041d\u0410\u041b\u0410\u0428\u0422\u0423\u0412\u0410\u041d\u041d\u042f WI-FI",connectWifi:"\u041f\u0406\u0414\u041a\u041b\u042e\u0427\u0418\u0422\u0418\u0421\u042c \u041f\u041e WI-FI",pairRequired:"\u0421\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e OBD2",pairRequiredDesc:"Android \u043c\u043e\u0436\u0435 \u0437\u0430\u043f\u0440\u043e\u0441\u0438\u0442\u0438 \u0441\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044f, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u0438 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0430\u0454\u0442\u0435\u0441\u044c \u0432\u043f\u0435\u0440\u0448\u0435. PIN-\u043a\u043e\u0434 \u0441\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0442\u0430\u043a\u0438\u0439:",pairNow:"\u0421\u041f\u041e\u041b\u0423\u0427\u0418\u0422\u0418 \u0422\u0410 \u041f\u0406\u0414\u041a\u041b\u042e\u0427\u0418\u0422\u0418",pairingFailed:"\u0421\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f. \u0412\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0441\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u0432\u0440\u0443\u0447\u043d\u0443 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 Android.",successVin:"\u0417'\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e. \u041f\u0440\u043e\u0444\u0456\u043b\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043e.",cloneWarning:"\u0412\u0438\u044f\u0432\u043b\u0435\u043d\u043e \u043d\u0435\u0441\u0443\u043c\u0456\u0441\u043d\u0438\u0439 \u043a\u043b\u043e\u043d\u043e\u0432\u0430\u043d\u0438\u0439 \u0430\u0434\u0430\u043f\u0442\u0435\u0440. \u0420\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u043a\u043e\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u043e \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0457 \u0431\u0435\u0437\u043f\u0435\u043a\u0438.",viewHealth:"\u041c\u0415\u041d\u042e \u0414\u0406\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0418 OBD2",statusPrompt:"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0431\u0430\u0436\u0430\u043d\u0438\u0439 \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f OBD2.",scanHintIos:"\u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e BLE OBD2 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e \u0456 \u0432\u0456\u043d \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043f\u043e\u0440\u0443\u0447 \u0437 \u0432\u0430\u0448\u0438\u043c iOS-\u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0454\u043c.",scanHintAndroid:"\u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e Bluetooth \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u0456 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 \u0433\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u0441\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044f.",negotiating:"\u0423\u0417\u0413\u041e\u0414\u0416\u0415\u041d\u041d\u042f OBD2 \u0420\u0423\u041a\u041e\u0421\u0422\u0418\u0421\u041a\u0410\u041d\u041d\u042f",failed:"\u0421\u041f\u0420\u041e\u0411\u0410 \u041f\u0406\u0414\u041a\u041b\u042e\u0427\u0415\u041d\u041d\u042f \u041d\u0415 \u0412\u0414\u0410\u041b\u0410\u0421\u042f",errLayer1:"\u0423\u0441\u0443\u043d\u0435\u043d\u043d\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439: Bluetooth \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e.",errLayer2:"\u0423\u0441\u0443\u043d\u0435\u043d\u043d\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439: \u0422\u0430\u0439\u043c-\u0430\u0443\u0442 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0430\u0434\u0430\u043f\u0442\u0435\u0440 \u0449\u0456\u043b\u044c\u043d\u043e \u0432\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0443 \u043f\u043e\u0440\u0442 OBD2 \u0456 \u0433\u043e\u0440\u0438\u0442\u044c \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0436\u0438\u0432\u043b\u0435\u043d\u043d\u044f.",errLayer5:"\u0423\u0441\u0443\u043d\u0435\u043d\u043d\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439: \u0423\u0437\u0433\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443 OBD2 \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0437\u0430\u043c\u043e\u043a \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0432 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u0456 ON (\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0438\u0439 \u0434\u0432\u0438\u0433\u0443\u043d).",errLayer6:"\u0423\u0441\u0443\u043d\u0435\u043d\u043d\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439: \u0410\u0434\u0430\u043f\u0442\u0435\u0440 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u0430\u043b\u0435 \u0415\u0411\u0423 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u043d\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454. \u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0456\u0442\u044c \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f.",errGeneric:"\u0423\u0441\u0443\u043d\u0435\u043d\u043d\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439: \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0430\u0434\u0430\u043f\u0442\u0435\u0440 \u043c\u0430\u0454 \u0436\u0438\u0432\u043b\u0435\u043d\u043d\u044f, \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e \u0456 \u0436\u043e\u0434\u043d\u0430 \u0456\u043d\u0448\u0430 OBD-\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430 \u043d\u0435 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0430.",stepAdapter:"\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430 \u0442\u0430 \u043e\u0446\u0456\u043d\u043a\u0430 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439",stepProtocol:"\u0423\u0437\u0433\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443 OBD2",stepHandshake:"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0430 \u0437\u0432'\u044f\u0437\u043a\u0443 \u0437 \u0415\u0411\u0423",stepStabilization:"\u0421\u0442\u0430\u0431\u0456\u043b\u0456\u0437\u0430\u0446\u0456\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0446\u0438\u043a\u043b\u0443 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u0457",cancel:"\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438",offline:"OFFLINE",terminalTitle:"OBD \u0422\u0415\u0420\u041c\u0406\u041d\u0410\u041b / \u041a\u041e\u0420\u0418\u0421\u0422\u0423\u0412\u0410\u0426\u042c\u041a\u0418\u0419 \u041a\u041e\u0414",terminalDesc:"\u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u043a\u043e\u043c\u0430\u043d\u0434\u0438 OBD-II \u0430\u0431\u043e AT/ST \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0434\u043e ECU. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \xab010C\xbb (\u043e\u0431\u043e\u0440\u043e\u0442\u0438 \u0434\u0432\u0438\u0433\u0443\u043d\u0430) \u0430\u0431\u043e \xabATRV\xbb (\u043d\u0430\u043f\u0440\u0443\u0433\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0457).",ecuResponseLabel:"\u0412\u0406\u0414\u041f\u041e\u0412\u0406\u0414\u042c ECU:",adapterConnected:"\u0410\u0414\u0410\u041f\u0422\u0415\u0420 \u041f\u0406\u0414\u2019\u0404\u0414\u041d\u0410\u041d\u041e (OK)",lowQualityAdapterWarning:" \u0410\u0434\u0430\u043f\u0442\u0435\u0440 \u043d\u0438\u0437\u044c\u043a\u043e\u0457 \u044f\u043a\u043e\u0441\u0442\u0456 (\u043e\u0446\u0456\u043d\u043a\u0430: {{score}}/100): \u0432\u0430\u0448 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 \u0454 \u043d\u0438\u0437\u044c\u043a\u043e\u044f\u043a\u0456\u0441\u043d\u0438\u043c \u043a\u043b\u043e\u043d\u043e\u043c. \u0419\u043e\u043c\u0443 \u0431\u0440\u0430\u043a\u0443\u0454 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0456 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u0457, \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e\u0457 \u0434\u043b\u044f \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0456\u0432 \u0441\u0442\u0430\u0440\u0438\u0445 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u0445 \u0437\u0430\u0441\u043e\u0431\u0456\u0432 (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, K-Line \u043d\u0430 Dacia, Renault, Fiat, Lada). \u041c\u0438 \u043d\u0430\u0441\u0442\u0456\u0439\u043d\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u043c\u043e \u043e\u043d\u043e\u0432\u0438\u0442\u0438 \u0434\u043e \u0432\u0438\u0441\u043e\u043a\u043e\u044f\u043a\u0456\u0441\u043d\u043e\u0433\u043e \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430 OBD2 (\u0432\u0435\u0440\u0441\u0456\u044f 1.5 \u0430\u0431\u043e \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0438\u0439 OBDLink/vLinker), \u0449\u043e\u0431 \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0438\u0441\u044f.",statusProfiling:"\u0410\u043d\u0430\u043b\u0456\u0437 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430 OBD2...",statusScanningCan:"\u0421\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0443\u0447\u0430\u0441\u043d\u0438\u0445 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0456\u0432 CAN-Bus...",statusScanningKline:"\u041f\u0440\u043e\u0431\u0443\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0456\u0432 K-Line. \u0421\u0442\u0430\u0440\u0456 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456 (Dacia, Renault, Fiat) \u043c\u043e\u0436\u0443\u0442\u044c \u0440\u0435\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0434\u043e 15 \u0441\u0435\u043a\u0443\u043d\u0434...",statusHandshake:"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0430 \u0437\u0432\u2019\u044f\u0437\u043a\u0443 ECU...",statusStabilization:"\u0421\u0442\u0430\u0431\u0456\u043b\u0456\u0437\u0430\u0446\u0456\u044f \u043f\u043e\u0442\u043e\u043a\u0443 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445...",changeType:"\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0442\u0438\u043f \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f",errBluetoothUnavailable:"Bluetooth \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u0430\u0431\u043e \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0438\u0439",errDeviceNotFound:"\u041f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 OBD2 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e",errTimeout:"\u0427\u0430\u0441 \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u045