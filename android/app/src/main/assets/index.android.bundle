"BLUETOOTH-INST\xc4LLNINGAR",firstTimeGuideTitle:"GUIDE F\xd6R F\xd6RSTA PARKOPPLING OCH INST\xc4LLNING",firstTimeGuideDescAndroid:"Parkoppla Bluetooth Classic (ELM327)-adaptrar i telefonens Bluetooth-inst\xe4llningar f\xf6re f\xf6rsta anv\xe4ndning (PIN: 1234 eller 0000). BLE- och Wi-Fi-enheter ansluter direkt.",firstTimeGuideDescIos:"BLE (Bluetooth 4.0+) och Wi-Fi-adaptrar kr\xe4ver ingen parkoppling i telefonens inst\xe4llningar; de uppt\xe4cks och ansluts direkt i appen."},dashboard:{selectDevice:"TRYCK F\xd6R ATT V\xc4LJA ENHET",connectedDevice:"ANSLUTEN ENHET",noConnection:"Ingen anslutning \xe4nnu",batteryLow:"BATTERI SP\xc4NNING \xc4R L\xc5G!",batteryLowDesc:"Batterisp\xe4nningen \xe4r p\xe5{{voltage}}. Starta eller ladda fordonet. ECU-kommunikation kan avbrytas vid l\xe5g sp\xe4nning.",batteryWarn:"BATTERIET BLIVER SVAGT",batteryWarnDesc:"Batterisp\xe4nning{{voltage}}. Var f\xf6rsiktig under l\xe5ngvariga operationer.",rpm:"Motorvarvtal (RPM)",speed:"Fordonshastighet",temp:"TEMPERATUR",throttle:"Gasspj\xe4llsposition",status:"\xd6VERF\xd6RINGSSTATUS",statusHigh:"H\xd6G",statusLow:"L\xc5G",battery:"BATTERI",load:"LADDA",intake:"INTAG LUFT",manifold:"MANIFOLDE kPa",customizeTitle:"DASHBOARD INST\xc4LLNINGAR",customizeSubtitle:"V\xe4lj sensorerna du vill visa p\xe5 sk\xe4rmen (Max. 8).",layoutType:"Layout-stil",layoutGrid:"GITTER",layoutList:"LISTA",customizeButton:"ANPASSA M\xc4TARE",coolant:"Kylarv\xe4tsketemp.",voltage:"Batterisp\xe4nning",engineLoad:"Motorbelastning",intakeAirTemp:"Insugningslufttemp.",manifoldPressure:"Manifoldtryck (MAP)",ambientTemp:"Utomhustemperatur",oilTemp:"Oljetemperatur",mafFlow:"MAF-luftfl\xf6de",timingAdvance:"T\xe4ndningsf\xf6rst\xe4llning",fuelLevel:"Br\xe4nsleniv\xe5",catalystTemp:"Katalysatortemp.",layoutGauge:"M\xc4TARE",obdTerminalTitle:"OBD H\xc4LSA & TERMINAL",adapterClone:"KLONADAPTER",adapterOriginal:"ORIGINAL",adapterCloneShort:"KLON",adapterOriginalShort:"ORIGINAL",pidLabel:"PID: {{pid}}",limitReached:"Urvalsgr\xe4ns",limitReachedDesc:"Du kan v\xe4lja maximalt {{limit}} sensorer med detta protokoll.",customizeSubtitleKLine:"K-Line protokoll anslutet. Du kan v\xe4lja maximalt {{limit}} sensorer.",customizeSubtitleCAN:"CAN-Bus-protokoll anslutet. Du kan v\xe4lja maximalt {{limit}} sensorer.",unit:"Enhet",statusNormal:"NORMAL",layoutChart:"TABELL",adblue:"AdBlue-niv\xe5",egt:"Avgastemperatur (EGT)",nox:"NOx-sensorv\xe4rde",torque:"Motorvridmoment",selectedSensorsCount:"{{count}} / {{max}} sensorer valda"},expertise:{historyFound:"FORDONSHISTORIA HITTAD!",historyFoundDesc:"{{count}}poster f\xf6r detta fordon har skapats tidigare. Du kan granska historiken nedan.",viewHistory:"SE HISTORIEN \u203a",manualVin:"CHASSNUMMER (MANUELL INMATNING)",manualVinDesc:"Om fordonsdatorn inte delar chassinumret (VIN) automatiskt kan du skriva det h\xe4r.",vinPlaceholder:"Skriv VIN...",startScan:"STARTA EXPERT SCAN",scanning:"SKANNAR...",vehicleIdentity:"FORDONS-ID OCH KILAR",vin:"Chassinummer (VIN)",odometer:"Original KM",distSinceCleared:"Felet rensades",milDist:"Motorlampa t\xe4nd",dtcTitle:"Felkoder (DTC)",dtcClean:"INGA FELKODER - RENG\xd6RING",extraActions:"EXTRA TRANSAKTIONER",garageTitle:"GARAGE OCH TIDIGARE REKORD",share:"DELA",saveVehicle:"SPARA DETTA VERKTYG",noRecords:"Det finns inga registrerade fordon \xe4nnu.",clean:"REN",faults:"MISSLYCKANDE",vinRequired:"VIN kr\xe4vs",vinRequiredDesc:"F\xf6r att registrera sig m\xe5ste chassinumret (VIN) visas automatiskt eller skrivas manuellt.",missingInfo:"Information som saknas",missingInfoDesc:"V\xe4nligen fyll i f\xe4ltet M\xe4rke och modell.",saved:"Sparad ",savedDesc:"Den tillkom till garaget som ett resultat av expertis.",connRequired:"Anslutning kr\xe4vs",connRequiredDesc:"Anslut f\xf6rst till fordonet f\xf6r att starta denna process.",chronicFaultsTitle:"Statistiska kroniska problem",chronicFaultsObs:"{{code}}(Observation:{{days}}Annan dag / totalt:{{total}}g\xe5nger)",chronicFaultsPending:"Samla datapool / Analysera statistik",notScanned:"Inte skannat",notScannedDesc:"V\xe4nligen tryck p\xe5 skanningsknappen uppe till h\xf6ger f\xf6r att l\xe4sa diagnostiska koder.",scanFailed:"SKANNING MISLYCKDES",errTimeout:"Error: Connection Timeout (TIMEOUT)\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost (CONNECTION_LOST)\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\n(HARDWARE_FATAL_RECOVERY_FAILED)\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error (ERROR_UNABLE_TO_READ)\nECU trouble codes could not be read.",scannedSystems:"SKANNADE SYSTEM",moduleEngine:"Motorkontrollenhet (ECU)",moduleAbs:"L\xe5sningsfritt bromssystem (ABS)",moduleTcm:"Transmission Control Module (TCM)",moduleBcm:"Body Control Module (BCM)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" S\xc4KERHETSVARNING",safetyWarningDesc:"Under denna process: \u2022 T\xe4ndningen m\xe5ste vara P\xc5 \u2022 Motorn m\xe5ste vara AV \u2022 Starta inte fordonet Vill du forts\xe4tta?",step1:"Steg 1: Radera felkoder",step1Desc:"Alla lagrade felkoder (DTC) och lampan Check Engine kommer att raderas. Trimv\xe4rden f\xf6r br\xe4nsle kommer att \xe5terst\xe4llas. Denna \xe5tg\xe4rd kan inte \xe5ngras!",step2:"Steg 2: ECU h\xe5rd \xe5terst\xe4llning",step2Desc:"En elektrisk \xe5terst\xe4llning (Hard Reset) kommer att skickas till motordatorn. Det fungerar som att ta bort och installera batteriet. Det \xe4r ineffektivt i icke-st\xf6djande ECU:er. Det g\xf6r ingen skada.",clearCodes:"Ta bort koder",ecuReset:"Rensa felkoder",finish:"Hoppa \xf6ver (Slutf\xf6r)",completed:"Avslutad ",completedDesc:"Serviceverksamheten har slutf\xf6rts framg\xe5ngsrikt. Du kan starta om fordonet.",hardResetDesc:"Alla service\xe5tg\xe4rder har slutf\xf6rts framg\xe5ngsrikt. \u2022 Felkoder raderade \u2022 Br\xe4nsletrim \xe5terst\xe4lls \u2022 ECU-\xe5terst\xe4llning Du kan starta om fordonet."},info:{desc:"Professionell motorcykel- och fordonsdiagnostikapplikation. Kompatibel med alla fordon.",upgrade:" Uppgradera till Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"Tidig tillg\xe5ng ",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner \xe4r f\xf6r n\xe4rvarande under utveckling. Eftersom du \xe4r v\xe5r tidiga anv\xe4ndare \xe4r alla proffsfunktioner tillg\xe4ngliga f\xf6r dig nu. Din feedback \xe4r mycket v\xe4rdefull f\xf6r oss!",helpGuide:"HJ\xc4LP OCH GUIDE",language:" Spr\xe5k / Spr\xe5k / Bahasa",support:"SUPPORTCENTER",supportSubject:"Cortex OBD2 Diagnostic Scanner Support och Feedback",thanks:"Tack!",thanksDesc:"Tack f\xf6r din feedback. Du kan l\xe4mna oss en kommentar p\xe5 Play Store.",sections:{live:{title:"LIVE \xd6VERVAKNINGSSENSORER",content:"Du kan omedelbart \xf6vervaka varvtal, hastighet, motortemperatur, gasspj\xe4llsl\xe4ge, batterisp\xe4nning, motorbelastning, insugningslufttemperatur och grenr\xf6rstryck (MAP). V\xe4rden uppdateras 1-5 g\xe5nger per sekund beroende p\xe5 din Bluetooth-hastighet. Du kan direkt ingripa i fordonet med UDS / OBD-kommandon via terminalen."},expertise:{title:"UNDERS\xd6KNING OCH GARANTI",content:"Applikationen anv\xe4nder ECU (Brain)-koder f\xf6r att uppt\xe4cka fel. VIN-numret (VIN) och den aktuella k\xf6rstr\xe4ckan som registrerats p\xe5 fordonet registreras. Dessutom best\xe4ms tidigare fel genom att ber\xe4kna hur l\xe5ngt fordonet har f\xe4rdats med Check Engine-lampan. Den resulterande rapporten kan delas i PDF- och meddelandemilj\xf6er."},tests:{title:"BATTERI / PRESTANDA TEST",content:"Batteritestning har 3 steg: tester f\xf6r vila, start och tomg\xe5ngsladdning m\xe4ter ditt batteri/regulators h\xe4lsa. Prestandatestet m\xe4ter accelerationsv\xe4rdena 0-60 och 0-100 km/h med en felmarginal p\xe5 50ms, med hj\xe4lp av momentana hastighetsdata fr\xe5n din telefons processor och ditt fordon."},hardware:{title:"H\xc5RDVARUKOMPATIBILITET",content:"ELM327 Bluetooth (v1.5) rekommenderas. Vissa avancerade koder kanske inte fungerar p\xe5 h\xe5rdvara av d\xe5lig kvalitet med version 2.1 CLONE. Du f\xe5r den snabbaste hastigheten med premiumadaptrar som vLinker och OBDLink."},warnings:{title:"VIKTIGA VARNINGAR",content:"\u2022 T\xe4ndningen m\xe5ste vara P\xc5 och motorn AV under processen f\xf6r radering av felkoder eller ECU-\xe5terst\xe4llningsfunktionen. \u2022 Skicka inte en \xe5terst\xe4llning till ett k\xf6rande fordon. \u2022 Alla fordon kanske inte st\xf6der alla sensorer, sensorer som inte st\xf6ds kommer att visa \"--\"."},onboarding:{title:"JURIDISKT TILLST\xc5ND OCH ANONYM TELEMETRI",content:"F\xf6r att f\xf6rb\xe4ttra applikationskvaliteten och fordonskompatibiliteten; Helt anonymiserade motorparametrar och felkoder som genereras under feldiagnostik (utan att inneh\xe5lla personuppgifter och chassinummer) kan analyseras p\xe5 v\xe5ra s\xe4kra servrar. Genom att forts\xe4tta godk\xe4nner du dessa anonyma telemetrivillkor. Bluetooth och platsbeh\xf6righet kr\xe4vs f\xf6r att kommunicera med din motorcykels ECU."},featureCoding:{title:"DOLDA FUNKTIONSL\xc5SNING & UDS-KODNING",content:"Drivs av v\xe5r ISO 14229 UDS Protocol Engine, v\xe4xlar s\xe4kert funktioner som US Parking Lights, Needle Sweep, Horn Ack Lock, Comfort Windows och DRL-inst\xe4llningar f\xf6r VAG, BMW, Renault och Dacia-fordon."},multiEcu:{title:"MULTI-ECU SCANNING AV ALL MODUL",content:"Skanna och rensa felkoder bortom motorns styrenhet \u2014 inklusive ABS, krockkudde, automatisk v\xe4xell\xe5da (TCU), instrumentgrupp, klimatkontroll (HVAC) och kroppskontrollmoduler (BCM)."},advancedDiagnostics:{title:"DCT-ANPASSNING, DPF & HP POWER GAUGE",content:"\u2022 DCT / DSG Clutch Kiss Point Learning & Adaptation Reset\n\u2022 DPF-sotbelastning (%/g) & temperatur\xf6vervakning av avgasregenerering\n\u2022 Kort-/l\xe5ngtidsbr\xe4nsletrim i realtid (STFT/LTFT) & Lambdaanalys\n\u2022 Dynamisk h\xe4stkrafter (HP) & vridmoment (Nm) live telemetrigraf"},demoMode:{title:"DEMO-L\xc4GE (SIMULERING)",content:"Testa och utforska appen utan fysisk OBD2-h\xe5rdvara. Upplev fullst\xe4ndiga CAN-Bus och UDS diagnostiska funktioner med realistisk telemetrisimulering i realtid."}},reconfigurePermissions:"Visa tillst\xe5nd och juridiska villkor igen",shareWithFriend:"DELA MED EN V\xc4N",shareMessageText:"Uppt\xe4ck fordonets ECU-felkoder och levande sensortelemetri med Cortex OBD2 Diagnostic Scanner!\n\nLadda ner nu:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:" \u2550\u2550\u2550 CORTEX OBD2 DIAGNOSTISK RAPPORT \u2550\u2550\u2550 ",vehicleIdentity:" FORDONS-ID",vin:"Chassinummer (VIN)",odometer:"Avst\xe5nd (KM)",milDist:"Motorlampa t\xe4nd",distSinceCleared:"Felet rensades",dtcCount:" FELKODER ({{count}}kvantitet)",sensorData:" LIVE SENSORDATA",noData:"Det gick inte att l\xe4sa data",proApp:"Skannat med Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"datum",vinNotFound:"Inte uppt\xe4ckt",noDtcs:"INGA FELKODER - RENG\xd6RING",speed:"hastighet",coolant:"Motortemperatur",throttle:"gas",engineLoad:"Motorbelastning",intakeAir:"Insugsluft",manifold:"F\xf6rgreningsr\xf6r",voltage:"Batterisp\xe4nning",shareMessage:"F\xf6lj statusen f\xf6r din motorcykel fr\xe5n fickan med Motocortex OBD2 Diagnostic Application! Ladda ner: https://cortexobd2.app",subtitle:"Omfattande andrahandsdiagnostik och telemetriinspektion",vehicleInfo:"Fordonsidentifiering & ECU-metadata",healthScore:"Totalt ECU-h\xe4lsoresultat",dtcSection:"Diagnostiska felkoder (DTC-revision)",telemetrySection:"Live Telemetri & Sensor Snapshot",maintenanceSection:"Ak\u0131ll\u0131 Garaj Service- och underh\xe5llshistorik",aiSection:"AI-l\xe4kare \xf6vergripande tillst\xe5ndsanalys",noFaults:"Inga aktiva eller historiska felkoder lagrade i ECU-minnet.",noMaintenance:"Inga registrerade serviceinl\xe4gg i Ak\u0131ll\u0131 Garaj.",disclaimer:"Ansvarsfriskr