0942\u0925 OBD2 \u090f\u0921\u0947\u092a\u094d\u091f\u0930 \u0915\u094b \u0938\u094d\u0915\u0948\u0928 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u090f\u0902\u0921\u094d\u0930\u0949\u0907\u0921 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",deviceNotPairedTitle:"\u0921\u093f\u0935\u093e\u0907\u0938 \u0905\u092f\u0941\u0917\u094d\u092e\u093f\u0924",deviceNotPairedDesc:"\u0915\u094d\u0932\u093e\u0938\u093f\u0915 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 OBD2 \u090f\u0921\u0947\u092a\u094d\u091f\u0930 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947, \u0906\u092a\u0915\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u0915\u0940 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947 \u092a\u0947\u092f\u0930 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0906\u092a\u0915\u094b \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092a\u0930 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",unsupportedDeviceTitle:"\u0905\u0938\u0902\u0917\u0924 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930",unsupportedDeviceDesc:"\u091c\u093f\u0938 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u094b \u0906\u092a \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0935\u0939 \u0938\u0902\u0917\u0924 OBD2 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u092f\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",sendButton:"\u092d\u0947\u091c\u0947\u0902",connectDevice:"OBD2 \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902",adapterApproved:"\u090f\u0921\u0949\u092a\u094d\u091f\u0930 \u0938\u094d\u0935\u0940\u0915\u0943\u0924. \u0915\u094d\u0937\u092e\u0924\u093e\u0913\u0902 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923... [2/5]",protocolNegotiating:"\u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0915\u094b \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0928\u093e \u0914\u0930 \u091c\u093e\u0917\u0928\u093e... [3/5]",ecuDetected:"\u0908\u0938\u0940\u092f\u0942 \u0928\u0947 \u092a\u0924\u093e \u0932\u0917\u093e\u092f\u093e, \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948... [4/5]",ecuResponding:"\u0908\u0938\u0940\u092f\u0942 \u0928\u0947 \u091c\u0935\u093e\u092c \u0926\u093f\u092f\u093e, \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092a\u0942\u0930\u093e \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948... [5/5]",protocolScanningHint:"(\u092e\u093e\u0928\u0915 SP5, SP3, SP6, SP7 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0915\u094b \u0915\u094d\u0930\u092e\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0928\u093e...)",protocolFailed:"\u0938\u0902\u0917\u0924 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e! (SP5, SP3, SP4, SP6, SP7 \u0906\u091c\u093c\u092e\u093e\u092f\u093e \u0917\u092f\u093e)",ecuNotFound:" \u0935\u093e\u0939\u0928 \u0908\u0938\u0940\u092f\u0942 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0926\u0947 \u0930\u0939\u093e!",hardwareCapabilityScore:"\u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0915\u094d\u0937\u092e\u0924\u093e \u0938\u094d\u0915\u094b\u0930: {{score}}/100",hardwareFatal:"\u0917\u0902\u092d\u0940\u0930 \u0924\u094d\u0930\u0941\u091f\u093f: \u0906\u092a\u0915\u093e \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u090f\u0915 \u0928\u0915\u0932\u0940 \u0915\u094d\u0932\u094b\u0928 \u0939\u0948 \u091c\u094b \u092a\u0941\u0930\u093e\u0928\u0947 \u0935\u093e\u0939\u0928 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0935\u093e\u0939\u0928 ECU \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u093e. \u0915\u0943\u092a\u092f\u093e \u090f\u0915 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u090f\u0921\u093e\u092a\u094d\u091f\u0930 (v1.5 \u092f\u093e \u092e\u0942\u0932) \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0964",progressFormat:"{{progress}}%",btDisabled:"\u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0905\u0915\u094d\u0937\u092e \u0939\u0948",btDisabledDesc:"OBD2 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0916\u094b\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964",btDescIos:"BLE OBD2 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 (Veepeak, vLinker) \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0964",btDescAndroid:"Classic Bluetooth \u092f\u093e BLE \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0964",wifiDesc:"Wi-Fi \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902 (\u0906\u092e\u0924\u094c\u0930 \u092a\u0930 192.168.0.10)\u0964",wifiGuide:"Wi-Fi \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 Wi-Fi \u0938\u0947\u091f\u093f\u0902\u0917 \u092a\u0930 \u091c\u093e\u090f\u0902 \u0914\u0930 OBD \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u091a\u0941\u0928\u0947\u0902 (\u091c\u0948\u0938\u0947 OBDII, V-LINK)\u0964 \u092b\u093f\u0930 \u092f\u0939\u093e\u0902 \u0935\u093e\u092a\u0938 \u0906\u090f\u0902\u0964",openWifiSettings:"WI-FI \u0938\u0947\u091f\u093f\u0902\u0917 \u0916\u094b\u0932\u0947\u0902",connectWifi:"WI-FI \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902",pairRequired:"OBD2 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0947\u092f\u0930\u093f\u0902\u0917",pairRequiredDesc:"Android \u092a\u0947\u092f\u0930\u093f\u0902\u0917 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0906\u092a \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092a\u0947\u092f\u0930\u093f\u0902\u0917 PIN \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0939\u0948:",pairNow:"\u092a\u0947\u092f\u0930 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902",pairingFailed:"\u092a\u0947\u092f\u0930\u093f\u0902\u0917 \u0935\u093f\u092b\u0932 \u0939\u0941\u0908\u0964 Android \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0902 \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0930\u0942\u092a \u0938\u0947 \u092a\u0947\u092f\u0930 \u0915\u0930\u0947\u0902\u0964",successVin:"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0939\u0941\u0906\u0964 \u0935\u093e\u0939\u0928 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0939\u091a\u093e\u0928\u093e \u0917\u092f\u093e\u0964",cloneWarning:"\u0905\u0938\u0902\u0917\u0924 \u0915\u094d\u0932\u094b\u0928 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u092e\u093f\u0932\u093e\u0964 \u0906\u092a\u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0909\u0928\u094d\u0928\u0924 \u0915\u094b\u0921\u093f\u0902\u0917 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0902 \u0932\u0949\u0915 \u0939\u0948\u0902\u0964",viewHealth:"OBD2 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0914\u0930 \u0915\u094d\u0937\u092e\u0924\u093e \u092e\u0947\u0928\u0942",statusPrompt:"\u0928\u0940\u091a\u0947 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e OBD2 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0907\u0902\u091f\u0930\u092b\u093c\u0947\u0938 \u091a\u0941\u0928\u0947\u0902\u0964",scanHintIos:"\u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f BLE OBD2 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u091a\u093e\u0932\u0942 \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u0947 iOS \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0939\u0948\u0964",scanHintAndroid:"\u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948 \u0914\u0930 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u092a\u0947\u092f\u0930\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964",negotiating:"OBD2 \u0939\u0948\u0902\u0921\u0936\u0947\u0915 \u092c\u093e\u0924\u091a\u0940\u0924 \u091c\u093e\u0930\u0940 \u0939\u0948",failed:"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0935\u093f\u092b\u0932 \u0939\u0941\u0906",errLayer1:"\u0938\u092e\u0938\u094d\u092f\u093e \u0928\u093f\u0935\u093e\u0930\u0923: \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0905\u0915\u094d\u0937\u092e \u0939\u0948\u0964 \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0902 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964",errLayer2:"\u0938\u092e\u0938\u094d\u092f\u093e \u0928\u093f\u0935\u093e\u0930\u0923: \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091f\u093e\u0907\u092e\u0906\u0909\u091f\u0964 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u090f\u0921\u093e\u092a\u094d\u091f\u0930 OBD2 \u092a\u094b\u0930\u094d\u091f \u092e\u0947\u0902 \u092e\u091c\u092c\u0942\u0924\u0940 \u0938\u0947 \u0932\u0917\u093e \u0939\u094b \u0914\u0930 \u092a\u093e\u0935\u0930 \u0907\u0902\u0921\u093f\u0915\u0947\u091f\u0930 \u091c\u0932 \u0930\u0939\u093e \u0939\u094b\u0964",errLayer5:"\u0938\u092e\u0938\u094d\u092f\u093e \u0928\u093f\u0935\u093e\u0930\u0923: OBD2 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u092c\u093e\u0924\u091a\u0940\u0924 \u0935\u093f\u092b\u0932\u0964 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0935\u093e\u0939\u0928 \u0915\u0940 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 ON \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0939\u094b (\u0907\u0902\u091c\u0928 \u091a\u093e\u0932\u0942 \u0930\u0939\u0928\u093e \u0905\u0928\u0941\u0936\u0902\u0938\u093f\u0924 \u0939\u0948)\u0964",errLayer6:"\u0938\u092e\u0938\u094d\u092f\u093e \u0928\u093f\u0935\u093e\u0930\u0923: \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0935\u093e\u0939\u0928 ECU \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0926\u0947 \u0930\u0939\u093e\u0964 \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902 \u092f\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092a\u0941\u0928\u0903 \u0906\u0930\u0902\u092d \u0915\u0930\u0947\u0902\u0964",errGeneric:"\u0938\u092e\u0938\u094d\u092f\u093e \u0928\u093f\u0935\u093e\u0930\u0923: \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u092e\u0947\u0902 \u092c\u093f\u091c\u0932\u0940 \u0939\u0948, \u0907\u0917\u094d\u0928\u093f\u0936\u0928 ON \u0939\u0948 \u0914\u0930 \u0915\u094b\u0908 \u0905\u0928\u094d\u092f OBD \u0910\u092a \u0916\u0941\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",stepAdapter:"\u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0914\u0930 \u0915\u094d\u0937\u092e\u0924\u093e \u0938\u094d\u0915\u094b\u0930",stepProtocol:"OBD2 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u092c\u093e\u0924\u091a\u0940\u0924",stepHandshake:"ECU \u0938\u0902\u091a\u093e\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u0928",stepStabilization:"\u0938\u0915\u094d\u0930\u093f\u092f \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0932\u0942\u092a \u0938\u094d\u0925\u093f\u0930\u0940\u0915\u0930\u0923",cancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902",terminalTitle:"\u0913\u092c\u0940\u0921\u0940 \u091f\u0930\u094d\u092e\u093f\u0928\u0932/\u0915\u0938\u094d\u091f\u092e \u0915\u094b\u0921",terminalDesc:"\u0906\u092a OBD-II \u092f\u093e AT/ST \u0915\u092e\u093e\u0902\u0921 \u0938\u0940\u0927\u0947 ECU \u0915\u094b \u092d\u0947\u091c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f, \"010C\" (\u0907\u0902\u091c\u0928 RPM) \u092f\u093e \"ATRV\" (\u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c)\u0964",ecuResponseLabel:"\u0908\u0938\u0940\u092f\u0942 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e:",adapterConnected:"\u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0915\u0928\u0947\u0915\u094d\u091f\u0947\u0921 (\u0920\u0940\u0915)",lowQualityAdapterWarning:" \u0928\u093f\u092e\u094d\u0928 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0935\u093e\u0932\u093e \u090f\u0921\u093e\u092a\u094d\u091f\u0930 (\u0938\u094d\u0915\u094b\u0930: {{score}}/100): \u0906\u092a\u0915\u093e \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0928\u093f\u092e\u094d\u0928-\u0936\u094d\u0930\u0947\u0923\u0940 \u0915\u093e \u0915\u094d\u0932\u094b\u0928 \u0939\u0948\u0964 \u0907\u0938\u092e\u0947\u0902 \u092a\u0941\u0930\u093e\u0928\u0947 \u0935\u093e\u0939\u0928 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 (\u091c\u0948\u0938\u0947 \u0921\u0947\u0938\u093f\u092f\u093e, \u0930\u0947\u0928\u0949\u0932\u094d\u091f, \u092b\u093f\u090f\u091f, \u0932\u093e\u0921\u093e \u092a\u0930 \u0915\u0947-\u0932\u093e\u0907\u0928) \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u092e\u092f \u0938\u091f\u0940\u0915\u0924\u093e \u0915\u093e \u0905\u092d\u093e\u0935 \u0939\u0948\u0964 \u0939\u092e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u091a\u094d\u091a-\u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0935\u093e\u0932\u0947 OBD2 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 (v1.5 \u092f\u093e \u092e\u0942\u0932 OBDLink/vLinker) \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0905\u0928\u0941\u0936\u0902\u0938\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",statusProfiling:"OBD2 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0915\u094d\u0937\u092e\u0924\u093e\u0913\u0902 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",statusScanningCan:"\u0906\u0927\u0941\u0928\u093f\u0915 CAN-\u092c\u0938 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0915\u094b \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0928\u093e...",statusScanningKline:"\u0915\u0947-\u0932\u093e\u0907\u0928 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0915\u094b \u091c\u093e\u0917\u0943\u0924 \u0915\u0930\u0928\u093e\u0964 \u092a\u0941\u0930\u093e\u0928\u0947 \u0935\u093e\u0939\u0928\u094b\u0902 (\u0921\u0947\u0938\u093f\u092f\u093e, \u0930\u0947\u0928\u0949\u0932\u094d\u091f, \u092b\u093f\u090f\u091f) \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0926\u0947\u0928\u0947 \u092e\u0947\u0902 15 \u0938\u0947\u0915\u0902\u0921 \u0924\u0915 \u0915\u093e \u0938\u092e\u092f \u0932\u0917 \u0938\u0915\u0924\u093e \u0939\u0948...",statusHandshake:"\u0908\u0938\u0940\u092f\u0942 \u0938\u0902\u091a\u093e\u0930 \u0915\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",statusStabilization:"\u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0921\u0947\u091f\u093e \u0938\u094d\u091f\u094d\u0930\u0940\u092e \u0915\u094b \u0938\u094d\u0925\u093f\u0930 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",changeType:"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092a\u094d\u0930\u0915\u093e\u0930 \u092c\u0926\u0932\u0947\u0902",errBluetoothUnavailable:"\u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u092f\u093e \u0905\u0915\u094d\u0937\u092e \u0939\u0948",errDeviceNotFound:"OBD2 \u0921\u093f\u0935\u093e\u0907\u0938 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e",errTimeout:"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u0938\u092e\u092f \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u0917\u092f\u093e",errProtocolFailed:"OBD2 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0935\u093e\u0930\u094d\u0924\u093e \u0935\u093f\u092b\u0932 \u0930\u093