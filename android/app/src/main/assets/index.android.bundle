ity."},toyota_bsm_timing:{name:"Blind Spot Monitor Warning Warning Timing",desc:"Adjusts blind spot side mirror warning light illumination timing."},toyota_ac_noise_reduction:{name:"A/C Compressor Blower Noise Reduction Mode",desc:"Limits maximum air conditioning blower fan speed for cabin quietness."},toyota_sflow_control:{name:"S-Flow Smart Climate Single-Occupant Mode",desc:"Directs A/C airflow exclusively to occupied seats based on weight sensors."},toyota_relock_timeout:{name:"Automatic Re-Lock Delay Timer after Remote Unlock",desc:"Adjusts seconds before doors auto-relock if no door is opened."},lexus_mark_levinson_audio_profile:{name:"Mark Levinson Surround Sound DSP Audio Profile",desc:"Optimizes 3D spatial acoustic tuning for Mark Levinson premium speakers."},lexus_ev_mode_beeper_mute:{name:"Low-Speed Pedestrian EV Acoustic Alert Beeper Mute",desc:"Suppresses low speed electric mode synthetic exterior chime."},lexus_easy_access_seat:{name:"Easy Access Steering Wheel & Power Seat Slide-Back",desc:"Slides driver seat back and tilts steering wheel away for easy entry/exit."},nissan_epower_regen_mode:{name:"e-POWER One-Pedal Regenerative Braking Mode",desc:"Sets default e-Pedal regenerative braking deceleration level."},nissan_propilot_assist_timing:{name:"ProPILOT Lane Centering Assist Steering Sensitivity",desc:"Configures ProPILOT steering intervention sharpness."},nissan_intelligent_around_view:{name:"Around View Monitor Auto-Pop-Up at Low Speed",desc:"Triggers 360-degree camera display when front parking sensors detect obstacles."},mazda_g_vectoring_display:{name:"G-Vectoring Control Plus Dynamic Visualizer",desc:"Displays real-time GVC+ cornering torque vectoring graph on instrument panel."},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP Brake Energy Recovery Capacitor Meter",desc:"Shows electric capacitor charge & discharge status on central screen."},mazda_smart_city_brake_sens:{name:"Smart City Brake Support Sensitivity",desc:"Sets low-speed automatic e