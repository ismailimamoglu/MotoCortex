 Module (TCM / DCT)",absName:"ABS / Brake Safety System",srsName:"Airbag / Safety System (SRS)",bcmName:"Body Control Module (BCM)",statusClean:"0 FAULTS (HEALTHY)",statusFault:"{{count}} \u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621",statusNoResponse:"NO RESPONSE / NO HARDWARE",scanHintText:"\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \"SCAN ALL MODULES\" \u0644\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645 \u0639\u0646 \u0631\u0645\u0648\u0632 \u0627\u0644\u0645\u0634\u0627\u0643\u0644 \u0627\u0644\u062a\u0634\u062e\u064a\u0635\u064a\u0629 \u0639\u0628\u0631 \u062c\u0645\u064a\u0639 \u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0631\u0629.",gatewayName:"\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0634\u0628\u0643\u0629 \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629 (Gateway)",ipcName:"\u0644\u0648\u062d\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a (IPC / Cockpit)",epsName:"\u062a\u0648\u062c\u064a\u0647 \u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0645\u0624\u0627\u0632\u0631 (EPS)",hvacName:"\u0627\u0644\u062a\u0643\u064a\u064a\u0641 \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0628\u0627\u0644\u0645\u0646\u0627\u062e (HVAC)",tpmsName:"\u0646\u0638\u0627\u0645 \u0645\u0631\u0627\u0642\u0628\u0629 \u0636\u063a\u0637 \u0627\u0644\u0625\u0637\u0627\u0631\u0627\u062a (TPMS)",bmsName:"\u0646\u0638\u0627\u0645 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 (BMS / EV)",readyTitle:"\u062a\u0634\u062e\u064a\u0635 ECU \u062c\u0627\u0647\u0632"},dct:{title:"\u062a\u0643\u064a\u0641 \u0642\u0627\u0628\u0636 \u0627\u0644\u062a\u0631\u0648\u0633 \u0627\u0644\u0645\u0632\u062f\u0648\u062c DCT",subtitle:"\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0644\u0644\u0642\u0627\u0628\u0636 \u0627\u064