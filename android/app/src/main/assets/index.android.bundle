Spor Egzoz Valfi S\xfcrekli A\xe7\u0131k Override",desc:"Aktif egzoz valflerinin t\xfcm devirlerde %100 a\xe7\u0131k kalmas\u0131n\u0131 sa\u011flar."},audi_drive_select_memory:{name:"Audi Drive Select Mod Haf\u0131zas\u0131",desc:"Kontak yeniden a\xe7\u0131ld\u0131\u011f\u0131nda son aktif S\xfcr\xfc\u015f Profilini korur."},audi_virtual_cockpit_themes:{name:"Audi Virtual Cockpit S/RS Spor Tasar\u0131m Temas\u0131",desc:"Dijital g\xf6sterge panelinde S/RS merkezi devir saati spor grafik temas\u0131n\u0131 a\xe7ar."},vag_epb_service_mode:{name:"Elektronik Park Freni Balata De\u011fi\u015fim Modu",desc:"Arka fren balata ve disk de\u011fi\u015fimi i\xe7in EPB kaliper pistonlar\u0131n\u0131 geriye \xe7eker."},bmw_bms_battery_registration:{name:"Ak\u0131ll\u0131 Ak\xfc Sens\xf6r\xfc Ak\xfc Tan\u0131tma",desc:"Yeni 12V AGM/Sulu ak\xfc de\u011fi\u015fimini motor kontrol \xfcnitesine kaydeder."},bmw_motorrad_service_indicator_reset:{name:"BMW Motorrad Y\u0131ll\u0131k Bak\u0131m & Ya\u011f S\u0131f\u0131rlama",desc:"TFT g\xf6sterge ekran\u0131ndaki y\u0131ll\u0131k bak\u0131m tarihi ve 10.000 km servis uyar\u0131s\u0131n\u0131 siler."},ducati_desmo_service_reset:{name:"Ducati Desmo Supap Bak\u0131m Uyar\u0131s\u0131 S\u0131f\u0131rlama",desc:"15.000 / 30.000 km Desmoservice anahtar ikonu uyar\u0131s\u0131n\u0131 g\xf6stergeden temizler."},byd_bms_isolation_self_test:{name:"BYD Blade Batarya Y\xfcksek Gerilim \u0130zolasyon Testi",desc:"BMS \xfcnitesinde 400V/800V y\xfcksek voltaj sistemi ka\xe7ak ve diren\xe7 te\u015fhisini \xe7al\u0131\u015ft\u0131r\u0131r."},vag_drl_brightness_multi:{name:"G\xfcnd\xfcz Far\u0131 Parlakl\u0131k Ayar\u0131",desc:"Park ve k\u0131sa far modunda LED g\xfcnd\xfcz s\xfcr\xfc\u015f far\u0131 yo\u011funluk seviyesini ayarlar."},bmw_comfort_turn_signal_cycles:{name:"Tek Dokunu\u015f Konfor Sinyali Yan\u0131p S\xf6nme Say\u0131s\u0131",desc:"Sinyal koluna dokunuldu\u011funda lamban\u0131n ka\xe7 kez konfor sinyali verece\u011fini belirler."},vag_st