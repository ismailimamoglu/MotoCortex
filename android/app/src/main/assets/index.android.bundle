Safety:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e",safetyAlertTitle:" \u0915\u092e \u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u091a\u0947\u0924\u093e\u0935\u0928\u0940",safetyAlertMsg:"\u0915\u094b\u0921\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0928\u094d\u092f\u0942\u0928\u0924\u092e 12.2V \u092c\u0948\u091f\u0930\u0940 \u0935\u094b\u0932\u094d\u091f\u0947\u091c \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964\n\u0915\u0943\u092a\u092f\u093e \u091a\u093e\u0930\u094d\u091c\u0930 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902 \u092f\u093e \u0907\u0902\u091c\u0928 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964",items:{vag_staging_needle_sweep:{name:"\u0917\u0947\u091c \u0938\u094d\u091f\u0947\u091c\u093f\u0902\u0917/\u0938\u0941\u0908 \u0938\u094d\u0935\u0940\u092a",desc:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0909\u092a\u0915\u0930\u0923 \u0915\u0940 \u0938\u0941\u0907\u092f\u094b\u0902 \u0915\u094b \u0905\u0927\u093f\u0915\u0924\u092e \u0924\u0915 \u0938\u094d\u0935\u0940\u092a \u0915\u0930\u0928\u093e\u0964"},vag_acoustic_lock_confirmation:{name:"\u0927\u094d\u0935\u0928\u093f\u0915 \u0932\u0949\u0915 \u092a\u0941\u0937\u094d\u091f\u093f\u0915\u0930\u0923 \u091a\u093f\u0930\u092a",desc:"\u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u092a\u0930 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0939\u0949\u0930\u094d\u0928 \u092a\u0941\u0937\u094d\u091f\u093f\u0915\u0930\u0923 \u0927\u094d\u0935\u0928\u093f \u0915\u093e \u0909\u0924\u094d\u0938\u0930\u094d\u091c\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_american_parking_lights:{name:"\u092f\u0942\u090f\u0938 \u0938\u094d\u091f\u093e\u0907\u0932 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0932\u093e\u0907\u091f\u094d\u0938",desc:"\u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0932\u093e\u0907\u091f \u0915\u0947 \u0938\u093e\u0925 \u092b\u094d\u0930\u0902\u091f \u091f\u0930\u094d\u0928 \u0938\u093f\u0917\u094d\u0928\u0932 \u0915\u094b 20% \u0921\u093f\u092e\u093f\u0902\u0917 \u092a\u0930 \u0932\u0917\u093e\u0924\u093e\u0930 \u0930\u094b\u0936\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_drl_menu_toggle:{name:"\u0921\u0947\u091f\u093e\u0907\u092e \u0930\u0928\u093f\u0902\u0917 \u0932\u093e\u0907\u091f\u094d\u0938 (\u0921\u0940\u0906\u0930\u090f\u0932) \u092e\u0947\u0928\u0942 \u091f\u0949\u0917\u0932 \u0915\u0930\u0947\u0902",desc:"\u0907\u0902\u092b\u094b\u091f\u0947\u0928\u092e\u0947\u0902\u091f \u0935\u093e\u0939\u0928 \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0928\u0942 \u092e\u0947\u0902 \u0921\u0940\u0906\u0930\u090f\u0932 \u091a\u093e\u0932\u0942/\u092c\u0902\u0926 \u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_tear_wiping:{name:"\u0935\u093f\u0902\u0921\u0936\u0940\u0932\u094d\u0921 \u0906\u0902\u0938\u0942 \u092a\u094b\u0902\u091b\u0928\u093e",desc:"\u0935\u093f\u0902\u0921\u0936\u0940\u0932\u094d\u0921 \u0935\u0949\u0936\u0930 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 5 \u0938\u0947\u0915\u0902\u0921 \u092c\u093e\u0926 \u090f\u0915 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0905\u0902\u0924\u093f\u092e \u0935\u093e\u0907\u092a \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_emergency_brake_flashing:{name:"\u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u092c\u094d\u0930\u0947\u0915 \u0916\u0924\u0930\u093e \u091a\u092e\u0915 \u0930\u0939\u093e \u0939\u0948",desc:"\u092d\u093e\u0930\u0940 \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u092c\u094d\u0930\u0947\u0915\u093f\u0902\u0917 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0924\u0947\u091c\u0940 \u0938\u0947 \u091a\u092e\u0915\u0924\u0940 \u092c\u094d\u0930\u0947\u0915 \u0932\u093e\u0907\u091f \u0914\u0930 \u0916\u0924\u0930\u0947\u0964"},vag_cornering_lights:{name:"\u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u092b\u093c\u0949\u0917 \u0932\u093e\u0907\u091f\u094d\u0938",desc:"\u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0935\u094d\u0939\u0940\u0932 \u0930\u094b\u091f\u0947\u0936\u0928 \u0938\u093e\u0907\u0921 \u092a\u0930 \u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u092b\u093c\u0949\u0917 \u0932\u093e\u0907\u091f \u0915\u094b \u0930\u094b\u0936\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_comfort_mirror_folding:{name:"\u0915\u0940 \u092b\u094b\u092c \u0915\u092e\u094d\u092b\u0930\u094d\u091f \u092e\u093f\u0930\u0930 \u092b\u094b\u0932\u094d\u0921\u093f\u0902\u0917",desc:"\u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u092a\u0930 \u0932\u0949\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u090f \u0930\u0916\u0928\u0947 \u092a\u0930 \u0938\u093e\u0907\u0921 \u092e\u093f\u0930\u0930 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092e\u0941\u0921\u093c \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},vag_lap_timer:{name:"\u0909\u092a\u0915\u0930\u0923 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0932\u0948\u092a \u091f\u093e\u0907\u092e\u0930",desc:"\u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0947\u0902 \u091f\u094d\u0930\u0948\u0915 \u0932\u0948\u092a \u091f\u093e\u0907\u092e\u0930 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u091f\u0948\u092c \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_refuel_quantity:{name:"\u0908\u0902\u0927\u0928 \u092e\u093e\u0924\u094d\u0930\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928",desc:"\u092a\u0942\u0930\u094d\u0923 \u0908\u0902\u0927\u0928 \u0908\u0902\u0927\u0928 \u092d\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0932\u0940\u091f\u0930 \u092e\u0947\u0902 \u0938\u091f\u0940\u0915 \u092e\u093e\u0924\u094d\u0930\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_start_stop_memory:{name:"\u0911\u091f\u094b \u0938\u094d\u091f\u093e\u0930\u094d\u091f-\u0938\u094d\u091f\u0949\u092a \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u094b\u0921",desc:"\u0935\u093e\u0939\u0928 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0939\u094b\u0928\u0947 \u092a\u0930 \u0905\u0902\u0924\u093f\u092e \u0911\u091f\u094b \u0938\u094d\u091f\u093e\u0930\u094d\u091f-\u0938\u094d\u091f\u0949\u092a \u0938\u094d\u0925\u093f\u0924\u093f (\u092c\u0902\u0926/\u091a\u093e\u0932\u0942) \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},bmw_digital_speedometer:{name:"\u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u092a\u0940\u0921\u094b\u092e\u0940\u091f\u0930 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947",desc:"\u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0924\u0924\u094d\u0915\u093e\u0932 \u0921\u093f\u091c\u093f\u091f\u0932 \u0917\u0924\u093f \u0938\u0902\u0916\u094d\u092f\u093e\u0924\u094d\u092e\u0915 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0935\u093f\u0915\u0932\u094d\u092a \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"},bmw_sport_displays:{name:"\u0938\u094d\u092a\u094b\u0930\u094d\u091f \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 (\u090f\u091a\u092a\u0940 \u0914\u0930 \u090f\u0928\u090f\u092e \u0917\u0947\u091c)",desc:"\u0906\u0908\u0921\u094d\u0930\u093e\u0907\u0935 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0947\u0902 \u0932\u093e\u0907\u0935 \u0939\u0949\u0930\u094d\u0938\u092a\u093e\u0935\u0930 \u0914\u0930 \u091f\u0949\u0930\u094d\u0915 \u0921\u093e\u092f\u0928\u0947\u092e\u093f\u0915 \u0921\u093e\u092f\u0932 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_acoustic_lock_sound:{name:"\u0927\u094d\u0935\u0928\u093f\u0915 \u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u0927\u094d\u0935\u0928\u093f",desc:"\u0935\u093e\u0939\u0928 \u0915\u094b \u0932\u0949\u0915 \u092f\u093e \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0905\u0932\u093e\u0930\u094d\u092e \u0938\u093f\u0938\u094d\u091f\u092e \u092c\u091c\u0924\u093e \u0939\u0948\u0964"},bmw_mirror_fold_delay_zero:{name:"\u0907\u0902\u0938\u094d\u091f\u0947\u0902\u091f \u092e\u093f\u0930\u0930 \u092b\u094b\u0932\u094d\u0921\u093f\u0902\u0917 (0.0s \u0935\u093f\u0932\u0902\u092c)",desc:"\u092c\u093f\u0928\u093e \u0926\u0947\u0930 \u0915\u093f\u090f \u0932\u0949\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u0928\u0947 \u092a\u0930 \u0938\u093e\u0907\u0921 \u092e\u093f\u0930\u0930 \u0924\u0941\u0930\u0902\u0924 \u092e\u0941\u0921\u093c \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},bmw_tpms_tire_temperature:{name:"\u091f\u093e\u092f\u0930 \u0915\u093e \u0926\u092c\u093e\u0935 \u0914\u0930 \u0924\u093e\u092a\u092e\u093e\u0928 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928",desc:"\u091f\u0940\u092a\u0940\u090f\u092e\u090f\u0938 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0947\u0902 \u0926\u092c\u093e\u0935 \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u091f\u093e\u092f\u0930 \u0924\u093e\u092a\u092e\u093e\u0928 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},renault_trip_computer_enable:{name:"\u0911\u0928-\u092c\u094b\u0930\u094d\u0921 \u091f\u094d\u0930\u093f\u092a \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902",desc:"\u0914\u0938\u0924 \u0908\u0902\u0927\u0928 \u0916\u092a\u0924 \u0914\u0930 \u0930\u0947\u0902\u091c \u091f\u094d\u0930\u093f\u092a \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},renault_external_temp_display:{name:"\u092c\u093e\u0939\u0930\u0940 \u0924\u093e\u092a\u092e\u093e\u0928 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928",desc:"\u0909\u092a\u0915\u0930\u0923 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092e\u0947\u0902 \u092a\u0930\u093f\u0935\u0947\u0936 \u0915\u0947 \u092c\u093e\u0939\u0930\u0940 \u0924\u093e\u092a\u092e\u093e\u0928 \u0915\u094b \u092a\u0922\u093c\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964"},renault_automatic_tailgate:{name:"\u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u091f\u094d\u0930\u0902\u0915 \u0930\u093f\u0932\u0940\u091c\u093c",desc:"\u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u091f\u094d\u0930\u0902\u0915 \u092c\u091f\u0928 \u0915\u094b \u0926\u092c\u093e\u090f \u0930\u0916\u0928\u0947 \u092a\u0930 \u091f\u094d\u0930\u0902\u0915 \u0932\u0948\u091a \u0924\u0902\u0924\u094d\u0930 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092a\u0949\u092a \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964"},renault_alarm_chirp:{name:"\u0905\u0932\u093e\u0930\u094d\u092e \u0932\u0949\u0915 \u092a\u0941\u0937\u094d\u091f\u093f\u0915\u0930\u0923 \u091a\u093f\u0930\u092a",desc:"\u0935\u093e\u0939\u0928 \u0915\u093e \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0932\u0949\u0915 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0939\u0949\u0930\u094d\u0928 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"},renault_shift_indicator:{name:"\u0917\u093f\u092f\u0930 \u0936\u093f\u092b\u094d\u091f \u0938\u0902\u0915\u0947\u0924\u0915 (\u091c\u0940\u090f\u0938\u0906\u0908)",desc:"\u0909\u092a\u0915\u0930\u0923 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092e\u0947\u0902 \u0907\u0915\u094b-\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0936\u093f\u092b\u094d\u091f \u090a\u092a\u0930/\u0928\u0940\u091a\u0947 \u0924\u0940\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ford_double_horn_honk_disable:{name:"\u0926\u0930\u0935\u093e\u091c\u093c\u093e \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0921\u092c\u0932 \u0939\u0949\u0930\u094d\u0928 \u0939\u0949\u0930\u094d\u0928 \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902",desc:"\u0907\u0902\u091c\u0928 \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u092c\u0902\u0926 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0921\u092c\u0932 \u0939\u0949\u0930\u094d\u0928 \u092c\u091c\u093e\u0928\u093e \u0905\u0915\u094d\u0937\u092e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"},ford_auto_door_locking:{name:"20 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u092a\u0930 \u0911\u091f\u094b \u0921\u094b\u0930 \u0932\u0949\u0915\u093f\u0902\u0917",desc:"\u0935\u093e\u0939\u0928 \u0915\u0940 \u0917\u0924\u093f 20 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0938\u092d\u0940 \u0926\u0930\u0935\u093e\u091c\u0947 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"},ford_tpms_psi_display:{name:"\u0938\u0902\u0916\u094d\u092f\u093e\u0924\u094d\u092e\u0915 \u091f\u093e\u092f\u0930 \u0926\u092c\u093e\u0935 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928",desc:"\u0909\u092a\u0915\u0930\u0923 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u093f \u091f\u093e\u092f\u0930 \u0938\u091f\u0940\u0915 \u0938\u0902\u0916\u094d\u092f\u093e\u0924\u094d\u092e\u0915 PSI/BAR \u0926\u092c\u093e\u0935 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},ford_sync_climate_screen:{name:"\u0938\u093f\u0902\u0915 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u091c\u0932\u0935\u093e\u092f\u0941 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923",desc:"SYNC \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092e\u0947\u0902 \u091c\u0932\u0935\u093e\u092f\u0941 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0914\u0930 \u0938\u0940\u091f \u0939\u0940\u091f\u093f\u0902\u0917 \u091f\u091a\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0947\u0928\u0942 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"},stellantis_power_windows_remote:{name:"\u0915\u0941\u0902\u091c\u0940 \u092b\u093c\u0949\u092c \u0930\u093f\u092e\u094b\u091f \u0935\u093f\u0902\u0921\u094b \u0930\u094b\u0932 \u090a\u092a\u0930/\u0928\u0940\u091a\u0947",desc:"\u0932\u0949\u0915/\u0905\u0928\u0932\u0949\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u090f \u0930\u0916\u0928\u0947 \u092a\u0930 \u0938\u092d\u0940 \u092a\u093e\u0935\u0930 \u0935\u093f\u0902\u0921\u094b \u0915\u094b \u090a\u092a\u0930 \u092f\u093e \u0928\u0940\u091a\u0947 \u0930\u094b\u0932 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},stellantis_cornering_fogs:{name:"\u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u092b\u093c\u0949\u0917 \u0932\u093e\u0907\u091f \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902",desc:"\u0915\u092e \u0917\u0924\u093f \u0935\u093e\u0932\u0947 \u092e\u094b\u0921\u093c\u094b\u0902 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0915\u0949\u0930\u094d\u0928\u0930\u093f\u0902\u0917 \u092b\u0949\u0917 \u0932\u0948\u0902\u092a \u0915\u094b \u0930\u094b\u0936\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_traffic_sign_recognition:{name:"\u092f\u093e\u0924\u093e\u092f\u093e\u0924 \u091a\u093f\u0939\u094d\u0928 \u092a\u0939\u091a\u093e\u0928 (\u0935\u0940\u091c\u0947\u0921\u0908)",desc:"\u0909\u092a\u0915\u0930\u0923 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u0914\u0930 HUD \u092e\u0947\u0902 \u0915\u0948\u092e\u0930\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0939\u091a\u093e\u0928\u0947 \u0917\u090f \u0917\u0924\u093f \u091a\u093f\u0939\u094d\u0928 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_ambient_color_palette_30:{name:"30-\u0930\u0902\u0917 \u092a\u0930\u093f\u0935\u0947\u0936 \u092a\u094d\u0930\u0915\u093e\u0936 \u092a\u0948\u0932\u0947\u091f",desc:"\u090f\u092e\u0906\u0908\u092c\u0940 \u0907\u0902\u092b\u094b\u091f\u0947\u0928\u092e\u0947\u0902\u091f \u092e\u0947\u0928\u0942 \u092e\u0947\u0902 30 \u0906\u0930\u091c\u0940\u092c\u0940 \u0907\u0902\u091f\u0940\u0930\u093f\u092f\u0930 \u0932\u093e\u0907\u091f\u093f\u0902\u0917 \u0915\u0932\u0930 \u092a\u093f\u0915\u0930 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},vag_seatbelt_warning_mute:{name:"\u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u091a\u093e\u0907\u092e \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f\u0915\u0930\u0923",desc:"\u0909\u092a\u0915\u0930\u0923 \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092e\u0947\u0902 \u092c\u093f\u0928\u093e \u092c\u0915\u0932 \u0935\u093e\u0932\u0940 \u0938\u0940\u091f\u092c\u0947\u0932\u094d\u091f \u0927\u094d\u0935\u0928\u093f\u0915 \u091d\u0902\u0915\u093e\u0930 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_alpina_cluster_theme:{name:"\u0905\u0932\u094d\u092a\u093e\u0907\u0928\u093e \u0921\u093f\u091c\u093f\u091f\u0932 \u0921\u0948\u0936 \u0932\u0947\u0906\u0909\u091f",desc:"\u0921\u093f\u091c\u093f\u091f\u0932 \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u094d\u0932\u0938\u094d\u091f\u0930 \u092a\u0930 \u0928\u0940\u0932\u0940 \u0905\u0932\u094d\u092a\u093e\u0907\u0928\u093e \u0938\u093f\u0917\u094d\u0928\u0947\u091a\u0930 \u0925\u0940\u092e \u0932\u093e\u0917\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},bmw_video_in_motion:{name:"\u0935\u0940\u0921\u093f\u092f\u094b \u0907\u0928 \u092e\u094b\u0936\u0928 (\u0935\u0940\u0906\u0908\