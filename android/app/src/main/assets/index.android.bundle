ast Drive Mode Memory",desc:"Remembers last selected Drive Mode across vehicle restart."},mercedes_proximity_360_camera_auto:{name:"Proximity Sensor Auto 360\xb0 Camera View",desc:"Automatically switches screen to 360 camera when front sensors detect obstacle < 50 cm."},ford_sync_climate_screen_unlock:{name:"SYNC3 / SYNC4 Touchscreen Climate Control Page",desc:"Enables climate control, heated seat, and airflow direction touchscreen page."},ford_turn_signal_5_flashes:{name:"One-Touch Lane Change Signal",desc:"Increases one-touch lane change turn signal duration from 3 to 5 flashes."},ford_auto_engine_shutdown_disable:{name:"30-Minute Idle Auto Engine Shutdown Override",desc:"Prevents automatic engine shutoff after 30 minutes idle."},ev_battery_preheat_manual_switch:{name:"EV Battery Pre-Heating Manual Switch",desc:"Allows manual battery pre-heating to 25\xb0C before DC fast charging without navigation route."},ev_v2l_power_output_expand:{name:"V2L 220V Outlet Power Expansion",desc:"Expands V2L external 220V AC household power outlet limit from 2.2 kW to 3.6 kW."},ev_one_pedal_regen_force_level3:{name:"One-Pedal Drive Maximum Regenerative Braking Default",desc:"Sets maximum regenerative braking as default on vehicle start."},byd_soc_max_charge_target_limit:{name:"BYD Battery Health Protection Max Charge Limit",desc:"Sets max AC/DC charge cutoff limit to 80% or 90% to extend Blade Battery lifespan."},byd_dmi_forced_pure_ev_speed_override:{name:"BYD DM-i Pure EV Mode Gasoline Engine Override",desc:"Inhibits gasoline engine start in EV mode up to 130 km/h even during full throttle acceleration."},byd_vtol_v2v_rescue_charge_mode:{name:"BYD VTOL Rescue Charge Mode",desc:"Unlocks external AC power output to charge stranded electric vehicles on road."},hyundai_ipedal_memory_lock:{name:"Hyundai / Kia i-PEDAL One-Pedal Drive Memory Lock",desc:"Prevents i-PEDAL one-pedal stop mode from dropping back to Level 3 after shifting to Reverse."},hyundai_utility_mode_12v_saver:{name:"U