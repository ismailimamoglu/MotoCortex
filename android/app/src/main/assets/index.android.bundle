onnectedDevice:"VERBONDEN APPARAAT",noConnection:"Nog geen verbinding",batteryLow:"ACCUSPANNING IS LAAG!",batteryLowDesc:"De accuspanning bedraagt{{voltage}}. Start of laad het voertuig op. De ECU-communicatie kan worden onderbroken bij lage spanning.",batteryWarn:"BATTERIJ WORDT ZWAK",batteryWarnDesc:"Accuspanning{{voltage}}. Wees voorzichtig tijdens langdurig gebruik.",rpm:"Motortoerental",speed:"Voertuigsnelheid",temp:"TEMPERATUUR",throttle:"Gasklepstand",status:"OVERDRACHTSTATUS",statusHigh:"HOOG",statusNormal:"NORMAAL",statusLow:"LAAG",battery:"BATTERIJ",load:"LADEN",intake:"INLAAT LUCHT",manifold:"SPRUITSTUK kPa",customizeSubtitle:"Selecteer de sensoren die u op het scherm wilt zien.",layoutType:"Layout Stijl",layoutGrid:"ROOSTER",layoutList:"LIJST",customizeButton:"PAS DASHBOARD AAN",coolant:"Koelvloeistoftemp.",voltage:"Accuspanning",engineLoad:"Motorbelasting",intakeAirTemp:"Inlaatluchttemp.",manifoldPressure:"Spruitstukdruk",ambientTemp:"Buitentemperatuur",oilTemp:"Olietemperatuur",mafFlow:"MAF-luchtstroom",timingAdvance:"Ontstekingstijdstip",fuelLevel:"Brandstofniveau",catalystTemp:"Katalysatortemp.",layoutGauge:"METER",obdTerminalTitle:"OBD GEZONDHEID & TERMINAL",adapterClone:"Kloon-ADAPTER",adapterOriginal:"ORIGINEEL",adapterCloneShort:"KLON",adapterOriginalShort:"ORIGINEEL",pidLabel:"PID: {{pid}}",limitReached:"Selectielimiet",limitReachedDesc:"Met dit protocol kunt u maximaal {{limit}} sensoren selecteren.",customizeSubtitleKLine:"K-Line-protocol aangesloten. U kunt maximaal {{limit}} sensoren selecteren.",customizeSubtitleCAN:"CAN-Bus-protocol aangesloten. U kunt maximaal {{limit}} sensoren selecteren.",unit:"Eenheid",customizeTitle:"DASHBOARDINSTELLINGEN",layoutChart:"GRAFIEK",adblue:"AdBlue-niveau",egt:"Uitlaatgastemperatuur",nox:"NOx-sensorwaarde",torque:"Motorkoppel",selectedSensorsCount:"{{count}} / {{max}} sensoren geselecteerd",proSensorMsg:"Upgrade to PRO to unlock and monitor advanced live sensors."},expertise:{historyFound:"VOERTUIGGESCHIEDENIS GEVONDEN!",historyFoundDesc:"Er zijn eerder{{count}}-records van dit voertuig aangemaakt. Hieronder kunt u de geschiedenis bekijken.",viewHistory:"ZIE DE GESCHIEDENIS \u203a",manualVin:"CHASSISNUMMER",manualVinDesc:"Als de voertuigcomputer het chassisnummer niet automatisch deelt, kunt u dit hier noteren.",vinPlaceholder:"Typ chassisnummer...",startScan:"START DESKUNDIGE SCAN",scanning:"SCANNEN...",vehicleIdentity:"VOERTUIG-ID & KILOMETERSTAND",vin:"Chassisnummer",odometer:"Originele km",distSinceCleared:"Fout gewist",milDist:"Motorlampje aan",dtcTitle:"Foutcodes",dtcClean:"GEEN FOUTCODES - SCHOON",extraActions:"EXTRA TRANSACTIES",garageTitle:"GARAGE EN VERLEDEN RECORDS",share:"DEEL",saveVehicle:"BEWAAR DIT GEREEDSCHAP",noRecords:"Er zijn nog geen geregistreerde voertuigen.",clean:"SCHOON",faults:"MISLUKKING",vinRequired:"VIN vereist",vinRequiredDesc:"Om te kunnen registreren moet het chassisnummer automatisch verschijnen of handmatig worden geschreven.",missingInfo:"Ontbrekende informatie",missingInfoDesc:"Vul het veld Merk en Model in.",saved:"Opgeslagen",savedDesc:"Vanwege de expertise is deze aan de garage toegevoegd.",connRequired:"Verbinding vereist",connRequiredDesc:"Maak eerst verbinding met het voertuig om dit proces te starten.",chronicFaultsTitle:"Statistische chronische problemen",chronicFaultsObs:"{{code}} (Observation: {{days}} Unique Days / Total: {{total}} Times)",chronicFaultsPending:"Gegevenspool verzamelen / Statistieken analyseren",notScanned:"Niet gescand",notScannedDesc:"Druk op de scanknop rechtsboven om diagnostische codes te lezen.",scanFailed:"SCANNEN MISLUKT",errTimeout:"Error: Connection Timeout\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error\nECU trouble codes could not be read.",scannedSystems:"GESCANDE SYSTEMEN",moduleEngine:"Motorregeleenheid",moduleAbs:"Antiblokkeersysteem",moduleTcm:"Transmissieregelmodule",moduleBcm:"Lichaamscontrolemodule",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:"VEILIGHEIDSWAARSCHUWING",safetyWarningDesc:"Tijdens dit proces: \u2022 Het contact moet AAN zijn \u2022 De motor moet UIT staan \u2022 Start het voertuig niet Wil je doorgaan?",step1:"Stap 1: Wis foutcodes",step1Desc:"Alle opgeslagen foutcodes en het Check Engine-lampje worden gewist. Brandstoftrimwaarden worden gereset. Deze actie kan niet ongedaan worden gemaakt!",step2:"Stap 2: ECU harde reset",step2Desc:"Er wordt een elektrische reset naar de motorcomputer verzonden. Het werkt hetzelfde als het verwijderen en installeren van de batterij. Het is niet effectief bij niet-ondersteunende ECU's. Het kan geen kwaad.",clearCodes:"Codes verwijderen",ecuReset:"Foutcodes wissen",finish:"Overslaan",completed:"Voltooid",completedDesc:"De servicewerkzaamheden zijn succesvol afgerond. U kunt het voertuig opnieuw starten.",hardResetDesc:"Alle servicewerkzaamheden zijn succesvol afgerond. \u2022 Foutcodes gewist \u2022 Brandstoftrims gereset \u2022 ECU-reset U kunt het voertuig opnieuw starten."},info:{desc:"Professionele diagnosetoepassing voor motorfietsen en voertuigen. Compatibel met alle voertuigen.",upgrade:"Upgrade naar Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"Vroege toegang",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner is momenteel in ontwikkeling. Omdat u onze vroege gebruiker bent, zijn alle professionele functies nu voor u beschikbaar. Uw feedback is zeer waardevol voor ons!",helpGuide:"HULP EN GIDS",language:"Taal / Taal / Bahasa",support:"STEUNCENTRUM",supportSubject:"Cortex OBD2 Diagnostic Scanner-ondersteuning en feedback",thanks:"Dank je!",thanksDesc:"Bedankt voor uw feedback. U kunt een reactie achterlaten in de Play Store.",sections:{live:{title:"LIVE-MONITORINGSSENSOREN",content:"U kunt direct het toerental, de snelheid, de motortemperatuur, de gasklepstand, de accuspanning, de motorbelasting, de inlaatluchttemperatuur en de spruitstukdruk controleren. Waarden worden 1-5 keer per seconde vernieuwd, afhankelijk van uw Bluetooth-snelheid. Via de terminal kunt u direct ingrijpen in het voertuig met UDS/OBD-opdrachten."},expertise:{title:"ONDERZOEK EN GARANTIE",content:"De applicatie maakt gebruik van ECU-codes om fouten te detecteren. Het VIN-nummer en de huidige kilometerstand die op het voertuig is geregistreerd, worden vastgelegd. Bovendien worden fouten uit het verleden bepaald door te berekenen hoe ver het voertuig heeft afgelegd met het Check Engine-lampje. Het resulterende rapport kan worden gedeeld in PDF- en Messaging-omgevingen."},tests:{title:"BATTERIJ / PRESTATIETESTS",content:"Het testen van de batterij bestaat uit 3 fasen: Rust-, Start- en Stationair Laadtests meten de gezondheid van uw batterij/regelaar. De prestatietest meet de acceleratiewaarden van 0-60 en 0-100 km/u met een foutmarge van 50 ms, waarbij gebruik wordt gemaakt van de momentane snelheidsgegevens van de processor van uw telefoon en uw voertuig."},hardware:{title:"HARDWARE-COMPATIBILITEIT",content:"ELM327 Bluetooth wordt aanbevolen. Sommige geavanceerde codes werken mogelijk niet op hardware van slechte kwaliteit met v2.1 CLONE-versie. U krijgt de hoogste snelheid met premium adapters zoals vLinker en OBDLink."},warnings:{title:"BELANGRIJKE WAARSCHUWINGEN",content:"\u2022 Het contact moet AAN zijn en de motor UIT tijdens het verwijderen van de foutcode of de ECU-resetfunctie. \u2022 Stuur geen reset naar een rijdend voertuig. \u2022 Het is mogelijk dat niet elk voertuig alle sensoren ondersteunt; niet-ondersteunde sensoren geven \"--\" weer."},onboarding:{title:"WETTELIJKE TOESTEMMINGEN EN ANONIEME TELEMETRIE",content:"Om de applicatiekwaliteit en voertuigcompatibiliteit te verbeteren; Volledig geanonimiseerde motorparameters en foutcodes die tijdens de foutdiagnose worden gegenereerd kunnen op onze beveiligde servers worden geanalyseerd. Als u doorgaat, gaat u akkoord met deze voorwaarden voor anonieme telemetrie. Bluetooth- en locatietoestemmingen zijn vereist om te communiceren met de ECU van uw motorfiets."},featureCoding:{title:"VERBORGEN FUNCTIE ONTGRENDELEN & UDS-CODERING",content:"Aangedreven door onze ISO 14229 UDS Protocol Engine, schakel je veilig functies zoals Amerikaanse parkeerlichten, Needle Sweep, Horn Ack Lock, Comfort Windows en DRL-instellingen in voor VAG-, BMW-, Renault- en Dacia-voertuigen."},multiEcu:{title:"MULTI-ECU SCANNEN VAN ALLE MODULEN",content:"Scan en wis foutcodes buiten de motor-ECU, inclusief ABS, airbag, automatische transmissie, instrumentenpaneel, klimaatregeling en carrosseriecontrolemodules."},advancedDiagnostics:{title:"DCT-AANPASSING, DPF & PK-VERMOGENSMETER",content:"\u2022 DCT / DSG-koppeling Kiss Point Leren en aanpassing resetten\n\u2022 DPF-roetbelasting en bewaking van uitlaatregeneratietemperatuur\n\u2022 Realtime brandstofafstelling op korte/lange termijn en lambda-analyse\n\u2022 Dynamische paardenkracht en koppel Live telemetriegrafiek"},demoMode:{title:"DEMOMODUS",content:"Test en verken de app zonder fysieke OBD2-hardware. Ervaar de volledige CAN-Bus- en UDS-diagnosefuncties met realistische realtime telemetriesimulatie."}},reconfigurePermissions:"Toestemmingen en juridische voorwaarden opnieuw weergeven",shareWithFriend:"DELEN MET EEN VRIEND",shareMessageText:"Ontdek ECU-foutcodes en live sensortelemetrie van uw voertuig met Cortex OBD2 Diagnostic Scanner! Nu downloaden: iOS: https://apps.apple.com/app/id6764052240 Android: https://play.google.com/store/apps/details?id=com.ismail.motocortexv2 Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:"\u2550\u2550\u2550 CORTEX OBD2 DIAGNOSTISCH RAPPORT \u2550\u2550\u2550",vehicleIdentity:"VOERTUIG-ID",vin:"Chassisnummer",odometer:"Afstand",milDist:"Motorlampje aan",distSinceCleared:"Fout gewist",dtcCount:"FAULT CODES ({{count}})",sensorData:"LIVE SENSORGEGEVENS",noData:"Kan gegevens niet lezen",proApp:"Gescand met Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"datum",vinNotFound:"Niet gedetecteerd",noDtcs:"GEEN FOUTCODES - SCHOON",speed:"snelheid",coolant:"Motortemperatuur",throttle:"gas",engineLoad:"Motorbelasting",intakeAir:"Inlaatlucht",manifold:"Verdeelstuk",voltage:"Batterijspanning",shareMessage:"Volg de status van uw motorfiets vanuit uw zak met Motocortex OBD2 diagnostische applicatie! Downloaden: https://cortexobd2.app",subtitle:"Uitgebreide tweedehands diagnose- en telemetrie-inspectie",vehicleInfo:"Voertuigidentificatie en ECU-metagegevens",healthScore:"Algemene ECU-gezondheidsscore",dtcSection:"Diagnostische foutcodes",telemetrySection:"Live telemetrie en sensormomentopname",maintenanceSection:"Ak\u0131ll\u0131 Garaj Service- en onderhoudsgeschiedenis",aiSection:"AI Doctor Algemene conditieanalyse",noFaults:"Geen actieve of historische foutcodes opgeslagen in het ECU-geheugen.",noMaintenance:"Geen geregistreerde dienstvermeldingen in Ak\u0131ll\u0131 Garaj.",disclaimer:"Disclaimer: dit rapport is gegenereerd door de diagnostische software van MotoCortex. Fysieke inspectie door een gecertificeerde technicus wordt aanbevolen voorafgaand aan de aanschaf van het voertuig.",shareTitle:"Deel het MotoCortex-beoordelingsrapport"},battery:{title:"BATTERIJ & STARTTEST",ready:"Klaar om te beginnen met testen.",restingStatus:"Contact aan, motor uit... Accuspanning wordt afgelezen...",crankingStatus:"START NU!",chargingStatus:"Motor draait stationair... Laadspanning wordt afgelezen...",doneStatus:"Testen voltooid!",voltageError:"De spanning kon niet worden afgelezen. Controleer de verbinding.",start:"BEGIN TEST",retry:"HERHAAL TEST",procedure:"TESTPROCEDURE",steps:{1:"1. Contact aan, motor uit \u2192 Rustspanning wordt gemeten",2:"2. Wanneer het bericht \"START NU\" verschijnt, start u de motor.",3:"3. Laagste gemeten spanning gedurende 5 seconden",4:"4. De laad-/regelaarspanning wordt gemeten terwijl de motor draait"},warning:"Verbreek de Bluetooth-verbinding niet tijdens het testen.",resting:"RUST",cranking:"ANTHEM",charging:"OPLADEN",instantV:"DIRECT SPANNING",evaluation:"EVALUATIE",verdicts:{full:"Batterij: volledig opgeladen",good:"Batterij: goede staat",weak:"Batterij: verzwakking",empty:"Batterij: zwak/dood",crankNormal:"Begin: normale daling",crankLow:"Starter: Lage spanning",crankCritical:"Anthem: Kritieke drop",regNormal:"Opladen: Regelaar normaal",regLow:"Opladen: lage lading",regHigh:"Opladen: overladen",regFail:"Opladen: Regelaar is defect"},verdictLocked:"Upgrade naar PRO voor het gedetailleerde batterijrapport."},freeze:{title:"BEVRIEZEN FRAME",snapshot:"STORING GEHEUGEN",desc:"Het leest de motorparameters wanneer het Check Engine-lampje gaat branden. Deze gegevens bieden cruciale informatie bij foutdiagnose.",noDtcs:"Er is geen foutcode geregistreerd. Mogelijk zijn er geen Freeze Frame-gegevens aanwezig.",read:"LEES BEVROREN GEGEVENS",loading:"Modus 02 wordt in twijfel getrokken...",noData:"Geen bevroren gegevens gevonden. Het voertuig ondersteunt deze functie mogelijk niet.",error:"Fout bij het lezen van gegevens",values:"WAARDEN OPGESLAGEN OP HET TIJDSTIP VAN EEN FOUT",retry:"LEES OPNIEUW",techInfo:"TECHNISCHE INFORMATIE",techDesc:"\u2022 OBD-II-modus 02: Framegegevens bevriezen \u2022 PID 020C00: Fout in toerental \u2022 PID 020D00: Toerentalfout \u2022 PID 020500: Koelwatertemperatuur op het moment van de storing Deze gegevens horen bij de laatste foutcode. Wanneer de foutcodes worden gewist, worden de vastgelopen framegegevens ook gewist.",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"PRESTATIETEST",seconds:"SECONDEN",speed:"KM/U",idle:"Druk op de knop en maak je klaar om actie te ondernemen.",ready:"KLAAR! Begin met het besturen van het voertuig...",readyDesc:"De teller start wanneer toerental > 0.",measuring:"Er wordt gemeten...",done:"TESTEN VOLTOOID",start:"BEGIN TEST",stop:"STOP",reset:"RESET",howItWorks:"HOE WERKT HET?",howDesc:"1. Druk op de knop \"Test starten\". 2. Het voertuig moet stilstaan 3. Chrono start wanneer je begint te bewegen 4. Er worden passeertijden van 60 km/uur en 100 km/uur geregistreerd Doe deze test in een veilige omgeving!",sec:"sec"},dtc:{P0102:"Luchtstroomsensor - Lage invoer",P0113:"Inlaatluchttemperatuursensor - Hoogspanning",P0171:"Brandstofsysteem laag",P0300:"Willekeurige/meerdere cilinderontstekingsfout",P0420:"Katalysatorsysteem - Laag rendement",P0700:"Transmissiecontrolesysteem - Storing",P0715:"Turbinesnelheidssensor - Circuitstoring",P0560:"Systeemspanning - Storing",P0562:"Systeemspanning - Laag",U0100:"Verloren communicatie met motorregelmodule",U0121:"Communicatie met module antiblokkeerremsysteem verbroken",C0035:"Circuitfout snelheidssensor linker voorwiel",B0001:"Bestuurder voorste fase 1-implementatiecontrolecircuit",P0750:"Schakelmagneet A Storing",P0814:"Transmissiebereik Display Circuitstoring",U0140:"Verloren communicatie met Body Control Module",C0040:"Fout in het circuit van de snelheidssensor van het rechter voorwiel",C0110:"Storing in het circuit van de ABS-pompmotor",C0121:"Storing in het circuit van de remdruksensor",B0010:"Passagiersfront Fase 1 Implementatiecontrole",B0020:"Controle van de activering van de linkerzijairbag",B1000:"Hardwarefout carrosseriecontrolemodule.",B1325:"Apparaatvoedingscircuit Lage spanning",generalFault:"General Fault"},vehicleSelect:{title:"KIES UW VOERTUIG OM DE DIAGNOSTISCHE NAUWKEURIGHEID TE VERHOGEN",subtitle:"Geef voertuiggegevens op voor nauwkeurige diagnostiek en protocolafstemming.",brand:"MERK",selectBrand:"Kies merk...",searchBrand:"Merk zoeken...",customBrandPlaceholder:"Bijvoorbeeld: Triumph, CFMoto, Kia...",model:"MODEL",selectModel:"Model selecteren...",searchModel:"Model zoeken...",customModelPlaceholder:"Bijvoorbeeld: CBR600, Golf, Focus...",year:"MODELJAAR",selectYear:"Selecteer Jaar...",customYearPlaceholder:"Bijvoorbeeld: 2018",disconnect:"ONTKOPPEL",confirm:"DOORGAAN",errorBrand:"Selecteer of voer een merk in.",errorModel:"Selecteer of voer een model in.",errorYear:"Selecteer of voer een geldig jaar in.",noResults:"Geen resultaten gevonden",selectVehiclePrompt:"SELECTEER EERST HET VOERTUIG",selectedVehicle:"GESELECTEERD VOERTUIG",changeVehicle:"WIJZIGEN",newVehicle:"Nieuw voertuig toevoegen",titleMenu:"Voertuig & Verbinding",registeredVehiclesLabel:"GEREGISTREERDE VOERTUIGEN",viewRegisteredList:"Geregistreerde voertuigen bekijken",registeredVehicles:"MIJN GEREGISTREERDE VOERTUIGEN",deleteConfirm:"Weet u zeker dat u dit voertuig wilt verwijderen uit de geregistreerde voertuigen?",noRegisteredVehicles:"Geen geregistreerde voertuigen gevonden.",selectVehicle:"SELECTEREN",mismatchTitle:"Voertuig Afwijking",mismatchDesc:"De fabrikant van het verbonden voertuig is gedetecteerd als \"{{make}}\" op basis van de VIN. Het door u geselecteerde voertuig is echter \"{{selected}}\". Wilt u de huidige selectie annuleren en opnieuw defini\xebren met het juiste merk?",operations:{clearDtc:"Foutcodes gewist",fuelAdaptation:"Brandstofaanpassing gereset",ecuReset:"ECU gereset"},searchLanguage:"Zoektaal...",connectionSection:"OBD-apparaatverbinding",noVehicleTitle:"VOERTUIGDETECTIE VEREIST",noVehicleDesc:"De identiteit van het voertuig wordt automatisch ontdekt via de OBD-II-verbinding. Koppel en maak hieronder verbinding met uw apparaat.",registeredVehiclesButton:"MIJN GEREGISTREERDE VOERTUIGEN",connectDevice:"VERBINDEN MET OBD2-APPARAAT"},brands:{audi:"Audi",bajaj:"bajaj",bmw_car:"BMW",bmw_moto:"BMW",chery:"Chery",citroen:"Citroen",cupra:"Cupra",dacia:"Dacia",fiat:"fiat",ford:"doorwaadbare plaats",hero:"held",honda_car:"Honda",honda_moto:"Honda",hyundai:"hyundai",indian:"Indiaas",jeep:"jeep",kawasaki:"kawasaki",kia:"Kia",ktm:"KTM",kuba:"Cuba",kymco:"Kymco",land_rover:"landrover",lexus:"Lexus",mazda:"Mazda",mg:"MG",mondial:"mondiaal",mv_agusta:"MV Augusta",opel:"opel",peugeot_car:"Peugeot",peugeot_moto:"Peugeot",rks:"RKS",seat:"Zitplaats",skoda:"\u0160koda",suzuki_car:"Suzuki",suzuki_moto:"Suzuki",sym:"sym",tesla:"Tesla",togg:"schakelen",triumph:"Triomf",tvs:"TVS",vespa:"Vespa",volvo:"Volvo",yuki:"Yuki",other:"Anders",alfa_romeo:"Alfa Romeo",aprilia:"Aprilia",aston_martin:"Aston Martin",benelli:"Benelli",cfmoto:"CFMoto",chevrolet:"Chevrolet",ducati:"Ducati",harley:"Harley-Davidson",husqvarna:"Husqvarna",mercedes:"Mercedes-Benz",mitsubishi:"Mitsubishi",nissan:"Nissan",peugeot:"Peugeot",porsche:"Porsche",renault:"Renault",subaru:"Subaru",toyota:"Toyota",volkswagen:"Volkswagen",bmw:"BMW/MINI",gm:"GM/Chevrolet/GMC",dodge:"Ontwijken/RAM/Jeep",byd:"BYD EV",stellantis:"Stellantis/Fiat"},permissions:{headerSubtitle:"TOESTEMMINGSPANEEL",cardTitle:"Hardwaretoegang vereist",cardDesc:"Om de app-kwaliteit en voertuigcompatibiliteit te verbeteren, kunnen volledig geanonimiseerde motorparameters en foutcodes die tijdens de diagnose zijn vastgelegd, op onze beveiligde servers worden geanalyseerd. Door verder te gaan, gaat u akkoord met deze anonieme telemetrievoorwaarden.",btSub:"Het wordt alleen gebruikt om te koppelen met uw ELM327/OBD2-adapter en live CAN-bus/K-Line-gegevens te streamen.",locLabel:"Locatietoestemming",locSub:"Het is door de Android-systeemarchitectuur verplicht om Bluetooth-apparaten met een laag energieverbruik in de buurt te vinden. Wij volgen uw rijgedrag niet.",grantBtn:"TOESTAAN EN DOORGAAN",skipBtn:"Voorlopig overslaan",deniedDesc:"Sommige vergunningen werden geweigerd. Het is mogelijk dat Cortex OBD2 Diagnostic Scanner niet succesvol scant of verbinding maakt met OBD2-apparaten.",proceedAnyway:"Hoe dan ook doorgaan",openSettings:"Instellingen openen",btLabel:"Bluetooth",langTitle:"Taal selecteren",nextBtn:"VERDER",langDesc:"Selecteer uw voorkeurstaal.",langSelectSub:"TAALPORTAAL",telemetryLabel:"Diagnostische telemetrie",telemetrySub:"Deel anonieme protocol- en foutlogboeken om de voertuigcompatibiliteit te verbeteren.",restartOnboarding:"Eerste installatie opnieuw starten"},disclaimer:{subtitle:"Read carefully before writing configuration to vehicle ECU.",p1:"ECU coding and parameter writing directly modifies your vehicle's Electronic Control Unit configuration memory. MotoCortex executes multi-stage journal backups, but failure to comply with safety rules can risk module lockouts.",check1:"I confirm that the vehicle battery is stable (>= 12.4V) and ignition is ON.",check2:"I understand that incorrect coding may require a factory reset and accept all liability.",proceed:"WRITE PARAMETERS"},hiddenFeatures:{title:"VERBORGEN FUNCTIES",btnLabel:"VERBORGEN FUNCTIES ONTGRENDELEN",unsupported:"Deze OBD2-adapter ondersteunt het ontgrendelen van verborgen functies niet.",unsupportedDesc:"Originele ELM327 v2.1 of hoger vereist. Clone-adapters worden niet ondersteund.",notConnected:"Verbind eerst met een voertuig.",notConnectedDesc:"Een OBD2-apparaat moet verbonden zijn.",warning:"Deze wijzigingen kunnen de garantie van uw voertuig be\xefnvloeden.",confirmTitle:"Bevestiging vereist",confirmMsg:"Het wijzigen van deze functie be\xefnvloedt ECU-instellingen. Doorgaan?",confirmOk:"Doorgaan",confirmCancel:"Annuleren",categoryLighting:"VERLICHTING",categorySound:"GELUID & WAARSCHUWINGEN",categoryDisplay:"INSTRUMENTENPANEEL",categoryDriving:"RIJDEN",featureDrl:"Dagrijverlichting",featureRearFog:"Achterste Mistlamp Override",featureDoorChime:"Deurwaarschuwing uitschakelen",featureParkingAlert:"Handrem geluidswaarschuwing",featureRpmWarning:"RPM Limietwaarschuwing",featureFuelSensitivity:"Brandstofmeter Gevoeligheid",featureStartStop:"Start-Stop standaard uit",featureSportMemory:"Sport Modus Geheugen",enabled:"ACTIEF",disabled:"INACTIEF",writeSuccess:"Functie succesvol bijgewerkt.",writeError:"Schrijffout. Probeer het opnieuw.",simulationBanner:"SIMULATIEMODUS \u2014 Echte ECU-schrijven nog niet actief",closeBtn:"SLUITEN",unsupportedOk:"OK",disclaimerTitle:"UITSLUITING VAN AANSPRAKELIJKHEID",disclaimerFeature:"Functie",disclaimerBody:"Het wijzigen van deze functie heeft rechtstreeks invloed op de fabrieksinstellingen en de ECU-software van uw voertuig. Lees de volgende risico\u2019s aandachtig door: \u2022 Een onjuiste toepassing kan de garantie van uw voertuig ongeldig maken.\n\u2022 Sommige wijzigingen kunnen permanente storingen of onverwachte elektrische fouten veroorzaken.\n\u2022 Hoewel de werking omkeerbaar kan zijn, is voor sommige ECU-modules mogelijk een fabrieksreset vereist.\n\u2022 De gebruiker is als enige verantwoordelijk voor eventuele materi\xeble of immateri\xeble schade die voortvloeit uit het gebruik van deze functie.\n\u2022 Cortex OBD2 Diagnosescanner kan niet aansprakelijk worden gesteld voor eventuele storingen of schade veroorzaakt door deze wijzigingen. U moet bevestigen dat u deze waarschuwing heeft gelezen en begrepen.",checkboxTitle:"BEVESTIGING VEREIST",check1:"Ik heb deze waarschuwing gelezen en begrijp dat de garantie van mijn voertuig hierdoor kan worden be\xefnvloed.",check2:"Ik erken dat de Cortex OBD2-diagnosescanner niet verantwoordelijk is voor eventuele fouten of schade als gevolg van deze handeling.",check3:"Ik wil deze verandering willens en wetens en uit eigen vrije wil doorvoeren, waarbij ik alle risico's aanvaard.",disclaimerCancel:"ANNULEREN",disclaimerContinue:"DOORGAAN",unsupportedTitle:"Niet ondersteund",unsupportedMsg:"Het aangesloten OBD2-apparaat ondersteunt deze functie nog niet. Voor het schrijven van verborgen functies is een compatibele ELM327 v2.1+ adapter vereist. Kloon- of standaardadapters kunnen deze opdrachten niet verwerken."},disconnectShort:"ONTK.",obdTerminal:{title:"OBD GEZONDHEID & TERMINAL",terminalTitle:"OBD-TERMINAL",terminalPlaceholder:"Typ onderstaande opdracht om naar de ECU te sturen",inputPlaceholder:"Voer opdracht in...",sendButton:"VERZENDEN",statsTitle:"OBD-GEZONDHEIDSSTATISTIEKEN",connectionProtocol:"Verbindingsprotocol:",none:"Geen",hardwareQualityScore:"Hardwarekwaliteitsscore:",original:"Origineel",clone:"Kloon",requestResponseCount:"Aantal verzoeken/antwoorden:",timeoutCount:"Aantal time-outs:",recoveryCount:"Hersteltelling:",diagnosticLogTitle:"DIAGNOSTISCH LOGBOEK",clearButton:"HELDER",shareButton:"DEEL",noLogs:"Geen diagnostische logboeken gevonden.",noShareSupport:"Deelfuncties zijn niet beschikbaar op dit apparaat."},dtcContext:{powertrain:"Deze fout kan het brandstofverbruik en de motorprestaties be\xefnvloeden. Volledige diagnose ontgrendelen",cooling:"Kritiek gevaar voor koeling gedetecteerd. Bekijk gedetailleerde reparatiestappen",ignition:"Probleem met ontstekingssysteem gedetecteerd. Bekijk gedetailleerde reparatiestappen",chassis:"Waarschuwing chassisveiligheidssysteem. Ontgrendel PRO voor volledige analyse",body:"Fout in carrosserie-elektronica gevonden. Upgrade voor volledige diagnostiek",network:"Communicatienetwerkfout. PRO ontgrendelt volledige probleemoplossing",fallback:"Ontgrendel gedetailleerde foutanalyse, reparatiekosten en risicobeoordeling"},perfTeaser:{limitTitle:"Dagelijkse limiet bereikt",limitDesc:"Je hebt de dagelijkse limiet van 3 gratis 0-60 km/u-testen bereikt. Upgrade naar PRO voor onbeperkt testen en 0-100 km/u-metingen."},sandbox:{title:"Sandbox-telemetriecontrole",connectionStatus:"Verbindingsstatus:",ecuStatus:"ECU-status:",fps:"UI-prestaties: {{fps}} FPS",stressBtnStart:"Begin met 20 Hz-stress",stressBtnStop:"Stop de telemetrielus",stopDisconnect:"Stoppen / verbreken",discoveredDevices:"ONTDEkte APPARATEN",connect:"VERBINDEN",scanning:"Scannen...",scan:"Apparaten scannen",rpm:"Motortoerental",speed:"Voertuigsnelheid",coolant:"Koelvloeistoftemp",throttle:"Gaspedaalpositie",notConnected:"Niet verbonden",connected:"Verbonden",connecting:"Verbinden...",error:"Fout",openSandbox:"DIAG",advancedTerminal:"Geavanceerde verbindingsterminal",terminalTitle:"Live terminal- en busmonitor",pause:"PAUZE",resume:"HERVATTEN",share:"DEEL",clear:"HELDER",clearDtcs:"DTC WISSEN",dtcTitle:"DTC-DIAGNOSTIEK & FOUTCODES",noDtcs:"GEEN DTC-CODES GEVONDEN IN ECU",readDtcs:"DTC LEZEN",sendDtcs:"VERZENDEN"},health:{titleMenu:"OBD2 GEZONDHEID EN CAPACITEIT",adapterQuality:"ADAPTERKWALITEIT EN PRESTATIES",excellent:"UITSTEKEND",good:"GOED",clone:"INCOMPATIBEL / KLOON",firmware:"Firmwareversie:",capScore:"Capaciteitsscore",latency:"Latentie",protocol:"Actief protocol",featureSupport:"TOEPASSINGSFUNCTIEMATRIX",matrixReadCodes:"Foutcodes lezen en wissen",matrixLiveSensors:"Live sensorcontrole",matrixBattery:"Batterij- / spanningstest",matrixHighSpeed:"Hoge-snelheid telemetrie",matrixCoding:"ECU-codering en aanpassingen",active:"Actief",degraded:"Gedegradeerd",locked:"Vergrendeld",warning:"BEVEILIGINGSVERGRENDELING:",lockExplain:"Uw adapter is gemarkeerd als een kloon/nep-chip. Omdat klonadapters ontbrekende timingprecisie hebben en het voertuig tijdens schrijfbewerkingen kunnen beschadigen, zijn coderings- en aanpassingsfuncties vergrendeld. Schaf een origineel ELM327 v2.1- of vLinker-apparaat aan voor veilige codering.",vehiclePids:"VOERTUIGSENSORCHECKLIST",checklistPrompt:"De standaard sensorparameters die worden ondersteund door de ECU van uw voertuig staan hieronder vermeld. Sensoren zonder vinkje worden niet gerapporteerd door uw voertuig.",supportedBadge:"ONDERSTEUND",unsupportedBadge:"NIET ONDERSTEUND",backToExpertise:"BACK TO DIAGNOSTICS",tabHardware:"HARDWARE",tabModes:"MODES",tabTopology:"ECU NETWORK",tabReadiness:"I/M READINESS",tabVehicles:"VEHICLES",chipType:"Detected Chipset:",atCommands:"AT Command Set Benchmark",mode01:"Mode 01: Live Sensor Stream",mode02:"Mode 02: Freeze Frame Snapshot",mode03:"Mode 03 & 07: Fault Codes",mode04:"Mode 04: Clear DTCs & Reset MIL",mode06:"Mode 06: On-Board & Misfire Tests",mode08:"Mode 08: Bi-Directional Actuator Control",mode09:"Mode 09: Vehicle Identity",mode0A:"Mode 0A: Permanent Emission DTCs",modulePcm:"Powertrain / Engine",moduleTcm:"Transmission Control",moduleAbs:"ABS / ESP Brake Control Module",moduleBcm:"Body Control Module",moduleSrs:"Airbag & Safety System",moduleIpc:"Instrument Panel & Gateway",readinessStatus:"I/M Emission & Inspection Readiness",readinessReady:"READY FOR INSPECTION",readinessComplete:"COMPLETE",readinessIncomplete:"INCOMPLETE",monMisfire:"Misfire Monitor",monFuel:"Fuel System Monitor",monComponent:"Comprehensive Components",monCatalyst:"Catalyst Monitor",monEvap:"EVAP System Monitor",monO2:"Oxygen Sensors",monO2Heater:"O2 Sensor Heaters",monEgr:"EGR & VVT Variable Timing",catPassenger:"Passenger & Light Commercial",catMotorcycle:"Motorcycle",catTruck:"Heavy-Duty Commercial & Truck",catEv:"Electric & Hybrid Vehicles"},sensor:{oilTemp:"Motorolietemperatuur",boost:"Turbo-boostdruk",widebandAfr:"Breedband O2 / AFR-verhouding",transTemp:"Transmissietemperatuur",catalystTemp:"Katalysator temperatuur",ethanol:"Ethanol Brandstof %",timingAdvance:"Ontstekingstijdstip vooruit",baro:"Barometrische druk",rpm:"Motortoerental",speed:"Voertuigsnelheid",coolant:"Koelvloeistoftemperatuur",throttle:"Smoorkleppositie",voltage:"Controlemodulevoltage",maf:"MAF luchtstroomsnelheid",iat:"Inlaatluchttemperatuur",load:"Berekende motorbelasting",fuel:"Brandstofniveau"},secretDebug:{title:"MOTO CORTEX ONTWIKKELPANEEL",logFileSize:"Zwarte doos / Bestandsgrootte:",dtcCloudSync:"DTC CLOUD-SYNCHRONISATIE",lastSync:"Laatste synchronisatie",syncNow:"Synchroniseer nu",developerTools:"ONTWIKKELAAR HULPMIDDELEN",trialResetSuccess:"Gratis proefteller succesvol gereset!",crashTestTitle:"Crashtest",crashTestDesc:"De applicatie crasht nu opzettelijk. Bevestig om de Crashlytics-integratie te verifi\xebren.",crashButton:"Crash",crashTest:"Crashtest"},features:{title:"UNLOCK HIDDEN FEATURES & UDS CODING",subTitle:"ISO 14229 UDS Long Coding & Adaptation Engine",batteryVoltage:"BATTERY VOLTAGE",voltageReady:"Safe",voltageLocked:"Low Voltage",locked:"LOCKED",ready:"READY",allMarks:"ALL MARKS",writeBtn:"WRITE",catLighting:"LIGHTING",catSound:"SOUND & ALERTS",catDisplay:"INSTRUMENTS",catComfort:"COMFORT",catSafety:"SAFETY",safetyAlertTitle:"Low Battery Voltage Alert",safetyAlertMsg:"Minimum 12.2V battery voltage required for coding.\nPlease connect a charger or start the engine.",items:{vag_staging_needle_sweep:{name:"Gauge Staging / Needle Sweep",desc:"Sweeps instrument needles to maximum upon ignition start."},vag_acoustic_lock_confirmation:{name:"Acoustic Lock Confirmation Chirp",desc:"Emits a short horn confirmation chirp upon key fob locking."},vag_american_parking_lights:{name:"US Style Parking Lights",desc:"Illuminates front turn signals continuously at 20% dimming with parking lights."},vag_drl_menu_toggle:{name:"Daytime Running Lights Menu Toggle",desc:"Enables DRL ON/OFF checkbox in infotainment vehicle settings menu."},vag_tear_wiping:{name:"Windshield Tear Wiping",desc:"Executes an additional final wipe 5 seconds after windshield washer use."},vag_emergency_brake_flashing:{name:"Emergency Brake Hazard Flashing",desc:"Rapidly flashes brake lights and hazards under heavy emergency braking."},vag_cornering_lights:{name:"Cornering Fog Lights",desc:"Illuminates cornering fog light on steering wheel rotation side."},vag_comfort_mirror_folding:{name:"Key Fob Comfort Mirror Folding",desc:"Automatically folds side mirrors when lock button is held on key fob."},vag_lap_timer:{name:"Instrument Cluster Lap Timer",desc:"Unlocks track lap timer display tab in instrument cluster screen."},vag_refuel_quantity:{name:"Refuel Quantity Display",desc:"Displays exact volume in liters required for a full fuel refuel."},bmw_start_stop_memory:{name:"Auto Start-Stop Memory Mode",desc:"Remembers last Auto Start-Stop state across vehicle restarts."},bmw_digital_speedometer:{name:"Digital Speedometer Display",desc:"Adds instant digital speed numerical display option to cluster screen."},bmw_sport_displays:{name:"Sport Displays",desc:"Enables live horsepower and torque dynamic dials in iDrive screen."},bmw_acoustic_lock_sound:{name:"Acoustic Lock/Unlock Sound",desc:"Emits alarm system chirps when locking or unlocking the vehicle."},bmw_mirror_fold_delay_zero:{name:"Instant Mirror Folding",desc:"Folds side mirrors instantly upon lock button press without holding delay."},bmw_tpms_tire_temperature:{name:"Tire Pressure & Temperature Display",desc:"Displays real-time tire temperature alongside pressure in TPMS screen."},renault_trip_computer_enable:{name:"On-Board Trip Computer Enable",desc:"Unlocks average fuel consumption and range trip computer displays."},renault_external_temp_display:{name:"External Temperature Display",desc:"Enables ambient outdoor temperature reading in instrument cluster."},renault_automatic_tailgate:{name:"Key Fob Trunk Release",desc:"Fully pops trunk latch mechanism upon holding key fob trunk button."},renault_alarm_chirp:{name:"Alarm Lock Confirmation Chirp",desc:"Sounds horn confirmation chirp upon vehicle door locking."},renault_shift_indicator:{name:"Gear Shift Indicator",desc:"Activates eco-driving shift UP/DOWN arrows in instrument cluster."},ford_double_horn_honk_disable:{name:"Disable Double Horn Honk on Door Close",desc:"Disables double horn honk when closing door with engine running."},ford_auto_door_locking:{name:"Auto Door Locking at 20 km/h",desc:"Automatically locks all doors when vehicle speed exceeds 20 km/h."},ford_tpms_psi_display:{name:"Numerical Tire Pressure Display",desc:"Displays exact numerical PSI/BAR pressure per tire in instrument screen."},ford_sync_climate_screen:{name:"SYNC Screen Climate Controls",desc:"Adds climate control and seat heating touchscreen menu to SYNC display."},stellantis_power_windows_remote:{name:"Key Fob Remote Window Roll Up/Down",desc:"Rolls up or down all power windows when holding lock/unlock buttons."},stellantis_cornering_fogs:{name:"Cornering Fog Lights Enable",desc:"Illuminates cornering fog lamp during low-speed turns."},vag_traffic_sign_recognition:{name:"Traffic Sign Recognition",desc:"Displays camera-detected speed signs in instrument cluster and HUD."},vag_ambient_color_palette_30:{name:"30-Color Ambient Lighting Palette",desc:"Unlocks 30 RGB interior lighting color picker in MIB infotainment menu."},vag_seatbelt_warning_mute:{name:"Seatbelt Chime Deactivation",desc:"Disables unbuckled seatbelt acoustic chime in instrument cluster."},bmw_alpina_cluster_theme:{name:"Alpina Digital Dash Layout",desc:"Applies blue Alpina signature theme to digital instrument cluster."},bmw_video_in_motion:{name:"Video In Motion",desc:"Unlocks USB video playback on iDrive screen while driving."},bmw_sport_plus_mode_unlock:{name:"Sport+ Driving Mode Enable",desc:"Enables Sport+ high-performance dynamic driving mode in DEC selector."},mercedes_amg_menu_unlock:{name:"AMG Performance Telemetry Menu",desc:"Displays AMG oil temp, transmission temp, lap timer, and G-meter."},mercedes_agility_mode_enable:{name:"Agility Transmission Mode",desc:"Unlocks ultra-responsive Agility shift program in 7G/9G-Tronic transmission."},mercedes_drl_brightness_boost:{name:"Daytime Running Lights 100% Intensity",desc:"Increases LED daytime running lights output to 100% full brightness."},mercedes_alarm_lock_chirp:{name:"Acoustic Locking Horn Chirp",desc:"Emits short horn chirp notification when central locking is engaged."},mercedes_dpf_adblue_gauge:{name:"DPF Soot & AdBlue Level Gauge",desc:"Displays exact DPF soot mass percentage and remaining AdBlue range in IC."},renault_rs_monitor_enable:{name:"Renault Sport RS Monitor Telemetry",desc:"Enables live G-force, turbo boost, and oil temp telemetry on R-Link."},renault_duster_mirror_fold:{name:"Duster Auto Mirror Folding on Lock",desc:"Folds side mirrors automatically via BCM central locking command."},ford_bambi_mode_fog_light:{name:"Bambi Mode",desc:"Allows fog lights to remain ON when high beam headlights are activated."},ford_st_rs_boot_animation:{name:"ST/RS Performance SYNC Boot Screen",desc:"Changes SYNC touchscreen startup splash animation to ST / RS logo."},toyota_reverse_beep_mute:{name:"Reverse Gear Continuous Cabin Beep Mute",desc:"Mutes continuous reverse gear chime inside cabin to a single beep."},toyota_remote_window_drop:{name:"Key Fob Remote Window Roll Down",desc:"Rolls down all power windows when holding key fob unlock button."},toyota_auto_lock_shift_p:{name:"Auto Lock Doors on Gear Shift",desc:"Automatically locks all doors when shifting out of Park position."},peugeot_icockpit_theme_unlock:{name:"Peugeot 3D i-Cockpit Performance Theme",desc:"Unlocks Copper and Track Red color display themes on 3D digital cluster."},jeep_offroad_pages_enable:{name:"Jeep Uconnect Off-Road Pages",desc:"Enables pitch/roll angle gauges, wheel articulation, and 4x4 lock status."},hyundai_smart_welcome_mirror:{name:"Smart Key Approach Welcome Mirror Unfold",desc:"Automatically unfolds side mirrors when approaching vehicle with smart key."},hyundai_one_touch_turn_7_flashes:{name:"One-Touch Lane Change Signal",desc:"Sets one-touch lane change blinker duration to 7 flashes."},hyundai_svm_camera_speed_extend:{name:"360\xb0 Surround Camera Speed Extension",desc:"Keeps 360-degree parking camera active up to 20 km/h forward speed."},hyundai_n_performance_exhaust_flap:{name:"N-Performance Exhaust Flap Default OPEN",desc:"Sets active exhaust valve default position to OPEN on engine start."},vag_rain_closing_sunroof:{name:"Rain Closing",desc:"Automatically closes sunroof and windows when rain is detected while parked."},bmw_launch_control_unlock:{name:"Launch Control Unlock",desc:"Unlocks factory launch control acceleration program in transmission ECU."},mercedes_ambient_64_multi_zone:{name:"64-Color Multi-Zone Ambient Profile",desc:"Unlocks dynamic multi-zone color cycle animation in MBUX interior lighting."},ford_trailer_brake_activation:{name:"Trailer Brake Controller Enable",desc:"Enables integrated trailer brake controller menu in instrument cluster."},gm_afm_dfm_cylinder_deactivation_disable:{name:"AFM/DFM V8 Cylinder Lock",desc:"Locks engine in 8-cylinder mode permanently to prevent V4 vibration."},gm_remote_start_time_extend:{name:"Remote Start Duration Extension",desc:"Extends factory key fob remote engine start run time from 10 to 20 minutes."},dodge_srt_performance_pages:{name:"SRT Performance Pages & Drive Modes",desc:"Unlocks Uconnect 0-100 acceleration timers, G-force meter, and launch control."},ram_bambi_mode_fog:{name:"RAM Truck Fog Lights with High Beam",desc:"Allows RAM fog lights to remain active alongside high beam headlights."},byd_avas_pedestrian_siren_mute:{name:"AVAS EV Low-Speed Siren Mute",desc:"Mutes low-speed artificial electric motor siren below 30 km/h."},chery_isa_overspeed_chime_mute:{name:"ISA Overspeed Warning Chime Deactivation",desc:"Disables continuous 80/120 km/h overspeed warning beep on Tiggo/MG models."},mg_ev_battery_preconditioning_toggle:{name:"EV Fast-Charge Battery Pre-Heating Manual Switch",desc:"Enables manual battery pre-heating switch before DC fast charging."},chery_dms_fatigue_camera_mute:{name:"Driver Monitoring Camera Sensitivity Reduction",desc:"Reduces over-sensitive eye-tracking fatigue warnings on steering column."},honda_walk_away_auto_lock:{name:"Walk-Away Auto Door Lock",desc:"Automatically locks all doors when driver steps 2 meters away with key fob."},subaru_avh_auto_hold_memory:{name:"Auto Vehicle Hold Memory Mode",desc:"Remembers AVH brake hold ON/OFF state across ignition cycles."},volvo_start_stop_default_off:{name:"Auto Start-Stop Default OFF Mode",desc:"Sets Start-Stop engine shutoff system default state to OFF upon vehicle start."},volvo_polestar_digital_theme:{name:"Polestar Blue Digital Cluster Theme",desc:"Unlocks Polestar signature blue dynamic gauge theme in Volvo driver display."},vag_virtual_cockpit_r_theme:{name:"Virtual Cockpit R / S / Cupra Performance Themes",desc:"Unlocks R-Line, S-Line, and Cupra central tachometer performance themes in digital cockpit."},vag_sound_symposer_mute:{name:"Sound Symposer Fake Engine Noise Deactivation",desc:"Deactivates cabin speaker fake engine sound generator for pure exhaust note."},vag_wireless_carplay_enable:{name:"Wireless Apple CarPlay & Android Auto Activation",desc:"Enables 5GHz Wi-Fi wireless Apple CarPlay and Android Auto on MIB2.5/MIB3 units."},vag_offroad_telemetry_menu:{name:"MIB Offroad Telemetry & Gauge Display",desc:"Displays steering angle, oil temp, coolant temp, and altitude gauges on MIB screen."},vag_easy_entry_driver_seat:{name:"Automatic Easy Entry Power Seat Back-step",desc:"Moves electric driver seat back 5 cm upon door opening for easy vehicle entry."},vag_hba_memory_state:{name:"High-Beam Assist Memory Retention",desc:"Remembers High-Beam Assist ON status across ignition restart cycles."},vag_battery_soc_display:{name:"Battery State of Charge Display",desc:"Shows exact battery charge percentage on instrument cluster when trip button is held."},bmw_idrive7_m_animation:{name:"iDrive 7 / 8 M-Performance Startup Animation",desc:"Changes iDrive screen boot graphic to M-Performance or M-GmbH logo animation."},bmw_bowers_wilkins_audio_profiles:{name:"Bowers & Wilkins 3D Sound Engine Unlock",desc:"Unlocks Bowers & Wilkins Concert, Studio, and Stage DSP audio profiles on HiFi systems."},bmw_hitch_zoom_camera:{name:"Reverse Camera Trailer Hitch Zoom Mode",desc:"Unlocks top-down trailer hitch alignment zoom mode on reverse camera view."},bmw_secure_idle_protection:{name:"Secure Idle Engine Shift-Lock Protection",desc:"Locks transmission in Park if driver leaves running vehicle with key fob."},bmw_seatbelt_handover_mute:{name:"Coupe Electric Seatbelt Handover Arm Deactivation",desc:"Disables motorized seatbelt extender arm on 4 Series and 2 Series Coupes."},bmw_auto_heat_threshold_5c:{name:"Automatic Seat & Steering Wheel Heating Temperature",desc:"Triggers automatic seat and steering wheel heating when ambient temp drops below 5\xb0C."},mercedes_amg_track_pace_unlock:{name:"MBUX AMG Track Pace Telemetry & Lap Timer",desc:"Unlocks lap timing, acceleration telemetry, and G-force graphs on MBUX screen."},mercedes_drive_mode_last_memory:{name:"Dynamic Select Last 