w_video_in_motion:{name:"Video \xeen mi\u0219care (VIM)",desc:"Deblocheaz\u0103 redarea video USB pe ecranul iDrive \xeen timp ce conduce\u021bi."},bmw_sport_plus_mode_unlock:{name:"Activare mod de conducere Sport+",desc:"Activeaz\u0103 modul de conducere dinamic de \xeenalt\u0103 performan\u021b\u0103 Sport+ \xeen selectorul DEC."},mercedes_amg_menu_unlock:{name:"Meniul de telemetrie AMG Performance",desc:"Afi\u0219eaz\u0103 temperatura uleiului AMG, temperatura transmisiei, cronometrul turei \u0219i G-metrul."},mercedes_agility_mode_enable:{name:"Mod de transmisie Agilitate (A).",desc:"Deblocheaz\u0103 programul de schimbare a vitezei Agility ultra-responsiv \xeen transmisia 7G/9G-Tronic."},mercedes_drl_brightness_boost:{name:"Lumini de zi 100% intensitate",desc:"M\u0103re\u0219te puterea luminilor de zi cu LED-uri la 100% luminozitate maxim\u0103."},mercedes_alarm_lock_chirp:{name:"Ciripit claxon de blocare acustic\u0103",desc:"Emite o notificare scurt\u0103 de claxon c\xe2nd \xeenchiderea centralizat\u0103 este activat\u0103."},mercedes_dpf_adblue_gauge:{name:"Indicator de nivel de funingine \u0219i AdBlue DPF",desc:"Afi\u0219eaz\u0103 procentul exact de mas\u0103 de funingine DPF \u0219i intervalul de AdBlue r\u0103mas \xeen IC."},renault_rs_monitor_enable:{name:"Telemetrie monitor Renault Sport RS",desc:"Permite telemetria live G-force, turbo boost \u0219i temperatura uleiului pe R-Link."},renault_duster_mirror_fold:{name:"Oglinda automat\u0103 Duster pliabil\u0103 pe blocare",desc:"Pliaz\u0103 automat oglinzile laterale prin comanda de \xeenchidere centralizat\u0103 BCM."},ford_bambi_mode_fog_light:{name:"Modul Bambi (faze lungi + lumini de cea\u021b\u0103)",desc:"Permite luminilor de cea\u021b\u0103 s\u0103 r\u0103m\xe2n\u0103 aprinse atunci c\xe2nd sunt activate farurile pentru faza lung\u0103."},ford_st_rs_boot_animation:{name:"Ecranul de pornire ST/RS Performance SYNC",desc:"Schimb\u0103 anima\u021bia de pornire a ecranului tactil SYNC \xeen logo-ul ST / RS."},toyota_reverse_beep_mute:{name:"Treapta de mar\u0219arier continuu bip cabin\u0103 Dezactivare",desc:"Dezactiveaz\u0103 sunetul continuu al treptei de mar\u0219arier din interiorul cabinei la un singur bip."},toyota_remote_window_drop:{name:"Geamul telecomand\u0103 cu cheie roti\u021bi \xeen jos",desc:"Deruleaz\u0103 toate geamurile electrice c\xe2nd \u021bine\u021bi ap\u0103sat butonul de deblocare a cheii."},toyota_auto_lock_shift_p:{name:"Blocare automat\u0103 a u\u0219ilor la schimbarea vitezelor (P -> D)",desc:"Bloceaz\u0103 automat toate u\u0219ile atunci c\xe2nd ie\u0219i din pozi\u021bia Parcare."},peugeot_icockpit_theme_unlock:{name:"Tema de performan\u021b\u0103 Peugeot 3D i-Cockpit",desc:"Deblocheaz\u0103 temele de afi\u0219are color Copper \u0219i Track Red pe clusterul digital 3D."},jeep_offroad_pages_enable:{name:"Pagini off-road Jeep Uconnect",desc:"Permite indicatori de unghi de \xeenclinare/ruliu, articula\u021bia ro\u021bilor \u0219i starea de blocare 4x4."},hyundai_smart_welcome_mirror:{name:"Smart Key Approach Oglinda de bun venit Desf\u0103\u0219oar\u0103",desc:"Desface automat oglinzile laterale c\xe2nd se apropie de vehicul cu cheia inteligent\u0103."},hyundai_one_touch_turn_7_flashes:{name:"Semnal de schimbare a benzii cu o singur\u0103 atingere (7 clipiri)",desc:"Seteaz\u0103 durata intermitentului pentru schimbarea benzii cu o singur\u0103 atingere la 7 clipiri."},hyundai_svm_camera_speed_extend:{name:"Extensie de vitez\u0103 a camerei surround 360\xb0 (20 km/h)",desc:"P\u0103streaz\u0103 camera de parcare la 360 de grade activ\u0103 p\xe2n\u0103 la o vitez\u0103 \xeenainte de p\xe2n\u0103 la 20 km/h."},hyundai_n_performance_exhaust_flap:{name:"Clapeta de evacuare N-Performance implicit\u0103 DESCHIS",desc:"Seteaz\u0103 pozi\u021bia implicit\u0103 a supapei de evacuare activ\u0103 la DESCHIS la pornirea motorului."},vag_rain_closing_sunroof:{name:"\xcenchiderea ploii (Regenschlie\xdfen)",desc:"\xcenchide automat trapa \u0219i geamurile c\xe2nd se detecteaz\u0103 ploaie \xeen timp ce sta\u021bi parcat."},bmw_launch_control_unlock:{name:"Lansa\u021bi Control Unlock",desc:"Deblocheaz\u0103 programul de accelerare pentru controlul lans\u0103rii din fabric\u0103 \xeen ECU de transmisie."},mercedes_ambient_64_multi_zone:{name:"Profil ambiental multizon\u0103 cu 64 de culori",desc:"Deblocheaz\u0103 anima\u021bia dinamic\u0103 a ciclului de culoare cu mai multe zone \xeen iluminarea interioar\u0103 MBUX."},ford_trailer_brake_activation:{name:"Activare controler fr\xe2n\u0103 remorc\u0103 (TBC).",desc:"Activeaz\u0103 meniul integrat al controlerului fr\xe2nei remorcii \xeen grupul de instrumente."},gm_afm_dfm_cylinder_deactivation_disable:{name:"Blocare cilindru AFM/DFM V8 (f\u0103r\u0103 c\u0103dere V4)",desc:"Bloceaz\u0103 permanent motorul \xeen modul cu 8 cilindri pentru a preveni vibra\u021biile V4."},gm_remote_start_time_extend:{name:"Prelungire a duratei pornirii de la distan\u021b\u0103 (20 de minute)",desc:"Prelunge\u0219te timpul de pornire a motorului de la distan\u021b\u0103 cu cheia din fabric\u0103 de la 10 la 20 de minute."},dodge_srt_performance_pages:{name:"Pagini de performan\u021b\u0103 SRT \u0219i moduri de conducere",desc:"Deblocheaz\u0103 temporizatoarele de accelera\u021bie Uconnect 0-100, contorul de for\u021b\u0103 G \u0219i controlul lans\u0103rii."},ram_bambi_mode_fog:{name:"Faruri de cea\u021b\u0103 pentru camion RAM cu faza lung\u0103",desc:"Permite farurilor de cea\u021b\u0103 RAM s\u0103 r\u0103m\xe2n\u0103 active al\u0103turi de farurile cu faza lung\u0103."},byd_avas_pedestrian_siren_mute:{name:"Siren\u0103 de vitez\u0103 redus\u0103 AVAS EV",desc:"Dezactiveaz\u0103 sirena cu motor electric artificial de vitez\u0103 redus\u0103 sub 30 km/h."},chery_isa_overspeed_chime_mute:{name:"Dezactivarea soneriei de avertizare de supravitez\u0103 ISA",desc:"Dezactiveaz\u0103 semnalul sonor continuu de avertizare de supravitez\u0103 de 80/120 km/h pe modelele Tiggo/MG."},mg_ev_battery