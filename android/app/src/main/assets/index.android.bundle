\u0938\u094d\u091f\u093f\u0915 \u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 (\u0911\u092a\u094d\u091f-\u0907\u0928)",telemetrySub:"\u0935\u093e\u0939\u0928 \u0905\u0928\u0941\u0915\u0942\u0932\u0924\u093e \u092e\u0947\u0902 \u0938\u0941\u0927\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u093e\u092e \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0914\u0930 \u0924\u094d\u0930\u0941\u091f\u093f \u0932\u0949\u0917 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902\u0964",restartOnboarding:"\u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u0938\u0947\u091f\u0905\u092a \u092a\u0941\u0928\u0903 \u0906\u0930\u0902\u092d \u0915\u0930\u0947\u0902 (\u092d\u093e\u0937\u093e \u0914\u0930 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901)"},disclaimer:"\u0938\u092d\u0940 \u0909\u0924\u094d\u092a\u093e\u0926 \u0928\u093e\u092e, \u0932\u094b\u0917\u094b \u0914\u0930 \u092c\u094d\u0930\u093e\u0902\u0921 \u0909\u0928\u0915\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u094d\u0935\u093e\u092e\u093f\u092f\u094b\u0902 \u0915\u0940 \u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0939\u0948\u0902\u0964 \u0907\u0938 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u092e\u0947\u0902 \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u0917\u090f \u0938\u092d\u0940 \u0915\u0902\u092a\u0928\u0940, \u0909\u0924\u094d\u092a\u093e\u0926 \u0914\u0930 \u0938\u0947\u0935\u093e \u0928\u093e\u092e \u0915\u0947\u0935\u0932 \u092a\u0939\u091a\u093e\u0928 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0902\u0964 \u0907\u0928 \u0928\u093e\u092e\u094b\u0902, \u0932\u094b\u0917\u094b \u0914\u0930 \u092c\u094d\u0930\u093e\u0902\u0921\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u094b\u0908 \u0938\u092e\u0930\u094d\u0925\u0928 \u092f\u093e \u092a\u094d\u0930\u093e\u092f\u094b\u091c\u0928 \u0928\u0939\u0940\u0902 \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964",hiddenFeatures:{title:"\u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902",btnLabel:"\u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902",unsupported:"\u092f\u0939 OBD2 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u0913\u0902 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964",unsupportedDesc:"\u092e\u0942\u0932 ELM327 v2.1 \u092f\u093e \u0909\u0938\u0938\u0947 \u090a\u092a\u0930 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u0932\u094b\u0928 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964",notConnected:"\u092a\u0939\u0932\u0947 \u0935\u093e\u0939\u0928 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0964",notConnectedDesc:"OBD2 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964",warning:"\u092f\u0947 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",confirmTitle:"\u092a\u0941\u0937\u094d\u091f\u093f \u0906\u0935\u0936\u094d\u092f\u0915",confirmMsg:"\u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u094b \u092c\u0926\u0932\u0928\u0947 \u0938\u0947 ECU \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902?",confirmOk:"\u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",confirmCancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902",categoryLighting:"\u092a\u094d\u0930\u0915\u093e\u0936 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e",categorySound:"\u0927\u094d\u0935\u0928\u093f \u0914\u0930 \u091a\u0947\u0924\u093e\u0935\u0928\u0940",categoryDisplay:"\u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u092a\u0948\u0928\u0932",categoryDriving:"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917",featureDrl:"\u0926\u093f\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u091a\u0932\u0928\u0947 \u0935\u093e\u0932\u0940 \u0930\u094b\u0936\u0928\u0940 (DRL)",featureRearFog:"\u0930\u093f\u092f\u0930 \u092b\u0949\u0917 \u0932\u093e\u0907\u091f \u0913\u0935\u0930\u0930\u093e\u0907\u0921",featureDoorChime:"\u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0918\u0902\u091f\u0940 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902",featureParkingAlert:"\u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092c\u094d\u0930\u0947\u0915 \u0927\u094d\u0935\u0928\u093f \u0905\u0932\u0930\u094d\u091f",featureRpmWarning:"RPM \u0938\u0940\u092e\u093e \u091a\u0947\u0924\u093e\u0935\u0928\u0940",featureFuelSensitivity:"\u0908\u0902\u0927\u0928 \u0917\u0947\u091c \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",featureStartStop:"\u0938\u094d\u091f\u093e\u0930\u094d\u091f-\u0938\u094d\u091f\u0949\u092a \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u092c\u0902\u0926",featureSportMemory:"\u0938\u094d\u092a\u094b\u0930\u094d\u091f \u092e\u094b\u0921 \u092e\u0947\u092e\u094b\u0930\u0940",enabled:"\u0938\u0915\u094d\u0937\u092e",disabled:"\u0905\u0915\u094d\u0937\u092e",writeSuccess:"\u0938\u0941\u0935\u093f\u0927\u093e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u092a\u0921\u0947\u091f \u0915\u0940 \u0917\u0908\u0964",writeError:"\u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",simulationBanner:"\u0938\u093f\u092e\u0941\u0932\u0947\u0936\u0928 \u092e\u094b\u0921 \u2014 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 ECU \u0930\u093e\u0907\u091f\u093f\u0902\u0917 \u0905\u092d\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0928\u0939\u0940\u0902 \u0939\u0948",closeBtn:"\u092c\u0902\u0926 \u0915\u0930\u0947\u0902",unsupportedOk:"OK",disclaimerTitle:"\u0926\u093e\u092f\u093f\u0924\u094d\u0935 \u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0923",disclaimerFeature:"\u0935\u093f\u0936\u0947\u0937\u0924\u093e",disclaimerBody:"\u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u094b \u092c\u0926\u0932\u0928\u0947 \u0938\u0947 \u0938\u0940\u0927\u0947 \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0915\u0940 \u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0914\u0930 ECU \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u091c\u094b\u0916\u093f\u092e\u094b\u0902 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u092a\u0922\u093c\u0947\u0902:\n\n\u2022 \u0917\u0932\u0924 \u0906\u0935\u0947\u0926\u0928 \u0938\u0947 \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u0916\u093c\u0924\u094d\u092e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964\n\u2022 \u0915\u0941\u091b \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0938\u094d\u0925\u093e\u092f\u0940 \u0916\u0930\u093e\u092c\u0940 \u092f\u093e \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u093e\u0936\u093f\u0924 \u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u093e\u0901 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964\n\u2022 \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0911\u092a\u0930\u0947\u0936\u0928 \u0909\u0932\u091f\u093e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948, \u0915\u0941\u091b \u0908\u0938\u0940\u092f\u0942 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0915\u094b \u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0930\u0940\u0938\u0947\u091f \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964\n\u2022 \u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092f\u093e \u0905\u092d\u094c\u0924\u093f\u0915 \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u0948\u0964\n\u2022 \u0907\u0928 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0916\u0930\u093e\u092c\u0940 \u092f\u093e \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 OBD2 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u094d\u0915\u0948\u0928\u0930 \u0915\u094b \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0928\u0939\u0940\u0902 \u0920\u0939\u0930\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\n\u0906\u092a\u0915\u094b \u092f\u0939 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0928\u0940 \u0939\u094b\u0917\u0940 \u0915\u093f \u0906\u092a\u0928\u0947 \u092f\u0939 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092a\u0922\u093c \u0914\u0930 \u0938\u092e\u091d \u0932\u0940 \u0939\u0948\u0964",checkboxTitle:"\u092a\u0941\u0937\u094d\u091f\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948",check1:"\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092a\u0922\u093c \u0932\u0940 \u0939\u0948 \u0914\u0930 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092e\u0947\u0930\u0947 \u0935\u093e\u0939\u0928 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",check2:"\u092e\u0948\u0902 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0913\u092c\u0940\u0921\u09402 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u094d\u0915\u0948\u0928\u0930 \u0907\u0938 \u0911\u092a\u0930\u0947\u0936\u0928 \u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0916\u0930\u093e\u092c\u0940 \u092f\u093e \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",check3:"\u092e\u0948\u0902 \u0938\u092d\u0940 \u091c\u094b\u0916\u093f\u092e\u094b\u0902 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0907\u091a\u094d\u091b\u093e \u0938\u0947 \u092f\u0939 \u092c\u0926\u0932\u093e\u0935 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902\u0964",disclaimerCancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902",disclaimerContinue:"\u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",unsupportedTitle:"\u0935\u093e\u0939\u0928 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948",unsupportedMsg:"\u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0915\u0947 \u0908\u0938\u0940\u092f\u0942 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"},disconnectShort:"\u0921\u093f\u0938\u094d\u0915.",obdTerminal:{title:"\u0939\u093f\u0921\u0928 \u092b\u0940\u091a\u0930\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0914\u0930 \u092f\u0942\u0921\u0940\u090f\u0938 \u0915\u094b\u0921\u093f\u0902\u0917",terminalTitle:"\u0913\u092c\u0940\u0921\u0940 \u091f\u0930\u094d\u092e\u093f\u0928\u0932",terminalPlaceholder:"\u0908\u0938\u0940\u092f\u0942 \u0915\u094b \u092d\u0947\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u091a\u0947 \u0915\u092e\u093e\u0902\u0921 \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 010\u0938\u0940, \u090f\u091f\u0940\u0906\u0930\u0935\u0940)",inputPlaceholder:"\u0906\u0926\u0947\u0936 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902...",sendButton:"\u092d\u0947\u091c\u0947\u0902",statsTitle:"\u0913\u092c\u0940\u0921\u0940 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940",connectionProtocol:"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932:",none:"\u0915\u094b\u0908 \u0928\u0939\u0940\u0902",hardwareQualityScore:"\u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0938\u094d\u0915\u094b\u0930:",original:"\u092e\u094c\u0932\u093f\u0915",clone:"\u0915\u094d\u0932\u094b\u0928",requestResponseCount:"\u0905\u0928\u0941\u0930\u094b\u0927/\u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0917\u0923\u0928\u093e:",timeoutCount:"\u0938\u092e\u092f \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0917\u0923\u0928\u093e:",recoveryCount:"\u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0917\u0923\u0928\u093e (\u0935\u0938\u0942\u0932\u0940):",diagnosticLogTitle:"\u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0932\u0949\u0917",clearButton:"\u0938\u094d\u092a\u0937\u094d\u091f",shareButton:"\u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902",noLogs:"\u0915\u094b\u0908 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0932\u0949\u0917 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e.",noShareSupport:"\u0907\u0938 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u0938\u093e\u091d\u093e\u0915\u0930\u0923 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902."},dtcContext:{powertrain:"\u092f\u0939 \u0916\u0930\u093e\u092c\u0940 \u0908\u0902\u0927\u0928 \u0905\u0930\u094d\u0925\u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u0914\u0930 \u0907\u0902\u091c\u0928 \u0915\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u092a\u0942\u0930\u094d\u0923 \u0928\u093f\u0926\u093e\u0928 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902 \u2192",cooling:"\u0917\u0902\u092d\u0940\u0930 \u0936\u0940\u0924\u0932\u0928 \u0916\u0924\u0930\u0947 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e\u0964 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u092e\u0930\u092e\u094d\u092e\u0924 \u091a\u0930\u0923 \u0926\u0947\u0916\u0947\u0902 \u2192",ignition:"\u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e\u0964 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u092e\u0930\u092e\u094d\u092e\u0924 \u091a\u0930\u0923 \u0926\u0947\u0916\u0947\u0902 \u2192",chassis:"\u091a\u0947\u0938\u093f\u0938 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940. \u092a\u0942\u0930\u094d\u0923 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0947 \u0932\u093f\u090f PRO \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902 \u2192",body:"\u092c\u0949\u0921\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u094d\u0938 \u092e\u0947\u0902 \u0916\u0930\u093e\u092c\u0940 \u092a\u093e\u0908 \u0917\u0908\u0964 \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0928\u093f\u0926\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902 \u2192",network:"\u0938\u0902\u091a\u093e\u0930 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0924\u094d\u0930\u0941\u091f\u093f. PRO \u092a\u0942\u0930\u094d\u0923 \u0938\u092e\u0938\u094d\u092f\u093e \u0928\u093f\u0935\u093e\u0930\u0923 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0924\u093e \u0939\u0948 \u2192",fallback:"\u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0926\u094b\u0937 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923, \u092e\u0930\u092e\u094d\u092e\u0924 \u0932\u093e\u0917\u0924 \u0914\u0930 \u091c\u094b\u0916\u093f\u092e \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902 \u2192"},perfTeaser:{limitTitle:"\u0926\u0948\u0928\u093f\u0915 \u0938\u0940\u092e\u093e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0917\u092f\u093e",limitDesc:"\u0906\u092a 3 \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 0-60 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u0923\u094b\u0902 \u0915\u0940 \u0926\u0948\u0928\u093f\u0915 \u0938\u0940\u092e\u093e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0917\u090f \u0939\u0948\u0902\u0964 \u0905\u0938\u0940\u092e\u093f\u0924 \u092a\u0930\u0940\u0915\u094d\u0937\u0923\u094b\u0902 \u0914\u0930 0-100 \u0915\u093f\u092e\u0940/\u0918\u0902\u091f\u093e \u092e\u093e\u092a \u0915\u0947 \u0932\u093f\u090f PRO \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902\u0964"},sandbox:{title:"\u0939\u093f\u0921\u0928 \u092b\u0940\u091a\u0930\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0914\u0930 \u092f\u0942\u0921\u0940\u090f\u0938 \u0915\u094b\u0921\u093f\u0902\u0917",connectionStatus:"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u094d\u0925\u093f\u0924\u093f:",ecuStatus:"\u0908\u0938\u0940\u092f\u0942 \u0938\u094d\u0925\u093f\u0924\u093f:",fps:"\u092f\u0942\u0906\u0908 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928: {{fps}} \u090f\u092b\u092a\u0940\u090f\u0938",stressBtnStart:"20Hz \u0924\u0928\u093e\u0935 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902",stressBtnStop:"\u091f\u0947\u0932\u0940\u092e\u0947\u091f\u094d\u0930\u0940 \u0932\u0942\u092a \u092c\u0902\u0926 \u0915\u0930\u094b",stopDisconnect:"\u0930\u094b\u0915\u0947\u0902/\u0921\u093f\u0938\u094d\u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902",discoveredDevices:"\u0916\u094b\u091c\u0947 \u0917\u090f \u0909\u092a\u0915\u0930\u0923",connect:"\u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902",scanning:"\u0938\u094d\u0915\u0948\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",scan:"\u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902",rpm:"\u0907\u0902\u091c\u0928 \u0906\u0930\u092a\u0940\u090f\u092e",speed:"\u0935\u093e\u0939\u0928 \u0915\u0940 \u0917\u0924\u093f",coolant:"\u0936\u0940\u0924\u0932\u0915 \u0924\u093e\u092a\u092e\u093e\u0928",throttle:"\u0917\u0932\u093e \u0918\u094b\u0902\u091f\u0928\u093e \u0938\u094d\u0925\u093f\u0924\u093f",notConnected:"\u0915\u0928\u0947\u0915\u094d\u091f\u0947\u0921 \u0928\u0939\u0940\u0902",connected:"\u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906",connecting:"\u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b 