amento delle ruote."},adas_cross_traffic_alert_sensitivity_adjust:{name:"Raggio di rilevamento dell'allarme traffico trasversale posteriore (RCTA).",desc:"Aumenta la distanza di rilevamento radar laterale per i veicoli che si avvicinano mentre fanno retromarcia."},adas_aeb_emergency_braking_threshold_preview:{name:"Efficacia dell'avviso di frenata automatica di emergenza (AEB).",desc:"Regola i tempi del segnale acustico di avviso anticipato o tardivo per gli avvisi di collisione anteriore."},adas_night_vision_camera_alignment:{name:"Allineamento del target della termocamera per visione notturna a infrarossi",desc:"Avvia la sequenza di verifica dell'allineamento del piedistallo della telecamera a infrarossi."},adas_dms_driver_monitoring_ir_threshold:{name:"Sensibilit\xe0 a infrarossi della fotocamera DMS Driver Attenzione",desc:"Regola la soglia di tracciamento oculare per i conducenti che indossano occhiali da sole polarizzati scuri."},toyota_soft_close_door_retrofit_coding:{name:"Codifica dell'attuatore di vuoto per porta con chiusura rallentata",desc:"Abilita gli attuatori di estrazione della chiusura elettrica della porta nel modulo di controllo della carrozzeria."},toyota_digital_speedometer_display_enable:{name:"Display del calibro centrale del tachimetro digitale",desc:"Aggiunge un'ampia lettura digitale della velocit\xe0 al display LCD del quadro strumenti analogico."},toyota_walk_away_auto_lock_sensitivity:{name:"Sensibilit\xe0 di chiusura automatica della porta con chiave intelligente Walk-Away",desc:"Regola la soglia della distanza prima che le porte si blocchino automaticamente quando ci si allontana."},toyota_jbl_3d_eq_audio_profile_unlock:{name:"Curve dell'equalizzatore audio JBL Premium Surround",desc:"Sblocca i profili dell'equalizzatore 3D della sala da concerto nell'unit\xe0 principale audio JBL."},toyota_ev_mode_throttle_override_suppression:{name:"Modalit\xe0 EV Soppressione del limite dell'acceleratore puramente elettrico",desc:"Impedisce l'avvio del motore a benzina durante l'accelerazione EV moderata."},ford_sync3_engineering_diagnostics_page:{name:"Schermata diagnostica tecnica touchscreen SYNC3 / SYNC4",desc:"Abilita le schermate diagnostiche GPS grezze, test APIM e frequenza audio su SYNC."},ford_rear_seat_entertainment_unlock:{name:"Pass-through audio HDMI/intrattenimento video per sedile posteriore",desc:"Abilita lo streaming audio delle cuffie dell'abitacolo per gli schermi di intrattenimento dei sedili posteriori."},ford_bambi_mode_fog_light_expansion:{name:"Modalit\xe0 Bambi Abbaglianti + Fendinebbia Illuminazione simultanea",desc:"Mantiene accesi i fendinebbia anteriori anche quando sono attivati gli abbaglianti."},ford_auto_engine_idle_shutdown_30min_override:{name:"Disattivazione dello spegnimento automatico del motore al minimo di 30 minuti",desc:"Impedisce lo spegnimento automatico del motore dopo 30 minuti di parcheggio."},hyundai_n_grin_shift_retrofit_enable:{name:"Sblocco retrofit overboost di 20 secondi N Grin Shift (NGS).",desc:"Abilita la funzione overboost del pulsante NGS sul volante nella ECU."},hyundai_smart_tailgate_approach_distance:{name:"Rilevamento di prossimit\xe0 di avvicinamento al portellone posteriore intelligente a mani libere",desc:"Regola il tempo di ritardo dello stazionamento (da 3 secondi a 1 secondo) prima che il portellone intelligente si apra automaticamente."},hyundai_digital_cluster_n_performance_theme:{name:"Layout degli strumenti del quadro strumenti digitale N Performance",desc:"Applica il layout del quadro strumenti con indicatore di spostamento rosso N-Performance al cruscotto LCD standard."},stellantis_scr_adblue_warning_threshold_adjust:{name:"Regolazione della soglia di distanza di avviso SCR AdBlue",desc:"Regola la distanza di avviso del primo rifornimento di AdBlue da 2400 km a 1000 km."},stellantis_jeep_trail_rated_offroad_pages:{name:"Pagine di telemetria fuoristrada Jeep Uconnect Trail-Rated",desc:"Sblocca le pagine su passo, rollio, articolazione d