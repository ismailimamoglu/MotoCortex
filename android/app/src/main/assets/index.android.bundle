0% \u0e17\u0e23\u0e34\u0e1b)"},tesla_mirror_fold_lock:{name:"\u0e01\u0e23\u0e30\u0e08\u0e01\u0e1e\u0e31\u0e1a\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e25\u0e47\u0e2d\u0e04 Walk-Away (Tesla)",desc:"\u0e01\u0e23\u0e30\u0e08\u0e01\u0e21\u0e2d\u0e07\u0e02\u0e49\u0e32\u0e07\u0e1e\u0e31\u0e1a\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e25\u0e47\u0e2d\u0e04\u0e01\u0e38\u0e0d\u0e41\u0e08\u0e42\u0e17\u0e23\u0e28\u0e31\u0e1e\u0e17\u0e4c\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e40\u0e14\u0e34\u0e19\u0e2d\u0e2d\u0e01\u0e44\u0e1b"},nissan_coming_home:{name:"\u0e2b\u0e19\u0e48\u0e27\u0e07\u0e40\u0e27\u0e25\u0e32\u0e01\u0e32\u0e23\u0e1b\u0e34\u0e14\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32 (Nissan)",desc:"\u0e0a\u0e48\u0e27\u0e22\u0e43\u0e2b\u0e49\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32\u0e2a\u0e27\u0e48\u0e32\u0e07\u0e40\u0e1b\u0e47\u0e19\u0e40\u0e27\u0e25\u0e32 30 \u0e27\u0e34\u0e19\u0e32\u0e17\u0e35\u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e2d\u0e2d\u0e01\u0e08\u0e32\u0e01\u0e23\u0e16\u0e19\u0e34\u0e2a\u0e2a\u0e31\u0e19"},nissan_lane_change_flash:{name:"\u0e23\u0e30\u0e1a\u0e1a\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e40\u0e25\u0e19\u0e41\u0e1a\u0e1a\u0e41\u0e15\u0e30\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e1c\u0e48\u0e32\u0e19 (Nissan)",desc:"\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e08\u0e33\u0e19\u0e27\u0e19\u0e1e\u0e31\u0e25\u0e2a\u0e4c\u0e02\u0e2d\u0e07\u0e44\u0e1f\u0e40\u0e25\u0e35\u0e49\u0e22\u0e27\u0e1a\u0e19\u0e01\u0e49\u0e32\u0e19\u0e44\u0e1f"},nissan_autolock_behavior:{name:"\u0e25\u0e47\u0e2d\u0e04\u0e1b\u0e23\u0e30\u0e15\u0e39\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e15\u0e32\u0e21\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27 (Nissan)",desc:"\u0e25\u0e47\u0e2d\u0e04\u0e1b\u0e23\u0e30\u0e15\u0e39\u0e17\u0e38\u0e01\u0e1a\u0e32\u0e19\u0e42\u0e14\u0e22\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e23\u0e16\u0e16\u0e36\u0e07 24 \u0e01\u0e21./\u0e0a\u0e21."},nissan_window_remote:{name:"\u0e01\u0e38\u0e0d\u0e41\u0e08\u0e23\u0e35\u0e42\u0e21\u0e17\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e01\u0e23\u0e30\u0e08\u0e01\u0e44\u0e1f\u0e1f\u0e49\u0e32 (Nissan)",desc:"\u0e40\u0e1b\u0e34\u0e14/\u0e1b\u0e34\u0e14\u0e2b\u0e19\u0e49\u0e32\u0e15\u0e48\u0e32\u0e07\u0e14\u0e49\u0e32\u0e19\u0e2b\u0e19\u0e49\u0e32\u0e14\u0e49\u0e27\u0e22\u0e1b\u0e38\u0e48\u0e21\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e04\u0e01\u0e38\u0e0d\u0e41\u0e08 fob \u0e01\u0e14\u0e04\u0e49\u0e32\u0e07\u0e44\u0e27\u0e49"},nissan_seatbelt_chime_mute:{name:"\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e23\u0e31\u0e14\u0e40\u0e02\u0e47\u0e21\u0e02\u0e31\u0e14\u0e19\u0e34\u0e23\u0e20\u0e31\u0e22 (Nissan)",desc:"\u0e1b\u0e34\u0e14\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e23\u0e31\u0e14\u0e40\u0e02\u0e47\u0e21\u0e02\u0e31\u0e14\u0e19\u0e34\u0e23\u0e20\u0e31\u0e22\u0e0b\u0e49\u0e33\u0e46 \u0e42\u0e14\u0e22\u0e17\u0e35\u0e48\u0e22\u0e31\u0e07\u0e04\u0e07\u0e44\u0e2d\u0e04\u0e2d\u0e19\u0e04\u0e25\u0e31\u0e2a\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e44\u0e27\u0e49"},porsche_sport_chrono_launch:{name:"\u0e42\u0e1b\u0e23\u0e44\u0e1f\u0e25\u0e4c\u0e01\u0e32\u0e23\u0e15\u0e2d\u0e1a\u0e2a\u0e19\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e34\u0e14\u0e15\u0e31\u0e27 Sport Chrono (\u0e1b\u0e2d\u0e23\u0e4c\u0e40\u0e0a\u0e48)",desc:"\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e01\u0e32\u0e23\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e34\u0e14\u0e15\u0e31\u0e27\u0e40\u0e01\u0e35\u0e22\u0e23\u0e4c PDK \u0e40\u0e01\u0e13\u0e11\u0e4c RPM \u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e01\u0e31\u0e14\u0e04\u0e25\u0e31\u0e15\u0e0a\u0e4c"},porsche_pasm_default:{name:"\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e0a\u0e48\u0e27\u0e07\u0e25\u0e48\u0e32