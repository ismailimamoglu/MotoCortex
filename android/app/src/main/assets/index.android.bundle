41a\u0410\u041d\u0423\u0412\u0410\u041d\u041d\u042f...",vehicleIdentity:"ID \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0406\u041b\u042f \u0422\u0410 \u041f\u0420\u041e\u0411\u0406\u0413",vin:"\u041d\u043e\u043c\u0435\u0440 \u0448\u0430\u0441\u0456 (VIN)",odometer:"\u041e\u0440\u0438\u0433\u0456\u043d\u0430\u043b \u041a\u041c",distSinceCleared:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u0430",milDist:"\u0406\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0433\u043e\u0440\u0438\u0442\u044c",dtcTitle:"\u041a\u043e\u0434\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 (DTC)",dtcClean:"\u041d\u0415\u041c\u0410\u0404 \u041a\u041e\u0414\u0406\u0412 \u041f\u041e\u041c\u0418\u041b\u041e\u041a - \u0427\u0418\u0421\u0422\u041e",extraActions:"\u0414\u041e\u0414\u0410\u0422\u041a\u041e\u0412\u0406 \u041e\u041f\u0415\u0420\u0410\u0426\u0406\u0407",garageTitle:"\u0413\u0410\u0420\u0410\u0416 \u0406 \u041c\u0418\u041d\u0423\u041b\u0406 \u0417\u0410\u041f\u0418\u0421\u0418",share:"\u041f\u041e\u0414\u0406\u041b\u0418\u0422\u0418\u0421\u042f",saveVehicle:"\u0417\u0411\u0415\u0420\u0415\u0416\u0406\u0422\u042c \u0426\u0415\u0419 \u0406\u041d\u0421\u0422\u0420\u0423\u041c\u0415\u041d\u0422",noRecords:"\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u0445 \u0437\u0430\u0441\u043e\u0431\u0456\u0432.",clean:"\u0427\u0418\u0421\u0422\u0418\u0419",faults:"\u041d\u0415\u0412\u0414\u0410\u0427\u0410",vinRequired:"VIN \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0438\u0439",vinRequiredDesc:"\u0414\u043b\u044f \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u0457 \u043d\u043e\u043c\u0435\u0440 \u0448\u0430\u0441\u0456 (VIN) \u043c\u0430\u0454 \u0437\u2019\u044f\u0432\u0438\u0442\u0438\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0430\u0431\u043e \u0431\u0443\u0442\u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u0439 \u0432\u0440\u0443\u0447\u043d\u0443.",missingInfo:"\u0412\u0456\u0434\u0441\u0443\u0442\u043d\u044f \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f",missingInfoDesc:"\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0437\u0430\u043f\u043e\u0432\u043d\u0456\u0442\u044c \u043f\u043e\u043b\u044f \u041c\u0430\u0440\u043a\u0430 \u0442\u0430 \u041c\u043e\u0434\u0435\u043b\u044c.",saved:"\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e ",savedDesc:"\u0417\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c\u0438 \u0435\u043a\u0441\u043f\u0435\u0440\u0442\u0438\u0437\u0438 \u043f\u0440\u0438\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0434\u043e \u0433\u0430\u0440\u0430\u0436\u0443.",connRequired:"\u041f\u043e\u0442\u0440\u0456\u0431\u043d\u0435 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f",connRequiredDesc:"\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0456\u0442\u044c\u0441\u044f \u0434\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f, \u0449\u043e\u0431 \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0446\u0435\u0439 \u043f\u0440\u043e\u0446\u0435\u0441.",chronicFaultsTitle:"\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u043d\u0456 \u0445\u0440\u043e\u043d\u0456\u0447\u043d\u0456 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438",chronicFaultsObs:"{{code}}(\u0421\u043f\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f:{{days}}\u0456\u043d\u0448\u0438\u0439 \u0434\u0435\u043d\u044c / \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c:{{total}}\u0440\u0430\u0437\u0456\u0432)",chronicFaultsPending:"\u0417\u0431\u0456\u0440 \u0434\u0430\u043d\u0438\u0445 / \u0410\u043d\u0430\u043b\u0456\u0437 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438",notScanned:"\u041d\u0435 \u0441\u043a\u0430\u043d\u043e\u0432\u0430\u043d\u043e",notScannedDesc:"\u0429\u043e\u0431 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0456 \u043a\u043e\u0434\u0438, \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0443 \u0432\u0435\u0440\u0445\u043d\u044c\u043e\u043c\u0443 \u043f\u0440\u0430\u0432\u043e\u043c\u0443 \u043a\u0443\u0442\u0456.",scanFailed:"\u041f\u041e\u041c\u0418\u041b\u041a\u0410 \u0421\u041a\u0410\u041d\u0423\u0412\u0410\u041d\u041d\u042f",errTimeout:"Error: Connection Timeout (TIMEOUT)\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost (CONNECTION_LOST)\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\n(HARDWARE_FATAL_RECOVERY_FAILED)\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error (ERROR_UNABLE_TO_READ)\nECU trouble codes could not be read.",scannedSystems:"\u0421\u043a\u0430\u043d\u043e\u0432\u0430\u043d\u0456 \u0441\u0438\u0441\u0442\u0435\u043c\u0438",moduleEngine:"\u0411\u043b\u043e\u043a \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u0432\u0438\u0433\u0443\u043d\u043e\u043c (ECU)",moduleAbs:"\u0410\u043d\u0442\u0438\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043b\u044c\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0433\u0430\u043b\u044c\u043c (ABS)",moduleTcm:"\u041c\u043e\u0434\u0443\u043b\u044c \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u0440\u043e\u0431\u043a\u043e\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447 (TCM)",moduleBcm:"\u041c\u043e\u0434\u0443\u043b\u044c \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0443\u0437\u043e\u0432\u043e\u043c (BCM)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" \u041f\u041e\u041f\u0415\u0420\u0415\u0414\u0416\u0415\u041d\u041d\u042f \u041f\u0420\u041e \u0411\u0415\u0417\u041f\u0415\u041a\u0423",safetyWarningDesc:"\u041f\u0456\u0434 \u0447\u0430\u0441 \u0446\u044c\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0443: \u2022 \u0417\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0432\u0438\u043d\u043d\u043e \u0431\u0443\u0442\u0438 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e \u2022 \u0414\u0432\u0438\u0433\u0443\u043d \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u0412\u0418\u041c\u041a\u041d\u0415\u041d\u041e \u2022 \u041d\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0439\u0442\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u0412\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?",step1:"\u041a\u0440\u043e\u043a 1. \u0412\u0438\u0434\u0430\u043b\u0456\u0442\u044c \u043a\u043e\u0434\u0438 \u043f\u043e\u043c\u0438\u043b\u043e\u043a",step1Desc:"\u0423\u0441\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u043a\u043e\u0434\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 (DTC) \u0456 \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 Check Engine \u0431\u0443\u0434\u0435 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e. \u0417\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043a\u043e\u0440\u0435\u043a\u0446\u0456\u0457 \u043f\u0430\u043b\u0438\u0432\u0430 \u0431\u0443\u0434\u0443\u0442\u044c \u0441\u043a\u0438\u043d\u0443\u0442\u0456. \u0426\u044e \u0434\u0456\u044e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438!",step2:"\u041a\u0440\u043e\u043a 2: Hard Reset ECU",step2Desc:"\u0415\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u0435 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f (Hard Reset) \u0431\u0443\u0434\u0435 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043d\u043e \u043d\u0430 \u043a\u043e\u043c\u043f\u2019\u044e\u0442\u0435\u0440 \u0434\u0432\u0438\u0433\u0443\u043d\u0430. \u0426\u0435 \u043f\u0440\u0430\u0446\u044e\u0454 \u044f\u043a \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430. \u0426\u0435 \u043d\u0435\u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0432 \u043d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0438\u0445 ECU. \u0426\u0435 \u043d\u0435 \u0448\u043a\u043e\u0434\u0438\u0442\u044c.",clearCodes:"\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u043a\u043e\u0434\u0438",ecuReset:"\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u043a\u043e\u0434\u0438 \u043f\u043e\u043c\u0438\u043b\u043e\u043a",finish:"\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 (\u0437\u0430\u043a\u0456\u043d\u0447\u0438\u0442\u0438)",completed:"\u0412\u0438\u043a\u043e\u043d\u0430\u043d\u043e ",completedDesc:"\u0421\u0435\u0440\u0432\u0456\u0441\u043d\u0456 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0457 \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c.",hardResetDesc:"\u0423\u0441\u0456 \u0441\u0435\u0440\u0432\u0456\u0441\u043d\u0456 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0457 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043e \u0443\u0441\u043f\u0456\u0448\u043d\u043e. \u2022 \u041a\u043e\u0434\u0438 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e \u2022 \u0421\u043a\u0438\u0434\u0430\u043d\u043d\u044f \u0440\u0435\u0433\u0443\u043b\u044e\u0432\u0430\u0447\u0456\u0432 \u043f\u0430\u043b\u0438\u0432\u0430 \u2022 \u0421\u043a\u0438\u0434\u0430\u043d\u043d\u044f ECU \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c."},info:{desc:"\u041f\u0440\u043e\u0444\u0435\u0441\u0456\u0439\u043d\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0434\u043b\u044f \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043c\u043e\u0442\u043e\u0446\u0438\u043a\u043b\u0456\u0432 \u0456 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u0445 \u0437\u0430\u0441\u043e\u0431\u0456\u0432. \u0421\u0443\u043c\u0456\u0441\u043d\u0438\u0439 \u0437 \u0443\u0441\u0456\u043c\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f\u043c\u0438.",upgrade:" \u041e\u043d\u043e\u0432\u0456\u0442\u044c \u0434\u043e Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"\u0420\u0430\u043d\u043d\u0456\u0439 \u0434\u043e\u0441\u0442\u0443\u043f ",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner \u0437\u0430\u0440\u0430\u0437 \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0432 \u0440\u043e\u0437\u0440\u043e\u0431\u0446\u0456. \u041e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u0438 \u0454 \u043d\u0430\u0448\u0438\u043c \u043f\u0435\u0440\u0448\u0438\u043c \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0435\u043c, \u0443\u0441\u0456 \u043f\u0440\u043e\u0444\u0435\u0441\u0456\u0439\u043d\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0432\u0430\u043c \u0437\u0430\u0440\u0430\u0437. \u0412\u0430\u0448 \u0432\u0456\u0434\u0433\u0443\u043a \u0434\u0443\u0436\u0435 \u0446\u0456\u043d\u043d\u0438\u0439 \u0434\u043b\u044f \u043d\u0430\u0441!",helpGuide:"\u0414\u041e\u041f\u041e\u041c\u041e\u0413\u0410 \u0422\u0410 \u041f\u041e\u0421\u0406\u0411\u041d\u0418\u041a",language:" \u041c\u043e\u0432\u0430 / \u041c\u043e\u0432\u0430 / Bahasa",support:"\u0426\u0415\u041d\u0422\u0420 \u041f\u0406\u0414\u0422\u0420\u0418\u041c\u041a\u0418",supportSubject:"\u041f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430 Cortex OBD2 Diagnostic Scanner \u0456 \u0432\u0456\u0434\u0433\u0443\u043a\u0438",thanks:"\u0434\u044f\u043a\u0443\u044e!",thanksDesc:"\u0414\u044f\u043a\u0443\u0454\u043c\u043e \u0437\u0430 \u0432\u0456\u0434\u0433\u0443\u043a. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043d\u0430\u043c \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u0443 Play Store.",sections:{live:{title:"\u0414\u0410\u0422\u0427\u0418\u041a\u0418 \u041c\u041e\u041d\u0406\u0422\u041e\u0420\u0418\u041d\u0413\u0423 \u0412 \u0416\u0418\u0412\u041e\u041c\u0423 \u0420\u0415\u0416\u0418\u041c\u0406",content:"\u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043c\u0438\u0442\u0442\u0454\u0432\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e\u0432\u0430\u0442\u0438 \u043e\u0431\u0435\u0440\u0442\u0438, \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0434\u0432\u0438\u0433\u0443\u043d\u0430, \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044f \u0434\u0440\u043e\u0441\u0435\u043b\u044c\u043d\u043e\u0457 \u0437\u0430\u0441\u043b\u0456\u043d\u043a\u0438, \u043d\u0430\u043f\u0440\u0443\u0433\u0443 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430, \u043d\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0434\u0432\u0438\u0433\u0443\u043d\u0430, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0456\u0442\u0440\u044f \u0442\u0430 \u0442\u0438\u0441\u043a \u0443 \u043a\u043e\u043b\u0435\u043a\u0442\u043e\u0440\u0456 (MAP). \u0417\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043e\u043d\u043e\u0432\u043b\u044e\u044e\u0442\u044c\u0441\u044f 1-5 \u0440\u0430\u0437\u0456\u0432 \u043d\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u0432 \u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0456 \u0432\u0456\u0434 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 Bluetooth. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0432\u0442\u0440\u0443\u0447\u0430\u0442\u0438\u0441\u044f \u0432 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u043a\u043e\u043c\u0430\u043d\u0434 UDS / OBD \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0440\u043c\u0456\u043d\u0430\u043b."},expertise:{title:"\u041e\u0413\u041b\u042f\u0414 \u0422\u0410 \u0413\u0410\u0420\u0410\u041d\u0422\u0406\u042f",content:"\u0414\u043e\u0434\u0430\u0442\u043e\u043a \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u043a\u043e\u0434\u0438 ECU (Brain) \u0434\u043b\u044f \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043d\u044f \u043f\u043e\u043c\u0438\u043b\u043e\u043a. \u0417\u0430\u043f\u0438\u0441\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u043e\u043c\u0435\u0440 VIN (VIN) \u0456 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 \u043f\u0440\u043e\u0431\u0456\u0433 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u043c\u0438\u043d\u0443\u043b\u0456 \u043f\u043e\u043c\u0438\u043b\u043a\u0438 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u044c\u0441\u044f \u0448\u043b\u044f\u0445\u043e\u043c \u043f\u0456\u0434\u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u0456, \u044f\u043a\u0443 \u043f\u0440\u043e\u0457\u0445\u0430\u0432 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 Check Engine. \u041e\u0442\u0440\u0438\u043c\u0430\u043d\u0438\u043c \u0437\u0432\u0456\u0442\u043e\u043c \u043c\u043e\u0436\u043d\u0430 \u043f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f \u0432 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430\u0445 PDF \u0456 Messaging."},tests:{title:"\u0411\u0410\u0422\u0410\u0420\u0415\u042f / \u0422\u0415\u0421\u0422\u0418 \u041f\u0420\u041e\u0414\u0423\u041a\u0422\u0418\u0412\u041d\u041e\u0421\u0422\u0406",content:"\u0422\u0435\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0441\u043a\u043b\u0430\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0437 3 \u0435\u0442\u0430\u043f\u0456\u0432: \u0443 \u0440\u0435\u0436\u0438\u043c\u0456 \u0432\u0456\u0434\u043f\u043e\u0447\u0438\u043d\u043a\u0443, \u043f\u0443\u0441\u043a\u0443 \u0442\u0430 \u0437\u0430\u0440\u044f\u0434\u0443 \u0432 \u0440\u0435\u0436\u0438\u043c\u0456 \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u0433\u043e \u0445\u043e\u0434\u0443 \u0432\u0438\u043c\u0456\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u0431\u0430\u0442\u0430\u0440\u0435\u0457/\u0440\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u0430. \u0422\u0435\u0441\u0442 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456 \u0432\u0438\u043c\u0456\u0440\u044e\u0454 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u044f 0-60 \u0456 0-100 \u043a\u043c/\u0433\u043e\u0434 \u0437 \u043f\u043e\u0445\u0438\u0431\u043a\u043e\u044e 50 \u043c\u0441, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0447\u0438 \u0434\u0430\u043d\u0456 \u043f\u0440\u043e \u043c\u0438\u0442\u0442\u0454\u0432\u0443 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0437 \u043f\u0440\u043e\u0446\u0435\u0441\u043e\u0440\u0430 \u0432\u0430\u0448\u043e\u0433\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0442\u0430 \u0432\u0430\u0448\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f."},hardware:{title:"\u0410\u041f\u0410\u0420\u0410\u0422\u041d\u0410 \u0421\u0423\u041c\u0406\u0421\u041d\u0406\u0421\u0422\u042c",content:"\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f ELM327 Bluetooth (v1.5). \u0414\u0435\u044f\u043a\u0456 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u043a\u043e\u0434\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u043d\u0430 \u0430\u043f\u0430\u0440\u0430\u0442\u043d\u043e\u043c\u0443 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u0456 \u043d\u0438\u0437\u044c\u043a\u043e\u0457 \u044f\u043a\u043e\u0441\u0442\u0456 \u0437 \u0432\u0435\u0440\u0441\u0456\u0454\u044e CLONE v2.1. \u0412\u0438 \u043e\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u0435 \u043d\u0430\u0439\u0432\u0438\u0449\u0443 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0437\u0430\u0432\u0434\u044f\u043a\u0438 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430\u043c \u043f\u0440\u0435\u043c\u0456\u0443\u043c-\u043a\u043b\u0430\u0441\u0443, \u0442\u0430\u043a\u0438\u043c \u044f\u043a vLinker \u0456 OBDLink."},warnings:{title:"\u0412\u0410\u0416\u041b\u0418\u0412\u0406 \u0417\u0410\u0421\u0422\u0415\u0420\u0415\u0416\u0415\u041d\u041d\u042f",content:"\u2022 \u041f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0440\u043e\u0446\u0435\u0441\u0443 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f \u043a\u043e\u0434\u0443 \u043f\u043e\u043c\u0438\u043b\u043a\u0438 \u0430\u0431\u043e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f ECU \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0432\u0438\u043d\u043d\u043e \u0431\u0443\u0442\u0438 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e, \u0430 \u0434\u0432\u0438\u0433\u0443\u043d \u0412\u0418\u041c\u041a\u041d\u0415\u041d. \u2022 \u041d\u0435 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0439\u0442\u0435 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u043c\u0443 \u0437\u0430\u0441\u043e\u0431\u0443, \u0449\u043e \u043f\u0440\u0430\u0446\u044e\u0454. \u2022 \u041d\u0435 \u043a\u043e\u0436\u0435\u043d \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u043c\u043e\u0436\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0456 \u0434\u0430\u0442\u0447\u0438\u043a\u0438, \u043d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0456 \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u0438\u043c\u0443\u0442\u044c \"--\"."},onboarding:{title:"\u042e\u0420\u0418\u0414\u0418\u0427\u041d\u0406 \u0414\u041e\u0417\u0412\u041e\u041b\u0418 \u0422\u0410 \u0410\u041d\u041e\u041d\u0406\u041c\u041d\u0410 \u0422\u0415\u041b\u0415\u041c\u0415\u0422\u0420\u0406\u042f",content:"\u0429\u043e\u0431 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u044f\u043a\u0456\u0441\u0442\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0442\u0430 \u0441\u0443\u043c\u0456\u0441\u043d\u0456\u0441\u0442\u044c \u0437 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u043c \u0437\u0430\u0441\u043e\u0431\u043e\u043c; \u041f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0430\u043d\u043e\u043d\u0456\u043c\u043d\u0456 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0442\u0430 \u043a\u043e\u0434\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439, \u0437\u0433\u0435\u043d\u0435\u0440\u043e\u0432\u0430\u043d\u0456 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 (\u0431\u0435\u0437 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0456 \u043d\u043e\u043c\u0435\u0440\u0430 \u0448\u0430\u0441\u0456), \u043c\u043e\u0436\u043d\u0430 \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043d\u0430 \u043d\u0430\u0448\u0438\u0445 \u0437\u0430\u0445\u0438\u0449\u0435\u043d\u0438\u0445 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u0445. \u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u044e\u0447\u0438, \u0432\u0438 \u043f\u043e\u0433\u043e\u0434\u0436\u0443\u0454\u0442\u0435\u0441\u044f \u0437 \u0443\u043c\u043e\u0432\u0430\u043c\u0438 \u0430\u043d\u043e\u043d\u0456\u043c\u043d\u043e\u0457 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u0457. \u0414\u043b\u044f \u0437\u0432\u2019\u044f\u0437\u043a\u0443 \u0437 \u0415\u0411\u0423 \u0432\u0430\u0448\u043e\u0433\u043e \u043c\u043e\u0442\u043e\u0446\u0438\u043a\u043b\u0430 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0456 \u0434\u043e\u0437\u0432\u043e\u043b\u0438 \u043d\u0430 Bluetooth \u0456 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f."},featureCoding:{title:"\u0420\u041e\u0417\u0411\u041b\u041e\u041a\u0423\u0412\u0410\u041d\u041d\u042f \u041f\u0420\u0418\u0425\u041e\u0412\u0410\u041d\u0418\u0425 \u0424\u0423\u041d\u041a\u0426\u0406\u0419 \u0422\u0410 \u041a\u041e\u0414\u0423\u0412\u0410\u041d\u041d\u042f UDS",content:"\u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043d\u0430\u0448\u043e\u0433\u043e \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443 ISO 14229 UDS Protocol Engine \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0439\u0442\u0435 \u0442\u0430\u043a\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457, \u044f\u043a \u043f\u0430\u0440\u043a\u0443\u0432\u0430\u043b\u044c\u043d\u0456 \u0432\u043e\u0433\u043d\u0456 \u0421\u0428\u0410, \u0440\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u043d\u043d\u044f \u0433\u043e\u043b\u043a\u0438, \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043b\u0430\u043a\u0441\u043e\u043d\u0430, \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u0456 \u0432\u0456\u043a\u043d\u0430 \u0442\u0430 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f DRL \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456\u0432 VAG, BMW, Renault \u0456 Dacia."},multiEcu:{title:"\u0421\u041a\u0410\u041d\u0423\u0412\u0410\u041d\u041d\u042f \u0412\u0421\u0406\u0425 \u041c\u041e\u0414\u0423\u041b\u0406\u0412 \u041c\u0423\u041b\u042c\u0422\u0418-\u0411\u0415\u041a\u0423",content:"\u041f\u0440\u043e\u0441\u043a\u0430\u043d\u0443\u0439\u0442\u0435 \u0442\u0430 \u043e\u0447\u0438\u0441\u0442\u0456\u0442\u044c \u043a\u043e\u0434\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 \u0437\u0430 \u043c\u0435\u0436\u0430\u043c\u0438 ECU \u0434\u0432\u0438\u0433\u0443\u043d\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 ABS, Airbag, \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0443 \u0442\u0440\u0430\u043d\u0441\u043c\u0456\u0441\u0456\u044e (TCU), \u043f\u0440\u0438\u043b\u0430\u0434\u043e\u0432\u0443 \u043f\u0430\u043d\u0435\u043b\u044c, \u043a\u043b\u0456\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c (HVAC) \u0456 \u043c\u043e\u0434\u0443\u043b\u0456 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0443\u0437\u043e\u0432\u043e\u043c (BCM)."},advancedDiagnostics:{title:"\u0410\u0414\u0410\u041f\u0422\u0410\u0426\u0406\u042f DCT, DPF \u0422\u0410 \u041f\u041e\u0422\u0423\u0416\u041d\u0406\u0421\u0422\u042c HP",content:"\u2022 DCT / DSG Clutch Kiss Point \u041d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0441\u043a\u0438\u0434\u0430\u043d\u043d\u044f \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0456\u0457\n\u2022 \u041d\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0441\u0430\u0436\u0456 DPF (%/\u0433) \u0456 \u043c\u043e\u043d\u0456\u0442\u043e\u0440\u0438\u043d\u0433 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0438 \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457 \u0432\u0438\u0445\u043b\u043e\u043f\u0443\n\u2022 \u041a\u043e\u0440\u043e\u0442\u043a\u043e\u0441\u0442\u0440\u043e\u043a\u043e\u0432\u0456/\u0434\u043e\u0432\u0433\u043e\u0441\u0442\u0440\u043e\u043a\u043e\u0432\u0456 \u043a\u043e\u0440\u0435\u043a\u0446\u0456\u0457 \u043f\u0430\u043b\u0438\u0432\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0456 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0447\u0430\u0441\u0443 (STFT/LTFT) \u0456 \u043b\u044f\u043c\u0431\u0434\u0430-\u0430\u043d\u0430\u043b\u0456\u0437\n\u2022 \u0416\u0438\u0432\u0438\u0439 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0438\u0439 \u0433\u0440\u0430\u0444\u0456\u043a \u0434\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u043e\u0457 \u043f\u043e\u0442\u0443\u0436\u043d\u043e\u0441\u0442\u0456 (HP) \u0456 \u043a\u0440\u0443\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0443 (Nm)."},demoMode:{title:"\u0414\u0415\u041c\u041e \u0420\u0415\u0416\u0418\u041c (\u0421\u0418\u041c\u0423\u041b\u042f\u0426\u0406\u042f)",content:"\u0422\u0435\u0441\u0442\u0443\u0439\u0442\u0435 \u0442\u0430 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u0439\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0431\u0435\u0437 \u0444\u0456\u0437\u0438\u0447\u043d\u043e\u0433\u043e \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f OBD2. \u0412\u0456\u0434\u0447\u0443\u0439\u0442\u0435 \u0432\u0441\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 CAN-Bus \u0456 UDS \u0456\u0437 \u0440\u0435\u0430\u043b\u0456\u0441\u0442\u0438\u0447\u043d\u0438\u043c \u043c\u043e\u0434\u0435\u043b\u044e\u0432\u0430\u043d\u043d\u044f\u043c \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u0457 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0430\u0441\u0456."}},reconfigurePermissions:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0435 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0434\u043e\u0437\u0432\u043e\u043b\u0456\u0432 \u0456 \u044e\u0440\u0438\u0434\u0438\u0447\u043d\u0438\u0445 \u0443\u043c\u043e\u0432",shareWithFriend:"\u041f\u041e\u0414\u0406\u041b\u0418\u0422\u0418\u0421\u042f \u0417 \u0414\u0420\u0423\u0413\u041e\u041c",shareMessageText:"\u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044c \u043f\u0440\u043e \u043a\u043e\u0434\u0438 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0415\u0411\u0423 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0442\u0430 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u044e \u0434\u0430\u0442\u0447\u0438\u043a\u0456\u0432 \u0443 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0430\u0441\u0456 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Cortex OBD2 Diagnostic Scanner!\n\n\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0437\u0430\u0440\u0430\u0437:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:" \u2550\u2550\u2550 \u0414\u0406\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u0427\u041d\u0418\u0419 \u0417\u0412\u0406\u0422 \u041c\u041e\u0422\u041e\u041a\u041e\u0420\u0422\u0415\u041a\u0421\u0423 \u2550\u2550\u2550 ",vehicleIdentity:" ID \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0406\u041b\u042f",vin:"\u041d\u043e\u043c\u0435\u0440 \u0448\u0430\u0441\u0456 (VIN)",odometer:"\u0412\u0456\u0434\u0441\u0442\u0430\u043d\u044c (\u043a\u043c)",milDist:"\u0406\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u0433\u043e\u0440\u0438\u0442\u044c",distSinceCleared:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u0430",dtcCount:" \u041a\u041e\u0414\u0418 \u041f\u041e\u041c\u0418\u041b\u041e\u041a ({{count}}\u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c)",sensorData:" \u0414\u0410\u041d\u0406 \u0414\u0410\u0422\u0427\u0418\u041a\u0410 \u0412 \u0416\u0418\u0412\u041e\u041c\u0423 \u0420\u0415\u0416\u0418\u041c\u0406",noData:"\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u0434\u0430\u043d\u0456",proApp:"\u0412\u0456\u0434\u0441\u043a\u0430\u043d\u043e\u0432\u0430\u043d\u043e \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"\u0434\u0430\u0442\u0430",vinNotFound:"\u041d\u0435 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043e",noDtcs:"\u041d\u0415\u041c\u0410\u0404 \u041a\u041e\u0414\u0406\u0412 \u041f\u041e\u041c\u0418\u041b\u041e\u041a - \u0427\u0418\u0421\u0422\u041e",speed:"\u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c",coolant:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0434\u0432\u0438\u0433\u0443\u043d\u0430",throttle:"\u0433\u0430\u0437",engineLoad:"\u041d\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0434\u0432\u0438\u0433\u0443\u043d\u0430",intakeAir:"\u0412\u0445\u0456\u0434\u043d\u0435 \u043f\u043e\u0432\u0456\u0442\u0440\u044f",manifold:"\u041a\u043e\u043b\u0435\u043a\u0442\u043e\u0440",voltage:"\u041d\u0430\u043f\u0440\u0443\u0433\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0457",shareMessage:"\u0421\u043b\u0456\u0434\u043a\u0443\u0439\u0442\u0435 \u0437\u0430 \u0441\u0442\u0430\u043d\u043e\u043c \u0441\u0432\u043e\u0433\u043e \u043c\u043e\u0442\u043e\u0446\u0438\u043a\u043b\u0430 \u0437\u0456 \u0441\u0432\u043e\u0454\u0457 \u043a\u0438\u0448\u0435\u043d\u0456 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u043e\u0457 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 Motocortex OBD2! \u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438: https://cortexobd2.app",subtitle:"\u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u0430 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0430 \u0442\u0430 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0430 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0430 \u0431/\u0443",vehicleInfo:"\u0406\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0442\u0430 \u043c\u0435\u0442\u0430\u0434\u0430\u043d\u0456 ECU",healthScore:"\u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0430 \u043e\u0446\u0456\u043d\u043a\u0430 ECU",dtcSection:"\u0414\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0456 \u043a\u043e\u0434\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 (\u0430\u0443\u0434\u0438\u0442 DTC)",telemetrySection:"\u0416\u0438\u0432\u0430 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u044f \u0442\u0430 \u0437\u043d\u0456\u043c\u043e\u043a \u0434\u0430\u0442\u0447\u0438\u043a\u0430",maintenanceSection:"\u0406\u0441\u0442\u043e\u0440\u0456\u044f \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e\u0433\u043e \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f Ak\u0131ll\u0131 Garaj",aiSection:"\u0410\u043d\u0430\u043b\u0456\u0437 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u043d\u0443 \u043b\u0456\u043a\u0430\u0440\u0435\u043c \u0437\u0456 \u0448\u0442\u0443\u0447\u043d\u0438\u043c \u0456\u043d\u0442\u0435\u043b\u0435\u043a\u0442\u043e\u043c",noFaults:"\u0423 \u043f\u0430\u043c'\u044f\u0442\u0456 ECU \u043d\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u0456 \u0430\u0431\u043e \u0456\u0441\u0442\u043e\u0440\u0438\u0447\u043d\u0456 \u043a\u043e\u0434\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439.",noMaintenance:"\u041d\u0435\u043c\u0430\u0454 \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u0441\u043b\u0443\u0436\u0431\u043e\u0432\u0438\u0445 \u0437\u0430\u043f\u0438\u0441\u0456\u0432 \u0443 Ak\u0131ll\u0131 Garaj.",disclaimer:"\u0412\u0456\u0434\u043c\u043e\u0432\u0430 \u0432\u0456\u0434 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0456: \u0446\u0435\u0439 \u0437\u0432\u0456\u0442 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043e \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0438\u043c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u0438\u043c \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f\u043c MotoCortex. \u041f\u0435\u0440\u0435\u0434 \u043f\u0440\u0438\u0434\u0431\u0430\u043d\u043d\u044f\u043c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u0444\u0456\u0437\u0438\u0447\u043d\u0438\u0439 \u043e\u0433\u043b\u044f\u0434 \u0443 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u0444\u0430\u0445\u0456\u0432\u0446\u044f.",shareTitle:"\u041f\u043e\u0434\u0456\u043b\u0456\u0442\u044c\u0441\u044f \u0437\u0432\u0456\u0442\u043e\u043c \u043f\u0440\u043e \u043e\u0446\u0456\u043d\u043a\u0443 MotoCortex"},battery:{title:"\u0422\u0415\u0421\u0422 \u0411\u0410\u0422\u0410\u0420\u0415\u0407 \u0422\u0410 \u0417\u0410\u041f\u0423\u0421\u041a",ready:"\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u043f\u043e\u0447\u0430\u0442\u0438 \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f.",restingStatus:"\u0417\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0435, \u0434\u0432\u0438\u0433\u0443\u043d \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0438\u0439... \u0417\u0447\u0438\u0442\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u043f\u0440\u0443\u0433\u0430 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430...",crankingStatus:"\u041f\u041e\u0427\u0410\u0422\u041e\u041a \u0417\u0410\u0420\u0410\u0417! (\u0412\u0438\u043c\u0456\u0440\u044e\u0432\u0430\u043d\u043d\u044f \u0431\u0443\u0434\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0438\u0441\u044f \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 5 \u0441\u0435\u043a\u0443\u043d\u0434)",chargingStatus:"\u0414\u0432\u0438\u0433\u0443\u043d \u043f\u0440\u0430\u0446\u044e\u0454 \u043d\u0430 \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u043c\u0443 \u0445\u043e\u0434\u0456... \u0417\u0447\u0438\u0442\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u043f\u0440\u0443\u0433\u0430 \u0437\u0430\u0440\u044f\u0434\u043a\u0438...",doneStatus:"\u0422\u0435\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e!",voltageError:"\u041d\u0430\u043f\u0440\u0443\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043d\u0430. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f.",start:"\u041f\u041e\u0427\u0410\u0422\u0418 \u0422\u0415\u0421\u0422",retry:"\u041f\u041e\u0412\u0422\u041e\u0420\u041d\u0418\u0419 \u0422\u0415\u0421\u0422",procedure:"\u041f\u0420\u041e\u0426\u0415\u0414\u0423\u0420\u0410 \u0412\u0418\u041f\u0420\u041e\u0411\u0423\u0412\u0410\u041d\u041d\u042f",steps:{1:"1. \u0417\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u0435, \u0434\u0432\u0438\u0433\u0443\u043d \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0438\u0439 \u2192 \u0412\u0438\u043c\u0456\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u043f\u0440\u0443\u0433\u0430 \u0441\u043f\u043e\u043a\u043e\u044e",2:"2. \u041a\u043e\u043b\u0438 \u0437\u2019\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \xab\u041f\u041e\u0427\u0410\u0422\u0418 \u0417\u0410\u0420\u0410\u0417\xbb, \u0437\u0430\u043f\u0443\u0441\u0442\u0456\u0442\u044c \u0434\u0432\u0438\u0433\u0443\u043d.",3:"3. \u041d\u0430\u0439\u043d\u0438\u0436\u0447\u0430 \u043d\u0430\u043f\u0440\u0443\u0433\u0430, \u0437\u0430\u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 5 \u0441\u0435\u043a\u0443\u043d\u0434",4:"4. \u041d\u0430\u043f\u0440\u0443\u0433\u0430 \u0437\u0430\u0440\u044f\u0434\u0443/\u0440\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u0430 \u0432\u0438\u043c\u0456\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u0440\u043e\u0431\u043e\u0442\u0438 \u0434\u0432\u0438\u0433\u0443\u043d\u0430"},warning:"\u041d\u0435 \u0432\u0438\u043c\u0438\u043a\u0430\u0439\u0442\u0435 \u0437\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f Bluetooth \u043f\u0456\u0434 \u0447\u0430\u0441 \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f.",resting:"\u0412\u0406\u0414\u041f\u041e\u0427\u0418\u041d\u041e\u041a",cranking:"\u0413\u0406\u041c\u041d",charging:"\u0417\u0410\u0420\u042f\u0414\u041a\u0410",instantV:"\u041c\u0418\u0422\u0422\u0404\u0412\u0410 \u041d\u0410\u041f\u0420\u0423\u0413\u0410",evaluation:"\u041e\u0426\u0406\u041d\u041a\u0410",verdicts:{full:"\u0410\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440: \u041f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u0430\u0440\u044f\u0434\u0436\u0435\u043d\u0438\u0439",good:"\u0410\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440: \u0445\u043e\u0440\u043e\u0448\u0438\u0439 \u0441\u0442\u0430\u043d",weak:"\u0410\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440: \u041e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u044f",empty:"\u0410\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440: \u0441\u043b\u0430\u0431\u043a\u0438\u0439/\u0440\u043e\u0437\u0440\u044f\u0434\u0436\u0435\u043d\u0438\u0439",crankNormal:"\u041f\u043e\u0447\u0430\u0442\u043e\u043a: \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0438\u0439 \u0441\u043f\u0430\u0434",crankLow:"\u0421\u0442\u0430\u0440\u0442\u0435\u0440: \u041d\u0438\u0437\u044c\u043a\u0430 \u043d\u0430\u043f\u0440\u0443\u0433\u0430",crankCritical:"\u0413\u0456\u043c\u043d: \u041a\u0440\u0438\u0442\u0438\u0447\u043d\u0435 \u043f\u0430\u0434\u0456\u043d\u043d\u044f",regNormal:"\u0417\u0430\u0440\u044f\u0434\u043a\u0430: \u0420\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0438\u0439",regLow:"\u0417\u0430\u0440\u044f\u0434\u043a\u0430: \u041d\u0438\u0437\u044c\u043a\u0438\u0439 \u0437\u0430\u0440\u044f\u0434",regHigh:"\u0417\u0430\u0440\u044f\u0434\u043a\u0430: \u0437\u0430\u0439\u0432\u0430",regFail:"\u0417\u0430\u0440\u044f\u0434\u043a\u0430: \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0438\u0439 \u0440\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440"},verdictLocked:"\u041e\u043d\u043e\u0432\u0456\u0442\u044c \u0434\u043e PRO, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0434\u043e\u043a\u043b\u0430\u0434\u043d\u0438\u0439 \u0437\u0432\u0456\u0442 \u043f\u0440\u043e \u043e\u0446\u0456\u043d\u043a\u0443 \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0442\u0430 \u0433\u0440\u0430\u0444\u0456\u043a \u0430\u043d\u0430\u043b\u0456\u0437\u0443 \u0437\u0430\u043f\u0443\u0441\u043a\u0443."},freeze:{title:"\u0421\u0422\u041e\u041f-\u041a\u0410\u0414\u0420",snapshot:"\u041f\u0410\u041c'\u042f\u0422\u042c \u041d\u0410 \u0417\u0411\u041e\u0420\u041a\u0418",desc:"\u0412\u0456\u043d \u0437\u0447\u0438\u0442\u0443\u0454 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 \u0434\u0432\u0438\u0433\u0443\u043d\u0430, \u043a\u043e\u043b\u0438 \u0437\u0430\u0433\u043e\u0440\u044f\u0454\u0442\u044c\u0441\u044f \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 Check Engine. \u0426\u0456 \u0434\u0430\u043d\u0456 \u043d\u0430\u0434\u0430\u044e\u0442\u044c \u0432\u0430\u0436\u043b\u0438\u0432\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u0434\u043b\u044f \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439.",noDtcs:"\u041a\u043e\u0434 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0456 \u043d\u0435 \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u0439. \u041c\u043e\u0436\u043b\u0438\u0432\u043e, \u043d\u0435\u043c\u0430\u0454 \u0434\u0430\u043d\u0438\u0445 \u0441\u0442\u043e\u043f-\u043a\u0430\u0434\u0440\u0443.",read:"\u0427\u0418\u0422\u0410\u0422\u0418 \u0417\u0410\u041c\u041e\u0420\u041e\u0416\u0415\u041d\u0406 \u0414\u0410\u041d\u0406",loading:"\u0420\u0435\u0436\u0438\u043c 02 \u0441\u0442\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0441\u0443\u043c\u043d\u0456\u0432...",noData:"\u0417\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e. \u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u043c\u043e\u0436\u0435 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u0446\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u044e.",error:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445",values:" \u0426\u0406\u041d\u041d\u041e\u0421\u0422\u0406, \u0417\u0411\u0415\u0420\u0415\u0416\u0415\u041d\u0406 \u041d\u0410 \u041c\u041e\u041c\u0415\u041d\u0422 \u0417\u0411\u041e\u042e",retry:"\u041f\u0420\u041e\u0427\u0418\u0422\u0410\u0419\u0422\u0415 \u0417\u041d\u041e\u0412\u0423",techInfo:"\u0422\u0415\u0425\u041d\u0406\u0427\u041d\u0410 \u0406\u041d\u0424\u041e\u0420\u041c\u0410\u0426\u0406\u042f",techDesc:"\u2022 \u0420\u0435\u0436\u0438\u043c OBD-II 02: \u0434\u0430\u043d\u0456 \u0441\u0442\u043e\u043f-\u043a\u0430\u0434\u0440\u0443 \u2022 PID 020C00: \u043f\u043e\u043c\u0438\u043b\u043a\u0430 \u043e\u0431\u0435\u0440\u0442\u0456\u0432 \u2022 PID 020D00: \u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u2022 PID 020500: \u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043e\u0445\u043e\u043b\u043e\u0434\u0436\u0443\u0432\u0430\u043b\u044c\u043d\u043e\u0457 \u0432\u043e\u0434\u0438 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0456 \u0426\u0456 \u0434\u0430\u043d\u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u0442\u044c \u0434\u043e \u043e\u0441\u0442\u0430\u043d\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u0434\u0443 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0456. \u041f\u0456\u0441\u043b\u044f \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f \u043a\u043e\u0434\u0456\u0432 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0434\u0430\u043d\u0456 \u0441\u0442\u043e\u043f-\u043a\u0430\u0434\u0440\u0443 \u0442\u0430\u043a\u043e\u0436 \u0432\u0438\u0434\u0430\u043b\u044f\u044e\u0442\u044c\u0441\u044f.",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"\u0422\u0415\u0421\u0422 \u041f\u0420\u041e\u0414\u0423\u041a\u0422\u0418\u0412\u041d\u041e\u0421\u0422\u0406",seconds:"\u0421\u0415\u041a\u0423\u041d\u0414",speed:"\u043a\u043c/\u0433\u043e\u0434",idle:"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \u0456 \u0433\u043e\u0442\u0443\u0439\u0442\u0435\u0441\u044f \u0434\u043e \u0434\u0456\u0439.",ready:"\u0413\u041e\u0422\u041e\u0412\u0418\u0419! \u041f\u043e\u0447\u043d\u0456\u0442\u044c \u043a\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u043c \u0437\u0430\u0441\u043e\u0431\u043e\u043c...",readyDesc:"\u041b\u0456\u0447\u0438\u043b\u044c\u043d\u0438\u043a \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c > 0.",measuring:"\u0412\u0418\u0414\u0406\u0422\u042c\u0421\u042f \u0417\u0410\u041c\u0406\u0420...",done:"\u0422\u0415\u0421\u0422\u0423\u0412\u0410\u041d\u041d\u042f \u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041d\u041e",start:"\u041f\u041e\u0427\u0410\u0422\u0418 \u0422\u0415\u0421\u0422",stop:"\u0421\u0422\u041e\u041f",reset:"\u0421\u041a\u0418\u0414\u0410\u041d\u041d\u042f",howItWorks:"\u042f\u041a \u0426\u0415 \u041f\u0420\u0410\u0426\u042e\u0404?",howDesc:"1. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \xab\u041f\u043e\u0447\u0430\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443\xbb. 2. \u0422\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u0439 \u0437\u0430\u0441\u0456\u0431 \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u0438\u043c (\u0428\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c = 0) 3. \u0425\u0440\u043e\u043d\u043e \u043f\u043e\u0447\u0438\u043d\u0430\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0432\u0438 \u043f\u043e\u0447\u0438\u043d\u0430\u0454\u0442\u0435 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044f 4. \u0417\u0430\u043f\u0438\u0441\u0430\u043d\u043e \u0447\u0430\u0441 \u043f\u0440\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f 60 \u043a\u043c/\u0433\u043e\u0434 \u0456 100 \u043a\u043c/\u0433\u043e\u0434 \u041f\u0440\u043e\u0439\u0434\u0456\u0442\u044c \u0446\u0435\u0439 \u0442\u0435\u0441\u0442 \u0443 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456!",sec:"\u0441\u0435\u043a"},dtc:{P0102:"\u0414\u0430\u0442\u0447\u0438\u043a \u043f\u043e\u0442\u043e\u043a\u0443 \u043f\u043e\u0432\u0456\u0442\u0440\u044f (MAF) - \u043d\u0438\u0437\u044c\u043a\u0438\u0439 \u0432\u0445\u0456\u0434\u043d\u0438\u0439 \u0441\u0438\u0433\u043d\u0430\u043b",P0113:"\u0414\u0430\u0442\u0447\u0438\u043a \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0438 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0456\u0442\u0440\u044f - \u0432\u0438\u0441\u043e\u043a\u0430 \u043d\u0430\u043f\u0440\u0443\u0433\u0430",P0171:"\u041d\u0438\u0437\u044c\u043a\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c \u043f\u0430\u043b\u0438\u0432\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 (\u0431\u0430\u043d\u043a 1)",P0300:"\u0412\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0430/\u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0446\u0438\u043b\u0456\u043d\u0434\u0440\u0456\u0432",P0420:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u0430\u0442\u0430\u043b\u0456\u0442\u0438\u0447\u043d\u0438\u0445 \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0456\u0437\u0430\u0442\u043e\u0440\u0456\u0432 (B1) - \u043d\u0438\u0437\u044c\u043a\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c",P0700:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u0440\u043e\u0431\u043a\u043e\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447 - \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c",P0715:"\u0414\u0430\u0442\u0447\u0438\u043a \u043e\u0431\u0435\u0440\u0442\u0456\u0432 \u0442\u0443\u0440\u0431\u0456\u043d\u0438 - \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430",P0560:"\u041d\u0430\u043f\u0440\u0443\u0433\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 - \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c",P0562:"\u041d\u0430\u043f\u0440\u0443\u0433\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 - \u043d\u0438\u0437\u044c\u043a\u0430",U0100:"\u0412\u0442\u0440\u0430\u0447\u0435\u043d\u043e \u0437\u0432\u2019\u044f\u0437\u043e\u043a \u0456\u0437 \u043c\u043e\u0434\u0443\u043b\u0435\u043c \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u0432\u0438\u0433\u0443\u043d\u043e\u043c (ECM/PCM)",U0121:"\u0412\u0442\u0440\u0430\u0447\u0435\u043d\u043e \u0437\u0432\u2019\u044f\u0437\u043e\u043a \u0456\u0437 \u043c\u043e\u0434\u0443\u043b\u0435\u043c \u0430\u043d\u0442\u0438\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043b\u044c\u043d\u043e\u0457 \u0433\u0430\u043b\u044c\u043c\u0456\u0432\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 (ABS).",C0035:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u043b\u0456\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430",B0001:"\u0421\u0445\u0435\u043c\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u043d\u043d\u044f\u043c \u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f 1 \u0434\u0440\u0430\u0439\u0432\u0435\u0440\u0430",P0750:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u0441\u043e\u043b\u0435\u043d\u043e\u0457\u0434\u0430 A \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447",P0814:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0434\u0456\u0430\u043f\u0430\u0437\u043e\u043d\u0443 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0456",U0140:"\u0412\u0442\u0440\u0430\u0447\u0435\u043d\u043e \u0437\u0432\u2019\u044f\u0437\u043e\u043a \u0456\u0437 \u043c\u043e\u0434\u0443\u043b\u0435\u043c \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0443\u0437\u043e\u0432\u043e\u043c (BCM)",C0040:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u043f\u0440\u0430\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430",C0110:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430 \u0434\u0432\u0438\u0433\u0443\u043d\u0430 \u043d\u0430\u0441\u043e\u0441\u0430 ABS",C0121:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0433\u0430\u043b\u044c\u043c\u0456\u0432\u043d\u043e\u0433\u043e \u0442\u0438\u0441\u043a\u0443",B0010:"\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0440\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f 1 \u0434\u043b\u044f \u043f\u0430\u0441\u0430\u0436\u0438\u0440\u0430",B0020:"\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0440\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u043d\u043d\u044f \u043b\u0456\u0432\u043e\u0457 \u0431\u0456\u0447\u043d\u043e\u0457 \u043f\u043e\u0434\u0443\u0448\u043a\u0438 \u0431\u0435\u0437\u043f\u0435\u043a\u0438",B1000:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u0430\u043f\u0430\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f \u043c\u043e\u0434\u0443\u043b\u044f \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0443\u0437\u043e\u0432\u043e\u043c (BCM).",B1325:"\u041d\u0438\u0437\u044c\u043a\u0430 \u043d\u0430\u043f