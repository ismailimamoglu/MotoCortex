u044c \u0437\u0430\u0440\u044f\u0434\u0430 (SOC):",remainingCharge:"\u041e\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044f \u0437\u0430\u0440\u044f\u0434",cellBalance:"\u0411\u0430\u043b\u0430\u043d\u0441 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u044f\u0447\u0435\u0439\u043a\u0438 (\u043f\u0430\u043a\u0435\u0442 16S)",optimalBalance:"\u041e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0431\u0430\u043b\u0430\u043d\u0441 (\u0434\u0435\u043b\u044c\u0442\u0430 <30 \u043c\u0412)",mildImbalance:"\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d \u043b\u0435\u0433\u043a\u0438\u0439 \u0434\u0438\u0441\u0431\u0430\u043b\u0430\u043d\u0441",thermalStatus:"\u0422\u0435\u043f\u043b\u043e\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0435",packTemp:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0438:",packVoltage:"\u041d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0438:",chargeCycles:"\u0426\u0438\u043a\u043b\u044b \u0437\u0430\u0440\u044f\u0434\u043a\u0438:",cycles:"\u0426\u0438\u043a\u043b\u044b"},serviceReset:{title:"\u0421\u0411\u0420\u041e\u0421 \u0421\u0415\u0420\u0412\u0418\u0421\u041d\u042b\u0425 \u0418\u041d\u0422\u0415\u0420\u0412\u0410\u041b\u041e\u0412 \u0418 \u0422\u041e",subtitle:"\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u043c\u0443\u044e \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f ({{make}})",preCheckTitle:"\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0442\u0440\u0435\u0431\u043e\u0432\u