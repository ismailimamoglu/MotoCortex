2\u0430\u043d\u043d\u044f",privacy:"\u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456",hardwareWarning:" \u0412\u0430\u0436\u043b\u0438\u0432\u0430 \u0430\u043f\u0430\u0440\u0430\u0442\u043d\u0430 \u043f\u0440\u0438\u043c\u0456\u0442\u043a\u0430: \u0447\u0435\u0440\u0435\u0437 \u044e\u0440\u0438\u0434\u0438\u0447\u043d\u0456 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f Apple \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457 iOS \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438 Bluetooth Classic (\u0432\u0435\u0440\u0441\u0456\u0457 2.1) \u0441\u0442\u0430\u0440\u0456\u0448\u043e\u0433\u043e \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f. \u041f\u0435\u0440\u0448 \u043d\u0456\u0436 \u043e\u043d\u043e\u0432\u0438\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443 \u0434\u043e \u0440\u0435\u0436\u0438\u043c\u0443 PRO, \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0432\u0430\u0448 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0441\u0443\u043c\u0456\u0441\u043d\u0438\u0439 \u0437 Bluetooth LE (4.0+) \u0430\u0431\u043e Wi-Fi.",hardwareWarningAndroid:" \u0412\u0430\u0436\u043b\u0438\u0432\u0430 \u0430\u043f\u0430\u0440\u0430\u0442\u043d\u0430 \u043f\u0440\u0438\u043c\u0456\u0442\u043a\u0430: \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457 Android \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0438 Bluetooth Classic \u0456 Bluetooth LE (4.0+). \u041f\u0435\u0440\u0448 \u043d\u0456\u0436 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0442\u0438\u0441\u044f \u0432 \u0440\u0435\u0436\u0438\u043c PRO, \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0432\u0430\u0448 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0441\u0443\u043c\u0456\u0441\u043d\u0438\u0439.",errorTitle:"\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438",errorDesc:"\u041f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0456\u0432 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043c\u0438\u043b\u043a\u0430. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0434\u043e \u0406\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0443 \u0442\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0441\u043f\u0440\u043e\u0431\u0443.",retryBtn:"\u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u043d\u043e\u0432\u0443",loadingPrices:"\u0426\u0456\u043d\u0438 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u044e\u0442\u044c\u0441\u044f...",contextualDesc:"\u041e\u043d\u043e\u0432\u0456\u0442\u044c \u0434\u043e Cortex OBD2 Diagnostic Scanner PRO, \u0449\u043e\u0431 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u043f\u043e\u0432\u043d\u0438\u0439 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0438\u0439 \u0430\u043d\u0430\u043b\u0456\u0437, \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u0456 \u0440\u0438\u0437\u0438\u043a\u0438 \u0434\u0432\u0438\u0433\u0443\u043d\u0430, \u043e\u0446\u0456\u043d\u043a\u0443 \u0432\u0430\u0440\u0442\u043e\u0441\u0442\u0456 \u0440\u0435\u043c\u043e\u043d\u0442\u0443 \u0442\u0430 \u043f\u043e\u043a\u0440\u043e\u043a\u043e\u0432\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457 \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043a\u043e\u0434\u0443 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0456.",crownBadge:"MOTO CORTEX PRO",actionLocked:"PRO \u0417\u0410\u0411\u041b\u041e\u041a\u