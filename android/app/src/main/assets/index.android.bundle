ith this protocol, you can select at most {{limit}} sensors.",proSensorMsg:"Upgrade to PRO to unlock and monitor advanced live sensors.",customizeSubtitleKLine:"K-Line protocol connected. You can select a maximum of {{limit}} sensors.",customizeSubtitleCAN:"CAN-Bus protocol connected. You can select a maximum of {{limit}} sensors.",unit:"Unit",selectDevice:"TAP TO SELECT DEVICE",connectedDevice:"CONNECTED DEVICE",noConnection:"No connection yet",batteryLow:"LOW BATTERY VOLTAGE!",batteryLowDesc:"Battery voltage is at {{voltage}}. Start vehicle or charge. ECU communication may be lost at low voltage.",batteryWarn:"BATTERY GETTING WEAK",batteryWarnDesc:"Battery voltage {{voltage}}. Be careful during long operations.",rpm:"Engine RPM",speed:"Vehicle Speed",temp:"TEMP",throttle:"Throttle Position",status:"RPM STATUS",statusHigh:"HIGH",statusNormal:"NORMAL",statusLow:"LOW",battery:"BATTERY",load:"LOAD",intake:"INTAKE AIR",manifold:"MANIFOLD kPa",customizeTitle:"DASHBOARD SETTINGS",customizeSubtitle:"Select the sensors you want to see on screen.",layoutType:"Layout Style",layoutGrid:"GRID",layoutList:"LIST",layoutGauge:"GAUGE",layoutChart:"CHART",customizeButton:"CUSTOMIZE DASHBOARD",coolant:"Engine Coolant Temp",voltage:"Battery Voltage",engineLoad:"Engine Load",intakeAirTemp:"Intake Air Temp",manifoldPressure:"Manifold Pressure",ambientTemp:"Ambient Temp",oilTemp:"Engine Oil Temp",mafFlow:"MAF Air Flow Rate",timingAdvance:"Timing Advance",fuelLevel:"Fuel Level",catalystTemp:"Catalyst Temp",obdTerminalTitle:"OBD HEALTH & TERMINAL",adapterClone:"CLONE ADAPTER",adapterOriginal:"ORIGINAL",adapterCloneShort:"CLONE",adapterOriginalShort:"ORIGINAL",pidLabel:"PID: {{pid}}",adblue:"AdBlue Level",egt:"Exhaust Gas Temp",nox:"NOx Sensor Value",torque:"Engine Torque",selectedSensorsCount:"{{count}} / {{max}} Sensors Selected"},expertise:{historyFound:"VEHICLE HISTORY FOUND!",historyFoundDesc:"This vehicle has {{count}} previous records. You can review the history below.",viewHistory:"VIEW HISTORY \u203a",manualVin:"VIN",manualVinDesc:"If the vehicle ECU does not share the VIN automatically, you can type it here.",vinPlaceholder:"Type VIN...",startScan:"START DIAGNOSTIC SCAN",scanning:"SCANNING...",vehicleIdentity:"VEHICLE IDENTITY & MILEAGE",vin:"VIN",odometer:"Original Mileage",distSinceCleared:"Dist Since Cleared",milDist:"Dist with MIL On",dtcTitle:"DIAGNOSTIC TROUBLE CODES",dtcClean:"NO TROUBLE CODES \u2014 CLEAN",extraActions:"EXTRA ACTIONS",garageTitle:"GARAGE & PAST RECORDS",share:"SHARE",saveVehicle:"SAVE THIS VEHICLE",noRecords:"No saved vehicles yet.",clean:"CLEAN",faults:"FAULTS",vinRequired:"VIN Required",vinRequiredDesc:"VIN must be detected automatically or entered manually to save a record.",missingInfo:"Missing Info",missingInfoDesc:"Please fill in the Make and Model fields.",saved:"Saved",savedDesc:"Diagnostic result added to garage.",connRequired:"Connection Required",connRequiredDesc:"Please connect to the vehicle first to start this operation.",chronicFaultsTitle:"Statistical Chronic Faults",chronicFaultsObs:"{{code}} (Observation: {{days}} Unique Days / Total: {{total}} Times)",chronicFaultsPending:"Collecting Data Pool / Analyzing Statistics",notScanned:"Not Scanned",notScannedDesc:"Please press the scan button on the top right to read diagnostic codes.",scanFailed:"SCAN FAILED",errTimeout:"Error: Connection Timeout\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error\nECU trouble codes could not be read.",scannedSystems:"SCANNED SYSTEMS",moduleEngine:"Engine Control Unit",moduleAbs:"Anti-lock Braking System",moduleTcm:"Transmission Control Module",moduleBcm:"Body Control Module",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:"SAFETY WARNING",safetyWarningDesc:"During this operation: \u2022 Ignition must be ON\n\u2022 Engine must be OFF\n\u2022 Do not start the vehicle Do you want to continue?",step1:"Step 1: Clear Trouble Codes",step1Desc:"All saved Trouble Codes and Check Engine light will be cleared. Fuel trim values will be reset. This action cannot be undone!",step2:"Step 2: ECU Hard Reset",step2Desc:"An electrical reset will be sent to the engine brain. Functions like battery disconnect/reconnect. Ineffective on unsupported ECUs. Will not cause harm.",clearCodes:"Clear Codes",ecuReset:"Clear DTCs",finish:"Skip",completed:"Completed",completedDesc:"Service operations completed successfully. You may restart the vehicle.",hardResetDesc:"All service operations completed successfully. \u2022 Trouble codes cleared\n\u2022 Fuel trims reset\n\u2022 ECU reset You may restart the vehicle."},info:{desc:"Professional motorcycle and vehicle diagnostic application.\nCompatible with all vehicles.",upgrade:"Upgrade to Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"Early Access",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner is currently in development. As an early user, all pro features are unlocked for you. Your feedback is very valuable!",helpGuide:"HELP & GUIDE",language:"Dil / Language / Bahasa",support:"SUPPORT CENTER",supportSubject:"Cortex OBD2 Diagnostic Scanner Support Ticket",shareWithFriend:"SHARE WITH A FRIEND",shareMessageText:"Discover vehicle ECU fault codes & live sensor telemetry with Cortex OBD2 Diagnostic Scanner! Download Now: iOS: https://apps.apple.com/app/id6764052240 Android: https://play.google.com/store/apps/details?id=com.ismail.motocortexv2 Web Portal: https://motocortex-telemetry.vercel.app/",thanks:"Thank You!",thanksDesc:"Thank you for your feedback. You can leave us a review on the Play Store.",sections:{featureCoding:{title:"HIDDEN FEATURE UNLOCK & UDS CODING",content:"Powered by our ISO 14229 UDS Protocol Engine, safely toggle features like US Parking Lights, Needle Sweep, Horn Ack Lock, Comfort Windows, and DRL settings for VAG, BMW, Renault, and Dacia vehicles."},multiEcu:{title:"MULTI-ECU ALL MODULE SCANNING",content:"Scan and clear fault codes beyond the Engine ECU \u2014 including ABS, Airbag, Automatic Transmission, Instrument Cluster, Climate Control, and Body Control Modules."},advancedDiagnostics:{title:"DCT ADAPTATION, DPF & HP POWER GAUGE",content:"\u2022 DCT / DSG Clutch Kiss Point Learning & Adaptation Reset\n\u2022 DPF Soot Load & Exhaust Regeneration Temp Monitoring\n\u2022 Real-time Short/Long Term Fuel Trims & Lambda Analysis\n\u2022 Dynamic Horsepower & Torque Live Telemetry Graph"},demoMode:{title:"DEMO MODE",content:"Test and explore the app without physical OBD2 hardware. Experience full CAN-Bus and UDS diagnostic features with realistic real-time telemetry simulation."},live:{title:"LIVE MONITORING SENSORS",content:"Monitor RPM, Speed, Engine Temperature, Throttle Position, Battery Voltage, Engine Load, Intake Air Temperature, and Manifold Pressure in real-time. Values refresh 1-5 times per second depending on Bluetooth speed. You can interact directly with the vehicle via UDS / OBD commands in the terminal."},expertise:{title:"DIAGNOSTICS & WARRANTY",content:"The app uses ECU codes to detect faults. VIN and recorded mileage are retrieved. Additionally, distance traveled with the Check Engine light is calculated to determine hitstorical faults. Reports can be shared via PDF or messaging platforms."},tests:{title:"BATTERY / PERFORMANCE TESTS",content:"Battery test consists of 3 stages: Resting, Cranking, and Idle Charge tests to measure battery/regulator health. Performance test measures 0-60 and 0-100 km/h acceleration values with 50ms margin of error using your phone's processor and vehicle's live speed data."},hardware:{title:"HARDWARE COMPATIBILITY",content:"ELM327 Bluetooth is recommended. Some advanced codes may not work with low-quality v2.1 CLONE hardware. Get highest speed with premium adapters like vLinker and OBDLink."},warnings:{title:"IMPORTANT WARNINGS",content:"\u2022 Ignition must be ON, Engine must be OFF during trouble code clearing or ECU Reset.\n\u2022 Do not send Reset to a running vehicle.\n\u2022 Not every vehicle may support all sensors, unsupported sensors show \"--\"."},onboarding:{title:"LEGAL PERMISSIONS & ANONYMOUS TELEMETRY",content:"To improve application quality and vehicle compatibility, completely anonymized engine parameters and diagnostic trouble codes captured during diagnostics may be analyzed on our secure servers. By proceeding, you agree to these anonymous telemetry terms. Bluetooth and Location permissions are required to establish a connection with your motorcycle's ECU."}},reconfigurePermissions:"Re-run Onboarding & Legal Terms"},report:{title:"MotoCortex \u2014 ECU & Vehicle Appraisal Report",subtitle:"Comprehensive Second-Hand Diagnostic & Telemetry Inspection",vehicleInfo:"Vehicle Identification & ECU Metadata",healthScore:"Overall ECU Health Score",dtcSection:"Diagnostic Trouble Codes",telemetrySection:"Live Telemetry & Sensor Snapshot",maintenanceSection:"Smart Garage Service & Maintenance History",aiSection:"AI Doctor Overall Condition Analysis",noFaults:"No active or historical fault codes stored in ECU memory.",noMaintenance:"No recorded service entries in Smart Garage.",disclaimer:"Disclaimer: This report is generated by MotoCortex diagnostic software. Physical inspection by a certified technician is recommended prior to vehicle acquisition.",shareTitle:"Share MotoCortex Appraisal Report",vehicleIdentity:"Vehicle Identity",vin:"VIN",odometer:"Odometer",milDist:"Distance Traveled with MIL ON",distSinceCleared:"Distance Since Codes Cleared",dtcCount:"FAULT CODES ({{count}})",sensorData:"Live Sensor Data",noData:"No Data Available",proApp:"Cortex OBD2 Diagnostic Scanner",date:"Report Date",vinNotFound:"VIN Not Found / Unable to Read",noDtcs:"No Diagnostic Fault Codes Found",speed:"Vehicle Speed",coolant:"Engine Coolant Temp",throttle:"Throttle Position",engineLoad:"Calculated Engine Load",intakeAir:"Intake Air Temp",manifold:"Intake Manifold Absolute Pressure",voltage:"Control Module Voltage",shareMessage:"Cortex OBD2 Diagnostic Report"},battery:{title:"BATTERY & CRANKING TEST",ready:"Ready to start the test.",restingStatus:"Ignition on, engine off... Reading battery voltage...",crankingStatus:"START THE ENGINE NOW!",chargingStatus:"Engine idling... Reading charging voltage...",doneStatus:"Test completed!",voltageError:"Voltage could not be read. Check the connection.",start:"START TEST",retry:"RETRY TEST",procedure:"TEST PROCEDURE",steps:{1:"1. Ignition on, engine off \u2192 Resting voltage measured",2:"2. Start the engine when \"START THE ENGINE NOW\" appears",3:"3. Lowest voltage during startup is recorded",4:"4. Charging/regulator voltage measured with engine running"},warning:"Do not disconnect Bluetooth during the test.",resting:"RESTING",cranking:"CRANKING",charging:"CHARGING",instantV:"CURRENT VOLTAGE",evaluation:"EVALUATION",verdicts:{full:"Battery: Fully charged",good:"Battery: Good condition",weak:"Battery: Weakening",empty:"Battery: Weak / Discharged",crankNormal:"Cranking: Normal drop",crankLow:"Cranking: Low voltage",crankCritical:"Cranking: Critical drop",regNormal:"Charging: Regulator normal",regLow:"Charging: Low charge",regHigh:"Charging: Overcharging",regFail:"Charging: Regulator faulty"},verdictLocked:"Upgrade to PRO to view detailed battery assessment report and cranking analysis graph."},freeze:{title:"FREEZE FRAME",snapshot:"FAULT SNAPSHOT",desc:"Reads engine parameters at the moment the Check Engine light turned on. This data provides critical info for diagnosis.",noDtcs:"No fault codes stored. Freeze Frame data may not be available.",read:"READ FREEZE FRAME",loading:"Querying Mode 02...",noData:"No freeze frame data found. Vehicle may not support this feature.",error:"Data read error",values:"VALUES RECORDED AT FAULT TIME",retry:"READ AGAIN",techInfo:"TECHNICAL INFO",techDesc:"\u2022 OBD-II Mode 02: Freeze Frame Data\n\u2022 PID 020C00: RPM at fault\n\u2022 PID 020D00: Speed at fault\n\u2022 PID 020500: Coolant temp at fault This data belongs to the last fault code. Clearing codes will also clear freeze frame data.",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"PERFORMANCE TEST",seconds:"SECONDS",speed:"KM/H",idle:"Press the button and prepare to move.",ready:"READY! Start driving...",readyDesc:"Timer starts when speed > 0.",measuring:"MEASURING...",done:"TEST COMPLETED",start:"START TEST",stop:"STOP",reset:"RESET",howItWorks:"HOW IT WORKS?",howDesc:"1. Press \"Start Test\" button\n2. Vehicle must be stationary\n3. Timer starts automatically when you move\n4. 0-60 km/h and 0-100 km/h times are recorded Perform this test in a safe area!",sec:"sec"},dtc:{P0113:"Intake Air Temperature Sensor 1 Circuit High Input",P0102:"Mass or Volume Air Flow Circuit Low Input",P0300:"Random / Multiple Cylinder Misfire Detected",P0171:"System Too Lean",P0420:"Catalyst System Efficiency Below Threshold",P0560:"System Voltage Malfunction",P0562:"System Voltage Low",P0700:"Transmission Control System Malfunction",P0715:"Input/Turbine Speed Sensor A Circuit Malfunction",P0750:"Shift Solenoid A Malfunction",P0814:"Transmission Range Display Circuit Malfunction",U0100:"Lost Communication With Engine Control Module",U0121:"Lost Communication With Anti-Lock Brake System Module",U0140:"Lost Communication With Body Control Module",C0035:"Left Front Wheel Speed Sensor Circuit Malfunction",C0040:"Right Front Wheel Speed Sensor Circuit Malfunction",C0110:"ABS Pump Motor Circuit Malfunction",C0121:"Brake Pressure Sensor Circuit Malfunction",B0001:"Driver Front Stage 1 Deployment Control Circuit",B0010:"Passenger Front Stage 1 Deployment Control",B0020:"Left Side Airbag Deployment Control",B1000:"Body Control Module Hardware Fault",B1325:"Device Power Supply Circuit Low Voltage",generalFault:"General Fault"},vehicleSelect:{connectionSection:"OBD Device Connection",title:"SELECT YOUR VEHICLE FOR DIAGNOSTIC ACCURACY",subtitle:"Please provide vehicle details for correct fault identification and protocol matching.",brand:"BRAND",selectBrand:"Select Brand...",searchBrand:"Search Brand...",searchLanguage:"Search Language...",customBrandPlaceholder:"e.g. Triumph, CFMoto, Kia...",model:"MODEL",selectModel:"Select Model...",searchModel:"Search Model...",customModelPlaceholder:"e.g. CBR600, Golf, Focus...",year:"MODEL YEAR",selectYear:"Select Year...",customYearPlaceholder:"e.g. 2018",disconnect:"DISCONNECT",confirm:"CONTINUE",errorBrand:"Please select or type a brand.",errorModel:"Please select or type a model.",errorYear:"Please select or type a valid year.",noResults:"No results found",selectVehiclePrompt:"PLEASE SELECT VEHICLE FIRST",selectedVehicle:"SELECTED VEHICLE",changeVehicle:"CHANGE",newVehicle:"Add New Vehicle",noVehicleTitle:"VEHICLE DETECTION REQUIRED",noVehicleDesc:"Vehicle identity will be automatically discovered via OBD-II connection. Please pair and connect to your device below.",titleMenu:"Vehicle & Connection",registeredVehiclesLabel:"REGISTERED VEHICLES",viewRegisteredList:"View Registered Vehicles",registeredVehicles:"MY REGISTERED VEHICLES",registeredVehiclesButton:"MY REGISTERED VEHICLES",connectDevice:"CONNECT TO OBD2 DEVICE",deleteConfirm:"Are you sure you want to delete this vehicle from registered vehicles?",noRegisteredVehicles:"No registered vehicles found.",selectVehicle:"SELECT",mismatchTitle:"Vehicle Mismatch",mismatchDesc:"The connected vehicle's manufacturer is detected as \"{{make}}\" from the VIN. However, your selected vehicle is \"{{selected}}\". Would you like to cancel the current selection and redefine it with the correct brand?",operations:{clearDtc:"Trouble Codes Cleared",fuelAdaptation:"Fuel Adaptation Reset",ecuReset:"ECU Reset"}},brands:{other:"Other",alfa_romeo:"Alfa Romeo",aprilia:"Aprilia",aston_martin:"Aston Martin",audi:"Audi",bajaj:"Bajaj",benelli:"Benelli",bmw_car:"BMW",bmw_moto:"BMW",cfmoto:"CFMoto",chery:"Chery / MG",chevrolet:"Chevrolet",citroen:"Citro\xebn",cupra:"Cupra",dacia:"Dacia",ducati:"Ducati",fiat:"Fiat",ford:"Ford",harley:"Harley-Davidson",hero:"Hero",honda_car:"Honda",honda_moto:"Honda",husqvarna:"Husqvarna",hyundai:"Hyundai / Kia",indian:"Indian",jeep:"Jeep",kawasaki:"Kawasaki",kia:"Kia",ktm:"KTM",kuba:"Kuba",kymco:"Kymco",land_rover:"Land Rover",lexus:"Lexus",mazda:"Mazda",mercedes:"Mercedes-Benz",mg:"MG",mitsubishi:"Mitsubishi",mondial:"Mondial",mv_agusta:"MV Agusta",nissan:"Nissan",opel:"Opel",peugeot:"Peugeot",peugeot_car:"Peugeot",peugeot_moto:"Peugeot",porsche:"Porsche",renault:"Renault / Dacia",rks:"RKS",seat:"Seat",skoda:"Skoda",subaru:"Subaru",suzuki_car:"Suzuki",suzuki_moto:"Suzuki",sym:"Sym",tesla:"Tesla",togg:"Togg",volkswagen:"Volkswagen / VAG",bmw:"BMW / MINI",gm:"GM / Chevrolet / GMC",dodge:"Dodge / RAM / Jeep",byd:"BYD EV",toyota:"Toyota / Lexus / Honda",stellantis:"Stellantis / Fiat",volvo:"Volvo / Polestar",yuki:"Yuki",tvs:"TVS",vespa:"Vespa",triumph:"Triumph"},permissions:{headerSubtitle:"PERMISSION GATEWAY",cardTitle:"Hardware Access Required",cardDesc:"To improve application quality and vehicle compatibility, completely anonymized engine parameters and diagnostic trouble codes captured during diagnostics may be analyzed on our secure servers. By proceeding, you agree to these anonymous telemetry terms.",btLabel:"Bluetooth",btSub:"Used exclusively to pair and stream live CAN-bus/K-Line metrics from your ELM327/OBD2 adapter.",locLabel:"Fine Location",locSub:"Required by Android system architecture to discover low-energy Bluetooth beacons nearby. We do not track your drives.",grantBtn:"GRANT & CONTINUE",skipBtn:"Skip for now",deniedDesc:"Some permissions were denied. Cortex OBD2 Diagnostic Scanner may not be able to scan or connect to OBD2 devices successfully.",proceedAnyway:"Proceed Anyway",openSettings:"Open Settings",langTitle:"Select Language",nextBtn:"CONTINUE",langDesc:"Please select your preferred language to customize your diagnostics experience.",langSelectSub:"LANGUAGE GATEWAY",telemetryLabel:"Diagnostic Telemetry",telemetrySub:"Share anonymous protocol and error logs to improve vehicle compatibility.",restartOnboarding:"Restart Initial Setup"},obdTerminal:{title:"OBD HEALTH & TERMINAL",terminalTitle:"OBD TERMINAL",terminalPlaceholder:"Type command below to send to ECU",inputPlaceholder:"Enter command...",sendButton:"SEND",statsTitle:"OBD HEALTH STATISTICS",connectionProtocol:"Connection Protocol:",none:"None",hardwareQualityScore:"Hardware Quality Score:",original:"Original",clone:"Clone",requestResponseCount:"Request / Response Count:",timeoutCount:"Timeout Count:",recoveryCount:"Recovery Count:",diagnosticLogTitle:"DIAGNOSTIC LOG",clearButton:"CLEAR",shareButton:"SHARE",noLogs:"No diagnostic logs found.",noShareSupport:"Sharing features are not available on this device."},disconnectShort:"DISC",dtcContext:{powertrain:"This fault may affect fuel economy and engine performance. Unlock full diagnosis",cooling:"Critical cooling hazard detected. View detailed repair steps",ignition:"Ignition system issue detected. View detailed repair steps",chassis:"Chassis safety system alert. Unlock PRO for full analysis",body:"Body electronics fault found. Upgrade for complete diagnostics",network:"Communication network error. PRO unlocks full troubleshooting",fallback:"Unlock detailed fault analysis, repair costs & risk assessment"},perfTeaser:{limitTitle:"Daily Limit Reached",limitDesc:"You have reached the daily limit of 3 free 0-60 km/h tests. Upgrade to PRO for unlimited tests and 0-100 km/h measurements."},sandbox:{title:"Sandbox Telemetry Control",connectionStatus:"Connection Status:",ecuStatus:"ECU Status:",fps:"UI Performance: {{fps}} FPS",stressBtnStart:"Start 20Hz Stress",stressBtnStop:"Stop Telemetry Loop",stopDisconnect:"Stop / Disconnect",discoveredDevices:"DISCOVERED DEVICES",connect:"CONNECT",scanning:"Scanning...",scan:"Scan Devices",rpm:"Engine RPM",speed:"Vehicle Speed",coolant:"Coolant Temp",throttle:"Throttle Position",notConnected:"Not Connected",connected:"Connected",connecting:"Connecting...",error:"Error",openSandbox:"DIAG",advancedTerminal:"Advanced Connection Terminal",terminalTitle:"Live Terminal & Bus Monitor",pause:"PAUSE",resume:"RESUME",share:"SHARE",clear:"CLEAR",clearDtcs:"CLEAR DTC",dtcTitle:"DTC DIAGNOSTICS & FAULT CODES",noDtcs:"NO DTC CODES FOUND IN ECU",readDtcs:"READ DTC",sendDtcs:"SEND"},hiddenFeatures:{title:"Hidden Features",btnLabel:"Unlock Hidden Features",unsupported:"This OBD2 adapter does not support unlocking hidden features.",unsupportedDesc:"Original ELM327 v2.1 or higher is required. Clone adapters are not supported.",notConnected:"Please connect to a vehicle first.",notConnectedDesc:"OBD2 device must be connected.",warning:"These changes may affect your vehicle's warranty.",confirmTitle:"Confirmation Required",confirmMsg:"Changing this feature affects ECU controller settings. Do you want to proceed?",confirmOk:"Continue",confirmCancel:"Cancel",categoryLighting:"Lighting",categorySound:"Sound & Alerts",categoryDisplay:"Instrument Cluster",categoryDriving:"Driving",featureDrl:"Daytime Running Lights",featureRearFog:"Rear Fog Light Override",featureDoorChime:"Disable Door Chime",featureParkingAlert:"Handbrake Acoustic Alert",featureRpmWarning:"RPM Limit Warning",featureFuelSensitivity:"Fuel Gauge Sensitivity",featureStartStop:"Start-Stop Disabled by Default",featureSportMemory:"Sport Mode Memory",enabled:"Enabled",disabled:"Disabled",writeSuccess:"Feature updated successfully.",writeError:"Write error. Please try again.",simulationBanner:"Simulation Mode \u2014 Actual writing to ECU is not active yet",closeBtn:"Close",disclaimerTitle:"LIABILITY DISCLAIMER",disclaimerFeature:"Feature",disclaimerBody:"Changing this feature directly affects your vehicle's factory settings and ECU software. Please read the following risks carefully: \u2022 Incorrect application may void your vehicle warranty.\n\u2022 Some changes may cause permanent faults or unexpected electrical errors.\n\u2022 While the operation may be reversible, some ECU modules may require a factory reset.\n\u2022 The user is solely responsible for any material or immaterial damage resulting from the use of this feature.\n\u2022 Cortex OBD2 Diagnostic Scanner cannot be held responsible for any malfunction or damage caused by these changes. You must confirm that you have read and understood this warning.",checkboxTitle:"CONFIRMATION REQUIRED",check1:"I have read this warning and understand that my vehicle warranty may be affected.",check2:"I acknowledge that Cortex OBD2 Diagnostic Scanner is not responsible for any faults or damages resulting from this operation.",check3:"I wish to make this change knowingly and of my own free will, accepting all risks.",disclaimerCancel:"CANCEL",disclaimerContinue:"CONTINUE",unsupportedTitle:"Not Supported",unsupportedMsg:"The connected OBD2 device does not yet support this feature. A compatible ELM327 v2.1+ adapter is required for hidden feature writing. Clone or standard adapters cannot process these commands.",unsupportedOk:"OK"},secretDebug:{title:"MOTO CORTEX DEV PANEL",logFileSize:"Black Box / File Size:",dtcCloudSync:"DTC CLOUD SYNCHRONIZATION",lastSync:"Last Sync",syncNow:"Sync Now",developerTools:"DEVELOPER TOOLS",trialResetSuccess:"Free Trial counter reset successfully!",crashTestTitle:"Crash Test",crashTestDesc:"The application will now crash intentionally. Confirm to verify Crashlytics integration.",crashButton:"Crash",crashTest:"Crash Test"},features:{headerCategory:"Hidden Features & Coding",title:"UNLOCK HIDDEN FEATURES & UDS CODING",subTitle:"ISO 14229 UDS Long Coding & Adaptation Engine",batteryVoltage:"BATTERY VOLTAGE",voltageReady:"Safe",voltageLocked:"Low Voltage",locked:"LOCKED",ready:"READY",vehicleMatched:"{{make}} \u2014 MATCHED",demoModeVehicle:"DEMO MODE: {{make}}",waitingVehicle:"WAITING FOR CONNECTED VEHICLE",activeFeaturesCount:"{{count}} vehicle-specific OEM features active",demoFeaturesCount:"{{count}} demo features listed",connectForFeaturesNote:"Connect to an OBD2 device to list vehicle-specific features",allMarks:"ALL MARKS",writeBtn:"WRITE",catLighting:"LIGHTING",catSound:"SOUND & ALERTS",catDisplay:"INSTRUMENTS",catComfort:"COMFORT",catSafety:"SAFETY",catMotorcycle:"MOTORCYCLE ECU",catRetrofit:"RETROFIT & HARDWARE",catEv:"EV & BATTERY",catAdas:"ADAS CALIBRATION",catEasterEgg:"EASTER EGGS",catService:"SERVICE & MAINTENANCE",catPerformance:"PERFORMANCE",segmentAll:"ALL MAKES",segmentEuroPremium:"European Premium",segmentEuroVolume:"European Volume",segmentAsian:"Asian",segmentAmerican:"American",segmentChineseEv:"Chinese EV",segmentMotorcycle:"Motorcycle",expertModeTitle:"Expert Mode",expertSafetyNote:"For advanced users only. In case of incorrect coding, use 'Restore Factory Settings' below to revert to original state.",expertDidPlaceholder:"DID Hex",expertValPlaceholder:"Value Hex",writeRawPayload:"WRITE RAW UDS PAYLOAD",restoreFactoryBtn:"RESTORE FACTORY SETTINGS",restoreFactoryTitle:"RESTORE FACTORY SETTINGS",enterDidFirst:"Please enter the DID Hex code to restore.",restoreConfirmMsg:"Revert to original factory state for DID 0x{{didHex}}?",restoreAction:"RESTORE FACTORY",enterValidHex:"Please enter valid DID and Value Hex strings.",detailTitle:"Feature Details & One-Click Coding",prePostValues:"Pre / Post Payload Preview",selectOption:"Select Coding Option:",oneClickActivate:"ONE-CLICK ACTIVATE",cloneLockedBanner:"Clone Adapter Detected \u2014 Coding Locked",cloneAlertTitle:"Clone OBD2 Adapter Detected",cloneAlertMsg:"Your connected OBD2 adapter was flagged as a counterfeit clone adapter lacking strict timing accuracy required for ECU writing. You can browse and search all features, but coding write operations are locked to protect your vehicle. Please connect a genuine ELM327 v2.1+ or vLinker adapter for writing.",riskLow:"LOW RISK",riskMedium:"MEDIUM RISK",riskHigh:"HIGH RISK",sfdProtected:"SFD Protected ECU",legalDisclaimerUsLights:"Note: Continuous US parking lights may not be street legal in some European jurisdictions.",legalDisclaimerVim:"Note: Video playback while driving is intended for passenger use only.",safetyAlertTitle:"Low Battery Voltage Alert",allMakes:"ALL MAKES",techEcuSpecs:"TECHNICAL ECU SPECIFICATIONS & PAYLOAD PREVIEW",targetEcuHeaderLabel:"Target ECU Header:",udsDidLabel:"UDS Data Identifier:",bitPositionLabel:"Bit Position:",targetPayloadLabel:"Target UDS Payload:",byteBitValue:"Byte {{byte}}, Bit {{bit}}",items:{vag_oil_service_reset:{name:"Oil Service Interval Reset",desc:"Resets oil change service counter and inspection interval for VAG vehicles."},bmw_oil_service_reset:{name:"CBS Engine Oil Reset",desc:"Resets Condition Based Service oil life percentage back to 100%."},generic_oil_service_reset:{name:"Universal Oil Maintenance Indicator Reset",desc:"Clears dashboard oil maintenance warning light across supported OBD2/UDS ECUs."},vag_epb_pad_change:{name:"EPB Brake Pad Replacement Mode",desc:"Retracts electronic parking brake calipers for rear brake pad servicing."},bmw_epb_pad_change:{name:"EPB Brake Service Mode",desc:"Opens parking brake actuator to service position for rear pad replacement."},mb_epb_pad_change:{name:"EPB Pad Fitting Mode",desc:"Releases parking brake spindle to workshop position for brake service."},vag_dpf_regen:{name:"DPF Service Regeneration Trigger",desc:"Initiates stationary Diesel Particulate Filter soot burn-off cycle."},bmw_dpf_regen:{name:"DPF Forced Regeneration Trigger",desc:"Requests DDE ECU to start active particulate filter regeneration routine."},psa_dpf_regen:{name:"DPF Regeneration Request",desc:"Triggers stationary DPF regeneration for HDi diesel engine ECUs."},bmw_bms_battery_register:{name:"BMS Battery Replacement Registration",desc:"Registers new battery replacement with DME/DDE Intelligent Battery Sensor."},mb_bms_battery_register:{name:"Battery Registration & Reset",desc:"Resets battery aging counter in SAM module after new battery installation."},vag_sas_calibrate:{name:"Steering Angle Sensor Calibration",desc:"Calibrates G85 steering angle sensor zero-point position for ABS/ESP ECU."},toyota_sas_calibrate:{name:"Steering Angle Zero Point Calibration",desc:"Performs zero point calibration of steering angle sensor in Skid Control ECU."},generic_tba_adapt:{name:"Throttle Body Alignment & Adaptation",desc:"Executes electronic throttle body stop learning routine in engine ECU."},epb_service_reset:{name:"Universal EPB Maintenance Reset",desc:"Resets electronic park brake caliper wear counter and calibrates air gap."},vag_dsg_reset:{name:"DSG Transmission Basic Settings Reset",desc:"Resets clutch engagement points and shift valve adaptations for DSG/S-Tronic."},bmw_zf_reset:{name:"ZF 8HP Transmission Adaptation Reset",desc:"Clears EGS transmission shift time and pressure adaptation values."},bmw_brake_fluid_reset:{name:"Brake Fluid Service Interval Reset",desc:"Resets Condition Based Service 2-year brake fluid change timer."},ford_injector_code:{name:"Injector Correction Factor Coding",desc:"Programs 16-character IQA codes for diesel injectors into PCM."},bmw_injector_code:{name:"Fuel Injector Flow Rate Coding",desc:"Writes energy calibration values for replaced fuel injectors into DME."},generic_headlight_aim:{name:"Headlight Auto-Leveling Calibration",desc:"Sets reference zero position for adaptive auto-leveling headlight motors."},bmw_12v_battery_reg:{name:"12V Auxiliary Battery Registration",desc:"Registers auxiliary AGM starter/support battery replacement in PCU."},vag_comfort_turn_signal:{name:"Comfort Turn Signal Blink Count",desc:"Adjusts lane change blinker cycle count between 3, 4, and 5 flashes."},vag_coming_home_duration:{name:"Coming/Leaving Home Light Duration",desc:"Configures headlight illumination timer after vehicle locking."},vag_remote_windows:{name:"Remote Convenience