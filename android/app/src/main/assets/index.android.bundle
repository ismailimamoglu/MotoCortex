041a\u041e\u0414\u042b DTC \u0412 \u042d\u0411\u0423 \u041d\u0415 \u041d\u0410\u0419\u0414\u0415\u041d\u042b",readDtcs:"\u0421\u0427\u0418\u0422\u0410\u0422\u042c DTC",sendDtcs:"\u041e\u0422\u041f\u0420\u0410\u0412\u0418\u0422\u042c"},health:{titleMenu:"\u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0410 OBD2",adapterQuality:"\u041a\u0410\u0427\u0415\u0421\u0422\u0412\u041e \u0418 \u041f\u0420\u041e\u0418\u0417\u0412\u041e\u0414\u0418\u0422\u0415\u041b\u042c\u041d\u041e\u0421\u0422\u042c \u0410\u0414\u0410\u041f\u0422\u0415\u0420\u0410",excellent:"\u041e\u0422\u041b\u0418\u0427\u041d\u042b\u0419 (\u041e\u0420\u0418\u0413\u0418\u041d\u0410\u041b\u042c\u041d\u042b\u0419)",good:"\u0425\u041e\u0420\u041e\u0428\u0418\u0419 (\u0421\u0422\u0410\u041d\u0414\u0410\u0420\u0422\u041d\u042b\u0419)",clone:"\u041d\u0415\u0421\u041e\u0412\u041c\u0415\u0421\u0422\u0418\u041c\u042b\u0419 / \u041a\u041b\u041e\u041d",firmware:"\u0412\u0435\u0440\u0441\u0438\u044f \u043f\u0440\u043e\u0448\u0438\u0432\u043a\u0438:",capScore:"\u041e\u0446\u0435\u043d\u043a\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439",latency:"\u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430 (RTT)",protocol:"\u0410\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b",featureSupport:"\u041c\u0410\u0422\u0420\u0418\u0426\u0410 \u0424\u0423\u041d\u041a\u0426\u0418\u0419 \u041f\u0420\u0418\u041b\u041e\u0416\u0415\u041d\u0418\u042f",matrixReadCodes:"\u0427\u0442\u0435\u043d\u0438\u0435 \u0438 \u0441\u0431\u0440\u043e\u0441 \u043a\u043e\u0434\u043e\u0432 \u043e\u0448\u0438\u0431\u043e\u043a",matrixLiveSensors:"\u041c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u0432 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 (\u0411\u0430\u0437\u043e\u0432\u044b\u0439)",matrixBattery:"\u0422\u0435\u0441\u0442 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 / \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f",matrixHighSpeed:"\u0412\u044b\u0441\u043e\u043a\u043e\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u0430\u044f \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044f (20\u0413\u0446)",matrixCoding:"\u041a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u042d\u0411\u0423",active:"\u0410\u043a\u0442\u0438\u0432\u0435\u043d",degraded:"\u0414\u0435\u0433\u0440\u0430\u0434\u0438\u0440\u043e\u0432\u0430\u043d (\u041c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u0439 RTT)",locked:"\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d (\u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c)",warning:"\u0411\u041b\u041e\u041a\u0418\u0420\u041e\u0412\u041a\u0410 \u0411\u0415\u0417\u041e\u041f\u0410\u0421\u041d\u041e\u0421\u0422\u0418:",lockExplain:"\u0412\u0430\u0448 \u0430\u0434\u0430\u043f\u0442\u0435\u0440 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d \u043a\u0430\u043a \u043a\u043b\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439/\u043f\u043e\u0434\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0447\u0438\u043f. \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043a\u043b\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u044b \u043b\u0438\u0448\u0435\u043d\u044b \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u043c\u043e\u0433\u0443\u0442 \u043f\u043e\u0432\u0440\u0435\u0434\u0438\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043f\u0440\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u0445 \u0437\u0430\u043f\u0438\u0441\u0438, \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u044b. \u041f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0438\u0442\u0435 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e ELM327 v2.1 \u0438\u043b\u0438 vLinker \u0434\u043b\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0433\u043e \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f.",vehiclePids:"\u0421\u041f\u0418\u0421\u041e\u041a \u041f\u0420\u041e\u0412\u0415\u0420\u041a\u0418 \u0414\u0410\u0422\u0427\u0418\u041a\u041e\u0412 \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0418\u041b\u042f",checklistPrompt:"\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u0432 (PID), \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0435 \u042d\u0411\u0423 \u0432\u0430\u0448\u0435\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f, \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u044b \u043d\u0438\u0436\u0435. \u0414\u0430\u0442\u0447\u0438\u043a\u0438 \u0431\u0435\u0437 \u0433\u0430\u043b\u043e\u0447\u043a\u0438 \u043d\u0435 \u0441\u043e\u043e\u0431\u0449\u0430\u044e\u0442\u0441\u044f \u0432\u0430\u0448\u0438\u043c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0435\u043c.",supportedBadge:" \u041f\u041e\u0414\u0414\u0415\u0420\u0416\u0418\u0412\u0410\u0415\u0422\u0421\u042f",unsupportedBadge:" \u041d\u0415 \u041f\u041e\u0414\u0414\u0415\u0420\u0416\u0418\u0412\u0410\u0415\u0422\u0421\u042f"},sensor:{oilTemp:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043c\u043e\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043c\u0430\u0441\u043b\u0430",boost:"\u0414\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0442\u0443\u0440\u0431\u043e\u043d\u0430\u0434\u0434\u0443\u0432\u0430",widebandAfr:"\u0428\u0438\u0440\u043e\u043a\u043e\u043f\u043e\u043b\u043e\u0441\u043d\u043e\u0435 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 O2/AFR",transTemp:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438",catalystTemp:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043a\u0430\u0442\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u0430",ethanol:"\u042d\u0442\u0430\u043d\u043e\u043b \u0422\u043e\u043f\u043b\u0438\u0432\u043d\u044b\u0439 %",timingAdvance:"\u041e\u043f\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f",baro:"\u0411\u0430\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435",rpm:"\u041e\u0431\u043e\u0440\u043e\u0442\u044b \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f (RPM)",speed:"\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f",coolant:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043e\u0445\u043b\u0430\u0436\u0434\u0430\u044e\u0449\u0435\u0439 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438",throttle:"\u041f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438",voltage:"\u041d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0434\u0443\u043b\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f",maf:"\u0420\u0430\u0441\u0445\u043e\u0434 \u0432\u043e\u0437\u0434\u0443\u0445\u0430 MAF",iat:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u043d\u0430 \u0432\u043f\u0443\u0441\u043a\u0435",load:"\u0420\u0430\u0441\u0447\u0451\u0442\u043d\u0430\u044f \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f",fuel:"\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0442\u043e\u043f\u043b\u0438\u0432\u0430"},secretDebug:{title:"\u0420\u0410\u0417\u0411\u041b\u041e\u041a\u0418\u0420\u041e\u0412\u041a\u0410 \u0421\u041a\u0420\u042b\u0422\u042b\u0425 \u0424\u0423\u041d\u041a\u0426\u0418\u0419 \u0418 UDS",logFileSize:"\u0427\u0435\u0440\u043d\u044b\u0439 \u044f\u0449\u0438\u043a / \u0420\u0430\u0437\u043c\u0435\u0440 \u0444\u0430\u0439\u043b\u0430:",dtcCloudSync:" \u041e\u0411\u041b\u0410\u0427\u041d\u0410\u042f \u0421\u0418\u041d\u0425\u0420\u041e\u041d\u0418\u0417\u0410\u0426\u0418\u042f DTC",lastSync:"\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u044f",syncNow:"\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0439\u0447\u0430\u0441",developerTools:"\u0418\u041d\u0421\u0422\u0420\u0423\u041c\u0415\u041d\u0422\u042b \u0420\u0410\u0417\u0420\u0410\u0411\u041e\u0422\u0427\u0418\u041a\u0410",trialResetSuccess:"\u0421\u0447\u0435\u0442\u0447\u0438\u043a \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u0439 \u043f\u0440\u043e\u0431\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0441\u0431\u0440\u043e\u0448\u0435\u043d!",crashTestTitle:"\u041a\u0440\u0430\u0448-\u0442\u0435\u0441\u0442",crashTestDesc:"\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u0430\u0432\u0430\u0440\u0438\u0439\u043d\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0443. \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044e Crashlytics.",crashButton:"\u0410\u0432\u0430\u0440\u0438\u044f",crashTest:"\u041a\u0440\u0430\u0448-\u0442\u0435\u0441\u0442"},features:{title:"\u0420\u0410\u0417\u0411\u041b\u041e\u041a\u0418\u0420\u041e\u0412\u041a\u0410 \u0421\u041a\u0420\u042b\u0422\u042b\u0425 \u0424\u0423\u041d\u041a\u0426\u0418\u0419 \u0418 UDS \u041a\u041e\u0414\u0418\u0420\u041e\u0412\u0410\u041d\u0418\u0415",subTitle:"ISO 14229 UDS \u0414\u043b\u0438\u043d\u043d\u043e\u0435 \u041a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0410\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u044f",batteryVoltage:"\u041d\u0410\u041f\u0420\u042f\u0416\u0415\u041d\u0418\u0415 \u0410\u041a\u041a\u0423\u041c\u0423\u041b\u042f\u0422\u041e\u0420\u0410",voltageReady:" \u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e (\u0413\u043e\u0442\u043e\u0432\u043e \u043a \u0437\u0430\u043f\u0438\u0441\u0438 \u0432 \u042d\u0411\u0423)",voltageLocked:" \u041d\u0438\u0437\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 (\u041a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043e)",locked:"\u0417\u0410\u0411\u041b\u041e\u041a\u0418\u0420\u041e\u0412\u0410\u041d\u041e",ready:"\u0413\u041e\u0422\u041e\u0412\u041e",allMarks:"\u0412\u0421\u0415 \u041c\u0410\u0420\u041a\u0418",writeBtn:"\u041d\u0410\u041f\u0418\u0421\u0410\u0422\u042c",catLighting:"\u041e\u0421\u0412\u0415\u0429\u0415\u041d\u0418\u0415",catSound:"\u0417\u0412\u0423\u041a \u0418 \u041f\u0420\u0415\u0414\u0423\u041f\u0420\u0415\u0416\u0414\u0415\u041d\u0418\u042f",catDisplay:"\u0418\u041d\u0421\u0422\u0420\u0423\u041c\u0415\u041d\u0422\u042b",catComfort:"\u041a\u041e\u041c\u0424\u041e\u0420\u0422",catSafety:"\u0411\u0415\u0417\u041e\u041f\u0410\u0421\u041d\u041e\u0421\u0422\u042c",safetyAlertTitle:" \u041e\u043f\u043e\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u043e \u043d\u0438\u0437\u043a\u043e\u043c \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0438 \u0431\u0430\u0442\u0430\u0440\u0435\u0438",safetyAlertMsg:"\u0414\u043b\u044f \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 12,2 \u0412.\n\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0437\u0430\u0440\u044f\u0434\u043d\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0438\u043b\u0438 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c.",items:{vag_staging_needle_sweep:{name:"\u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430/\u0440\u0430\u0437\u0432\u0435\u0440\u0442\u043a\u0430 \u0438\u0433\u043b\u044b",desc:"\u0421\u043c\u0435\u0449\u0430\u0435\u0442 \u0441\u0442\u0440\u0435\u043b\u043a\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432 \u0434\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430 \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},vag_acoustic_lock_confirmation:{name:"\u0417\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438",desc:"\u041f\u0440\u0438 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0435 \u0431\u0440\u0435\u043b\u043e\u043a\u0430 \u0438\u0437\u0434\u0430\u0435\u0442\u0441\u044f \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f."},vag_american_parking_lights:{name:"\u0421\u0442\u043e\u044f\u043d\u043e\u0447\u043d\u044b\u0435 \u043e\u0433\u043d\u0438 \u0432 \u0441\u0442\u0438\u043b\u0435 \u0421\u0428\u0410",desc:"\u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0433\u043e\u0440\u0438\u0442 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0435 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0441 \u044f\u0440\u043a\u043e\u0441\u0442\u044c\u044e 20% \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043d\u044b\u0445 \u043e\u0433\u043d\u0435\u0439."},vag_drl_menu_toggle:{name:"\u0414\u043d\u0435\u0432\u043d\u044b\u0435 \u0445\u043e\u0434\u043e\u0432\u044b\u0435 \u043e\u0433\u043d\u0438 (DRL) \u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u043c\u0435\u043d\u044e",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0444\u043b\u0430\u0436\u043e\u043a \u0412\u041a\u041b/\u0412\u042b\u041a\u041b \u0414\u0425\u041e \u0432 \u043c\u0435\u043d\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u043e-\u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b."},vag_tear_wiping:{name:"\u041e\u0447\u0438\u0441\u0442\u043a\u0430 \u043b\u043e\u0431\u043e\u0432\u043e\u0433\u043e \u0441\u0442\u0435\u043a\u043b\u0430",desc:"\u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u043e\u0447\u0438\u0441\u0442\u043a\u0443 \u0447\u0435\u0440\u0435\u0437 5 \u0441\u0435\u043a\u0443\u043d\u0434 \u043f\u043e\u0441\u043b\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043e\u043c\u044b\u0432\u0430\u0442\u0435\u043b\u044f \u0432\u0435\u0442\u0440\u043e\u0432\u043e\u0433\u043e \u0441\u0442\u0435\u043a\u043b\u0430."},vag_emergency_brake_flashing:{name:"\u041c\u0438\u0433\u0430\u043d\u0438\u0435 \u0430\u0432\u0430\u0440\u0438\u0439\u043d\u043e\u0433\u043e \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u044f",desc:"\u0411\u044b\u0441\u0442\u0440\u043e \u043c\u0438\u0433\u0430\u0435\u0442 \u0441\u0442\u043e\u043f-\u0441\u0438\u0433\u043d\u0430\u043b\u0430\u043c\u0438 \u0438 \u0441\u0438\u0433\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043e\u0431 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438 \u0440\u0435\u0437\u043a\u043e\u043c \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u043c \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u0438."},vag_cornering_lights:{name:"\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0435 \u0444\u0430\u0440\u044b \u043d\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u0445",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u044b\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0439 \u0444\u043e\u043d\u0430\u0440\u044c \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430."},vag_comfort_mirror_folding:{name:"\u0411\u0440\u0435\u043b\u043e\u043a \u0434\u043b\u044f \u043a\u043b\u044e\u0447\u0435\u0439 Comfort, \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u043e",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043a\u043e\u0432\u044b\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u043f\u0440\u0438 \u043d\u0430\u0436\u0430\u0442\u0438\u0438 \u043a\u043d\u043e\u043f\u043a\u0438 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u043d\u0430 \u0431\u0440\u0435\u043b\u043e\u043a\u0435."},vag_lap_timer:{name:"\u0422\u0430\u0439\u043c\u0435\u0440 \u043a\u0440\u0443\u0433\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0432\u043a\u043b\u0430\u0434\u043a\u0443 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0442\u0430\u0439\u043c\u0435\u0440\u0430 \u043a\u0440\u0443\u0433\u0430 \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432."},vag_refuel_quantity:{name:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0437\u0430\u043f\u0440\u0430\u0432\u043a\u0438",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0442\u043e\u0447\u043d\u044b\u0439 \u043e\u0431\u044a\u0435\u043c \u0432 \u043b\u0438\u0442\u0440\u0430\u0445, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0439 \u0434\u043b\u044f \u043f\u043e\u043b\u043d\u043e\u0439 \u0437\u0430\u043f\u0440\u0430\u0432\u043a\u0438 \u0442\u043e\u043f\u043b\u0438\u0432\u0430."},bmw_start_stop_memory:{name:"\u0420\u0435\u0436\u0438\u043c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0438 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043f\u0430\u043c\u044f\u0442\u0438",desc:"\u0417\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430-\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 (\u0412\u042b\u041a\u041b/\u0412\u041a\u041b) \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},bmw_digital_speedometer:{name:"\u0426\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0441\u043f\u0438\u0434\u043e\u043c\u0435\u0442\u0440\u0430",desc:"\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u043f\u0446\u0438\u044e \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0433\u043e \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043d\u0430 \u044d\u043a\u0440\u0430\u043d \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0430."},bmw_sport_displays:{name:"\u0421\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u044b\u0435 \u0434\u0438\u0441\u043f\u043b\u0435\u0438 (\u0434\u0430\u0442\u0447\u0438\u043a\u0438 HP \u0438 \u041d\u043c)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0448\u043a\u0430\u043b\u044b \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 \u0438 \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 iDrive."},bmw_acoustic_lock_sound:{name:"\u0417\u0432\u0443\u043a \u0430\u043a\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438/\u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438",desc:"\u0418\u0437\u0434\u0430\u0435\u0442 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0441\u0438\u0433\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u0440\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u043d\u0438\u0438 \u0438\u043b\u0438 \u043e\u0442\u043f\u0438\u0440\u0430\u043d\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},bmw_mirror_fold_delay_zero:{name:"\u041c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e\u0435 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043d\u0438\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430 (\u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0430 0,0 \u0441)",desc:"\u0421\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043a\u043e\u0432\u044b\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u043f\u0440\u0438 \u043d\u0430\u0436\u0430\u0442\u0438\u0438 \u043a\u043d\u043e\u043f\u043a\u0438 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0438."},bmw_tpms_tire_temperature:{name:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0432 \u0448\u0438\u043d\u0430\u0445",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0448\u0438\u043d \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 TPMS."},renault_trip_computer_enable:{name:"\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0431\u043e\u0440\u0442\u043e\u0432\u043e\u0433\u043e \u043f\u0443\u0442\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0431\u043e\u0440\u0442\u043e\u0432\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430 \u043e \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u0440\u0430\u0441\u0445\u043e\u0434\u0435 \u0442\u043e\u043f\u043b\u0438\u0432\u0430 \u0438 \u0437\u0430\u043f\u0430\u0441\u0435 \u0445\u043e\u0434\u0430."},renault_external_temp_display:{name:"\u0412\u043d\u0435\u0448\u043d\u0438\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043d\u0430\u0440\u0443\u0436\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u043d\u0430 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432."},renault_automatic_tailgate:{name:"\u0411\u0440\u0435\u043b\u043e\u043a \u0434\u043b\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a\u0430",desc:"\u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0437\u0430\u0449\u0435\u043b\u043a\u0438 \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a\u0430 \u043f\u0440\u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043d\u0438\u0438 \u043a\u043d\u043e\u043f\u043a\u0438 \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a\u0430 \u043d\u0430 \u0431\u0440\u0435\u043b\u043e\u043a\u0435."},renault_alarm_chirp:{name:"\u0417\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0441\u0438\u0433\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438",desc:"\u041f\u0440\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u043d\u0438\u0438 \u0434\u0432\u0435\u0440\u0435\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0437\u0432\u0443\u0447\u0438\u0442 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f."},renault_shift_indicator:{name:"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447 (GSI)",desc:"\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u043d\u043e\u0433\u043e \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f. \u0421\u0442\u0440\u0435\u043b\u043a\u0438 \u0412\u0412\u0415\u0420\u0425/\u0412\u041d\u0418\u0417 \u043d\u0430 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432."},ford_double_horn_honk_disable:{name:"\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0434\u0432\u043e\u0439\u043d\u043e\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0440\u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u0438 \u0434\u0432\u0435\u0440\u0438",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0434\u0432\u043e\u0439\u043d\u043e\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0440\u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u0438 \u0434\u0432\u0435\u0440\u0438 \u043f\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0435\u043c \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0435."},ford_auto_door_locking:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0430\u043f\u0438\u0440\u0430\u043d\u0438\u0435 \u0434\u0432\u0435\u0440\u0435\u0439 \u043d\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 20 \u043a\u043c/\u0447",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u0435\u0442 \u0432\u0441\u0435 \u0434\u0432\u0435\u0440\u0438, \u043a\u043e\u0433\u0434\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 20 \u043a\u043c/\u0447."},ford_tpms_psi_display:{name:"\u0426\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0432 \u0448\u0438\u043d\u0430\u0445",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0442\u043e\u0447\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 PSI/BAR \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0439 \u0448\u0438\u043d\u044b \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 \u043f\u0440\u0438\u0431\u043e\u0440\u0430."},ford_sync_climate_screen:{name:"\u041a\u043b\u0438\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u044d\u043a\u0440\u0430\u043d\u0430 SYNC",desc:"\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u043e\u0435 \u043c\u0435\u043d\u044e \u043a\u043b\u0438\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0438 \u043e\u0431\u043e\u0433\u0440\u0435\u0432\u0430 \u0441\u0438\u0434\u0435\u043d\u0438\u0439 \u043d\u0430 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 SYNC."},stellantis_power_windows_remote:{name:"\u0411\u0440\u0435\u043b\u043e\u043a \u0434\u043b\u044f \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043e\u043a\u043d\u043e\u043c \u0432\u0432\u0435\u0440\u0445/\u0432\u043d\u0438\u0437",desc:"\u041f\u043e\u0434\u043d\u0438\u043c\u0438\u0442\u0435 \u0438\u043b\u0438 \u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0432\u0441\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0442\u0435\u043a\u043b\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u0438\u043a\u0438 \u043f\u0440\u0438 \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0438 \u043a\u043d\u043e\u043f\u043e\u043a \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438/\u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438."},stellantis_cornering_fogs:{name:"\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0445 \u0444\u0430\u0440 \u043d\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u0445",desc:"\u0417\u0430\u0433\u043e\u0440\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u0430\u044f \u0444\u0430\u0440\u0430 \u043f\u0440\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u0445 \u043d\u0430 \u043d\u0438\u0437\u043a\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438."},vag_traffic_sign_recognition:{name:"\u0420\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u0440\u043e\u0436\u043d\u044b\u0445 \u0437\u043d\u0430\u043a\u043e\u0432 (VZE)",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0435 \u043a\u0430\u043c\u0435\u0440\u043e\u0439 \u0437\u043d\u0430\u043a\u0438 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043d\u0430 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432 \u0438 HUD."},vag_ambient_color_palette_30:{name:"30-\u0446\u0432\u0435\u0442\u043d\u0430\u044f \u043f\u0430\u043b\u0438\u0442\u0440\u0430 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0430\u043b\u0438\u0442\u0440\u0443 \u0446\u0432\u0435\u0442\u043e\u0432 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f 30 RGB \u0432 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u043e-\u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043c\u0435\u043d\u044e MIB."},vag_seatbelt_warning_mute:{name:"\u041e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u0440\u0435\u043c\u043d\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043d\u0435\u043f\u0440\u0438\u0441\u0442\u0435\u0433\u043d\u0443\u0442\u043e\u0433\u043e \u0440\u0435\u043c\u043d\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0432 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432."},bmw_alpina_cluster_theme:{name:"\u041a\u043e\u043c\u043f\u043e\u043d\u043e\u0432\u043a\u0430 Alpina Digital Dash",desc:"\u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442 \u0441\u0438\u043d\u044e\u044e \u0444\u0438\u0440\u043c\u0435\u043d\u043d\u0443\u044e \u0442\u0435\u043c\u0443 Alpina \u043a \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432."},bmw_video_in_motion:{name:"\u0412\u0438\u0434\u0435\u043e \u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 (VIM)",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u