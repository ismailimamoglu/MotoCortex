attery:"BATERIE",load:"\xceNC\u0102RCARE",intake:"AER DE ADMISIE",manifold:"COLECTOR kPa",customizeTitle:"SET\u0102RI PANOU DE BORD",customizeSubtitle:"Selecta\u021bi senzorii pe care dori\u021bi s\u0103 \xeei vede\u021bi pe ecran (Max 8).",layoutType:"Tip Aspect",layoutGrid:"GRIL\u0102",layoutList:"LIST\u0102",customizeButton:"PERSONALIZEAZ\u0102 BORDUL",coolant:"Temp. Lichid R\u0103cire",voltage:"Tensiune Baterie",engineLoad:"Sarcina Motorului",intakeAirTemp:"Temp. Aer Admisie",manifoldPressure:"Presiune Galerie (MAP)",ambientTemp:"Temp. Exterioar\u0103",oilTemp:"Temp. Ulei Motor",mafFlow:"Debit Aer MAF",timingAdvance:"Avans Aprindere",fuelLevel:"Nivel Combustibil",catalystTemp:"Temp. Catalizator",layoutGauge:"INDICATOR",obdTerminalTitle:"OBD HEALTH & TERMINAL",adapterClone:"ADAPTOR CLONARE",adapterOriginal:"ORIGINAL",adapterCloneShort:"CLONARE",adapterOriginalShort:"ORIGINAL",pidLabel:"PID: {{pid}}",limitReached:"Limit\u0103 de selec\u021bie",limitReachedDesc:"Pute\u021bi selecta maximum {{limit}} senzori cu acest protocol.",customizeSubtitleKLine:"Protocolul K-Line conectat. Pute\u021bi selecta maximum {{limit}} senzori.",customizeSubtitleCAN:"Protocol CAN-Bus conectat. Pute\u021bi selecta maximum {{limit}} senzori.",unit:"unitate",statusNormal:"NORMAL",layoutChart:"HART\u0102",adblue:"Nivel AdBlue",egt:"Temperatura gazelor de e\u0219apament (EGT)",nox:"Valoare senzor NOx",torque:"Cuplu motor",selectedSensorsCount:"{{count}} / {{max}} senzori selecta\u021bi"},expertise:{historyFound:"ISTORICUL VEHICULULUI G\u0102SIT!",historyFoundDesc:"\xcenregistr\u0103rile{{count}}ale acestui vehicul au fost create anterior. Pute\u021bi revizui mai jos istoricul.",viewHistory:"VEZI ISTORIA \u203a",manualVin:"NUM\u0102R DE \u0218ASIU (INTRODARE MANUAL\u0102)",manualVinDesc:"Dac\u0103 computerul vehiculului nu \xeemp\u0103rt\u0103\u0219e\u0219te automat num\u0103rul \u0219asiului (VIN), \xeel pute\u021bi scrie aici.",vinPlaceholder:"Tip VIN...",startScan:"\xceNCEP\u021aI SCANAREA EXPERT",scanning:"Se scaneaz\u0103...",vehicleIdentity:"ID-UL \u0218I KILOMETRAJUL VEHICULULUI",vin:"Num\u0103r \u0219asiu (VIN)",odometer:"KM original",distSinceCleared:"Eroare \u0219tears\u0103",milDist:"Lumina motorului aprins",dtcTitle:"Coduri de eroare (DTC)",dtcClean:"F\u0102R\u0102 CODURI DE EROARE - CURAT",extraActions:"TRANZAC\u021aII EXTRA",garageTitle:"GARAJ \u0218I \xceNREGISTR\u0102RI ANTRECELE",share:"SHARE",saveVehicle:"SALVA\u021aI ACEST INSTRUMENT",noRecords:"Nu exist\u0103 \xeenc\u0103 vehicule \xeenmatriculate.",clean:"CURAT",faults:"E\u0219ec",vinRequired:"VIN necesar",vinRequiredDesc:"Pentru \xeenregistrare, num\u0103rul \u0219asiului (VIN) trebuie s\u0103 apar\u0103 automat sau s\u0103 fie scris manual.",missingInfo:"Informa\u021bii lips\u0103",missingInfoDesc:"V\u0103 rug\u0103m s\u0103 completa\u021bi c\xe2mpul Brand \u0219i Model.",saved:"Salvat ",savedDesc:"A fost ad\u0103ugat\u0103 \xeen garaj ca urmare a expertizei.",connRequired:"Conexiune necesar\u0103",connRequiredDesc:"V\u0103 rug\u0103m s\u0103 v\u0103 conecta\u021bi mai \xeent\xe2i la vehicul pentru a \xeencepe acest proces.",chronicFaultsTitle:"Probleme cronice statistice",chronicFaultsObs:"{{code}}(Observa\u021bie:{{days}}Zi diferit\u0103 / Total:{{total}}Ori)",chronicFaultsPending:"Colectarea grupului de date / analiza statisticilor",notScanned:"Nu a fost scanat",notScannedDesc:"V\u0103 rug\u0103m s\u0103 ap\u0103sa\u021bi butonul de scanare din dreapta sus pentru a citi codurile de diagnosticare.",scanFailed:"SCANAREA EROUT\u0102",errTimeout:"Error: Connection Timeout (TIMEOUT)\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost (CONNECTION_LOST)\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\n(HARDWARE_FATAL_RECOVERY_FAILED)\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error (ERROR_UNABLE_TO_READ)\nECU trouble codes could not be read.",scannedSystems:"SISTEME SCANATE",moduleEngine:"Unitate de control al motorului (ECU)",moduleAbs:"Sistem de fr\xe2nare antiblocare (ABS)",moduleTcm:"Modulul de control al transmisiei (TCM)",moduleBcm:"Modul de control al caroseriei (BCM)",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:" AVERTISMENT DE SECURITATE",safetyWarningDesc:"\xcen timpul acestui proces: \u2022 Aprinderea trebuie s\u0103 fie PORNIT \u2022 Motorul trebuie s\u0103 fie OPRIT \u2022 Nu porni\u0163i vehiculul Vrei s\u0103 continui?",step1:"Pasul 1: \u0218terge\u021bi codurile de eroare",step1Desc:"Toate codurile de eroare stocate (DTC) \u0219i ledul Check Engine vor fi \u0219terse. Valorile de reglare a combustibilului vor fi resetate. Aceast\u0103 ac\u021biune nu poate fi anulat\u0103!",step2:"Pasul 2: Resetare hardware ECU",step2Desc:"O resetare electric\u0103 (Hard Reset) va fi trimis\u0103 la computerul motorului. Func\u021bioneaz\u0103 ca demontarea \u0219i instalarea bateriei. Este ineficient \xeen ECU-uri care nu suport\u0103. Nu face r\u0103u.",clearCodes:"\u0218terge coduri",ecuReset:"\u0218terge\u021bi codurile de eroare",finish:"Omite (termin\u0103)",completed:"Finalizat ",completedDesc:"Opera\u021biunile de service au fost finalizate cu succes. Pute\u021bi reporni vehiculul.",hardResetDesc:"Toate opera\u021biunile de service au fost finalizate cu succes. \u2022 Codurile de eroare au fost \u0219terse \u2022 Resetarea garniturii de combustibil \u2022 Resetare ECU Pute\u021bi reporni vehiculul."},info:{desc:"Aplica\u021bie profesional\u0103 de diagnosticare a motocicletelor \u0219i vehiculelor. Compatibil cu toate vehiculele.",upgrade:" Face\u021bi upgrade la Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"Acces timpuriu ",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner este \xeen prezent \xeen dezvoltare. Deoarece sunte\u021bi utilizatorul nostru timpuriu, toate func\u021biile pro sunt disponibile pentru dvs. acum. Feedback-ul dumneavoastr\u0103 este foarte valoros pentru noi!",helpGuide:"AJUTOR \u0218I GHID",language:" Limb\u0103 / Limb\u0103 / Bahasa",support:"CENTRUL DE SUPORT",supportSubject:"Suport \u0219i feedback Cortex OBD2 Diagnostic Scanner",thanks:"Multumesc!",thanksDesc:"V\u0103 mul\u021bumim pentru feedback. Ne pute\u021bi l\u0103sa un comentariu pe Play Store.",sections:{live:{title:"SENSORI DE MONITORIZARE \xceN VIE",content:"Pute\u021bi monitoriza instantaneu RPM, viteza, temperatura motorului, pozi\u021bia clapetei de accelera\u021bie, tensiunea bateriei, sarcina motorului, temperatura aerului de admisie \u0219i presiunea \xeen galerie (MAP). Valorile sunt re\xeemprosp\u0103tate de 1-5 ori pe secund\u0103, \xeen func\u021bie de viteza Bluetooth. Pute\u021bi interveni direct \xeen vehicul cu comenzi UDS / OBD prin intermediul terminalului."},expertise:{title:"EXAMINARE \u0218I GARAN\u021aIE",content:"Aplica\u021bia folose\u0219te coduri ECU (Brain) pentru a detecta erori. Sunt capturate num\u0103rul VIN (VIN) \u0219i kilometrajul curent \xeenregistrat pe vehicul. \xcen plus, erorile anterioare sunt determinate prin calcularea c\xe2t de departe a parcurs vehiculul cu lumina Check Engine. Raportul rezultat poate fi partajat \xeen medii PDF \u0219i Mesaje."},tests:{title:"BATERIE / TESTE DE PERFORMAN\u021a\u0102",content:"Testarea bateriei are 3 etape: testele de repaus, de pornire \u0219i de \xeenc\u0103rcare \xeen gol m\u0103soar\u0103 starea bateriei/regulatorului. Testul de performan\u021b\u0103 m\u0103soar\u0103 valori de accelera\u021bie 0-60 \u0219i 0-100 km/h cu o marj\u0103 de eroare de 50 ms, folosind datele de vitez\u0103 instantanee de la procesorul telefonului \u0219i vehiculul dumneavoastr\u0103."},hardware:{title:"COMPATIBILITATE HARDWARE",content:"Este recomandat ELM327 Bluetooth (v1.5). Este posibil ca unele coduri avansate s\u0103 nu func\u021bioneze pe hardware de calitate slab\u0103 cu versiunea v2.1 CLONE. Ob\u021bine\u021bi cea mai rapid\u0103 vitez\u0103 cu adaptoare premium precum vLinker \u0219i OBDLink."},warnings:{title:"AVERTIZ\u0102RI IMPORTANTE",content:"\u2022 Aprinderea trebuie s\u0103 fie PORNIT \u0219i motorul OPRIT \xeen timpul procesului de \u0219tergere a codului de eroare sau al func\u021biei de resetare ECU. \u2022 Nu trimite\u021bi o resetare unui vehicul care ruleaz\u0103. \u2022 Nu toate vehiculele pot suporta to\u021bi senzorii, senzorii neaccepta\u021bi vor afi\u0219a \u201e--\u201d."},onboarding:{title:"PERMISIUNI LEGALE \u0218I TELEMETRIE ANONIM\u0102",content:"Pentru a \xeembun\u0103t\u0103\u021bi calitatea aplica\u021biei \u0219i compatibilitatea vehiculelor; Parametrii motorului complet anonimi \u0219i codurile de eroare generate \xeen timpul diagnostic\u0103rii defec\u021biunii (f\u0103r\u0103 a con\u021bine date personale \u0219i num\u0103rul \u0219asiului) pot fi analizate pe serverele noastre securizate. Continu\xe2nd, sunte\u021bi de acord cu ace\u0219ti termeni anonimi de telemetrie. Permisiunile Bluetooth \u0219i loca\u021bie sunt necesare pentru a comunica cu ECU-ul motocicletei dvs."},featureCoding:{title:"DEBLOCAREA FUN\u021aIILOR ASCUSCATE \u0219i CODARE UDS",content:"Alimentat de motorul nostru de protocol ISO 14229 UDS, comuta\u021bi \xeen siguran\u021b\u0103 func\u021bii precum luminile de parcare din SUA, m\u0103turarea acului, blocarea claxonului, geamurile confortabile \u0219i set\u0103rile DRL pentru vehiculele VAG, BMW, Renault \u0219i Dacia."},multiEcu:{title:"SCANARE MULTI-ECU TOATE MODULELE",content:"Scana\u021bi \u0219i \u0219terge\u021bi codurile de eroare dincolo de ECU al motorului - inclusiv ABS, airbag, transmisie automat\u0103 (TCU), grup de instrumente, control climatic (HVAC) \u0219i module de control al caroseriei (BCM)."},advancedDiagnostics:{title:"ADAPTARE DCT, DPF \u0219i INDICATOR DE PUTERE HP",content:"\u2022 DCT / DSG Clutch Kiss Point Learning & Adaptation Reset\n\u2022 Monitorizarea \xeenc\u0103rc\u0103rii cu funingine DPF (%/g) \u0219i a temperaturii de regenerare a gazelor de evacuare\n\u2022 Trimuri de combustibil pe termen scurt/lung \xeen timp real (STFT/LTFT) \u0219i analiz\u0103 Lambda\n\u2022 Grafic de telemetrie dinamic\u0103 a cailor putere (CP) \u0219i a cuplului (Nm)."},demoMode:{title:"MOD DEMO (SIMULARE)",content:"Testa\u021bi \u0219i explora\u021bi aplica\u021bia f\u0103r\u0103 hardware OBD2 fizic. Experimenta\u021bi func\u021biile complete de diagnosticare CAN-Bus \u0219i UDS cu simularea realist\u0103 a telemetriei \xeen timp real."}},reconfigurePermissions:"Reafi\u0219eaz\u0103 permisiunile \u0219i condi\u021biile legale",shareWithFriend:"TRIMITE UNUI PRIETEN",shareMessageText:"Descoper\u0103 codurile de eroare ECU ale vehiculului \u0219i telemetria \xeen timp real cu Cortex OBD2 Diagnostic Scanner!\n\nDescarc\u0103 acum:\n iOS (App Store): https://apps.apple.com/app/id6742882583\n Android (Play Store): https://play.google.com/store/apps/details?id=com.ismail.motocortexv2\n Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:" \u2550\u2550\u2550 RAPORT DE DIAGNOSTIC CORTEX OBD2 \u2550\u2550\u2550 ",vehicleIdentity:" ID VEHICUL",vin:"Num\u0103r \u0219asiu (VIN)",odometer:"Distan\u021b\u0103 (KM)",milDist:"Lumina motorului aprins",distSinceCleared:"Eroare \u0219tears\u0103",dtcCount:" CODURI DE EROARE ({{count}}cantitate)",sensorData:" DATE LIVE DE LA SENZOR",noData:"Nu s-au putut citi datele",proApp:"Scanat cu Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"data",vinNotFound:"Nedetectat",noDtcs:"F\u0102R\u0102 CODURI DE EROARE - CURAT",speed:"viteza",coolant:"Temperatura motorului",throttle:"gaz",engineLoad:"Sarcina motorului",intakeAir:"Aer de admisie",voltage:"Tensiunea bateriei",shareMessage:"Urm\u0103re\u0219te starea motocicletei tale din buzunar cu aplica\u021bia de diagnosticare Motocortex OBD2! Desc\u0103rca\u021bi: https://cortexobd2.app",manifold:"Manifold",subtitle:"Diagnosticare cuprinz\u0103toare la m\xe2na a doua \u0219i inspec\u021bie de telemetrie",vehicleInfo:"Identificarea vehiculului \u0219i metadatele ECU",healthScore:"Scorul general de s\u0103n\u0103tate ECU",dtcSection:"Coduri de diagnosticare a erorilor (audit DTC)",telemetrySection:"Telemetrie live \u0219i instantaneu senzor",maintenanceSection:"Istoricul de service \u0219i \xeentre\u021binere Ak\u0131ll\u0131 Garaj",aiSection:"Analiza general\u0103 a st\u0103rii AI Doctor",noFaults:"Nu exist\u0103 coduri de eroare active sau istorice stocate \xeen memoria ECU.",noMaintenance:"Nu exist\u0103 intr\u0103ri de servicii \xeenregistrate \xeen Ak\u0131ll\u0131 Garaj.",disclaimer:"Disclaimer: Acest raport este generat de software-ul de diagnosticare MotoCortex. Se recomand\u0103 inspec\u021bia fizic\u0103 de c\u0103tre un tehnician autorizat \xeenainte de achizi\u021bionarea vehiculului.",shareTitle:"Distribui\u021bi raportul de evaluare MotoCortex"},battery:{title:"BATERIE \u0218I TEST DE PORNIRE",ready:"Gata pentru a \xeencepe testarea.",restingStatus:"Contactul pus, motorul oprit... Se cite\u0219te tensiunea bateriei...",crankingStatus:"\xceNCEPE ACUM! (M\u0103surarea se va face timp de 5 secunde)",chargingStatus:"Motorul este la ralanti... Se cite\u0219te tensiunea de \xeenc\u0103rcare...",doneStatus:"Testarea s-a \xeencheiat!",voltageError:"Tensiunea nu a putut fi citit\u0103. Verifica\u021bi conexiunea.",start:"\xceNCEPE TESTUL",retry:"REPE\u021aI TESTUL",procedure:"PROCEDURA DE TESTARE",steps:{1:"1. Contactul pus, motorul oprit \u2192 Se m\u0103soar\u0103 tensiunea de repaus",2:"2. C\xe2nd apare mesajul \u201eSTART NOW\u201d, porni\u021bi motorul.",3:"3. Cea mai sc\u0103zut\u0103 tensiune \xeenregistrat\u0103 timp de 5 secunde",4:"4. Tensiunea de \xeenc\u0103rcare/regulator este m\u0103surat\u0103 \xeen timp ce motorul func\u021bioneaz\u0103"},warning:"Nu deconecta\u021bi conexiunea Bluetooth \xeen timpul test\u0103rii.",resting:"REST",cranking:"IMNUL",charging:"\xceNC\u0102RCARE",instantV:"TENSIUNE INSTANTAN\u0102",evaluation:"EVALUARE",verdicts:{full:"Baterie: Complet \xeenc\u0103rcat\u0103",good:"Baterie: Stare bun\u0103",weak:"Bateria: Sl\u0103bire",empty:"Bateria: slab\u0103/ moart\u0103",crankNormal:"\xcenceput: declin normal",crankLow:"Starter: tensiune joas\u0103",crankCritical:"Imnul: Sc\u0103dere critic\u0103",regNormal:"\xcenc\u0103rcare: Regulator normal",regLow:"\xcenc\u0103rcare: \xeenc\u0103rcare sc\u0103zut\u0103",regHigh:"\xcenc\u0103rcare: supra\xeenc\u0103rcare",regFail:"\xcenc\u0103rcare: Regulatorul este defect"},verdictLocked:"Face\u021bi upgrade la PRO pentru a vedea raportul detaliat de evaluare a bateriei \u0219i graficul de analiz\u0103 a pornirii."},freeze:{title:"\xcenghe\u021ba\u021bi cadru",snapshot:"MEMORIA E\u015eECURILOR",desc:"Cite\u0219te parametrii motorului c\xe2nd se aprinde ledul Check Engine. Aceste date ofer\u0103 informa\u021bii critice \xeen diagnosticarea defec\u021biunilor.",noDtcs:"Nu este \xeenregistrat niciun cod de eroare. Este posibil s\u0103 nu existe date \xeenghe\u021bate cadru.",read:"CITI\u021aI DATE \xceNGHE\u021aATE",loading:"Modul 02 este pus sub semnul \xeentreb\u0103rii...",noData:"Nu s-au g\u0103sit date \xeenghe\u021bate. Este posibil ca vehiculul s\u0103 nu accepte aceast\u0103 caracteristic\u0103.",error:"Eroare de citire a datelor",values:" VALORI SALVATE LA MOMENTUL E\u0218ECULUI",retry:"CITE\u0218TE DIN NOU",techInfo:"INFORMATII TEHNICE",techDesc:"\u2022 Modul OBD-II 02: \xcenghe\u021ba\u021bi datele cadru \u2022 PID 020C00: RPM \xeen eroare \u2022 PID 020D00: Viteza defect \u2022 PID 020500: Temperatura apei de r\u0103cire \xeen momentul defec\u021biunii Aceste date apar\u021bin ultimului cod de eroare. C\xe2nd codurile de eroare sunt \u0219terse, datele din cadru \xeenghe\u021bat sunt, de asemenea, \u0219terse.",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"TEST DE PERFORMAN\u021a\u0102",seconds:"SECONDE",speed:"KM/H",idle:"Ap\u0103sa\u021bi butonul \u0219i preg\u0103ti\u021bi-v\u0103 s\u0103 lua\u021bi m\u0103suri.",ready:"GATA! \xcencepe\u021bi s\u0103 conduce\u021bi vehiculul...",readyDesc:"Contorul porne\u0219te c\xe2nd viteza > 0.",measuring:"SE M\u0102SUR\u0102...",done:"TESTARE TERMINAT\u0102",start:"\xceNCEPE TESTUL",stop:"STOP",reset:"RESET",howItWorks:"CUM FUNCTIONEAZA?",howDesc:"1. Ap\u0103sa\u021bi butonul \u201eStart Test\u201d. 2. Vehiculul trebuie s\u0103 fie sta\u021bionat (Viteza = 0) 3. Chrono porne\u0219te c\xe2nd \xeencepe\u021bi s\u0103 v\u0103 mi\u0219ca\u021bi 4. Se \xeenregistreaz\u0103 timpi de trecere de 60 km/h \u0219i 100 km/h Face\u021bi acest test \xeentr-o zon\u0103 sigur\u0103!",sec:"sec"},dtc:{P0102:"Senzor de debit de aer (MAF) - Intrare sc\u0103zut\u0103",P0113:"Senzor de temperatur\u0103 a aerului de admisie - \xeenalt\u0103 tensiune",P0171:"Sistem de combustibil sc\u0103zut (banca 1)",P0300:"Eroare de aprindere aleatorie/cu mai multe cilindri",P0420:"Sistem convertizor catalitic (B1) - Eficien\u021b\u0103 sc\u0103zut\u0103",P0700:"Sistemul de control al transmisiei - Defec\u021biune",P0715:"Senzor de vitez\u0103 a turbinei - Defec\u021biune a circuitului",P0560:"Tensiune sistem - Defec\u021biune",P0562:"Tensiune sistem - sc\u0103zut\u0103",U0100:"Comunicare pierdut\u0103 cu modulul de control al motorului (ECM/PCM)",U0121:"Comunicare pierdut\u0103 cu modulul sistemului antiblocare de fr\xe2nare (ABS).",C0035:"Defec\u021biune a circuitului senzorului de vitez\u0103 a ro\u021bii din fa\u021b\u0103 st\xe2nga",B0001:"Circuitul de control al implement\u0103rii etapei 1 a \u0219oferului din fa\u021b\u0103",P0750:"Defec\u021biune a solenoidului de schimbare A",P0814:"Defec\u021biune a circuitului de afi\u0219are a intervalului de transmisie",U0140:"Comunicare pierdut\u0103 cu modulul de control al corpului (BCM)",C0040:"Defec\u021biune a circuitului senzorului de vitez\u0103 a ro\u021bii din fa\u021b\u0103 dreapta",C0110:"Defec\u021biune a circuitului motorului pompei ABS",C0121:"Defec\u021biune a circuitului senzorului de presiune a fr\xe2nelor",B0010:"Cont