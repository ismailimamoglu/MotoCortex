9a76\u5458\u5ea7\u6905\u9760\u80cc\u5e76\u503e\u659c\u65b9\u5411\u76d8\uff0c\u4ee5\u4fbf\u4e8e\u8fdb\u51fa\u3002"},nissan_epower_regen_mode:{name:"e-POWER \u4e00\u8e0f\u677f\u518d\u751f\u5236\u52a8\u6a21\u5f0f\uff08\u65e5\u4ea7\uff09",desc:"\u8bbe\u7f6e\u9ed8\u8ba4\u7684\u7535\u52a8\u8e0f\u677f\u518d\u751f\u5236\u52a8\u51cf\u901f\u5ea6\u6c34\u5e73\u3002"},nissan_propilot_assist_timing:{name:"ProPILOT \u8f66\u9053\u5c45\u4e2d\u8f85\u52a9\u8f6c\u5411\u7075\u654f\u5ea6\uff08\u65e5\u4ea7\uff09",desc:"\u914d\u7f6e ProPILOT \u8f6c\u5411\u5e72\u9884\u6e05\u6670\u5ea6\u3002"},nissan_intelligent_around_view:{name:"\u4f4e\u901f\u65f6\u73af\u89c6\u76d1\u89c6\u5668\u81ea\u52a8\u5f39\u51fa\uff08\u65e5\u4ea7\uff09",desc:"\u5f53\u524d\u65b9\u505c\u8f66\u4f20\u611f\u5668\u68c0\u6d4b\u5230\u969c\u788d\u7269\u65f6\uff0c\u89e6\u53d1 360 \u5ea6\u6444\u50cf\u5934\u663e\u793a\u3002"},mazda_g_vectoring_display:{name:"G-Vectoring Control Plus \u52a8\u6001\u5c55\u793a\u53f0\uff08\u9a6c\u81ea\u8fbe\uff09",desc:"\u5728\u4eea\u8868\u677f\u4e0a\u663e\u793a\u5b9e\u65f6 GVC+ \u8f6c\u5f2f\u626d\u77e9\u77e2\u91cf\u56fe\u3002"},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP \u5236\u52a8\u80fd\u91cf\u56de\u6536\u7535\u5bb9\u8868\uff08\u9a6c\u81ea\u8fbe\uff09",desc:"\u5728\u4e2d\u592e\u5c4f\u5e55\u4e0a\u663e\u793a\u7535\u5bb9\u5668\u5145\u7535\u548c\u653e\u7535\u72b6\u6001\u3002"},mazda_smart_city_brake_sens:{name:"\u667a\u80fd\u57ce\u5e02\u5236\u52a8\u652f\u6301 (SCBS) \u7075\u654f\u5ea6\uff08\u9a6c\u81ea\u8fbe\uff09",desc:"\u8bbe\u7f6e\u4f4e\u901f\u81ea\u52a8\u7d27\u6025\u5236\u52a8\u4f20\u611f\u5668\u8303\u56f4\u3002"},subaru_eyesight_distance_preset:{name:"EyeSight \u81ea\u9002\u5e94\u5de1\u822a\u63a7\u5236\u9ed8\u8ba4\u8ddd\u79bb\uff08\u65af\u5df4\u9c81\uff09",desc:"\u5728\u542f\u52a8\u65f6\u914d\u7f6e\u7acb\u4f53\u76f8\u673a\u9ed8\u8ba4\u5de1\u822a\u95f4\u9699\u914d\u7f6e\u6587\u4ef6\u3002"},subaru_xmode_auto_engage:{name:"X \u6a21\u5f0f\u8d8a\u91ce\u7275\u5f15\u529b\u81ea\u52a8\u63a5\u5408\u9608\u503c\uff08\u65af\u5df4\u9c81\uff09",desc:"\u8bbe\u7f6e\u81ea\u52a8\u53cc\u529f\u80fd X \u6a21\u5f0f\u6fc0\u6d3b\u7684\u8f66\u8f6e\u6ed1\u79fb\u9608\u503c\u3002"},subaru_steering_responsive_headlights:{name:"\u8f6c\u5411\u54cd\u5e94\u5f0f\u8f66\u5934\u706f (SRH) \u5207\u6362\uff08\u65af\u5df4\u9c81\uff09",desc:"\u542f\u7528\u6216\u7981\u7528\u5b9a\u5411\u81ea\u9002\u5e94\u5934\u706f\u65cb\u8f6c\u3002"},genesis_sport_plus_mode:{name:"\u8fd0\u52a8+\u52a8\u529b\u603b\u6210\u548c\u7535\u5b50\u60ac\u67b6\u6a21\u5f0f\uff08\u521b\u4e16\u7eaa\uff09",desc:"\u89e3\u9501\u9762\u5411\u8d5b\u9053\u7684 ESC OFF \u548c\u52a0\u5f3a\u963b\u5c3c\u5668\u6620\u5c04\u3002"},genesis_ambient_active_light:{name:"\u4e3b\u52a8\u73af\u5883\u7167\u660e\u9a71\u52a8\u6a21\u5f0f\u540c\u6b65 (Genesis)",desc:"\u6839\u636e\u9a7e\u9a76\u6a21\u5f0f\u52a8\u6001\u6539\u53d8\u5185\u90e8\u73af\u5883\u7167\u660e\u989c\u8272\u3002"},volvo_city_safety_warning:{name:"\u57ce\u5e02\u5b89\u5168\u81ea\u4e3b\u7d27\u6025\u9884\u8b66\u7075\u654f\u5ea6\uff08\u6c83\u5c14\u6c83\uff09",desc:"\u914d\u7f6e\u96f7\u8fbe\u548c\u6fc0\u5149\u96f7\u8fbe\u78b0\u649e\u8b66\u544a\u8b66\u62a5\u65f6\u95f4\uff08\u65e9\u671f/\u6b63\u5e38\uff09\u3002"},chery_ar_navigation_hud:{name:"HUD\u4e0a\u7684AR\u5bfc\u822a\u6295\u5f71\u53e0\u52a0\uff08\u5947\u745e\uff09",desc:"\u5c06 3D \u589e\u5f3a\u73b0\u5b9e\u5bfc\u822a\u7bad\u5934\u6295\u5f71\u5230\u6321\u98ce\u73bb\u7483\u4e0a\u3002"},jlr_terrain_response_preset:{name:"\u5730\u5f62\u54cd\u5e94\u81ea\u52a8\u8d8a\u91ce\u6a21\u5f0f\u9884\u8bbe (JLR)",desc:"\u8bb0\u4f4f\u6700\u540e\u7684\u5730\u5f62\u54cd\u5e94\u8868\u9762\u8f6e\u5ed3\uff08\u8349\u5730/\u783e\u77f3/\u96ea\uff09\u3002"},jlr_adaptive_dynamics_firm:{name:"\u81ea\u9002\u5e94\u52a8\u6001\u963b\u5c3c\u5668\u786c\u5ea6\u66f2\u7ebf (JLR)",desc:"\u8bbe\u7f6e\u9ed8\u8ba4\u7535\u5b50\u51cf\u9707\u5668\u963b\u5c3c\u521a\u5ea6\u3002"},jlr_wading_sensor_alert:{name:"\u6d89\u6c34\u611f\u5e94\u6df1\u5ea6\u8b66\u544a\u9e23\u54cd\u9608\u503c (JLR)",desc:"\u914d\u7f6e\u8d85\u58f0\u6ce2\u6c34\u6df1\u8b66\u62a5\u9e23\u54cd\u7075\u654f\u5ea6\u3002"},alfa_dna_dynamic_memory:{name:"Alfa DNA \u9009\u62e9\u5668\u52a8\u6001\u6a21\u5f0f\u542f\u52a8\u5185\u5b58 (Alfa Romeo)",desc:"\u91cd\u542f\u540e\u4fdd\u7559\u52a8\u6001\u6a21\u5f0f\u6cb9\u95e8\u54cd\u5e94\u3002"},alfa_q4_torque_split:{name:"Q4\u5168\u8f6e\u9a71\u52a8\u5b9e\u65f6\u626d\u77e9\u5206\u5272\u56fe\uff08\u963f\u5c14\u6cd5\u7f57\u5bc6\u6b27\uff09",desc:"\u5728\u4eea\u8868\u663e\u793a\u5c4f\u4e0a\u663e\u793a AWD \u524d/\u540e\u529f\u7387\u5206\u914d\u767e\u5206\u6bd4\u3002"},li_auto_range_extender_mode:{name:"REV \u53d1\u7535\u673a\u7535\u6c60\u7535\u91cf\u4fdd\u6301\u6c34\u5e73\uff08Li Auto\uff09",desc:"\u8c03\u6574\u5185\u71c3\u673a\u53d1\u7535\u673a\u542f\u52a8\u9608\u503c\u3002"},li_auto_cinema_seat_position:{name:"\u5267\u9662/\u5f71\u9662\u6a21\u5f0f\u4eba\u4f53\u5de5\u5b66\u5ea7\u6905\u4f4d\u7f6e\uff08Li Auto\uff09",desc:"\u5f53\u5f71\u9662\u6a21\u5f0f\u6fc0\u6d3b\u65f6\uff0c\u53ef\u503e\u659c\u540e\u6392\u5ea7\u6905\u5e76\u5c55\u5f00\u817f\u6258\u3002"},zeekr_drift_mode_torque:{name:"\u53cc\u7535\u673a\u6027\u80fd\u6f02\u79fb\u6a21\u5f0f\u540e\u504f\u7f6e (Zeekr)",desc:"\u5411\u540e\u7535\u52a8\u673a\u53d1\u9001 100% \u626d\u77e9\u4ee5\u5b9e\u73b0\u53d7\u63a7\u6f02\u79fb\u3002"},zeekr_ambient_beat_sync:{name:"\u73af\u5883\u706f\u5149\u97f3\u4e50\u8282\u594f\u8282\u62cd\u540c\u6b65\uff08Zeekr\uff09",desc:"\u8f66\u5185\u7167\u660e\u4e0e\u64ad\u653e\u7684\u97f3\u4e50\u8282\u62cd\u540c\u6b65\u8109\u52a8\u3002"},tata_drive_mode_voice:{name:"\u9a7e\u9a76\u6a21\u5f0f\u5207\u6362\u8bed\u97f3\u64ad\u62a5\uff08Tata\uff09",desc:"\u5207\u6362\u9a7e\u9a76\u6a21\u5f0f\uff08\u57ce\u5e02/\u8fd0\u52a8/\u751f\u6001\uff09\u65f6\u542f\u7528\u97f3\u9891\u8bed\u97f3\u786e\u8ba4\u3002"},mahindra_zip_zap_zoom_custom:{name:"Zip/Zap/Zoom \u52a8\u529b\u7cfb\u7edf\u6cb9\u95e8\u54cd\u5e94\u66f2\u7ebf (Mahindra)",desc:"\u81ea\u5b9a\u4e49 Zip\u3001Zap \u548c Zoom \u9a7e\u9a76\u6a21\u5f0f\u7684\u52a0\u901f\u66f2\u7ebf\u3002"},fun_cyberpunk_cluster_theme:{name:"\u8d5b\u535a\u670b\u514b 2077 \u9713\u8679\u56fe\u5f62\u9a7e\u9a76\u8231\u4e3b\u9898",desc:"\u5e94\u7528\u672a\u6765\u6d3e\u9713\u8679\u9752\u8272\u548c\u7425\u73c0\u8272\u6570\u5b57\u4eea\u8868\u677f\u4eea\u8868\u9020\u578b\u3002"},fun_exhaust_flame_sound_effect:{name:"\u7acb\u4f53\u58f0\u7cfb\u7edf Pop & Bang \u6392\u6c14\u97f3\u6548",desc:"\u901a\u8fc7\u673a\u8231\u626c\u58f0\u5668\u64ad\u653e\u903c\u771f\u7684 V8 \u6392\u6c14\u7ba1\u7206\u88c2\u58f0\u97f3\u6548\u3002"},fun_matrix_light_show_welcome:{name:"\u5b9a\u5236\u5934\u706f\u77e9\u9635 LED Dance Welcome",desc:"\u4f7f\u7528\u5934\u706f\u548c\u6307\u793a\u706f\u64ad\u653e\u6709\u8282\u594f\u7684\u706f\u5149\u79c0\u7f16\u6392\u3002"},fun_stealth_fighter_display:{name:"\u9690\u5f62\u6218\u6597\u673a\u591c\u95f4\u9a7e\u9a76\u6781\u7b80\u96c6\u7fa4\u6a21\u5f0f",desc:"\u5728\u6f06\u9ed1\u7684\u591c\u95f4\u9a7e\u9a76\u65f6\uff0c\u5173\u95ed\u9664\u8f66\u901f\u8868\u4e4b\u5916\u7684\u6240\u6709\u4eea\u8868\u706f\u3002"},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{name:"Retarder & Jake Brake Downshift Aggressiveness",desc:"Adjusts retarder torque blending curve and automatic transmission downshifting response under braking."},man_ecas_dock_level_memory:{name:"ECAS Air Suspension Loading Dock Height Memory",desc:"Stores and recalls customized pneumatic air suspension height level presets for loading docks.