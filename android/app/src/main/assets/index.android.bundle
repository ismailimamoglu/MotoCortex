...",crankingStatus:"\u0627\u0628\u062f\u0623 \u0627\u0644\u0622\u0646! (\u0633\u064a\u062a\u0645 \u0627\u0644\u0642\u064a\u0627\u0633 \u0644\u0645\u062f\u0629 5 \u062b\u0648\u0627\u0646\u064a)",chargingStatus:"\u0627\u0644\u0645\u062d\u0631\u0643 \u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u062e\u0645\u0648\u0644... \u062a\u062a\u0645 \u0642\u0631\u0627\u0621\u0629 \u062c\u0647\u062f \u0627\u0644\u0634\u062d\u0646...",doneStatus:"\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631!",voltageError:"\u0644\u0627 \u064a\u0645\u0643\u0646 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u062c\u0647\u062f. \u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644.",start:"\u0627\u0628\u062f\u0623 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631",retry:"\u0643\u0631\u0631 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631",procedure:"\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631",steps:{1:"1. \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0644\u060c \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 \u2190 \u064a\u062a\u0645 \u0642\u064a\u0627\u0633 \u062c\u0647\u062f \u0627\u0644\u0631\u0627\u062d\u0629",2:"2. \u0639\u0646\u062f\u0645\u0627 \u062a\u0638\u0647\u0631 \u0631\u0633\u0627\u0644\u0629 \"\u0627\u0628\u062f\u0623 \u0627\u0644\u0622\u0646\"\u060c \u0642\u0645 \u0628\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643.",3:"3. \u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0623\u0642\u0644 \u062c\u0647\u062f \u0644\u0645\u062f\u0629 5 \u062b\u0648\u0627\u0646\u064a",4:"4. \u064a\u062a\u0645 \u0642\u064a\u0627\u0633 \u062c\u0647\u062f \u0627\u0644\u0634\u062d\u0646/\u0627\u0644\u0645\u0646\u0638\u0645 \u0623\u062b\u0646\u0627\u0621 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643"},warning:"\u0644\u0627 \u062a\u0642\u0645 \u0628\u0641\u0635\u0644 \u0627\u062a\u0635\u0627\u0644 Bluetooth \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631.",resting:"\u0631\u0627\u062d\u0629",cranking:"\u0646\u0634\u064a\u062f \u0648\u0637\u0646\u064a",charging:"\u0627\u0644\u0634\u062d\u0646",instantV:"\u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0641\u0648\u0631\u064a",evaluation:"\u0627\u0644\u062a\u0642\u064a\u064a\u0645",verdicts:{full:"\u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629: \u0645\u0634\u062d\u0648\u0646\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644",good:"\u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629: \u062d\u0627\u0644\u0629 \u062c\u064a\u062f\u0629",weak:"\u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629: \u0636\u0639\u064a\u0641\u0629",empty:"\u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629: \u0636\u0639\u064a\u0641\u0629/\u0645\u064a\u062a\u0629",crankNormal:"\u0627\u0644\u0628\u062f\u0627\u064a\u0629: \u0627\u0644\u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0637\u0628\u064a\u0639\u064a",crankLow:"\u0643\u0627\u062a\u0628: \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0645\u0646\u062e\u0641\u0636",crankCritical:"\u0627\u0644\u0646\u0634\u064a\u062f: \u0647\u0628\u0648\u0637 \u062d\u0627\u0633\u0645",regNormal:"\u0627\u0644\u0634\u062d\u0646: \u0645\u0646\u0638\u0645 \u0639\u0627\u062f\u064a",regLow:"\u0627\u0644\u0634\u062d\u0646: \u0634\u062d\u0646 \u0645\u0646\u062e\u0641\u0636",regHigh:"\u0627\u0644\u0634\u062d\u0646: \u0641\u0627\u062d\u0634",regFail:"\u0627\u0644\u0634\u062d\u0646: \u0627\u0644\u0645\u0646\u0638\u0645 \u0645\u0639\u064a\u0628"},verdictLocked:"\u0642\u0645 \u0628\u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0625\u0644\u0649 PRO \u0644\u0639\u0631\u0636 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u0641\u0635\u0644."},freeze:{title:"\u062a\u062c\u0645\u064a\u062f \u0627\u0644\u0625\u0637\u0627\u0631",snapshot:"\u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0641\u0634\u0644",desc:"\u064a\u0642\u0631\u0623 \u0645\u0639\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u062d\u0631\u0643 \u0639\u0646\u062f\u0645\u0627 \u064a\u0636\u064a\u0621 \u0636\u0648\u0621 \u0641\u062d\u0635 \u0627\u0644\u0645\u062d\u0631\u0643. \u062a\u0648\u0641\u0631 \u0647\u0630\u0647 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0647\u0645\u0629 \u0641\u064a \u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0623\u062e\u0637\u0627\u0621.",noDtcs:"\u0644\u0627 \u064a\u0648\u062c\u062f \u0631\u0645\u0632 \u062e\u0637\u0623 \u0645\u0633\u062c\u0644. \u0642\u062f \u0644\u0627 \u062a\u0643\u0648\u0646 \u0647\u0646\u0627\u0643 \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u062c\u0645\u064a\u062f \u0627\u0644\u0625\u0637\u0627\u0631.",read:"\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062c\u0645\u062f\u0629",loading:"\u064a\u062a\u0645 \u0627\u0633\u062a\u062c\u0648\u0627\u0628 \u0627\u0644\u0648\u0636\u0639 02 ...",noData:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a \u0645\u062c\u0645\u062f\u0629. \u0642\u062f \u0644\u0627 \u062a\u062f\u0639\u0645 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629.",error:"\u062e\u0637\u0623 \u0641\u064a \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a",values:" \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u0648\u0642\u062a \u0627\u0644\u0641\u0634\u0644",retry:"\u0627\u0642\u0631\u0623 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649",techInfo:"\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0641\u0646\u064a\u0629",techDesc:"\u2022 \u0648\u0636\u0639 obd-ii 02: \u062a\u062c\u0645\u064a\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0625\u0637\u0627\u0631 \u2022 PID 020C00: \u0639\u062f\u062f \u0627\u0644\u062f\u0648\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 \u0639\u0646\u062f \u0627\u0644\u062e\u0637\u0623 \u2022 PID 020D00: \u0627\u0644\u0633\u0631\u0639\u0629 \u0639\u0646\u062f \u0627\u0644\u062e\u0637\u0623 \u2022 PID 020500: \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0645\u0627\u0621 \u0627\u0644\u062a\u0628\u0631\u064a\u062f \u0648\u0642\u062a \u062d\u062f\u0648\u062b \u0627\u0644\u0639\u0637\u0644 \u062a\u0646\u062a\u0645\u064a \u0647\u0630\u0647 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0625\u0644\u0649 \u0631\u0645\u0632 \u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0623\u062e\u064a\u0631. \u0639\u0646\u062f\u0645\u0627 \u064a\u062a\u0645 \u0645\u0633\u062d \u0631\u0645\u0648\u0632 \u0627\u0644\u062e\u0637\u0623\u060c \u064a\u062a\u0645 \u0623\u064a\u0636\u064b\u0627 \u0645\u0633\u062d \u0628\u064a\u0627\u0646\u0627\u062a \u0625\u0637\u0627\u0631 \u0627\u0644\u062a\u062c\u0645\u064a\u062f.",throttle:"Throttle",mapPressure:"Map Pressure",stft:"Stft",trimUnit:"Trim Unit"},perf:{title:"\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0623\u062f\u0627\u0621",seconds:"\u062b\u0648\u0627\u0646\u064a",speed:"\u0643\u0645/\u0633\u0627\u0639\u0629",idle:"\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0632\u0631 \u0648\u0627\u0633\u062a\u0639\u062f \u0644\u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0625\u062c\u0631\u0627\u0621.",ready:"\u0645\u0633\u062a\u0639\u062f! \u0627\u0644\u0628\u062f\u0621 \u0628\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629...",readyDesc:"\u064a\u0628\u062f\u0623 \u0627\u0644\u0639\u062f\u0627\u062f \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0627\u0644\u0633\u0631\u0639\u0629 > 0.",measuring:"\u062c\u0627\u0631\u064d \u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0642\u064a\u0627\u0633...",done:"\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631",start:"\u0627\u0628\u062f\u0623 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631",stop:"\u062a\u0648\u0642\u0641",reset:"\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646",howItWorks:"\u0643\u064a\u0641 \u064a\u0639\u0645\u0644\u061f",howDesc:"1. \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \"\u0628\u062f\u0621 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\". 2. \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u062b\u0627\u0628\u062a\u0629 (\u0627\u0644\u0633\u0631\u0639\u0629 = 0) 3. \u064a\u0628\u062f\u0623 Chrono \u0639\u0646\u062f\u0645\u0627 \u062a\u0628\u062f\u0623 \u0641\u064a \u0627\u0644\u062a\u062d\u0631\u0643 4. \u064a\u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0628\u0633\u0631\u0639\u0629 60 \u0643\u0645/\u0633\u0627\u0639\u0629 \u0648100 \u0643\u0645/\u0633\u0627\u0639\u0629 \u0642\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631 \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0622\u0645\u0646\u0629!",sec:"\u062b\u0627\u0646\u064a\u0629"},dtc:{P0102:"\u0645\u0633\u062a\u0634\u0639\u0631 \u062a\u062f\u0641\u0642 \u0627\u0644\u0647\u0648\u0627\u0621 (MAF) - \u0645\u062f\u062e\u0644\u0627\u062a \u0645\u0646\u062e\u0641\u0636\u0629",P0113:"\u0645\u0633\u062a\u0634\u0639\u0631 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0647\u0648\u0627\u0621 \u0627\u0644\u062f\u0627\u062e\u0644 - \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a",P0171:"\u0646\u0638\u0627\u0645 \u0627\u0644\u0648\u0642\u0648\u062f \u0645\u0646\u062e\u0641\u0636 (\u0627\u0644\u0635\u0641 1)",P0300:"\u062e\u0637\u0623 \u0641\u064a \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0623\u0633\u0637\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0639\u0634\u0648\u0627\u0626\u064a\u0629/\u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629",P0420:"\u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u062d\u0648\u0644 \u0627\u0644\u062d\u0641\u0627\u0632 (B1) - \u0643\u0641\u0627\u0621\u0629 \u0645\u0646\u062e\u0641\u0636\u0629",P0700:"\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 - \u0639\u0637\u0644",P0715:"\u0645\u0633\u062a\u0634\u0639\u0631 \u0633\u0631\u0639\u0629 \u0627\u0644\u062a\u0648\u0631\u0628\u064a\u0646 - \u0639\u0637\u0644 \u0641\u064a \u0627\u0644\u062f\u0627\u0626\u0631\u0629",P0560:"\u062c\u0647\u062f \u0627\u0644\u0646\u0638\u0627\u0645 - \u0639\u0637\u0644",P0562:"\u062c\u0647\u062f \u0627\u0644\u0646\u0638\u0627\u0645 - \u0645\u0646\u062e\u0641\u0636",U0100:"\u0641\u0642\u062f\u0627\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0643 (ECM/PCM)",U0121:"\u062a\u0645 \u0641\u0642\u062f\u0627\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0648\u062d\u062f\u0629 \u0646\u0638\u0627\u0645 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0645\u0627\u0646\u0639\u0629 \u0644\u0644\u0627\u0646\u063a\u0644\u0627\u0642 (ABS).",C0035:"\u0639\u0637\u0644 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u0645\u0633\u062a\u0634\u0639\u0631 \u0633\u0631\u0639\u0629 \u0627\u0644\u0639\u062c\u0644\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u064a\u0633\u0631\u0649",B0001:"\u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0646\u0634\u0631 \u0644\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0644\u0644\u0633\u0627\u0626\u0642",P0750:"\u062a\u062d\u0648\u0644 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0644\u0648\u0644\u0628\u064a \u0639\u0637\u0644",P0814:"\u0639\u0637\u0644 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u0639\u0631\u0636 \u0646\u0637\u0627\u0642 \u0627\u0644\u0625\u0631\u0633\u0627\u0644",U0140:"\u0641\u0642\u062f\u0627\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062c\u0633\u0645 (BCM)",C0040:"\u0639\u0637\u0644 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u062d\u0633\u0627\u0633 \u0633\u0631\u0639\u0629 \u0627\u0644\u0639\u062c\u0644\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u064a\u0645\u0646\u0649",C0110:"\u0639\u0637\u0644 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u0645\u062d\u0631\u0643 \u0645\u0636\u062e\u0629 ABS",C0121:"\u0639\u0637\u0644 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u062d\u0633\u0627\u0633 \u0636\u063a\u0637 \u0627\u0644\u0641\u0631\u0627\u0645\u0644",B0010:"\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0646\u0634\u0631 \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0644\u0631\u0627\u0643\u0628 \u0627\u0644\u0623\u0645\u0627\u0645\u064a",B0020:"\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0646\u0634\u0631 \u0627\u0644\u0648\u0633\u0627\u062f\u0629 \u0627\u0644\u0647\u0648\u0627\u0626\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u064a\u0633\u0631",B1000:"\u062e\u0637\u0623 \u0641\u064a \u0623\u062c\u0647\u0632\u0629 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062c\u0633\u0645 (BCM).",B1325:"\u062f\u0627\u0626\u0631\u0629 \u0625\u0645\u062f\u0627\u062f \u0627\u0644\u0637\u0627\u0642\u0629 \u0628\u0627\u0644\u062c\u0647\u0627\u0632 \u0630\u0627\u062a \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0645\u0646\u062e\u0641\u0636",generalFault:"General Fault"},vehicleSelect:{title:"\u0627\u062e\u062a\u0631 \u0633\u064a\u0627\u0631\u062a\u0643 \u0644\u0632\u064a\u0627\u062f\u0629 \u062f\u0642\u0629 \u0627\u0644\u062a\u0634\u062e\u064a\u0635",subtitle:"\u064a\u0631\u062c\u0649 \u062a\u0642\u062f\u064a\u0645 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u062f\u0642\u064a\u0642 \u0648\u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644.",brand:"\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629",selectBrand:"\u0627\u062e\u062a\u0631 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629...",searchBrand:"\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629...",customBrandPlaceholder:"\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644: \u062a\u0631\u064a\u0648\u0645\u0641\u060c \u0633\u064a \u0627\u0641 \u0645\u0648\u062a\u0648\u060c \u0643\u064a\u0627...",model:"\u0646\u0645\u0648\u0630\u062c",selectModel:"\u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0648\u062f\u064a\u0644...",searchModel:"\u0628\u062d\u062b \u0646\u0645\u0648\u0630\u062c\u064a...",customModelPlaceholder:"\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644: CBR600\u060c \u062c\u0648\u0644\u0641\u060c \u0641\u0648\u0643\u0633...",year:"\u0633\u0646\u0629 \u0627\u0644\u0645\u0648\u062f\u064a\u0644",selectYear:"\u0627\u062e\u062a\u0631 \u0627\u0644\u0633\u0646\u0629...",customYearPlaceholder:"\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644: 2018",disconnect:"\u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644",confirm:"\u0645\u062a\u0627\u0628\u0639\u0629",errorBrand:"\u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u062d\u062f\u064a\u062f \u0623\u0648 \u0625\u062f\u062e\u0627\u0644 \u0639\u0644\u0627\u0645\u0629 \u062a\u062c\u0627\u0631\u064a\u0629.",errorModel:"\u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u062d\u062f\u064a\u062f \u0623\u0648 \u0625\u062f\u062e\u0627\u0644 \u0646\u0645\u0648\u0630\u062c.",errorYear:"\u064a\u0631\u062c\u0649 \u062a\u062d\u062f\u064a\u062f \u0623\u0648 \u0625\u062f\u062e\u0627\u0644 \u0633\u0