\u043b\u044c\u043d\u043e\u0433\u043e \u0442\u043e\u043a\u0430 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0433\u043e \u0437\u0430\u0440\u044f\u0434\u043d\u043e\u0433\u043e \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u043e\u043a\u0430 (6\u201332 \u0410)",desc:"\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0442\u0435\u043b\u044c \u0442\u043e\u043a\u0430 \u0437\u0430\u0440\u044f\u0434\u043a\u0438 \u0434\u043e\u043c\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u043e\u043a\u0430 (6\u0410/10\u0410/16\u0410/32\u0410) \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043a\u0438 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0439 \u0441\u0435\u0442\u0438."},toyota_hybrid_ev_mode_override:{name:"\u041f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 Toyota/Lexus EV",desc:"\u041f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0437\u0430\u043f\u0443\u0441\u043a \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f, \u043a\u043e\u0433\u0434\u0430 \u043a\u043d\u043e\u043f\u043a\u0430 \u0440\u0435\u0436\u0438\u043c\u0430 EV \u0430\u043a\u0442\u0438\u0432\u043d\u0430."},toyota_hybrid_battery_fan_speed_boost:{name:"\u0423\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0430 \u043e\u0445\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u044b\u0441\u043e\u043a\u043e\u0432\u043e\u043b\u044c\u0442\u043d\u043e\u0439 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u043d\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 Toyota/Lexus (+30%)",desc:"\u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0430 \u043e\u0445\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u044f \u0433\u0438\u0431\u0440\u0438\u0434\u043d\u043e\u0439 \u0442\u044f\u0433\u043e\u0432\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u043d\u0430 +30% \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0442\u0435\u0440\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0438\u0438 \u0432 \u0436\u0430\u0440\u043a\u043e\u043c \u043a\u043b\u0438\u043c\u0430\u0442\u0435."},tesla_sentry_high_bitrate_video:{name:"\u0420\u0435\u0436\u0438\u043c Tesla Sentry \u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c \u0441 \u0432\u0438\u0434\u0435\u043e\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430 \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0431\u0438\u0442\u0440\u0435\u0439\u0442\u043e\u043c",desc:"\u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u0438\u0442\u0440\u0435\u0439\u0442 \u0432\u0438\u0434\u0435\u043e\u0437\u0430\u043f\u0438\u0441\u0438 \u043a\u0430\u043c\u0435\u0440\u044b \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043e\u0445\u0440\u0430\u043d\u044b \u0434\u043b\u044f \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e \u0447\u0435\u0442\u043a\u043e\u0439 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u043a\u0430."},tesla_cabin_overheat_threshold_30c:{name:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0439 \u043f\u043e\u0440\u043e\u0433 \u0437\u0430\u0449\u0438\u0442\u044b \u043a\u0430\u0431\u0438\u043d\u044b Tesla \u043e\u0442 \u043f\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0430 (30\xb0C)",desc:"\u0421\u043d\u0438\u0436\u0430\u0435\u0442 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0441\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u044f \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b \u043a\u0430\u0431\u0438\u043d\u044b \u043e\u0442 \u043f\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0430 \u0441 40\xb0C \u0434\u043e 30\xb0C \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0446\u0438\u0438 \u0441\u0430\u043b\u043e\u043d\u0430."},bmwmotorrad_quickshifter_pro_readapt:{name:"\u0420\u0435\u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u044f Shift Assistant Pro",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u0443\u044e \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0443 \u043a\u0432\u0438\u043a\u0448\u0438\u0444\u0442\u0435\u0440\u0430."},bmwmotorrad_esa_zero_point_calib:{name:"\u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0434\u0432\u0435\u0441\u043a\u0438 ESA",desc:"\u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0445 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u0432 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0438 \u0445\u043e\u0434\u0430 \u043f\u043e\u0434\u0432\u0435\u0441\u043a\u0438 \u0434\u043e \u0437\u0430\u0432\u043e\u0434\u0441\u043a\u043e\u0433\u043e \u043d\u0443\u043b\u044f."},bmwmotorrad_abs_pro_cornering_toggle:{name:"\u041f\u043e\u0440\u043e\u0433 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 ABS Pro",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 ABS \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0443\u0433\u043b\u0430 \u043d\u0430\u043a\u043b\u043e\u043d\u0430 \u0434\u043b\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0430 \u0433\u0443\u0441\u0435\u043d\u0438\u0446\u0430\u0445."},bmwmotorrad_service_interval_reset:{name:"\u0421\u0431\u0440\u043e\u0441 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439 \u043e \u0435\u0436\u0435\u0433\u043e\u0434\u043d\u043e\u043c \u0438 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0438",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432 \u0438 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b."},bmwmotorrad_headlight_pro_cornering:{name:"\u0410\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u0430\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432 Headlight Pro",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u0443\u0433\u043b\u0430 \u043d\u0430\u043a\u043b\u043e\u043d\u0430 \u0434\u043b\u044f \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0444\u0430\u0440 \u043f\u0440\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u0445."},bmwmotorrad_keyless_ride_range_extend:{name:"\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0431\u0440\u0435\u043b\u043e\u043a\u0430 Keyless Ride",desc:"\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u043d\u0434\u0435\u0440\u0430 \u0434\u043b\u044f \u0431\u0435\u0441\u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0433\u043e \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0438\u044f \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},bmwmotorrad_reverse_assist_sensitivity:{name:"\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u0441\u0438\u043b\u0438\u0442\u0435\u043b\u044f \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0445\u043e\u0434\u043