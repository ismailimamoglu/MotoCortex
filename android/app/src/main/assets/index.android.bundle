930 \u0926\u0940 \u091c\u093e\u090f\u0964 \u0928\u0935\u0940\u0928\u0940\u0915\u0930\u0923 \u0936\u0941\u0932\u094d\u0915 \u0906\u092a\u0915\u0947 Google \u0916\u093e\u0924\u0947 \u0938\u0947 \u0932\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0905\u0935\u0927\u093f \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902 \u0938\u0926\u0938\u094d\u092f\u0924\u093e\u090f\u0901 \u0928\u0935\u0940\u0928\u0940\u0915\u0943\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u0906\u092a \u0907\u0928\u094d\u0939\u0947\u0902 \u0905\u092a\u0928\u0940 \u0916\u093e\u0924\u093e \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0902 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902.",noPurchasesMsgAndroid:"\u0906\u092a\u0915\u0947 Google \u0916\u093e\u0924\u0947 \u0938\u0947 \u0938\u0902\u092c\u0926\u094d\u0927 \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f PRO \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0928\u0939\u0940\u0902 \u092a\u093e\u0908 \u0917\u0908\u0964",terms:"\u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902",privacy:"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f",hardwareWarning:" \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0928\u094b\u091f: Apple \u0915\u093e\u0928\u0942\u0928\u0940 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923, iOS \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0941\u0930\u093e\u0928\u0940 \u092a\u0940\u0922\u093c\u0940 \u0915\u0947 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0915\u094d\u0932\u093e\u0938\u093f\u0915 (v2.1) \u090f\u0921\u0947\u092a\u094d\u091f\u0930 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0910\u092a \u0915\u094b PRO \u092e\u094b\u0921 \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947, \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 LE (4.0+) \u092f\u093e \u0935\u093e\u0908-\u092b\u093e\u0908 \u0938\u0902\u0917\u0924 \u0939\u0948\u0964",hardwareWarningAndroid:" \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0928\u094b\u091f: \u090f\u0902\u0921\u094d\u0930\u0949\u0907\u0921 \u0921\u093f\u0935\u093e\u0907\u0938 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0915\u094d\u0932\u093e\u0938\u093f\u0915 \u0914\u0930 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 LE (4.0+) \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0926\u094b\u0928\u094b\u0902 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 PRO \u092e\u094b\u0921 \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0902\u0917\u0924 \u0939\u0948\u0964",errorTitle:"\u0909\u0924\u094d\u092a\u093e\u0926 \u0932\u094b\u0921 \u0939\u094b\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932",errorDesc:"\u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u094b \u0932\u094b\u0921 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u090f\u0915 \u0924\u094d\u0930\u0941\u091f\u093f \u0939\u0941\u0908, \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a\u0947\u0902 \u0914\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",retryBtn:"\u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902",loadingPrices:"\u0915\u0940\u092e\u0924\u0947\u0902 \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u0902...",contextualDesc:"\u092a\u0942\u0930\u094d\u0923 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923, \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0907\u0902\u091c\u0928 \u091c\u094b\u0916\u093f\u092e, \u092e\u0930\u092e\u094d\u092e\u0924 \u0932\u093e\u0917\u0924 \u0905\u0928\u0941\u092e\u093e\u0928 \u0914\u0930 \u0907\u0938 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u094b\u0921 \u0915\u0947 \u0932\u093f\u090f \u091a\u0930\u0923-\u0926\u0930-\u091a\u0930\u0923 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0913\u092c\u0940\u0921\u09402 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u094d\u0915\u0948\u0928\u0930 \u092a\u094d\u0930\u094b \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902\u0964",actionLocked:"\u092a\u094d\u0930\u094b \u0932\u0949\u0915 \u0938\u0941\u0935\u093f\u0927\u093e",congratsMsg:"\u0906\u092a\u0915\u0940 Cortex OBD2 PRO \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b \u0917\u0908 \u0939\u0948\u0964 \u0938\u092d\u0940 \u092a\u0947\u0936\u0947\u0935\u0930 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947\u0902!",congratsTitle:"\u092c\u0927\u093e\u0908 \u0939\u094b!",errMsg:"\u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u090f\u0915 \u0924\u094d\u0930\u0941\u091f\u093f \u0939\u0941\u0908. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928: \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",errTitle:" \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0935\u093f\u092b\u0932",monthlyNotice:"\u092e\u093e\u0938\u093f\u0915 \u0938\u094d\u0935\u0924\u0903-\u0928\u0935\u0940\u0915\u0930\u0923\u0940\u092f \u0938\u0926\u0938\u094d\u092f\u0924\u093e",noPkgMsg:"\u0915\u0943\u092a\u092f\u093e \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092a\u0948\u0915\u0947\u091c \u091a\u0941\u0928\u0947\u0902\u0964",noPkgTitle:" \u0915\u094b\u0908 \u092a\u0948\u0915\u0947\u091c \u091a\u092f\u0928\u093f\u0924 \u0928\u0939\u0940\u0902",noPurchasesMsg:"\u0906\u092a\u0915\u0947 Apple \u0916\u093e\u0924\u0947 \u0938\u0947 \u0938\u0902\u092c\u0926\u094d\u0927 \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f PRO \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964",noPurchasesTitle:"\u2139 \u0915\u094b\u0908 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940",proRequiredDesc:"\u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f PRO \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",proRequiredTitle:"\u092a\u0940\u0906\u0930\u0913 \u0906\u0935\u0936\u094d\u092f\u0915",purchasingText:"\u0932\u0947\u0928-\u0926\u0947\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",restoreErrorMsg:"\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0902\u091a\u0947\u0902 \u0914\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",restoreErrorTitle:" \u0924\u094d\u0930\u0941\u091f\u093f \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",restoreSuccessMsg:"\u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092c\u0939\u093e\u0932 \u0915\u0930 \u0926\u0940 \u0917\u0908! \u0905\u092c \u0906\u092a Cortex OBD2 PRO \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0936\u0941\u0930\u0942 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",restoreSuccessTitle:" \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u092c\u0939\u093e\u0932",weeklyNotice:"\u090f\u0915 \u092c\u093e\u0930 \u0915\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u0940, \u0938\u094d\u0935\u0924: \u0928\u0935\u0940\u0928\u0940\u0915\u0930\u0923 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940",yearlyNotice:"\u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0938\u094d\u0935\u0924\u0903-\u0928\u0935\u0940\u0915\u0930\u0923\u0940\u092f \u0938\u0926\u0938\u094d\u092f\u0924\u093e",aiDoctorLimitTitle:"\u090f\u0906\u0908 \u0921\u0949\u0915\u094d\u091f\u0930 \u0938\u0940\u092e\u093e \u0938\u092e\u093e\u092a\u094d\u0924",aiDoctorLimitDesc:"\u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0947 1 \u092e\u0941\u092b\u093c\u094d\u0924 \u090f\u0906\u0908 \u0907\u0902\u091c\u0928 \u0928\u093f\u0926\u093e\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948\u0964 \u0905\u0938\u0940\u092e\u093f\u0924 \u090f\u0906\u0908 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0947 \u0932\u093f\u090f PRO \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902\u0964"},connection:{logoSub:"v7\u092a\u094d\u0930\u094b",adapter:"\u090f\u0921\u093e\u092a\u094d\u091f\u0930",ecu:"\u0908\u0938\u0940\u092f\u0942",online:"\u0911\u0928\u0932\u093e\u0907\u0928",offline:"\u0911\u092b\u093c\u0932\u093e\u0907\u0928",connecting:"\u091c\u0941\u0921\u093c\u0928\u093e",scanDevices:"\u0921\u093f\u0935\u093e\u0907\u0938 \u0916\u094b\u091c\u0947\u0902",connectLast:"\u0905\u0902\u0924\u093f\u092e \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902",enableBt:"\u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902",scanning:"\u0938\u094d\u0915\u0948\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",foundDevices:"\u092e\u093f\u0932\u0947 OBD2 \u0921\u093f\u0935\u093e\u0907\u0938",unknownDevice:"\u0905\u091c\u094d\u091e\u093e\u0924 \u0909\u092a\u0915\u0930\u0923",scanHint:"\u092f\u0941\u0917\u094d\u092e\u093f\u0924 OBD \u0921\u093f\u0935\u093e\u0907\u0938 \u0922\u0942\u0902\u0922\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902\u0964",ecuWait:"\u0908\u0938\u0940\u092f\u0942 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b \u0930\u0939\u093e \u0939\u0948...",ecuNoResponse:"\u0908\u0938\u0940\u092f\u0942 \u091c\u0935\u093e\u092c \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e. \u0907\u0917\u094d\u0928\u093f\u0936\u0928 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902.",retry:"\u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902",disconnect:"\u0921\u093f\u0938\u094d\u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902",disconnectShort:"\u0921\u093f\u0938\u094d\u0915.",connectLabel:"\u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902",error:"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0924\u094d\u0930\u0941\u091f\u093f",bluetoothOffDesc:"\u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u092c\u0902\u0926 \u0939\u0948. \u0915\u0943\u092a\u092f\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964",permissionDesc:"\u092c\u094d\u093