rom dropping back to Level 3 after shifting to Reverse."},hyundai_utility_mode_12v_saver:{name:"Utility Camping Mode High-Voltage 12V Saver",desc:"Powers 220V V2L outlet directly from HV traction battery to prevent auxiliary 12V battery drain."},hyundai_phev_no_ice_climate_start:{name:"PHEV EV Mode Climate Heating Gasoline Engine Suppression",desc:"Forces heat pump / PTC electric heater for cabin climate without starting gasoline engine."},vag_taycan_ess_sound_profile_swap:{name:"Electric Sport Sound Taycan / RS e-tron Profile",desc:"Changes electric driving sound profile to Porsche Taycan GTS or Audi RS e-tron GT sound generator."},vag_meb_daily_charge_target_menu:{name:"MEB Battery Daily 80% / Trip 100% Quick Charge Bar",desc:"Adds quick toggle bar on MIB screen to switch between 80% daily battery care and 100% trip charge."},vag_gte_generator_charge_reserve:{name:"GTE / E-Mode Engine Generator Battery Force Charge",desc:"Forces combustion engine to act as generator to recharge high-voltage battery up to 80% while driving."},bmw_hans_zimmer_iconic_sounds_m:{name:"Hans Zimmer IconicSounds Electric M-Performance Sound Engine",desc:"Unlocks Hans Zimmer acoustic M-Performance electric acceleration sound profiles on i4 and iX."},bmw_phev_max_edrive_140kmh:{name:"PHEV MAX eDrive Pure Electric Speed Ceiling",desc:"Increases max pure electric speed ceiling on 330e / 530e Plug-in hybrids to 140 km/h."},bmw_ac_charging_current_limit_menu:{name:"AC Home Charger Maximum Current Limit Selector",desc:"Adds AC home charging current limiter to prevent home circuit overload."},toyota_hybrid_ev_mode_override:{name:"Toyota / Lexus EV Mode Throttle Override Suppression",desc:"Prevents gasoline engine from forced start during acceleration when EV mode button is active."},toyota_hybrid_battery_fan_speed_boost:{name:"Toyota / Lexus High-Voltage Battery Cooling Fan Boost",desc:"Increases hybrid traction battery cooling fan speed by +30% to prevent thermal degradation in hot climates."},t