m/u."},byd_ev_battery_preheat_manual_switch:{name:"Handmatige EV-batterijvoorverwarmschakelaar",desc:"Maakt handmatige thermische conditionering van de batterij mogelijk voorafgaand aan snelladen met gelijkstroom."},byd_v2l_220v_outlet_power_expansion:{name:"V2L (voertuig-naar-lading) 220V stopcontactuitbreiding (3,6 kW)",desc:"Breidt het externe V2L-afvoervermogensplafond uit van 2,2 kW naar maximaal 3,6 kW."},byd_one_pedal_regen_default_max:{name:"Aandrijving met \xe9\xe9n pedaal Regeneratief remmen Standaard Max",desc:"Vergrendelt hoog-regeneratief remmen als permanente standaard bij het opstarten van het voertuig."},mg_ismart_connectivity_unlock:{name:"i-SMART-connectiviteit en telemetrie-ontgrendeling op afstand",desc:"Maakt klimaatregeling op afstand en tracking van de voertuigstatus mogelijk."},mg_mg4_xpower_launch_control_enable:{name:"MG4 XPower Launch Control-modus met dubbele motor",desc:"Ontgrendelt de acceleratiemodus van 0-100 km/u in 3,8 seconden."},mg_battery_preheat_manual_trigger:{name:"Handmatige snellaadvoorconditionering van de batterij",desc:"Zorgt ervoor dat de verwarmingselementen van de hoogspanningsaccu AAN staan \u200b\u200bvoor maximale DC-laadsnelheden."},xpeng_xngp_adas_region_unlock:{name:"XNGP Autonoom Rijden Assistent Regioontgrendeling",desc:"Maakt geavanceerde navigatiegestuurde pilootassistentie mogelijk in ontgrendelde regio's."},xpeng_ambient_lighting_music_sync:{name:"Muziek-reactieve ritme sfeerverlichting",desc:"Synchroniseert de LED-sfeerverlichtingspulsen in de cabine met de basbeats van het audiosysteem."},xpeng_rear_camera_trailer_hitch_view:{name:"360\xb0 camerakoppeling en grondoverlay-modus",desc:"Voegt een hoge-resolutie-overlay voor het uitlijnen van de trekhaak toe aan de achteruitrijcamera."},nio_battery_swap_interval_reminder:{name:"Power Swap Station Pre-Conditioning-modus",desc:"Verlaagt automatisch de batterijvergrendelingspinnen en conditioneert pakketten voorafgaand aan het verwisselen."},nio_nomi_assistant_custom_voice_phrases:{name:"NOMI AI Companion-personalisatie en wake-words",desc:"Ontgrendelt aangepaste avatar-animaties en gepersonaliseerde begroetingszinnen voor NOMI."},nio_sentry_watchdog_continuous_recording:{name:"NIO Sentry-modus 4K-camerabufferopname",desc:"Maakt opname van de surroundcamera met hoge bitsnelheid op een USB-station mogelijk wanneer geparkeerd."},xiaomi_su7_hyperos_driver_profile_sync:{name:"Xiaomi SU7 HyperOS stuurprogrammaprofiel Ecosysteemsynchronisatie",desc:"Synchroniseert stoel-, spiegel- en klimaatinstellingen automatisch via Xiaomi-telefoon Bluetooth."},xiaomi_su7_boost_mode_throttle_curve:{name:"Boost-modus 20 seconden overboost Power-ontgrendeling",desc:"Verlengt de maximale overboostduur van de elektromotor tijdens acceleratie op volle snelheid."},xiaomi_su7_drift_mode_torque_vectoring:{name:"Drift-modus RWD Torque Vectoring-toewijzing",desc:"Wijst 100% motorkoppel toe aan de achteras als de tractiecontrole is uitgeschakeld."},chery_isa_overspeed_warning_chime_off:{name:"ISA Intelligent Speed Assist-waarschuwingssignaal dempen",desc:"Schakelt het aanhoudende akoestische geluidssignaal uit bij het overschrijden van de gedetecteerde snelheidslimiet."},chery_driver_monitoring_camera_sensitivity:{name:"DMS-stuurprogramma Vermoeidheid Monitoring Cameragevoeligheid",desc:"Vermindert vals-positieve afleidingswaarschuwingen van de bewakingscamera aan de binnenkant."},retrofit_parking_sensor_coding:{name:"Retrofit codering voor parkeerafstandscontrole (PDC) voor/achter",desc:"Registreert aftermarket- of OEM-parkeersensormodule in de Gateway-installatielijst."},retrofit_360_camera_activation:{name:"Retrofit surroundcamerasysteem met 360\xb0 omgevingszicht",desc:"Activeert de cameracontroller voor surroundweergave en voegt cameraweergave toe aan infotainment."},retrofit_led_license_plate_light_coding:{name:"Retrofit LED-kentekenplaat- en achterlichtfout Annuleren",desc:"Schakelt de controle van koude lampen uit om valse waarschuwingen voor lamp uit te voorkomen met LED's."},retrofit_dash_cam_sentry_integration:{name:"Retrofit dashcam met continu ontstekingsvermogen en Sentry-modus",desc:"Configureert de voedingslijn van terminal 30 van de Body Control Module voor continue parkeeropname."},retrofit_heated_windshield_activation:{name:"Retrofit verwarmde voorruitelementcodering",desc:"Schakelt de relaisuitgang van de voorruitontdooiverwarming en de climatronic-schermknop in."},retrofit_wireless_charger_module_coding:{name:"Retrofit Qi draadloze smartphone-oplaadpad-integratie",desc:"Schakelt de status-LED van de draadloze oplader en de herinneringspop-up voor achtergelaten telefoon in."},retrofit_acc_radar_module_coding:{name:"Retrofit adaptieve cruisecontrol (ACC) radarmodule vooraan",desc:"Codeert de achteraf ingebouwde afstandsradareenheid in het CAN-busvoertuignetwerk."},retrofit_traffic_sign_camera_activation:{name:"Retrofit verkeersbordherkenning voorruitcameracodering",desc:"Maakt verwerking van VZE-tekenherkenning mogelijk op een achteraf ge\xefnstalleerde voorruitcamera."},retrofit_heated_steering_wheel_coding:{name:"Retrofit activering van verwarmde stuurwielmodule",desc:"Maakt uitvoer van het stuurwielverwarmingselement en automatische temperatuurtriggers mogelijk."},retrofit_fatigue_camera_calibration:{name:"Retrofit vermoeidheidsbewaking van de bestuurder Camera-integratie",desc:"Kalibreert de infraroodcamerasensor voor bestuurdersbewaking na installatie van de stuurkolom."},retrofit_trailer_hitch_module_coding:{name:"Retrofit-integratie van elektrische module voor trekhaak en aanhangwagen",desc:"Codeert de trailermodule in het ESP-stabiliteitssysteem om het slingeren van de trailer te beperken."},retrofit_power_tailgate_trunk_kit_coding:{name:"Retrofit elektrische achterklep en integratie van voetgebaarsensoren",desc:"Maakt elektrische kofferbakaandrijfmotoren en codering van de bumperschopsensor mogelijk."},easteregg_urban_joke_light_show:{name:"Urban Joke afwisselende achterlichtshow",desc:"Configureert de achterlichten en richtingaanwijzers om afwisselend te knipperen bij het vergrendelen van het voertuig."},easteregg_custom_boot_greeting_text:{name:"Aangepaste opstartbegroetingstekst op digitaal cluster",desc:"Geeft een aangepast welkomstbericht weer op het instrumentenpaneel wanneer het contact wordt aangezet."},easteregg_cluster_mini_game_mode:{name:"Instrumentenpaneel Verborgen minigamemenu",desc:"Ontgrendelt een retro-minigame met stuurknoppen die wordt weergegeven wanneer deze is geparkeerd."},easteregg_custom_horn_melody_package:{name:"Aangepaste akoestische hoorn welkomstmelodie",desc:"Speelt een kort ritmisch pieppatroon af op de claxon bij het ontgrendelen van de auto."},easteregg_welcome_lighting_door_sequence:{name:"Chasing LED-welkomstlicht Deurvolgorde",desc:"Voert progressieve LED-achtervolgingsanimatie uit op buitendeurgrepen."},easteregg_developer_service_menu_shortcut:{name:"Ontwikkelaars- en servicediagnoseschermsnelkoppeling",desc:"Maakt snelle gebarensnelkoppeling mogelijk voor toegang tot verborgen technische diagnoseschermen."},easteregg_seasonal_cluster_theme_effect:{name:"Seizoensgebonden weerclusterthema-overlay (sneeuwvlok/regen)",desc:"Voegt een geanimeerde sneeuwvlok- of regendeeltjesachtergrond toe om de cluster in de winter te meten."},easteregg_valet_mode_prank_warning_message:{name:"Valetmodus Prank Snelheidslimiet pop-upwaarschuwing",desc:"Geeft humoristisch een strikt waarschuwingsbericht weer op het dashboard als de valetmodus wordt overschreden."},adas_lane_keep_assist_gentle_curve:{name:"Lane Keep Assist (LKA) Zachte stuurinterventiecurve",desc:"Verzacht plotselinge stuurbewegingen door progressieve koppelinterventie toe te passen."},adas_lka_last_state_memory_mode:{name:"Lane Keep Assist Laatste status Memory Lock",desc:"Voorkomt dat de LKA automatisch weer wordt ingeschakeld telkens wanneer het contact opnieuw wordt gestart."},adas_acc_default_follow_distance:{name:"Adaptieve cruisecontrol (ACC) Standaard afstandsvoorinstelling",desc:"Stelt de standaardafstandsinstelling in (1 tot 4 bar) wanneer ACC wordt ingeschakeld."},adas_acc_speed_step_adjustment:{name:"ACC-stapkeuzeschakelaar voor kruissnelheid (+5 / +10 km/u)",desc:"Verandert de snelheidsknop op het stuur kort indrukken van 1 km/u naar 5 km/u."},adas_matrix_led_glare_free_high_beam_unlock:{name:"Matrix LED-verblindingsvrij adaptief verblindingsscherm voor grootlicht",desc:"Ontgrendelt adaptief grootlicht volgens Europese specificaties op Noord-Amerikaanse auto's."},adas_traffic_jam_assist_follow_fine_tune:{name:"Traffic Jam Assist Stop-and-Go-hervattingsvertraging",desc:"Verlengt het automatische stop-en-go-herstartvenster van 3 seconden naar 15 seconden."},adas_rear_radar_blind_spot_zero_point_reset:{name:"Dodehoekradar achteraan Nulpunthoekkalibratie",desc:"Kalibreert de azimuthoek van de achterbumperradar opnieuw na verwijdering of reparatie van de bumper."},adas_surround_camera_stitching_recalib:{name:"Surround View-camera Dynamische beeldstitching-uitlijning",desc:"Voert dynamische kalibratie van camerabeelden uit tijdens het rijden op de weg."},adas_steering_angle_sensor_zero_point_reset:{name:"Stuurhoeksensor (SAS) Nulpuntkalibratie",desc:"Zet de stuurmiddenhoek terug op 0,0\xb0 na de wieluitlijningsservice."},adas_cross_traffic_alert_sensitivity_adjust:{name:"Detectiebereik voor Cross-Traffic Alert (RCTA) achteraan",desc:"Vergroot de zijradardetectieafstand voor naderende voertuigen terwijl ze achteruit rijden."},adas_aeb_emergency_braking_threshold_preview:{name:"Automatische noodremming (AEB) Waarschuwingseffectiviteit",desc:"Past de timing van vroege versus late waarschuwingssignalen aan voor waarschuwingen voor voorwaartse botsingen."},adas_night_vision_camera_alignment:{name:"Infrarood nachtzicht thermische camera Doeluitlijning",desc:"Start de verificatieprocedure voor de uitlijning van het infraroodcameravoetstuk."},adas_dms_driver_monitoring_ir_threshold:{name:"DMS-chauffeursaandacht Camera Infraroodgevoeligheid",desc:"Past de eye-trackingdrempel aan voor bestuurders die een donkere gepolariseerde zonnebril dragen."},toyota_soft_close_door_retrofit_coding:{name:"Power Soft-Close Deur Vacu\xfcm Actuator Codering",desc:"Maakt het mogelijk om elektrische deurgrendelintrekactuators in de carrosseriebedieningsmodule in te schakelen."},toyota_digital_speedometer_display_enable:{name:"Digitale snelheidsmeter, middenmeterdisplay",desc:"Voegt een grote digitale snelheidsaflezing toe aan het analoge LCD-instrumentenpaneel."},toyota_walk_away_auto_lock_sensitivity:{name:"Walk-Away Smart Key Gevoeligheid voor automatische deurvergrendeling",desc:"Past de afstandsdrempel aan voordat deuren automatisch vergrendelen wanneer u wegloopt."},toyota_jbl_3d_eq_audio_profile_unlock:{name:"JBL Premium Surround Sound Equalizer-curven",desc:"Ontgrendelt 3D-equalizerprofielen voor concertzalen in de JBL audiohoofdunit."},toyota_ev_mode_throttle_override_suppression:{name:"EV-modus Pure elektrische onderdrukking van gaspedaallimiet",desc:"Voorkomt dat de benzinemotor AAN slaat tijdens gematigde EV-acceleratie."},ford_sync3_engineering_diagnostics_page:{name:"SYNC3 / SYNC4 touchscreen technisch diagnosescherm",desc:"Maakt onbewerkte GPS-, APIM-test- en audiofrequentie-diagnostische schermen op SYNC mogelijk."},ford_rear_seat_entertainment_unlock:{name:"Achterbank HDMI / video-entertainment Audio-doorvoer",desc:"Maakt audiostreaming via hoofdtelefoons in de cabine mogelijk voor entertainmentschermen op de achterbank."},ford_bambi_mode_fog_light_expansion:{name:"Bambi-modus grootlicht + mistlamp gelijktijdige verlichting",desc:"Zorgt ervoor dat de mistlampen vooraan ingeschakeld blijven, zelfs als het grootlicht is ingeschakeld."},ford_auto_engine_idle_shutdown_30min_override:{name:"Automatische motoruitschakeling bij stationair draaien van 30 minuten uitgeschakeld",desc:"Voorkomt dat de motor automatisch wordt uitgeschakeld na 30 minuten parkeren."},hyundai_n_grin_shift_retrofit_enable:{name:"N Grin Shift (NGS) 20 seconden durende overboost-retrofit-ontgrendeling",desc:"Schakelt de overboostfunctie van de NGS-knop op het stuur in de ECU in."},hyundai_smart_tailgate_approach_distance:{name:"Slimme handsfree benadering van de achterklep. Nabijheidsdetectie",desc:"Past de sta-vertragingstijd aan (3s tot 1s) voordat de slimme achterklep automatisch opent."},hyundai_digital_cluster_n_performance_theme:{name:"N Performance digitale meterindeling van het instrumentenpaneel",desc:"Past de N-Performance rode schakelindicatorclusterindeling toe op het standaard LCD-dashboard."},stellantis_scr_adblue_warning_threshold_adjust:{name:"SCR AdBlue-waarschuwingsafstandsdrempelaanpassing",desc:"Past de waarschuwingsafstand voor de eerste AdBlue-bijvulherinnering aan van 2400 km tot 1000 km."},stellantis_jeep_trail_rated_offroad_pages:{name:"Jeep Uconnect Trail-rated offroad-telemetriepagina's",desc:"Ontgrendelt pagina's over pitch, roll, wielarticulatie en koelvloeistoftemperatuur van de aandrijflijn op Uconnect."},stellantis_peugeot_icockpit_3d_color_schemes:{name:"Peugeot 3D i-Cockpit aangepast kleurenpalet",desc:"Ontgrendelt de kleurenthema's Koper en Kwarts voor het 3D-holografische digitale instrumentenpaneel."},gm_super_cruise_follow_distance_adjust:{name:"Super Cruise Handsfree volgafstandscompensatie",desc:"Past de afstand tussen de ruimtes aan tijdens autonoom Super Cruise-rijden op de snelweg."},gm_instrument_hud_calibration_reset:{name:"Head-Up Display (HUD) Positie- en kantel-nulpuntkalibratie",desc:"Reset de beeldhoek van de HUD-projector op het windscherm en de horizonuitlijning op nulniveau."},gm_afm_v8_cylinder_lock_no_v4_drop:{name:"AFM / DFM-cilinderdeactivering opheffen (altijd V8-modus)",desc:"Schakelt het Active Fuel Management-cilinderdaling uit om de motor in de 8-cilindermodus te laten draaien."},dodge_ram_truck_fog_lights_with_high_beam:{name:"RAM Truck-mistlampen met grootlicht (High-Low-Fog Combo)",desc:"Voorkomt dat de mistlampen automatisch worden uitgeschakeld wanneer het grootlicht wordt ingeschakeld."},toyota_keyless_window_down:{name:"Toyota sleutelhangerraam open (ontgrendeling ingedrukt houden)",desc:"Rolt alle elektrisch bediende ruiten naar beneden wanneer u de UNLOCK-knop op de afstandsbediening ingedrukt houdt."},toyota_seatbelt_chime_disable:{name:"Toyota passagier veiligheidsgordel alarm dempen (parkeren/off-road)",desc:"Schakelt het aanhoudende akoestische waarschuwingssignaal van de veiligheidsgordel op de passagiersstoel uit."},honda_walkaway_auto_lock:{name:"Honda Walk-Away automatisch deurslot",desc:"Vergrendelt automatisch alle deuren wanneer de Smart Key een voertuigradius van 2,5 meter verlaat."},volvo_speed_limiter_unlock:{name:"Volvo 180 km/u Fabriekssnelheidsbegrenzer verlengd",desc:"Past de fabriekssnelheidslimiet van 180 km/u aan voor gebruik op het circuit/autobaan."},byd_v2l_3kw_power_unlock:{name:"BYD Vehicle-to-Load (V2L) 3,6 kW AC-uitgangsmodus",desc:"Maakt externe 220V/3,6kW V2L AC-ontladingspoort voor kampeerapparatuur mogelijk."},xiaomi_su7_drift_mode_unlock:{name:"Xiaomi SU7 Track Drift-modus en koppelvooroordeel aan de achterkant",desc:"Activeert 100% koppelvoorspanning van de achtermotor en ESC Track Drift-modus."},vag_oil_service_reset:{name:"Oil Change Service Reset (Flexible Interval)",desc:"Resets instrument cluster oil change interval counter to factory 15,000 km / 365 days."},vag_epb_service_mode:{name:"Elektronische parkeerrem (EPB) Servicemodus voor remblokken",desc:"Trekt de achterste EPB-remklauwzuigers in voor vervanging van het achterremblok en de rotor."},bmw_bms_battery_registration:{name:"Intelligente batterijsensor (IBS) Batterijregistratie",desc:"Registreert nieuwe 12V AGM/loodzuuraccuvervanging in DME/DDE-motormanagement."},bmw_motorrad_service_indicator_reset:{name:"BMW Motorrad jaarlijks onderhoud en olie-indicator resetten",desc:"Wist de jaarlijkse onderhoudsdatum en de 10.000 km-afstandsherinnering op het TFT-instrumentenpaneel."},ducati_desmo_service_reset:{name:"Ducati Desmo ventielonderhoudsherinnering duidelijk",desc:"Verwijdert het Desmoservice-moersleutelpictogram op het dashboard na een onderhoudsbeurt van 15.000/30.000 km."},byd_bms_isolation_self_test:{name:"BYD-zelftest voor hoogspanningsisolatie van mesbatterijen",desc:"Voert lek- en weerstandsdiagnostiek van hoogspanningssysteem (400V/800V) uit in gebouwbeheersystemen."},vag_drl_brightness_multi:{name:"Dagrijverlichting (DRL) Helderheidsaanpassing",desc:"Pas het intensiteitsniveau van de LED DRL aan voor dimlicht/parkeermodus."},bmw_comfort_turn_signal_cycles:{name:"One-Touch Comfort-richtingaanwijzerpulstelling",desc:"Selecteer hoeveel knipperingen er moeten optreden bij een snelle tik op de richtingaanwijzerhendel."},bmw_oil_service_reset:{name:"CBS Motorolie Reset (BMW)",desc:"Reset het Condition Based Service (CBS) olielevensduurpercentage terug naar 100%."},generic_oil_service_reset:{name:"Universele olie-onderhoudsindicator resetten",desc:"Wist het dashboardolie-onderhoudswaarschuwingslampje op ondersteunde OBD2/UDS-ECU's."},vag_epb_pad_change:{name:"EPB-remblokvervangingsmodus (VAG)",desc:"Trekt de elektronische parkeerremklauwen in voor onderhoud aan de achterremblokken."},bmw_epb_pad_change:{name:"EPB-remservicemodus (BMW)",desc:"Opent de parkeerremactuator naar de servicepositie voor vervanging van de achterremblokken."},mb_epb_pad_change:{name:"EPB-pad-aanpasmodus (Mercedes-Benz)",desc:"Zet de parkeerremspindel vrij in de werkplaatspositie voor onderhoud aan de remmen."},vag_dpf_regen:{name:"DPF Service Regeneratie Trigger (VAG)",desc:"Start de roetverbrandingscyclus van het stationaire roetfilter (DPF)."},bmw_dpf_regen:{name:"DPF gedwongen regeneratietrigger (BMW)",desc:"Vraagt DDE ECU om de actieve regeneratieroutine van het roetfilter te starten."},psa_dpf_regen:{name:"DPF-regeneratieverzoek (Peugeot/Citro\xebn)",desc:"Activeert stationaire DPF-regeneratie voor ECU's van HDi-dieselmotoren."},bmw_bms_battery_register:{name:"BMS Batterijvervangingsregistratie (BMW)",desc:"Registreert nieuwe batterijvervanging met DME/DDE Intelligent Battery Sensor."},mb_bms_battery_register:{name:"Accuregistratie en reset (Mercedes-Benz)",desc:"Reset de batterijverouderingsteller in de SAM-module na installatie van een nieuwe batterij."},vag_sas_calibrate:{name:"Stuurhoeksensor (SAS) Kalibratie (VAG)",desc:"Kalibreert de nulpuntpositie van de G85 stuurhoeksensor voor ABS/ESP ECU."},toyota_sas_calibrate:{name:"Stuurhoeknulpuntkalibratie (Toyota)",desc:"Voert nulpuntkalibratie uit van de stuurhoeksensor in Skid Control ECU."},generic_tba_adapt:{name:"Uitlijning en aanpassing van het gasklephuis",desc:"Voert een stopleerroutine voor het elektronische gasklephuis uit in de motor-ECU."},epb_service_reset:{name:"Universele EPB Onderhoudsreset",desc:"Reset de slijtageteller van de elektronische parkeerremklauw en kalibreert de luchtspleet."},vag_dsg_reset:{name:"DSG Transmissie Basisinstellingen Reset (VAG)",desc:"Reset koppelingsaangrijppunten en schakelklepaanpassingen voor DSG/S-Tronic."},bmw_zf_reset:{name:"ZF 8HP transmissie-aanpassing reset (BMW)",desc:"Wist de EGS-transmissieschakeltijd en drukaanpassingswaarden."},bmw_brake_fluid_reset:{name:"Onderhoudsinterval remvloeistof resetten (BMW)",desc:"Reset Condition Based Service (CBS) 2-jarige remvloeistofverversingstimer."},ford_injector_code:{name:"Injectorcorrectiefactorcodering (Ford)",desc:"Programmeert IQA-codes van 16 tekens voor dieselinjectoren in PCM."},bmw_injector_code:{name:"Brandstofinjectordebietcodering (BMW)",desc:"Schrijft energiekalibratiewaarden voor vervangen brandstofinjectoren naar DME."},generic_headlight_aim:{name:"Automatische kalibratie van koplampen",desc:"Stelt de nulreferentiepositie in voor adaptieve koplampmotoren met automatische niveauregeling."},bmw_12v_battery_reg:{name:"12V extra accuregistratie (BMW)",desc:"Registreert vervanging van de AGM-start-/ondersteuningsbatterij in de PCU."},vag_comfort_turn_signal:{name:"Comfort richtingaanwijzer knippertelling (VAG)",desc:"Past het aantal knippercycli van het wisselen van rijstrook aan tussen 3, 4 en 5 knipperingen."},vag_coming_home_duration:{name:"Coming/Leaving Home-lichtduur (VAG)",desc:"Configureert de koplampverlichtingstimer na het vergrendelen van het voertuig (10s - 60s)."},vag_remote_windows:{name:"Comfortraambediening op afstand (VAG)",desc:"Maakt het openen en sluiten van de elektrisch bediende ruiten mogelijk via de afstandsbediening door lang indrukken."},vag_auto_lock_15kmh:{name:"Automatisch deurslot bij 15 km/u (VAG)",desc:"Vergrendelt automatisch alle deuren wanneer de voertuigsnelheid 15 km/u bereikt."},vag_sfd_unlock_prep:{name:"SFD Gateway Beschermingsstatus Voorbereiding (VAG 2020+)",desc:"Bereidt MQB-evo SFD-gatewaytokensessie voor voor het schrijven van beveiligde DID's."},bmw_asd_deactivate:{name:"Actief Sound Design (ASD) Deactivering (BMW)",desc:"Dempt het synthetische motorgeluid dat via de luidsprekers in de cabine wordt afgespeeld."},bmw_comfort_turn_signal:{name:"Telling comfortrichtingaanwijzers (BMW)",desc:"Stelt het aantal pulsen van de indicator met \xe9\xe9n druk op de knop in (1 tot 5 knipperingen)."},bmw_mirror_fold_lock:{name:"Comfort Access spiegel inklapbaar slot (BMW)",desc:"Klapt de zijspiegels automatisch in zodra u de auto vergrendelt."},toyota_coming_home_duration:{name:"Koplampvertraging / Coming-Home (Toyota)",desc:"Configureert de vertragingstimer voor het uitschakelen van de koplamp na het uitschakelen van het contact (30s-120s)."},toyota_lane_change_flash:{name:"Knippertelling richtingaanwijzers bij het wisselen van rijstrook (Toyota)",desc:"Past het aantal schakelcycli van het knipperlicht met \xe9\xe9n druk op de knop aan."},toyota_remote_window_close:{name:"Elektrisch bediende ruitsluiting op afstand (Toyota)",desc:"Maakt het mogelijk om alle elektrisch bediende ruiten te sluiten door de knop voor de afstandsbediening ingedrukt te houden."},toyota_autolock_behavior:{name:"Aanpassing automatische deurvergrendeling/ontgrendeling (Toyota)",desc:"Stelt de deurvergrendeling in (schakel uit P versus voertuigsnelheid > 20 km/u)."},toyota_approach_welcome_lights:{name:"Smart Key Approach-welkomstverlichting (Toyota)",desc:"Schakelt de interieurverlichting/cabineverlichting in wanneer de Smart Key het voertuig nadert."},hyundai_autolock_behavior:{name:"Gedrag automatische deurvergrendeling/ontgrendeling (Hyundai/Kia)",desc:"Vergrendelt automatisch de deuren bij shift of speed en ontgrendelt bij P of contact uit."},hyundai_window_remote:{name:"Raam op afstand openen/sluiten (Hyundai/Kia)",desc:"Maakt het omhoog/omlaag rollen van ramen mogelijk met behulp van slimme sleutelhangerknoppen."},hyundai_sport_mode_memory:{name:"Rijmodusselectiegeheugen (Hyundai/Kia)",desc:"Onthoudt de laatst geselecteerde rijmodus (Sport/Eco) nadat de motor opnieuw is gestart."},tesla_charge_limit_custom:{name:"Aanpassing van de batterijlaadlimiet (Tesla)",desc:"Stelt het standaardlaadlimietpercentage van de HV-batterij in (80% dagelijks / 100% trip)."},tesla_mirror_fold_lock:{name:"Spiegel automatisch inklapbaar op wegloopslot (Tesla)",desc:"Vouwt automatisch de zijspiegels in wanneer de wegloopvergrendeling van de telefoonsleutel wordt geactiveerd."},nissan_coming_home:{name:"Met dank aan Vertraging koplamp uit (Nissan)",desc:"Houdt de koplampen 30 seconden lang verlicht na het verlaten van de Nissan-auto."},nissan_lane_change_flash:{name:"Tap-to-Pass-flitsenwissel van rijstrook (Nissan)",desc:"Stelt het aantal pulsen van de richtingaanwijzer in bij een lichte tik op de hendel."},nissan_autolock_behavior:{name:"Snelheidsafhankelijk automatisch deurslot (Nissan)",desc:"Vergrendelt automatisch alle deuren wanneer het voertuig een snelheid van 24 km/u bereikt."},nissan_window_remote:{name:"Elektrische ruitbediening met afstandsbediening (Nissan)",desc:"Opent/sluit de voorruiten via de ontgrendelingsknop van de sleutelhanger en houd deze lang ingedrukt."},nissan_seatbelt_chime_mute:{