\u043a\u0430\u043c\u0435\u0440\u044b \u043d\u0430 360\xb0 \u0438 \u0440\u0435\u0436\u0438\u043c \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043d\u0430 \u0437\u0435\u043c\u043b\u044e",desc:"\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0435\u0442\u043a\u0438 \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u044f \u0441\u0446\u0435\u043f\u043a\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043d\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443\u044e \u043a\u0430\u043c\u0435\u0440\u0443."},nio_battery_swap_interval_reminder:{name:"\u0420\u0435\u0436\u0438\u043c \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0434\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u0441\u043c\u0435\u043d\u044b \u043f\u0438\u0442\u0430\u043d\u0438\u044f",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0441\u0442\u043e\u043f\u043e\u0440\u043d\u044b\u0435 \u0448\u0442\u0438\u0444\u0442\u044b \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 \u0438 \u043f\u0430\u043a\u0435\u0442\u044b \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043c\u0435\u043d\u043e\u0439."},nio_nomi_assistant_custom_voice_phrases:{name:"NOMI AI Companion \u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0438 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u043e\u0431\u0443\u0436\u0434\u0435\u043d\u0438\u044f",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0443\u044e \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044e \u0430\u0432\u0430\u0442\u0430\u0440\u0430 \u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0444\u0440\u0430\u0437\u044b \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u043b\u044f NOMI."},nio_sentry_watchdog_continuous_recording:{name:"NIO Sentry Mode \u0417\u0430\u043f\u0438\u0441\u044c \u0432 \u0431\u0443\u0444\u0435\u0440 \u043a\u0430\u043c\u0435\u0440\u044b 4K",desc:"\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u043f\u0438\u0441\u044c \u0441 \u043a\u0430\u043c\u0435\u0440\u044b \u043e\u0431\u044a\u0435\u043c\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u0447\u0430\u043d\u0438\u044f \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0434\u0430\u043d\u043d\u044b\u0445 \u043d\u0430 USB-\u043d\u0430\u043a\u043e\u043f\u0438\u0442\u0435\u043b\u044c, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0430 \u043f\u0440\u0438\u043f\u0430\u0440\u043a\u043e\u0432\u0430\u043d\u0430."},xiaomi_su7_hyperos_driver_profile_sync:{name:"\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u0434\u0440\u0430\u0439\u0432\u0435\u0440\u0430 Xiaomi SU7 HyperOS \u0441 \u044d\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0441\u0438\u0434\u0435\u043d\u044c\u044f, \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 Bluetooth \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 Xiaomi."},xiaomi_su7_boost_mode_throttle_curve:{name:"\u0420\u0435\u0436\u0438\u043c Boost: 20-\u0441\u0435\u043a\u0443\u043d\u0434\u043d\u0430\u044f \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 Overboost",desc:"\u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0444\u043e\u0440\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043f\u0440\u0438 \u043f\u043e\u043b\u043d\u043e\u043c \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0438."},xiaomi_su7_drift_mode_torque_vectoring:{name:"\u0420\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u043a\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u0438 \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0434\u0440\u0438\u0444\u0442\u0430",desc:"\u041f\u0435\u0440\u0435\u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 100\xa0% \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u0437\u0430\u0434\u043d\u044e\u044e \u043e\u0441\u044c \u043f\u0440\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0442\u044f\u0433\u0438."},chery_isa_overspeed_warning_chime_off:{name:"\u041e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u043e\u043c\u043e\u0449\u0438 \u043f\u0440\u0438 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0438 ISA",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0440\u0438 \u043f\u0440\u0435\u0432\u044b\u0448\u0435\u043d\u0438\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438."},chery_driver_monitoring_camera_sensitivity:{name:"\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0430\u043c\u0435\u0440\u044b \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u0438 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f DMS",desc:"\u0423\u043c\u0435\u043d\u044c\u0448\u0430\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043b\u043e\u0436\u043d\u043e\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u044e\u0449\u0438\u0445 \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432 \u043e\u0442 \u043a\u0430\u043c\u0435\u0440\u044b \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f."},retrofit_parking_sensor_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0433\u043e/\u0437\u0430\u0434\u043d\u0435\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043f\u0430\u0440\u043a\u043e\u0432\u043a\u0438 (PDC)",desc:"\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442 \u043c\u043e\u0434\u0443\u043b\u044c \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043f\u0430\u0440\u043a\u043e\u0432\u043a\u0438 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0433\u043e \u0440\u044b\u043d\u043a\u0430 \u0438\u043b\u0438 OEM \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0448\u043b\u044e\u0437\u0430."},retrofit_360_camera_activation:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043a\u0430\u043c\u0435\u0440 \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u0437\u043e\u0440\u0430 \u0441 \u043e\u0431\u0437\u043e\u0440\u043e\u043c \u043d\u0430 360\xb0",desc:"\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440 \u043a\u0430\u043c\u0435\u0440\u044b \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u0437\u043e\u0440\u0430 \u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0432\u0438\u0434 \u0441 \u043a\u0430\u043c\u0435\u0440\u044b \u0432 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u043e-\u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443."},retrofit_led_license_plate_light_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u043e\u0433\u043e \u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u043a\u0430 \u0438 \u043e\u0448\u0438\u0431\u043a\u0438 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0444\u043e\u043d\u0430\u0440\u044f \u041e\u0442\u043c\u0435\u043d\u0430",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043b\u0430\u043c\u043f\u043e\u0447\u043a\u0438 \u043d\u0430 \u0445\u043e\u043b\u043e\u0434\u043d\u0443\u044e \u043b\u0430\u043c\u043f\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u043b\u043e\u0436\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u0432\u044b\u0445\u043e\u0434\u0435 \u043b\u0430\u043c\u043f\u044b \u0438\u0437 \u0441\u0442\u0440\u043e\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043e\u0432."},retrofit_dash_cam_sentry_integration:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u0432\u0438\u0434\u0435\u043e\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430 \u0441 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u0435\u043c \u0438 \u0440\u0435\u0436\u0438\u043c\u043e\u043c \u043e\u0445\u0440\u0430\u043d\u044b",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u043b\u0438\u043d\u0438\u044e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0438\u0442\u0430\u043d\u0438\u044f \u043a\u043b\u0435\u043c\u043c\u044b 30 \u043c\u043e\u0434\u0443\u043b\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u0443\u0437\u043e\u0432\u043d\u044b\u043c \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0434\u043b\u044f \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0439 \u0437\u0430\u043f\u0438\u0441\u0438 \u043f\u0440\u0438 \u043f\u0430\u0440\u043a\u043e\u0432\u043a\u0435."},retrofit_heated_windshield_activation:{name:"\u041a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043e\u0431\u043e\u0433\u0440\u0435\u0432\u0430 \u043b\u043e\u0431\u043e\u0432\u043e\u0433\u043e \u0441\u0442\u0435\u043a\u043b\u0430 \u0434\u043b\u044f \u043c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u0438",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0432\u044b\u0445\u043e\u0434 \u0440\u0435\u043b\u0435 \u043e\u0431\u043e\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043b\u044f \u043e\u0431\u043e\u0433\u0440\u0435\u0432\u0430 \u0432\u0435\u0442\u0440\u043e\u0432\u043e\u0433\u043e \u0441\u0442\u0435\u043a\u043b\u0430 \u0438 \u043a\u043d\u043e\u043f\u043a\u0443 \u044d\u043a\u0440\u0430\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043a\u043b\u0438\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f."},retrofit_wireless_charger_module_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u0431\u0435\u0441\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u043e\u0439 \u0437\u0430\u0440\u044f\u0434\u043a\u0438 \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d\u0430 Qi, \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f \u0441 \u0437\u0430\u0440\u044f\u0434\u043d\u044b\u043c \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u043c",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u044b\u0439 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0431\u0435\u0441\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u043e\u0433\u043e \u0437\u0430\u0440\u044f\u0434\u043d\u043e\u0433\u043e \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0438 \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043e\u043a\u043d\u043e \u0441 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435\u043c \u043e\u0431 \u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435."},retrofit_acc_radar_module_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u0440\u0430\u0434\u0430\u0440\u043d\u043e\u0433\u043e \u043c\u043e\u0434\u0443\u043b\u044f \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043a\u0440\u0443\u0438\u0437-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f (ACC)",desc:"\u041a\u043e\u0434\u0438\u0440\u0443\u0435\u0442 \u043c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0439 \u0440\u0430\u0434\u0430\u0440 \u0434\u0430\u043b\u044c\u043d\u0435\u0433\u043e \u0440\u0430\u0434\u0438\u0443\u0441\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0432 \u0441\u0435\u0442\u044c CAN-\u0448\u0438\u043d\u044b \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},retrofit_traffic_sign_camera_activation:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f, \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u0440\u043e\u0436\u043d\u044b\u0445 \u0437\u043d\u0430\u043a\u043e\u0432, \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u043c\u0435\u0440\u044b \u043d\u0430 \u043b\u043e\u0431\u043e\u0432\u043e\u043c \u0441\u0442\u0435\u043a\u043b\u0435",desc:"\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0438\u044f \u0437\u043d\u0430\u043a\u043e\u0432 VZE \u043d\u0430 \u043c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043a\u0430\u043c\u0435\u0440\u0435 \u043d\u0430 \u043b\u043e\u0431\u043e\u0432\u043e\u043c \u0441\u0442\u0435\u043a\u043b\u0435."},retrofit_heated_steering_wheel_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043c\u043e\u0434\u0443\u043b\u044f \u043f\u043e\u0434\u043e\u0433\u0440\u0435\u0432\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430, \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0432\u044b\u0445\u043e\u0434 \u043d\u0430\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0445 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u043e\u0432."},retrofit_fatigue_camera_calibration:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f, \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f \u043a\u0430\u043c\u0435\u0440\u044b \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u0438 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f",desc:"\u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0438\u043d\u0444\u0440\u0430\u043a\u0440\u0430\u0441\u043d\u043e\u0439 \u043a\u0430\u043c\u0435\u0440\u044b \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0437\u0430 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c \u043f\u043e\u0441\u043b\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0440\u0443\u043b\u0435\u0432\u043e\u0439 \u043a\u043e\u043b\u043e\u043d\u043a\u0438."},retrofit_trailer_hitch_module_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u043e\u0434\u0443\u043b\u044f \u0444\u0430\u0440\u043a\u043e\u043f\u0430 \u0438 \u043f\u0440\u0438\u0446\u0435\u043f\u0430",desc:"\u041a\u043e\u0434\u0438\u0440\u0443\u0435\u0442 \u043c\u043e\u0434\u0443\u043b\u044c \u043f\u0440\u0438\u0446\u0435\u043f\u0430 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0441\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438 ESP \u0434\u043b\u044f \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u043a\u0430\u0447\u0438\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u0438\u0446\u0435\u043f\u0430."},retrofit_power_tailgate_trunk_kit_coding:{name:"\u041c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u0437\u0430\u0434\u043d\u0435\u0439 \u0434\u0432\u0435\u0440\u0438 \u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043e\u043c \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0436\u0435\u0441\u0442\u043e\u0432 \u043d\u043e\u0433",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u0438\u0432\u043e\u0434\u0430 \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a\u0430 \u0438 \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0443\u0434\u0430\u0440\u0430 \u0432 \u0431\u0430\u043c\u043f\u0435\u0440."},easteregg_urban_joke_light_show:{name:"\u0428\u043e\u0443 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0441\u0432\u0435\u0442\u0430 Urban Joke",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u0434\u043d\u0438\u0435 \u0444\u043e\u043d\u0430\u0440\u0438 \u0438 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u043d\u0430 \u043f\u043e\u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0435 \u043c\u0438\u0433\u0430\u043d\u0438\u0435 \u043f\u0440\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u043d\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},easteregg_custom_boot_greeting_text:{name:"\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f \u043f\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435 \u0432 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u043c \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0435",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432 \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},easteregg_cluster_mini_game_mode:{name:"\u0421\u043a\u0440\u044b\u0442\u043e\u0435 \u043c\u0435\u043d\u044e \u043c\u0438\u043d\u0438-\u0438\u0433\u0440\u044b \u043d\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0440\u0435\u0442\u0440\u043e-\u043c\u0438\u043d\u0438-\u0438\u0433\u0440\u0443, \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u0443\u044e \u043a\u043d\u043e\u043f\u043a\u043e\u0439 \u043d\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u043c \u043a\u043e\u043b\u0435\u0441\u0435, \u043d\u0430 \u0434\u0438\u0441\u043f\u043b\u0435\u0435, \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u043f\u0440\u0438\u043f\u0430\u0440\u043a\u043e\u0432\u0430\u043d\u044b."},easteregg_custom_horn_melody_package:{name:"\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043c\u0435\u043b\u043e\u0434\u0438\u044f \u0430\u043a\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u043e\u0436\u043a\u0430 \u043d\u0430 \u0437\u0430\u043a\u0430\u0437",desc:"\u041f\u0440\u0438 \u043e\u0442\u043f\u0438\u0440\u0430\u043d\u0438\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0440\u0438\u0442\u043c\u0438\u0447\u043d\u044b\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b."},easteregg_welcome_lighting_door_sequence:{name:"\u041f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0434\u0432\u0435\u0440\u0435\u0439 \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0432\u0435\u0442\u0430 \u0432 \u043f\u043e\u0433\u043e\u043d\u0435",desc:"\u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0443\u044e \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044e \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043e\u0432 \u043d\u0430 \u043d\u0430\u0440\u0443\u0436\u043d\u044b\u0445 \u0434\u0432\u0435\u0440\u043d\u044b\u0445 \u0440\u0443\u0447\u043a\u0430\u0445."},easteregg_developer_service_menu_shortcut:{name:"\u042f\u0440\u043b\u044b\u043a \u044d\u043a\u0440\u0430\u043d\u0430 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u0438 \u0441\u043b\u0443\u0436\u0431",desc:"\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0441\u043a\u0440\u044b\u0442\u044b\u043c \u044d\u043a\u0440\u0430\u043d\u0430\u043c \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0436\u0435\u0441\u0442\u043e\u0432."},easteregg_seasonal_cluster_theme_effect:{name:"\u041d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0442\u0435\u043c\u044b \u0441\u0435\u0437\u043e\u043d\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0430 \u043f\u043e\u0433\u043e\u0434\u044b (\u0441\u043d\u0435\u0436\u0438\u043d\u043a\u0430/\u0434\u043e\u0436\u0434\u044c)",desc:"\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0430\u043d\u0438\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0444\u043e\u043d \u0438\u0437 \u0441\u043d\u0435\u0436\u0438\u043d\u043e\u043a \u0438\u043b\u0438 \u0447\u0430\u0441\u0442\u0438\u0446 \u0434\u043e\u0436\u0434\u044f \u0432 \u043a\u043b\u0430\u0441\u0442\u0435\u0440 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u0432 \u0437\u0438\u043c\u043e\u0439."},easteregg_valet_mode_prank_warning_message:{name:"\u0412\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043e\u0431 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0438 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0441\u043b\u0443\u0436\u0435\u0431\u043d\u043e\u0433\u043e \u0440\u043e\u0437\u044b\u0433\u0440\u044b\u0448\u0430",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u044e\u043c\u043e\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u0442\u0440\u043e\u0433\u043e\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u044e\u0449\u0435\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438, \u0435\u0441\u043b\u0438 \u043f\u0440\u0435\u0432\u044b\u0448\u0435\u043d \u0440\u0435\u0436\u0438\u043c \u043a\u0430\u043c\u0435\u0440\u0434\u0438\u043d\u0435\u0440\u0430."},adas_lane_keep_assist_gentle_curve:{name:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f (LKA) \u041a\u0440\u0438\u0432\u0430\u044f \u043f\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f",desc:"\u0421\u043c\u044f\u0433\u0447\u0430\u0435\u0442 \u0440\u0435\u0437\u043a\u0438\u0435 \u0440\u044b\u0432\u043a\u0438 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 \u0437\u0430 \u0441\u0447\u0435\u0442 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430."},adas_lka_last_state_memory_mode:{name:"\u0424\u0443\u043d\u043a\u0446\u0438\u044f \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u043f\u0430\u043c\u044f\u0442\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f",desc:"\u041f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 LKA \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u043c \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u043c \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},adas_acc_default_follow_distance:{name:"\u0410\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u044b\u0439 \u043a\u0440\u0443\u0438\u0437-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c (ACC) \u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443 \u0437\u0430\u0437\u043e\u0440\u0430 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e (\u043e\u0442 1 \u0434\u043e 4 \u043f\u043e\u043b\u043e\u0441\u043e\u043a) \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u043c \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 ACC."},adas_acc_speed_step_adjustment:{name:"\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u0448\u0430\u0433\u0430 \u043f\u0440\u0438\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043a\u0440\u0435\u0439\u0441\u0435\u0440\u0441\u043a\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 ACC (+5 / +10 \u043a\u043c/\u0447)",desc:"\u0418\u0437\u043c\u0435\u043d\u044f\u0435\u0442 \u0448\u0430\u0433 \u043a\u043d\u043e\u043f\u043a\u0438 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043f\u0440\u0438 \u043a\u0440\u0430\u0442\u043a\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c \u043d\u0430\u0436\u0430\u0442\u0438\u0438 \u043d\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u043c \u043a\u043e\u043b\u0435\u0441\u0435 \u0441 1 \u043a\u043c/\u0447 \u0434\u043e 5 \u043a\u043c/\u0447."},adas_matrix_led_glare_free_high_beam_unlock:{name:"\u041c\u0430\u0442\u0440\u0438\u0447\u043d\u044b\u0439 \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u044b\u0439 \u0430\u043d\u0442\u0438\u0431\u043b\u0438\u043a\u043e\u0432\u044b\u0439 \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u044b\u0439 \u044d\u043a\u0440\u0430\u043d \u0434\u0430\u043b\u044c\u043d\u0435\u0433\u043e \u0441\u0432\u0435\u0442\u0430",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u044b\u0439 \u0434\u0430\u043b\u044c\u043d\u0438\u0439 \u0441\u0432\u0435\u0442 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0430 \u043d\u0430 \u0441\u0435\u0432\u0435\u0440\u043e\u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0445 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f\u0445."},adas_traffic_jam_assist_follow_fine_tune:{name:"\u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430 \u0432\u043e\u0437\u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u043e\u043c\u043e\u0449\u0438 \u0432 \u043f\u0440\u043e\u0431\u043a\u0435",desc:"\u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043e\u043a\u043d\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0441 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u043e\u0439 \u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0441 3 \u0434\u043e 15 \u0441\u0435\u043a\u0443\u043d\u0434."},adas_rear_radar_blind_spot_zero_point_reset:{name:"\u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u0443\u0433\u043b\u0430 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0440\u0430\u0434\u0430\u0440\u0430 \u0441\u043b\u0435\u043f\u044b\u0445 \u0437\u043e\u043d",desc:"\u041f\u0435\u0440\u0435\u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u0443\u0433\u043b\u0430 \u0430\u0437\u0438\u043c\u0443\u0442\u0430 \u0440\u0430\u0434\u0430\u0440\u0430 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0431\u0430\u043c\u043f\u0435\u0440\u0430 \u043f\u043e\u0441\u043b\u0435 \u0441\u043d\u044f\u0442\u0438\u044f \u0438\u043b\u0438 \u0440\u0435\u043c\u043e\u043d\u0442\u0430 \u0431\u0430\u043c\u043f\u0435\u0440\u0430."},adas_surround_camera_stitching_recalib:{name:"\u041a\u0430\u043c\u0435\u0440\u0430 \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u0437\u043e\u0440\u0430. \u0412\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f.",desc:"\u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0443 \u0441\u0448\u0438\u0432\u0430\u043d\u0438\u044f \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043a\u0430\u043c\u0435\u0440\u044b \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043e \u0434\u043e\u0440\u043e\u0433\u0435."},adas_steering_angle_sensor_zero_point_reset:{name:"\u0414\u0430\u0442\u0447\u0438\u043a \u0443\u0433\u043b\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 (SAS) \u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0442\u043e\u0447\u043a\u0438",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0433\u043e\u043b \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 \u043d\u0430 0,0\xb0 \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043f\u043e \u0441\u0445\u043e\u0434-\u0440\u0430\u0437\u0432\u0430\u043b\u0443."},adas_cross_traffic_alert_sensitivity_adjust:{name:"\u0414\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043e\u043f\u043e\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043e \u043f\u0435\u0440\u0435\u043a\u0440\u0435\u0441\u0442\u043d\u043e\u043c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0441\u0437\u0430\u0434\u0438 (RCTA)",desc:"\u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0431\u043e\u043a\u043e\u0432\u044b\u043c \u0440\u0430\u0434\u0430\u0440\u043e\u043c \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432, \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u043f\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0437\u0430\u0434\u043d\u0438\u043c \u0445\u043e\u0434\u043e\u043c."},adas_aeb_emergency_braking_threshold_preview:{name:"\u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e\u0431 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u043c \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u0438 (AEB)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u0438 \u043f\u043e\u0437\u0434\u043d\u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0438 \u0432\u043f\u0435\u0440\u0435\u0434."},adas_night_vision_camera_alignment:{name:"\u0412\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u0435 \u0446\u0435\u043b\u0438 \u0438\u043d\u0444\u0440\u0430\u043a\u0440\u0430\u0441\u043d\u043e\u0439 \u0442\u0435\u043f\u043b\u043e\u0432\u0438\u0437\u0438\u043e\u043d\u043d\u043e\u0439 \u043a\u0430\u043c\u0435\u0440\u044b \u043d\u043e\u0447\u043d\u043e\u0433\u043e \u0432\u0438\u0434\u0435\u043d\u0438\u044f",desc:"\u0417\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0434\u0441\u0442\u0430\u0432\u043a\u0438 \u0438\u043d\u0444\u0440\u0430\u043a\u0440\u0430\u0441\u043d\u043e\u0439 \u043a\u0430\u043c\u0435\u0440\u044b."},adas_dms_driver_monitoring_ir_threshold:{name:"\u0418\u043d\u0444\u0440\u0430\u043a\u0440\u0430\u0441\u043d\u0430\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0430\u043c\u0435\u0440\u044b \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f DMS",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0433\u043b\u0430\u0437 \u0434\u043b\u044f \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439, \u043d\u043e\u0441\u044f\u0449\u0438\u0445 \u0442\u0435\u043c\u043d\u044b\u0435 \u043f\u043e\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0441\u043e\u043b\u043d\u0446\u0435\u0437\u0430\u0449\u0438\u0442\u043d\u044b\u0435 \u043e\u0447\u043a\u0438."},toyota_soft_close_door_retrofit_coding:{name:"\u041a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0430\u043a\u0443\u0443\u043c\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0430 \u0434\u0432\u0435\u0440\u0438 Power Soft-Close",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u0440\u0438\u0432\u043e\u0434\u044b \u0434\u0432\u0435\u0440\u043d\u043e\u0439 \u0437\u0430\u0449\u0435\u043b\u043a\u0438 \u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043e\u043c \u0432 \u043c\u043e\u0434\u0443\u043b\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u0443\u0437\u043e\u0432\u043d\u044b\u043c \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c."},toyota_digital_speedometer_display_enable:{name:"\u0426\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u0441\u043f\u0438\u0434\u043e\u043c\u0435\u0442\u0440\u0430",desc:"\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043d\u0430 \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0439 \u0416\u041a-\u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432."},toyota_walk_away_auto_lock_sensitivity:{name:"\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0440\u0430\u043d\u0438\u044f \u0434\u0432\u0435\u0440\u0435\u0439 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0441\u043c\u0430\u0440\u0442-\u043a\u043b\u044e\u0447\u0430 Walk-Away",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0434\u0432\u0435\u0440\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043a\u0440\u043e\u044e\u0442\u0441\u044f \u043f\u0440\u0438 \u0443\u0445\u043e\u0434\u0435."},toyota_jbl_3d_eq_audio_profile_unlock:{name:"\u041a\u0440\u0438\u0432\u044b\u0435 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0430 JBL Premium Surround Sound",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 3D-\u043f\u0440\u043e\u0444\u0438\u043b\u0438 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0430 \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u043d\u043e\u0433\u043e \u0437\u0430\u043b\u0430 \u0432 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u043c \u0430\u0443\u0434\u0438\u043e\u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0435 JBL."},toyota_ev_mode_throttle_override_suppression:{name:"\u0420\u0435\u0436\u0438\u043c EV: \u0447\u0438\u0441\u0442\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438",desc:"\u041f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043f\u0440\u0438 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u043c \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},ford_sync3_engineering_diagnostics_page:{name:"\u0421\u0435\u043d\u0441\u043e\u0440\u043d\u044b\u0439 \u044d\u043a\u0440\u0430\u043d SYNC3/SYNC4, \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044d\u043a\u0440\u0430\u043d",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043d\u0435\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0435 \u044d\u043a\u0440\u0430\u043d\u044b GPS, \u0442\u0435\u0441\u0442\u0430 APIM \u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0432 SYNC."},ford_rear_seat_entertainment_unlock:{name:"\u0421\u043a\u0432\u043e\u0437\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u0434\u043b\u044f HDMI/\u0432\u0438\u0434\u0435\u043e\u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439 \u043d\u0430 \u0437\u0430\u0434\u043d\u0438\u0445 \u0441\u0438\u0434\u0435\u043d\u044c\u044f\u0445",desc:"\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0442\u043e\u043a\u043e\u0432\u0443\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u0437\u0432\u0443\u043a\u0430 \u0447\u0435\u0440\u0435\u0437 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0432 \u0441\u0430\u043b\u043e\u043d\u0435 \u043d\u0430 \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u044d\u043a\u0440\u0430\u043d\u044b \u043d\u0430 \u0437\u0430\u0434\u043d\u0438\u0445 \u0441\u0438\u0434\u0435\u043d\u044c\u044f\u0445."},ford_bambi_mode_fog_light_expansion:{name:"\u0420\u0435\u0436\u0438\u043c \u0411\u044d\u043c\u0431\u0438 \u0414\u0430\u043b\u044c\u043d\u0438\u0439 \u0441\u0432\u0435\u0442 + \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0445 \u0444\u0430\u0440",desc:"\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u043c\u0438 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0435 \u0444\u0430\u0440\u044b \u0434\u0430\u0436\u0435 \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0434\u0430\u043b\u044c\u043d\u0435\u0433\u043e \u0441\u0432\u0435\u0442\u0430 \u0444\u0430\u0440."},ford_auto_engine_idle_shutdown_30min_override:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043d\u0430 30-\u043c\u0438\u043d\u0443\u0442\u043d\u043e\u043c \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u043c \u0445\u043e\u0434\u0443 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u043e",desc:"\u041f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043f\u043e\u0441\u043b\u0435 30 \u043c\u0438\u043d\u0443\u0442 \u0441\u0442\u043e\u044f\u043d\u043a\u0438."},hyundai_n_grin_shift_retrofit_enable:{name:"N Grin Shift (NGS) \u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 20-\u0441\u0435\u043a\u0443\u043d\u0434\u043d\u043e\u0439 \u043c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0430\u0446\u0438\u0438 Overboost",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f \u043a\u043d\u043e\u043f\u043a\u0438 NGS \u043d\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u043c \u043a\u043e\u043b\u0435\u0441\u0435 \u0432 \u042d\u0411\u0423."},hyundai_smart_tailgate_approach_distance:{name:"\u0418\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044f \u043a \u0437\u0430\u0434\u043d\u0435\u0439 \u0434\u0432\u0435\u0440\u0438 \u0431\u0435\u0437 \u043f\u043e\u043c\u043e\u0449\u0438 \u0440\u0443\u043a",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0438 \u0441\u0442\u043e\u044f\u043d\u0438\u044f (\u043e\u0442 3 \u0434\u043e 1 \u0441), \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0430\u044f \u0437\u0430\u0434\u043d\u044f\u044f \u0434\u0432\u0435\u0440\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0442\u043a\u0440\u043e\u0435\u0442\u0441\u044f."},hyundai_digital_cluster_n_performance_theme:{name:"\u0420\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438 N Performance",desc:"\u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442 \u043a\u043e\u043c\u043f\u043e\u043d\u043e\u0432\u043a\u0443 \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0430 \u043a\u0440\u0430\u0441\u043d\u043e\u0433\u043e \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u044f N-Performance \u043a \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438 \u0441 \u0416\u041a-\u0434\u0438\u0441\u043f\u043b\u0435\u0435\u043c."},stellantis_scr_adblue_warning_threshold_adjust:{name:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430 \u043f\u043e\u0440\u043e\u0433\u043e\u0432\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f SCR AdBlue",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043f\u0435\u0440\u0432\u043e\u0439 \u0434\u043e\u0437\u0430\u043f\u0440\u0430\u0432\u043a\u0435 AdBlue \u0441 2400 \u043a\u043c \u0434\u043e 1000 \u043a\u043c."},stellantis_jeep_trail_rated_offroad_pages:{name:"\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0438 \u0434\u043b\u044f \u0431\u0435\u0437\u0434\u043e\u0440\u043e\u0436\u044c\u044f Jeep Uconnect Trail-Rated",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0448\u0430\u0433\u0430, \u043a\u0440\u0435\u043d\u0430, \u0441\u043e\u0447\u043b\u0435\u043d\u0435\u043d\u0438\u044f \u043a\u043e\u043b\u0435\u0441 \u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u043e\u0445\u043b\u0430\u0436\u0434\u0430\u044e\u0449\u0435\u0439 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0432 Uconnect."},stellantis_peugeot_icockpit_3d_color_schemes:{name:"\u041f\u0430\u043b\u0438\u0442\u0440\u0430 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0446\u0432\u0435\u0442\u043e\u0432\u043e\u0439 \u0441\u0445\u0435\u043c\u044b Peugeot 3D i-Cockpit",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0446\u0432\u0435\u0442\u043e\u0432\u044b\u0435 \u0442\u0435\u043c\u044b \xab\u041c\u0435\u0434\u044c\xbb \u0438 \xab\u041a\u0432\u0430\u0440\u0446\xbb \u0434\u043b\u044f \u0433\u043e\u043b\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0439 3D-\u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438."},gm_super_cruise_follow_distance_adjust:{name:"\u0421\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f Super Cruise \u0431\u0435\u0437 \u043f\u043e\u043c\u043e\u0449\u0438 \u0440\u0443\u043a",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u0437\u043e\u0440 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u043e\u0433\u043e \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u043e \u0448\u043e\u0441\u0441\u0435 Super Cruise."},gm_instrument_hud_calibration_reset:{name:"\u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u043d\u0430\u043a\u043b\u043e\u043d\u0430 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0434\u0438\u0441\u043f\u043b\u0435\u044f (HUD)",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0443\u0433\u043e\u043b \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0440\u0430 HUD \u043d\u0430 \u043b\u043e\u0431\u043e\u0432\u043e\u043c \u0441\u0442\u0435\u043a\u043b\u0435 \u0438 \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430 \u043f\u043e \u043d\u0443\u043b\u0435\u0432\u043e\u043c\u0443 \u0443\u0440\u043e\u0432\u043d\u044e."},gm_afm_v8_cylinder_lock_no_v4_drop:{name:"\u0411\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430 AFM/DFM (\u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0435\u0436\u0438\u043c V8)",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 Active Fuel Management, \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u044e\u0449\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0432 8-\u0446\u0438\u043b\u0438\u043d\u0434\u0440\u043e\u0432\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435."},dodge_ram_truck_fog_lights_with_high_beam:{name:"\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0435 \u0444\u0430\u0440\u044b \u0434\u043b\u044f \u0433\u0440\u0443\u0437\u043e\u0432\u0438\u043a\u043e\u0432 RAM \u0441 \u0434\u0430\u043b\u044c\u043d\u0438\u043c \u0441\u0432\u0435\u0442\u043e\u043c (\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f \xab\u0432\u044b\u0441\u043e\u043a\u0438\u0439-\u043d\u0438\u0437\u043a\u0438\u0439-\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0439\xbb)",desc:"\u041f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0445 \u0444\u0430\u0440 \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0434\u0430\u043b\u044c\u043d\u0435\u0433\u043e \u0441\u0432\u0435\u0442\u0430."},toyota_keyless_window_down:{name:"\u041e\u043a\u043d\u043e \u0441 \u0431\u0440\u0435\u043b\u043a\u0430 Toyota \u043e\u0442\u043a\u0440\u044b\u0442\u043e (\u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0443)",desc:"\u041e\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0432\u0441\u0435 \u0441\u0442\u0435\u043a\u043b\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u0438\u043a\u0438 \u043f\u0440\u0438 \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0438 \u043a\u043d\u043e\u043f\u043a\u0438 \u0420\u0410\u0417\u0411\u041b\u041e\u041a\u0418\u0420\u041e\u0412\u0410\u0422\u042c \u043d\u0430 \u0431\u0440\u0435\u043b\u043e\u043a\u0435."},toyota_seatbelt_chime_disable:{name:"\u041e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u0442\u0440\u0435\u0432\u043e\u0433\u0438 \u0440\u0435\u043c\u043d\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430 Toyota (\u041f\u0430\u0440\u043a\u043e\u0432\u043a\u0430/\u0411\u0435\u0437\u0434\u043e\u0440\u043e\u0436\u044c\u0435)",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043d\u0435\u043f\u0440\u0438\u0441\u0442\u0435\u0433\u043d\u0443\u0442\u043e\u0433\u043e \u0440\u0435\u043c\u043d\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0441\u043a\u043e\u043c \u0441\u0438\u0434\u0435\u043d\u044c\u0435."},honda_walkaway_auto_lock:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0432\u0435\u0440\u043d\u043e\u0439 \u0437\u0430\u043c\u043e\u043a Honda Walk-Away",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u0435\u0442 \u0432\u0441\u0435 \u0434\u0432\u0435\u0440\u0438, \u043a\u043e\u0433\u0434\u0430 \u0441\u043c\u0430\u0440\u0442-\u043a\u043b\u044e\u0447 \u043f\u043e\u043a\u0438\u0434\u0430\u0435\u0442 \u0440\u0430\u0434\u0438\u0443\u0441 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 2,5 \u043c."},volvo_speed_limiter_unlock:{name:"\u0417\u0430\u0432\u043e\u0434\u0441\u043a\u043e\u0439 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0442\u0435\u043b\u044c \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 Volvo 180 \u043a\u043c/\u0447 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0439",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u0432\u043e\u0434\u0441\u043a\u043e\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 180 \u043a\u043c/\u0447 \u0434\u043b\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0430 \u0442\u0440\u0435\u043a\u0435/\u0430\u0432\u0442\u043e\u0431\u0430\u043d\u0435."},byd_v2l_3kw_power_unlock:{name:"BYD \xab\u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c-\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0430\xbb (V2L), \u0440\u0435\u0436\u0438\u043c \u0432\u044b\u0445\u043e\u0434\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u043e\u043a\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c\u044e 3,6 \u043a\u0412\u0442",desc:"\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0432\u043d\u0435\u0448\u043d\u0438\u0439 \u0440\u0430\u0437\u0440\u044f\u0434\u043d\u044b\u0439 \u043f\u043e\u0440\u0442 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u043e\u043a\u0430 220 \u0412/3,6 \u043a\u0412\u0442 V2L \u0434\u043b\u044f \u043a\u0435\u043c\u043f\u0438\u043d\u0433\u043e\u0432\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u0438."},xiaomi_su7_drift_mode_unlock:{name:"Xiaomi SU7 \u0420\u0435\u0436\u0438\u043c \u0442\u0440\u0435\u043a\u043e\u0432\u043e\u0433\u043e \u0434\u0440\u0438\u0444\u0442\u0430 \u0438 \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430",desc:"\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 100%-\u043d\u043e\u0435 \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0438 \u0440\u0435\u0436\u0438\u043c ESC Track Drift."},vag_oil_service_reset:{name:"Oil Change Service Reset (Flexible Interval)",desc:"Resets instrument cluster oil change interval counter to factory 15,000 km / 365 days."},vag_epb_service_mode:{name:"\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0439 \u0441\u0442\u043e\u044f\u043d\u043e\u0447\u043d\u044b\u0439 \u0442\u043e\u0440\u043c\u043e\u0437 (EPB) \u0420\u0435\u0436\u0438\u043c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u044b\u0445 \u043a\u043e\u043b\u043e\u0434\u043e\u043a",desc:"\u0412\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0440\u0448\u043d\u0438 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0441\u0443\u043f\u043f\u043e\u0440\u0442\u0430 EPB \u0434\u043b\u044f \u0437\u0430\u043c\u0435\u043d\u044b \u0437\u0430\u0434\u043d\u0438\u0445 \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u044b\u0445 \u043a\u043e\u043b\u043e\u0434\u043e\u043a \u0438 \u0440\u043e\u0442\u043e\u0440\u0430."},bmw_bms_battery_registration:{name:"\u0418\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0430\u0442\u0447\u0438\u043a \u0431\u0430\u0442\u0430\u0440\u0435\u0438 (IBS) \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0431\u0430\u0442\u0430\u0440\u0435\u0438",desc:"\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u043c\u0435\u043d\u0443 \u043d\u043e\u0432\u043e\u0439 AGM/\u0441\u0432\u0438\u043d\u0446\u043e\u0432\u043e-\u043a\u0438\u0441\u043b\u043e\u0442\u043d\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 12 \u0412 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0435\u043c DME/DDE."},bmw_motorrad_service_indicator_reset:{name:"\u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 BMW Motorrad \u0438 \u0441\u0431\u0440\u043e\u0441 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043c\u0430\u0441\u043b\u0430",desc:"\u0423\u0434\u0430\u043b\u044f\u0435\u0442 \u0434\u0430\u0442\u0443 \u0435\u0436\u0435\u0433\u043e\u0434\u043d\u043e\u0433\u043e \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0438 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043e \u043f\u0440\u043e\u0431\u0435\u0433\u0435 \u0432 10 000 \u043a\u043c \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432 TFT."},ducati_desmo_service_reset:{name:"\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043e \u0441\u0435\u0440\u0432\u0438\u0441\u043d\u043e\u043c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0438 \u043a\u043b\u0430\u043f\u0430\u043d\u0430 Ducati Desmo",desc:"\u0423\u0434\u0430\u043b\u044f\u0435\u0442 \u0437\u043d\u0430\u0447\u043e\u043a \u0433\u0430\u0435\u0447\u043d\u043e\u0433\u043e \u043a\u043b\u044e\u0447\u0430 Desmoservice \u043d\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438 \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0431\u0435\u0433\u0430 15 000/30 000 \u043a\u043c."},byd_bms_isolation_self_test:{name:"\u0421\u0430\u043c\u043e\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u0431\u0430\u0442\u0430\u0440\u0435\u0438 BYD Blade",desc:"\u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0443\u0442\u0435\u0447\u0435\u043a \u0438 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u044b\u0441\u043e\u043a\u043e\u0432\u043e\u043b\u044c\u0442\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b (400 \u0412/800 \u0412) \u0432 BMS."},vag_drl_brightness_multi:{name:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430 \u044f\u0440\u043a\u043e\u0441\u0442\u0438 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0445\u043e\u0434\u043e\u0432\u044b\u0445 \u043e\u0433\u043d\u0435\u0439 (\u0414\u0425\u041e)",desc:"\u041e\u0442\u0440\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0439\u0442\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043e\u0432 \u0414\u0425\u041e \u0434\u043b\u044f \u0440\u0435\u0436\u0438\u043c\u0430 \u0431\u043b\u0438\u0436\u043d\u0435\u0433\u043e \u0441\u0432\u0435\u0442\u0430/\u043f\u0430\u0440\u043a\u043e\u0432\u043a\u0438."},bmw_comfort_turn_signal_cycles:{name:"\u041a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u044b\u0439 \u043f\u043e\u0434\u0441\u0447\u0435\u0442 \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u043e\u0432 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0432 \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435",desc:"\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043c\u0438\u0433\u0430\u043d\u0438\u0439 \u043f\u0440\u0438 \u0431\u044b\u0441\u0442\u0440\u043e\u043c \u043d\u0430\u0436\u0430\u0442\u0438\u0438 \u0440\u044b\u0447\u0430\u0433\u0430 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430."},bmw_oil_service_reset:{name:"\u0421\u0431\u0440\u043e\u0441 \u043c\u043e\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043c\u0430\u0441\u043b\u0430 CBS (BMW)",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u0441\u0440\u043e\u043a\u0430 \u0441\u043b\u0443\u0436\u0431\u044b \u043c\u0430\u0441\u043b\u0430 \u043f\u0440\u0438 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0438 \u043f\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e (CBS) \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u043d\u0430 100%."},generic_oil_service_reset:{name:"\u0421\u0431\u0440\u043e\u0441 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0443\u0440\u043e\u0432\u043d\u044f \u043c\u0430\u0441\u043b\u0430",desc:"\u0423\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0438\u0433\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u043b\u0430\u043c\u043f\u043e\u0447\u043a\u0443 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0437\u0430\u043c\u0435\u043d\u044b \u043c\u0430\u0441\u043b\u0430 \u043d\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438 \u0432\u043e \u0432\u0441\u0435\u0445 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0445 \u042d\u0411\u0423 OBD2/UDS."},vag_epb_pad_change:{name:"\u0420\u0435\u0436\u0438\u043c \u0437\u0430\u043c\u0435\u043d\u044b \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u044b\u0445 \u043a\u043e\u043b\u043e\u0434\u043e\u043a EPB (VAG)",desc:"\u0412\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0435 \u0441\u0443\u043f\u043f\u043e\u0440\u0442\u044b \u0441\u0442\u043e\u044f\u043d\u043e\u0447\u043d\u043e\u0433\u043e \u0442\u043e\u0440\u043c\u043e\u0437\u0430 \u0434\u043b\u044f \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0437\u0430\u0434\u043d\u0438\u0445 \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u044b\u0445 \u043a\u043e\u043b\u043e\u0434\u043e\u043a."},bmw_epb_pad_change:{name:"\u0420\u0435\u0436\u0438\u043c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0442\u043e\u0440\u043c\u043e\u0437\u043e\u0432 EPB (BMW)",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u0432\u043e\u0434 \u0441\u0442\u043e\u044f\u043d\u043e\u0447\u043d\u043e\u0433\u043e \u0442\u043e\u0440\u043c\u043e\u0437\u0430 \u0432 \u0441\u0435\u0440\u0432\u0438\u0441\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0437\u0430\u043c\u0435\u043d\u044b \u0437\u0430\u0434\u043d\u0438\u0445 \u043a\u043e\u043b\u043e\u0434\u043e\u043a."},mb_epb_pad_change:{name:"\u0420\u0435\u0436\u0438\u043c \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043a\u043e\u043b\u043e\u0434\u043e\u043a EPB (Mercedes-Benz)",desc:"\u041e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0430\u0435\u0442 \u0448\u043f\u0438\u043d\u0434\u0435\u043b\u044c \u0441\u0442\u043e\u044f\u043d\u043e\u0447\u043d\u043e\u0433\u043e \u0442\u043e\u0440\u043c\u043e\u0437\u0430 \u0432 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439 \u0434\u043b\u044f \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0442\u043e\u0440\u043c\u043e\u0437\u043e\u0432."},vag_dpf_regen:{name:"\u0422\u0440\u0438\u0433\u0433\u0435\u0440 \u0441\u0435\u0440\u0432\u0438\u0441\u043d\u043e\u0439 \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 DPF (VAG)",desc:"\u0417\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0446\u0438\u043a\u043b \u0441\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0441\u0430\u0436\u0438 \u0432 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u043c \u0441\u0430\u0436\u0435\u0432\u043e\u043c \u0444\u0438\u043b\u044c\u0442\u0440\u0435 (DPF)."},bmw_dpf_regen:{name:"\u0422\u0440\u0438\u0433\u0433\u0435\u0440 \u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 DPF (BMW)",desc:"\u0417\u0430\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u042d\u0411\u0423 DDE \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443 \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0441\u0430\u0436\u0435\u0432\u043e\u0433\u043e \u0444\u0438\u043b\u044c\u0442\u0440\u0430."},psa_dpf_regen:{name:"\u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0430 \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044e DPF (Peugeot/Citro\xebn)",desc:"\u0417\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u0443\u044e \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044e DPF \u0434\u043b\u044f \u042d\u0411\u0423 \u0434\u0438\u0437\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0435\u0439 HDi."},bmw_bms_battery_register:{name:"\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0437\u0430\u043c\u0435\u043d\u044b \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 BMS (BMW)",desc:"\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u043c\u0435\u043d\u0443 \u043d\u043e\u0432\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 DME/DDE."},mb_bms_battery_register:{name:"\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0438 \u0441\u0431\u0440\u043e\u0441 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 (Mercedes-Benz)",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0441\u0447\u0435\u0442\u0447\u0438\u043a \u0441\u0442\u0430\u0440\u0435\u043d\u0438\u044f \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u0432 \u043c\u043e\u0434\u0443\u043b\u0435 SAM \u043f\u043e\u0441\u043b\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043d\u043e\u0432\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438."},vag_sas_calibrate:{name:"\u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0443\u0433\u043b\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 (SAS) (VAG)",desc:"\u041a\u0430\u043b\u0438\u0431\u0440\u0443\u0435\u0442 \u043d\u0443\u043b\u0435\u0432\u0443\u044e \u0442\u043e\u0447\u043a\u0443 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0443\u0433\u043b\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 G85 \u0434\u043b\u044f \u042d\u0411\u0423 ABS/ESP."},toyota_sas_calibrate:{name:"\u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u0443\u0433\u043b\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 (Toyota)",desc:"\u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0443 \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0443\u0433\u043b\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043e\u043b\u0435\u0441\u0430 \u0432 \u042d\u0411\u0423 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u043a\u043e\u043b\u044c\u0436\u0435\u043d\u0438\u044f."},generic_tba_adapt:{name:"\u0412\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u0435 \u0438 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u044f \u043a\u043e\u0440\u043f\u0443\u0441\u0430 \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438",desc:"\u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0433\u043e \u043a\u043e\u0440\u043f\u0443\u0441\u0430 \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438 \u0432 \u042d\u0411\u0423 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f."},epb_service_reset:{name:"\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0431\u0440\u043e\u0441 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f EPB",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0439 \u0441\u0447\u0435\u0442\u0447\u0438\u043a \u0438\u0437\u043d\u043e\u0441\u0430 \u0441\u0443\u043f\u043f\u043e\u0440\u0442\u0430 \u0441\u0442\u043e\u044f\u043d\u043e\u0447\u043d\u043e\u0433\u043e \u0442\u043e\u0440\u043c\u043e\u0437\u0430 \u0438 \u043a\u0430\u043b\u0438\u0431\u0440\u0443\u0435\u0442 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u044b\u0439 \u0437\u0430\u0437\u043e\u0440."},vag_dsg_reset:{name:"\u0421\u0431\u0440\u043e\u0441 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u043a\u043e\u0440\u043e\u0431\u043a\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0447 DSG (VAG)",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0442\u043e\u0447\u043a\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u044f \u0438 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u043a\u043b\u0430\u043f\u0430\u043d\u043e\u0432 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u0434\u043b\u044f DSG/S-Tronic."},bmw_zf_reset:{name:"\u0421\u0431\u0440\u043e\u0441 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u043a\u043e\u0440\u043e\u0431\u043a\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0447 ZF 8HP (BMW)",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u0440\u043e\u0431\u043a\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0447 EGS \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f."},bmw_brake_fluid_reset:{name:"\u0421\u0431\u0440\u043e\u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u043e\u0439 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 (BMW)",desc:"\u0421\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0442\u0430\u0439\u043c\u0435\u0440 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043f\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e (CBS) \u043d\u0430 2 \u0433\u043e\u0434\u0430."},ford_injector_code:{name:"\u041a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u0430 \u0444\u043e\u0440\u0441\u0443\u043d\u043a\u0438 (Ford)",desc:"\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u0443\u0435\u0442 16-\u0437\u043d\u0430\u0447\u043d\u044b\u0435 \u043a\u043e\u0434\u044b IQA \u0434\u043b\u044f \u0434\u0438\u0437\u0435\u043b\u044c\u043d\u044b\u0445 \u0444\u043e\u0440\u0441\u0443\u043d\u043e\u043a \u0432 PCM."},bmw_injector_code:{name:"\u041a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0430\u0441\u0445\u043e\u0434\u0430 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u044b\u0445 \u0444\u043e\u0440\u0441\u0443\u043d\u043e\u043a (BMW)",desc:"\u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0438 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0434\u043b\u044f \u0437\u0430\u043c\u0435\u043d\u0435\u043d\u043d\u044b\u0445 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u044b\u0445 \u0444\u043e\u0440\u0441\u0443\u043d\u043e\u043a \u0432 DME."},generic_headlight_aim:{name:"\u041a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u0430\u0432\u0442\u043e\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043e\u0440\u0430 \u0444\u0430\u0440",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0435 \u043d\u0443\u043b\u0435\u0432\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0435\u0439 \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0444\u0430\u0440."},bmw_12v_battery_reg:{name:"\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 12 \u0412 (BMW)",desc:"\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u043c\u0435\u043d\u0443 \u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0430\u0440\u0442\u0435\u0440\u043d\u043e\u0439/\u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 AGM \u0432 PCU."},vag_comfort_turn_signal:{name:"\u041a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u044b\u0439 \u0441\u0447\u0435\u0442\u0447\u0438\u043a \u043c\u0438\u0433\u0430\u043d\u0438\u0439 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 (VAG)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0446\u0438\u043a\u043b\u043e\u0432 \u043c\u0438\u0433\u0430\u043d\u0438\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u0438\u043a\u0430 \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 3, 4 \u0438\u043b\u0438 5."},vag_coming_home_duration:{name:"\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u0432\u0445\u043e\u0434\u0435/\u0432\u044b\u0445\u043e\u0434\u0435 \u0438\u0437 \u0434\u043e\u043c\u0430 (VAG)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0442\u0430\u0439\u043c\u0435\u0440 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0444\u0430\u0440 \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u0438\u0440\u0430\u043d\u0438\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f (10\u201360 \u0441)."},vag_remote_windows:{name:"\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0442\u0435\u043a\u043b\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u0438\u043a\u0430\u043c\u0438 (VAG)",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0442\u0435\u043a\u043b\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u0438\u043a\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u0436\u0430\u0442\u0438\u044f \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0431\u0440\u0435\u043b\u043e\u043a\u0430."},vag_auto_lock_15kmh:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u0432\u0435\u0440\u0435\u0439 \u043d\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 15 \u043a\u043c/\u0447 (VAG)",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u0435\u0442 \u0432\u0441\u0435 \u0434\u0432\u0435\u0440\u0438, \u043a\u043e\u0433\u0434\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442 15 \u043a\u043c/\u0447."},vag_sfd_unlock_prep:{name:"\u041f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u0437\u0430\u0449\u0438\u0442\u044b \u0448\u043b\u044e\u0437\u0430 SFD (VAG 2020+)",desc:"\u041f\u043e\u0434\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0441\u0435\u0430\u043d\u0441 \u0442\u043e\u043a\u0435\u043d\u0430 \u0448\u043b\u044e\u0437\u0430 MQB-evo SFD \u0434\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0438 \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u043d\u044b\u0445 DID."},bmw_asd_deactivate:{name:"\u0414\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f Active Sound Design (ASD) (BMW)",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0437\u0432\u0443\u043a \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f, \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u043c\u044b\u0439 \u0447\u0435\u0440\u0435\u0437 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0441\u0430\u043b\u043e\u043d\u0430."},bmw_comfort_turn_signal:{name:"\u041a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u044b\u0439 \u0441\u0447\u0435\u0442\u0447\u0438\u043a \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432 (BMW)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u043e\u0432 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0432 \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435 (\u043e\u0442 1 \u0434\u043e 5 \u043c\u0438\u0433\u0430\u043d\u0438\u0439)."},bmw_mirror_fold_lock:{name:"\u0417\u0435\u0440\u043a\u0430\u043b\u043e \u0441 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u044b\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043e\u043c, \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0449\u0435\u0435\u0441\u044f \u0441 \u0437\u0430\u043c\u043a\u043e\u043c (BMW)",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043a\u043e\u0432\u044b\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u0438\u0440\u0430\u043d\u0438\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},toyota_coming_home_duration:{name:"\u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0444\u0430\u0440/\u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0434\u043e\u043c\u043e\u0439 (Toyota)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0442\u0430\u0439\u043c\u0435\u0440 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0444\u0430\u0440 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f (30\u2013120 \u0441)."},toyota_lane_change_flash:{name:"\u0421\u0447\u0435\u0442\u0447\u0438\u043a \u043c\u0438\u0433\u0430\u043d\u0438\u0439 \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f (Toyota)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0446\u0438\u043a\u043b\u043e\u0432 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u043c\u0438\u0433\u0430\u043b\u043a\u0438 \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435."},toyota_remote_window_close:{name:"\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0435\u043a\u043b\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u0438\u043a\u043e\u0432 (Toyota)",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0437\u0430\u043a\u0440\u044b\u0442\u044c \u0432\u0441\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0442\u0435\u043a\u043b\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u0438\u043a\u0438, \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044f \u043a\u043d\u043e\u043f\u043a\u0443 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0437\u0430\u043c\u043a\u0430."},toyota_autolock_behavior:{name:"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0440\u0430\u043d\u0438\u044f/\u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0434\u0432\u0435\u0440\u0435\u0439 (Toyota)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0434\u0432\u0435\u0440\u0438 (\u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u0438\u0437 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f P \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f > 20 \u043a\u043c/\u0447)."},toyota_approach_welcome_lights:{name:"\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043e\u0433\u043d\u0438 \u0441 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0435\u0439 Smart Key (Toyota)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u0441\u0430\u043b\u043e\u043d\u0430/\u0441\u0430\u043b\u043e\u043d\u0430 \u043f\u0440\u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0438 \u0441\u043c\u0430\u0440\u0442-\u043a\u043b\u044e\u0447\u0430 \u043a \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044e."},hyundai_autolock_behavior:{name:"\u0420\u0435\u0436\u0438\u043c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438/\u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0434\u0432\u0435\u0440\u0435\u0439 (Hyundai/Kia)",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u0438 \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u0438\u043b\u0438 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0438 \u043e\u0442\u043f\u0438\u0440\u0430\u0435\u0442 \u0438\u0445 \u043f\u0440\u0438 \u043d\u0430\u0436\u0430\u0442\u0438\u0438 P \u0438\u043b\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},hyundai_window_remote:{name:"\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435/\u0437\u0430\u043a\u0440\u044b\u0442\u0438\u0435 \u043e\u043a\u043e\u043d (Hyundai/Kia)",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u043e\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044c \u043e\u043a\u043d\u0430 \u0432\u0432\u0435\u0440\u0445/\u0432\u043d\u0438\u0437 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043a\u043d\u043e\u043f\u043e\u043a \u0441\u043c\u0430\u0440\u0442-\u0431\u0440\u0435\u043b\u043e\u043a\u0430."},hyundai_sport_mode_memory:{name:"\u041f\u0430\u043c\u044f\u0442\u044c \u0432\u044b\u0431\u043e\u0440\u0430 \u0440\u0435\u0436\u0438\u043c\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f (Hyundai/Kia)",desc:"\u0417\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f (\u0421\u043f\u043e\u0440\u0442/\u042d\u043a\u043e) \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f."},tesla_charge_limit_custom:{name:"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430 \u0437\u0430\u0440\u044f\u0434\u0430 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 (Tesla)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u0437\u0430\u0440\u044f\u0434\u0430 \u0432\u044b\u0441\u043e\u043a\u043e\u0432\u043e\u043b\u044c\u0442\u043d\u043e\u0439 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u043d\u043e\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e (80\xa0% \u0432 \u0434\u0435\u043d\u044c/100\xa0% \u0432 \u043f\u043e\u0435\u0437\u0434\u043a\u0435)."},tesla_mirror_fold_lock:{name:"\u0417\u0435\u0440\u043a\u0430\u043b\u043e \u0441 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043d\u0438\u0435\u043c \u0438 \u0437\u0430\u043c\u043a\u043e\u043c Walk-Away Lock (Tesla)",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043a\u043e\u0432\u044b\u0435 \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u043f\u0440\u0438 \u0441\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u0438 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u043a\u043b\u044e\u0447\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430."},nissan_coming_home:{name:"\u041f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u043e\u0439 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0444\u0430\u0440 (Nissan)",desc:"\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0444\u0430\u0440\u044b \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u043c\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 30 \u0441\u0435\u043a\u0443\u043d\u0434 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0445\u043e\u0434\u0430 \u0438\u0437 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f Nissan."},nissan_lane_change_flash:{name:"\u0421\u0447\u0435\u0442\u0447\u0438\u043a \u043c\u0438\u0433\u0430\u043d\u0438\u0439 \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 Tap-to-Pass (Nissan)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u043e\u0432 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u043f\u0440\u0438 \u043d\u0430\u0436\u0430\u0442\u0438\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f \u0441\u0432\u0435\u0442\u0430."},nissan_autolock_behavior:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0437\u0430\u043c\u043e\u043a \u0434\u0432\u0435\u0440\u0435\u0439 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 (Nissan)",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u043f\u0438\u0440\u0430\u0435\u0442 \u0432\u0441\u0435 \u0434\u0432\u0435\u0440\u0438, \u043a\u043e\u0433\u0434\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 24 \u043a\u043c/\u0447."},nissan_window_remote:{name:"\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0442\u0435\u043a\u043b\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u0438\u043a\u0430\u043c\u0438 \u0441 \u0431\u0440\u0435\u043b\u043e\u043a\u0430 (Nissan)",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442/\u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0435 \u043e\u043a\u043d\u0430 \u0434\u043e\u043b\u0433\u0438\u043c \u043d\u0430\u0436\u0430\u0442\u0438\u0435\u043c \u043a\u043d\u043e\u043f\u043a\u0438 \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0431\u0440\u0435\u043b\u043e\u043a\u0430."},nissan_seatbelt_chime_mute:{name:"\u0417\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043d\u0435\u043f\u0440\u0438\u0441\u0442\u0435\u0433\u043d\u0443\u0442\u044b\u0445 \u0440\u0435\u043c\u043d\u044f\u0445 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 (Nissan)",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0438\u0439\u0441\u044f \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043d\u0435\u043f\u0440\u0438\u0441\u0442\u0435\u0433\u043d\u0443\u0442\u044b\u0445 \u0440\u0435\u043c\u043d\u044f\u0445 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438, \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044f \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0437\u043d\u0430\u0447\u043e\u043a \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0430."},porsche_sport_chrono_launch:{name:"\u041f\u0440\u043e\u0444\u0438\u043b\u044c \u0440\u0435\u0430\u043a\u0446\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c Sport Chrono (Porsche)",desc:"\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u043e\u0431\u043e\u0440\u043e\u0442\u043e\u0432 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c \u0442\u0440\u0430\u043d\u0441\u043c\u0438\u0441\u0441\u0438\u0438 PDK \u0438 \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u0435 \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u044f."},porsche_pasm_default:{name:"\u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0440\u0435\u0436\u0438\u043c\u0430 \u043f\u043e\u0434\u0432\u0435\u0441\u043a\u0438 PASM (Porsche)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0436\u0435\u0441\u0442\u043a\u043e\u0441\u0442\u044c \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u043e\u0434\u0432\u0435\u0441\u043a\u0438 PASM \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},porsche_exhaust_flap:{name:"\u0421\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u0430\u044f \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0430 \u0432\u044b\u0445\u043b\u043e\u043f\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0441 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c (Porsche)",desc:"\u0417\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u044b\u0435 \u043a\u043b\u0430\u043f\u0430\u043d\u044b \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c\u0438 \u043d\u0430 100% \u0432\u043e \u0432\u0441\u0435\u0445 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430\u0445 \u043e\u0431\u043e\u0440\u043e\u0442\u043e\u0432."},audi_drive_select_memory:{name:"\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043f\u0430\u043c\u044f\u0442\u0438 \u0440\u0435\u0436\u0438\u043c\u0430 Audi Drive Select (Audi)",desc:"\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0432\u044b\u0431\u043e\u0440\u0430 \u0434\u0438\u0441\u043a\u0430 (\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439/\u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439) \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430."},audi_virtual_cockpit_themes:{name:"\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u0430\u043a\u0435\u0442 Audi Virtual Cockpit S/RS Sport (Audi)",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0442\u0430\u0445\u043e\u043c\u0435\u0442\u0440\u0430 S/RS \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u0430\u0431\u0438\u043d\u0435."},vag_scandinavian_drl:{name:"\u0421\u043a\u0430\u043d\u0434\u0438\u043d\u0430\u0432\u0441\u043a\u0438\u0439 \u0440\u0435\u0436\u0438\u043c \u0414\u0425\u041e (VAG)",desc:"\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0435 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u043d\u0438\u0445 \u0444\u043e\u043d\u0430\u0440\u0435\u0439 \u0440\u044f\u0434\u043e\u043c \u0441 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u043c\u0438 \u0414\u0425\u041e."},vag_mirror_dip_reverse:{name:"\u041f\u0440\u043e\u0432\u0430\u043b \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430 \u043f\u0440\u0438 \u0437\u0430\u0434\u043d\u0435\u043c \u0445\u043e\u0434\u0435 (VAG)",desc:"\u041e\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0437\u0435\u0440\u043a\u0430\u043b\u043e \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430 \u0432\u043d\u0438\u0437 \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0434\u043d\u0435\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438."},vag_dynamic_turn_signal:{name:"\u0414\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439/\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 (VAG)",desc:"\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u0438\u0441\u0443\u043d\u043e\u043a \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u044b\u0445 \u043c\u0438\u0433\u0430\u043d\u0438\u0439 \u043d\u0430 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u044b\u0445 \u043c\u043e\u0434\u0443\u043b\u044f\u0445 \u0437\u0430\u0434\u043d\u0438\u0445 \u0444\u043e\u043d\u0430\u0440\u0435\u0439."},vag_seatbelt_warning_duration:{name:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043d\u0435\u043f\u0440\u0438\u0441\u0442\u0435\u0433\u043d\u0443\u0442\u044b\u0445 \u0440\u0435\u043c\u043d\u044f\u0445 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 (VAG)",desc:"\u0421\u043e\u043a\u0440\u0430\u0449\u0430\u0435\u0442 \u0438\u043b\u0438 \u043f\u043e\u0434\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0438\u0439\u0441\u044f \u0442\u0430\u0439\u043c\u0435\u0440 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043d\u0435\u043f\u0440\u0438\u0441\u0442\u0435\u0433\u043d\u0443\u0442\u044b\u0445 \u0440\u0435\u043c\u043d\u044f\u0445 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438."},vag_sunroof_remote:{name:"\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043e\u043c \u043b\u044e\u043a\u0430 \u043d\u0430 \u043a\u0440\u044b\u0448\u0435 (VAG)",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0438 \u043d\u0430\u043a\u043b\u043e\u043d\u044f\u0442\u044c \u043f\u0430\u043d\u043e\u0440\u0430\u043c\u043d\u044b\u0439 \u043b\u044e\u043a \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u0431\u0440\u0435\u043b\u043e\u043a\u0430."},vag_acc_distance_preset:{name:"\u0410\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u044b\u0439 \u043a\u0440\u0443\u0438\u0437-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c ACC \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e, \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0438 (VAG)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u0434\u0430\u0440 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e, \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0437\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u0435\u043c \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f."},vag_infotainment_startup_logo:{name:"\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043b\u043e\u0433\u043e\u0442\u0438\u043f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u043e-\u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b (VAG)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u043b\u043e\u0433\u043e\u0442\u0438\u043f \u0437\u0430\u0441\u0442\u0430\u0432\u043a\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u043e-\u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b (R-Line, GTI, RS)."},vag_ambient_color_cycle:{name:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0446\u0432\u0435\u0442\u043e\u0432\u043e\u0433\u043e \u0441\u043f\u0435\u043a\u0442\u0440\u0430 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f (VAG)",desc:"\u0420\u0430\u0441\u0448\u0438\u0440\u044f\u0435\u0442 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u043f\u0430\u043b\u0438\u0442\u0440\u044b \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0432 \u043c\u0435\u043d\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},vag_service_interval_custom:{name:"\u041f\u043e\u0440\u043e\u0433\u043e\u0432\u043e\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0434\u043b\u044f \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0438 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f (VAG)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u0446\u0435\u043b\u0438 \u0432 \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u0430\u0445 \u0438 \u0434\u043d\u044f\u0445 \u0434\u043b\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e\u0431 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0438."},vag_door_handle_lights_reverse:{name:"\u041f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u0430 \u043d\u0430\u0440\u0443\u0436\u043d\u043e\u0439 \u0440\u0443\u0447\u043a\u0438 \u0434\u0432\u0435\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u043f\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0437\u0430\u0434\u043d\u0438\u043c \u0445\u043e\u0434\u043e\u043c (VAG)",desc:"\u041f\u043e\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u044b\u0435 \u0444\u043e\u043d\u0430\u0440\u0438 \u043d\u0430 \u0434\u0432\u0435\u0440\u043d\u043e\u0439 \u0440\u0443\u0447\u043a\u0435 \u043f\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0437\u0430\u0434\u043d\u0438\u043c \u0445\u043e\u0434\u043e\u043c \u0434\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u0430 \u0437\u0435\u043c\u043b\u0435."},bmw_msport_exhaust_burble:{name:"M-Sport \u0412\u044b\u0445\u043b\u043e\u043f\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 Burble & Pop Intensity (BMW)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0437\u0432\u0443\u043a\u0430 \u0431\u043e\u0440\u043c\u043e\u0442\u0430\u043d\u0438\u044f \u0432 \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435."},bmw_welcome_light_sequence:{name:"\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0441\u0432\u0435\u0442\u043e\u0432\u0430\u044f \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044f (BMW)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u0443\u044e \u0444\u0430\u0440\u0443 \u0438 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \xab\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u0433\u043b\u0430\u0437\u043a\u0438\xbb."},bmw_service_history_menu:{name:"\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043c\u0435\u043d\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0445 \u0443\u0441\u043b\u0443\u0433 (BMW)",desc:"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u043c\u0435\u043d\u044e \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0441\u0435\u0440\u0432\u0438\u0441\u043d\u043e\u0439 \u043a\u043d\u0438\u0436\u043a\u0438 iDrive \u043d\u0430 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u043c \u0434\u0438\u0441\u043f\u043b\u0435\u0435."},bmw_hud_speed_display:{name:"\u041d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0433\u043e \u0441\u043f\u0438\u0434\u043e\u043c\u0435\u0442\u0440\u0430 \u043d\u0430 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 (BMW)",desc:"\u041f\u0440\u043e\u0435\u0446\u0438\u0440\u0443\u0435\u0442 \u0446\u0438\u0444\u0440\u043e\u0432\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439."},bmw_cornering_lights_fog:{name:"\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0435 \u0444\u0430\u0440\u044b \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432 (BMW)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u043c\u0430\u043d\u043d\u044b\u0439 \u0444\u043e\u043d\u0430\u0440\u044c \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0438\u043b\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0435 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u043d\u0430 \u043c\u0430\u043b\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438."},bmw_easy_entry_steering:{name:"\u0420\u0443\u043b\u0435\u0432\u0430\u044f \u043a\u043e\u043b\u043e\u043d\u043a\u0430 \u0441 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043d\u0438\u0435\u043c Easy Entry (BMW)",desc:"\u0423\u0431\u0438\u0440\u0430\u0435\u0442 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0440\u0443\u043b\u0435\u0432\u043e\u0435 \u043a\u043e\u043b\u0435\u0441\u043e \u0432\u0432\u0435\u0440\u0445 \u043f\u0440\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0434\u043b\u044f \u043e\u0431\u043b\u0435\u0433\u0447\u0435\u043d\u0438\u044f \u0432\u044b\u0445\u043e\u0434\u0430."},bmw_bluetooth_audio_enable:{name:"\u0423\u043b\u0443\u0447\u0448\u0435\u043d\u043d\u0430\u044f \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u043f\u043e\u0442\u043e\u043a\u043e\u0432\u043e\u0433\u043e \u0430\u0443\u0434\u0438\u043e \u043f\u043e Bluetooth (BMW)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0431\u0435\u0441\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u0443\u044e \u043f\u043e\u0442\u043e\u043a\u043e\u0432\u0443\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u043c\u0443\u0437\u044b\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 A2DP Bluetooth \u0432 iDrive HU_ENTRYNAV."},bmw_door_handle_lights_reverse:{name:"\u041f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u0430 \u043b\u0443\u0436\u0438 \u043d\u0430 \u043d\u0430\u0440\u0443\u0436\u043d\u044b\u0445 \u0434\u0432\u0435\u0440\u043d\u044b\u0445 \u0440\u0443\u0447\u043a\u0430\u0445 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0445\u043e\u0434\u0430 (BMW)",desc:"\u0417\u0430\u0433\u043e\u0440\u0430\u0435\u0442\u0441\u044f \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434 \u043d\u0430 \u0434\u0432\u0435\u0440\u043d\u043e\u0439 \u0440\u0443\u0447\u043a\u0435 \u043f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0434\u043d\u0435\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438."},toyota_auto_headlight_threshold:{name:"\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0432\u043d\u0435\u0448\u043d\u0435\u0439 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u0430\u0440 (Toyota)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u0441\u0443\u043c\u0435\u0440\u0435\u043a \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0444\u0430\u0440."},toyota_turn_signal_click_volume:{name:"\u0413\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 (Toyota)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u0440\u0435\u043b\u0435 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 (\u043d\u0438\u0437\u043a\u0430\u044f, \u0441\u0440\u0435\u0434\u043d\u044f\u044f, \u0432\u044b\u0441\u043e\u043a\u0430\u044f)."},toyota_smart_key_approach_lights:{name:"\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u0430 \u043b\u0443\u0436 \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044f \u0441\u043c\u0430\u0440\u0442-\u043a\u043b\u044e\u0447\u0430 (Toyota)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u0443 \u0437\u0435\u0440\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u043b\u0443\u0436, \u043a\u043e\u0433\u0434\u0430 \u0441\u043c\u0430\u0440\u0442-\u043a\u043b\u044e\u0447 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0430\u0435\u0442\u0441\u044f \u043a \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044e."},toyota_rear_hatch_behavior:{name:"\u041b\u043e\u0433\u0438\u043a\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f/\u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u0437\u0430\u0434\u043d\u0435\u0439 \u0434\u0432\u0435\u0440\u0438 \u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043e\u043c (Toyota)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0436\u0430\u0442\u0438\u044f \u043a\u043d\u043e\u043f\u043a\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u0430 \u043b\u044e\u043a\u0430 \u043d\u0430 \u043f\u0443\u043b\u044c\u0442\u0435 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u043d\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438."},toyota_open_windows_smart_key:{name:"\u0423\u0434\u0430\u043b\u0435\u043d\u043d\u044b\u0439 \u0441\u043c\u0430\u0440\u0442-\u043a\u043b\u044e\u0447 \u0441 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u043d\u0438\u0435\u043c \u043e\u043a\u043d\u0430 \u0438 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043d\u0430\u0436\u0430\u0442\u0438\u0435\u043c (Toyota)",desc:"\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0432\u0441\u0435 \u043e\u043a\u043d\u0430, \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044f \u043a\u043d\u043e\u043f\u043a\u0443 \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u043e\u0439 \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438."},toyota_interior_light_dim_timer:{name:"\u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u0438\u044f \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0441\u0430\u043b\u043e\u043d\u0430 (Toyota)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0442\u0430\u0439\u043c\u0435\u0440 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u0444\u043e\u043d\u0430 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u0434\u0432\u0435\u0440\u0438."},toyota_panic_alarm_remote:{name:"\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0431\u0440\u0435\u043b\u043e\u043a \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439 \u0442\u0440\u0435\u0432\u043e\u0436\u043d\u043e\u0439 \u0441\u0438\u0440\u0435\u043d\u044b (Toyota)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0438\u043b\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0441\u0438\u0433\u043d\u0430\u043b \u0442\u0440\u0435\u0432\u043e\u0433\u0438 \u043f\u0440\u0438 \u043f\u0430\u043d\u0438\u043a\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u043a\u043b\u044e\u0447\u0430."},toyota_eco_drive_indicator:{name:"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u043e\u043d\u044b \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432 ECO Drive (Toyota)",desc:"\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0447\u0438\u0441\u0442\u0443\u044e \u043f\u043e\u043b\u043e\u0441\u0443 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f \u0438 \u0441\u0432\u0435\u0442\u043e\u0432\u043e\u0439 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043d\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438."},hyundai_coming_home_duration:{name:"\u0422\u0430\u0439\u043c\u0435\u0440 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0444\u0430\u0440 Escort (Hyundai/Kia)",desc:"\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u043c \u0431\u043b\u0438\u0436\u043d\u0438\u0439 \u0441\u0432\u0435\u0442 \u0444\u0430\u0440 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0445\u043e\u0434\u0430 \u0438\u0437 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},hyundai_drl_menu_toggle:{name:"\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043c\u0435\u043d\u044e \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0445\u043e\u0434\u043e\u0432\u044b\u0445 \u043e\u0433\u043d\u0435\u0439 (Hyundai/Kia)",desc:"\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f/\u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f DRL \u0432 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432."},hyundai_welcome_sequence:{name:"\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u0430 \u0438 \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u0438\u0435 \u0437\u0435\u0440\u043a\u0430\u043b \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u044f \u043a \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u043a\u043b\u044e\u0447\u0443 (Hyundai/Kia)",desc:"\u0420\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043e\u043c \u0438 \u043f\u043e\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u043d\u044b\u0435 \u0440\u0443\u0447\u043a\u0438 \u043f\u0440\u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0438."},hyundai_interior_light_delay:{name:"\u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043b\u0430\u043c\u043f\u044b \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0441\u0430\u043b\u043e\u043d\u0430 (Hyundai/Kia)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0442\u0430\u0439\u043c\u0435\u0440 \u043f\u0435\u0440\u0435\u0434 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438 \u0437\u0430\u0440\u044f\u0434\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0438."},hyundai_heat_pump_efficiency:{name:"\u0420\u0435\u0436\u0438\u043c \u0442\u0435\u0440\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u043f\u043b\u043e\u0432\u043e\u0433\u043e \u043d\u0430\u0441\u043e\u0441\u0430 EV Climate (Hyundai/Kia)",desc:"\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u044d\u043d\u0435\u0440\u0433\u043e\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0442\u0435\u043f\u043b\u043e\u0432\u043e\u0433\u043e \u043d\u0430\u0441\u043e\u0441\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0432 \u0445\u043e\u043b\u043e\u0434\u043d\u0443\u044e \u0437\u0438\u043c\u043d\u044e\u044e \u043f\u043e\u0433\u043e\u0434\u0443."},tesla_track_mode_params:{name:"\u0421\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0436\u0438\u043c\u0430 \u0442\u0440\u0435\u043a\u0430 \u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 (Tesla)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u043e\u0434\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0433\u043e/\u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0438 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0432 \u0441\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044e."},tesla_regen_brake_strength:{name:"\u041f\u0440\u043e\u0444\u0438\u043b\u044c \u0440\u0435\u043a\u0443\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 (Tesla)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u043f\u0440\u0438 \u043d\u0430\u0436\u0430\u0442\u0438\u0438 \u043f\u0435\u0434\u0430\u043b\u0438 \u0430\u043a\u0441\u0435\u043b\u0435\u0440\u0430\u0442\u043e\u0440\u0430."},tesla_walkaway_door_lock:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0432\u0435\u0440\u043d\u043e\u0439 \u0437\u0430\u043c\u043e\u043a \u0441 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u043c \u043a\u043b\u044e\u0447\u043e\u043c (Tesla)",desc:"\u0417\u0430\u043f\u0438\u0440\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u0438 \u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0437\u0432\u0443\u043a\u043e\u0432\u044b\u043c \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u043c, \u043a\u043e\u0433\u0434\u0430 \u043a\u043b\u044e\u0447 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0443\u0445\u043e\u0434\u0438\u0442."},tesla_acceleration_boost_unlock:{name:"\u041f\u0440\u043e\u0444\u0438\u043b\u044c \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u043c\u0438\u0441\u0441\u0438\u0438 (Tesla)",desc:"\u0423\u043b\u0443\u0447\u0448\u0430\u0435\u0442 \u0440\u0435\u0430\u043a\u0446\u0438\u044e \u0438\u043d\u0432\u0435\u0440\u0442\u043e\u0440\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f, \u0443\u0441\u043a\u043e\u0440\u044f\u044f \u0440\u0430\u0437\u0433\u043e\u043d \u0441 0 \u0434\u043e 100 \u043a\u043c/\u0447."},tesla_interior_ambient_color:{name:"\u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0446\u0432\u0435\u0442\u0430 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435 \u0434\u043b\u044f \u043d\u043e\u0433 \u0432 \u0441\u0430\u043b\u043e\u043d\u0435 (Tesla)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0446\u0432\u0435\u0442\u043e\u0432\u0443\u044e \u043f\u0430\u043b\u0438\u0442\u0440\u0443 RGB \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u043e\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u043d\u043e\u0433."},audi_matrix_led_animation:{name:"\u041c\u0430\u0442\u0440\u0438\u0447\u043d\u044b\u0435 \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u044b\u0435 \u0444\u0430\u0440\u044b Dynamic Welcome Light Dance (Audi)",desc:"\u0412\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0441\u0432\u0435\u0442\u043e\u0432\u0443\u044e \u0445\u043e\u0440\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u043f\u0440\u0438 \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},audi_mmi_startup_screen:{name:"\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u043c\u0430 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u043e\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430 MMI (Audi)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044e \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430 MMI (S/RS/e-tron)."},audi_drive_select_efficiency:{name:"\u041f\u0440\u043e\u0444\u0438\u043b\u044c Efficiency Driving \u0432 Audi Drive Select (Audi)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0440\u0435\u0436\u0438\u043c \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0438 \u0442\u043e\u043f\u043b\u0438\u0432\u0430 \u0432 \u043e\u043f\u0446\u0438\u044f\u0445 Drive Select."},audi_laptimer_boost_display:{name:"\u041d\u0430\u043a\u043b\u0430\u0434\u043a\u0430 \u043d\u0430 \u0442\u0430\u0439\u043c\u0435\u0440 \u043a\u0440\u0443\u0433\u0430 \u0438 \u043c\u0430\u043d\u043e\u043c\u0435\u0442\u0440 \u0442\u0443\u0440\u0431\u043e\u0431\u0430\u0440\u0430 (Audi)",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0442\u0430\u0439\u043c\u0435\u0440 \u043a\u0440\u0443\u0433\u0430 \u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0442\u0443\u0440\u0431\u043e\u043d\u0430\u0434\u0434\u0443\u0432\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u0430\u0431\u0438\u043d\u0435."},audi_needle_sweep_gauge:{name:"\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0445\u043e\u0434\u0430 \u0441\u0442\u0440\u0435\u043b\u043a\u0438 \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043c\u0430\u043d\u043e\u043c\u0435\u0442\u0440\u0430 (Audi)",desc:"\u041f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u043f\u043e\u043b\u043d\u0443\u044e \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u0441\u0442\u0440\u0435\u043b\u043e\u043a \u0442\u0430\u0445\u043e\u043c\u0435\u0442\u0440\u0430 \u0438 \u0441\u043f\u0438\u0434\u043e\u043c\u0435\u0442\u0440\u0430."},skoda_coming_home_lights:{name:"\u0422\u0430\u0439\u043c\u0435\u0440 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u0432\u044b\u0445\u043e\u0434\u0435 \u0438\u0437 \u0434\u043e\u043c\u0430/\u043f\u0440\u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0434\u043e\u043c\u043e\u0439 (Skoda)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0442\u0430\u0439\u043c\u0435\u0440 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0444\u0430\u0440 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0435\u0437\u0434\u0430 \u0438\u0437 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},skoda_comfort_turn_signal:{name:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u043e\u0432 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0430 (Skoda)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043c\u0438\u0433\u0430\u043d\u0438\u0439 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0432 \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435 \u043e\u0442 3 \u0434\u043e 5."},cupra_sport_display_menu:{name:"\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 Cupra Performance \u0438 \u043c\u0435\u043d\u044e G-\u043c\u0435\u0442\u0440\u0430 (Cupra)",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u0435\u043b\u044c \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043a\u0438, \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 \u0432 \u043a\u0412\u0442 \u0438 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u043c\u0430\u0441\u043b\u0430."},cupra_virtual_cockpit_copper:{name:"\u0410\u043a\u0446\u0435\u043d\u0442\u043d\u0430\u044f \u0433\u0440\u0430\u0444\u0438\u043a\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438 \u043d\u0430 \u043c\u0435\u0434\u043d\u0443\u044e \u0442\u0435\u043c\u0443 (Cupra)",desc:"\u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442 \u0444\u0438\u0440\u043c\u0435\u043d\u043d\u0443\u044e \u043c\u0435\u0434\u043d\u043e-\u043c\u0435\u0442\u0430\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u043c\u0443 Cupra \u043a \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438."},vag_brake_disc_drying:{name:"\u0424\u0443\u043d\u043a\u0446\u0438\u044f \u043e\u0447\u0438\u0441\u0442\u043a\u0438/\u0441\u0443\u0448\u043a\u0438 \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u043e\u0433\u043e \u0434\u0438\u0441\u043a\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0434\u043e\u0436\u0434\u044f (VAG)",desc:"\u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u043a\u043e\u043b\u043e\u0434\u043a\u0438 \u0432\u043e \u0432\u043b\u0430\u0436\u043d\u0443\u044e \u043f\u043e\u0433\u043e\u0434\u0443 \u043a \u0441\u0443\u0445\u0438\u043c \u0440\u043e\u0442\u043e\u0440\u0430\u043c."},vag_tourist_mode_lights:{name:"\u0414\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u0430 \u0441\u0432\u0435\u0442\u0430 \u0444\u0430\u0440 \u0432 \u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 (VAG)",desc:"\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0434\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u0443 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0441\u0432\u0435\u0442\u0430 \u0444\u0430\u0440 \u043c\u0435\u0436\u0434\u0443 \u043b\u0435\u0432\u044b\u043c \u0438 \u043f\u0440\u0430\u0432\u044b\u043c \u0440\u0443\u043b\u0435\u043c \u0434\u043b\u044f \u0435\u0437\u0434\u044b \u0437\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0443."},vag_hood_warning_mute:{name:"\u041e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0437\u0432\u0443\u043a\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432 \u043f\u0440\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c \u043a\u0430\u043f\u043e\u0442\u0435 (VAG)",desc:"\u041f\u043e\u0434\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u044e\u0449\u0438\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432, \u043a\u043e\u0433\u0434\u0430 \u043a\u0430\u043f\u043e\u0442 \u043e\u0442\u043a\u0440\u044b\u0442."},vag_emergency_brake_hazard:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u0432\u0430\u0440\u0438\u0439\u043d\u0430\u044f \u0441\u0438\u0433\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u043c \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u0438 (VAG)",desc:"\u0411\u044b\u0441\u0442\u0440\u043e \u043c\u0438\u0433\u0430\u0435\u0442 \u0430\u0432\u0430\u0440\u0438\u0439\u043d\u0430\u044f \u0441\u0438\u0433\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0441 ABS."},vag_sunroof_comfort_open:{name:"\u041b\u043e\u0433\u0438\u043a\u0430 \u0431\u0440\u0435\u043b\u043a\u0430 \u043d\u0430\u043a\u043b\u043e\u043d\u0430/\u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043b\u044e\u043a\u0430 \u0432 \u043a\u0440\u044b\u0448\u0435 \u0441 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043e\u043c (VAG)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u043a\u043b\u044e\u0447\u0430 \u0434\u043b\u044f \u043d\u0430\u043a\u043b\u043e\u043d\u0430 \u0438\u043b\u0438 \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043b\u044e\u043a\u0430."},bmw_ecopro_display_variant:{name:"\u0421\u0442\u0438\u043b\u044c \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438 ECO PRO (BMW)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043d\u044e\u044e \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u043c\u0443 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 ECO PRO."},bmw_volume_bar_hud:{name:"\u041d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0448\u043a\u0430\u043b\u044b \u0443\u0440\u043e\u0432\u043d\u044f \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u0437\u0432\u0443\u043a\u0430 \u043d\u0430 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u0434\u0438\u0441\u043f\u043b\u0435\u0435 (BMW)",desc:"\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u043e\u0441\u0443 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u043f\u0440\u044f\u043c\u043e \u043d\u0430 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438 HUD."},bmw_anti_dazzle_mirror:{name:"\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u0445\u0440\u043e\u043c\u043d\u0430\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u0441\u043b\u0435\u043f\u043b\u044f\u044e\u0449\u0430\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u0438\u044f \u0437\u0435\u0440\u043a\u0430\u043b (BMW)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u0444\u043e\u0442\u043e\u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u0438\u044f \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u0432\u0438\u0434\u0430."},bmw_camera_pdc_warning_mute:{name:"PDC \u0438 \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u0437\u043e\u0440\u0430 (BMW)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043f\u0430\u0440\u043a\u043e\u0432\u043e\u0447\u043d\u044b\u0435 \u043a\u0430\u043c\u0435\u0440\u044b \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f."},toyota_pcs_distance_preset:{name:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0439 (PCS) \u0420\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043e\u043f\u043e\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e (Toyota)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0443\u044e \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0434\u0430\u0440\u0430 \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043f\u0440\u044f\u043c\u043e\u043c \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0438."},toyota_bsm_timing:{name:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0441\u043b\u0435\u043f\u044b\u0445 \u0437\u043e\u043d (BSM) \u0412\u0440\u0435\u043c\u044f \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f (Toyota)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0439 \u043b\u0430\u043c\u043f\u044b \u0431\u043e\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u0441\u043b\u0435\u043f\u043e\u0439 \u0437\u043e\u043d\u044b."},toyota_ac_noise_reduction:{name:"\u0420\u0435\u0436\u0438\u043c \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f \u0448\u0443\u043c\u0430 \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0430 \u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0441\u043e\u0440\u0430 \u043a\u043e\u043d\u0434\u0438\u0446\u0438\u043e\u043d\u0435\u0440\u0430 (Toyota)",desc:"\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0430 \u043a\u043e\u043d\u0434\u0438\u0446\u0438\u043e\u043d\u0435\u0440\u0430 \u0434\u043b\u044f \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u044f \u0442\u0438\u0448\u0438\u043d\u044b \u0432 \u0441\u0430\u043b\u043e\u043d\u0435."},toyota_sflow_control:{name:"\u0420\u0435\u0436\u0438\u043c S-Flow Smart Climate \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430 (Toyota)",desc:"\u041d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e\u0442\u043e\u043a \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u043a\u043e\u043d\u0434\u0438\u0446\u0438\u043e\u043d\u0435\u0440\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430 \u0437\u0430\u043d\u044f\u0442\u044b\u0435 \u0441\u0438\u0434\u0435\u043d\u044c\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u0432 \u0432\u0435\u0441\u0430."},toyota_relock_timeout:{name:"\u0422\u0430\u0439\u043c\u0435\u0440 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0439 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u043f\u043e\u0441\u043b\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u043e\u0439 \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 (Toyota)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u0441\u0435\u043a\u0443\u043d\u0434\u044b \u0434\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0434\u0432\u0435\u0440\u0435\u0439, \u0435\u0441\u043b\u0438 \u043d\u0438 \u043e\u0434\u043d\u0430 \u0434\u0432\u0435\u0440\u044c \u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f (30\u2013120 \u0441)."},lexus_mark_levinson_audio_profile:{name:"\u0410\u0443\u0434\u0438\u043e\u043f\u0440\u043e\u0444\u0438\u043b\u044c \u041c\u0430\u0440\u043a\u0430 \u041b\u0435\u0432\u0438\u043d\u0441\u043e\u043d\u0430 Surround Sound DSP (Lexus)",desc:"\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u0442\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u0443\u044e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0430\u043a\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443 \u0434\u043b\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u043e\u0432 \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u043a\u043b\u0430\u0441\u0441\u0430 Mark Levinson."},lexus_ev_mode_beeper_mute:{name:"\u0410\u043a\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u0434\u043b\u044f \u043d\u0438\u0437\u043a\u043e\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043f\u0435\u0448\u0435\u0445\u043e\u0434\u043d\u043e\u0433\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044f (Lexus)",desc:"\u041f\u043e\u0434\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u043d\u0435\u0448\u043d\u0438\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u0432 \u043d\u0438\u0437\u043a\u043e\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u043e\u043c \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435."},lexus_easy_access_seat:{name:"\u0420\u0443\u043b\u0435\u0432\u043e\u0435 \u043a\u043e\u043b\u0435\u0441\u043e \u0441 \u043b\u0435\u0433\u043a\u0438\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043e\u043c \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430 \u0441\u043f\u0438\u043d\u043a\u0438 \u0441\u0438\u0434\u0435\u043d\u044c\u044f (Lexus)",desc:"\u0421\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044f \u0441\u043f\u0438\u043d\u043a\u0430 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u0441\u0438\u0434\u0435\u043d\u044c\u044f \u0438 \u043e\u0442\u043a\u0438\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0440\u0443\u043b\u0435\u0432\u043e\u0435 \u043a\u043e\u043b\u0435\u0441\u043e \u0434\u043b\u044f \u043e\u0431\u043b\u0435\u0433\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u0430\u0434\u043a\u0438/\u0432\u044b\u0441\u0430\u0434\u043a\u0438."},nissan_epower_regen_mode:{name:"\u0420\u0435\u0436\u0438\u043c \u0440\u0435\u043a\u0443\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u044f \u043e\u0434\u043d\u043e\u0439 \u043f\u0435\u0434\u0430\u043b\u044c\u044e e-POWER (Nissan)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0437\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u0440\u0435\u043a\u0443\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u043c \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u0435\u0434\u0430\u043b\u0438 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e."},nissan_propilot_assist_timing:{name:"ProPILOT \u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u043e\u043c\u043e\u0449\u0438 \u043f\u0440\u0438 \u0446\u0435\u043d\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u043f\u043e\u043b\u043e\u0441\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f (Nissan)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0440\u0435\u0437\u043a\u043e\u0441\u0442\u044c \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0440\u0443\u043b\u0435\u0432\u043e\u0433\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f ProPILOT."},nissan_intelligent_around_view:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043e\u043a\u043d\u043e \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0430 \u043a\u0440\u0443\u0433\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u0437\u043e\u0440\u0430 \u043d\u0430 \u043d\u0438\u0437\u043a\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 (Nissan)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043a\u0430\u043c\u0435\u0440\u044b \u0441 \u043e\u0431\u0437\u043e\u0440\u043e\u043c \u043d\u0430 360 \u0433\u0440\u0430\u0434\u0443\u0441\u043e\u0432, \u043a\u043e\u0433\u0434\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0435 \u0434\u0430\u0442\u0447\u0438\u043a\u0438 \u043f\u0430\u0440\u043a\u043e\u0432\u043a\u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u044e\u0442 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f."},mazda_g_vectoring_display:{name:"\u0414\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440 G-Vectoring Control Plus (Mazda)",desc:"\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0433\u0440\u0430\u0444\u0438\u043a \u0432\u0435\u043a\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u0438 \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 GVC+ \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438."},mazda_ieloop_capacitor_monitor:{name:"i-ELOOP \u0418\u0437\u043c\u0435\u0440\u0438\u0442\u0435\u043b\u044c \u043a\u043e\u043d\u0434\u0435\u043d\u0441\u0430\u0442\u043e\u0440\u0430 \u0440\u0435\u043a\u0443\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0442\u043e\u0440\u043c\u043e\u0437\u0430 (Mazda)",desc:"\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0437\u0430\u0440\u044f\u0434\u0430 \u0438 \u0440\u0430\u0437\u0440\u044f\u0434\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043d\u0434\u0435\u043d\u0441\u0430\u0442\u043e\u0440\u0430 \u043d\u0430 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u043c \u044d\u043a\u0440\u0430\u043d\u0435."},mazda_smart_city_brake_sens:{name:"\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u044f Smart City (SCBS) (Mazda)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u044f \u043d\u0430 \u043d\u0438\u0437\u043a\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438."},subaru_eyesight_distance_preset:{name:"\u0420\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043a\u0440\u0443\u0438\u0437-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f EyeSight (Subaru)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u043a\u0440\u0443\u0438\u0437\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 \u0441\u0442\u0435\u0440\u0435\u043e\u043a\u0430\u043c\u0435\u0440\u044b \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435."},subaru_xmode_auto_engage:{name:"\u041f\u043e\u0440\u043e\u0433 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0442\u044f\u0433\u0438 \u0434\u043b\u044f \u0431\u0435\u0437\u0434\u043e\u0440\u043e\u0436\u044c\u044f X-Mode (Subaru)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u043f\u0440\u043e\u0431\u0443\u043a\u0441\u043e\u0432\u043a\u0438 \u043a\u043e\u043b\u0435\u0441 \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u0434\u0432\u043e\u0439\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 X-Mode."},subaru_steering_responsive_headlights:{name:"\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u044b\u0445 \u0444\u0430\u0440 (SRH) (Subaru)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0438\u043b\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u043e\u0432\u043e\u0440\u043e\u0442 \u0444\u0430\u0440."},genesis_sport_plus_mode:{name:"\u0422\u0440\u0430\u043d\u0441\u043c\u0438\u0441\u0441\u0438\u044f Sport+ \u0438 \u0440\u0435\u0436\u0438\u043c \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0434\u0432\u0435\u0441\u043a\u0438 (Genesis)",desc:"\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u044e ESC OFF, \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u043d\u0430 \u0442\u0440\u0435\u043a, \u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u043d\u0443\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443 \u0430\u043c\u043e\u0440\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u0432."},genesis_ambient_active_light:{name:"\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u0440\u0435\u0436\u0438\u043c\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u043d\u0435\u0448\u043d\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f (Genesis)",desc:"\u0414\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u043c\u0435\u043d\u044f\u0435\u0442 \u0446\u0432\u0435\u0442 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0440\u0435\u0436\u0438\u043c\u0430 \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f."},volvo_city_safety_warning:{name:"\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u043e\u0433\u043e \u0430\u0432\u0430\u0440\u0438\u0439\u043d\u043e\u0433\u043e \u043e\u043f\u043e\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 (Volvo)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0440\u0430\u0434\u0430\u0440\u0430 \u0438 \u043b\u0438\u0434\u0430\u0440\u0430 (\u0440\u0430\u043d\u043d\u0435\u0435/\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435)."},chery_ar_navigation_hud:{name:"\u041d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438 AR-\u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u043d\u0430 HUD (Chery)",desc:"\u041f\u0440\u043e\u0435\u0446\u0438\u0440\u0443\u0435\u0442 \u0442\u0440\u0435\u0445\u043c\u0435\u0440\u043d\u044b\u0435 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0441\u0442\u0440\u0435\u043b\u043a\u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u043b\u043e\u0431\u043e\u0432\u043e\u0435 \u0441\u0442\u0435\u043a\u043b\u043e."},jlr_terrain_response_preset:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0440\u0435\u0436\u0438\u043c\u0430 \u0431\u0435\u0437\u0434\u043e\u0440\u043e\u0436\u044c\u044f Terrain Response (JLR)",desc:"\u0417\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 Terrain Response (\u0442\u0440\u0430\u0432\u0430/\u0433\u0440\u0430\u0432\u0438\u0439/\u0441\u043d\u0435\u0433)."},jlr_adaptive_dynamics_firm:{name:"\u041f\u0440\u043e\u0444\u0438\u043b\u044c \u0436\u0435\u0441\u0442\u043a\u043e\u0441\u0442\u0438 \u0430\u043c\u043e\u0440\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u0432 Adaptive Dynamics (JLR)",desc:"\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0436\u0435\u0441\u0442\u043a\u043e\u0441\u0442\u044c \u0434\u0435\u043c\u043f\u0444\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0433\u043e \u0430\u043c\u043e\u0440\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u0430 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e."},jlr_wading_sensor_alert:{name:"\u041f\u043e\u0440\u043e\u0433 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f Wade (JLR)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u0432\u043e\u0434\u044b."},alfa_dna_dynamic_memory:{name:"\u041f\u0430\u043c\u044f\u0442\u044c \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 Alfa DNA Selector (Alfa Romeo)",desc:"\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0440\u0435\u0430\u043a\u0446\u0438\u044e \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438 \u0432 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430."},alfa_q4_torque_split:{name:"\u0413\u0440\u0430\u0444\u0438\u043a \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u043f\u043e\u043b\u043d\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u043d\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f Q4 (Alfa Romeo)",desc:"\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u043e\u0435 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0433\u043e/\u0437\u0430\u0434\u043d\u0435\u0433\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0430 AWD \u043d\u0430 \u0434\u0438\u0441\u043f\u043b\u0435\u0435 \u043f\u0440\u0438\u0431\u043e\u0440\u0430."},li_auto_range_extender_mode:{name:"\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0437\u0430\u0440\u044f\u0434\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u0430 REV (Li Auto)",desc:"\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u043e\u0433 \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u0441\u0433\u043e\u0440\u0430\u043d\u0438\u044f."},li_auto_cinema_seat_position:{name:"\u0420\u0435\u0436\u0438\u043c \xab\u0422\u0435\u0430\u0442\u0440/\u041a\u0438\u043d\u043e\xbb \u042d\u0440\u0433\u043e\u043d\u043e\u043c\u0438\u0447\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0438\u0434\u0435\u043d\u044c\u044f (Li Auto)",desc:"\u0417\u0430\u0434\u043d\u0438\u0435 \u0441\u0438\u0434\u0435\u043d\u044c\u044f \u043e\u0442\u043a\u0438\u0434\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0438 \u043f\u043e\u0434\u043d\u043e\u0436\u043a\u0438 \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0442\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u0430\u043a\u0442\u0438\u0432\u0435\u043d \u0440\u0435\u0436\u0438\u043c \u043a\u0438\u043d\u043e."},zeekr_drift_mode_torque:{name:"\u0414\u0432\u043e\u0439\u043d\u043e\u0439 \u043c\u043e\u0442\u043e\u0440 \u0441 \u0437\u0430\u0434\u043d\u0438\u043c \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435\u043c \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0434\u0440\u0438\u0444\u0442\u0430 (Zeekr)",desc:"\u041f\u0435\u0440\u0435\u0434\u0430\u0435\u0442 100\xa0% \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u043d\u0430 \u0437\u0430\u0434\u043d\u0438\u0439 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u043e\u0433\u043e \u0434\u0440\u0438\u0444\u0442\u0430."},zeekr_ambient_beat_sync:{name:"\u041e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0435 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u041c\u0443\u0437\u044b\u043a\u0430 \u0420\u0438\u0442\u043c \u0411\u0438\u0442 \u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u044f (Zeekr)",desc:"\u041e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u0441\u0430\u043b\u043e\u043d\u0430 \u043f\u0443\u043b\u044c\u0441\u0438\u0440\u0443\u0435\u0442 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u043d\u043e \u0441 \u0440\u0438\u0442\u043c\u0430\u043c\u0438 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u043c\u043e\u0439 \u043c\u0443\u0437\u044b\u043a\u0438."},tata_drive_mode_voice:{name:"\u0413\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0435 \u043e\u043f\u043e\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0440\u0435\u0436\u0438\u043c\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f (Tata)",desc:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0440\u0435\u0436\u0438\u043c\u043e\u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f (\u0413\u043e\u0440\u043e\u0434/\u0421\u043f\u043e\u0440\u0442/\u042d\u043a\u043e)."},mahindra_zip_zap_zoom_custom:{name:"\u041f\u0440\u043e\u0444\u0438\u043b\u044c \u043e\u0442\u043a\u043b\u0438\u043a\u0430 \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438 \u0442\u0440\u0430\u043d\u0441\u043c\u0438\u0441\u0441\u0438\u0438 Zip/Zap/Zoom (Mahindra)",desc:"\u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u043a\u0440\u0438\u0432\u0443\u044e \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0440\u0435\u0436\u0438\u043c\u043e\u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f Zip, Zap \u0438 Zoom."},fun_cyberpunk_cluster_theme:{name:"Cyberpunk 2077 \u041d\u0435\u043e\u043d\u043e\u0432\u0430\u044f \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u043c\u0430 \u043a\u0430\u0431\u0438\u043d\u044b",desc:"\u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442 \u0444\u0443\u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0435\u043e\u043d\u043e\u0432\u044b\u0439 \u0433\u043e\u043b\u0443\u0431\u043e\u0439 \u0438 \u044f\u043d\u0442\u0430\u0440\u043d\u044b\u0439 \u0441\u0442\u0438\u043b\u044c \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438."},fun_exhaust_flame_sound_effect:{name:"\u0421\u0442\u0435\u0440\u0435\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0430 Pop & Bang Exhaust Sound FX",desc:"\u0412\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442 \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u044b\u0435 \u0437\u0432\u0443\u043a\u043e\u0432\u044b\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u044b \u0432\u044b\u0445\u043b\u043e\u043f\u0430 V8 \u0447\u0435\u0440\u0435\u0437 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0441\u0430\u043b\u043e\u043d\u0430."},fun_matrix_light_show_welcome:{name:"\u0418\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u043d\u0430 \u0437\u0430\u043a\u0430\u0437 \u043c\u0430\u0442\u0440\u0438\u0447\u043d\u0430\u044f \u0441\u0432\u0435\u0442\u043e\u0434\u0438\u043e\u0434\u043d\u0430\u044f \u0444\u0430\u0440\u0430 Dance \u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c",desc:"\u0418\u0441\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0440\u0438\u0442\u043c\u0438\u0447\u043d\u043e\u0435 \u0441\u0432\u0435\u0442\u043e\u0432\u043e\u0435 \u0448\u043e\u0443 \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0444\u0430\u0440 \u0438 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430."},fun_stealth_fighter_display:{name:"\u0421\u0442\u0435\u043b\u0441-\u0438\u0441\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c \u041d\u043e\u0447\u043d\u043e\u0435 \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u041c\u0438\u043d\u0438\u043c\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u044b\u0439 \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c",desc:"\u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0432\u0441\u0435 \u043b\u0430\u043c\u043f\u043e\u0447\u043a\u0438 \u043f\u0440\u0438\u0431\u043e\u0440\u043d\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438, \u043a\u0440\u043e\u043c\u0435 \u0441\u043f\u0438\u0434\u043e\u043c\u0435\u0442\u0440\u0430, \u0434\u043b\u044f \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0432 \u043a\u0440\u043e\u043c\u0435\u0448\u043d\u0443\u044e \u0442\u044c\u043c\u0443 \u043d\u043e\u0447\u044c\u044e."},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{name:"Retarder & Jake Brake Downshift Aggressiveness",desc:"Adjusts retarder torque blending curve and automatic transmission downshifting response under braking."},man_ecas_dock_level_memory:{name:"ECAS Air Suspension Loading Dock Height Memory",desc:"Stores and recalls customized pneumatic air suspension height level presets for loading docks."},daf_stationary_dpf_regen_trigger:{name:"Stationary DPF Forced Soot Regeneration",desc:"Initiates stationary diesel particulate filter thermal soot burn routine in parked position."},ford_trucks_reverse_buzzer_night_mode:{name:"Reverse Acoustic Alarm Night Quiet Mode",desc:"Attenuates reverse backup horn alarm volume for quiet night distribution in residential areas."},cummins_ecm_fleet_speed_limiter:{name:"Cummins Engine Road Speed Limiter (RSL)",desc:"Programs maximum allowable road vehicle speed in Cummins ECM parameter tables."}},codeBtn:"\u041a\u041e\u0414\u0418\u0420\u041e\u0412\u0410\u0422\u042c",removeBtn:"\u0423\u0414\u0410\u041b\u0418\u0422\u042c",unsupportedTitle:"\u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u041d\u0435 \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f",unsupportedMsg:"\u042d\u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0438\u043b\u0438 \u041f\u041e \u042d\u0411\u0423 \u0432\u0430\u0448\u0435\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f.",layoutChart:"\u0413\u0420\u0410\u0424\u0418\u041a",selectBrand:"\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043c\u0430\u0440\u043a\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f",selectCategory:"\u0412\u044b\u0431\