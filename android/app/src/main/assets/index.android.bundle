ments nachr\xfcsten",desc:"Aktiviert den Relaisausgang der Windschutzscheiben-Entfrostungsheizung und die Taste f\xfcr den Climatronic-Bildschirm."},retrofit_wireless_charger_module_coding:{name:"Nachr\xfcsten der kabellosen Qi-Smartphone-Ladepad-Integration",desc:"Aktiviert die Status-LED des kabellosen Ladeger\xe4ts und das Popup-Fenster zur Erinnerung an das zur\xfcckgelassene Telefon."},retrofit_acc_radar_module_coding:{name:"Nachr\xfcstbares Frontradarmodul der adaptiven Geschwindigkeitsregelung (ACC).",desc:"Kodiert die nachger\xfcstete Front-Abstandsradareinheit in das CAN-Bus-Fahrzeugnetzwerk."},retrofit_traffic_sign_camera_activation:{name:"Codierung der Windschutzscheibenkamera zur Verkehrszeichenerkennung nachr\xfcsten",desc:"Erm\xf6glicht die Verarbeitung der VZE-Schildererkennung bei einer nachger\xfcsteten Windschutzscheibenkamera."},retrofit_heated_steering_wheel_coding:{name:"Nachr\xfcstung der Aktivierung des beheizten Lenkradmoduls",desc:"Erm\xf6glicht die Ausgabe des Lenkradheizelements und automatische Einschalttemperaturausl\xf6ser."},retrofit_fatigue_camera_calibration:{name:"Nachr\xfcstung der Kameraintegration zur \xdcberwachung der Fahrererm\xfcdung",desc:"Kalibriert den Infrarotkamerasensor zur Fahrer\xfcberwachung nach dem Einbau der Lenks\xe4ule."},retrofit_trailer_hitch_module_coding:{name:"Nachr\xfcstbare Integration von Anh\xe4ngerkupplung und elektrischem Anh\xe4ngermodul",desc:"Kodiert das Anh\xe4ngermodul in das ESP-Stabilit\xe4tssystem zur Abschw\xe4chung des Anh\xe4ngerpendelns."},retrofit_power_tailgate_trunk_kit_coding:{name:"Elektrische Heckklappe und Fu\xdfgestensensor-Integration nachr\xfcsten",desc:"Erm\xf6glicht elektrische Kofferraumantriebsmotoren und Kodierung des Sto\xdfsensors."},easteregg_urban_joke_light_show:{name:"Abwechselnde R\xfccklichtshow von Urban Joke",desc:"Konfiguriert R\xfccklichter und Blinker so, dass sie beim Verriegeln des Fahrzeugs abwechselnd blinken."},easteregg_custom_boot_greeting_text:{name:"Benutzerdefinierter Boot-Begr\xfc\xdfungstext auf digitalem Cluster",desc:"Zeigt beim Einschalten der Z\xfcndung eine benutzerdefinierte Begr\xfc\xdfungsnachricht auf dem Bildschirm des Kombiinstruments an."},easteregg_cluster_mini_game_mode:{name:"Verstecktes Minispielmen\xfc im Kombiinstrument",desc:"Schaltet das per Lenkradtaste gesteuerte Retro-Minispiel frei, das beim Parken angezeigt wird."},easteregg_custom_horn_melody_package:{name:"Kundenspezifische Willkommensmelodie f\xfcr akustisches Horn",desc:"Spielt beim Entriegeln des Fahrzeugs ein kurzes Rhythmus-Zwitschermuster auf der Hupe ab."},easteregg_welcome_lighting_door_sequence:{name:"Verfolgung der T\xfcrsequenz mit LED-Willkommenslicht",desc:"F\xfchrt eine progressive LED-Verfolgungsanimation an Au\xdfent\xfcrgriffen aus."},easteregg_developer_service_menu_shortcut:{name:"Verkn\xfcpfung zum Entwickler- und Service-Diagnosebildschirm",desc:"Erm\xf6glicht eine schnelle Gestenverkn\xfcpfung f\xfcr den Zugriff auf versteckte technische Diagnosebildschirme."},easteregg_seasonal_cluster_theme_effect:{name:"Saisonales Wetter-Cluster-Themen-Overlay (Schneeflocke/Regen)",desc:"F\xfcgt im Winter einen animierten Hintergrund aus Schneeflocken oder Regenpartikeln zum Messcluster hinzu."},easteregg_valet_mode_prank_warning_message:{name:"Valet-Modus-Streich-Geschwindigkeitsbegrenzungs-Popup-Warnung",desc:"Zeigt eine humorvoll strenge Warnmeldung auf dem Armaturenbrett an, wenn der Valet-Modus \xfcberschritten wird."},adas_lane_keep_assist_gentle_curve:{name:"Spurhalteassistent (LKA) Sanfte Lenkeingriffskurve",desc:"Mildert pl\xf6tzliche Lenkradbewegungen durch einen progressiven Drehmomenteingriff."},adas_lka_last_state_memory_mode:{name:"Speichersperre f\xfcr den letzten Zustand des Spurhalteassistenten",desc:"Verhindert, dass sich LKA bei jedem Neustart der Z\xfcndung automatisch wieder einschaltet."},adas_acc_default_follow_distance:{name:"Adaptive Cruise Control (ACC) Standard-Distanzvoreinstellung",desc:"Legt die Standardl\xfcckeneinstellung (1 bis 4 Balken) fest, wenn ACC eingeschaltet wird."},adas_acc_speed_step_adjustment:{name:"ACC Cruise Speed Inkrement-Stufenw\xe4hler (+5 / +10 km/h)",desc:"\xc4ndert die Geschwindigkeitsstufe durch kurzes Dr\xfccken der Lenkradtaste von 1 km/h auf 5 km/h."},adas_matrix_led_glare_free_high_beam_unlock:{name:"Blendfreier adaptiver Blendschutz f\xfcr Matrix-LEDs f\xfcr Fernlicht",desc:"Schaltet das adaptive strahlformende Fernlicht nach europ\xe4ischer Spezifikation bei nordamerikanischen Fahrzeugen frei."},adas_traffic_jam_assist_follow_fine_tune:{name:"Stop-and-Go-Wiederaufnahmeverz\xf6gerung des Stauassistenten",desc:"Verl\xe4ngert das automatische Stop-and-Go-Neustartfenster von 3 Sekunden auf 15 Sekunden."},adas_rear_radar_blind_spot_zero_point_reset:{name:"Nullpunktwinkelkalibrierung des Radars f\xfcr den toten Winkel hinten",desc:"Kalibriert den Azimutwinkel des hinteren Sto\xdff\xe4ngerradars nach dem Ausbau oder der Reparatur des Sto\xdff\xe4ngers neu."},adas_surround_camera_stitching_recalib:{name:"Dynamische Bild-Stitching-Ausrichtung der Surround-View-Kamera",desc:"F\xfchrt w\xe4hrend der Fahrt auf der Stra\xdfe eine dynamische Kamerabild-Stitching-Kalibrierung durch."},adas_steering_angle_sensor_zero_point_reset:{name:"Nullpunktkalibrierung des Lenkwinkelsensors (SAS).",desc:"Setzt den Lenkmittelwinkel nach der Achsvermessung auf 0,0\xb0 zur\xfcck."},adas_cross_traffic_alert_sensitivity_adjust:{name:"Erkennungsbereich des Rear Cross Traffic Alert (RCTA).",desc:"Erh\xf6ht die Erkennungsreichweite des Seitenradars f\xfcr Fahrzeuge, die sich beim R\xfcckw\xe4rtsfahren n\xe4hern."},adas_aeb_emergency_braking_threshold_preview:{name:"Wirksamkeit der automatischen Notbremsung (AEB).",desc:"Passt den Zeitpunkt des Fr\xfchwarnsignals gegen\xfcber dem Sp\xe4twarnsignal f\xfcr Vorw\xe4rtskollisionswarnungen an."},adas_night_vision_camera_alignment:{name:"Zielausrichtung der Infrarot-Nachtsicht-W\xe4rmebildkamera",desc:"Leitet die \xdcbe