celeration_boost_unlock:{name:"\u0e42\u0e1b\u0e23\u0e44\u0e1f\u0e25\u0e4c Boost Drive \u0e01\u0e32\u0e23\u0e40\u0e23\u0e48\u0e07\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e02\u0e2d\u0e07 Powertrain (Tesla)",desc:"\u0e1b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e15\u0e2d\u0e1a\u0e2a\u0e19\u0e2d\u0e07\u0e02\u0e2d\u0e07\u0e21\u0e2d\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e44\u0e1f\u0e1f\u0e49\u0e32\u0e43\u0e2b\u0e49\u0e04\u0e21\u0e0a\u0e31\u0e14\u0e02\u0e36\u0e49\u0e19\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27 0-100 \u0e01\u0e21./\u0e0a\u0e21. \u0e17\u0e35\u0e48\u0e40\u0e23\u0e47\u0e27\u0e02\u0e36\u0e49\u0e19"},tesla_interior_ambient_color:{name:"\u0e0a\u0e48\u0e2d\u0e07\u0e27\u0e32\u0e07\u0e40\u0e17\u0e49\u0e32\u0e43\u0e19\u0e2b\u0e49\u0e2d\u0e07\u0e42\u0e14\u0e22\u0e2a\u0e32\u0e23 Ambient Lighting \u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e2a\u0e35\u0e25\u0e48\u0e27\u0e07\u0e2b\u0e19\u0e49\u0e32 (Tesla)",desc:"\u0e1b\u0e23\u0e31\u0e1a\u0e41\u0e15\u0e48\u0e07\u0e0a\u0e38\u0e14\u0e2a\u0e35 RGB \u0e02\u0e2d\u0e07\u0e44\u0e1f LED \u0e1a\u0e23\u0e34\u0e40\u0e27\u0e13\u0e0a\u0e48\u0e2d\u0e07\u0e27\u0e32\u0e07\u0e40\u0e17\u0e49\u0e32"},audi_matrix_led_animation:{name:"\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32 Matrix LED Dynamic Welcome Light Dance (Audi)",desc:"\u0e40\u0e25\u0e48\u0e19\u0e17\u0e48\u0e32\u0e40\u0e15\u0e49\u0e19\u0e41\u0e2a\u0e07\u0e41\u0e1a\u0e1a\u0e44\u0e14\u0e19\u0e32\u0e21\u0e34\u0e01\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e04\u0e22\u0e32\u0e19\u0e1e\u0e32\u0e2b\u0e19\u0e30"},audi_mmi_startup_screen:{name:"\u0e18\u0e35\u0e21\u0e01\u0e23\u0e32\u0e1f\u0e34\u0e01\u0e1a\u0e39\u0e15\u0e2b\u0e19\u0e49\u0e32\u0e08\u0e2d\u0e2a\u0e31\u0e21\u0e1c\u0e31\u0e2a MMI (Audi)",desc:"\u0e1b\u0e23\u0e31\u0e1a\u0e41\u0e15\u0e48\u0e07\u0e20\u0e32\u0e1e\u0e40\u0e04\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e44\u0e2b\u0e27\u0e01\u0e32\u0e23\u0e1a\u0e39\u0e15\u0e2b\u0e19\u0e49\u0e32\u0e08\u0e2d\u0e01\u0e25\u0e32\u0e07 MMI (S / RS / e-tron)"},audi_drive_select_efficiency:{name:"\u0e42\u0e1b\u0e23\u0e44\u0e1f\u0e25\u0e4c\u0e01\u0e32\u0e23\u0e02\u0e31\u0e1a\u0e02\u0e35\u0e48\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e21\u0e35\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e43\u0e19 Audi Drive Select (Audi)",desc:"\u0e40\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e1b\u0e23\u0e30\u0e2b\u0e22\u0e31\u0e14\u0e19\u0e49\u0e33\u0e21\u0e31\u0e19\u0e40\u0e0a\u0e37\u0e49\u0e2d\u0e40\u0e1e\u0e25\u0e34\u0e07\u0e43\u0e19\u0e15\u0e31\u0e27\u0e40\u0e25\u0e37\u0e2d\u0e01 Drive Select"},audi_laptimer_boost_display:{name:"Lap Timer & Turbo Bar \u0e40\u0e01\u0e08\u0e4c\u0e27\u0e31\u0e14\u0e41\u0e23\u0e07\u0e14\u0e31\u0e19\u0e42\u0e2d\u0e40\u0e27\u0e2d\u0e23\u0e4c\u0e40\u0e25\u0e22\u0e4c (Audi)",desc:"\u0e41\u0e2a\u0e14\u0e07\u0e15\u0e31\u0e27\u0e08\u0e31\u0e1a\u0e40\u0e27\u0e25\u0e32\u0e23\u0e2d\u0e1a\u0e2a\u0e19\u0e32\u0e21\u0e41\u0e02\u0e48\u0e07\u0e41\u0e25\u0e30\u0e21\u0e32\u0e15\u0e23\u0e27\u0e31\u0e14\u0e1a\u0e39\u0e2a\u0e15\u0e4c\u0e40\u0e17\u0e2d\u0e23\u0e4c\u0e42\u0e1a\u0e41\u0e1a\u0e1a\u0e40\u0e23\u0e35\u0e22\u0e25\u0e44\u0e17\u0e21\u0e4c\u0e1a\u0e19 Virtual Cockpit"},audi_needle_sweep_gauge:{name:"\u0e01\u0e32\u0e23\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e40\u0e02\u0e47\u0e21\u0e27\u0e31\u0e14\u0e41\u0e1a\u0e1a\u0e2a\u0e1b\u0e2d\u0e23\u0e4c\u0e15 (Audi)",desc:"\u0e17\u0e33\u0e01\u0e32\u0e23\u0e17\u0e14\u0e2a\u0e2d\u0e1a\u0e01\u0e32\u0e23\u0e01\u0e27\u0e32\u0e14\u0e40\u0e02\u0e47\u0e21\u0e27\u0e31\u0e14\u0e23\u0e2d\u0e1a\u0e41\u0e25\u0e30\u0e21\u0e32\u0e15\u0e23\u0e27\u0e31\u0e14\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e40\u0e15\u0e47\u0e21\u0e23\u0e39\u0e1b\u0e41\u0e1a\u0e1a\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e2a\u0e15\u0e32\u0e23\u0e4c\u0e17"},skoda_coming_home_lights:{name:"\u0e2d\u0e2d\u0e01\u0e08\u0e32\u0e01\u0e1a\u0e49\u0e32\u0e19 / \u0e01\u0e33\u0e25\u0e31\u0e07\u0e01\u0e25\u0e31\u0e1a\u0e1a\u0e49\u0e32\u0e19 \u0e44\u0e1f\u0e08\u0e31\u0e1a\u0e40\u0e27\u0e25\u0e32 (Skoda)",desc:"\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e04\u0e48\u0e32\u0e15\u0e31\u0e27\u0e08\u0e31\u0e1a\u0e40\u0e27\u0e25\u0e32\u0e01\u0e32\u0e23\u0e2a\u0e48\u0e2d\u0e07\u0e2a\u0e27\u0e48\u0e32\u0e07\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32\u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e2d\u0e2d\u0e01\u0e08\u0e32\u0e01\u0e23\u0e16"},skoda_comfort_turn_signal:{name:"\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e19\u0e31\u0e1a\u0e0a\u0e35\u0e1e\u0e08\u0e23\u0e02\u0e2d\u0e07\u0e15\u0e31\u0e27\u0e1a\u0e48\u0e07\u0e0a\u0e35\u0e49\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e30\u0e14\u0e27\u0e01\u0e2a\u0e1a\u0e32\u0e22 (Skoda)",desc:"\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e08\u0e33\u0e19\u0e27\u0e19\u0e01\u0e32\u0e23\u0e01\u0e30\u0e1e\u0e23\u0e34\u0e1a\u0e02\u0e2d\u0e07\u0e2a\u0e31\u0e0d\u0e0d\u0e32\u0e13\u0e44\u0e1f\u0e40\u0e25\u0e35\u0e49\u0e22\u0e27\u0e41\u0e1a\u0e1a\u0e2a\u0e31\u0e21\u0e1c\u0e31\u0e2a\u0e40\u0e14\u0e35\u0e22\u0e27\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07 3 \u0e16\u0e36\u0e07 5 \u0e01\u0e30\u0e1e\u0e23\u0e34\u0e1a"},cupra_sport_display_menu:{name:"\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e14\u0e19\u0e15\u0e23\u0e35 Cupra Performance \u0e41\u0e25\u0e30\u0e40\u0e21\u0e19\u0e39 G-Meter (Cupra)",desc:"\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e04\u0e21\u0e34\u0e40\u0e15\u0e2d\u0e23\u0e4c G-force, \u0e40\u0e01\u0e08\u0e27\u0e31\u0e14\u0e01\u0e33\u0e25\u0e31\u0e07 kW \u0e41\u0e25\u0e30\u0e08\u0e2d\u0e41\u0e2a\u0e14\u0e07\u0e2d\u0e38\u0e13\u0e2b\u0e20\u0e39\u0e21\u0e34\u0e19\u0e49\u0e33\u0e21\u0e31\u0e19"},cupra_virtual_cockpit_copper:{name:"\u0e01\u0e23\u0e32\u0e1f\u0e34\u0e01\u0e40\u0e19\u0e49\u0e19\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e41\u0e14\u0e0a\u0e1a\u0e2d\u0e23\u0e4c\u0e14\u0e18\u0e35\u0e21\u0e17\u0e2d\u0e07\u0e41\u0e14\u0e07 (Cupra)",desc:"\u0e43\u0e0a\u0e49\u0e18\u0e35\u0e21\u0e40\u0e19\u0e49\u0e19\u0e2a\u0e35\u0e17\u0e2d\u0e07\u0e41\u0e14\u0e07\u0e40\u0e21\u0e17\u0e31\u0e25\u0e25\u0e34\u0e01\u0e2d\u0e31\u0e19\u0e40\u0e1b\u0e47\u0e19\u0e40\u0e2d\u0e01\u0e25\u0e31\u0e01\u0e29\u0e13\u0e4c\u0e02\u0e2d\u0e07 Cupra \u0e01\u0e31\u0e1a\u0e01\u0e25\u0e38\u0e48\u0e21\u0e40\u0e01\u0e08"},vag_brake_disc_drying:{name:"\u0e1f\u0e31\u0e07\u0e01\u0e4c\u0e0a\u0e31\u0e48\u0e19\u0e01\u0e32\u0e23\u0e40\u0e0a\u0e47\u0e14\u0e08\u0e32\u0e19\u0e40\u0e1a\u0e23\u0e01 / \u0e01\u0e32\u0e23\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e41\u0e2b\u0e49\u0e07\u0e43\u0e19\u0e2a\u0e32\u0e22\u0e1d\u0e19 (VAG)",desc:"\u0e43\u0e0a\u0e49\u0e41\u0e23\u0e07\u0e01\u0e14\u0e41\u0e1c\u0e48\u0e19\u0e19\u0e49\u0e2d\u0e22\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e40\u0e1b\u0e47\u0e19\u0e23\u0e30\u0e22\u0e30\u0e46 \u0e43\u0e19\u0e2a\u0e20\u0e32\u0e1e\u0e2d\u0e32\u0e01\u0e32\u0e28\u0e40\u0e1b\u0e35\u0e22\u0e01\u0e01\u0e31\u0e1a\u0e42\u0e23\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e41\u0e2b\u0e49\u0e07"},vag_tourist_mode_lights:{name:"\u0e23\u0e39\u0e1b\u0e41\u0e1a\u0e1a\u0e25\u0e33\u0e41\u0e2a\u0e07\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32\u0e42\u0e2b\u0e21\u0e14\u0e19\u0e31\u0e01\u0e17\u0e48\u0e2d\u0e07\u0e40\u0e17\u0e35\u0e48\u0e22\u0e27 (VAG)",desc:"\u0e2a\u0e25\u0e31\u0e1a\u0e23\u0e39\u0e1b\u0e41\u0e1a\u0e1a\u0e25\u0e33\u0e41\u0e2a\u0e07\u0e44\u0e1f\u0e2b\u0e19\u0e49\u0e32\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07 LHD \u0e41\u0e25\u0e30 RHD \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e02\u0e31\u0e1a\u0e23\u0e16\u0e44\u0e1b\u0e15\u0e48\u0e32\u0e07\u0e1b\u0e23\u0e30\u0e40\u0e17\u0e28"},vag_hood_warning_mute:{name:"\u0e1b\u0e34\u0e14\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e14\u0e19\u0e15\u0e23\u0e35\u0e41\u0e1a\u0e1a\u0e40\u0e1b\u0e34\u0e14\u0e1d\u0e32\u0e01\u0e23\u0e30\u0e42\u0e1b\u0e23\u0e07 (VAG)",desc:"\u0e23\u0e30\u0e07\u0e31\u0e1a\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e2d\u0e38\u0e1b\u0e01\u0e23\u0e13\u0e4c\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e15\u0e48\u0e2d\u0e40\u0e19\u0e37\u0e48\u0e2d\u0e07\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e44\u0e21\u0e48\u0e44\u0e14\u0e49\u0e25\u0e47\u0e2d\u0e04\u0e