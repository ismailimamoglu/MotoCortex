nsion:{name:"Mode Bambi feux de route + \xe9clairage simultan\xe9 antibrouillard",desc:"Maintient les phares antibrouillard allum\xe9s m\xeame lorsque les feux de route sont activ\xe9s."},ford_auto_engine_idle_shutdown_30min_override:{name:"D\xe9sactivation de l'arr\xeat automatique du moteur au ralenti apr\xe8s 30 minutes",desc:"Emp\xeache le moteur de s'\xe9teindre automatiquement apr\xe8s 30 minutes de stationnement."},hyundai_n_grin_shift_retrofit_enable:{name:"N Grin Shift (NGS) D\xe9verrouillage de la mise \xe0 niveau Overboost de 20 secondes",desc:"Active la fonction overboost du bouton NGS du volant dans l'ECU."},hyundai_smart_tailgate_approach_distance:{name:"D\xe9tection de proximit\xe9 d'approche de hayon mains libres intelligentes",desc:"Ajuste le temps de retard (3 s \xe0 1 s) avant l\u2019ouverture automatique du hayon intelligent."},hyundai_digital_cluster_n_performance_theme:{name:"Disposition de la jauge du groupe d'instruments num\xe9riques N Performance",desc:"Applique la disposition du groupe d'indicateurs de changement de vitesse rouge N-Performance au tableau de bord LCD standard."},stellantis_scr_adblue_warning_threshold_adjust:{name:"R\xe9glage du seuil de distance d'avertissement SCR AdBlue",desc:"Ajuste la distance d'avertissement du premier rappel de remplissage d'AdBlue de 2 400 km \xe0 1 000 km."},stellantis_jeep_trail_rated_offroad_pages:{name:"Pages de t\xe9l\xe9m\xe9trie tout-terrain Jeep Uconnect Trail-Rated",desc:"D\xe9verrouille les pages de pas de transmission, de roulis, d'articulation des roues et de temp\xe9rature du liquide de refroidissement sur Uconnect."},stellantis_peugeot_icockpit_3d_color_schemes:{name:"Palette de couleurs personnalis\xe9es Peugeot 3D i-Cockpit",desc:"D\xe9bloque les th\xe8mes de couleurs Cuivre et Quartz pour le groupe d'instruments num\xe9riques holographiques 3D."},gm_super_cruise_follow_distance_adjust:{name:"D\xe9calage de distance de suivi mains libres Super Cruise",desc:"Personnalise l\u2019espace