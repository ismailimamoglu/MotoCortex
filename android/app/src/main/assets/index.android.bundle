u0633\u0628\u0642 \u0644\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u064a\u062f\u0648\u064a\u064b\u0627 \u0625\u0644\u0649 25 \u062f\u0631\u062c\u0629 \u0645\u0626\u0648\u064a\u0629 \u0642\u0628\u0644 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0633\u0631\u064a\u0639 \u0628\u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0628\u062f\u0648\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u062a\u0646\u0642\u0644."},ev_v2l_power_output_expand:{name:"V2L (\u0645\u0646 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u062d\u062a\u0649 \u0627\u0644\u062a\u062d\u0645\u064a\u0644) \u0645\u062e\u0631\u062c \u0637\u0627\u0642\u0629 220 \u0641\u0648\u0644\u062a (3.6 \u0643\u064a\u0644\u0648\u0648\u0627\u062a)",desc:"\u064a\u0648\u0633\u0639 \u062d\u062f \u0645\u0646\u0641\u0630 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0646\u0632\u0644\u064a\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a V2L \u0628\u062c\u0647\u062f 220 \u0641\u0648\u0644\u062a \u0645\u0646 2.2 \u0643\u064a\u0644\u0648\u0648\u0627\u062a \u0625\u0644\u0649 3.6 \u0643\u064a\u0644\u0648\u0648\u0627\u062a."},ev_one_pedal_regen_force_level3:{name:"\u0645\u062d\u0631\u0643 \u0628\u062f\u0648\u0627\u0633\u0629 \u0648\u0627\u062d\u062f\u0629 \u0623\u0642\u0635\u0649 \u0641\u0631\u0627\u0645\u0644 \u0645\u062a\u062c\u062f\u062f\u0629 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0641\u0631\u0645\u0644\u0629 \u0627\u0644\u0645\u062a\u062c\u062f\u062f\u0629 (\u0648\u0636\u0639 \u0627\u0644\u062a\u0648\u0642\u0641 \u0628\u062f\u0648\u0627\u0633\u0629 \u0648\u0627\u062d\u062f\u0629) \u0643\u0625\u0639\u062f\u0627\u062f \u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0639\u0646\u062f \u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},byd_soc_max_charge_target_limit:{name:"\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0634\u062d\u0646 \u0644\u062d\u0645\u0627\u064a\u0629 \u0635\u062d\u0629 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0645\u0646 BYD (80% / 90%)",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0642\u0637\u0639 \u0634\u062d\u0646 \u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062a\u0631\u062f\u062f/\u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0639\u0644\u0649 80% \u0623\u0648 90% \u0644\u0625\u0637\u0627\u0644\u0629 \u0639\u0645\u0631 \u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0634\u0641\u0631\u0629."},byd_dmi_forced_pure_ev_speed_override:{name:"\u062a\u062c\u0627\u0648\u0632 \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u0646\u0632\u064a\u0646 BYD DM-i Pure EV Mode",desc:"\u064a\u0645\u0646\u0639 \u062a\u0634\u063a\u064a\u0644 \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u0646\u0632\u064a\u0646 \u0641\u064a \u0648\u0636\u0639 EV \u062d\u062a\u0649 130 \u0643\u0645/\u0633\u0627\u0639\u0629 \u062d\u062a\u0649 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0633\u0627\u0631\u0639 \u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u0644\u062e\u0627\u0646\u0642."},byd_vtol_v2v_rescue_charge_mode:{name:"BYD VTOL (\u0645\u0631\u0643\u0628\u0629 \u0625\u0644\u0649 \u0645\u0631\u0643\u0628\u0629) \u0648\u0636\u0639 \u0634\u062d\u0646 \u0627\u0644\u0625\u0646\u0642\u0627\u0630",desc:"\u064a\u0641\u062a\u062d \u0645\u062e\u0631\u062c \u0637\u0627\u0642\u0629 \u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062a\u0631\u062f\u062f \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0644\u0634\u062d\u0646 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0627\u0644\u0639\u0627\u0644\u0642\u0629 \u0639\u0644\u0649 \u0627\u0644\u0637\u0631\u064a\u0642."},hyundai_ipedal_memory_lock:{name:"\u0642\u0641\u0644 \u0630\u0627\u0643\u0631\u0629 \u0645\u062d\u0631\u0643 \u0627\u0644\u0623\u0642\u0631\u0627\u0635 \u0630\u0648 \u0627\u0644\u062f\u0648\u0627\u0633\u0629 \u0627\u0644\u0648\u0627\u062d\u062f\u0629 Hyundai / Kia i-PEDAL",desc:"\u064a\u0645\u0646\u0639 \u0648\u0636\u0639 \u0627\u0644\u062a\u0648\u0642\u0641 \u0630\u0648 \u0627\u0644\u062f\u0648\u0627\u0633\u0629 \u0627\u0644\u0648\u0627\u062d\u062f\u0629 i-PEDAL \u0645\u0646 \u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 3 \u0628\u0639\u062f \u0627\u0644\u062a\u062d\u0648\u0644 \u0625\u0644\u0649 \u0648\u0636\u0639 \u0627\u0644\u0631\u062c\u0648\u0639 \u0644\u0644\u062e\u0644\u0641."},hyundai_utility_mode_12v_saver:{name:"\u0648\u0636\u0639 \u0627\u0644\u062a\u062e\u064a\u064a\u0645 \u0627\u0644\u0645\u0646\u0641\u0639\u0629 \u0645\u0648\u0641\u0631 \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a 12 \u0641\u0648\u0644\u062a",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u0634\u063a\u064a\u0644 \u0645\u0646\u0641\u0630 V2L \u0628\u0642\u0648\u0629 220 \u0641\u0648\u0644\u062a \u0645\u0628\u0627\u0634\u0631\u0629 \u0645\u0646 \u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u0631 \u0630\u0627\u062a \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a \u0644\u0645\u0646\u0639 \u0627\u0633\u062a\u0646\u0632\u0627\u0641 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0628\u062c\u0647\u062f 12 \u0641\u0648\u0644\u062a."},hyundai_phev_no_ice_climate_start:{name:"\u0648\u0636\u0639 PHEV EV \u0644\u062a\u062f\u0641\u0626\u0629 \u0627\u0644\u0645\u0646\u0627\u062e \u0648\u0625\u062e\u0645\u0627\u062f \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u0646\u0632\u064a\u0646",desc:"\u062a\u0639\u0645\u0644 \u0627\u0644\u0645\u0636\u062e\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629 / \u0633\u062e\u0627\u0646 \u0643\u0647\u0631\u0628\u0627\u0626\u064a PTC \u0639\u0644\u0649 \u0645\u0646\u0627\u062e \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u062f\u0648\u0646 \u062a\u0634\u063a\u064a\u0644 \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u0646\u0632\u064a\u0646."},vag_taycan_ess_sound_profile_swap:{name:"\u0646\u0638\u0627\u0645 \u0635\u0648\u062a \u0631\u064a\u0627\u0636\u064a \u0643\u0647\u0631\u0628\u0627\u0626\u064a (ESS) Taycan / RS e-tron",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u063a\u064a\u064a\u0631 \u0645\u0644\u0641 \u0635\u0648\u062a \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0625\u0644\u0649 \u0645\u0648\u0644\u062f \u0627\u0644\u0635\u0648\u062a Porsche Taycan GTS \u0623\u0648 Audi RS e-tron GT."},vag_meb_daily_charge_target_menu:{name:"\u0628\u0637\u0627\u0631\u064a\u0629 MEB \u064a\u0648\u0645\u064a\u064b\u0627 \u0628\u0646\u0633\u0628\u0629 80% / \u0634\u0631\u064a\u0637 \u0634\u062d\u0646 \u0633\u0631\u064a\u0639 \u0628\u0646\u0633\u0628\u0629 100%",desc:"\u064a\u0636\u064a\u0641 \u0634\u0631\u064a\u0637 \u062a\u0628\u062f\u064a\u0644 \u0633\u0631\u064a\u0639 \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 MIB \u0644\u0644\u062a\u0628\u062f\u064a\u0644 \u0628\u064a\u0646 \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0628\u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 80% \u0648\u0634\u062d\u0646 \u0627\u0644\u0631\u062d\u0644\u0629 \u0628\u0646\u0633\u0628\u0629 100%."},vag_gte_generator_charge_reserve:{name:"\u0634\u062d\u0646 \u0642\u0648\u0629 \u0628\u0637\u0627\u0631\u064a\u0629 \u0645\u0648\u0644\u062f \u0627\u0644\u0645\u062d\u0631\u0643 GTE / \u0627\u0644\u0648\u0636\u0639 E (80%)",desc:"\u064a\u062c\u0628\u0631 \u0645\u062d\u0631\u0643 \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0642 \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0644 \u0643\u0645\u0648\u0644\u062f \u0644\u0625\u0639\u0627\u062f\u0629 \u0634\u062d\u0646 \u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a \u0628\u0646\u0633\u0628\u0629 \u062a\u0635\u0644 \u0625\u0644\u0649 80% \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0642\u064a\u0627\u062f\u0629."},bmw_hans_zimmer_iconic_sounds_m:{name:"\u0645\u062d\u0631\u0643 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a M-Performance \u0645\u0646 \u0647\u0627\u0646\u0632 \u0632\u064a\u0645\u0631 IconicSounds",desc:"\u064a\u0641\u062a\u062d \u0645\u0644\u0641\u0627\u062a \u0635\u0648\u062a \u0627\u0644\u062a\u0633\u0627\u0631\u0639 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a M-Performance \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0645\u0646 Hans Zimmer \u0639\u0644\u0649 i4 \u0648iX."},bmw_phev_max_edrive_140kmh:{name:"\u0633\u0642\u0641 \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0627\u0644\u0646\u0642\u064a PHEV MAX eDrive (140 \u0643\u0645/\u0633\u0627\u0639\u0629)",desc:"\u064a\u0632\u064a\u062f \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0627\u0644\u0646\u0642\u064a\u0629 \u0641\u064a \u0627\u0644\u0637\u0631\u0627\u0632\u0627\u062a 330e / 530e \u0627\u0644\u0647\u062c\u064a\u0646\u0629 \u0625\u0644\u0649 140 \u0643\u0645 / \u0633\u0627\u0639\u0629."},bmw_ac_charging_current_limit_menu:{name:"\u0634\u0627\u062d\u0646 \u0645\u0646\u0632\u0644\u064a AC - \u0645\u062d\u062f\u062f \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u062a\u064a\u0627\u0631 (6A - 32A)",desc:"\u064a\u0636\u064a\u0641 \u0645\u062d\u062f\u062f \u062a\u064a\u0627\u0631 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0645\u0646\u0632\u0644\u064a \u0628\u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062a\u0631\u062f\u062f (6A / 10A / 16A / 32A) \u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0632\u0627\u0626\u062f \u0639\u0644\u0649 \u0627\u0644\u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0645\u0646\u0632\u0644\u064a\u0629."},toyota_hybrid_ev_mode_override:{name:"\u062a\u0648\u064a\u0648\u062a\u0627 / \u0644\u0643\u0632\u0633 EV \u0648\u0636\u0639 \u062e\u0646\u0642 \u062a\u062c\u0627\u0648\u0632 \u0642\u0645\u0639",desc:"\u064a\u0645\u0646\u0639 \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u0646\u0632\u064a\u0646 \u0645\u0646 \u0627\u0644\u0628\u062f\u0621 \u0627\u0644\u0642\u0633\u0631\u064a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0633\u0627\u0631\u0639 \u0639\u0646\u062f\u0645\u0627 \u064a\u0643\u0648\u0646 \u0632\u0631 \u0648\u0636\u0639 EV \u0646\u0634\u0637\u064b\u0627."},toyota_hybrid_battery_fan_speed_boost:{name:"\u062a\u0639\u0632\u064a\u0632 \u0645\u0631\u0648\u062d\u0629 \u062a\u0628\u0631\u064a\u062f \u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a \u062a\u0648\u064a\u0648\u062a\u0627/\u0644\u0643\u0632\u0633 (+30%)",desc:"\u062a\u0632\u064a\u062f \u0645\u0646 \u0633\u0631\u0639\u0629 \u0645\u0631\u0648\u062d\u0629 \u062a\u0628\u0631\u064a\u062f \u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u0631 \u0627\u0644\u0647\u062c\u064a\u0646 \u0628\u0646\u0633\u0628\u0629 +30% \u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u062f\u0647\u0648\u0631 \u0627\u0644\u062d\u0631\u0627\u0631\u064a \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u062e\u0627\u062a \u0627\u0644\u062d\u0627\u0631\u0629."},tesla_sentry_high_bitrate_video:{name:"\u0648\u0636\u0639 Tesla Sentry \u062a\u0633\u062c\u064a\u0644 \u0643\u0627\u0645\u064a\u0631\u0627 Dashcam \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0628\u0645\u0639\u062f\u0644 \u0627\u0644\u0628\u062a \u0627\u0644\u0639\u0627\u0644\u064a",desc:"\u064a\u0632\u064a\u062f \u0645\u0646 \u0645\u0639\u062f\u0644 \u0627\u0644\u0628\u062a \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0641\u064a \u0643\u0627\u0645\u064a\u0631\u0627 Sentry Mode \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0631\u0624\u064a\u0629 \u0648\u0627\u0636\u062d\u0629 \u062a\u0645\u0627\u0645\u064b\u0627 \u0644\u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635."},tesla_cabin_overheat_threshold_30c:{name:"\u0639\u062a\u0628\u0629 \u062f\u0631\u062c\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0644\u0644\u062d\u0645\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0632\u0627\u0626\u062f\u0629 \u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u062a\u0633\u0644\u0627 (30 \u062f\u0631\u062c\u0629 \u0645\u0626\u0648\u064a\u0629)",desc:"\u064a\u062e\u0641\u0636 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0645\u0646\u0627\u062e \u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0632\u0627\u0626\u062f\u0629 \u0644\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0645\u0646 40 \u062f\u0631\u062c\u0629 \u0645\u0626\u0648\u064a\u0629 \u0625\u0644\u0649 30 \u062f\u0631\u062c\u0629 \u0645\u0626\u0648\u064a\u0629 \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u062f\u0627\u062e\u0644\u064a."},bmwmotorrad_quickshifter_pro_readapt:{name:"\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0643\u064a\u0641 \u0645\u0639 \u0645\u0633\u0627\u0639\u062f Shift Pro",desc:"\u064a\u0639\u064a\u062f \u0636\u0628\u0637 \u0645\u0639\u0644\u0645\u0627\u062a \u062a\u0639\u0644\u0645 \u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u062a\u062d\u0648\u0644 \u0648\u064a\u0628\u062f\u0623 \u0625\u0639\u0627\u062f\u0629 \u0645\u0639\u0627\u064a\u0631\u0629 \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0633\u0631\u064a\u0639."},bmwmotorrad_esa_zero_point_calib:{name:"\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a ESA\u060c \u0645\u0639\u0627\u064a\u0631\u0629 \u0646\u0642\u0637\u0629 \u0627\u0644\u0635\u0641\u0631",desc:"\u0645\u0639\u0627\u064a\u0631\u0629 \u062d\u0645\u0644 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0623\u062c\u0647\u0632\u0629 \u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0627\u0644\u0635\u0641\u0631 \u0641\u064a \u0627\u0644\u0645\u0635\u0646\u0639."},bmwmotorrad_abs_pro_cornering_toggle:{name:"\u0639\u062a\u0628\u0629 \u0627\u0644\u062a\u062f\u062e\u0644 \u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 ABS Pro",desc:"\u064a\u0636\u0628\u0637 \u062d\u0633\u0627\u0633\u064a\u0629 \u062a\u062f\u062e\u0644 ABS \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0647\u0632\u064a\u0644\u0629 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0633\u0627\u0631."},bmwmotorrad_service_interval_reset:{name:"\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u062a\u0630\u0643\u064a\u0631 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629 \u0648\u0627\u0644\u0645\u0633\u0627\u0641\u0629",desc:"\u064a\u0639\u064a\u062f \u0636\u0628\u0637 \u0645\u0624\u0634\u0631 \u062e\u062f\u0645\u0629 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u064a\u0636\u0628\u0637 \u0627\u0644\u0641\u0627\u0635\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0627\u0644\u0645\u062e\u0635\u0635."},bmwmotorrad_headlight_pro_cornering:{name:"\u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0627\u0644\u0645\u062a\u0643\u064a\u0641 \u0645\u0639 \u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u0636\u0648\u0621 \u0639\u0646\u062f \u0627\u0644\u0645\u0646\u0639\u0637\u0641\u0627\u062a",desc:"\u064a\u0636\u0628\u0637 \u0639\u062a\u0628\u0629 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0647\u0632\u064a\u0644\u0629 \u0644\u062a\u0646\u0634\u064a\u0637 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0639\u0646\u062f \u0627\u0644\u0645\u0646\u0639\u0637\u0641\u0627\u062a."},bmwmotorrad_keyless_ride_range_extend:{name:"\u062a\u0645\u062f\u064a\u062f \u0646\u0637\u0627\u0642 \u0627\u0644\u0643\u0634\u0641 \u0639\u0646 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0628\u062f\u0648\u0646 \u0645\u0641\u062a\u0627\u062d",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u062d\u0633\u064a\u0646 \u0646\u0637\u0627\u0642 \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0645\u0631\u0633\u0644 \u0627\u0644\u0645\u0633\u062a\u062c\u064a\u0628 \u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0628\u062f\u0648\u0646 \u0645\u0641\u062a\u0627\u062d."},bmwmotorrad_reverse_assist_sensitivity:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0627\u0644\u0645\u0633\u0627\u0639\u062f \u0644\u0644\u0631\u062c\u0648\u0639 \u0644\u0644\u062e\u0644\u0641",desc:"\u064a\u0642\u0648\u0645 \u0628\u0636\u0628\u0637 \u0633\u0631\u0639\u0629 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0644\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0639\u0643\u0633\u064a \u0648\u062d\u062f \u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646."},ducati_riding_mode_custom_profile:{name:"\u0645\u0646\u0634\u0626 \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0645\u062e\u0635\u0635 \u0644\u0648\u0636\u0639 \u0627\u0644\u0631\u0643\u0648\u0628",desc:"\u064a\u0641\u062a\u062d \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0645\u062e\u0635\u0635\u0629 \u0644\u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0633\u0628\u0627\u0642 \u0648\u0627\u0644\u0631\u064a\u0627\u0636\u0629 \u0648\u0627\u0644\u062a\u062c\u0648\u0644 \u0648\u0627\u0644\u062d\u0636\u0631\u064a\u0629."},ducati_ohlins_suspension_mapping:{name:"\xd6hlins Smart EC 2.0 \u0631\u0633\u0645 \u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0634\u0628\u0647 \u0627\u0644\u0646\u0634\u0637",desc:"\u0636\u0628\u0637 \u0645\u0646\u062d\u0646\u0649 \u0627\u0644\u062a\u062e\u0645\u064a\u062f \u0648\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0633\u0628\u0642\u0629 \u0644\u0644\u0635\u0644\u0627\u0628\u0629 \u0644\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a."},ducati_dashboard_lap_timer_gps:{name:"\u0645\u0624\u0642\u062a \u0627\u0644\u062f\u0648\u0631\u0629 \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 TFT \u0648\u062a\u0642\u0633\u064a\u0645\u0627\u062a \u0642\u0637\u0627\u0639 \u0646\u0638\u0627\u0645 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0639\u0627\u0644\u0645\u064a (GPS).",desc:"\u064a\u0641\u062a\u062d \u0645\u0624\u0642\u062a \u062f\u0648\u0631\u0629 \u0627\u0644\u0645\u0633\u0627\u0631 \u0648\u0634\u0627\u0634\u0629 \u062a\u0642\u0633\u064a\u0645 \u0627\u0644\u0642\u0637\u0627\u0639 \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a."},ducati_engine_brake_control_ebc:{name:"\u062a\u0639\u062f\u064a\u0644 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 (EBC).",desc:"\u064a\u0636\u0628\u0637 \u0639\u0632\u0645 \u062f\u0648\u0631\u0627\u0646 \u062a\u0628\u0627\u0637\u0624 \u0627\u0644\u0639\u062c\u0644\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0623\u062b\u0646\u0627\u0621 \u0641\u0631\u0645\u0644\u0629 \u062f\u062e\u0648\u0644 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0635\u0644\u0628\u0629."},ducati_cruise_control_retrofit_enable:{name:"\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a\u0629 \u0644\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0633\u0631\u0639\u0629",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0639\u0644\u0627\u0645\u0629 \u0628\u0631\u0646\u0627\u0645\u062c \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 (ECU) \u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u0645\u0639\u062f\u0644\u0629."},ducati_exhaust_valve_sound_map:{name:"\u062e\u0631\u064a\u0637\u0629 RPM \u0644\u0641\u062a\u062d \u0635\u0645\u0627\u0645 \u0627\u0644\u0639\u0627\u062f\u0645 \u0627\u0644\u0645\u0624\u0627\u0632\u0631",desc:"\u064a\u0636\u0628\u0637 \u0639\u062a\u0628\u0629 \u0641\u062a\u062d \u0635\u0645\u0627\u0645 \u0627\u0644\u0639\u0627\u062f\u0645 \u0627\u0644\u0635\u0648\u062a\u064a \u0644\u062a\u062d\u0633\u064a\u0646 \u0635\u0648\u062a \u0627\u0644\u0639\u0627\u062f\u0645."},ducati_pit_lane_limiter_config:{name:"\u0639\u062a\u0628\u0629 \u0645\u062d\u062f\u062f \u0633\u0631\u0639\u0629 \u062d\u0627\u0631\u0629 \u0627\u0644\u062d\u0641\u0631\u0629",desc:"\u062a\u0645\u0643\u064a\u0646 \u062a\u0628\u062f\u064a\u0644 \u0645\u062d\u062f\u062f \u0633\u0631\u0639\u0629 \u062d\u0627\u0631\u0629 \u0627\u0644\u062d\u0641\u0631\u0629 \u0628\u0633\u0631\u0639\u0629 60 \u0643\u0645/\u0633\u0627\u0639\u0629 \u0639\u0644\u0649 \u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u0645\u0642\u0648\u062f."},ducati_desmo_service_light_reset:{name:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0636\u0648\u0621 \u062e\u062f\u0645\u0629 \u0635\u0645\u0627\u0645 \u0627\u0644\u0632\u064a\u062a \u0648\u0627\u0644\u062f\u064a\u0632\u0645\u0648",desc:"\u0645\u0633\u062d \u062a\u062d\u0630\u064a\u0631 \u062a\u0630\u0643\u064a\u0631 \u062e\u062f\u0645\u0629 \u0627\u0644\u0635\u0645\u0627\u0645 Desmodromic \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a."},ktm_quickshifter_plus_delay_tuning:{name:"Quickshifter + Shift Cut Time & Delay Tuning",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u062e\u0635\u064a\u0635 \u0645\u062f\u0629 \u0642\u0637\u0639 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0644\u0643\u0644 \u062a\u0631\u0633 \u0645\u0646 \u0623\u062c\u0644 \u0627\u0644\u062a\u062d\u0648\u0644\u0627\u062a \u0627\u0644\u0633\u0644\u0633\u0629 \u0644\u0623\u0639\u0644\u0649/\u0644\u0623\u0633\u0641\u0644."},ktm_rally_offroad_abs_tc_unlock:{name:"\u0641\u062a\u062d \u0648\u0636\u0639 \u0627\u0644\u0631\u0627\u0644\u064a/\u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u0648\u0639\u0631\u0629 ABS \u0648TC",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0639\u0637\u064a\u0644 \u0646\u0638\u0627\u0645 ABS \u0627\u0644\u062e\u0644\u0641\u064a \u0648\u064a\u0641\u062a\u062d \u0642\u0641\u0644 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642 \u0630\u0648 \u0627\u0644\u0640 9 \u0645\u0631\u0627\u062d\u0644 \u0641\u064a \u0648\u0636\u0639 Rally."},ktm_my_ktm_connectivity_unlock:{name:"\u062a\u0641\u0639\u064a\u0644 \u0648\u062d\u062f\u0629 \u0627\u062a\u0635\u0627\u0644 KTM / Husqvarna \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u064a",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u062a\u0646\u0642\u0644 \u0639\u0628\u0631 Bluetooth \u0648\u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629 \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 TFT."},ktm_cruise_control_retrofit_enable:{name:"\u0641\u062a\u062d \u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0646\u0634\u064a\u0637 \u0648\u0638\u064a\u0641\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0633\u0631\u0639\u0629 \u0628\u0639\u062f \u062a\u062b\u0628\u064a\u062a \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u0645\u0642\u0648\u062f."},ktm_clutch_pull_map_switch_gesture:{name:"\u062a\u0628\u062f\u064a\u0644 \u062e\u0631\u064a\u0637\u0629 \u0625\u064a\u0645\u0627\u0621\u0629 \u0627\u0644\u0642\u0627\u0628\u0636 \u0648\u0627\u0644\u0633\u062d\u0628",desc:"\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u062a\u0628\u062f\u064a\u0644 \u0627\u0644\u0633\u0631\u064a\u0639 \u0644\u0644\u062e\u0631\u064a\u0637\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062a\u0646\u0641\u064a\u0630 \u0625\u064a\u0645\u0627\u0621\u0629 \u0630\u0631\u0627\u0639 \u0627\u0644\u0642\u0627\u0628\u0636 \u0639\u0646\u062f \u0628\u062f\u0621 \u0627\u0644\u062a\u0634\u063a\u064a\u0644."},yamaha_quickshifter_cut_time_adjust:{name:"Quickshifter \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0642\u0637\u0639 \u0627\u0644\u0648\u0642\u062a \u0648\u0627\u0644\u062d\u0633\u0627\u0633\u064a\u0629",desc:"\u064a\u0636\u0628\u0637 \u062d\u062f \u062a\u062d\u0645\u064a\u0644 \u0645\u0633\u062a\u0634\u0639\u0631 \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0633\u0631\u064a\u0639 \u0648\u062a\u0623\u062e\u064a\u0631 \u0627\u0646\u0642\u0637\u0627\u0639 \u0627\u0644\u0634\u0631\u0627\u0631\u0629."},yamaha_ride_by_wire_throttle_map:{name:"\u0645\u062d\u062f\u062f \u0645\u0633\u0628\u0642 \u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u062e\u0627\u0646\u0642 Ride-by-Wire",desc:"\u0627\u0644\u062a\u0628\u062f\u064a\u0644 \u0628\u064a\u0646 \u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062e\u0627\u0646\u0642 A-Mode (\u0627\u0644\u0639\u062f\u0648\u0627\u0646\u064a\u0629)\u060c \u0648STD\u060c \u0648B-Mode (\u0627\u0644\u0633\u0644\u0633)."},yamaha_tft_track_theme_unlock:{name:"\u062a\u062e\u0637\u064a\u0637 \u0639\u0631\u0636 \u0627\u0644\u0645\u0633\u0627\u0631 TFT \u0648\u0641\u062a\u062d \u0636\u0648\u0621 \u0627\u0644\u062a\u062d\u0648\u0644",desc:"\u064a\u0641\u062a\u062d \u062a\u062e\u0637\u064a\u0637 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0645\u0633\u0627\u0631 R1/MT-09 SP \u0648\u0623\u0636\u0648\u0627\u0621 RPM \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0628\u0631\u0645\u062c\u0629."},yamaha_launch_control_sensitivity:{name:"\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0625\u0637\u0644\u0627\u0642 (LCS) \u0633\u0642\u0641 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0625\u0637\u0644\u0627\u0642 \u0645\u0639 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0639\u062f\u062f \u062f\u0648\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 (\u0646\u0637\u0627\u0642 \u0645\u0646 8000 \u0625\u0644\u0649 10000 \u062f\u0648\u0631\u0629 \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629)."},yamaha_heated_grips_accessory_enable:{name:"\u0645\u0642\u0627\u0628\u0636 \u0633\u0627\u062e\u0646\u0629 \u062d\u0642\u064a\u0642\u064a\u0629 \u062a\u0643\u0627\u0645\u0644 \u0642\u0627\u0626\u0645\u0629 TFT",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0645\u0642\u0628\u0636 \u0627\u0644\u0633\u0627\u062e\u0646 \u0648\u0645\u0642\u064a\u0627\u0633 \u062f\u0631\u062c\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 TFT."},honda_hstc_wheelie_control_fine_tune:{name:"\u0627\u0644\u0636\u0628\u0637 \u0627\u0644\u062f\u0642\u064a\u0642 \u0644\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062c\u0631 \u0648\u062d\u0631\u0643\u0629 \u0628\u0647\u0644\u0648\u0627\u0646\u064a\u0629 \u0628\u0627\u0644\u062f\u0631\u0627\u062c\u0629 HSTC",desc:"\u064a\u0636\u0628\u0637 \u0646\u0633\u0628\u0629 \u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642 \u0644\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u062d\u062f\u064a\u062f \u0645\u0646 \u0647\u0648\u0646\u062f\u0627 \u0648\u062a\u062d\u0645\u0644 \u0631\u0641\u0639 \u0627\u0644\u0639\u062c\u0644\u0627\u062a \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629."},honda_bi_directional_quickshifter_enable:{name:"\u0641\u062a\u062d \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a\u0629 Quickshifter \u062b\u0646\u0627\u0626\u064a\u0629 \u0627\u0644\u0627\u062a\u062c\u0627\u0647",desc:"\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0648\u0645\u064a\u0636 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0648\u062a\u0631\u0645\u064a\u0632 \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0633\u0631\u064a\u0639 \u0644\u0623\u0639\u0644\u0649/\u0644\u0623\u0633\u0641\u0644 \u0641\u064a \u0630\u0627\u0643\u0631\u0629 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629."},honda_service_reminder_custom_interval:{name:"\u0623\u062f\u0627\u0629 \u062a\u062e\u0635\u064a\u0635 \u0645\u0633\u0627\u0641\u0629 \u062a\u0630\u0643\u064a\u0631 \u062e\u062f\u0645\u0629 \u0627\u0644\u0646\u0641\u0637",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u0641\u0627\u0635\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0627\u0644\u0645\u062e\u0635\u0635 \u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0632\u064a\u062a \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629."},honda_track_abs_rear_disable:{name:"\u062a\u062a\u0628\u0639 \u0625\u0644\u063a\u0627\u0621 \u062a\u0646\u0634\u064a\u0637 \u0627\u0644\u0639\u062c\u0644\u0627\u062a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 ABS",desc:"\u062a\u0639\u0637\u064a\u0644 \u0642\u0646\u0627\u0629 ABS \u0644\u0644\u0639\u062c\u0644\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0645\u0639 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 ABS \u0641\u064a \u0627\u0644\u0645\u0646\u0639\u0637\u0641\u0627\u062a \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0645\u0633\u0627\u0631."},honda_cold_start_idle_enrichment:{name:"\u0625\u062b\u0631\u0627\u0621 \u0627\u0644\u0648\u0642\u0648\u062f \u0628\u0628\u062f\u0621 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0628\u0627\u0631\u062f \u0648\u0633\u0631\u0639\u0629 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629 \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u062e\u0645\u0648\u0644",desc:"\u064a\u0636\u0628\u0637 \u0633\u0631\u0639\u0629 \u0627\u0644\u062a\u0628\u0627\u0637\u0624 \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u0644\u0644\u0625\u062d\u0645\u0627\u0621 \u0644\u0623\u0646\u0638\u0645\u0629 \u0639\u0627\u062f\u0645 \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u0628\u064a\u0639."},harley_custom_throttle_curve_editor:{name:"\u0645\u062d\u0631\u0631 \u0645\u0646\u062d\u0646\u0649 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0627\u0644\u062e\u0627\u0646\u0642 \u0627\u0644\u0645\u062e\u0635\u0635",desc:"\u064a\u0636\u0628\u0637 \u062a\u0642\u062f\u0645 \u062f\u0648\u0627\u0633\u0629 \u0627\u0644\u0648\u0642\u0648\u062f \u0641\u064a Milwaukee-Eight / Revolution Max."},harley_security_alarm_sensitivity:{name:"\u0646\u0638\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0646 \u0627\u0644\u0630\u0643\u064a \u0648\u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u0642\u0631\u0628 \u0648\u0627\u0644\u0625\u0645\u0627\u0644\u0629",desc:"\u064a\u0636\u0628\u0637 \u062d\u0633\u0627\u0633\u064a\u0629 \u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u062d\u0631\u0643\u0629 \u0648\u062a\u0623\u062e\u064a\u0631 \u062a\u0633\u0644\u064a\u062d \u0641\u0648\u0628 \u0628\u062f\u0648\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u064a\u062f\u064a\u0646."},harley_boom_box_gts_hidden_diagnostics:{name:"\u0628\u0648\u0645! \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0645\u062e\u0641\u064a\u0629 \u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u0631\u0641\u064a\u0647 Box GTS",desc:"\u064a\u0641\u062a\u062d \u0634\u0627\u0634\u0627\u062a \u0627\u0644\u0642\u064a\u0627\u0633 \u0627\u0644\u0647\u0646\u062f\u0633\u064a\u0629 \u0639\u0646 \u0628\u0639\u062f\u060c \u0648\u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0645\u062d\u0631\u0643\u060c \u0648\u0623\u062c\u0647\u0632\u0629 \u0642\u064a\u0627\u0633 \u0636\u063a\u0637 \u0627\u0644\u0632\u064a\u062a."},harley_rdrs_defensive_system_tune:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642 \u0628\u0639\u0632\u0645 \u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u0633\u062d\u0628 RDRS",desc:"\u064a\u0642\u0648\u0645 \u0646\u0638\u0627\u0645 Reflex Defensive Rider System \u0628\u0636\u0628\u0637 \u0646\u0638\u0627\u0645 \u062a\u062e\u0641\u064a\u0641 \u0627\u0646\u0632\u0644\u0627\u0642 \u0627\u0644\u0639\u062c\u0644\u0627\u062a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0646\u0642\u0644 \u0625\u0644\u0649 \u0633\u0631\u0639\u0627\u062a \u0623\u0642\u0644."},byd_avas_low_speed_siren_mute:{name:"\u0643\u062a\u0645 \u0635\u0648\u062a \u0635\u0641\u0627\u0631\u0629 \u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0634\u0627\u0629 EV \u0645\u0646\u062e\u0641\u0636\u0629 \u0627\u0644\u0633\u0631\u0639\u0629 \u0645\u0646 AVAS",desc:"\u0643\u062a\u0645 \u0623\u0648 \u062e\u0641\u0636 \u0635\u0641\u0627\u0631\u0627\u062a \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0644\u0646\u0638\u0627\u0645 \u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0628\u0633\u0631\u0639\u0629 \u0623\u0642\u0644 \u0645\u0646 30 \u0643\u0645/\u0633\u0627\u0639\u0629."},byd_ev_battery_preheat_manual_switch:{name:"\u062a\u0628\u062f\u064a\u0644 \u0627\u0644\u062a\u0633\u062e\u064a\u0646 \u0627\u0644\u0645\u0633\u0628\u0642 \u0644\u0628\u0637\u0627\u0631\u064a\u0629 EV \u064a\u062f\u0648\u064a\u064b\u0627",desc:"\u064a\u062a\u064a\u062d \u0627\u0644\u062a\u0643\u064a\u064a\u0641 \u0627\u0644\u062d\u0631\u0627\u0631\u064a \u0644\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u064a\u062f\u0648\u064a\u064b\u0627 \u0642\u0628\u0644 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0633\u0631\u064a\u0639 \u0628\u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u0645\u0631."},byd_v2l_220v_outlet_power_expansion:{name:"V2L (\u0645\u0646 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u062d\u062a\u0649 \u0627\u0644\u062a\u062d\u0645\u064a\u0644) \u0645\u062e\u0631\u062c \u0637\u0627\u0642\u0629 220 \u0641\u0648\u0644\u062a (3.6 \u0643\u064a\u0644\u0648\u0648\u0627\u062a)",desc:"\u064a\u0648\u0633\u0639 \u0633\u0642\u0641 \u0637\u0627\u0642\u0629 \u0627\u0644\u062a\u0641\u0631\u064a\u063a \u0627\u0644\u062e\u0627\u0631\u062c\u064a V2L \u0645\u0646 2.2 \u0643\u064a\u0644\u0648\u0648\u0627\u062a \u0625\u0644\u0649 3.6 \u0643\u064a\u0644\u0648\u0648\u0627\u062a \u0643\u062d\u062f \u0623\u0642\u0635\u0649."},byd_one_pedal_regen_default_max:{name:"\u0627\u0644\u0643\u0628\u062d \u0627\u0644\u0645\u062a\u062c\u062f\u062f \u0644\u0644\u0645\u062d\u0631\u0643 \u0628\u062f\u0648\u0627\u0633\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0643\u0628\u062d \u0627\u0644\u0645\u062a\u062c\u062f\u062f \u0627\u0644\u0639\u0627\u0644\u064a \u0628\u0627\u0639\u062a\u0628\u0627\u0631\u0647 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u064b\u0627 \u0645\u0633\u062a\u0645\u0631\u064b\u0627 \u0639\u0646\u062f \u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},mg_ismart_connectivity_unlock:{name:"\u0627\u062a\u0635\u0627\u0644 i-SMART \u0648\u0641\u062a\u062d \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f",desc:"\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u062e \u0639\u0646 \u0628\u0639\u062f \u0648\u0645\u064a\u0632\u0627\u062a \u062a\u062a\u0628\u0639 \u062d\u0627\u0644\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},mg_mg4_xpower_launch_control_enable:{name:"\u0648\u0636\u0639 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0645\u0632\u062f\u0648\u062c MG4 XPower",desc:"\u064a\u0641\u062a\u062d \u0648\u0636\u0639 \u062a\u0633\u0631\u064a\u0639 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0625\u0637\u0644\u0627\u0642 \u0628\u0633\u0631\u0639\u0629 3.8 \u062b\u0627\u0646\u064a\u0629 \u0645\u0646 0 \u0625\u0644\u0649 100 \u0643\u0645/\u0633\u0627\u0639\u0629."},mg_battery_preheat_manual_trigger:{name:"\u0627\u0644\u062a\u0643\u064a\u064a\u0641 \u0627\u0644\u0645\u0633\u0628\u0642 \u0627\u0644\u064a\u062f\u0648\u064a \u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0633\u0631\u064a\u0639",desc:"\u064a\u0641\u0631\u0636 \u062a\u0634\u063a\u064a\u0644 \u0639\u0646\u0627\u0635\u0631 \u062a\u0633\u062e\u064a\u0646 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0630\u0627\u062a \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u0639\u062f\u0644\u0627\u062a \u0634\u062d\u0646 \u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0627\u0644\u0642\u0635\u0648\u0649."},xpeng_xngp_adas_region_unlock:{name:"\u0641\u062a\u062d \u0645\u0646\u0637\u0642\u0629 \u0645\u0633\u0627\u0639\u062f \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0630\u0627\u062a\u064a\u0629 XNGP",desc:"\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0627\u0644\u0645\u0648\u062c\u0647\u0629 \u0644\u0644\u062a\u0646\u0642\u0644 \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u063a\u064a\u0631 \u0627\u0644\u0645\u0624\u0645\u0646\u0629."},xpeng_ambient_lighting_music_sync:{name:"\u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0628\u0627\u0644\u0625\u064a\u0642\u0627\u0639 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u064a \u0627\u0644\u0645\u062a\u0641\u0627\u0639\u0644",desc:"\u064a\u0642\u0648\u0645 \u0628\u0645\u0632\u0627\u0645\u0646\u0629 \u0646\u0628\u0636\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 LED \u0628\u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0645\u0639 \u0625\u064a\u0642\u0627\u0639\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0635\u0648\u062a\u064a."},xpeng_rear_camera_trailer_hitch_view:{name:"\u0648\u0635\u0644\u0629 \u0631\u0628\u0637 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0628\u0632\u0627\u0648\u064a\u0629 360 \u062f\u0631\u062c\u0629 \u0648\u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0627\u0643\u0628 \u0627\u0644\u0623\u0631\u0636\u064a",desc:"\u064a\u0636\u064a\u0641 \u062a\u0631\u0627\u0643\u0628 \u0634\u0628\u0643\u0629 \u0645\u062d\u0627\u0630\u0627\u0629 \u0648\u0635\u0644\u0629 \u0627\u0644\u0648\u0635\u0644 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062f\u0642\u0629 \u0625\u0644\u0649 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629."},nio_battery_swap_interval_reminder:{name:"\u0648\u0636\u0639 \u0627\u0644\u062a\u0643\u064a\u064a\u0641 \u0627\u0644\u0645\u0633\u0628\u0642 \u0644\u0645\u062d\u0637\u0629 \u062a\u0628\u062f\u064a\u0644 \u0627\u0644\u0637\u0627\u0642\u0629",desc:"\u064a\u0642\u0648\u0645 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0628\u062e\u0641\u0636 \u062f\u0628\u0627\u0628\u064a\u0633 \u0642\u0641\u0644 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0648\u062d\u0632\u0645 \u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u0645\u0633\u0628\u0642\u0629 \u0642\u0628\u0644 \u0627\u0644\u062a\u0628\u062f\u064a\u0644."},nio_nomi_assistant_custom_voice_phrases:{name:"NOMI AI Companion Personalization & Wake Words",desc:"\u064a\u0641\u062a\u062d \u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u0635\u0648\u0631 \u0627\u0644\u0631\u0645\u0632\u064a\u0629 \u0648\u0639\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u062d\u064a\u0629 \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0644\u0640 NOMI."},nio_sentry_watchdog_continuous_recording:{name:"NIO Sentry Mode 4K \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u062e\u0632\u0646 \u0627\u0644\u0645\u0624\u0642\u062a \u0644\u0644\u0643\u0627\u0645\u064a\u0631\u0627",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0645\u062d\u064a\u0637\u064a\u0629 \u0630\u0627\u062a \u0645\u0639\u062f\u0644 \u0627\u0644\u0628\u062a \u0627\u0644\u0639\u0627\u0644\u064a \u0639\u0644\u0649 \u0645\u062d\u0631\u0643 \u0623\u0642\u0631\u0627\u0635 USB \u0639\u0646\u062f \u0627\u0644\u0648\u0642\u0648\u0641."},xiaomi_su7_hyperos_driver_profile_sync:{name:"\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0628\u0631\u0646\u0627\u0645\u062c \u062a\u0634\u063a\u064a\u0644 Xiaomi SU7 HyperOS Ecosystem Sync",desc:"\u064a\u0642\u0648\u0645 \u0628\u0645\u0632\u0627\u0645\u0646\u0629 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0642\u0639\u062f \u0648\u0627\u0644\u0645\u0631\u0622\u0629 \u0648\u0627\u0644\u0645\u0646\u0627\u062e \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0628\u0631 \u0647\u0627\u062a\u0641 Xiaomi Bluetooth."},xiaomi_su7_boost_mode_throttle_curve:{name:"\u0648\u0636\u0639 \u0627\u0644\u062a\u0639\u0632\u064a\u0632: \u0641\u062a\u062d \u0642\u0648\u0629 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0632\u0627\u0626\u062f \u0644\u0645\u062f\u0629 20 \u062b\u0627\u0646\u064a\u0629",desc:"\u064a\u0637\u064a\u0644 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0645\u062f\u0629 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0632\u0627\u0626\u062f \u0644\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0633\u0627\u0631\u0639 \u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u0644\u062e\u0627\u0646\u0642."},xiaomi_su7_drift_mode_torque_vectoring:{name:"\u0648\u0636\u0639 \u0627\u0644\u0627\u0646\u062c\u0631\u0627\u0641 \u062a\u062e\u0635\u064a\u0635 \u062a\u0648\u062c\u064a\u0647 \u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 RWD",desc:"\u064a\u062e\u0635\u0635 \u0639\u0632\u0645 \u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u0645\u062d\u0631\u0643 \u0628\u0646\u0633\u0628\u0629 100% \u0644\u0644\u0645\u062d\u0648\u0631 \u0627\u0644\u062e\u0644\u0641\u064a \u0645\u0639 \u0641\u0635\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062c\u0631."},chery_isa_overspeed_warning_chime_off:{name:"ISA Intelligent Speed \u200b\u200bAssist \u062a\u062d\u0630\u064a\u0631 \u0627\u0644\u0631\u0646\u064a\u0646 \u0643\u062a\u0645 \u0627\u0644\u0635\u0648\u062a",desc:"\u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u0631\u0646\u064a\u0646 \u0627\u0644\u0635\u0648\u062a\u064a \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0639\u0646\u062f \u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0645\u0643\u062a\u0634\u0641\u0629."},chery_driver_monitoring_camera_sensitivity:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u062a\u0639\u0628 \u0633\u0627\u0626\u0642 DMS",desc:"\u064a\u0642\u0644\u0644 \u0645\u0646 \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0644\u062a\u0634\u062a\u064a\u062a \u0627\u0644\u0625\u064a\u062c\u0627\u0628\u064a\u0629 \u0627\u0644\u0643\u0627\u0630\u0628\u0629 \u0645\u0646 \u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629."},retrofit_parking_sensor_coding:{name:"\u062a\u0631\u0645\u064a\u0632 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0645\u0633\u0627\u0641\u0629 \u0631\u0643\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a/\u0627\u0644\u062e\u0644\u0641\u064a (PDC) \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a",desc:"\u064a\u0633\u062c\u0644 \u0648\u062d\u062f\u0629 \u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0648\u0642\u0648\u0641 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u0628\u064a\u0639 \u0623\u0648 OEM \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u0628\u0648\u0627\u0628\u0629."},retrofit_360_camera_activation:{name:"\u062a\u062d\u062f\u064a\u062b \u0646\u0638\u0627\u0645 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0645\u062d\u064a\u0637\u064a\u0629 \u0644\u0639\u0631\u0636 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0628\u0632\u0627\u0648\u064a\u0629 360 \u062f\u0631\u062c\u0629",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0646\u0634\u064a\u0637 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u064a\u0629 \u0648\u064a\u0636\u064a\u0641 \u0639\u0631\u0636 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0625\u0644\u0649 \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u0631\u0641\u064a\u0647."},retrofit_led_license_plate_light_coding:{name:"\u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a\u0629 LED \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 \u0648\u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u062e\u0644\u0641\u064a \u062e\u0637\u0623 \u0625\u0644\u063a\u0627\u0621",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u0639\u0637\u064a\u0644 \u0645\u0631\u0627\u0642\u0628\u0629 \u0641\u062d\u0635 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0628\u0627\u0631\u062f \u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u062d\u0630\u064a\u0631\u0627\u062a \u0627\u0644\u0643\u0627\u0630\u0628\u0629 \u0645\u0646 \u0627\u0646\u0642\u0637\u0627\u0639 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0635\u0627\u0628\u064a\u062d LED."},retrofit_dash_cam_sentry_integration:{name:"\u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a\u0629 \u0643\u0627\u0645\u064a\u0631\u0627 \u062f\u0627\u0634 \u0643\u0627\u0645 \u0642\u0648\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0648\u0648\u0636\u0639 \u0627\u0644\u062d\u0631\u0627\u0633\u0629",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u062e\u0637 \u0627\u0644\u0637\u0627\u0642\u0629 \u0631\u0642\u0645 30 \u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062c\u0633\u0645 \u0644\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0644\u0648\u0642\u0648\u0641 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a."},retrofit_heated_windshield_activation:{name:"\u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a\u0629 \u062a\u0631\u0645\u064a\u0632 \u0639\u0646\u0635\u0631 \u0627\u0644\u0632\u062c\u0627\u062c \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0627\u0644\u0645\u0633\u062e\u0646",desc:"\u062a\u0645\u0643\u064a\u0646 \u0625\u062e\u0631\u0627\u062c \u0645\u0631\u062d\u0644 \u0633\u062e\u0627\u0646 \u062a\u0630\u0648\u064a\u0628 \u0627\u0644\u0632\u062c\u0627\u062c \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0648\u0632\u0631 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u0646\u0627\u062e\u064a\u0629."},retrofit_wireless_charger_module_coding:{name:"\u062a\u062d\u062f\u064a\u062b \u0644\u0648\u062d\u0629 \u0634\u062d\u0646 \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0630\u0643\u064a \u0627\u0644\u0644\u0627\u0633\u0644\u0643\u064a Qi",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0645\u0624\u0634\u0631 LED \u0627\u0644\u062e\u0627\u0635 \u0628\u062d\u0627\u0644\u0629 \u0627\u0644\u0634\u0627\u062d\u0646 \u0627\u0644\u0644\u0627\u0633\u0644\u0643\u064a \u0648\u062a\u0631\u0643 \u0627\u0644\u0647\u0627\u062a\u0641 \u062e\u0644\u0641 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629 \u0644\u0644\u062a\u0630\u0643\u064a\u0631."},retrofit_acc_radar_module_coding:{name:"\u0648\u062d\u062f\u0629 \u0627\u0644\u0631\u0627\u062f\u0627\u0631 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u062d\u062f\u062b\u0629 \u0644\u0646\u0638\u0627\u0645 \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u062a\u0643\u064a\u0641\u064a (ACC).",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0634\u0641\u064a\u0631 \u0648\u062d\u062f\u0629 \u0631\u0627\u062f\u0627\u0631 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u0639\u062f\u0644\u0629 \u0641\u064a \u0634\u0628\u0643\u0629 \u0645\u0631\u0643\u0628\u0627\u062a \u062d\u0627\u0641\u0644\u0627\u062a CAN."},retrofit_traffic_sign_camera_activation:{name:"\u062a\u062d\u062f\u064a\u062b \u062a\u0631\u0645\u064a\u0632 \u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0632\u062c\u0627\u062c \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0644\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0639\u0644\u0627\u0645\u0629 VZE \u0639\u0644\u0649 \u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0632\u062c\u0627\u062c \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0627\u0644\u0645\u0639\u062f\u0644\u0629."},retrofit_heated_steering_wheel_coding:{name:"\u062a\u0641\u0639\u064a\u0644 \u0648\u062d\u062f\u0629 \u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0645\u062f\u0641\u0623\u0629 \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a\u0629",desc:"\u062a\u0645\u0643\u0646 \u0645\u0646 \u0625\u062e\u0631\u0627\u062c \u0639\u0646\u0635\u0631 \u062a\u0633\u062e\u064a\u0646 \u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0648\u0645\u0634\u063a\u0644\u0627\u062a \u062f\u0631\u062c\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629."},retrofit_fatigue_camera_calibration:{name:"\u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a\u0629 \u0627\u0644\u062a\u0643\u0627\u0645\u0644 \u0643\u0627\u0645\u064a\u0631\u0627 \u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u062a\u0639\u0628 \u0627\u0644\u0633\u0627\u0626\u0642",desc:"\u064a\u0642\u0648\u0645 \u0628\u0645\u0639\u0627\u064a\u0631\u0629 \u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0628\u0627\u0644\u0623\u0634\u0639\u0629 \u062a\u062d\u062a \u0627\u0644\u062d\u0645\u0631\u0627\u0621 \u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0633\u0627\u0626\u0642 \u0628\u0639\u062f \u062a\u062b\u0628\u064a\u062a \u0639\u0645\u0648\u062f \u0627\u0644\u062a\u0648\u062c\u064a\u0647."},retrofit_trailer_hitch_module_coding:{name:"\u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a \u0644\u0642\u0636\u064a\u0628 \u0627\u0644\u0642\u0637\u0631 \u0648\u062a\u0643\u0627\u0645\u0644 \u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0644\u0644\u0645\u0642\u0637\u0648\u0631\u0629",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0634\u0641\u064a\u0631 \u0648\u062d\u062f\u0629 \u0627\u0644\u0645\u0642\u0637\u0648\u0631\u0629 \u0641\u064a \u0646\u0638\u0627\u0645 \u0627\u0644\u0627\u0633\u062a\u0642\u0631\u0627\u0631 ESP \u0644\u062a\u062e\u0641\u064a\u0641 \u062a\u0623\u062b\u064a\u0631 \u0627\u0644\u0645\u0642\u0637\u0648\u0631\u0629."},retrofit_power_tailgate_trunk_kit_coding:{name:"\u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0644\u0644\u0628\u0627\u0628 \u0627\u0644\u062e\u0644\u0641\u064a \u0648\u062a\u0643\u0627\u0645\u0644 \u0645\u0633\u062a\u0634\u0639\u0631 \u0625\u064a\u0645\u0627\u0621\u0627\u062a \u0627\u0644\u0642\u062f\u0645",desc:"\u062a\u0645\u0643\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u062f\u0641\u0639 \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0648\u062a\u0631\u0645\u064a\u0632 \u0645\u0633\u062a\u0634\u0639\u0631 \u0631\u0643\u0644\u0629 \u0627\u0644\u0645\u0635\u062f."},easteregg_urban_joke_light_show:{name:"\u0639\u0631\u0636 \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u062e\u0644\u0641\u064a \u0627\u0644\u0645\u062a\u0646\u0627\u0648\u0628 \u0644\u0644\u0646\u0643\u062a\u0629 \u0627\u0644\u062d\u0636\u0631\u064a\u0629",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0648\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0644\u0644\u0648\u0645\u064a\u0636 \u0628\u0627\u0644\u062a\u0646\u0627\u0648\u0628 \u0639\u0646\u062f \u0642\u0641\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},easteregg_custom_boot_greeting_text:{name:"\u0646\u0635 \u062a\u062d\u064a\u0629 \u062a\u0645\u0647\u064a\u062f\u064a \u0645\u062e\u0635\u0635 \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629",desc:"\u064a\u0639\u0631\u0636 \u0631\u0633\u0627\u0644\u0629 \u062a\u0631\u062d\u064a\u0628 \u0645\u062e\u0635\u0635\u0629 \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a \u0639\u0646\u062f \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0644."},easteregg_cluster_mini_game_mode:{name:"\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u0645\u0635\u063a\u0631\u0629 \u0627\u0644\u0645\u062e\u0641\u064a\u0629 \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0623\u062f\u0648\u0627\u062a",desc:"\u064a\u0641\u062a\u062d \u0644\u0639\u0628\u0629 \u0635\u063a\u064a\u0631\u0629 \u0642\u062f\u064a\u0645\u0629 \u064a\u062a\u0645 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a\u0647\u0627 \u0628\u0648\u0627\u0633\u0637\u0629 \u0632\u0631 \u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0648\u064a\u062a\u0645 \u0639\u0631\u0636\u0647\u0627 \u0639\u0646\u062f \u0631\u0643\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},easteregg_custom_horn_melody_package:{name:"\u0628\u0648\u0642 \u0635\u0648\u062a\u064a \u0645\u062e\u0635\u0635 \u0644\u062d\u0646 \u0627\u0644\u062a\u0631\u062d\u064a\u0628",desc:"\u064a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644 \u0646\u0645\u0637 \u063a\u0631\u062f \u0625\u064a\u0642\u0627\u0639\u064a \u0642\u0635\u064a\u0631 \u0639\u0644\u0649 \u0627\u0644\u0628\u0648\u0642 \u0639\u0646\u062f \u0641\u062a\u062d \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},easteregg_welcome_lighting_door_sequence:{name:"\u0645\u0637\u0627\u0631\u062f\u0629 \u062a\u0633\u0644\u0633\u0644 \u0628\u0627\u0628 \u0636\u0648\u0621 \u0627\u0644\u062a\u0631\u062d\u064a\u0628 LED",desc:"\u064a\u0646\u0641\u0630 \u0631\u0633\u0648\u0645 \u0645\u062a\u062d\u0631\u0643\u0629 \u0645\u0637\u0627\u0631\u062f\u0629 LED \u062a\u0642\u062f\u0645\u064a\u0629 \u0639\u0644\u0649 \u0645\u0642\u0627\u0628\u0636 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629."},easteregg_developer_service_menu_shortcut:{name:"\u0627\u062e\u062a\u0635\u0627\u0631 \u0634\u0627\u0634\u0629 \u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0645\u0637\u0648\u0631 \u0648\u0627\u0644\u062e\u062f\u0645\u0629",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0627\u062e\u062a\u0635\u0627\u0631 \u0627\u0644\u0625\u064a\u0645\u0627\u0621\u0627\u062a \u0627\u0644\u0633\u0631\u064a\u0639\u0629 \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0634\u0627\u0634\u0627\u062a \u0627\u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0627\u0644\u0645\u062e\u0641\u064a\u0629."},easteregg_seasonal_cluster_theme_effect:{name:"\u062a\u0631\u0627\u0643\u0628 \u0633\u0645\u0629 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u0645\u0648\u0633\u0645\u064a\u0629 (\u0646\u062f\u0641\u0629 \u0627\u0644\u062b\u0644\u062c/\u0627\u0644\u0645\u0637\u0631)",desc:"\u064a\u0636\u064a\u0641 \u0646\u062f\u0641\u0629 \u0627\u0644\u062b\u0644\u062c \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 \u0623\u0648 \u062e\u0644\u0641\u064a\u0629 \u062c\u0633\u064a\u0645\u0627\u062a \u0627\u0644\u0645\u0637\u0631 \u0644\u0642\u064a\u0627\u0633 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0641\u064a \u0641\u0635\u0644 \u0627\u0644\u0634\u062a\u0627\u0621."},easteregg_valet_mode_prank_warning_message:{name:"\u062a\u062d\u0630\u064a\u0631 \u0645\u0646\u0628\u062b\u0642 \u0644\u062d\u062f\u0648\u062f \u0627\u0644\u0633\u0631\u0639\u0629 \u0641\u064a \u0648\u0636\u0639 Valet Mode",desc:"\u064a\u0639\u0631\u0636 \u0631\u0633\u0627\u0644\u0629 \u062a\u062d\u0630\u064a\u0631 \u0635\u0627\u0631\u0645\u0629 \u0628\u0634\u0643\u0644 \u0641\u0643\u0627\u0647\u064a \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0641\u064a \u062d\u0627\u0644\u0629 \u062a\u062c\u0627\u0648\u0632 \u0648\u0636\u0639 \u0631\u0643\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},adas_lane_keep_assist_gentle_curve:{name:"\u0645\u0633\u0627\u0639\u062f \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0631 (LKA) \u0645\u0646\u062d\u0646\u0649 \u062a\u062f\u062e\u0644 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0644\u0637\u064a\u0641",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u062e\u0641\u064a\u0641 \u0627\u0644\u0634\u062f \u0627\u0644\u0645\u0641\u0627\u062c\u0626 \u0644\u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u062f\u062e\u0644 \u0627\u0644\u062a\u062f\u0631\u064a\u062c\u064a \u0641\u064a \u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646."},adas_lka_last_state_memory_mode:{name:"\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0631\u060c \u0642\u0641\u0644 \u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629",desc:"\u064a\u0645\u0646\u0639 LKA \u0645\u0646 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u064a\u062a\u0645 \u0641\u064a\u0647\u0627 \u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0644."},adas_acc_default_follow_distance:{name:"\u0645\u062b\u0628\u062a \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u062a\u0643\u064a\u0641\u064a (ACC) \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0645\u0633\u0628\u0642\u064b\u0627",desc:"\u064a\u0636\u0628\u0637 \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0641\u062c\u0648\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a (\u0645\u0646 1 \u0625\u0644\u0649 4 \u0623\u0634\u0631\u0637\u0629) \u0639\u0646\u062f \u062a\u0634\u063a\u064a\u0644 ACC."},adas_acc_speed_step_adjustment:{name:"\u0645\u062d\u062f\u062f \u062e\u0637\u0648\u0629 \u0632\u064a\u0627\u062f\u0629 \u0633\u0631\u0639\u0629 \u0627\u0644\u0633\u0631\u0639\u0629 ACC (+5 / +10 \u0643\u0645/\u0633\u0627\u0639\u0629)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u063a\u064a\u064a\u0631 \u062e\u0637\u0648\u0629 \u0632\u0631 \u0633\u0631\u0639\u0629 \u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0628\u0627\u0644\u0636\u063a\u0637 \u0644\u0641\u062a\u0631\u0629 \u0642\u0635\u064a\u0631\u0629 \u0645\u0646 1 \u0643\u0645/\u0633\u0627\u0639\u0629 \u0625\u0644\u0649 5 \u0643\u0645/\u0633\u0627\u0639\u0629."},adas_matrix_led_glare_free_high_beam_unlock:{name:"\u062f\u0631\u0639 \u0648\u0647\u062c \u0639\u0627\u0644\u064a \u0627\u0644\u0634\u0639\u0627\u0639 \u0645\u062a\u0643\u064a\u0641 \u0648\u062e\u0627\u0644\u064a \u0645\u0646 \u0627\u0644\u0648\u0647\u062c \u0645\u0646 Matrix LED",desc:"\u064a\u0641\u062a\u062d \u0627\u0644\u0634\u0639\u0627\u0639 \u0627\u0644\u0639\u0627\u0644\u064a \u0627\u0644\u0645\u062a\u0643\u064a\u0641 \u0628\u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a\u0629 \u0641\u064a \u0633\u064a\u0627\u0631\u0627\u062a \u0623\u0645\u0631\u064a\u0643\u0627 \u0627\u0644\u0634\u0645\u0627\u0644\u064a\u0629."},adas_traffic_jam_assist_follow_fine_tune:{name:"\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u0627\u0632\u062f\u062d\u0627\u0645 \u0627\u0644\u0645\u0631\u0648\u0631 \u0648\u062a\u0623\u062e\u064a\u0631 \u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u0627\u0644\u062a\u0648\u0642\u0641 \u0648\u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642",desc:"\u064a\u0648\u0633\u0639 \u0646\u0627\u0641\u0630\u0629 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0644\u0644\u062a\u0648\u0642\u0641 \u0648\u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0645\u0646 3 \u062b\u0648\u0627\u0646\u064d \u0625\u0644\u0649 15 \u062b\u0627\u0646\u064a\u0629."},adas_rear_radar_blind_spot_zero_point_reset:{name:"\u0631\u0627\u062f\u0627\u0631 \u0627\u0644\u0646\u0642\u0637\u0629 \u0627\u0644\u0639\u0645\u064a\u0627\u0621 \u0627\u0644\u062e\u0644\u0641\u064a\u0629\u060c \u0645\u0639\u0627\u064a\u0631\u0629 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0646\u0642\u0637\u0629 \u0635\u0641\u0631",desc:"\u064a\u0639\u064a\u062f \u0645\u0639\u0627\u064a\u0631\u0629 \u0632\u0627\u0648\u064a\u0629 \u0633\u0645\u062a \u0631\u0627\u062f\u0627\u0631 \u0627\u0644\u0645\u0635\u062f \u0627\u0644\u062e\u0644\u0641\u064a \u0628\u0639\u062f \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0645\u0635\u062f \u0623\u0648 \u0625\u0635\u0644\u0627\u062d\u0647."},adas_surround_camera_stitching_recalib:{name:"\u0645\u062d\u0627\u0630\u0627\u0629 \u062e\u064a\u0627\u0637\u0629 \u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629 \u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u064a\u0629",desc:"\u064a\u0646\u0641\u0630 \u0645\u0639\u0627\u064a\u0631\u0629 \u062e\u064a\u0627\u0637\u0629 \u0635\u0648\u0631\u0629 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0637\u0631\u064a\u0642."},adas_steering_angle_sensor_zero_point_reset:{name:"\u0645\u0633\u062a\u0634\u0639\u0631 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 (SAS) \u0645\u0639\u0627\u064a\u0631\u0629 \u0646\u0642\u0637\u0629 \u0627\u0644\u0635\u0641\u0631",desc:"\u064a\u0639\u064a\u062f \u0636\u0628\u0637 \u0632\u0627\u0648\u064a\u0629 \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0625\u0644\u0649 0.0 \u062f\u0631\u062c\u0629 \u0628\u0639\u062f \u062e\u062f\u0645\u0629 \u0645\u062d\u0627\u0630\u0627\u0629 \u0627\u0644\u0639\u062c\u0644\u0627\u062a."},adas_cross_traffic_alert_sensitivity_adjust:{name:"\u0646\u0637\u0627\u0642 \u0627\u0644\u0643\u0634\u0641 \u0639\u0646 \u062a\u0646\u0628\u064a\u0647 \u062d\u0631\u0643\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 (RCTA).",desc:"\u064a\u0632\u064a\u062f \u0645\u0646 \u0645\u0633\u0627\u0641\u0629 \u0643\u0634\u0641 \u0627\u0644\u0631\u0627\u062f\u0627\u0631 \u0627\u0644\u062c\u0627\u0646\u0628\u064a \u0644\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0642\u062a\u0631\u0628 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0631\u0627\u062c\u0639."},adas_aeb_emergency_braking_threshold_preview:{name:"\u0641\u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 (AEB).",desc:"\u064a\u0636\u0628\u0637 \u062a\u0648\u0642\u064a\u062a \u0631\u0646\u064a\u0646 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0627\u0644\u0645\u0628\u0643\u0631 \u0648\u0627\u0644\u0645\u062a\u0623\u062e\u0631 \u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0644\u0627\u0635\u0637\u062f\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0645\u064a."},adas_night_vision_camera_alignment:{name:"\u0627\u0644\u0623\u0634\u0639\u0629 \u062a\u062d\u062a \u0627\u0644\u062d\u0645\u0631\u0627\u0621 \u0644\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0644\u064a\u0644\u064a\u0629 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629 \u0645\u062d\u0627\u0630\u0627\u0629 \u0627\u0644\u0647\u062f\u0641",desc:"\u064a\u0628\u062f\u0623 \u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u062d\u0627\u0630\u0627\u0629 \u0642\u0627\u0639\u062f\u0629 \u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0623\u0634\u0639\u0629 \u062a\u062d\u062a \u0627\u0644\u062d\u0645\u0631\u0627\u0621."},adas_dms_driver_monitoring_ir_threshold:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0623\u0634\u0639\u0629 \u062a\u062d\u062a \u0627\u0644\u062d\u0645\u0631\u0627\u0621 \u0644\u0644\u0633\u0627\u0626\u0642 DMS",desc:"\u064a\u0636\u0628\u0637 \u0639\u062a\u0628\u0629 \u062a\u062a\u0628\u0639 \u0627\u0644\u0639\u064a\u0646 \u0644\u0644\u0633\u0627\u0626\u0642\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0631\u062a\u062f\u0648\u0646 \u0646\u0638\u0627\u0631\u0627\u062a \u0634\u0645\u0633\u064a\u0629 \u0645\u0633\u062a\u0642\u0637\u0628\u0629 \u062f\u0627\u0643\u0646\u0629."},toyota_soft_close_door_retrofit_coding:{name:"\u062a\u0631\u0645\u064a\u0632 \u0645\u0634\u063a\u0644 \u0641\u0631\u0627\u063a \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0630\u0648 \u0627\u0644\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0639\u0645",desc:"\u062a\u0645\u0643\u0646 \u0645\u0634\u063a\u0644\u0627\u062a \u0633\u062d\u0628 \u0645\u0632\u0644\u0627\u062c \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0641\u064a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u062c\u0633\u0645."},toyota_digital_speedometer_display_enable:{name:"\u0634\u0627\u0634\u0629 \u0639\u0631\u0636 \u0645\u0631\u0643\u0632\u064a\u0629 \u0644\u0639\u062f\u0627\u062f \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0631\u0642\u0645\u064a",desc:"\u064a\u0636\u064a\u0641 \u0642\u0631\u0627\u0621\u0627\u062a \u0631\u0642\u0645\u064a\u0629 \u0643\u0628\u064a\u0631\u0629 \u0644\u0644\u0633\u0631\u0639\u0629 \u0625\u0644\u0649 \u0634\u0627\u0634\u0629 LCD \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0646\u0627\u0638\u0631\u064a\u0629."},toyota_walk_away_auto_lock_sensitivity:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0642\u0641\u0644 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a Walk-Away",desc:"\u064a\u0636\u0628\u0637 \u0639\u062a\u0628\u0629 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0642\u0628\u0644 \u0642\u0641\u0644 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u0627\u0644\u0627\u0628\u062a\u0639\u0627\u062f."},toyota_jbl_3d_eq_audio_profile_unlock:{name:"\u0645\u0646\u062d\u0646\u064a\u0627\u062a \u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062d\u064a\u0637\u064a \u0627\u0644\u0645\u062a\u0645\u064a\u0632 \u0645\u0646 JBL",desc:"\u064a\u0641\u062a\u062d \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0645\u0639\u0627\u062f\u0644 \u0642\u0627\u0639\u0629 \u0627\u0644\u062d\u0641\u0644\u0627\u062a \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u064a\u0629 \u062b\u0644\u0627\u062b\u064a\u0629 \u0627\u0644\u0623\u0628\u0639\u0627\u062f \u0641\u064a \u0648\u062d\u062f\u0629 \u0631\u0623\u0633 \u0627\u0644\u0635\u0648\u062a JBL."},toyota_ev_mode_throttle_override_suppression:{name:"\u0648\u0636\u0639 EV\u060c \u0642\u0645\u0639 \u062d\u062f \u0627\u0644\u062e\u0627\u0646\u0642 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0627\u0644\u0646\u0642\u064a",desc:"\u064a\u0645\u0646\u0639 \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u0646\u0632\u064a\u0646 \u0645\u0646 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0633\u0627\u0631\u0639 \u0627\u0644\u0645\u0639\u062a\u062f\u0644 \u0644\u0644\u0645\u0631\u0643\u0628\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629."},ford_sync3_engineering_diagnostics_page:{name:"SYNC3 / SYNC4 \u0634\u0627\u0634\u0629 \u062a\u0634\u062e\u064a\u0635\u064a\u0629 \u0647\u0646\u062f\u0633\u064a\u0629 \u062a\u0639\u0645\u0644 \u0628\u0627\u0644\u0644\u0645\u0633",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0634\u0627\u0634\u0627\u062a GPS \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u0648\u0627\u062e\u062a\u0628\u0627\u0631 APIM \u0648\u0634\u0627\u0634\u0627\u062a \u062a\u0634\u062e\u064a\u0635 \u062a\u0631\u062f\u062f \u0627\u0644\u0635\u0648\u062a \u0639\u0644\u0649 SYNC."},ford_rear_seat_entertainment_unlock:{name:"HDMI \u0644\u0644\u0645\u0642\u0639\u062f \u0627\u0644\u062e\u0644\u0641\u064a / \u062a\u0645\u0631\u064a\u0631 \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0627\u0644\u062a\u0631\u0641\u064a\u0647\u064a",desc:"\u064a\u062a\u064a\u062d \u0628\u062b \u0627\u0644\u0635\u0648\u062a \u0639\u0628\u0631 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0631\u0623\u0633 \u0641\u064a \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0644\u0634\u0627\u0634\u0627\u062a \u0627\u0644\u062a\u0631\u0641\u064a\u0647 \u0641\u064a \u0627\u0644\u0645\u0642\u0639\u062f \u0627\u0644\u062e\u0644\u0641\u064a."},ford_bambi_mode_fog_light_expansion:{name:"\u0648\u0636\u0639 \u0628\u0627\u0645\u0628\u064a \u0634\u0639\u0627\u0639 \u0639\u0627\u0644\u064d + \u0625\u0636\u0627\u0621\u0629 \u0636\u0628\u0627\u0628\u064a\u0629 \u0645\u062a\u0632\u0627\u0645\u0646\u0629",desc:"\u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u062a\u0634\u063a\u064a\u0644 \u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0636\u0628\u0627\u0628 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u062d\u062a\u0649 \u0639\u0646\u062f \u062a\u0646\u0634\u064a\u0637 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0630\u0627\u062a \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u0639\u0627\u0644\u064a."},ford_auto_engine_idle_shutdown_30min_override:{name:"\u062a\u0639\u0637\u064a\u0644 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0644\u0645\u062f\u0629 30 \u062f\u0642\u064a\u0642\u0629",desc:"\u064a\u0645\u0646\u0639 \u0627\u0644\u0645\u062d\u0631\u0643 \u0645\u0646 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0628\u0639\u062f 30 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u0648\u0642\u0648\u0641."},hyundai_n_grin_shift_retrofit_enable:{name:"N Grin Shift (NGS) \u0641\u062a\u062d \u0627\u0644\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u064a \u0644\u0645\u062f\u0629 20 \u062b\u0627\u0646\u064a\u0629",desc:"\u062a\u0645\u0643\u064a\u0646 \u0648\u0638\u064a\u0641\u0629 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0632\u0627\u0626\u062f \u0644\u0632\u0631 NGS \u0641\u064a \u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0641\u064a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629."},hyundai_smart_tailgate_approach_distance:{name:"\u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u0642\u0631\u0628 \u0627\u0644\u0630\u0643\u064a \u0644\u0646\u0647\u062c \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062e\u0644\u0641\u064a \u0628\u062f\u0648\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u064a\u062f\u064a\u0646",desc:"\u064a\u0636\u0628\u0637 \u0648\u0642\u062a \u062a\u0623\u062e\u064a\u0631 \u0627\u0644\u0648\u0642\u0648\u0641 (\u0645\u0646 3 \u062b\u0648\u0627\u0646\u064d \u0625\u0644\u0649 1 \u062b\u0627\u0646\u064a\u0629) \u0642\u0628\u0644 \u0641\u062a\u062d \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062e\u0644\u0641\u064a \u0627\u0644\u0630\u0643\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."},hyundai_digital_cluster_n_performance_theme:{name:"\u062a\u062e\u0637\u064a\u0637 \u0645\u0642\u064a\u0627\u0633 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0631\u0642\u0645\u064a N Performance",desc:"\u064a\u0637\u0628\u0642 \u062a\u062e\u0637\u064a\u0637 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0624\u0634\u0631 \u0627\u0644\u062a\u062d\u0648\u0644 \u0627\u0644\u0623\u062d\u0645\u0631 N-Performance \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 \u0634\u0627\u0634\u0629 LCD \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629."},stellantis_scr_adblue_warning_threshold_adjust:{name:"\u062a\u0639\u062f\u064a\u0644 \u0639\u062a\u0628\u0629 \u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 SCR AdBlue",desc:"\u064a\u0636\u0628\u0637 \u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0644\u062a\u0630\u0643\u064a\u0631 \u0628\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u0628\u0626\u0629 AdBlue \u0645\u0646 2400 \u0643\u0645 \u0625\u0644\u0649 1000 \u0643\u0645."},stellantis_jeep_trail_rated_offroad_pages:{name:"\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0642\u064a\u0627\u0633 \u0639\u0646 \u0628\u0639\u062f \u0644\u0644\u0637\u0631\u0642 \u0627\u0644\u0648\u0639\u0631\u0629 \u0645\u0646 Jeep Uconnect Trail",desc:"\u064a\u0641\u062a\u062d \u062d\u0631\u0643\u0629 \u0645\u062c\u0645\u0648\u0639\u0629 \u0646\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629\u060c \u0648\u0627\u0644\u062a\u062f\u062d\u0631\u062c\u060c \u0648\u0645\u0641\u0627\u0635\u0644 \u0627\u0644\u0639\u062c\u0644\u0627\u062a\u060c \u0648\u0635\u0641\u062d\u0627\u062a \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0628\u0631\u064a\u062f \u0639\u0644\u0649 \u0646\u0638\u0627\u0645 Uconnect."},stellantis_peugeot_icockpit_3d_color_schemes:{name:"\u0644\u0648\u062d\u0629 \u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0644\u0640 Peugeot 3D i-Cockpit",desc:"\u064a\u0641\u062a\u062d \u0645\u0648\u0636\u0648\u0639\u0627\u062a \u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u0646\u062d\u0627\u0633\u064a\u0629 \u0648\u0627\u0644\u0643\u0648\u0627\u0631\u062a\u0632 \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u062b\u0644\u0627\u062b\u064a\u0629 \u0627\u0644\u0623\u0628\u0639\u0627\u062f."},gm_super_cruise_follow_distance_adjust:{name:"Super Cruise \u0645\u0639 \u0625\u0632\u0627\u062d\u0629 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0628\u062f\u0648\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u064a\u062f\u064a\u0646",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0645\u0633\u0627\u0641\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0641\u062c\u0648\u0627\u062a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0630\u0627\u062a\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0637\u0631\u064a\u0642 \u0627\u0644\u0633\u0631\u064a\u0639 Super Cruise."},gm_instrument_hud_calibration_reset:{name:"\u0645\u0648\u0636\u0639 \u0634\u0627\u0634\u0629 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0639\u0644\u0648\u064a\u0629 (HUD) \u0648\u0645\u0639\u0627\u064a\u0631\u0629 \u0646\u0642\u0637\u0629 \u0627\u0644\u0635\u0641\u0631 \u0644\u0644\u0625\u0645\u0627\u0644\u0629",desc:"\u064a\u0639\u064a\u062f \u0636\u0628\u0637 \u0632\u0627\u0648\u064a\u0629 \u0635\u0648\u0631\u0629 \u062c\u0647\u0627\u0632 \u0627\u0644\u0639\u0631\u0636 HUD \u0627\u0644\u0648\u0627\u0642\u064a \u0645\u0646 \u0627\u0644\u0631\u064a\u0627\u062d \u0648\u0645\u062d\u0627\u0630\u0627\u0629 \u0627\u0644\u0623\u0641\u0642 \u0639\u0646\u062f \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0635\u0641\u0631."},gm_afm_v8_cylinder_lock_no_v4_drop:{name:"\u062a\u062c\u0627\u0648\u0632 \u0625\u0644\u063a\u0627\u0621 \u062a\u0646\u0634\u064a\u0637 \u0623\u0633\u0637\u0648\u0627\u0646\u0629 AFM / DFM (\u0648\u0636\u0639 V8 \u062f\u0627\u0626\u0645\u064b\u0627)",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u0639\u0637\u064a\u0644 \u0627\u0646\u062e\u0641\u0627\u0636 \u0623\u0633\u0637\u0648\u0627\u0646\u0629 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0646\u0634\u0637 \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 \u0641\u064a \u0648\u0636\u0639 8 \u0623\u0633\u0637\u0648\u0627\u0646\u0627\u062a."},dodge_ram_truck_fog_lights_with_high_beam:{name:"\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0636\u0628\u0627\u0628 \u0644\u0634\u0627\u062d\u0646\u0629 RAM \u0630\u0627\u062a \u0627\u0644\u0634\u0639\u0627\u0639 \u0627\u0644\u0639\u0627\u0644\u064a (\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0636\u0628\u0627\u0628 \u0627\u0644\u0639\u0627\u0644\u064a \u0648\u0627\u0644\u0645\u0646\u062e\u0641\u0636)",desc:"\u064a\u0645\u0646\u0639 \u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0636\u0628\u0627\u0628 \u0645\u0646 \u0627\u0644\u0627\u0646\u0637\u0641\u0627\u0621 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0639\u0627\u0644\u064a\u0629."},toyota_keyless_window_down:{name:"\u0646\u0627\u0641\u0630\u0629 \u0645\u0641\u062a\u0627\u062d \u062a\u0648\u064a\u0648\u062a\u0627 \u0645\u0641\u062a\u0648\u062d\u0629 (\u0627\u0636\u063a\u0637 \u0645\u0639 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0639\u0644\u0649 \u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644)",desc:"\u064a\u062a\u0645 \u0637\u064a \u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0644\u0644\u0623\u0633\u0641\u0644 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 UNLOCK \u0627\u0644\u0645\u0648\u062c\u0648\u062f \u0639\u0644\u0649 \u062c\u0647\u0627\u0632 \u0627\u0644\u062a\u062d\u0643\u0645 \u0639\u0646 \u0628\u0639\u062f."},toyota_seatbelt_chime_disable:{name:"\u0643\u062a\u0645 \u0635\u0648\u062a \u0625\u0646\u0630\u0627\u0631 \u062d\u0632\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0646 \u0644\u0631\u0643\u0627\u0628 \u062a\u0648\u064a\u0648\u062a\u0627 (\u0627\u0644\u0631\u0643\u0646/\u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u0648\u0639\u0631\u0629)",desc:"\u062a\u0639\u0637\u064a\u0644 \u0635\u0648\u062a \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0635\u0648\u062a\u064a \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0644\u062d\u0632\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0646 \u0641\u064a \u0645\u0642\u0639\u062f \u0627\u0644\u0631\u0627\u0643\u0628."},honda_walkaway_auto_lock:{name:"\u0647\u0648\u0646\u062f\u0627 \u0627\u0644\u0645\u0634\u064a \u0628\u0639\u064a\u062f\u0627 \u0642\u0641\u0644 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a",desc:"\u0642\u0641\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f\u0645\u0627 \u064a\u062a\u0631\u0643 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a \u0646\u0635\u0641 \u0642\u0637\u0631 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 2.5 \u0645\u062a\u0631."},volvo_speed_limiter_unlock:{name:"\u0645\u062d\u062f\u062f \u0633\u0631\u0639\u0629 \u0627\u0644\u0645\u0635\u0646\u0639 \u0627\u0644\u0645\u0645\u062a\u062f \u0628\u0633\u0631\u0639\u0629 180 \u0643\u0645/\u0633\u0627\u0639\u0629 \u0645\u0646 \u0641\u0648\u0644\u0641\u0648",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0645\u0635\u0646\u0639 \u0627\u0644\u0628\u0627\u0644\u063a\u0629 180 \u0643\u0645/\u0633\u0627\u0639\u0629 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u062f\u0627\u0621 \u0627\u0644\u0645\u0633\u0627\u0631/\u0627\u0644\u0637\u0631\u064a\u0642 \u0627\u0644\u0633\u0631\u064a\u0639."},byd_v2l_3kw_power_unlock:{name:"\u0648\u0636\u0639 \u0625\u062e\u0631\u0627\u062c \u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062a\u0631\u062f\u062f \u0645\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0625\u0644\u0649 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 (V2L) \u0645\u0646 BYD \u0628\u0642\u062f\u0631\u0629 3.6 \u0643\u064a\u0644\u0648 \u0648\u0627\u062a",desc:"\u064a\u062a\u064a\u062d \u0645\u0646\u0641\u0630 \u062a\u0641\u0631\u064a\u063a \u062a\u064a\u0627\u0631 \u0645\u062a\u0631\u062f\u062f \u062e\u0627\u0631\u062c\u064a \u0628\u0642\u062f\u0631\u0629 220 \u0641\u0648\u0644\u062a/3.6 \u0643\u064a\u0644\u0648 \u0648\u0627\u062a V2L \u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u062a\u062e\u064a\u064a\u0645."},xiaomi_su7_drift_mode_unlock:{name:"\u0648\u0636\u0639 \u0627\u0644\u0627\u0646\u062c\u0631\u0627\u0641 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0631 Xiaomi SU7 \u0648\u0627\u0646\u062d\u064a\u0627\u0632 \u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u062e\u0644\u0641\u064a",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0646\u0634\u064a\u0637 \u0627\u0646\u062d\u064a\u0627\u0632 \u0639\u0632\u0645 \u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u062e\u0644\u0641\u064a \u0628\u0646\u0633\u0628\u0629 100% \u0648\u0648\u0636\u0639 ESC Track Drift."},vag_oil_service_reset:{name:"Oil Change Service Reset (Flexible Interval)",desc:"Resets instrument cluster oil change interval counter to factory 15,000 km / 365 days."},vag_epb_service_mode:{name:"\u0648\u0636\u0639 \u062e\u062f\u0645\u0629 \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 (EPB).",desc:"\u064a\u0633\u062d\u0628 \u0645\u0643\u0627\u0628\u0633 \u0627\u0644\u0641\u0631\u062c\u0627\u0631 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 EPB \u0644\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0648\u0633\u0627\u062f\u0629 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0648\u0627\u0644\u062f\u0648\u0627\u0631."},bmw_bms_battery_registration:{name:"\u062a\u0633\u062c\u064a\u0644 \u0628\u0637\u0627\u0631\u064a\u0629 \u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0630\u0643\u064a (IBS).",desc:"\u064a\u0633\u062c\u0644 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0628\u0637\u0627\u0631\u064a\u0629 AGM/\u0627\u0644\u0631\u0635\u0627\u0635 \u0627\u0644\u062d\u0645\u0636\u064a\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0628\u0642\u062f\u0631\u0629 12 \u0641\u0648\u0644\u062a \u0641\u064a \u0625\u062f\u0627\u0631\u0629 \u0645\u062d\u0631\u0643 DME/DDE."},bmw_motorrad_service_indicator_reset:{name:"\u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629 \u0644\u0640 BMW Motorrad \u0648\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0645\u0624\u0634\u0631 \u0627\u0644\u0632\u064a\u062a",desc:"\u0645\u0633\u062d \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0633\u0646\u0648\u064a \u0648\u062a\u0630\u0643\u064a\u0631 \u0645\u0633\u0627\u0641\u0629 10000 \u0643\u064a\u0644\u0648\u0645\u062a\u0631 \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a TFT."},ducati_desmo_service_reset:{name:"\u062a\u0630\u0643\u064a\u0631 \u062e\u062f\u0645\u0629 \u0635\u0645\u0627\u0645 Ducati Desmo \u0648\u0627\u0636\u062d",desc:"\u0645\u0633\u062d \u0631\u0645\u0632 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0631\u0628\u0637 Desmoservice \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0628\u0639\u062f \u062e\u062f\u0645\u0629 15,000 / 30,000 \u0643\u0645."},byd_bms_isolation_self_test:{name:"\u0627\u062e\u062a\u0628\u0627\u0631 \u0630\u0627\u062a\u064a \u0644\u0639\u0632\u0644 \u0628\u0637\u0627\u0631\u064a\u0629 BYD Blade \u0630\u0627\u062a \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a",desc:"\u064a\u0646\u0641\u0630 \u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u062a\u0633\u0631\u0628 \u0648\u0627\u0644\u0645\u0642\u0627\u0648\u0645\u0629 \u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a (400 \u0641\u0648\u0644\u062a / 800 \u0641\u0648\u0644\u062a) \u0641\u064a \u0646\u0638\u0627\u0645 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0628\u0627\u0646\u064a."},vag_drl_brightness_multi:{name:"\u062a\u0639\u062f\u064a\u0644 \u0633\u0637\u0648\u0639 \u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0646\u0647\u0627\u0631 (DRL).",desc:"\u0627\u0636\u0628\u0637 \u0645\u0633\u062a\u0648\u0649 \u0643\u062b\u0627\u0641\u0629 LED DRL \u0644\u0648\u0636\u0639 \u0627\u0644\u0634\u0639\u0627\u0639 \u0627\u0644\u0645\u0646\u062e\u0641\u0636/\u0648\u0642\u0648\u0641 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a."},bmw_comfort_turn_signal_cycles:{name:"\u0639\u062f\u062f \u0646\u0628\u0636\u0627\u062a \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0627\u0644\u0645\u0631\u064a\u062d\u0629 \u0628\u0644\u0645\u0633\u0629 \u0648\u0627\u062d\u062f\u0629",desc:"\u062d\u062f\u062f \u0639\u062f\u062f \u0627\u0644\u0648\u0645\u0636\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062d\u062f\u062b \u0639\u0646\u062f \u0627\u0644\u0646\u0642\u0631 \u0627\u0644\u0633\u0631\u064a\u0639 \u0639\u0644\u0649 \u0630\u0631\u0627\u0639 \u0645\u0624\u0634\u0631 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641."},bmw_oil_service_reset:{name:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0632\u064a\u062a \u0645\u062d\u0631\u0643 CBS (BMW)",desc:"\u064a\u0639\u064a\u062f \u0636\u0628\u0637 \u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0644\u0645\u0626\u0648\u064a\u0629 \u0644\u0639\u0645\u0631 \u0632\u064a\u062a \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u062d\u0627\u0644\u0629 (CBS) \u0625\u0644\u0649 100%."},generic_oil_service_reset:{name:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0645\u0624\u0634\u0631 \u0635\u064a\u0627\u0646\u0629 \u0627\u0644\u0632\u064a\u062a \u0627\u0644\u0639\u0627\u0644\u0645\u064a",desc:"\u064a\u0645\u0633\u062d \u0636\u0648\u0621 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0627\u0644\u062e\u0627\u0635 \u0628\u0635\u064a\u0627\u0646\u0629 \u0632\u064a\u062a \u0644\u0648\u062d\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0639\u0628\u0631 \u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u0645\u062f\u0639\u0648\u0645\u0629 \u0645\u0646 \u0646\u0648\u0639 Obd2/UDS."},vag_epb_pad_change:{name:"\u0648\u0636\u0639 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0648\u0633\u0627\u062f\u0629 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 EPB (VAG)",desc:"\u064a\u0633\u062d\u0628 \u0645\u0633\u0627\u0645\u064a\u0643 \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0644\u062e\u062f\u0645\u0629 \u0648\u0633\u0627\u062f\u0629 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u062e\u0644\u0641\u064a\u0629."},bmw_epb_pad_change:{name:"\u0648\u0636\u0639 \u062e\u062f\u0645\u0629 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 EPB (BMW)",desc:"\u064a\u0641\u062a\u062d \u0645\u0634\u063a\u0644 \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u0625\u0644\u0649 \u0645\u0648\u0636\u0639 \u0627\u0644\u062e\u062f\u0645\u0629 \u0644\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0627\u0644\u0648\u0633\u0627\u062f\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629."},mb_epb_pad_change:{name:"\u0648\u0636\u0639 \u062a\u0631\u0643\u064a\u0628 \u0648\u0633\u0627\u062f\u0629 EPB (\u0645\u0631\u0633\u064a\u062f\u0633 \u0628\u0646\u0632)",desc:"\u064a\u062d\u0631\u0631 \u0639\u0645\u0648\u062f \u062f\u0648\u0631\u0627\u0646 \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u0625\u0644\u0649 \u0645\u0648\u0636\u0639 \u0627\u0644\u0648\u0631\u0634\u0629 \u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0641\u0631\u0627\u0645\u0644."},vag_dpf_regen:{name:"\u0645\u0634\u063a\u0644 \u062a\u062c\u062f\u064a\u062f \u062e\u062f\u0645\u0629 DPF (VAG)",desc:"\u064a\u0628\u062f\u0623 \u062f\u0648\u0631\u0629 \u062d\u0631\u0642 \u0627\u0644\u0633\u062e\u0627\u0645 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0645\u0631\u0634\u062d \u062c\u0633\u064a\u0645\u0627\u062a \u0627\u0644\u062f\u064a\u0632\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u0629 (DPF)."},bmw_dpf_regen:{name:"\u0645\u0634\u063a\u0644 \u0627\u0644\u062a\u062c\u062f\u064a\u062f \u0627\u0644\u0642\u0633\u0631\u064a DPF (BMW)",desc:"\u064a\u0637\u0644\u0628 \u0645\u0646 DDE ECU \u0628\u062f\u0621 \u0631\u0648\u062a\u064a\u0646 \u062a\u062c\u062f\u064a\u062f \u0645\u0631\u0634\u062d \u0627\u0644\u062c\u0633\u064a\u0645\u0627\u062a \u0627\u0644\u0646\u0634\u0637."},psa_dpf_regen:{name:"\u0637\u0644\u0628 \u062a\u062c\u062f\u064a\u062f DPF (\u0628\u064a\u062c\u0648/\u0633\u064a\u062a\u0631\u0648\u064a\u0646)",desc:"\u064a\u0624\u062f\u064a \u0625\u0644\u0649 \u062a\u062c\u062f\u064a\u062f DPF \u0627\u0644\u062b\u0627\u0628\u062a \u0644\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0628\u0645\u062d\u0631\u0643 \u0627\u0644\u062f\u064a\u0632\u0644 HDi."},bmw_bms_battery_register:{name:"\u062a\u0633\u062c\u064a\u0644 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0628\u0637\u0627\u0631\u064a\u0629 BMS (BMW)",desc:"\u064a\u0633\u062c\u0644 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0630\u0643\u064a DME/DDE."},mb_bms_battery_register:{name:"\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0648\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637\u0647\u0627 (\u0645\u0631\u0633\u064a\u062f\u0633 \u0628\u0646\u0632)",desc:"\u064a\u0639\u064a\u062f \u0636\u0628\u0637 \u0639\u062f\u0627\u062f \u0639\u0645\u0631 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0641\u064a \u0648\u062d\u062f\u0629 SAM \u0628\u0639\u062f \u062a\u0631\u0643\u064a\u0628 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629."},vag_sas_calibrate:{name:"\u0645\u0639\u0627\u064a\u0631\u0629 \u0645\u0633\u062a\u0634\u0639\u0631 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 (SAS) (VAG)",desc:"\u064a\u0642\u0648\u0645 \u0628\u0645\u0639\u0627\u064a\u0631\u0629 \u0645\u0648\u0636\u0639 \u0646\u0642\u0637\u0629 \u0627\u0644\u0635\u0641\u0631 \u0644\u0645\u0633\u062a\u0634\u0639\u0631 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 G85 \u0644\u0640 ABS/ESP ECU."},toyota_sas_calibrate:{name:"\u0645\u0639\u0627\u064a\u0631\u0629 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0646\u0642\u0637\u0629 \u0627\u0644\u0635\u0641\u0631 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0642\u0648\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u0645\u0639\u0627\u064a\u0631\u0629 \u0646\u0642\u0637\u0629 \u0627\u0644\u0635\u0641\u0631 \u0644\u0645\u0633\u062a\u0634\u0639\u0631 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0641\u064a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642."},generic_tba_adapt:{name:"\u0645\u062d\u0627\u0630\u0627\u0629 \u0627\u0644\u062c\u0633\u0645 \u0627\u0644\u062e\u0627\u0646\u0642 \u0648\u0627\u0644\u062a\u0643\u064a\u0641",desc:"\u064a\u0646\u0641\u0630 \u0631\u0648\u062a\u064a\u0646 \u0627\u0644\u062a\u0639\u0644\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u062c\u0633\u0645 \u0627\u0644\u062e\u0627\u0646\u0642 \u0641\u064a \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0643."},epb_service_reset:{name:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0635\u064a\u0627\u0646\u0629 EPB \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629",desc:"\u064a\u0642\u0648\u0645 \u0628\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0639\u062f\u0627\u062f \u062a\u0622\u0643\u0644 \u0645\u0633\u0645\u0627\u0643 \u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u062a\u0648\u0642\u0641 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0645\u0639\u0627\u064a\u0631\u0629 \u0627\u0644\u0641\u062c\u0648\u0629 \u0627\u0644\u0647\u0648\u0627\u0626\u064a\u0629."},vag_dsg_reset:{name:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0644\u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 DSG (VAG)",desc:"\u064a\u0639\u064a\u062f \u0636\u0628\u0637 \u0646\u0642\u0627\u0637 \u062a\u0639\u0634\u064a\u0642 \u0627\u0644\u0642\u0627\u0628\u0636 \u0648\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0635\u0645\u0627\u0645 \u0627\u0644\u0646\u0642\u0644 \u0644\u0640 DSG/S-Tronic."},bmw_zf_reset:{name:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u062a\u0643\u064a\u0641 \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 ZF 8HP (BMW)",desc:"\u064a\u0645\u0633\u062d \u0648\u0642\u062a \u062a\u062d\u0648\u064a\u0644 \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 EGS \u0648\u0642\u064a\u0645 \u0627\u0644\u062a\u0643\u064a\u0641 \u0645\u0639 \u0627\u0644\u0636\u063a\u0637."},bmw_brake_fluid_reset:{name:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0627\u0644\u0641\u0627\u0635\u0644 \u0627\u0644\u0632\u0645\u0646\u064a \u0644\u062e\u062f\u0645\u0629 \u0633\u0627\u0626\u0644 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 (BMW)",desc:"\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0645\u0624\u0642\u062a \u062a\u063a\u064a\u064a\u0631 \u0633\u0627\u0626\u0644 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0644\u0645\u062f\u0629 \u0639\u0627\u0645\u064a\u0646 \u0644\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u062d\u0627\u0644\u0629 (CBS)."},ford_injector_code:{name:"\u062a\u0631\u0645\u064a\u0632 \u0639\u0627\u0645\u0644 \u062a\u0635\u062d\u064a\u062d \u0627\u0644\u062d\u0627\u0642\u0646 (\u0641\u0648\u0631\u062f)",desc:"\u0628\u0631\u0627\u0645\u062c \u0631\u0645\u0648\u0632 IQA \u0627\u0644\u0645\u0643\u0648\u0646\u0629 \u0645\u0646 16 \u062d\u0631\u0641\u064b\u0627 \u0644\u062d\u0627\u0642\u0646\u0627\u062a \u0627\u0644\u062f\u064a\u0632\u0644 \u0641\u064a PCM."},bmw_injector_code:{name:"\u062a\u0631\u0645\u064a\u0632 \u0645\u0639\u062f\u0644 \u062a\u062f\u0641\u0642 \u062d\u0627\u0642\u0646 \u0627\u0644\u0648\u0642\u0648\u062f (BMW)",desc:"\u064a\u0643\u062a\u0628 \u0642\u064a\u0645 \u0645\u0639\u0627\u064a\u0631\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0644\u062d\u0627\u0642\u0646\u0627\u062a \u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0645\u0633\u062a\u0628\u062f\u0644\u0629 \u0641\u064a \u0628\u0648\u0631\u0635\u0629 \u062f\u0628\u064a \u0644\u0644\u0637\u0627\u0642\u0629."},generic_headlight_aim:{name:"\u0645\u0639\u0627\u064a\u0631\u0629 \u0627\u0644\u062a\u0633\u0648\u064a\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0644\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a",desc:"\u064a\u0636\u0628\u0637 \u0645\u0648\u0636\u0639 \u0627\u0644\u0635\u0641\u0631 \u0627\u0644\u0645\u0631\u062c\u0639\u064a \u0644\u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0630\u0627\u062a \u0627\u0644\u062a\u0633\u0648\u064a\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629."},bmw_12v_battery_reg:{name:"\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 12 \u0641\u0648\u0644\u062a (BMW)",desc:"\u064a\u0633\u062c\u0644 \u0628\u062f\u0627\u064a\u0629 AGM \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629/\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u062f\u0639\u0645 \u0641\u064a \u0648\u062d\u062f\u0629 PCU."},vag_comfort_turn_signal:{name:"\u0639\u062f\u062f \u0648\u0645\u064a\u0636 \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0627\u0644\u0645\u0631\u064a\u062d (VAG)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062f\u062f \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0648\u0627\u0645\u0636 \u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0633\u0627\u0631 \u0628\u064a\u0646 3 \u06484 \u06485 \u0648\u0645\u0636\u0627\u062a."},vag_coming_home_duration:{name:"\u0645\u062f\u0629 \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0642\u0627\u062f\u0645\u0629/\u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629 \u0644\u0644\u0645\u0646\u0632\u0644 (VAG)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0645\u0624\u0642\u062a \u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0628\u0639\u062f \u0642\u0641\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 (10 \u062b\u0648\u0627\u0646\u064d - 60 \u062b\u0627\u0646\u064a\u0629)."},vag_remote_windows:{name:"\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0639\u0646 \u0628\u0639\u062f (VAG)",desc:"\u062a\u0645\u0643\u0646 \u0645\u0646 \u0641\u062a\u062d \u0648\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0636\u063a\u0637 \u0644\u0641\u062a\u0631\u0629 \u0637\u0648\u064a\u0644\u0629 \u0639\u0644\u0649 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062a\u062d\u0643\u0645 \u0639\u0646 \u0628\u0639\u062f."},vag_auto_lock_15kmh:{name:"\u0642\u0641\u0644 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0628\u0633\u0631\u0639\u0629 15 \u0643\u0645/\u0633\u0627\u0639\u0629 (VAG)",desc:"\u0642\u0641\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u0623\u0648\u062a\u0648\u0645\u0627\u062a\u064a\u0643\u064a\u0627\u064b \u0639\u0646\u062f\u0645\u0627 \u062a\u0635\u0644 \u0633\u0631\u0639\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0625\u0644\u0649 15 \u0643\u0645/\u0633\u0627\u0639\u0629."},vag_sfd_unlock_prep:{name:"\u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0644\u062d\u0627\u0644\u0629 \u062d\u0645\u0627\u064a\u0629 \u0628\u0648\u0627\u0628\u0629 SFD (VAG 2020+)",desc:"\u064a\u0642\u0648\u0645 \u0628\u0625\u0639\u062f\u0627\u062f \u062c\u0644\u0633\u0629 \u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0645\u0645\u064a\u0632 \u0644\u0628\u0648\u0627\u0628\u0629 MQB-evo SFD \u0644\u0643\u062a\u0627\u0628\u0629 \u0645\u0639\u0631\u0641\u0627\u062a DID \u0627\u0644\u0645\u062d\u0645\u064a\u0629."},bmw_asd_deactivate:{name:"\u0625\u0644\u063a\u0627\u0621 \u062a\u0646\u0634\u064a\u0637 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0634\u0637 (ASD) (BMW)",desc:"\u064a\u0643\u062a\u0645 \u0635\u0648\u062a \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0627\u0644\u0630\u064a \u064a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644\u0647 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0645\u0643\u0628\u0631\u0627\u062a \u0627\u0644\u0635\u0648\u062a \u0641\u064a \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629."},bmw_comfort_turn_signal:{name:"\u0639\u062f\u062f \u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0627\u0644\u0645\u0631\u064a\u062d\u0629 (BMW)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062f\u062f \u0646\u0628\u0636\u0627\u062a \u0627\u0644\u0645\u0624\u0634\u0631 \u0628\u0644\u0645\u0633\u0629 \u0648\u0627\u062d\u062f\u0629 (\u0645\u0646 1 \u0625\u0644\u0649 5 \u0648\u0645\u0636\u0627\u062a)."},bmw_mirror_fold_lock:{name:"\u0648\u0635\u0648\u0644 \u0645\u0631\u064a\u062d \u0644\u0644\u0645\u0631\u0622\u0629 \u0639\u0646\u062f \u0627\u0644\u0642\u0641\u0644 (BMW)",desc:"\u0637\u064a \u0627\u0644\u0645\u0631\u0627\u064a\u0627 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u0627 \u0641\u0648\u0631 \u0642\u0641\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},toyota_coming_home_duration:{name:"\u062a\u0623\u062e\u064a\u0631 \u0627\u0644\u0645\u062c\u0627\u0645\u0644\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 / \u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u0646\u0632\u0644 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0645\u0624\u0642\u062a \u062a\u0623\u062e\u064a\u0631 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0628\u0639\u062f \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0644 (30 \u062b\u0627\u0646\u064a\u0629 - 120 \u062b\u0627\u0646\u064a\u0629)."},toyota_lane_change_flash:{name:"\u0639\u062f\u062f \u0641\u0644\u0627\u0634 \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0633\u0627\u0631 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062f\u062f \u062f\u0648\u0631\u0627\u062a \u0627\u0644\u0648\u0627\u0645\u0636 \u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0633\u0627\u0631 \u0628\u0644\u0645\u0633\u0629 \u0648\u0627\u062d\u062f\u0629."},toyota_remote_window_close:{name:"\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0639\u0646 \u0628\u0639\u062f (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0633\u0645\u062d \u0628\u0625\u063a\u0644\u0627\u0642 \u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0628\u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0642\u0641\u0644 \u0639\u0646 \u0628\u0639\u062f."},toyota_autolock_behavior:{name:"\u062a\u062e\u0635\u064a\u0635 \u0642\u0641\u0644/\u0641\u062a\u062d \u0627\u0644\u0628\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0645\u0634\u063a\u0644 \u0642\u0641\u0644 \u0627\u0644\u0628\u0627\u0628 (\u0627\u0644\u062a\u0628\u062f\u064a\u0644 \u0645\u0646 \u0627\u0644\u0648\u0636\u0639 P \u0645\u0642\u0627\u0628\u0644 \u0633\u0631\u0639\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 > 20 \u0643\u0645/\u0633\u0627\u0639\u0629)."},toyota_approach_welcome_lights:{name:"\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u062a\u0631\u062d\u064a\u0628 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0646\u0647\u062c \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0634\u063a\u064a\u0644 \u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0628\u0631\u0643\u0629/\u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0639\u0646\u062f\u0645\u0627 \u064a\u0642\u062a\u0631\u0628 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a \u0645\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},hyundai_autolock_behavior:{name:"\u0633\u0644\u0648\u0643 \u0642\u0641\u0644/\u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a (\u0647\u064a\u0648\u0646\u062f\u0627\u064a/\u0643\u064a\u0627)",desc:"\u064a\u062a\u0645 \u0642\u0641\u0644 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0633\u0631\u0639\u0629 \u0623\u0648 \u0627\u0644\u0633\u0631\u0639\u0629 \u0648\u064a\u062a\u0645 \u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644 \u0639\u0646\u062f \u0627\u0644\u0648\u0636\u0639 P \u0623\u0648 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0644."},hyundai_window_remote:{name:"\u0646\u0627\u0641\u0630\u0629 \u0639\u0646 \u0628\u0639\u062f \u0641\u062a\u062d/\u0625\u063a\u0644\u0627\u0642 (\u0647\u064a\u0648\u0646\u062f\u0627\u064a/\u0643\u064a\u0627)",desc:"\u064a\u062a\u064a\u062d \u062a\u062f\u0648\u064a\u0631 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0644\u0623\u0639\u0644\u0649/\u0644\u0623\u0633\u0641\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0632\u0631\u0627\u0631 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u0630\u0643\u064a\u0629."},hyundai_sport_mode_memory:{name:"\u0648\u0636\u0639 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u062d\u062f\u062f \u0627\u0644\u0630\u0627\u0643\u0631\u0629 (\u0647\u064a\u0648\u0646\u062f\u0627\u064a/\u0643\u064a\u0627)",desc:"\u064a\u062a\u0630\u0643\u0631 \u0622\u062e\u0631 \u0648\u0636\u0639 \u0642\u064a\u0627\u062f\u0629 \u062a\u0645 \u062a\u062d\u062f\u064a\u062f\u0647 (Sport/Eco) \u0628\u0639\u062f \u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643."},tesla_charge_limit_custom:{name:"\u062a\u062e\u0635\u064a\u0635 \u062d\u062f \u0634\u062d\u0646 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629 (\u062a\u0633\u0644\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0646\u0633\u0628\u0629 \u062d\u062f \u0634\u062d\u0646 \u0628\u0637\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0627\u0644\u064a \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 (80% \u064a\u0648\u0645\u064a\u064b\u0627 / 100% \u0631\u062d\u0644\u0629)."},tesla_mirror_fold_lock:{name:"\u0645\u0631\u0622\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0637\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u0642\u0641\u0644 Walk-Away (Tesla)",desc:"\u0637\u064a \u0627\u0644\u0645\u0631\u0627\u064a\u0627 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u062a\u0634\u063a\u064a\u0644 \u0642\u0641\u0644 \u0627\u0644\u0627\u0628\u062a\u0639\u0627\u062f \u0639\u0646 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0647\u0627\u062a\u0641."},nissan_coming_home:{name:"\u062a\u0623\u062e\u064a\u0631 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a (\u0646\u064a\u0633\u0627\u0646)",desc:"\u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0644\u0645\u062f\u0629 30 \u062b\u0627\u0646\u064a\u0629 \u0628\u0639\u062f \u0627\u0644\u062e\u0631\u0648\u062c \u0645\u0646 \u0633\u064a\u0627\u0631\u0629 \u0646\u064a\u0633\u0627\u0646."},nissan_lane_change_flash:{name:"\u0639\u062f\u062f \u0627\u0644\u0641\u0644\u0627\u0634 \u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0633\u0627\u0631 \u0639\u0646\u062f \u0627\u0644\u0646\u0642\u0631 \u0644\u062a\u0645\u0631\u064a\u0631 (\u0646\u064a\u0633\u0627\u0646)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062f\u062f \u0646\u0628\u0636\u0627\u062a \u0645\u0624\u0634\u0631 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0639\u0644\u0649 \u0630\u0631\u0627\u0639 \u0627\u0644\u0636\u0648\u0621."},nissan_autolock_behavior:{name:"\u0642\u0641\u0644 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u0623\u0648\u062a\u0648\u0645\u0627\u062a\u064a\u0643\u064a \u0627\u0644\u0645\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0633\u0631\u0639\u0629 (\u0646\u064a\u0633\u0627\u0646)",desc:"\u064a\u0642\u0641\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f\u0645\u0627 \u062a\u0635\u0644 \u0633\u0631\u0639\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0625\u0644\u0649 24 \u0643\u0645/\u0633\u0627\u0639\u0629."},nissan_window_remote:{name:"\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0639\u0646 \u0628\u0639\u062f (\u0646\u064a\u0633\u0627\u0646)",desc:"\u0641\u062a\u062d/\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644 \u0644\u0641\u062a\u0631\u0629 \u0637\u0648\u064a\u0644\u0629."},nissan_seatbelt_chime_mute:{name:"\u0642\u0645\u0639 \u0627\u0644\u0631\u0646\u064a\u0646 \u0627\u0644\u0635\u0648\u062a\u064a \u0644\u0644\u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u062d\u0632\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0646 (\u0646\u064a\u0633\u0627\u0646)",desc:"\u0643\u062a\u0645 \u0635\u0648\u062a \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0627\u0644\u0645\u062a\u0643\u0631\u0631 \u0628\u0634\u0623\u0646 \u062d\u0632\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0646 \u0645\u0639 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0631\u0645\u0632 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629."},porsche_sport_chrono_launch:{name:"\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0644\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0625\u0637\u0644\u0627\u0642 Sport Chrono (\u0628\u0648\u0631\u0634\u0647)",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0625\u0637\u0644\u0627\u0642 \u0646\u0627\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 PDK \u0648\u0639\u062a\u0628\u0629 RPM \u0648\u0639\u0636\u0629 \u0627\u0644\u0642\u0627\u0628\u0636."},porsche_pasm_default:{name:"\u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0633\u0628\u0642 \u0644\u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 \u0648\u0636\u0639 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 PASM (\u0628\u0648\u0631\u0634)",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u0635\u0644\u0627\u0628\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u062a\u0643\u064a\u0641\u064a PASM \u0639\u0646\u062f \u0628\u062f\u0621 \u0627\u0644\u0625\u0634\u0639\u0627\u0644."},porsche_exhaust_flap:{name:"\u063a\u0637\u0627\u0621 \u0639\u0627\u062f\u0645 \u0631\u064a\u0627\u0636\u064a \u0645\u0641\u062a\u0648\u062d \u0628\u0627\u0633\u062a\u0645\u0631\u0627\u0631 (\u0628\u0648\u0631\u0634)",desc:"\u064a\u062c\u0628\u0631 \u0635\u0645\u0627\u0645\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u0645 \u0627\u0644\u0646\u0634\u0637\u0629 \u0639\u0644\u0649 \u0627\u0644\u0628\u0642\u0627\u0621 \u0645\u0641\u062a\u0648\u062d\u0629 \u0628\u0646\u0633\u0628\u0629 100% \u0639\u0628\u0631 \u062c\u0645\u064a\u0639 \u0646\u0637\u0627\u0642\u0627\u062a \u062f\u0648\u0631\u0629 \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629."},audi_drive_select_memory:{name:"\u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0641\u064a \u0648\u0636\u0639 \u062a\u062d\u062f\u064a\u062f \u0645\u062d\u0631\u0643 \u0623\u0648\u062f\u064a (\u0623\u0648\u062f\u064a)",desc:"\u064a\u062d\u062a\u0641\u0638 \u0628\u0622\u062e\u0631 \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0646\u0634\u0637 \u0644\u0640 Drive Select (\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a/\u0641\u0631\u062f\u064a) \u0639\u0646\u062f \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644."},audi_virtual_cockpit_themes:{name:"\u0623\u0648\u062f\u064a Virtual Cockpit S/RS Sport Graphic Layout (\u0623\u0648\u062f\u064a)",desc:"\u064a\u0641\u062a\u062d \u062e\u064a\u0627\u0631\u0627\u062a \u062a\u062e\u0637\u064a\u0637 \u0645\u0642\u064a\u0627\u0633 \u0633\u0631\u0639\u0629 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u0645\u0631\u0643\u0632\u064a S/RS \u0641\u064a Virtual Cockpit."},vag_scandinavian_drl:{name:"\u0648\u0636\u0639 DRL \u0627\u0644\u0627\u0633\u0643\u0646\u062f\u0646\u0627\u0641\u064a (VAG)",desc:"\u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0628\u0634\u0643\u0644 \u0645\u0633\u062a\u0645\u0631 \u062c\u0646\u0628\u064b\u0627 \u0625\u0644\u0649 \u062c\u0646\u0628 \u0645\u0639 \u0645\u0635\u0627\u0628\u064a\u062d DRL \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629."},vag_mirror_dip_reverse:{name:"\u062a\u0631\u0627\u062c\u0639 \u0645\u0631\u0622\u0629 \u0627\u0644\u0631\u0627\u0643\u0628 \u0625\u0644\u0649 \u0627\u0644\u062e\u0644\u0641 (VAG)",desc:"\u0642\u0645 \u0628\u062a\u062d\u0631\u064a\u0643 \u0645\u0631\u0622\u0629 \u062c\u0627\u0646\u0628 \u0627\u0644\u0631\u0627\u0643\u0628 \u0625\u0644\u0649 \u0627\u0644\u0623\u0633\u0641\u0644 \u0639\u0646\u062f \u062a\u0639\u0634\u064a\u0642 \u062a\u0631\u0633 \u0627\u0644\u0631\u062c\u0648\u0639 \u0644\u0644\u062e\u0644\u0641."},vag_dynamic_turn_signal:{name:"\u0648\u0636\u0639 \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a / \u0627\u0644\u0645\u062a\u0633\u0644\u0633\u0644 (VAG)",desc:"\u064a\u062a\u064a\u062d \u0646\u0645\u0637 \u0648\u0627\u0645\u0636 LED \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a \u0627\u0644\u0634\u0627\u0645\u0644 \u0639\u0644\u0649 \u0648\u062d\u062f\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0627\u0644\u0645\u062a\u0648\u0627\u0641\u0642\u0629."},vag_seatbelt_warning_duration:{name:"\u0636\u0628\u0637 \u0645\u062f\u0629 \u0646\u063a\u0645\u0629 \u062a\u062d\u0630\u064a\u0631 \u062d\u0632\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0646 (VAG)",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u0642\u0635\u064a\u0631 \u0645\u0624\u0642\u062a \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0645\u062a\u0643\u0631\u0631 \u0644\u062d\u0632\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0646 \u0623\u0648 \u0625\u064a\u0642\u0627\u0641\u0647."},vag_sunroof_remote:{name:"\u0627\u0644\u062a\u062d\u0643\u0645 \u0639\u0646 \u0628\u0639\u062f \u0641\u064a \u0641\u062a\u062d\u0629 \u0627\u0644\u0633\u0642\u0641 (VAG)",desc:"\u064a\u0633\u0645\u062d \u0628\u0641\u062a\u062d \u0648\u0625\u0645\u0627\u0644\u0629 \u0641\u062a\u062d\u0629 \u0627\u0644\u0633\u0642\u0641 \u0627\u0644\u0628\u0627\u0646\u0648\u0631\u0627\u0645\u064a\u0629 \u0639\u0628\u0631 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062a\u062d\u0643\u0645 \u0639\u0646 \u0628\u0639\u062f."},vag_acc_distance_preset:{name:"\u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0644\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u062a\u0643\u064a\u0641\u064a\u0629 (VAG) \u0645\u0646 ACC",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u0631\u0627\u062f\u0627\u0631 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0628\u0639\u062f \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0639\u0646\u062f \u0628\u062f\u0621 \u0627\u0644\u0625\u0634\u0639\u0627\u0644."},vag_infotainment_startup_logo:{name:"\u0627\u0644\u0634\u0639\u0627\u0631 \u0627\u0644\u062c\u0631\u0627\u0641\u064a\u0643\u064a \u0644\u062a\u0645\u0647\u064a\u062f \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u0631\u0641\u064a\u0647 (VAG)",desc:"\u062a\u062e\u0635\u064a\u0635 \u0634\u0639\u0627\u0631 \u0634\u0627\u0634\u0629 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u0644\u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u0631\u0641\u064a\u0647 (R-Line\u060c GTI\u060c RS)."},vag_ambient_color_cycle:{name:"\u0641\u062a\u062d \u0646\u0637\u0627\u0642 \u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 (VAG)",desc:"\u064a\u0648\u0633\u0639 \u062e\u064a\u0627\u0631\u0627\u062a \u0644\u0648\u062d\u0629 \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},vag_service_interval_custom:{name:"\u0627\u0644\u0641\u062d\u0635 \u0627\u0644\u0645\u062e\u0635\u0635 \u0648\u0639\u062a\u0628\u0629 \u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u062e\u062f\u0645\u0629 (VAG)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u0643\u064a\u0644\u0648\u0645\u062a\u0631\u0627\u062a \u0648\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0644\u062a\u062d\u0630\u064a\u0631 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629."},vag_door_handle_lights_reverse:{name:"\u0623\u0636\u0648\u0627\u0621 \u0645\u0642\u0628\u0636 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0645\u0636\u0627\u0621\u0629 \u0641\u064a \u0627\u0644\u062e\u0644\u0641 (VAG)",desc:"\u064a\u0636\u064a\u0621 \u0645\u0642\u0628\u0636 \u0627\u0644\u0628\u0627\u0628 \u0628\u0623\u0636\u0648\u0627\u0621 LED \u0639\u0646\u062f \u0627\u0644\u0631\u062c\u0648\u0639 \u0644\u0644\u062e\u0644\u0641 \u0645\u0646 \u0623\u062c\u0644 \u0631\u0624\u064a\u0629 \u0627\u0644\u0623\u0631\u0636."},bmw_msport_exhaust_burble:{name:"\u0635\u0648\u062a \u0639\u0627\u062f\u0645 M-Sport \u0648\u0643\u062b\u0627\u0641\u0629 \u0641\u0631\u0642\u0639\u0629 (BMW)",desc:"\u064a\u0636\u0628\u0637 \u0634\u062f\u0629 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u0632\u0639\u062c \u0641\u064a \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0631\u064a\u0627\u0636\u064a."},bmw_welcome_light_sequence:{name:"\u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 \u0644\u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u062a\u0631\u062d\u064a\u0628\u064a (BMW)",desc:"\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0645\u0635\u0628\u0627\u062d LED \u0648\u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u062a\u0631\u062d\u064a\u0628 \u0628\u0627\u0644\u062a\u0631\u062d\u064a\u0628 \u0628\u0639\u064a\u0648\u0646 \u0627\u0644\u0645\u0644\u0627\u0643."},bmw_service_history_menu:{name:"\u062a\u0645\u0643\u064a\u0646 \u0642\u0627\u0626\u0645\u0629 \u0633\u062c\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 (BMW)",desc:"\u064a\u0641\u062a\u062d \u0642\u0627\u0626\u0645\u0629 \u0633\u062c\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 iDrive \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629."},bmw_hud_speed_display:{name:"\u0634\u0627\u0634\u0629 \u0639\u0631\u0636 \u0623\u0645\u0627\u0645\u064a\u0629 \u0631\u0642\u0645\u064a\u0629 \u0644\u0639\u062f\u0627\u062f \u0627\u0644\u0633\u0631\u0639\u0629 (BMW)",desc:"\u064a\u0639\u0631\u0636 \u0642\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629."},bmw_cornering_lights_fog:{name:"\u0625\u0636\u0627\u0621\u0629 \u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0636\u0628\u0627\u0628 \u0639\u0646\u062f \u0627\u0644\u0645\u0646\u0639\u0637\u0641\u0627\u062a (BMW)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0634\u063a\u064a\u0644 \u0636\u0648\u0621 \u0627\u0644\u0636\u0628\u0627\u0628 \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0639\u0646\u062f \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0623\u0648 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0645\u0646\u062e\u0641\u0636\u0629 \u0627\u0644\u0633\u0631\u0639\u0629."},bmw_easy_entry_steering:{name:"\u0639\u0645\u0648\u062f \u062a\u0648\u062c\u064a\u0647 \u0642\u0627\u0628\u0644 \u0644\u0644\u0633\u062d\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 (BMW) \u0633\u0647\u0644 \u0627\u0644\u062f\u062e\u0648\u0644",desc:"\u064a\u062a\u0645 \u0633\u062d\u0628 \u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0644\u0623\u0639\u0644\u0649 \u0639\u0646\u062f \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0643 \u0644\u0633\u0647\u0648\u0644\u0629 \u0627\u0644\u062e\u0631\u0648\u062c."},bmw_bluetooth_audio_enable:{name:"\u0641\u062a\u062d \u062a\u062f\u0641\u0642 \u0627\u0644\u0635\u0648\u062a \u0639\u0628\u0631 \u0627\u0644\u0628\u0644\u0648\u062a\u0648\u062b \u0627\u0644\u0645\u062d\u0633\u0651\u0646 (BMW)",desc:"\u062a\u0645\u0643\u064a\u0646 \u062f\u0641\u0642 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0627\u0644\u0644\u0627\u0633\u0644\u0643\u064a\u0629 \u0628\u062a\u0642\u0646\u064a\u0629 Bluetooth A2DP \u0641\u064a iDrive HU_ENTRYNAV."},bmw_door_handle_lights_reverse:{name:"\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0628\u0631\u0643\u0629 \u0641\u064a \u0645\u0642\u0628\u0636 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0641\u064a \u0627\u0644\u062e\u0644\u0641 (BMW)",desc:"\u064a\u0636\u064a\u0621 \u0645\u0635\u0627\u0628\u064a\u062d LED \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0645\u0642\u0628\u0636 \u0627\u0644\u0628\u0627\u0628 \u0639\u0646\u062f \u062a\u0634\u063a\u064a\u0644 \u062a\u0631\u0633 \u0627\u0644\u0631\u062c\u0648\u0639 \u0644\u0644\u062e\u0644\u0641."},toyota_auto_headlight_threshold:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0644\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062a\u0628\u0629 \u0627\u0644\u063a\u0633\u0642 \u0627\u0644\u0634\u0641\u0642 \u0644\u062a\u0646\u0634\u064a\u0637 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."},toyota_turn_signal_click_volume:{name:"\u0645\u0633\u062a\u0648\u0649 \u0635\u0648\u062a \u0645\u0643\u0628\u0631 \u0627\u0644\u0635\u0648\u062a \u0644\u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u062a\u062a\u0627\u0628\u0639 \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0639\u0646\u062f \u0627\u0644\u0646\u0642\u0631 \u0641\u0648\u0642 \u0645\u0633\u062a\u0648\u0649 \u0635\u0648\u062a \u0627\u0644\u0631\u0646\u064a\u0646 (\u0645\u0646\u062e\u0641\u0636\u060c \u0645\u062a\u0648\u0633\u0637\u060c \u0645\u0631\u062a\u0641\u0639)."},toyota_smart_key_approach_lights:{name:"\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u062a\u0631\u062d\u064a\u0628 \u0628\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0634\u063a\u064a\u0644 \u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0645\u0631\u0622\u0629 \u0639\u0646\u062f\u0645\u0627 \u064a\u0642\u062a\u0631\u0628 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a \u0645\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},toyota_rear_hatch_behavior:{name:"\u0645\u0646\u0637\u0642 \u062a\u0634\u063a\u064a\u0644/\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062e\u0644\u0641\u064a \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0645\u062f\u0629 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0641\u062a\u062d\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0639\u0646 \u0628\u0639\u062f \u0648\u0644\u0648\u062d\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629."},toyota_open_windows_smart_key:{name:"\u0627\u0644\u0636\u063a\u0637 \u0644\u0641\u062a\u0631\u0629 \u0637\u0648\u064a\u0644\u0629 \u0639\u0644\u0649 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0628\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a \u0639\u0646 \u0628\u0639\u062f (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0633\u0645\u062d \u0628\u0641\u062a\u062d \u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644 \u0639\u0646 \u0628\u0639\u062f."},toyota_interior_light_dim_timer:{name:"\u062a\u0623\u062e\u064a\u0631 \u0625\u0637\u0641\u0627\u0621 \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0644\u0644\u0645\u0642\u0635\u0648\u0631\u0629 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0645\u0624\u0642\u062a \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0636\u0648\u0621 \u0627\u0644\u0642\u0628\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0628\u0639\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0628\u0627\u0628."},toyota_panic_alarm_remote:{name:"\u0648\u0638\u064a\u0641\u0629 \u0635\u0641\u0627\u0631\u0629 \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0628\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062a\u062d\u0643\u0645 \u0639\u0646 \u0628\u0639\u062f (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u062a\u0645\u0643\u064a\u0646 \u0623\u0648 \u062a\u0639\u0637\u064a\u0644 \u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0630\u0639\u0631 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0628\u0648\u0642 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062a\u062d\u0643\u0645 \u0639\u0646 \u0628\u0639\u062f."},toyota_eco_drive_indicator:{name:"\u0636\u0648\u0621 \u0645\u0624\u0634\u0631 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0638\u0647\u0631 \u0634\u0631\u064a\u0637 \u062a\u0633\u0627\u0631\u0639 \u0635\u062f\u064a\u0642 \u0644\u0644\u0628\u064a\u0626\u0629 \u0648\u0645\u0624\u0634\u0631 \u0636\u0648\u0626\u064a \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629."},hyundai_coming_home_duration:{name:"\u0645\u0624\u0642\u062a \u062a\u0623\u062e\u064a\u0631 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a (\u0647\u064a\u0648\u0646\u062f\u0627\u064a/\u0643\u064a\u0627)",desc:"\u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0630\u0627\u062a \u0627\u0644\u0634\u0639\u0627\u0639 \u0627\u0644\u0645\u0646\u062e\u0641\u0636 \u0628\u0639\u062f \u062e\u0631\u0648\u062c \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},hyundai_drl_menu_toggle:{name:"\u0627\u0644\u062a\u062d\u0643\u0645 \u0628\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u0636\u0648\u0627\u0621 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0646\u0647\u0627\u0631 (\u0647\u064a\u0648\u0646\u062f\u0627\u064a/\u0643\u064a\u0627)",desc:"\u064a\u0636\u064a\u0641 \u0625\u0639\u062f\u0627\u062f \u062a\u0634\u063a\u064a\u0644/\u0625\u064a\u0642\u0627\u0641 DRL \u0625\u0644\u0649 \u062e\u064a\u0627\u0631\u0627\u062a \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a."},hyundai_welcome_sequence:{name:"\u0636\u0648\u0621 \u0627\u0644\u062a\u0631\u062d\u064a\u0628 \u0628\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0630\u0643\u064a \u0648\u0627\u0644\u0645\u0631\u0622\u0629 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0641\u062a\u062d (\u0647\u064a\u0648\u0646\u062f\u0627\u064a/\u0643\u064a\u0627)",desc:"\u064a\u062a\u0645 \u0641\u062a\u062d \u0627\u0644\u0645\u0631\u0627\u064a\u0627 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0648\u0625\u0636\u0627\u0621\u0629 \u0645\u0642\u0627\u0628\u0636 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u0639\u0646\u062f \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0628."},hyundai_interior_light_delay:{name:"\u062a\u0623\u062e\u064a\u0631 \u0642\u0637\u0639 \u0645\u0635\u0628\u0627\u062d \u0627\u0644\u063a\u0631\u0641\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0644\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 (\u0647\u064a\u0648\u0646\u062f\u0627\u064a/\u0643\u064a\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u0645\u0624\u0642\u062a \u0642\u0628\u0644 \u0623\u0646 \u062a\u0646\u0637\u0641\u0626 \u0627\u0644\u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0644\u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629."},hyundai_heat_pump_efficiency:{name:"\u0648\u0636\u0639 \u0627\u0644\u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629 \u0644\u0645\u0636\u062e\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0645\u0646\u0627\u062e\u064a\u0629 \u0644\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 (\u0647\u064a\u0648\u0646\u062f\u0627\u064a/\u0643\u064a\u0627)",desc:"\u064a\u062d\u0633\u0646 \u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0636\u062e\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629 EV \u0641\u064a \u0637\u0642\u0633 \u0627\u0644\u0634\u062a\u0627\u0621 \u0627\u0644\u0628\u0627\u0631\u062f."},tesla_track_mode_params:{name:"\u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0648\u0636\u0639 \u0627\u0644\u0645\u0633\u0627\u0631 \u0648\u0645\u0644\u0641 \u0627\u0646\u062d\u064a\u0627\u0632 \u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 (\u062a\u064a\u0633\u0644\u0627)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0627\u0646\u062d\u064a\u0627\u0632 \u0645\u062d\u0631\u0643 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0623\u0645\u0627\u0645\u064a/\u0627\u0644\u062e\u0644\u0641\u064a \u0648\u0627\u0644\u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u0627\u0633\u062a\u0642\u0631\u0627\u0631."},tesla_regen_brake_strength:{name:"\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0642\u0648\u0629 \u0627\u0644\u0643\u0628\u062d \u0627\u0644\u0645\u062a\u062c\u062f\u062f (\u062a\u064a\u0633\u0644\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0643\u062b\u0627\u0641\u0629 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0639\u0646\u062f \u0631\u0641\u0639 \u062f\u0648\u0627\u0633\u0629 \u0627\u0644\u0648\u0642\u0648\u062f."},tesla_walkaway_door_lock:{name:"\u0642\u0641\u0644 \u0627\u0644\u0628\u0627\u0628 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0628\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0647\u0627\u062a\u0641 (\u062a\u064a\u0633\u0644\u0627)",desc:"\u064a\u0642\u0641\u0644 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u0648\u064a\u0624\u0643\u062f \u0645\u0646 \u062e\u0644\u0627\u0644 \u0632\u0642\u0632\u0642\u0629 \u0627\u0644\u0628\u0648\u0642 \u0639\u0646\u062f\u0645\u0627 \u064a\u062a\u062d\u0631\u0643 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0647\u0627\u062a\u0641 \u0628\u0639\u064a\u062f\u064b\u0627."},tesla_acceleration_boost_unlock:{name:"\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0645\u062d\u0631\u0643 \u062a\u0633\u0631\u064a\u0639 \u0645\u062c\u0645\u0648\u0639\u0629 \u0646\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 (\u062a\u064a\u0633\u0644\u0627)",desc:"\u064a\u0632\u064a\u062f \u0645\u0646 \u062d\u062f\u0629 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0639\u0627\u0643\u0633 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0644\u062a\u062d\u0642\u064a\u0642 \u0633\u0631\u0639\u0629 \u0623\u0633\u0631\u0639 \u0645\u0646 0 \u0625\u0644\u0649 100 \u0643\u0645/\u0633\u0627\u0639\u0629."},tesla_interior_ambient_color:{name:"\u0644\u0648\u0646 \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0644\u0644\u0645\u0642\u0635\u0648\u0631\u0629 Footwell (\u062a\u0633\u0644\u0627)",desc:"\u062a\u062e\u0635\u064a\u0635 \u0644\u0648\u062d\u0629 \u0623\u0644\u0648\u0627\u0646 RGB \u0644\u0644\u0636\u0648\u0621 \u0627\u0644\u0645\u062d\u064a\u0637 \u0628\u0645\u0633\u0627\u062d\u0627\u062a \u0627\u0644\u0642\u062f\u0645 LED."},audi_matrix_led_animation:{name:"Matrix LED \u0644\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629 \u0627\u0644\u062a\u0631\u062d\u064a\u0628\u064a\u0629 \u0627\u0644\u0631\u0642\u0635\u064a\u0629 (\u0623\u0648\u062f\u064a)",desc:"\u062a\u0634\u063a\u064a\u0644 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0631\u0642\u0635\u0627\u062a \u0627\u0644\u0636\u0648\u0626\u064a\u0629 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629 \u0639\u0646\u062f \u0641\u062a\u062d \u0642\u0641\u0644 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},audi_mmi_startup_screen:{name:"MMI \u0634\u0627\u0634\u0629 \u062a\u0639\u0645\u0644 \u0628\u0627\u0644\u0644\u0645\u0633 \u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0631\u0633\u0645 \u0627\u0644\u062a\u0645\u0647\u064a\u062f (\u0623\u0648\u062f\u064a)",desc:"\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 \u0644\u062a\u0645\u0647\u064a\u062f \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629 \u0644\u0640 MMI (S / RS / e-tron)."},audi_drive_select_efficiency:{name:"\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0641\u064a Audi Drive Select (Audi)",desc:"\u0644\u062a\u0645\u0643\u064a\u0646 \u0648\u0636\u0639 \u0643\u0641\u0627\u0621\u0629 \u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0648\u0642\u0648\u062f \u0641\u064a \u062e\u064a\u0627\u0631\u0627\u062a Drive Select."},audi_laptimer_boost_display:{name:"\u0645\u0624\u0642\u062a \u0627\u0644\u062f\u0648\u0631\u0629 \u0648\u0645\u0642\u064a\u0627\u0633 \u0636\u063a\u0637 \u0634\u0631\u064a\u0637 \u0627\u0644\u062a\u0631\u0628\u0648 (\u0623\u0648\u062f\u064a)",desc:"\u064a\u0639\u0631\u0636 \u0645\u0624\u0642\u062a \u062f\u0648\u0631\u0629 \u0627\u0644\u0645\u0633\u0627\u0631 \u0648\u0645\u0642\u064a\u0627\u0633 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u062a\u0648\u0631\u0628\u0648 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a \u0639\u0644\u0649 Virtual Cockpit."},audi_needle_sweep_gauge:{name:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0633\u062d \u0625\u0628\u0631\u0629 \u0627\u0644\u0645\u0642\u064a\u0627\u0633 \u0627\u0644\u0631\u064a\u0627\u0636\u064a (\u0623\u0648\u062f\u064a)",desc:"\u064a\u0642\u0648\u0645 \u0628\u0625\u062c\u0631\u0627\u0621 \u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0645\u0633\u062d \u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u0645\u0642\u064a\u0627\u0633 \u0633\u0631\u0639\u0629 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 \u0648\u0625\u0628\u0631\u0629 \u0639\u062f\u0627\u062f \u0627\u0644\u0633\u0631\u0639\u0629 \u0639\u0646\u062f \u0627\u0644\u0628\u062f\u0627\u064a\u0629."},skoda_coming_home_lights:{name:"\u0645\u0624\u0642\u062a \u0625\u0636\u0627\u0621\u0629 \u0645\u063a\u0627\u062f\u0631\u0629 \u0627\u0644\u0645\u0646\u0632\u0644 / \u0627\u0644\u0639\u0648\u062f\u0629 \u0644\u0644\u0645\u0646\u0632\u0644 (\u0633\u0643\u0648\u062f\u0627)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0645\u0624\u0642\u062a \u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0628\u0639\u062f \u062e\u0631\u0648\u062c \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},skoda_comfort_turn_signal:{name:"\u062a\u0639\u062f\u064a\u0644 \u0639\u062f\u062f \u0646\u0628\u0636 \u0645\u0624\u0634\u0631 \u0627\u0644\u0631\u0627\u062d\u0629 (\u0633\u0643\u0648\u062f\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062f\u062f \u0648\u0645\u0636\u0627\u062a \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0646\u0639\u0637\u0627\u0641 \u0628\u0644\u0645\u0633\u0629 \u0648\u0627\u062d\u062f\u0629 \u0628\u064a\u0646 3 \u06485 \u0648\u0645\u0636\u0627\u062a."},cupra_sport_display_menu:{name:"\u0623\u062f\u0627\u0629 \u0623\u062f\u0627\u0621 \u0643\u0648\u0628\u0631\u0627 \u0648\u0642\u0627\u0626\u0645\u0629 \u0645\u0642\u064a\u0627\u0633 \u0627\u0644\u062a\u0633\u0627\u0631\u0639 (\u0643\u0648\u0628\u0631\u0627)",desc:"\u064a\u0641\u062a\u062d \u0645\u0642\u064a\u0627\u0633 \u0642\u0648\u0629 \u0627\u0644\u062c\u0627\u0630\u0628\u064a\u0629\u060c \u0648\u0645\u0642\u064a\u0627\u0633 \u0627\u0644\u0637\u0627\u0642\u0629 \u0643\u064a\u0644\u0648\u0648\u0627\u0637\u060c \u0648\u0639\u0631\u0636 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0632\u064a\u062a."},cupra_virtual_cockpit_copper:{name:"\u0627\u0644\u0631\u0633\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0645\u064a\u0632\u0629 \u0644\u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0630\u0627\u062a \u0627\u0644\u0645\u0638\u0647\u0631 \u0627\u0644\u0646\u062d\u0627\u0633\u064a (Cupra)",desc:"\u064a\u062a\u0645 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0633\u0645\u0629 \u0627\u0644\u0645\u0645\u064a\u0632\u0629 \u0627\u0644\u0646\u062d\u0627\u0633\u064a\u0629 \u0627\u0644\u0645\u0639\u062f\u0646\u064a\u0629 \u0643\u0648\u0628\u0631\u0627 \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0642\u064a\u0627\u0633."},vag_brake_disc_drying:{name:"\u0648\u0638\u064a\u0641\u0629 \u0645\u0633\u062d / \u062a\u062c\u0641\u064a\u0641 \u0642\u0631\u0635 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0641\u064a \u0627\u0644\u0645\u0637\u0631 (VAG)",desc:"\u064a\u0637\u0628\u0642 \u0628\u0634\u0643\u0644 \u062f\u0648\u0631\u064a \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 \u0636\u063a\u0637 \u0627\u0644\u0648\u0633\u0627\u062f\u0629 \u0641\u064a \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u0631\u0637\u0628 \u0639\u0644\u0649 \u0627\u0644\u062f\u0648\u0627\u0631\u0627\u062a \u0627\u0644\u062c\u0627\u0641\u0629."},vag_tourist_mode_lights:{name:"\u0646\u0645\u0637 \u0634\u0639\u0627\u0639 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0644\u0644\u0648\u0636\u0639 \u0627\u0644\u0633\u064a\u0627\u062d\u064a (VAG)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0628\u062f\u064a\u0644 \u0646\u0645\u0637 \u0634\u0639\u0627\u0639 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0628\u064a\u0646 LHD \u0648RHD \u0644\u0644\u0642\u064a\u0627\u062f\u0629 \u0641\u064a \u0627\u0644\u062e\u0627\u0631\u062c."},vag_hood_warning_mute:{name:"\u0643\u062a\u0645 \u0635\u0648\u062a \u0623\u062f\u0627\u0629 \u0641\u062a\u062d \u063a\u0637\u0627\u0621 \u0627\u0644\u0645\u062d\u0631\u0643 (VAG)",desc:"\u064a\u0645\u0646\u0639 \u0635\u0648\u062a \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0644\u0644\u0623\u062f\u0627\u0629 \u0639\u0646\u062f \u0641\u062a\u062d \u063a\u0637\u0627\u0621 \u0627\u0644\u0645\u062d\u0631\u0643."},vag_emergency_brake_hazard:{name:"\u0646\u0638\u0627\u0645 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0641\u064a \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626 (VAG)",desc:"\u064a\u0648\u0645\u0636 \u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u062e\u0637\u0631 \u0628\u0633\u0631\u0639\u0629 \u0623\u062b\u0646\u0627\u0621 \u062a\u0648\u0642\u0641 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0642\u0648\u064a \u0644\u0646\u0638\u0627\u0645 ABS."},vag_sunroof_comfort_open:{name:"\u0625\u0645\u0627\u0644\u0629 \u0641\u062a\u062d\u0629 \u0627\u0644\u0633\u0642\u0641 / \u0641\u062a\u062d \u0645\u0641\u062a\u0627\u062d FOB \u0627\u0644\u0645\u0646\u0637\u0642\u064a \u0644\u0644\u062a\u062d\u0643\u0645 \u0639\u0646 \u0628\u0639\u062f (VAG)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0639\u0646 \u0628\u0639\u062f \u0625\u0645\u0627 \u0644\u0625\u0645\u0627\u0644\u0629 \u0641\u062a\u062d\u0629 \u0627\u0644\u0633\u0642\u0641 \u0623\u0648 \u0641\u062a\u062d\u0647\u0627 \u0628\u0627\u0644\u0643\u0627\u0645\u0644."},bmw_ecopro_display_variant:{name:"\u062a\u0635\u0645\u064a\u0645 \u0645\u0642\u064a\u0627\u0633 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a ECO PRO (BMW)",desc:"\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0645\u0638\u0647\u0631 \u0627\u0644\u0631\u0633\u0648\u0645\u064a \u0644\u0645\u0642\u064a\u0627\u0633 \u0627\u0644\u0643\u0641\u0627\u0621\u0629 ECO PRO \u0628\u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0623\u0632\u0631\u0642."},bmw_volume_bar_hud:{name:"\u062a\u0631\u0627\u0643\u0628 \u0634\u0631\u064a\u0637 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0635\u0648\u062a \u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0639\u0644\u0648\u064a\u0629 (BMW)",desc:"\u064a\u064f\u0638\u0647\u0631 \u0634\u0631\u064a\u0637 \u062a\u063a\u064a\u064a\u0631 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0635\u0648\u062a \u0645\u0628\u0627\u0634\u0631\u0629\u064b \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 \u0639\u0631\u0636 HUD."},bmw_anti_dazzle_mirror:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u062a\u0639\u062a\u064a\u0645 \u0627\u0644\u0645\u0631\u0622\u0629 \u0627\u0644\u0643\u0647\u0631\u0648\u0636\u0648\u0626\u064a\u0629 \u0627\u0644\u0645\u0636\u0627\u062f\u0629 \u0644\u0644\u0627\u0646\u0628\u0647\u0627\u0631 (BMW)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062a\u0628\u0629 \u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u0635\u0648\u0631\u0629 \u0644\u062a\u0639\u062a\u064a\u0645 \u0645\u0631\u0622\u0629 \u0627\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."},bmw_camera_pdc_warning_mute:{name:"PDC \u0648\u0636\u0628\u0637 \u0633\u0631\u0639\u0629 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0645\u062d\u064a\u0637\u064a (BMW)",desc:"\u064a\u0636\u0628\u0637 \u062d\u062f \u0633\u0631\u0639\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0630\u064a \u064a\u062a\u0645 \u0639\u0646\u062f\u0647 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0631\u0643\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629."},toyota_pcs_distance_preset:{name:"\u0646\u0638\u0627\u0645 \u0645\u0627 \u0642\u0628\u0644 \u0627\u0644\u0627\u0635\u0637\u062f\u0627\u0645 (PCS) \u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0636\u0628\u0637 \u062d\u0633\u0627\u0633\u064a\u0629 \u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u0627\u0644\u0627\u0635\u0637\u062f\u0627\u0645 \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0644\u0644\u0631\u0627\u062f\u0627\u0631 \u0627\u0644\u0623\u0648\u0644\u064a."},toyota_bsm_timing:{name:"\u0627\u0644\u062a\u0648\u0642\u064a\u062a \u0627\u0644\u062a\u062d\u0630\u064a\u0631\u064a \u0644\u0646\u0638\u0627\u0645 \u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0628\u0642\u0639\u0629 \u0627\u0644\u0639\u0645\u064a\u0627\u0621 (BSM) (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0636\u0628\u0637 \u062a\u0648\u0642\u064a\u062a \u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u062a\u062d\u0630\u064a\u0631\u064a \u0644\u0644\u0645\u0631\u0622\u0629 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0629 \u0627\u0644\u0639\u0645\u064a\u0627\u0621."},toyota_ac_noise_reduction:{name:"\u0648\u0636\u0639 \u062a\u0642\u0644\u064a\u0644 \u0636\u0648\u0636\u0627\u0621 \u0645\u0646\u0641\u0627\u062e \u0636\u0627\u063a\u0637 \u0645\u0643\u064a\u0641 \u0627\u0644\u0647\u0648\u0627\u0621 (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u062d\u062f \u0645\u0646 \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0642\u0635\u0648\u0649 \u0644\u0645\u0631\u0648\u062d\u0629 \u062a\u0643\u064a\u064a\u0641 \u0627\u0644\u0647\u0648\u0627\u0621 \u0644\u0636\u0645\u0627\u0646 \u0647\u062f\u0648\u0621 \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629."},toyota_sflow_control:{name:"\u0648\u0636\u0639 S-Flow \u0644\u0644\u0645\u0646\u0627\u062e \u0627\u0644\u0630\u0643\u064a \u0644\u0644\u0631\u0627\u0643\u0628 \u0627\u0644\u0648\u0627\u062d\u062f (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0648\u062c\u0647 \u062a\u062f\u0641\u0642 \u0647\u0648\u0627\u0621 \u0645\u0643\u064a\u0641 \u0627\u0644\u0647\u0648\u0627\u0621 \u062d\u0635\u0631\u064a\u064b\u0627 \u0625\u0644\u0649 \u0627\u0644\u0645\u0642\u0627\u0639\u062f \u0627\u0644\u0645\u0634\u063a\u0648\u0644\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0645\u0633\u062a\u0634\u0639\u0631\u0627\u062a \u0627\u0644\u0648\u0632\u0646."},toyota_relock_timeout:{name:"\u0645\u0624\u0642\u062a \u062a\u0623\u062e\u064a\u0631 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0642\u0641\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0628\u0639\u062f \u0641\u062a\u062d \u0627\u0644\u0642\u0641\u0644 \u0639\u0646 \u0628\u0639\u062f (\u062a\u0648\u064a\u0648\u062a\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u062b\u0648\u0627\u0646\u064a \u0642\u0628\u0644 \u0625\u0639\u0627\u062f\u0629 \u0642\u0641\u0644 \u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u0641\u062a\u062d \u0623\u064a \u0628\u0627\u0628 (30 \u062b\u0627\u0646\u064a\u0629 - 120 \u062b\u0627\u0646\u064a\u0629)."},lexus_mark_levinson_audio_profile:{name:"\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0635\u0648\u062a\u064a \u0645\u0627\u0631\u0643 \u0644\u064a\u0641\u064a\u0646\u0633\u0648\u0646 \u0644\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062d\u064a\u0637\u064a DSP (\u0644\u0643\u0632\u0633)",desc:"\u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a\u064a \u0627\u0644\u0645\u0643\u0627\u0646\u064a \u062b\u0644\u0627\u062b\u064a \u0627\u0644\u0623\u0628\u0639\u0627\u062f \u0644\u0645\u0643\u0628\u0631\u0627\u062a \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u0645\u064a\u0632\u0629 Mark Levinson."},lexus_ev_mode_beeper_mute:{name:"\u0643\u062a\u0645 \u0635\u0648\u062a \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0635\u0648\u062a\u064a \u0644\u0644\u0645\u0631\u0643\u0628\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0644\u0644\u0645\u0634\u0627\u0629 \u0639\u0644\u0649 \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0645\u0646\u062e\u0641\u0636\u0629 (\u0644\u0643\u0632\u0633)",desc:"\u064a\u0645\u0646\u0639 \u0627\u0644\u0631\u0646\u064a\u0646 \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0630\u0648 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0627\u0644\u0645\u0646\u062e\u0641\u0636 \u0627\u0644\u0633\u0631\u0639\u0629."},lexus_easy_access_seat:{name:"\u0633\u0647\u0648\u0644\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0648\u0627\u0644\u0645\u0642\u0639\u062f \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0627\u0644\u0642\u0627\u0628\u0644 \u0644\u0644\u0627\u0646\u0632\u0644\u0627\u0642 \u0644\u0644\u062e\u0644\u0641 (\u0644\u0643\u0632\u0633)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u062d\u0631\u064a\u0643 \u0645\u0642\u0639\u062f \u0627\u0644\u0633\u0627\u0626\u0642 \u0644\u0644\u062e\u0644\u0641 \u0648\u0625\u0645\u0627\u0644\u0629 \u0639\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0628\u0639\u064a\u062f\u064b\u0627 \u0644\u0633\u0647\u0648\u0644\u0629 \u0627\u0644\u062f\u062e\u0648\u0644/\u0627\u0644\u062e\u0631\u0648\u062c."},nissan_epower_regen_mode:{name:"\u0648\u0636\u0639 \u0627\u0644\u0643\u0628\u062d \u0627\u0644\u0645\u062a\u062c\u062f\u062f e-POWER \u0628\u062f\u0648\u0627\u0633\u0629 \u0648\u0627\u062d\u062f\u0629 (\u0646\u064a\u0633\u0627\u0646)",desc:"\u064a\u0636\u0628\u0637 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0644\u062a\u0628\u0627\u0637\u0624 \u0627\u0644\u0643\u0628\u062d \u0627\u0644\u0645\u062a\u062c\u062f\u062f \u0644\u0644\u062f\u0648\u0627\u0633\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629."},nissan_propilot_assist_timing:{name:"ProPILOT Lane Centering Assist \u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 (\u0646\u064a\u0633\u0627\u0646)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u062f\u0642\u0629 \u062a\u062f\u062e\u0644 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 ProPILOT."},nissan_intelligent_around_view:{name:"\u0634\u0627\u0634\u0629 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0634\u0627\u0645\u0644\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0628\u0633\u0631\u0639\u0629 \u0645\u0646\u062e\u0641\u0636\u0629 (\u0646\u064a\u0633\u0627\u0646)",desc:"\u064a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644 \u0639\u0631\u0636 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0628\u0632\u0627\u0648\u064a\u0629 360 \u062f\u0631\u062c\u0629 \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u062a\u0634\u0641 \u0623\u062c\u0647\u0632\u0629 \u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0631\u0643\u0646 \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u0639\u0648\u0627\u0626\u0642."},mazda_g_vectoring_display:{name:"G-Vectoring Control Plus \u0627\u0644\u0645\u062a\u062e\u064a\u0644 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a (\u0645\u0627\u0632\u062f\u0627)",desc:"\u064a\u0639\u0631\u0636 \u0631\u0633\u0645\u064b\u0627 \u0628\u064a\u0627\u0646\u064a\u064b\u0627 \u0645\u0628\u0627\u0634\u0631\u064b\u0627 \u0644\u062a\u0648\u062c\u064a\u0647 \u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 GVC+ \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a."},mazda_ieloop_capacitor_monitor:{name:"\u062c\u0647\u0627\u0632 \u0642\u064a\u0627\u0633 \u0645\u0643\u062b\u0641\u0627\u062a \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0637\u0627\u0642\u0629 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 i-ELOOP (\u0645\u0627\u0632\u062f\u0627)",desc:"\u064a\u0638\u0647\u0631 \u062d\u0627\u0644\u0629 \u0634\u062d\u0646 \u0648\u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0645\u0643\u062b\u0641 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629."},mazda_smart_city_brake_sens:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0646\u0638\u0627\u0645 \u062f\u0639\u0645 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0627\u0644\u0630\u0643\u064a \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 (SCBS) (\u0645\u0627\u0632\u062f\u0627)",desc:"\u064a\u0636\u0628\u0637 \u0646\u0637\u0627\u0642 \u0645\u0633\u062a\u0634\u0639\u0631 \u0627\u0644\u0643\u0628\u062d \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0641\u064a \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0645\u0646\u062e\u0641\u0636 \u0627\u0644\u0633\u0631\u0639\u0629."},subaru_eyesight_distance_preset:{name:"\u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0644\u0646\u0638\u0627\u0645 \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u062a\u0643\u064a\u0641\u064a EyeSight (\u0633\u0648\u0628\u0627\u0631\u0648)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0641\u062c\u0648\u0629 \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0644\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0627\u0633\u062a\u0631\u064a\u0648 \u0639\u0646\u062f \u0628\u062f\u0621 \u0627\u0644\u062a\u0634\u063a\u064a\u0644."},subaru_xmode_auto_engage:{name:"\u0639\u062a\u0628\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0644\u0644\u062c\u0631 \u0639\u0644\u0649 \u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u0648\u0639\u0631\u0629 \u0641\u064a \u0648\u0636\u0639 X (\u0633\u0648\u0628\u0627\u0631\u0648)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062a\u0628\u0629 \u0627\u0646\u0632\u0644\u0627\u0642 \u0627\u0644\u0639\u062c\u0644\u0629 \u0644\u062a\u0646\u0634\u064a\u0637 X-Mode \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u062b\u0646\u0627\u0626\u064a \u0627\u0644\u0648\u0638\u064a\u0641\u0629."},subaru_steering_responsive_headlights:{name:"\u062a\u0628\u062f\u064a\u0644 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062c\u064a\u0628\u0629 \u0644\u0644\u062a\u0648\u062c\u064a\u0647 (SRH) (\u0633\u0648\u0628\u0627\u0631\u0648)",desc:"\u062a\u0645\u0643\u064a\u0646 \u0623\u0648 \u062a\u0639\u0637\u064a\u0644 \u062f\u0648\u0631\u0627\u0646 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a \u0627\u0644\u0645\u062a\u0643\u064a\u0641 \u0627\u0644\u0627\u062a\u062c\u0627\u0647\u064a."},genesis_sport_plus_mode:{name:"\u0633\u0628\u0648\u0631\u062a + \u0645\u062c\u0645\u0648\u0639\u0629 \u0646\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 \u0648\u0648\u0636\u0639 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a (\u062c\u064a\u0646\u064a\u0633\u064a\u0633)",desc:"\u064a\u0641\u062a\u062d \u0646\u0638\u0627\u0645 ESC OFF \u0627\u0644\u0645\u0648\u062c\u0647 \u0646\u062d\u0648 \u0627\u0644\u0645\u0633\u0627\u0631 \u0648\u0631\u0633\u0645 \u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u0645\u062b\u0628\u0637 \u0627\u0644\u0645\u0642\u0648\u0649."},genesis_ambient_active_light:{name:"\u0645\u0632\u0627\u0645\u0646\u0629 \u0648\u0636\u0639 \u0645\u062d\u0631\u0643 \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0627\u0644\u0646\u0634\u0637\u0629 (\u062c\u064a\u0646\u064a\u0633\u064a\u0633)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u063a\u064a\u064a\u0631 \u0644\u0648\u0646 \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u064b\u0627 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0648\u0636\u0639 \u0627\u0644\u0642\u064a\u0627\u062f\u0629."},volvo_city_safety_warning:{name:"\u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0641\u064a \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0633\u062a\u0642\u0644\u0629 \u0644\u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 (\u0641\u0648\u0644\u0641\u0648)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u062a\u0648\u0642\u064a\u062a \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0644\u0644\u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u0627\u0644\u0627\u0635\u0637\u062f\u0627\u0645 \u0628\u0627\u0644\u0631\u0627\u062f\u0627\u0631 \u0648\u062c\u0647\u0627\u0632 \u0627\u0644\u0644\u064a\u062f\u0627\u0631 (\u0645\u0628\u0643\u0631\u064b\u0627/\u0639\u0627\u062f\u064a\u064b\u0627)."},chery_ar_navigation_hud:{name:"\u062a\u0631\u0627\u0643\u0628 \u0625\u0633\u0642\u0627\u0637 \u0627\u0644\u0645\u0644\u0627\u062d\u0629 AR \u0639\u0644\u0649 HUD (\u0634\u064a\u0631\u064a)",desc:"\u064a\u0639\u0631\u0636 \u0623\u0633\u0647\u0645 \u062a\u0646\u0642\u0644 \u0627\u0644\u0648\u0627\u0642\u0639 \u0627\u0644\u0645\u0639\u0632\u0632 \u062b\u0644\u0627\u062b\u064a\u0629 \u0627\u0644\u0623\u0628\u0639\u0627\u062f \u0639\u0644\u0649 \u0627\u0644\u0632\u062c\u0627\u062c \u0627\u0644\u0623\u0645\u0627\u0645\u064a."},jlr_terrain_response_preset:{name:"\u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0633\u0628\u0642 \u0644\u0644\u0648\u0636\u0639 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0644\u0637\u0631\u0642 \u0627\u0644\u0648\u0639\u0631\u0629 (JLR) \u0644\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0644\u0644\u062a\u0636\u0627\u0631\u064a\u0633",desc:"\u064a\u062a\u0630\u0643\u0631 \u0622\u062e\u0631 \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0633\u0637\u062d\u064a \u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0644\u0644\u062a\u0636\u0627\u0631\u064a\u0633 (\u0627\u0644\u0639\u0634\u0628/\u0627\u0644\u062d\u0635\u0649/\u0627\u0644\u062b\u0644\u062c)."},jlr_adaptive_dynamics_firm:{name:"\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0635\u0644\u0627\u0628\u0629 \u0627\u0644\u0645\u062b\u0628\u0637 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a \u0627\u0644\u062a\u0643\u064a\u0641\u064a (JLR)",desc:"\u064a\u0636\u0628\u0637 \u0635\u0644\u0627\u0628\u0629 \u0627\u0644\u062a\u062e\u0645\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0644\u0627\u0645\u062a\u0635\u0627\u0635 \u0627\u0644\u0635\u062f\u0645\u0627\u062a."},jlr_wading_sensor_alert:{name:"\u0639\u062a\u0628\u0629 \u0627\u0644\u0631\u0646\u064a\u0646 \u0627\u0644\u062a\u062d\u0630\u064a\u0631\u064a \u0644\u0639\u0645\u0642 \u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0644\u062e\u0648\u0636 \u0641\u064a \u0627\u0644\u062e\u0648\u0636 \u0641\u064a \u0627\u0644\u062e\u0648\u0636 \u0641\u064a \u0627\u0644\u062e\u0648\u0636 \u0641\u064a \u0627\u0644\u0645\u064a\u0627\u0647 (JLR)",desc:"\u064a\u0642\u0648\u0645 \u0628\u062a\u0643\u0648\u064a\u0646 \u062d\u0633\u0627\u0633\u064a\u0629 \u0625\u0646\u0630\u0627\u0631 \u0639\u0645\u0642 \u0627\u0644\u0645\u0627\u0621 \u0628\u0627\u0644\u0645\u0648\u062c\u0627\u062a \u0641\u0648\u0642 \u0627\u0644\u0635\u0648\u062a\u064a\u0629."},alfa_dna_dynamic_memory:{name:"\u0630\u0627\u0643\u0631\u0629 \u0628\u062f\u0621 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0644\u0644\u0648\u0636\u0639 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a \u0644\u0640 Alfa DNA Selector (Alfa Romeo)",desc:"\u064a\u062d\u062a\u0641\u0638 \u0628\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u062f\u0648\u0627\u0633\u0629 \u0627\u0644\u0648\u0642\u0648\u062f \u0641\u064a \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a \u0628\u0639\u062f \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644."},alfa_q4_torque_split:{name:"Q4 \u0627\u0644\u0631\u0633\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u064a \u0644\u062a\u0642\u0633\u064a\u0645 \u0639\u0632\u0645 \u0627\u0644\u062f\u0648\u0631\u0627\u0646 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u062d\u0642\u064a\u0642\u064a \u0644\u0644\u062f\u0641\u0639 \u0627\u0644\u0631\u0628\u0627\u0639\u064a (\u0623\u0644\u0641\u0627 \u0631\u0648\u0645\u064a\u0648)",desc:"\u064a\u064f\u0638\u0647\u0631 \u0646\u0633\u0628\u0629 \u062a\u0642\u0633\u064a\u0645 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629/\u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0644\u0644\u062f\u0641\u0639 \u0627\u0644\u0631\u0628\u0627\u0639\u064a \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 \u0639\u0631\u0636 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a."},li_auto_range_extender_mode:{name:"\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0634\u062d\u0646 \u0628\u0637\u0627\u0631\u064a\u0629 \u0645\u0648\u0644\u062f REV (Li Auto)",desc:"\u064a\u0636\u0628\u0637 \u0639\u062a\u0628\u0629 \u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 \u0645\u0648\u0644\u062f \u0645\u062d\u0631\u0643 \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0642 \u0627\u0644\u062f\u0627\u062e\u0644\u064a."},li_auto_cinema_seat_position:{name:"\u0648\u0636\u0639 \u0627\u0644\u0645\u0633\u0631\u062d/\u0627\u0644\u0633\u064a\u0646\u0645\u0627 \u0648\u0636\u0639 \u0627\u0644\u0645\u0642\u0639\u062f \u0627\u0644\u0645\u0631\u064a\u062d (Li Auto)",desc:"\u064a\u0645\u0643\u0646 \u0625\u0645\u0627\u0644\u0629 \u0627\u0644\u0645\u0642\u0627\u0639\u062f \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0648\u0641\u062a\u062d \u0645\u0633\u0627\u0646\u062f \u0627\u0644\u0623\u0631\u062c\u0644 \u0639\u0646\u062f\u0645\u0627 \u064a\u0643\u0648\u0646 \u0648\u0636\u0639 \u0627\u0644\u0633\u064a\u0646\u0645\u0627 \u0646\u0634\u0637\u064b\u0627."},zeekr_drift_mode_torque:{name:"\u0623\u062f\u0627\u0621 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0645\u0632\u062f\u0648\u062c \u0648\u0636\u0639 \u0627\u0644\u0627\u0646\u062c\u0631\u0627\u0641 \u0627\u0644\u062e\u0644\u0641\u064a (Zeekr)",desc:"\u064a\u0631\u0633\u0644 \u0639\u0632\u0645 \u062f\u0648\u0631\u0627\u0646 \u0628\u0646\u0633\u0628\u0629 100% \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0627\u0644\u062e\u0644\u0641\u064a \u0644\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0627\u0646\u062c\u0631\u0627\u0641."},zeekr_ambient_beat_sync:{name:"\u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0625\u064a\u0642\u0627\u0639 \u0645\u0632\u0627\u0645\u0646\u0629 (Zeekr)",desc:"\u062a\u0646\u0628\u0636 \u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0628\u0627\u0644\u062a\u0632\u0627\u0645\u0646 \u0645\u0639 \u0625\u064a\u0642\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0627\u0644\u062a\u064a \u064a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644\u0647\u0627."},tata_drive_mode_voice:{name:"\u0625\u0639\u0644\u0627\u0646 \u0635\u0648\u062a\u064a \u0644\u062a\u0628\u062f\u064a\u0644 \u0648\u0636\u0639 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 (Tata)",desc:"\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0635\u0648\u062a\u064a \u0639\u0646\u062f \u062a\u0628\u062f\u064a\u0644 \u0623\u0648\u0636\u0627\u0639 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 (\u0645\u062f\u064a\u0646\u0629/\u0631\u064a\u0627\u0636\u064a\u0629/\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629)."},mahindra_zip_zap_zoom_custom:{name:"\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0627\u0644\u062e\u0627\u0646\u0642 \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0646\u0642\u0644 \u0627\u0644\u062d\u0631\u0643\u0629 Zip/Zap/Zoom (\u0645\u0627\u0647\u064a\u0646\u062f\u0631\u0627)",desc:"\u062a\u062e\u0635\u064a\u0635 \u0645\u0646\u062d\u0646\u0649 \u0627\u0644\u062a\u0633\u0627\u0631\u0639 \u0644\u0623\u0648\u0636\u0627\u0639 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 Zip \u0648Zap \u0648Zoom."},fun_cyberpunk_cluster_theme:{name:"\u0645\u0648\u0636\u0648\u0639 Cyberpunk 2077 Neon Graphic Cockpit",desc:"\u064a\u0637\u0628\u0642 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644\u064a \u0644\u0645\u0642\u064a\u0627\u0633 \u0644\u0648\u062d\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0628\u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0633\u0645\u0627\u0648\u064a \u0648\u0627\u0644\u0639\u0646\u0628\u0631."},fun_exhaust_flame_sound_effect:{name:"\u0646\u0638\u0627\u0645 \u0633\u062a\u064a\u0631\u064a\u0648 Pop & Bang Exhaust Sound FX",desc:"\u064a\u0644\u0639\u0628 \u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0635\u0648\u062a\u064a\u0629 \u0648\u0627\u0642\u0639\u064a\u0629 \u0644\u0639\u0627\u062f\u0645 V8 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0645\u0643\u0628\u0631\u0627\u062a \u0627\u0644\u0635\u0648\u062a \u0641\u064a \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629."},fun_matrix_light_show_welcome:{name:"\u062a\u0631\u062d\u064a\u0628 \u0627\u0644\u0631\u0642\u0635 LED \u0645\u0635\u0641\u0648\u0641\u0629 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u062e\u0635\u0635\u0629",desc:"\u064a\u0644\u0639\u0628 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0631\u0642\u0635\u0627\u062a \u0627\u0644\u0625\u064a\u0642\u0627\u0639\u064a\u0629 \u0644\u0644\u0639\u0631\u0636 \u0627\u0644\u0636\u0648\u0626\u064a \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u062d \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0648\u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a."},fun_stealth_fighter_display:{name:"\u0627\u0644\u0645\u0642\u0627\u062a\u0644\u0629 \u0627\u0644\u0634\u0628\u062d \u0627\u0644\u0644\u064a\u0644\u064a\u0629 \u0644\u0644\u0642\u064a\u0627\u062f\u0629 \u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0628\u0633\u064a\u0637",desc:"\u064a\u0637\u0641\u0626 \u062c\u0645\u064a\u0639 \u0623\u0636\u0648\u0627\u0621 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0639\u062f\u0627\u062f \u0627\u0644\u0633\u0631\u0639\u0629 \u0644\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0644\u064a\u0644\u064a\u0629 \u0627\u0644\u0645\u0638\u0644\u0645\u0629."},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{name:"Retarder & Jake Brake Downshift Aggressiveness",desc:"Adjusts retarder torque blending curve and automatic transmission downshifting response under braking."},man_ecas_dock_level_memory:{name:"ECAS Air Suspension Loading Dock Height Memory",desc:"Stores and recalls customized pneumatic air suspension height level presets for loading docks."},daf_stationary_dpf_regen_trigger:{name:"Stationary DPF Forced Soot Regeneration",desc:"Initiates stationary diesel particulate filter thermal soot burn routine in parked position."},ford_trucks_reverse_buzzer_night_mode:{name:"Reverse Acoustic Alarm Night Quiet Mode",desc:"Attenuates reverse backup horn alarm volume for quiet night distribution in residential areas."},cummins_ecm_fleet_speed_limiter:{name:"Cummins Engine Road Speed Limiter (RSL)",desc:"Programs maximum allowable road vehicle speed in Cummins ECM parameter tables."}},codeBtn:"\u062a\u0631\u0645\u064a\u0632",removeBtn:"\u0625\u0632\u0627\u0644\u0629",unsupportedTitle:"\u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\u0629",unsupportedMsg:"\u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\u0629 \u0645\u0646 \u0642\u0628\u0644 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0644\u0644\u0645\u0631\u0643\u0628\u0629.",layoutChart:"\u0645\u062e\u0637\u0637",selectBrand:"\u0627\u062e\u062a\u0631 \u0645\u0627\u0631\u0643\u0629 \u0627\u0644\u0633\u064a\u0627\u0631\u0629",selectCategory:"\u0627\u062e\u062a\u0631 \u0627\u0644\u0641\u0626\u0