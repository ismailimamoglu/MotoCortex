c0ac\ud56d: Android \uc7a5\uce58\ub294 Bluetooth Classic \ubc0f Bluetooth LE(4.0+) \uc5b4\ub311\ud130\ub97c \ubaa8\ub450 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. PRO \ubaa8\ub4dc\ub85c \uc804\ud658\ud558\uae30 \uc804\uc5d0 \uc7a5\uce58\uac00 \ud638\ud658\ub418\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.",errorTitle:"\uc81c\ud488\uc744 \ub85c\ub4dc\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4.",errorDesc:"\uc0c1\ud488\uc744 \ub85c\ub4dc\ud558\ub294 \uc911 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uace0 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694.",retryBtn:"\ub2e4\uc2dc \uc2dc\ub3c4",loadingPrices:"\uac00\uaca9\uc744 \ub85c\ub4dc\ud558\ub294 \uc911\uc785\ub2c8\ub2e4...",contextualDesc:"\uc804\uccb4 \uc9c4\ub2e8 \ubd84\uc11d, \uc911\uc694\ud55c \uc5d4\uc9c4 \uc704\ud5d8, \uc218\ub9ac \ube44\uc6a9 \ucd94\uc815 \ubc0f \uc774 \ubb38\uc81c \ucf54\ub4dc\uc5d0 \ub300\ud55c \ub2e8\uacc4\ubcc4 \uc9c0\uce68\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 Cortex OBD2 \uc9c4\ub2e8 \uc2a4\uce90\ub108 PRO\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694.",actionLocked:"PRO \uc7a0\uae08 \uae30\ub2a5",congratsMsg:"Cortex OBD2 PRO \uba64\ubc84\uc2ed\uc774 \uc131\uacf5\uc801\uc73c\ub85c \ud65c\uc131\ud654\ub418\uc5c8\uc2b5\ub2c8\ub2e4!",congratsTitle:" \ucd95\ud558\ud569\ub2c8\ub2e4!",errMsg:"\uad6c\ub9e4 \uc911 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694.",errTitle:" \uad6c\ub9e4 \uc2e4\ud328",monthlyNotice:"\uc6d4\uac04 \uc790\ub3d9 \uac31\uc2e0 \uad6c\ub3c5",noPkgMsg:"\ud328\ud0a4\uc9c0\ub97c \uc120\ud0dd\ud558\uc138\uc694.",noPkgTitle:" \ud328\ud0a4\uc9c0 \ubbf8\uc120\ud0dd",noPurchasesMsg:"\ud65c\uc131 PRO \uba64\ubc84\uc2ed\uc744 \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",noPurchasesTitle:"\u2139 \uad6c\ub9e4 \ub0b4\uc5ed \uc5c6\uc74c",proRequiredDesc:"\uc774 \uae30\ub2a5\uc740 PRO \uad6c\ub3c5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.",proR