ionDesc:"\ube14\ub8e8\ud22c\uc2a4 \uad8c\ud55c\uc774 \uac70\ubd80\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc571 \uc124\uc815\uc5d0\uc11c \ud5c8\uc6a9\ud574\uc8fc\uc138\uc694.",safeModeActive:"\uc548\uc804 \ubaa8\ub4dc \ud65c\uc131: \ubcf5\uc81c \ub610\ub294 \ub0ae\uc740 \ud488\uc9c8\uc758 \uc5b4\ub311\ud130\uac00 \uac10\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",iosBtManual:"\uc81c\uc5b4 \uc13c\ud130 \ub610\ub294 \uc124\uc815\uc5d0\uc11c Bluetooth\ub97c \ucf1c\uc2ed\uc2dc\uc624. iOS \uc7a5\uce58\uc5d0\uc11c\ub294 Bluetooth\ub97c \uc790\ub3d9\uc73c\ub85c \ucf24 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",iosBleOnly:"\ucc38\uace0: iOS \uae30\uae30\ub294 BLE(Bluetooth Low Energy) OBD2 \uc5b4\ub311\ud130\ub9cc \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \ud074\ub798\uc2dd Bluetooth \uc5b4\ub311\ud130\ub294 \uc2a4\uce94\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",androidClassicHint:"\ucc38\uace0: \ud45c\uc900(\ud074\ub798\uc2dd) Bluetooth OBD2 \uc5b4\ub311\ud130\ub294 \uc2a4\uce94\uc5d0 \ud45c\uc2dc\ub418\uae30 \uc804\uc5d0 Android Bluetooth \uc124\uc815\uc5d0\uc11c \ud398\uc5b4\ub9c1\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4.",deviceNotPairedTitle:"\uc7a5\uce58\uac00 \ud398\uc5b4\ub9c1\ub418\uc9c0 \uc54a\uc74c",deviceNotPairedDesc:"\ud074\ub798\uc2dd Bluetooth OBD2 \uc5b4\ub311\ud130\ub97c \uc5f0\uacb0\ud558\uae30 \uc804\uc5d0 \ud734\ub300\ud3f0\uc758 Bluetooth \uc124\uc815\uc5d0\uc11c \ud398\uc5b4\ub9c1\ud574\uc57c \ud569\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ub429\ub2c8\ub2e4.",unsupportedDeviceTitle:"\ud638\ud658\ub418\uc9c0 \uc54a\ub294 \ud558\ub4dc\uc6e8\uc5b4",unsupportedDeviceDesc:"\uc5f0\uacb0\ud558\ub824\ub294 \uc7a5\uce58\uac00 \ud638\ud658\ub418\ub294 OBD2 \uc5b4\ub311\ud130\uac00 \uc544\ub2c8\uac70\ub098 \ud544\uc694\ud55c \uc11c\ube44\uc2a4\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",sendButton:"\ubcf4\ub0b4\uae30",connectDevice:"OBD2 \uc7a5\uce58\uc5d0 \uc5f0\uacb0",adapterApproved:"\uc5b4\ub311\ud130\uac00 \uc2b9\uc778\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub2a5\ub825 \ubd84\uc11d... [2/5]",protocolNegotiating:"\uc2a4\uce94 \ud504\ub85c\ud1a0\ucf5c \ubc0f \uae68\uc6b0\uae30... [3/5]",ecuDetected:"ECU \uac10\uc9c0, \ud655\uc778 \uc911... [4/5]",ecuResponding:"ECU\uac00 \uc751\ub2f5\ud558\uace0 \uc5f0\uacb0\uc744 \uc644\ub8cc\ud558\ub294 \uc911... [5/5]",protocolScanningHint:"(\ud45c\uc900 SP5, SP3, SP6, SP7 \ud504\ub85c\ud1a0\ucf5c\uc744 \uc21c\ucc28\uc801\uc73c\ub85c \uc2a4\uce94...)",protocolFailed:" \ud638\ud658\ub418\ub294 \ud504\ub85c\ud1a0\ucf5c\uc744 \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4! (SP5, SP3, SP4, SP6, SP7 \uc2dc\ub3c4)",ecuNotFound:" \ucc28\ub7c9 ECU\uac00 \uc751\ub2f5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4!",hardwareCapabilityScore:"\uc5b4\ub311\ud130 \ud558\ub4dc\uc6e8\uc5b4 \uae30\ub2a5 \uc810\uc218: {{score}}/100",hardwareFatal:"\uc2ec\uac01\ud55c \uc624\ub958: \uadc0\ud558\uc758 \ud558\ub4dc\uc6e8\uc5b4\ub294 \uc774\uc804 \ucc28\ub7c9 \ud504\ub85c\ud1a0\ucf5c\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\ub294 \uac00\uc9dc \ubcf5\uc81c\ud488\uc785\ub2c8\ub2e4. \ucc28\ub7c9 ECU\uc5d0 \uc5f0\uacb0\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uace0\ud488\uc9c8 \uc5b4\ub311\ud130(v1.5 \ub610\ub294 \uc6d0\ubcf8)\ub97c \uad6c\ud558\uc2ed\uc2dc\uc624.",progressFormat:"{{progress}}%",btDisabled:"\ube14\ub8e8\ud22c\uc2a4 \ube44\ud65c\uc131\ud654",btDisabledDesc:"OBD2 \uc5b4\ub311\ud130\ub97c \uac80\uc0c9\ud558\ub824\uba74 \ube14\ub8e8\ud22c\uc2a4\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694.",btDescIos:"BLE OBD2 \uc5b4\ub311\ud130(Veepeak, vLinker)\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5f0\uacb0\ud569\ub2c8\ub2e4.",btDescAndroid:"Classic Bluetooth \ub610\ub294 BLE \uc5b4\ub311\ud130\ub85c \uc5f0\uacb0\ud569\ub2c8\ub2e4.",wifiDesc:"Wi-Fi \uc5b4\ub311\ud130\uc5d0 \uc5f0\uacb0\ud569\ub2c8\ub2e4(\uc77c\ubc18\uc801\uc73c\ub85c 192.168.0.10).",wifiGuide:"Wi-Fi \uc5b4\ub311\ud130\uc5d0 \uc5f0\uacb0\ud558\ub824\uba74 \ud734\ub300\ud3f0\uc758 Wi-Fi \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec OBD \uc5b4\ub311\ud130 \ub124\ud2b8\uc6cc\ud06c(\uc608: OBDII, V-LINK)\ub97c \uc120\ud0dd\ud558\uc138\uc694. \uadf8\ub7f0 \ub2e4\uc74c \uc5ec\uae30\ub85c \ub3cc\uc544\uc624\uc138\uc694.",openWifiSettings:"WI-FI \uc124\uc815 \uc5f4\uae30",connectWifi:"WI-FI\ub97c \ud1b5\ud574 \uc5f0\uacb0",pairRequired:"OBD2 \uae30\uae30 \ud398\uc5b4\ub9c1",pairRequiredDesc:"\ucc98\uc74c \uc5f0\uacb0\ud558\ub294 \uac83\uc774\ubbc0\ub85c Android\uc5d0\uc11c \ud398\uc5b4\ub9c1\uc744 \uc694\uccad\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud398\uc5b4\ub9c1 PIN\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4:",pairNow:"\ud398\uc5b4\ub9c1 \ubc0f \uc5f0\uacb0",pairingFailed:"\ud398\uc5b4\ub9c1\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4. Android \uc124\uc815\uc5d0\uc11c \uc218\ub3d9\uc73c\ub85c \ud398\uc5b4\ub9c1\ud558\uc138\uc694.",successVin:"\uc5f0\uacb0\uc774 \uc124\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucc28\ub7c9 \ud504\ub85c\ud544\uc774 \uc131\uacf5\uc801\uc73c\ub85c \ud655\uc778\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",cloneWarning:"\ud638\ud658\ub418\uc9c0 \uc54a\ub294 \ud074\ub860 \uc5b4\ub311\ud130\uac00 \uac10\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc548\uc804\uc744 \uc704\ud574 \uace0\uae09 \ucf54\ub529 \uae30\ub2a5\uc774 \uc7a0\uacbc\uc2b5\ub2c8\ub2e4.",viewHealth:"OBD2 \uac74\uac15 \ubc0f \uae30\ub2a5 \uba54\ub274",statusPrompt:"\uc544\ub798\uc5d0\uc11c \uc6d0\ud558\ub294 OBD2 \uc5f0\uacb0 \uc778\ud130\ud398\uc774\uc2a4\ub97c \uc120\ud0dd\ud558\uc138\uc694.",scanHintIos:"BLE OBD2 \uc5b4\ub311\ud130\uac00 \ucf1c\uc838 \uc788\uace0 iOS \uae30\uae30 \uadfc\ucc98\uc5d0 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.",scanHintAndroid:"\ube14\ub8e8\ud22c\uc2a4\uac00 \ud65c\uc131\ud654\ub418\uc5b4 \uc788\uace0 \uc5b4\ub311\ud130\uac00 \ud398\uc5b4\ub9c1 \uc900\ube44\uac00 \ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.",negotiating:"OBD2 \ud578\ub4dc\uc170\uc774\ud06c \ud611\uc0c1 \uc911",failed:"\uc5f0\uacb0 \uc2dc\ub3c4 \uc2e4\ud328",errLayer1:"\ubb38\uc81c \ud574\uacb0: \ube14\ub8e8\ud22c\uc2a4\uac00 \ube44\ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uae30\uae30 \uc124\uc815\uc5d0\uc11c \ube14\ub8e8\ud22c\uc2a4\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694.",errLayer2:"\ubb38\uc81c \ud574\uacb0: \uc5f0\uacb0 \uc2dc\uac04 \ucd08\uacfc. \uc5b4\ub311\ud130\uac00 OBD2 \ud3ec\ud2b8\uc5d0 \ub2e8\ub2e8\ud788 \uc5f0\uacb0\ub418\uc5b4 \uc788\uace0 \uc804\uc6d0 \ud45c\uc2dc\ub4f1\uc774 \ucf1c\uc838 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.",errLayer5:"\ubb38\uc81c \ud574\uacb0: OBD2 \ud504\ub85c\ud1a0\ucf5c \ud611\uc0c1 \uc2e4\ud328. \ucc28\ub7c9 \uc810\ud654\uac00 ON \uc704\uce58\uc5d0 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694(\uc5d4\uc9c4 \uc791\ub3d9 \uad8c\uc7a5).",errLayer6:"\ubb38\uc81c \ud574\uacb0: \uc5b4\ub311\ud130\uac00 \uc5f0\uacb0\ub418\uc5c8\uc9c0\ub9cc \ucc28\ub7c9 ECU\uac00 \uc751\ub2f5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc810\ud654\ub97c \ucf1c\uac70\ub098 \uc5f0\uacb0\uc744 \ub2e4\uc2dc \uc2dc\uc791\ud558\uc138\uc694.",errGeneric:"\ubb38\uc81c \ud574\uacb0: \uc5b4\ub311\ud130\uc5d0 \uc804\uc6d0\uc774 \uc788\uace0, \uc810\ud654\uac00 \ucf1c\uc838 \uc788\uc73c\uba70, \ub2e4\ub978 OBD \uc571\uc774 \uc5f4\ub824 \uc788\uc9c0 \uc54a\uc740\uc9c0 \ud655\uc778\ud558\uc138\uc694.",stepAdapter:"\uc5b4\ub311\ud130 \uc5f0\uacb0 \ubc0f \uae30\ub2a5 \uc810\uc218",stepProtocol:"OBD2 \ud504\ub85c\ud1a0\ucf5c \ud611\uc0c1",stepHandshake:"ECU \ud1b5\uc2e0 \ud655\uc778",stepStabilization:"\ub2a5\ub3d9 \uc6d0\uaca9 \uce21\uc815 \ub8e8\ud504 \uc548\uc815\ud654",cancel:"\ucde8\uc18c",terminalTitle:"Obd\ub2e8\ub9d0\uae30/\ucee4\uc2a4\ud140\ucf54\ub4dc",terminalDesc:"OBD-II \ub610\ub294 AT/ST \uba85\ub839\uc744 ECU\uc5d0 \uc9c1\uc811 \ubcf4\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608: \"010C\"(\uc5d4\uc9c4 RPM) \ub610\ub294 \"ATRV\"(\ubc30\ud130\ub9ac \uc804\uc555).",ecuResponseLabel:"ECU \uc751\ub2f5:",adapterConnected:"\uc5b4\ub311\ud130 \uc5f0\uacb0\ub428(\uc815\uc0c1)",lowQualityAdapterWarning:" \ub0ae\uc740 \ud488\uc9c8\uc758 \uc5b4\ub311\ud130(\uc810\uc218: {{score}}/100): \uadc0\ud558\uc758 \uc5b4\ub311\ud130\ub294 \ub0ae\uc740 \ub4f1\uae09\uc758 \ubcf5\uc81c\ud488\uc785\ub2c8\ub2e4. \uad6c\ud615 \ucc28\ub7c9 \ud504\ub85c\ud1a0\ucf5c(\uc608: Dacia, Renault, Fiat, Lada\uc758 K-Line)\uc5d0 \ud544\uc694\ud55c \ud0c0\uc774\ubc0d \uc815\ubc00\ub3c4\uac00 \ubd80\uc871\ud569\ub2c8\ub2e4. \uc131\uacf5\uc801\uc73c\ub85c \uc5f0\uacb0\ud558\ub824\uba74 \uace0\ud488\uc9c8 obd2 \uc5b4\ub311\ud130(v1.5 \ub610\ub294 \uc6d0\ub798 obdlink/vlinker)\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.",statusProfiling:"OBD2 \uc5b4\ub311\ud130 \uae30\ub2a5\uc744 \ubd84\uc11d\ud558\ub294 \uc911...",statusScanningCan:"\ucd5c\uc2e0 CAN-Bus \ud504\ub85c\ud1a0\ucf5c\uc744 \uc2a4\uce94\ud558\ub294 \uc911...",statusScanningKline:"K-Line \ud504\ub85c\ud1a0\ucf5c\uc744 \uae68\uc6c1\ub2c8\ub2e4. \uad6c\ud615 \ucc28\ub7c9(\ub2e4\ud0a4\uc544, \ub974\ub178, \ud53c\uc544\ud2b8)\uc740 \uc751\ub2f5\ud558\ub294\ub370 \ucd5c\ub300 15\ucd08 \uc815\ub3c4 \uac78\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",statusHandshake:"ECU \ud1b5\uc2e0 \ud655\uc778 \uc911...",statusStabilization:"\uc6d0\uaca9 \uce21\uc815 \ub370\uc774\ud130 \uc2a4\ud2b8\ub9bc \uc548\uc815\ud654 \uc911...",changeType:"\uc5f0\uacb0 \uc720\ud615 \ubcc0\uacbd",errBluetoothUnavailable:"\ube14\ub8e8\ud22c\uc2a4\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uac70\ub098 \ube44\ud65c\uc131\ud654\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",errDeviceNotFound:"OBD2 \uc7a5\uce58\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4",errTimeout:"\uc5f0\uacb0 \uc2dc\uac04\uc774 \ucd08\uacfc\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",errProtocolFailed:"Obd2 \ud504\ub85c\ud1a0\ucf5c \ud611\uc0c1 \uc2e4\ud328",errEcuHandshake:"\ucc28\ub7c9 ECU\uac00 \uc751\ub2f5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4",requiredTitle:"\uc5f0\uacb0 \ud544\uc694",requiredDesc:"\uc774 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\ub824\uba74 obd2 \uc7a5\uce58\uc5d0 \uc5f0\uacb0\ud558\uac70\ub098 