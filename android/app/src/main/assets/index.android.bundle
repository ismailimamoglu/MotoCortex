xe9ho momentu na obrazovce iDrive."},bmw_acoustic_lock_sound:{name:"Zvuk akustick\xe9ho z\xe1mku/odemknut\xed",desc:"P\u0159i zamyk\xe1n\xed nebo odemyk\xe1n\xed vozidla vyd\xe1v\xe1 zvukov\xfd sign\xe1l popla\u0161n\xe9ho syst\xe9mu."},bmw_mirror_fold_delay_zero:{name:"Okam\u017eit\xe9 skl\xe1d\xe1n\xed zrcadla (zpo\u017ed\u011bn\xed 0,0 s)",desc:"Sklop\xed bo\u010dn\xed zrc\xe1tka okam\u017eit\u011b po stisknut\xed zamykac\xedho tla\u010d\xedtka bez prodlevy."},bmw_tpms_tire_temperature:{name:"Zobrazen\xed tlaku a teploty v pneumatik\xe1ch",desc:"Zobrazuje teplotu pneumatik v re\xe1ln\xe9m \u010dase spolu s tlakem na obrazovce TPMS."},renault_trip_computer_enable:{name:"Palubn\xed palubn\xed po\u010d\xedta\u010d Povolit",desc:"Odemkne ukazatele pr\u016fm\u011brn\xe9 spot\u0159eby paliva a dojezdu na palubn\xedm po\u010d\xedta\u010di."},renault_external_temp_display:{name:"Zobrazen\xed extern\xed teploty",desc:"Umo\u017e\u0148uje ode\u010d\xedt\xe1n\xed venkovn\xed teploty v p\u0159\xedstrojov\xe9 desce."},renault_automatic_tailgate:{name:"Uvoln\u011bn\xed kufru kl\xed\u010denky",desc:"Po p\u0159idr\u017een\xed tla\u010d\xedtka kufru na p\u0159\xedv\u011bsku na kl\xed\u010de se zcela vysune z\xe1padkov\xfd mechanismus kufru."},renault_alarm_chirp:{name:"Cvrlik\xe1n\xed potvrzen\xed z\xe1mku alarmu",desc:"P\u0159i zamknut\xed dve\u0159\xed vozidla se ozve potvrzovac\xed p\xedpnut\xed klaksonu."},renault_shift_indicator:{name:"Indik\xe1tor \u0159azen\xed (GSI)",desc:"Aktivuje \u0161ipky NAHORU/DOL\u016e p\u0159i ekologick\xe9 j\xedzd\u011b na sdru\u017een\xe9m p\u0159\xedstroji."},ford_double_horn_honk_disable:{name:"Vypn\u011bte dvojit\xe9 houk\xe1n\xed p\u0159i zav\u0159en\xed dve\u0159\xed",desc:"Deaktivuje dvojit\xe9 houk\xe1n\xed p\u0159i zav\xedr\xe1n\xed dve\u0159\xed p\u0159i b\u011b\u017e\xedc\xedm motoru."},ford_auto_door_locking:{name:"Automatick\xe9 zamyk\xe1n\xed dve\u0159\xed p\u0159i rychlosti 20 km/h",desc:"Automaticky uzamkne v\u0161echny dve\u0159e, kdy\u017e rychlost vozidla p\u0159ekro\u010d\xed 20 km/h."},ford_tpms_psi_display:{name:"\u010c\xedseln\xfd ukazatel tlaku v pneumatik\xe1ch",desc:"Zobrazuje p\u0159esn\xfd \u010d\xedseln\xfd tlak PSI/BAR na pneumatiku na obrazovce p\u0159\xedstroje."},ford_sync_climate_screen:{name:"Ovl\xe1d\xe1n\xed klimatizace obrazovky SYNC",desc:"P\u0159id\xe1 na displej SYNC nab\xeddku ovl\xe1d\xe1n\xed klimatizace a vyh\u0159\xedv\xe1n\xed sedadel."},stellantis_power_windows_remote:{name:"Kl\xed\u010denka s d\xe1lkov\xfdm ovl\xe1d\xe1n\xedm stahov\xe1n\xed/stahov\xe1n\xed oken",desc:"P\u0159idr\u017een\xedm tla\u010d\xedtek zamyk\xe1n\xed/odemyk\xe1n\xed se sroluj\xed nebo stahuj\xed v\u0161echna elektricky ovl\xe1dan\xe1 okna."},stellantis_cornering_fogs:{name:"Povolit zat\xe1\u010den\xed mlhov\xfdch sv\u011btel",desc:"Rozsv\xedt\xed se sv\u011btlomety do zat\xe1\u010dky p\u0159i zat\xe1\u010dk\xe1ch p\u0159i n\xedzk\xe9 rychlosti."},vag_traffic_sign_recognition:{name:"Rozpozn\xe1v\xe1n\xed dopravn\xedch zna\u010dek (VZE)",desc:"Zobrazuje rychlostn\xed zna\u010dky detekovan\xe9 kamerou na sdru\u017een\xe9m p\u0159\xedstroji a HUD."},vag_ambient_color_palette_30:{name:"30barevn\xe1 paleta okoln\xedho osv\u011btlen\xed",desc:"Odemkne 30 RGB v\xfdb\u011br barvy osv\u011btlen\xed interi\xe9ru v nab\xeddce infotainmentu MIB."},vag_seatbelt_warning_mute:{name:"Deaktivace zvonku bezpe\u010dnostn\xedch p\xe1s\u016f",desc:"Deaktivuje akustick\xfd zvuk rozepnut\xe9ho bezpe\u010dnostn\xedho p\xe1su v p\u0159\xedstrojov\xe9 desce."},bmw_alpina_cluster_theme:{name:"Rozlo\u017een\xed digit\xe1ln\xed poml\u010dky Alpina",desc:"Pou\u017eije modr\xfd charakteristick\xfd motiv Alpina na digit\xe1ln\xed p\u0159\xedstrojov\xfd \u0161t\xedt."},bmw_video_in_motion:{name:"Video v pohybu (VIM)",desc:"Odemkne p\u0159ehr\xe1v\xe1n\xed USB videa na obrazovce iDrive b\u011bhem j\xedzdy."},bmw_sport_plus_mode_unlock:{name:"Aktivovat j\xedzdn\xed re\u017eim Sport+",desc:"Aktivuje vysoce v\xfdkonn\xfd dynamick\xfd j\xedzdn\xed re\u017eim Sport+ na voli\u010di DEC."},mercedes_amg_menu_unlock:{name:"Nab\xeddka telemetrie AMG Performance",desc:"Zobrazuje teplotu oleje AMG, teplotu p\u0159evodovky, stopky a G-metr."},mercedes_agility_mode_enable:{name:"Agility (A) Re\u017eim p\u0159enosu",desc:"Odemyk\xe1 extr\xe9mn\u011b citliv\xfd program \u0159azen\xed Agility v p\u0159evodovce 7G/9G-Tronic."},mercedes_drl_brightness_boost:{name:"Sv\u011btla pro denn\xed sv\xedcen\xed 100% intenzita",desc:"Zvy\u0161uje v\xfdkon LED sv\u011btel pro denn\xed sv\xedcen\xed na 100% pln\xfd jas."},mercedes_alarm_lock_chirp:{name:"Cvrlik\xe1n\xed akustick\xe9 houka\u010dky",desc:"P\u0159i aktivaci centr\xe1ln\xedho zamyk\xe1n\xed vyd\xe1v\xe1 kr\xe1tk\xe9 p\xedpnut\xed klaksonu."},mercedes_dpf_adblue_gauge:{name:"Ukazatel hladiny DPF saz\xed a AdBlue",desc:"Zobrazuje p\u0159esn\xe9 procento hmotnosti saz\xed DPF a zb\xfdvaj\xedc\xed rozsah AdBlue v IC."},renault_rs_monitor_enable:{name:"Telemetrie monitoru Renault Sport RS",desc:"Umo\u017e\u0148uje \u017eiv\xe9 G-force, turbo boost a telemetrii teploty oleje na R-Link."},renault_duster_mirror_fold:{name:"Duster Auto Mirror Folding on Lock",desc:"Automaticky skl\xe1p\xed bo\u010dn\xed zrc\xe1tka pomoc\xed p\u0159\xedkazu centr\xe1ln\xedho zamyk\xe1n\xed BCM."},ford_bambi_mode_fog_light:{name:"Re\u017eim Bambi (d\xe1lkov\xe1 sv\u011btla + mlhov\xe1 sv\u011btla)",desc:"Umo\u017e\u0148uje, aby mlhov\xe1 sv\u011btla z\u016fstala rozsv\xedcen\xe1, kdy\u017e jsou aktivov\xe1na d\xe1lkov\xe1 sv\u011btla."},ford_st_rs_boot_animation:{name:"Spou\u0161t\u011bc\xed obrazovka ST/RS Performance SYNC",desc:"Zm\u011bn\xed \xfavodn\xed \xfavodn\xed animaci dotykov\xe9 obrazovky SYNC na logo ST / RS."},toyota_reverse_beep_mute:{name:"Nep\u0159etr\u017eit\xe9 ztlumen\xed p\xedp\xe1n\xed v kabin\u011b zp\xe1te\u010dky",desc:"Ztlum\xed nep\u0159etr\u017eit\xfd zvuk zp\xe1te\u010dky uvnit\u0159 kabiny na jedin\xe9 p\xedpnut\xed."},toyota_remote_window_drop:{name:"D\xe1lkov\xe9 ovl\xe1d\xe1n\xed okenn\xedho p\u0159\xedv\u011bsku na kl\xed\u010de",desc:"St\xe1hne v\u0161echna elektricky ovl\xe1dan\xe1 okna p\u0159i podr\u017een\xed tla\u010d\xedtka odemyk\xe1n\xed na kl\xed\u010dence."},toyota_auto_lock_shift_p:{name:"Automatick\xe9 zamyk\xe1n\xed dve\u0159\xed p\u0159i \u0159azen\xed (P -> D)",desc:"Automaticky uzamkne v\u0161echny dve\u0159e p\u0159i vy\u0159azen\xed z parkovac\xed polohy."},peugeot_icockpit_theme_unlock:{name:"Motiv v\xfdkonu Peugeot 3D i-Cockpit",desc:"Odemyk\xe1 barevn\xe1 t\xe9mata zobrazen\xed Copper a Track Red na 3D digit\xe1ln\xedm clusteru."},jeep_offroad_pages_enable:{name:"Jeep Uconnect Off-Road Pages",desc:"Umo\u017e\u0148uje m\u011b\u0159en\xed \xfahlu sklonu/n\xe1klonu, kloubov\xe9ho spojen\xed kol a stavu z\xe1mku 4x4."},hyundai_smart_welcome_mirror:{name:"P\u0159\xedstup pomoc\xed chytr\xe9ho kl\xed\u010de Welcome Mirror Unfold",desc:"Automaticky odklop\xed bo\u010dn\xed zrc\xe1tka p\u0159i p\u0159ibl\xed\u017een\xed k vozidlu pomoc\xed smart kl\xed\u010de."},hyundai_one_touch_turn_7_flashes:{name:"Sign\xe1l zm\u011bny j\xedzdn\xedho pruhu jedn\xedm dotykem (7 bliknut\xed)",desc:"Nastav\xed dobu trv\xe1n\xed blinkru zm\u011bny j\xedzdn\xedho pruhu na 7 bliknut\xed."},hyundai_svm_camera_speed_extend:{name:"Roz\u0161\xed\u0159en\xed rychlosti 360\xb0 prostorov\xe9 kamery (20 km/h)",desc:"Udr\u017euje 360stup\u0148ovou parkovac\xed kameru aktivn\xed a\u017e do rychlosti 20 km/h vp\u0159ed."},hyundai_n_performance_exhaust_flap:{name:"V\xfdfukov\xe1 klapka N-Performance V\xfdchoz\xed OTEV\u0158EN\xc1",desc:"Nastav\xed v\xfdchoz\xed polohu aktivn\xedho v\xfdfukov\xe9ho ventilu na OPEN p\u0159i startov\xe1n\xed motoru."},vag_rain_closing_sunroof:{name:"Zav\xedr\xe1n\xed de\u0161t\u011b (Regenschlie\xdfen)",desc:"Automaticky zav\u0159e st\u0159e\u0161n\xed okno a okna, kdy\u017e je p\u0159i parkov\xe1n\xed detekov\xe1n d\xe9\u0161\u0165."},bmw_launch_control_unlock:{name:"Launch Control Unlock",desc:"Odemkne program akcelerace \u0159\xedzen\xed spu\u0161t\u011bn\xed z v\xfdroby v p\u0159evodov\xe9 ECU."},mercedes_ambient_64_multi_zone:{name:"64barevn\xfd v\xedcez\xf3nov\xfd okoln\xed profil",desc:"Odemyk\xe1 dynamickou v\xedcez\xf3novou animaci barevn\xe9ho cyklu v osv\u011btlen\xed interi\xe9ru MBUX."},ford_trailer_brake_activation:{name:"Povolit ovlada\u010d brzdy p\u0159\xedv\u011bsu (TBC).",desc:"Aktivuje nab\xeddku integrovan\xe9ho ovlada\u010de brzd p\u0159\xedv\u011bsu ve sdru\u017een\xe9m p\u0159\xedstroji."},gm_afm_dfm_cylinder_deactivation_disable:{name:"Cylindrov\xfd z\xe1mek AFM/DFM V8 (bez p\xe1du V4)",desc:"Trvale uzamkne motor v 8v\xe1lcov\xe9m re\u017eimu, aby se zabr\xe1nilo vibrac\xedm motoru V4."},gm_remote_start_time_extend:{name:"Prodlou\u017een\xed doby trv\xe1n\xed vzd\xe1len\xe9ho spu\u0161t\u011bn\xed (20 minut)",desc:"Prodlu\u017euje dobu chodu d\xe1lkov\xe9ho startov\xe1n\xed motoru z tov\xe1rn\xed kl\xed\u010denky z 10 na 20 minut."},dodge_srt_performance_pages:{name:"Str\xe1nky v\xfdkonu SRT a re\u017eimy j\xedzdy",desc:"Odemyk\xe1 \u010dasova\u010de zrychlen\xed Uconnect 0-100, m\u011b\u0159i\u010d s\xedly G a ovl\xe1d\xe1n\xed spou\u0161t\u011bn\xed."},ram_bambi_mode_fog:{name:"RAM Truck Mlhov\xe1 sv\u011btla s d\xe1lkov\xfdmi sv\u011btly",desc:"Umo\u017e\u0148uje, aby mlhov\xe1 sv\u011btla RAM z\u016fstala aktivn\xed spolu s d\xe1lkov\xfdmi sv\u011btlomety."},byd_avas_pedestrian_siren_mute:{name:"Ztlumen\xed n\xedzkorychlostn\xed sir\xe9ny AVAS EV",desc:"Ztlum\xed n\xedzkorychlostn\xed sir\xe9nu um\u011bl\xe9ho elektromotoru pod 30 km/h."},chery_isa_overspeed_chime_mute:{name:"Deaktivace varovn\xe9ho zvon\u011bn\xed ISA p\u0159i p\u0159ekro\u010den\xed rychlosti",desc:"Deaktivuje nep\u0159etr\u017eit\xe9 p\xedp\xe1n\xed upozorn\u011bn\xed na p\u0159ekro\u010den\xed rychlosti 80/120 km/h u model\u016f Tiggo/MG."},mg_ev_battery_preconditioning_toggle:{name:"Ru\u010dn\xed sp\xedna\u010d p\u0159edeh\u0159\xedv\xe1n\xed EV rychl\xe9ho nab\xedjen\xed",desc:"Umo\u017e\u0148uje manu\xe1ln\xed sp\xedna\u010d p\u0159edeh\u0159\xedv\xe1n\xed baterie p\u0159ed rychl\xfdm DC nab\xedjen\xedm."},chery_dms_fatigue_camera_mute:{name:"Sn\xed\u017een\xed citlivosti kamery pro monitorov\xe1n\xed \u0159idi\u010de (DMS).",desc:"Sni\u017euje p\u0159ecitliv\u011bl\xe1 upozorn\u011bn\xed na \xfanavu p\u0159i sledov\xe1n\xed o\u010d\xed na sloupku \u0159\xedzen\xed."},honda_walk_away_auto_lock:{name:"Automatick\xfd z\xe1mek dve\u0159\xed s mo\u017enost\xed ch\u016fze",desc:"Automaticky zamkne v\u0161echny dve\u0159e, kdy\u017e \u0159idi\u010d ustoup\xed 2 metry pomoc\xed p\u0159\xedv\u011bsku na kl\xed\u010de."},subaru_avh_auto_hold_memory:{name:"Re\u017eim pam\u011bti automatick\xe9ho p\u0159idr\u017een\xed vozidla (AVH).",desc:"Pamatuje si stav p\u0159idr\u017een\xed brzdy AVH ON/OFF b\u011bhem zapalovac\xedch cykl\u016f."},volvo_start_stop_default_off:{name:"Auto Start-Stop V\xfdchoz\xed re\u017eim VYPNUTO",desc:"Nastav\xed v\xfdchoz\xed stav syst\xe9mu vypnut\xed motoru Start-Stop na VYPNUTO p\u0159i nastartov\xe1n\xed vozidla."},volvo_polestar_digital_theme:{name:"T\xe9ma digit\xe1ln\xedho clusteru Polestar Blue",desc:"Odemyk\xe1 charakteristick\xfd modr\xfd motiv dynamick\xe9ho m\u011b\u0159idla Polestar na displeji \u0159idi\u010de Volva."},vag_virtual_cockpit_r_theme:{name:"Motivy virtu\xe1ln\xedho kokpitu R / S / Cupra",desc:"Odemyk\xe1 motivy v\xfdkonu centr\xe1ln\xedho ot\xe1\u010dkom\u011bru R-Line, S-Line a Cupra v digit\xe1ln\xedm kokpitu."},vag_sound_symposer_mute:{name:"Sound Symposer fale\u0161n\xe1 deaktivace hluku motoru",desc:"Deaktivuje gener\xe1tor fale\u0161n\xe9ho zvuku motoru z reproduktor\u016f kabiny pro \u010dist\xfd zvuk v\xfdfuku."},vag_wireless_carplay_enable:{name:"Bezdr\xe1tov\xe1 aktivace Apple CarPlay a Android Auto",desc:"Umo\u017e\u0148uje 5GHz bezdr\xe1tov\xe9 Wi-Fi Apple CarPlay a Android Auto na jednotk\xe1ch MIB2.5/MIB3."},vag_offroad_telemetry_menu:{name:"Displej telemetrie a m\u011b\u0159idel MIB Offroad",desc:"Zobrazuje \xfahel \u0159\xedzen\xed, teplotu oleje, teplotu chladic\xed kapaliny a nadmo\u0159skou v\xfd\u0161ku na obrazovce MIB."},vag_easy_entry_driver_seat:{name:"Automatick\xe9 snadn\xe9 nastupov\xe1n\xed elektricky ovl\xe1dan\xe9 op\u011bradlo sedadla",desc:"Posune elektrick\xe9 sedadlo \u0159idi\u010de dozadu o 5 cm p\u0159i otev\u0159en\xed dve\u0159\xed pro snadn\xfd vstup do vozidla."},vag_hba_memory_state:{name:"Uchov\xe1n\xed pam\u011bti High-Beam Assist (HBA).",desc:"Pamatuje si stav zapnut\xe9ho asistenta d\xe1lkov\xfdch sv\u011btel b\u011bhem cykl\u016f restartov\xe1n\xed zapalov\xe1n\xed."},vag_battery_soc_display:{name:"Zobrazen\xed stavu nabit\xed baterie (% SOC).",desc:"Ukazuje p\u0159esn\xe9 procento nabit\xed baterie (% SOC) na sdru\u017een\xe9m p\u0159\xedstroji, kdy\u017e dr\u017e\xedte vyp\xednac\xed tla\u010d\xedtko."},bmw_idrive7_m_animation:{name:"Animace spou\u0161t\u011bn\xed iDrive 7/8 M-Performance",desc:"Zm\u011bn\xed spou\u0161t\u011bc\xed grafiku obrazovky iDrive na animaci loga M-Performance nebo M-GmbH."},bmw_bowers_wilkins_audio_profiles:{name:"Bowers & Wilkins 3D Sound Engine Unlock",desc:"Odemyk\xe1 zvukov\xe9 profily Bowers & Wilkins Concert, Studio a Stage DSP na HiFi syst\xe9mech."},bmw_hitch_zoom_camera:{name:"Reverzn\xed re\u017eim p\u0159ibl\xed\u017een\xed p\u0159\xedv\u011bsu p\u0159\xedv\u011bsu kamery",desc:"Odemkne re\u017eim zoomu zarovn\xe1n\xed n\xe1v\u011bsu shora dol\u016f p\u0159i pohledu ze zp\u011btn\xe9 kamery."},bmw_secure_idle_protection:{name:"Bezpe\u010dn\xe1 ochrana proti zablokov\xe1n\xed \u0159azen\xed motoru p\u0159i volnob\u011bhu",desc:"Zamkne p\u0159evodovku v re\u017eimu Park, pokud \u0159idi\u010d opust\xed b\u011b\u017e\xedc\xed vozidlo s p\u0159\xedv\u011bskem na kl\xed\u010de."},bmw_seatbelt_handover_mute:{name:"Elektrick\xe1 deaktivace ramene bezpe\u010dnostn\xedho p\xe1su pro kup\xe9",desc:"Deaktivuje motorizovan\xe9 prodlu\u017eovac\xed rameno bezpe\u010dnostn\xedho p\xe1su na \u0159ad\xe1ch 4 a 2 kup\xe9."},bmw_auto_heat_threshold_5c:{name:"Teplota automatick\xe9ho vyh\u0159\xedv\xe1n\xed sedadla a volantu (+5 \xb0C)",desc:"Spust\xed automatick\xe9 vyh\u0159\xedv\xe1n\xed sedadla a volantu, kdy\u017e okoln\xed teplota klesne pod 5 \xb0C."},mercedes_amg_track_pace_unlock:{name:"MBUX AMG Track Pace Telemetry & Lap Timer",desc:"Odemkne m\u011b\u0159en\xed \u010dasu kola, telemetrii zrychlen\xed a grafy G-force na obrazovce MBUX."},mercedes_drive_mode_last_memory:{name:"Dynamick\xfd v\xfdb\u011br pam\u011bti posledn\xedho re\u017eimu j\xedzdy",desc:"Pamatuje si posledn\xed zvolen\xfd j\xedzdn\xed re\u017eim (individu\xe1ln\xed / sportovn\xed) po restartov\xe1n\xed vozidla."},mercedes_proximity_360_camera_auto:{name:"Automatick\xfd 360\xb0 pohled kamery p\u0159ibl\xed\u017een\xed senzoru",desc:"Automaticky p\u0159epne obrazovku na 360\xb0 kameru, kdy\u017e p\u0159edn\xed senzory detekuj\xed p\u0159ek\xe1\u017eku < 50 cm."},ford_sync_climate_screen_unlock:{name:"Str\xe1nka ovl\xe1d\xe1n\xed klimatu SYNC3 / SYNC4 s dotykovou obrazovkou",desc:"Umo\u017e\u0148uje ovl\xe1d\xe1n\xed klimatizace, vyh\u0159\xedv\xe1n\xed sedadla a str\xe1nku na dotykov\xe9 obrazovce pro sm\u011br proud\u011bn\xed vzduchu."},ford_turn_signal_5_flashes:{name:"Sign\xe1l zm\u011bny j\xedzdn\xedho pruhu jedn\xedm dotykem (5 bliknut\xed)",desc:"Prodlu\u017euje dobu trv\xe1n\xed sm\u011brov\xfdch sv\u011btel p\u0159i zm\u011bn\u011b j\xedzdn\xedho pruhu na jeden dotek ze 3 na 5 bliknut\xed."},ford_auto_engine_shutdown_disable:{name:"Potla\u010den\xed automatick\xe9ho vypnut\xed motoru po 30 minut\xe1ch ne\u010dinnosti",desc:"Zabra\u0148uje automatick\xe9mu vypnut\xed motoru po 30 minut\xe1ch ne\u010dinnosti (p\u0159i kempov\xe1n\xed/pou\u017e\xedv\xe1n\xed elektrick\xe9 z\xe1suvky)."},ev_battery_preheat_manual_switch:{name:"Ru\u010dn\xed sp\xedna\u010d p\u0159edeh\u0159\xedv\xe1n\xed baterie EV (rychl\xe1 p\u0159\xedprava na stejnosm\u011brn\xe9 nab\xedjen\xed)",desc:"Umo\u017e\u0148uje manu\xe1ln\xed p\u0159edeh\u0159\xe1t\xed baterie na 25 \xb0C p\u0159ed stejnosm\u011brn\xfdm rychl\xfdm nab\xedjen\xedm bez naviga\u010dn\xed trasy."},ev_v2l_power_output_expand:{name:"V2L (Vehicle-to-Load) 220V roz\u0161\xed\u0159en\xed v\xfdstupn\xedho v\xfdkonu (3,6 kW)",desc:"Roz\u0161i\u0159uje limit extern\xed dom\xe1c\xed elektrick\xe9 z\xe1suvky V2L 220 V AC z 2,2 kW na 3,6 kW."},ev_one_pedal_regen_force_level3:{name:"V\xfdchoz\xed nastaven\xed maxim\xe1ln\xedho rekupera\u010dn\xedho brzd\u011bn\xed s jedn\xedm ped\xe1lem",desc:"Nastav\xed maxim\xe1ln\xed rekupera\u010dn\xed brzd\u011bn\xed (re\u017eim zastaven\xed jedn\xedm ped\xe1lem) jako v\xfdchoz\xed p\u0159i startu vozidla."},byd_soc_max_charge_target_limit:{name:"Maxim\xe1ln\xed limit nabit\xed baterie BYD (80 % / 90 %)",desc:"Nastavuje maxim\xe1ln\xed limit p\u0159eru\u0161en\xed nab\xedjen\xed AC/DC na 80 % nebo 90 %, aby se prodlou\u017eila \u017eivotnost baterie Blade."},byd_dmi_forced_pure_ev_speed_override:{name:"P\u0159epis benz\xednov\xe9ho motoru BYD DM-i Pure EV Mode",desc:"Zabra\u0148uje nastartov\xe1n\xed benz\xednov\xe9ho motoru v re\u017eimu EV a\u017e do rychlosti 130 km/h i p\u0159i akceleraci na pln\xfd plyn."},byd_vtol_v2v_rescue_charge_mode:{name:"Re\u017eim z\xe1chrann\xe9ho nab\xedjen\xed BYD VTOL (Vehicle-to-Vehicle).",desc:"Odemyk\xe1 extern\xed v\xfdstup st\u0159\xeddav\xe9ho proudu pro nab\xedjen\xed uv\xedzl\xfdch elektrick\xfdch vozidel na silnici."},hyundai_ipedal_memory_lock:{name:"Hyundai / Kia i-PEDAL One-Pedal Drive Memory Lock",desc:"Zabra\u0148uje tomu, aby se re\u017eim zastaven\xed i-PEDAL jedn\xedm ped\xe1lem vr\xe1til zp\u011bt na \xfarove\u0148 3 po za\u0159azen\xed zp\u011btn\xe9ho chodu."},hyundai_utility_mode_12v_saver:{name:"U\u017eitn\xfd re\u017eim Camping High-Voltage 12V Saver",desc:"Nap\xe1j\xed 220V V2L v\xfdstup p\u0159\xedmo z HV trak\u010dn\xed baterie, aby se zabr\xe1nilo vybit\xed pomocn\xe9 12V baterie."},hyundai_phev_no_ice_climate_start:{name:"Re\u017eim PHEV EV Klima Topen\xed Potla\u010den\xed benz\xednov\xe9ho motoru",desc:"Vynut\xed tepeln\xe9 \u010derpadlo / elektrick\xe9 topen\xed PTC pro klima v kabin\u011b bez nastartov\xe1n\xed benz\xednov\xe9ho motoru."},vag_taycan_ess_sound_profile_swap:{name:"Electric Sport Sound (ESS) Taycan / RS e-tron Profile",desc:"M\u011bn\xed elektrick\xfd j\xedzdn\xed zvukov\xfd profil na zvukov\xfd gener\xe1tor Porsche Taycan GTS nebo Audi RS e-tron GT."},vag_meb_daily_charge_target_menu:{name:"Baterie MEB denn\u011b 80 % / v\xfdlet 100 % Li\u0161ta rychl\xe9ho nab\xedjen\xed",desc:"P\u0159id\xe1 rychl\xfd p\u0159ep\xednac\xed panel na obrazovku MIB pro p\u0159ep\xedn\xe1n\xed mezi 80% denn\xed p\xe9\u010d\xed o baterii a 100% v\xfdletn\xedm nabit\xedm."},vag_gte_generator_charge_reserve:{name:"Nabit\xed baterie gener\xe1toru motoru GTE / E-Mode (80 %)",desc:"P\u0159inut\xed spalovac\xed motor, aby fungoval jako gener\xe1tor pro dobit\xed vysokonap\u011b\u0165ov\xe9 baterie a\u017e na 80 % za j\xedzdy."},bmw_hans_zimmer_iconic_sounds_m:{name:"Hans Zimmer IconicSounds Electric M-Performance Sound Engine",desc:"Odemyk\xe1 zvukov\xe9 profily Hanse Zimmera akustick\xe9 M-Performance elektrick\xe9 akcelerace na i4 a iX."},bmw_phev_max_edrive_140kmh:{name:"PHEV MAX eDrive Pure Electric rychlostn\xed strop (140 km/h)",desc:"Zvy\u0161uje maxim\xe1ln\xed \u010dist\u011b elektrick\xfd strop rychlosti u hybrid\u016f 330e / 530e Plug-in na 140 km/h."},bmw_ac_charging_current_limit_menu:{name:"Voli\u010d maxim\xe1ln\xedho limitu proudu dom\xe1c\xed nab\xedje\u010dky (6A - 32A)",desc:"P\u0159id\xe1v\xe1 omezova\u010d dom\xe1c\xedho nab\xedjec\xedho proudu AC (6A / 10A / 16A / 32A), aby se zabr\xe1nilo p\u0159et\xed\u017een\xed dom\xe1c\xedho okruhu."},toyota_hybrid_ev_mode_override:{name:"Potla\u010den\xed potla\u010den\xed \u0161krtic\xed klapky v re\u017eimu EV Toyota / Lexus",desc:"Zabra\u0148uje vynucen\xe9mu startu benz\xednov\xe9ho motoru b\u011bhem akcelerace, kdy\u017e je aktivn\xed tla\u010d\xedtko re\u017eimu EV."},toyota_hybrid_battery_fan_speed_boost:{name:"Pos\xedlen\xed ventil\xe1toru vysokonap\u011b\u0165ov\xe9ho chlazen\xed baterie Toyota / Lexus (+30 %)",desc:"Zvy\u0161uje rychlost ventil\xe1toru chlazen\xed hybridn\xed trak\u010dn\xed baterie o +30 %, aby se zabr\xe1nilo tepeln\xe9 degradaci v hork\xe9m klimatu."},tesla_sentry_high_bitrate_video:{name:"Nep\u0159etr\u017eit\xe9 nahr\xe1v\xe1n\xed z palubn\xed kamery s vysokou p\u0159enosovou rychlost\xed v re\u017eimu Tesla Sentry",desc:"Zvy\u0161uje p\u0159enosovou rychlost z\xe1znamu videa z kamery Sentry Mode pro k\u0159i\u0161\u0165\xe1lov\u011b \u010distou viditelnost SPZ."},tesla_cabin_overheat_threshold_30c:{name:"Teplotn\xed pr\xe1h ochrany proti p\u0159eh\u0159\xe1t\xed kabiny Tesla (30 \xb0C)",desc:"Sni\u017euje teplotu spou\u0161t\u011bc\xed klima ochrany proti p\u0159eh\u0159\xe1t\xed v kabin\u011b ze 40 \xb0C na 30 \xb0C pro zachov\xe1n\xed interi\xe9ru."},bmwmotorrad_quickshifter_pro_readapt:{name:"Shift Assistant Pro Re-adaptace",desc:"Resetuje parametry u\u010den\xed sn\xedma\u010de \u0159azen\xed a inicializuje rekalibraci quickshifteru."},bmwmotorrad_esa_zero_point_calib:{name:"Dynamick\xe1 kalibrace nulov\xe9ho bodu odpru\u017een\xed ESA",desc:"Kalibruje elektronick\xe9 sn\xedma\u010de zat\xed\u017een\xed odpru\u017een\xed a pojezdu na tov\xe1rn\xed nulu."},bmwmotorrad_abs_pro_cornering_toggle:{name:"Pr\xe1h z\xe1sahu re\u017eimu ABS Pro v zat\xe1\u010dk\xe1ch",desc:"Nastavuje citlivost z\xe1sahu ABS z\xe1vislou na \xfahlu sklonu pro pou\u017eit\xed na trati."},bmwmotorrad_service_interval_reset:{name:"Resetov\xe1n\xed p\u0159ipomenut\xed ro\u010dn\xed a distan\u010dn\xed slu\u017eby",desc:"Resetuje servisn\xed indik\xe1tor sdru\u017een\xe9ho p\u0159\xedstroje a nastavuje vlastn\xed interval."},bmwmotorrad_headlight_pro_cornering:{name:"Adaptivn\xed citlivost na zat\xe1\u010den\xed sv\u011btlomet\u016f Pro",desc:"Nastavuje pr\xe1h \xfahlu n\xe1klonu pro adaptivn\xed aktivaci sv\u011btlomet\u016f v zat\xe1\u010dk\xe1ch."},bmwmotorrad_keyless_ride_range_extend:{name:"Roz\u0161\xed\u0159en\xed dosahu detekce p\u0159\xedv\u011bsku pro j\xedzdu bez kl\xed\u010de",desc:"Optimalizuje dosah sign\xe1lu transpond\xe9ru pro sn\xedm\xe1n\xed bezkl\xed\u010dov\xe9ho zapalov\xe1n\xed."},bmwmotorrad_reverse_assist_sensitivity:{name:"Citlivost motoru elektrick\xe9ho asistenta zp\xe1te\u010dky",desc:"Jemn\u011b dola\u010fuje ot\xe1\u010dky a limit to\u010div\xe9ho momentu motoru elektrick\xe9ho start\xe9ru vzad."},ducati_riding_mode_custom_profile:{name:"Tv\u016frce vlastn\xedch profil\u016f re\u017eimu j\xedzdy",desc:"Odemkne vlastn\xed kombinace pro profily Race, Sport, Touring a Urban."},ducati_ohlins_suspension_mapping:{name:"Poloaktivn\xed mapov\xe1n\xed odpru\u017een\xed \xd6hlins Smart EC 2.0",desc:"Jemn\u011b dola\u010fuje k\u0159ivku tlumen\xed a p\u0159ednastaven\xed tuhosti pro elektronick\xe9 odpru\u017een\xed."},ducati_dashboard_lap_timer_gps:{name:"TFT Dashboard Lap Timer & GPS sektorov\xe9 rozd\u011blen\xed",desc:"Odemkne stopky a zobrazen\xed rozd\u011blen\xed sektor\u016f na sdru\u017een\xe9m p\u0159\xedstroji."},ducati_engine_brake_control_ebc:{name:"Nastaven\xed \xfarovn\u011b \u0159\xedzen\xed motorov\xe9 brzdy (EBC).",desc:"Nastavuje moment zpomalen\xed zadn\xedho kola p\u0159i prudk\xe9m brzd\u011bn\xed p\u0159i n\xe1jezdu do zat\xe1\u010dky."},ducati_cruise_control_retrofit_enable:{name:"Dodate\u010dn\xe1 aktivace tempomatu",desc:"Povoluje softwarov\xfd p\u0159\xedznak ECU pro dovybaven\xe9 sp\xedna\u010de elektronick\xe9ho tempomatu."},ducati_exhaust_valve_sound_map:{name:"Mapa otv\xedr\xe1n\xed v\xfdfukov\xe9ho servoventilu",desc:"Nastavuje pr\xe1h otev\u0159en\xed akustick\xe9ho v\xfdfukov\xe9ho ventilu pro lep\u0161\xed v\xfdfuk."},ducati_pit_lane_limiter_config:{name:"Pr\xe1h omezova\u010de rychlosti v boxech",desc:"Umo\u017e\u0148uje p\u0159ep\xedn\xe1n\xed omezova\u010de rychlosti v boxov\xe9 uli\u010dce na 60 km/h na sp\xedna\u010d\xedch na \u0159\xedd\xedtk\xe1ch."},ducati_desmo_service_light_reset:{name:"Reset servisn\xed kontrolky olejov\xe9ho a desmo ventilu",desc:"Vyma\u017ee varov\xe1n\xed p\u0159ipomenut\xed servisu desmodromick\xe9ho ventilu na sdru\u017een\xe9m p\u0159\xedstroji."},ktm_quickshifter_plus_delay_tuning:{name:"Jemn\xe9 lad\u011bn\xed Quickshifter+ Shift Cut Time & Delay",desc:"P\u0159izp\u016fsobuje dobu p\u0159eru\u0161en\xed zapalov\xe1n\xed na rychlostn\xed stupe\u0148 pro plynul\xe9 \u0159azen\xed nahoru/dol\u016f."},ktm_rally_offroad_abs_tc_unlock:{name:"Odemknut\xed re\u017eimu Rally / Off-Road ABS & TC",desc:"Deaktivuje zadn\xed ABS a odemkne 9-stup\u0148ov\xe9 nastaven\xed prokluzu v re\u017eimu Rally."},ktm_my_ktm_connectivity_unlock:{name:"Aktivace m\xe9ho modulu p\u0159ipojen\xed KTM / Husqvarna",desc:"Umo\u017e\u0148uje navigaci Bluetooth a podrobn\xe9 sm\u011brov\xe1n\xed na TFT displeji."},ktm_cruise_control_retrofit_enable:{name:"Odemknut\xed softwaru pro modernizaci tempomatu",desc:"Aktivuje funkci tempomatu po instalaci sady sp\xedna\u010d\u016f na \u0159\xedd\xedtka."},ktm_clutch_pull_map_switch_gesture:{name:"P\u0159ep\xedn\xe1n\xed mapy gestem spojky a tahu",desc:"Umo\u017e\u0148uje rychl\xe9 p\u0159ep\xedn\xe1n\xed map proveden\xedm gesta p\xe1\u010dky spojky p\u0159i spu\u0161t\u011bn\xed."},yamaha_quickshifter_cut_time_adjust:{name:"Quickshifter zapalov\xe1n\xed Cut-Time & Citlivost",desc:"Nastavuje prahovou hodnotu zat\xed\u017een\xed sn\xedma\u010de quickshifter a zpo\u017ed\u011bn\xed p\u0159eru\u0161en\xed jiskry."},yamaha_ride_by_wire_throttle_map:{name:"Voli\u010d p\u0159edvoleb mapy Ride-by-Wire",desc:"P\u0159ep\xedn\xe1 mezi mapami plynu A-Mode (Aggressive), STD a B-Mode (Smooth)."},yamaha_tft_track_theme_unlock:{name:"Rozvr\u017een\xed zobrazen\xed stopy TFT a odemknut\xed sv\u011btla posunu",desc:"Odemyk\xe1 rozvr\u017een\xed skupiny kolejnic R1/MT-09 SP a kontrolky programovateln\xe9ho \u0159azen\xed RPM."},yamaha_launch_control_sensitivity:{name:"Launch Control System (LCS) Rev Ceiling",desc:"Konfiguruje ovl\xe1d\xe1n\xed spou\u0161t\u011bn\xed podr\u017een\xedm RPM (rozsah 8 000 a\u017e 10 000 RPM)."},yamaha_heated_grips_accessory_enable:{name:"Integrace origin\xe1ln\xedch vyh\u0159\xedvan\xfdch rukojet\xed TFT menu",desc:"Umo\u017e\u0148uje ovl\xe1dac\xed prvky vyh\u0159\xedvan\xe9 rukojeti a teplom\u011br na obrazovce TFT."},honda_hstc_wheelie_control_fine_tune:{name:"Jemn\xe9 vylad\u011bn\xed trakce HSTC & Wheelie Control",desc:"Nastavuje pom\u011br prokluzu Honda Selectable Torque Control a toleranci zdvihu p\u0159edn\xedho kola."},honda_bi_directional_quickshifter_enable:{name:"Obousm\u011brn\xfd Quickshifter Retrofit Unlock",desc:"Umo\u017e\u0148uje automatick\xe9 bliknut\xed a k\xf3dov\xe1n\xed rychl\xe9ho \u0159azen\xed nahoru/dol\u016f v pam\u011bti ECU."},honda_service_reminder_custom_interval:{name:"P\u0159izp\u016fsoben\xed vzd\xe1lenosti p\u0159ipomenut\xed olejov\xe9 slu\u017eby",desc:"Nastavuje vlastn\xed interval v\xfdm\u011bny oleje na digit\xe1ln\xed p\u0159\xedstrojov\xe9 desce."},honda_track_abs_rear_disable:{name:"Track ABS Deaktivace zadn\xedho kola",desc:"Deaktivuje kan\xe1l ABS zadn\xedho kola a zachov\xe1 ABS v p\u0159edn\xedch zat\xe1\u010dk\xe1ch pro dny na z\xe1vodn\xed dr\xe1ze."},honda_cold_start_idle_enrichment:{name:"Obohacen\xed paliva p\u0159i studen\xe9m startu a c\xedlov\xe9 ot\xe1\u010dky p\u0159i volnob\u011bhu",desc:"Upravuje volnob\u011b\u017en\xe9 ot\xe1\u010dky p\u0159i po\u010d\xe1te\u010dn\xedm zah\u0159\xedv\xe1n\xed pro v\xfdfukov\xe9 syst\xe9my po prodeji."},harley_custom_throttle_curve_editor:{name:"Vlastn\xed editor k\u0159ivky odezvy plynu",desc:"Upravuje progresi plynu Milwaukee-Eight / Revolution Max ride-by-wire."},harley_security_alarm_sensitivity:{name:"Inteligentn\xed bezpe\u010dnostn\xed syst\xe9m bl\xedzkost a citlivost na n\xe1klon",desc:"Nastavuje citlivost sn\xedma\u010de pohybu a zpo\u017ed\u011bn\xed aktivace p\u0159\xedv\u011bsku hands-free."},harley_boom_box_gts_hidden_diagnostics:{name:"Bum! Box GTS Infotainment Nab\xeddka skryt\xe9 diagnostiky",desc:"Odemyk\xe1 technick\xe9 telemetrick\xe9 displeje, m\u011b\u0159i\u010de teploty motoru a tlaku oleje."},harley_rdrs_defensive_system_tune:{name:"Citlivost \u0159\xedzen\xed prokluzu brzdn\xe9ho momentu RDRS",desc:"Dola\u010fuje syst\xe9m Reflex Defensive Rider System zm\xedr\u0148uj\xedc\xed prokluz zadn\xedho kola p\u0159i pod\u0159azov\xe1n\xed."},byd_avas_low_speed_siren_mute:{name:"Ztlumen\xed varovn\xe9 sir\xe9ny pro chodce AVAS pro n\xedzkorychlostn\xed EV",desc:"Ztlum\xed nebo sn\xed\u017e\xed extern\xed akustickou sir\xe9nu v\xfdstra\u017en\xe9ho syst\xe9mu vozidla pod 30 km/h."},byd_ev_battery_preheat_manual_switch:{name:"P\u0159ep\xedna\u010d manu\xe1ln\xedho p\u0159edeh\u0159\xedv\xe1n\xed baterie EV",desc:"Umo\u017e\u0148uje manu\xe1ln\xed tepelnou \xfapravu baterie p\u0159ed stejnosm\u011brn\xfdm rychl\xfdm nab\xedjen\xedm."},byd_v2l_220v_outlet_power_expansion:{name:"V2L (Vehicle-to-Load) 220V roz\u0161\xed\u0159en\xed v\xfdstupn\xedho v\xfdkonu (3,6 kW)",desc:"Roz\u0161i\u0159uje strop extern\xedho v\xfdboje V2L z 2,2 kW na maximum 3,6 kW."},byd_one_pedal_regen_default_max:{name:"Regenerativn\xed brzd\u011bn\xed s pohonem jedn\xedm ped\xe1lem V\xfdchoz\xed Max",desc:"Blokuje vysok\xe9 rekupera\u010dn\xed brzd\u011bn\xed jako trval\xe9 v\xfdchoz\xed nastaven\xed p\u0159i nastartov\xe1n\xed vozidla."},mg_ismart_connectivity_unlock:{name:"i-SMART Connectivity & Remote Telemetry Unlock",desc:"Umo\u017e\u0148uje d\xe1lkov\xe9 ovl\xe1d\xe1n\xed klimatizace a funkce sledov\xe1n\xed stavu vozidla."},mg_mg4_xpower_launch_control_enable:{name:"Re\u017eim ovl\xe1d\xe1n\xed spou\u0161t\u011bn\xed dvou motor\u016f MG4 XPower",desc:"Odemkne re\u017eim akcelerace 3,8s 0-100 km/h."},mg_battery_preheat_manual_trigger:{name:"Manu\xe1ln\xed p\u0159edb\u011b\u017en\xe1 \xfaprava baterie s rychl\xfdm nab\xedjen\xedm",desc:"Vynut\xed ZAPNUT\xcd vysokonap\u011b\u0165ov\xfdch bateriov\xfdch topn\xfdch \u010dl\xe1nk\u016f pro maxim\xe1ln\xed stejnosm\u011brn\xe9 nab\xedjen\xed."},xpeng_xngp_adas_region_unlock:{name:"Odemknut\xed regionu asistenta autonomn\xedho \u0159\xedzen\xed XNGP",desc:"Umo\u017e\u0148uje pokro\u010dilou navigaci nav\xe1d\u011bnou pilotn\xed asistenci v odem\u010den\xfdch oblastech."},xpeng_ambient_lighting_music_sync:{name:"Hudebn\u011b-reaktivn\xed rytmick\xe9 okoln\xed osv\u011btlen\xed",desc:"Synchronizuje pulzy okoln\xedho osv\u011btlen\xed kabiny s basov\xfdmi rytmy audio syst\xe9mu."},xpeng_rear_camera_trailer_hitch_view:{name:"360\xb0 re\u017eim p\u0159ekryt\xed kamery Hitch & Ground",desc:"P\u0159id\xe1v\xe1 p\u0159ekryvnou m\u0159\xed\u017eku pro vyrovn\xe1n\xed z\xe1v\u011bsu s vysok\xfdm rozli\u0161en\xedm do zadn\xed kamery."},nio_battery_swap_interval_reminder:{name:"Re\u017eim p\u0159edb\u011b\u017en\xe9 \xfapravy stanice Power Swap",desc:"Automaticky spust\xed uzamykac\xed kol\xedky baterie a p\u0159iprav\xed sady p\u0159ed v\xfdm\u011bnou."},nio_nomi_assistant_custom_voice_phrases:{name:"NOMI AI Companion Personalization & Wake Words",desc:"Odemyk\xe1 vlastn\xed animace avatar\u016f a personalizovan\xe9 pozdravn\xe9 fr\xe1ze pro NOMI."},nio_sentry_watchdog_continuous_recording:{name:"Z\xe1znam z vyrovn\xe1vac\xed pam\u011bti fotoapar\xe1tu 4K v re\u017eimu NIO Sentry",desc:"Umo\u017e\u0148uje nahr\xe1v\xe1n\xed prostorov\xe9 kamery s vysokou bitovou rychlost\xed na USB disk, kdy\u017e je zaparkovan\xfd."},xiaomi_su7_hyperos_driver_profile_sync:{name:"Xiaomi SU7 HyperOS Driver Profile Ecosystem Sync",desc:"Automaticky synchronizuje p\u0159edvolby sedadla, zrc\xe1tka a klimatizace prost\u0159ednictv\xedm Bluetooth telefonu Xiaomi."},xiaomi_su7_boost_mode_throttle_curve:{name:"Re\u017eim zes\xedlen\xed 20sekundov\xe9 odblokov\xe1n\xed v\xfdkonu p\u0159i p\u0159ev\xfd\u0161en\xed",desc:"Prodlu\u017euje maxim\xe1ln\xed dobu trv\xe1n\xed p\u0159ebit\xed elektromotoru p\u0159i akceleraci na pln\xfd plyn."},xiaomi_su7_drift_mode_torque_vectoring:{name:"Re\u017eim Drift P\u0159id\u011blen\xed vektorov\xe1n\xed to\u010div\xe9ho momentu RWD",desc:"P\u0159id\u011bluje 100 % to\u010div\xe9ho momentu motoru zadn\xed n\xe1prav\u011b s vypnutou kontrolou trakce."},chery_isa_overspeed_warning_chime_off:{name:"ISA Intelligent Speed Assist Varovn\xe9 ztlumen\xed zvon\u011bn\xed",desc:"Deaktivuje trval\xe9 akustick\xe9 zvon\u011bn\xed p\u0159i p\u0159ekro\u010den\xed zji\u0161t\u011bn\xe9ho rychlostn\xedho limitu."},chery_driver_monitoring_camera_sensitivity:{name:"Citlivost kamery pro monitorov\xe1n\xed \xfanavy \u0159idi\u010de DMS",desc:"Sni\u017euje fale\u0161n\u011b pozitivn\xed upozorn\u011bn\xed na rozpt\xfdlen\xed z vnit\u0159n\xed monitorovac\xed kamery."},retrofit_parking_sensor_coding:{name:"Dodate\u010dn\xe1 mont\xe1\u017e k\xf3dov\xe1n\xed p\u0159edn\xed/zadn\xed parkovac\xed vzd\xe1lenosti (PDC).",desc:"Registruje modul parkovac\xedho senzoru pro trh s n\xe1hradn\xedmi d\xedly nebo OEM modul parkovac\xedho senzoru v instala\u010dn\xedm seznamu br\xe1ny."},retrofit_360_camera_activation:{name:"Dodate\u010dn\xe1 mont\xe1\u017e 360\xb0 prostorov\xe9ho kamerov\xe9ho syst\xe9mu s prostorov\xfdm v\xfdhledem",desc:"Aktivuje ovlada\u010d prostorov\xe9 kamery a p\u0159id\xe1v\xe1 pohled kamery do infotainmentu."},retrofit_led_license_plate_light_coding:{name:"Dodate\u010dn\xe1 mont\xe1\u017e LED SPZ a zadn\xedho sv\u011btla Zru\u0161it",desc:"Deaktivuje monitorov\xe1n\xed studen\xe9 \u017e\xe1rovky, aby se zabr\xe1nilo fale\u0161n\xfdm varov\xe1n\xedm zhasnut\xfdch sv\u011btel pomoc\xed LED."},retrofit_dash_cam_sentry_integration:{name:"Retrofit Dash Cam Continuous Ignition Power & Sentry Mode",desc:"Konfiguruje nap\xe1jec\xed veden\xed 30 \u0159\xeddic\xedho modulu karos\xe9rie pro nep\u0159etr\u017eit\xe9 nahr\xe1v\xe1n\xed parkov\xe1n\xed."},retrofit_heated_windshield_activation:{name:"Dodate\u010dn\xe1 mont\xe1\u017e k\xf3dov\xe1n\xed prvku vyh\u0159\xedvan\xe9ho \u010deln\xedho skla",desc:"Umo\u017e\u0148uje v\xfdstup rel\xe9 vyh\u0159\xedv\xe1n\xed odmrazov\xe1n\xed \u010deln\xedho skla a tla\u010d\xedtko obrazovky climatronic."},retrofit_wireless_charger_module_coding:{name:"Dodate\u010dn\xe1 integrace Qi bezdr\xe1tov\xe9 nab\xedjec\xed podlo\u017eky pro smartphone",desc:"Aktivuje LED stavu bezdr\xe1tov\xe9 nab\xedje\u010dky a vyskakovac\xed okno s p\u0159ipom\xednkou zanechan\xe9ho telefonu."},retrofit_acc_radar_module_coding:{name:"Dodate\u010dn\xe1 mont\xe1\u017e p\u0159edn\xedho radarov\xe9ho modulu adaptivn\xedho tempomatu (ACC).",desc:"K\xf3duje dodate\u010dn\u011b namontovanou p\u0159edn\xed distan\u010dn\xed radarovou jednotku do vozidlov\xe9 s\xedt\u011b CAN bus."},retrofit_traffic_sign_camera_activation:{name:"Dodate\u010dn\xe1 mont\xe1\u017e K\xf3dov\xe1n\xed \u010deln\xedho skla pro rozpozn\xe1v\xe1n\xed dopravn\xedch zna\u010dek",desc:"Umo\u017e\u0148uje zpracov\xe1n\xed rozpozn\xe1v\xe1n\xed znak\u016f VZE na dovybaven\xe9 kame\u0159e \u010deln\xedho skla."},retrofit_heated_steering_wheel_coding:{name:"Retrofit Aktivace modulu vyh\u0159\xedvan\xe9ho volantu",desc:"Umo\u017e\u0148uje v\xfdstup topn\xe9ho t\u011blesa volantu a automatick\xe9 spou\u0161t\u011bn\xed teploty."},retrofit_fatigue_camera_calibration:{name:"Dodate\u010dn\xe1 mont\xe1\u017e Integrace kamery pro sledov\xe1n\xed \xfanavy \u0159idi\u010de",desc:"Kalibruje sn\xedma\u010d infra\u010derven\xe9 kamery monitoruj\xedc\xed \u0159idi\u010de po instalaci sloupku \u0159\xedzen\xed."},retrofit_trailer_hitch_module_coding:{name:"Dodate\u010dn\xe1 mont\xe1\u017e integrace elektrick\xe9ho modulu ta\u017en\xe9ho za\u0159\xedzen\xed a p\u0159\xedv\u011bsu",desc:"K\xf3duje modul p\u0159\xedv\u011bsu do stabiliza\u010dn\xedho syst\xe9mu ESP pro zm\xedrn\u011bn\xed v\xfdkyv\u016f p\u0159\xedv\u011bsu."},retrofit_power_tailgate_trunk_kit_coding:{name:"Dodate\u010dn\xe1 mont\xe1\u017e elektricky ovl\xe1dan\xfdch dve\u0159\xed zavazadlov\xe9ho prostoru a integrace sn\xedma\u010de gest nohou",desc:"Umo\u017e\u0148uje elektrick\xe9 motory pohonu kufru a k\xf3dov\xe1n\xed sn\xedma\u010de n\xe1razu do n\xe1razn\xedku."},easteregg_urban_joke_light_show:{name:"Urban Joke st\u0159\xeddav\xe1 zadn\xed sv\u011bteln\xe1 show",desc:"Konfiguruje koncov\xe1 sv\u011btla a ukazatele sm\u011bru tak, aby p\u0159i zamyk\xe1n\xed vozidla st\u0159\xeddav\u011b blikaly."},easteregg_custom_boot_greeting_text:{name:"Vlastn\xed spou\u0161t\u011bc\xed text pozdravu na digit\xe1ln\xedm clusteru",desc:"Po zapnut\xed zapalov\xe1n\xed zobraz\xed u\u017eivatelskou uv\xedtac\xed zpr\xe1vu na obrazovce sdru\u017een\xe9ho p\u0159\xedstroje."},easteregg_cluster_mini_game_mode:{name:"Instrument Cluster Skryt\xe1 nab\xeddka miniher",desc:"P\u0159i zaparkov\xe1n\xed odemkne na displeji retro minihru ovl\xe1danou tla\u010d\xedtkem na volantu."},easteregg_custom_horn_melody_package:{name:"Vlastn\xed uv\xedtac\xed melodie akustick\xe9ho klaksonu",desc:"P\u0159i odemyk\xe1n\xed auta p\u0159ehraje kr\xe1tk\xfd rytmick\xfd cvrlik\xe1n\xed na klakson."},easteregg_welcome_lighting_door_sequence:{name:"Chasing LED Welcome Light Door sekvence",desc:"Prov\xe1d\xed progresivn\xed LED chasing animaci na vn\u011bj\u0161\xedch klik\xe1ch dve\u0159\xed."},easteregg_developer_service_menu_shortcut:{name:"Z\xe1stupce obrazovky diagnostiky pro v\xfdvoj\xe1\u0159e a slu\u017eby",desc:"Umo\u017e\u0148uje rychlou zkratku gesta pro p\u0159\xedstup ke skryt\xfdm obrazovk\xe1m in\u017een\xfdrsk\xe9 diagnostiky."},easteregg_seasonal_cluster_theme_effect:{name:"P\u0159ekryvn\xe9 t\xe9ma Sez\xf3nn\xed seskupen\xed po\u010das\xed (sn\u011bhov\xe1 vlo\u010dka/d\xe9\u0161\u0165)",desc:"P\u0159id\xe1 animovan\xe9 pozad\xed sn\u011bhov\xfdch vlo\u010dek nebo de\u0161\u0165ov\xfdch \u010d\xe1stic do shluku m\u011b\u0159idel v zim\u011b."},easteregg_valet_mode_prank_warning_message:{name:"Vyskakovac\xed upozorn\u011bn\xed na omezen\xed rychlosti v re\u017eimu obsluhy \u017eert",desc:"Zobrazuje vtipn\u011b p\u0159\xedsn\xe9 varovn\xe9 hl\xe1\u0161en\xed na palubn\xed desce, pokud je p\u0159ekro\u010den servisn\xed re\u017eim."},adas_lane_keep_assist_gentle_curve:{name:"Lane Keep Assist (LKA) Jemn\xe1 k\u0159ivka z\xe1sahu \u0159\xedzen\xed",desc:"Zm\xedr\u0148uje n\xe1hl\xe9 \u0161kub\xe1n\xed volantem pou\u017eit\xedm progresivn\xedho z\xe1sahu to\u010div\xe9ho momentu."},adas_lka_last_state_memory_mode:{name:"Asistent udr\u017eov\xe1n\xed j\xedzdn\xedho pruhu Posledn\xed stav Z\xe1mek pam\u011bti",desc:"Zabra\u0148uje automatick\xe9mu op\u011btovn\xe9mu zapnut\xed LKA p\u0159i ka\u017ed\xe9m restartov\xe1n\xed zapalov\xe1n\xed."},adas_acc_default_follow_distance:{name:"V\xfdchoz\xed p\u0159edvolba vzd\xe1lenosti adaptivn\xedho tempomatu (ACC).",desc:"Nastav\xed v\xfdchoz\xed nastaven\xed mezery (1 a\u017e 4 \u010d\xe1rky) p\u0159i ka\u017ed\xe9m zapnut\xed ACC."},adas_acc_speed_step_adjustment:{name:"Krokov\xfd voli\u010d tempomatu ACC (+5 / +10 km/h)",desc:"Zm\u011bn\xed krok tla\u010d\xedtka rychlosti na volantu z 1 km/h na 5 km/h."},adas_matrix_led_glare_free_high_beam_unlock:{name:"Matrix LED bezosl\u0148uj\xedc\xed adaptivn\xed d\xe1lkov\xfd sv\u011bteln\xfd \u0161t\xedt",desc:"Odemyk\xe1 adaptivn\xed d\xe1lkov\xe1 sv\u011btla evropsk\xe9 specifikace na severoamerick\xfdch autech."},adas_traffic_jam_assist_follow_fine_tune:{name:"Traffic Jam Assist Stop-and-Go Resume Resume",desc:"Prodlu\u017euje okno automatick\xe9ho restartu stop-and-go ze 3 sekund na 15 sekund."},adas_rear_radar_blind_spot_zero_point_reset:{name:"Kalibrace \xfahlu nulov\xe9ho bodu radaru pro zadn\xed mrtv\xfd \xfahel",desc:"P\u0159ekalibruje \xfahel azimutu radaru zadn\xedho n\xe1razn\xedku po demont\xe1\u017ei nebo oprav\u011b n\xe1razn\xedku."},adas_surround_camera_stitching_recalib:{name:"Kamera s prostorov\xfdm pohledem Zarovn\xe1n\xed dynamick\xe9ho se\u0161\xedv\xe1n\xed obrazu",desc:"Prov\xe1d\xed dynamickou kalibraci se\u0161\xedv\xe1n\xed obrazu kamery p\u0159i j\xedzd\u011b na silnici."},adas_steering_angle_sensor_zero_point_reset:{name:"Kalibrace nulov\xe9ho bodu sn\xedma\u010de \xfahlu \u0159\xedzen\xed (SAS).",desc:"Resetuje st\u0159edov\xfd \xfahel \u0159\xedzen\xed na 0,0\xb0 po slu\u017eb\u011b se\u0159\xedzen\xed geometrie kol."},adas_cross_traffic_alert_sensitivity_adjust:{name:"Rozsah detekce zadn\xedho upozorn\u011bn\xed na k\u0159\xed\u017eov\xfd provoz (RCTA).",desc:"Prodlu\u017euje bo\u010dn\xed radarovou detek\u010dn\xed vzd\xe1lenost pro vozidla p\u0159ibli\u017euj\xedc\xed se p\u0159i couv\xe1n\xed."},adas_aeb_emergency_braking_threshold_preview:{name:"V\xfdstra\u017en\xe1 \xfa\u010dinnost automatick\xe9ho nouzov\xe9ho brzd\u011bn\xed (AEB).",desc:"Upravuje \u010dasov\xe1n\xed v\u010dasn\xe9ho a pozdn\xedho varov\xe1n\xed pro upozorn\u011bn\xed na kolizi vp\u0159ed."},adas_night_vision_camera_alignment:{name:"Zarovn\xe1n\xed c\xedle infra\u010derven\xe9 termokamery pro no\u010dn\xed vid\u011bn\xed",desc:"Spust\xed sekvenci ov\u011b\u0159en\xed zarovn\xe1n\xed podstavce infra\u010derven\xe9 kamery."},adas_dms_driver_monitoring_ir_threshold:{name:"DMS Driver Attention Camera Infrared Sensitivity",desc:"Upravuje pr\xe1h sledov\xe1n\xed o\u010d\xed pro \u0159idi\u010de s tmav\xfdmi polariza\u010dn\xedmi slune\u010dn\xedmi br\xfdlemi."},toyota_soft_close_door_retrofit_coding:{name:"Power Soft-Close Door Actuator Actuator Code",desc:"Umo\u017e\u0148uje elektrick\xe9 zatahovac\xed aktu\xe1tory z\xe1padky dve\u0159\xed v \u0159\xeddic\xedm modulu karos\xe9rie."},toyota_digital_speedometer_display_enable:{name:"St\u0159edov\xfd displej digit\xe1ln\xedho rychlom\u011bru",desc:"P\u0159id\xe1v\xe1 velk\xfd digit\xe1ln\xed ode\u010det rychlosti na LCD analogov\xe9ho sdru\u017een\xe9ho p\u0159\xedstroje."},toyota_walk_away_auto_lock_sensitivity:{name:"Citlivost automatick\xe9ho zamyk\xe1n\xed dve\u0159\xed pomoc\xed chytr\xe9ho kl\xed\u010de p\u0159i odchodu",desc:"Uprav\xed pr\xe1h vzd\xe1lenosti p\u0159ed automatick\xfdm zamknut\xedm dve\u0159\xed p\u0159i odchodu."},toyota_jbl_3d_eq_audio_profile_unlock:{name:"K\u0159ivky ekvaliz\xe9ru prostorov\xe9ho zvuku JBL Premium Surround Sound",desc:"Odemyk\xe1 3D profily ekvaliz\xe9ru koncertn\xedho s\xe1lu v audio hlavn\xed jednotce JBL."},toyota_ev_mode_throttle_override_suppression:{name:"\u010cist\xe9 elektrick\xe9 omezen\xed limitu \u0161krtic\xed klapky v re\u017eimu EV",desc:"Zabra\u0148uje nastartov\xe1n\xed benz\xednov\xe9ho motoru p\u0159i m\xedrn\xe9 akceleraci EV."},ford_sync3_engineering_diagnostics_page:{name:"SYNC3 / SYNC4 Touchscreen Engineering Diagnostick\xe1 obrazovka",desc:"Povoluje nezpracovan\xe9 obrazovky GPS, test APIM a diagnostick\xe9 obrazovky zvukov\xe9 frekvence v syst\xe9mu SYNC."},ford_rear_seat_entertainment_unlock:{name:"Zadn\xed sedadla HDMI / Video Entertainment Audio Pass-Through",desc:"Umo\u017e\u0148uje streamov\xe1n\xed zvuku ze sluch\xe1tek v kabin\u011b pro obrazovky z\xe1bavy na zadn\xedch sedadlech."},ford_bambi_mode_fog_light_expansion:{name:"Re\u017eim Bambi D\xe1lkov\xe1 sv\u011btla + sou\u010dasn\xe9 osv\u011btlen\xed mlhov\xfdch sv\u011btel",desc:"Udr\u017euje zapnut\xe1 p\u0159edn\xed mlhov\xe1 sv\u011btla, i kdy\u017e jsou aktivov\xe1na d\xe1lkov\xe1 sv\u011btla."},ford_auto_engine_idle_shutdown_30min_override:{name:"Automatick\xe9 vypnut\xed motoru po 30 minut\xe1ch ne\u010dinnosti zak\xe1zat",desc:"Zabra\u0148uje automatick\xe9mu vypnut\xed motoru po 30 minut\xe1ch v Parkov\xe1n\xed."},hyundai_n_grin_shift_retrofit_enable:{name:"N Grin Shift (NGS) 20sekundov\xe9 odblokov\xe1n\xed dodate\u010dn\xe9ho p\u0159eboostov\xe1n\xed",desc:"Umo\u017e\u0148uje funkci overboost tla\u010d\xedtka NGS na volantu v ECU."},hyundai_smart_tailgate_approach_distance:{name:"Inteligentn\xed sn\xedm\xe1n\xed p\u0159ibl\xed\u017een\xed k zadn\xedm v\xfdklopn\xfdm dve\u0159\xedm bez pou\u017eit\xed rukou",desc:"Upravuje dobu zpo\u017ed\u011bn\xed st\xe1n\xed (3 s a\u017e 1 s), ne\u017e se chytr\xe9 dve\u0159e zavazadlov\xe9ho prostoru automaticky otev\u0159ou."},hyundai_digital_cluster_n_performance_theme:{name:"N Performance Digital Instrument Cluster Gauge Layout",desc:"Aplikuje rozlo\u017een\xed skupiny \u010derven\xe9ho indik\xe1toru \u0159azen\xed N-Performance na standardn\xed p\u0159\xedstrojovou desku LCD."},stellantis_scr_adblue_warning_threshold_adjust:{name:"Nastaven\xed prahu vzd\xe1lenosti v\xfdstrahy SCR AdBlue",desc:"Upravuje prvn\xed varovnou vzd\xe1lenost p\u0159ipomenut\xed dopln\u011bn\xed AdBlue z 2400 km na 1000 km."},stellantis_jeep_trail_rated_offroad_pages:{name:"Jeep Uconnect Trail-Rated Off-Road telemetrick\xe9 str\xe1nky",desc:"Odemyk\xe1 str\xe1nky n\xe1klonu hnac\xedho \xfastroj\xed, n\xe1klonu, kloubov\xe9ho spojen\xed kol a teploty chladic\xed kapaliny na Uconnect."},stellantis_peugeot_icockpit_3d_color_schemes:{name:"Vlastn\xed paleta barevn\xfdch sch\xe9mat Peugeot 3D i-Cockpit",desc:"Odemyk\xe1 barevn\xe9 motivy m\u011bdi a k\u0159emene pro 3D holografick\xfd digit\xe1ln\xed p\u0159\xedstrojov\xfd panel."},gm_super_cruise_follow_distance_adjust:{name:"Super Cruise Hands-Free Posun vzd\xe1lenosti",desc:"P\u0159izp\u016fsobuje rozestup mezer b\u011bhem autonomn\xed d\xe1lni\u010dn\xed j\xedzdy Super Cruise."},gm_instrument_hud_calibration_reset:{name:"Head-Up Display (HUD) Kalibrace polohy a n\xe1klonu nulov\xe9ho bodu",desc:"Resetuje \xfahel obrazu projektoru HUD na \u010deln\xedm skle a zarovn\xe1n\xed horizontu na nulov\xe9 \xfarovni."},gm_afm_v8_cylinder_lock_no_v4_drop:{name:"P\u0159eps\xe1n\xed deaktivace v\xe1lce AFM / DFM (v\u017edy re\u017eim V8)",desc:"Deaktivuje aktivn\xed spou\u0161t\u011bn\xed v\xe1lc\u016f pro \u0159\xedzen\xed paliva, aby motor b\u011b\u017eel v 8v\xe1lcov\xe9m re\u017eimu."},dodge_ram_truck_fog_lights_with_high_beam:{name:"Mlhov\xe1 sv\u011btla RAM Truck s d\xe1lkov\xfdmi sv\u011btly (kombinace vysok\xe9 a n\xedzk\xe9 mlhy)",desc:"Zabra\u0148uje automatick\xe9mu vypnut\xed mlhov\xfdch sv\u011btel p\u0159i zapnut\xed d\xe1lkov\xfdch sv\u011btel."},toyota_keyless_window_down:{name:"Otev\u0159en\xe9 ok\xe9nko na kl\xed\u010de Toyota (p\u0159idr\u017een\xed odemknut\xed)",desc:"Podr\u017een\xedm tla\u010d\xedtka UNLOCK na d\xe1lkov\xe9m ovlada\u010di st\xe1hne v\u0161echna elektricky ovl\xe1dan\xe1 okna."},toyota_seatbelt_chime_disable:{name:"Ztlumen\xed alarmu bezpe\u010dnostn\xedho p\xe1su Toyota (parkov\xe1n\xed/ter\xe9n)",desc:"Deaktivuje trval\xfd akustick\xfd varovn\xfd sign\xe1l bezpe\u010dnostn\xedho p\xe1su na sedadle spolujezdce."},honda_walkaway_auto_lock:{name:"Automatick\xfd z\xe1mek dve\u0159\xed Honda Walk-Away",desc:"Automaticky zamkne v\u0161echny dve\u0159e, kdy\u017e Smart Key opust\xed okruh vozidla 2,5 m."},volvo_speed_limiter_unlock:{name:"Roz\u0161\xed\u0159en\xfd tov\xe1rn\xed omezova\u010d rychlosti Volvo na 180 km/h",desc:"Upravuje maxim\xe1ln\xed tov\xe1rn\xed rychlost 180 km/h pro pou\u017eit\xed na trati / d\xe1lnici."},byd_v2l_3kw_power_unlock:{name:"BYD Re\u017eim st\u0159\xeddav\xe9ho v\xfdstupu 3,6 kW od vozidla k zat\xed\u017een\xed (V2L).",desc:"Umo\u017e\u0148uje extern\xed vyb\xedjec\xed port 220V/3,6kW V2L AC pro kempingov\xe1 za\u0159\xedzen\xed."},xiaomi_su7_drift_mode_unlock:{name:"Xiaomi SU7 Track Drift Mode & Rear-Torque Bias",desc:"Aktivuje 100% zkreslen\xed to\u010div\xe9ho momentu zadn\xedho motoru a re\u017eim ESC Track Drift."},vag_oil_service_reset:{name:"Oil Change Service Reset (Flexible Interval)",desc:"Resets instrument cluster oil change interval counter to factory 15,000 km / 365 days."},vag_epb_service_mode:{name:"Servisn\xed re\u017eim brzdov\xfdch desti\u010dek elektronick\xe9 parkovac\xed brzdy (EPB).",desc:"Stahuje p\xedsty zadn\xedho EPB t\u0159menu pro v\xfdm\u011bnu zadn\xed brzdov\xe9 desti\u010dky a rotoru."},bmw_bms_battery_registration:{name:"Registrace baterie inteligentn\xedho sn\xedma\u010de baterie (IBS).",desc:"Registruje novou v\xfdm\u011bnu 12V AGM/olov\u011bn\xe9 baterie v \u0159\xedzen\xed motoru DME/DDE."},bmw_motorrad_service_indicator_reset:{name:"V\xfdro\u010dn\xed servis BMW Motorrad a reset indik\xe1toru oleje",desc:"Vyma\u017ee datum ro\u010dn\xedho servisu a p\u0159ipomenut\xed ujet\xe9 vzd\xe1lenosti 10 000 km na sdru\u017een\xe9m p\u0159\xedstroji TFT."},ducati_desmo_service_reset:{name:"P\u0159ipomenut\xed servisu ventil\u016f Ducati Desmo je jasn\xe9",desc:"Vyma\u017ee ikonu kl\xed\u010de Desmoservice na p\u0159\xedstrojov\xe9 desce po 15 000 / 30 000 km servisu."},byd_bms_isolation_self_test:{name:"Samo\u010dinn\xfd vysokonap\u011b\u0165ov\xfd izola\u010dn\xed test BYD Blade Battery",desc:"Prov\xe1d\xed diagnostiku svod\u016f a odporu vysokonap\u011b\u0165ov\xe9ho syst\xe9mu (400V/800V) v BMS."},vag_drl_brightness_multi:{name:"Nastaven\xed jasu sv\u011btel pro denn\xed sv\xedcen\xed (DRL).",desc:"Upravte \xfarove\u0148 intenzity LED DRL pro re\u017eim potk\xe1vac\xedch sv\u011btel/parkov\xe1n\xed."},bmw_comfort_turn_signal_cycles:{name:"Jednodotykov\xfd komfortn\xed po\u010det pulz\u016f sm\u011brov\xfdch sv\u011btel",desc:"Vyberte po\u010det bliknut\xed p\u0159i rychl\xe9m klepnut\xed na p\xe1\u010dku ukazatel\u016f sm\u011bru."},bmw_oil_service_reset:{name:"Resetov\xe1n\xed motorov\xe9ho oleje CBS (BMW)",desc:"Resetuje procento \u017eivotnosti oleje CBS (Condition Based Service) zp\u011bt na 100 %."},generic_oil_service_reset:{name:"Resetov\xe1n\xed univerz\xe1ln\xedho indik\xe1toru \xfadr\u017eby oleje",desc:"Vyma\u017ee v\xfdstra\u017enou kontrolku \xfadr\u017eby oleje na palubn\xed desce u podporovan\xfdch ECU OBD2/UDS."},vag_epb_pad_change:{name:"Re\u017eim v\xfdm\u011bny brzdov\xfdch desti\u010dek EPB (VAG)",desc:"Stahuje t\u0159meny elektronick\xe9 parkovac\xed brzdy pro servis zadn\xedch brzdov\xfdch desti\u010dek."},bmw_epb_pad_change:{name:"Servisn\xed re\u017eim brzd EPB (BMW)",desc:"Otev\xedr\xe1 ovlada\u010d parkovac\xed brzdy do servisn\xed polohy pro v\xfdm\u011bnu zadn\xedho oblo\u017een\xed."},mb_epb_pad_change:{name:"Re\u017eim EPB Pad Fitting Mode (Mercedes-Benz)",desc:"Uvoln\xed v\u0159eteno parkovac\xed brzdy do d\xedlensk\xe9 polohy pro servis brzd."},vag_dpf_regen:{name:"Spou\u0161t\u011b\u010d regenerace DPF (VAG)",desc:"Spou\u0161t\xed stacion\xe1rn\xed cyklus vypalov\xe1n\xed saz\xed filtru pevn\xfdch \u010d\xe1stic (DPF)."},bmw_dpf_regen:{name:"Spou\u0161t\u011b\u010d nucen\xe9 regenerace DPF (BMW)",desc:"Po\u017eaduje ECU DDE, aby zah\xe1jila aktivn\xed rutinu regenerace filtru pevn\xfdch \u010d\xe1stic."},psa_dpf_regen:{name:"\u017d\xe1dost o regeneraci DPF (Peugeot/Citro\xebn)",desc:"Spou\u0161t\xed stacion\xe1rn\xed regeneraci DPF pro ECU dieselov\xe9ho motoru HDi."},bmw_bms_battery_register:{name:"Registrace v\xfdm\u011bny baterie BMS (BMW)",desc:"Registruje novou v\xfdm\u011bnu baterie pomoc\xed inteligentn\xedho sn\xedma\u010de baterie DME/DDE."},mb_bms_battery_register:{name:"Registrace a reset baterie (Mercedes-Benz)",desc:"Po instalaci nov\xe9 baterie vynuluje po\u010d\xedtadlo st\xe1rnut\xed baterie v modulu SAM."},vag_sas_calibrate:{name:"Kalibrace sn\xedma\u010de \xfahlu \u0159\xedzen\xed (SAS) (VAG)",desc:"Kalibruje nulovou polohu sn\xedma\u010de \xfahlu \u0159\xedzen\xed G85 pro ECU ABS/ESP."},toyota_sas_calibrate:{name:"Kalibrace nulov\xe9ho bodu \xfahlu \u0159\xedzen\xed (Toyota)",desc:"Prov\xe1d\xed kalibraci nulov\xe9ho bodu sn\xedma\u010de \xfahlu nato\u010den\xed volantu v ECU \u0159\xedzen\xed smyku."},generic_tba_adapt:{name:"Vyrovn\xe1n\xed a p\u0159izp\u016fsoben\xed t\u011bla \u0161krtic\xed klapky",desc:"V ECU motoru provede rutinu u\u010den\xed zastaven\xed elektronick\xe9ho t\u011blesa \u0161krtic\xed klapky."},epb_service_reset:{name:"Univerz\xe1ln\xed reset \xfadr\u017eby EPB",desc:"Resetuje po\u010d\xedtadlo opot\u0159eben\xed t\u0159menu elektronick\xe9 parkovac\xed brzdy a kalibruje vzduchovou mezeru."},vag_dsg_reset:{name:"Obnoven\xed z\xe1kladn\xedho nastaven\xed p\u0159evodovky DSG (VAG)",desc:"Resetuje body z\xe1b\u011bru spojky a p\u0159izp\u016fsoben\xed \u0159adic\xedch ventil\u016f pro DSG/S-Tronic."},bmw_zf_reset:{name:"Obnoven\xed adaptace p\u0159evodovky ZF 8HP (BMW)",desc:"Vyma\u017ee \u010das \u0159azen\xed p\u0159evodovky EGS a hodnoty p\u0159izp\u016fsoben\xed tlaku."},bmw_brake_fluid_reset:{name:"Resetov\xe1n\xed servisn\xedho intervalu brzdov\xe9 kapaliny (BMW)",desc:"Resetuje 2let\xfd \u010dasova\u010d v\xfdm\u011bny brzdov\xe9 kapaliny Service (CBS)."},ford_injector_code:{name:"K\xf3dov\xe1n\xed korek\u010dn\xedho faktoru vst\u0159ikova\u010de (Ford)",desc:"Programuje 16znakov\xe9 IQA k\xf3dy pro dieselov\xe9 vst\u0159ikova\u010de do PCM."},bmw_injector_code:{name:"K\xf3dov\xe1n\xed pr\u016ftoku vst\u0159ikova\u010de paliva (BMW)",desc:"Zapisuje hodnoty energetick\xe9 kalibrace pro vym\u011bn\u011bn\xe9 vst\u0159ikova\u010de paliva do DME."},generic_headlight_aim:{name:"Kalibrace automatick\xe9ho vyrovn\xe1v\xe1n\xed sv\u011btlomet\u016f",desc:"Nastavuje referen\u010dn\xed nulovou polohu pro motory adaptivn\xedho automatick\xe9ho nastavov\xe1n\xed sklonu sv\u011btlomet\u016f."},bmw_12v_battery_reg:{name:"Registrace 12V pomocn\xe9 baterie (BMW)",desc:"Registruje v\xfdm\u011bnu pomocn\xe9ho start\xe9ru/pomocn\xe9 baterie AGM v PCU."},vag_comfort_turn_signal:{name:"Komfortn\xed po\u010det bliknut\xed blinkr\u016f (VAG)",desc:"Upravuje po\u010det cykl\u016f blinkru zm\u011bny j\xedzdn\xedho pruhu mezi 3, 4 a 5 bliknut\xedmi."},vag_coming_home_duration:{name:"Doba osv\u011btlen\xed p\u0159\xedchodu/odch\xe1zen\xed (VAG)",desc:"Konfiguruje \u010dasova\u010d osv\u011btlen\xed sv\u011btlomet\u016f po uzam\u010den\xed vozidla (10s - 60s)."},vag_remote_windows:{name:"D\xe1lkov\xe9 pohodln\xe9 ovl\xe1d\xe1n\xed oken (VAG)",desc:"Umo\u017e\u0148uje otev\xedr\xe1n\xed a zav\xedr\xe1n\xed elektricky ovl\xe1dan\xfdch oken dlouh\xfdm stisknut\xedm d\xe1lkov\xe9ho ovlada\u010de."},vag_auto_lock_15kmh:{name:"Auto Door Lock p\u0159i 15 km/h (VAG)",desc:"Automaticky uzamkne v\u0161echny dve\u0159e, kdy\u017e rychlost vozidla dos\xe1hne 15 km/h."},vag_sfd_unlock_prep:{name:"P\u0159\xedprava na stav ochrany br\xe1ny SFD (VAG 2020+)",desc:"P\u0159ipravuje relaci tokenu br\xe1ny MQB-evo SFD pro z\xe1pis chr\xe1n\u011bn\xfdch DID."},bmw_asd_deactivate:{name:"Deaktivace aktivn\xedho zvukov\xe9ho designu (ASD) (BMW)",desc:"Ztlum\xed syntetick\xfd zvuk motoru p\u0159ehr\xe1van\xfd z reproduktor\u016f v kabin\u011b."},bmw_comfort_turn_signal:{name:"Komfortn\xed po\u010det sm\u011brov\xfdch sv\u011btel (BMW)",desc:"Nastavuje po\u010det pulz\u016f indik\xe1toru jedn\xedm dotykem (1 a\u017e 5 bliknut\xed)."},bmw_mirror_fold_lock:{name:"Comfort Access Mirror Fold on Lock (BMW)",desc:"Automaticky sklop\xed bo\u010dn\xed zrc\xe1tka ihned po zamknut\xed vozidla."},toyota_coming_home_duration:{name:"Zpo\u017ed\u011bn\xed sv\u011btlometu / Coming-Home (Toyota)",desc:"Konfiguruje \u010dasova\u010d zpo\u017ed\u011bn\xed vypnut\xed sv\u011btlomet\u016f po vypnut\xed zapalov\xe1n\xed (30s-120s)."},toyota_lane_change_flash:{name:"Po\u010det z\xe1blesk\u016f sm\u011brov\xfdch sv\u011btel p\u0159i zm\u011bn\u011b j\xedzdn\xedho pruhu (Toyota)",desc:"Upravuje po\u010det cykl\u016f blinkru zm\u011bny j\xedzdn\xedho pruhu na jeden dotek."},toyota_remote_window_close:{name:"D\xe1lkov\xe9 elektrick\xe9 zav\xedr\xe1n\xed oken (Toyota)",desc:"Umo\u017e\u0148uje zav\u0159\xedt v\u0161echna elektricky ovl\xe1dan\xe1 okna p\u0159idr\u017een\xedm tla\u010d\xedtka d\xe1lkov\xe9ho zamyk\xe1n\xed."},toyota_autolock_behavior:{name:"P\u0159izp\u016fsoben\xed automatick\xe9ho zamyk\xe1n\xed/odemyk\xe1n\xed dve\u0159\xed (Toyota)",desc:"Nastav\xed spou\u0161\u0165 zamyk\xe1n\xed dve\u0159\xed (vy\u0159azen\xed z P vs. rychlost vozidla > 20 km/h)."},toyota_approach_welcome_lights:{name:"Uv\xedtac\xed sv\u011btla Smart Key Approach (Toyota)",desc:"Zapne vnit\u0159n\xed osv\u011btlen\xed kalu\u017ee/kabiny, kdy\u017e se chytr\xfd kl\xed\u010d p\u0159ibl\xed\u017e\xed k vozidlu."},hyundai_autolock_behavior:{name:"Chov\xe1n\xed automatick\xe9ho zamyk\xe1n\xed/odemyk\xe1n\xed dve\u0159\xed (Hyundai/Kia)",desc:"Automaticky zamyk\xe1 dve\u0159e p\u0159i \u0159azen\xed nebo rychlosti a odemyk\xe1 v poloze P nebo p\u0159i vypnut\xe9m zapalov\xe1n\xed."},hyundai_window_remote:{name:"D\xe1lkov\xe9 otev\xedr\xe1n\xed/zav\xedr\xe1n\xed oken (Hyundai/Kia)",desc:"Umo\u017e\u0148uje rolov\xe1n\xed oken nahoru/dol\u016f pomoc\xed tla\u010d\xedtek na chytr\xe9 kl\xed\u010dence."},hyundai_sport_mode_memory:{name:"Pam\u011b\u0165 volby re\u017eimu j\xedzdy (Hyundai/Kia)",desc:"Pamatuje si posledn\xed zvolen\xfd j\xedzdn\xed re\u017eim (Sport/Eco) po restartov\xe1n\xed motoru."},tesla_charge_limit_custom:{name:"P\u0159izp\u016fsoben\xed limitu nabit\xed baterie (Tesla)",desc:"Nastav\xed v\xfdchoz\xed procento limitu nabit\xed HV baterie (80 % denn\u011b / 100 % v\xfdlet)."},tesla_mirror_fold_lock:{name:"Automatick\xe9 skl\xe1d\xe1n\xed zrcadla na z\xe1mku Walk-Away (Tesla)",desc:"Automaticky sklop\xed bo\u010dn\xed zrc\xe1tka, kdy\u017e se aktivuje odemyk\xe1n\xed kl\xed\u010de od telefonu."},nissan_coming_home:{name:"Zpo\u017ed\u011bn\xed zhasnut\xed sv\u011btlomet\u016f (Nissan)",desc:"Udr\u017euje sv\u011btlomety rozsv\xedcen\xe9 po dobu 30 sekund po opu\u0161t\u011bn\xed vozidla Nissan."},nissan_lane_change_flash:{name:"Po\u010det z\xe1blesk\u016f zm\u011bny j\xedzdn\xedho pruhu p\u0159i p\u0159ej\xed\u017ed\u011bn\xed klepnut\xedm (Nissan)",desc:"Nastavuje po\u010det impulz\u016f ukazatele sm\u011bru p\u0159i klepnut\xed na p\xe1\u010dku sv\u011btla."},nissan_autolock_behavior:{name:"Automatick\xfd z\xe1mek dve\u0159\xed z\xe1visl\xfd na rychlosti (Nissan)",desc:"Automaticky zamkne v\u0161echny dve\u0159e, kdy\u017e vozidlo dos\xe1hne rychlosti 24 km/h."},nissan_window_remote:{name:"D\xe1lkov\xe9 ovl\xe1d\xe1n\xed oken na kl\xed\u010denku (Nissan)",desc:"Otev\xedr\xe1/zav\xedr\xe1 p\u0159edn\xed okna dlouh\xfdm stisknut\xedm tla\u010d\xedtka odemyk\xe1n\xed na kl\xed\u010dence."},nissan_seatbelt_chime_mute:{name:"Potla\u010den\xed zvuku upozorn\u011bn\xed na bezpe\u010dnostn\xed p\xe1s (Nissan)",desc:"Ztlum\xed opakuj\xedc\xed se varovn\xfd sign\xe1l bezpe\u010dnostn\xedch p\xe1s\u016f a z\xe1rove\u0148 zachov\xe1 ikonu sdru\u017een\xe9ho p\u0159\xedstroje."},porsche_sport_chrono_launch:{name:"Profil odezvy Sport Chrono Launch Control (Porsche)",desc:"Optimalizuje ovl\xe1d\xe1n\xed spou\u0161t\u011bn\xed p\u0159evodovky PDK prahov\xe9 hodnoty ot\xe1\u010dek a z\xe1b\u011br spojky."},porsche_pasm_default:{name:"P\u0159edvolba spu\u0161t\u011bn\xed re\u017eimu PASM Suspension (Porsche)",desc:"Nastav\xed v\xfdchoz\xed tuhost adaptivn\xedho odpru\u017een\xed PASM p\u0159i startu zapalov\xe1n\xed."},porsche_exhaust_flap:{name:"Konstantn\xed vyp\xedn\xe1n\xed sportovn\xed v\xfdfukov\xe9 klapky (Porsche)",desc:"P\u0159inut\xed aktivn\xed v\xfdfukov\xe9 ventily, aby z\u016fstaly 100% otev\u0159en\xe9 ve v\u0161ech rozsaz\xedch ot\xe1\u010dek."},audi_drive_select_memory:{name:"Uchov\xe1n\xed pam\u011bti re\u017eimu Audi Drive Select (Audi)",desc:"Po restartu zachov\xe1 posledn\xed aktivn\xed profil Drive Select (Dynamic/Individual)."},audi_virtual_cockpit_themes:{name:"Grafick\xe9 rozlo\u017een\xed Audi Virtual Cockpit S/RS Sport (Audi)",desc:"Odemyk\xe1 mo\u017enosti rozlo\u017een\xed centr\xe1ln\xedho tachometru S/RS ve virtu\xe1ln\xedm kokpitu."},vag_scandinavian_drl:{name:"Skandin\xe1vsk\xfd re\u017eim DRL (VAG)",desc:"Udr\u017euje zadn\xed koncov\xe1 sv\u011btla trvale rozsv\xedcen\xe1 vedle p\u0159edn\xedch DRL."},vag_mirror_dip_reverse:{name:"Sklopen\xed zp\u011btn\xe9ho zrc\xe1tka spolujezdce (VAG)",desc:"Sklop\xed zrc\xe1tko na stran\u011b spolujezdce dol\u016f, kdy\u017e je za\u0159azena zp\xe1te\u010dka."},vag_dynamic_turn_signal:{name:"Dynamick\xfd / sekven\u010dn\xed re\u017eim sm\u011brov\xfdch sv\u011btel (VAG)",desc:"Umo\u017e\u0148uje rozm\xedt\xe1n\xed dynamick\xe9ho vzoru blik\xe1n\xed LED na kompatibiln\xedch modulech zadn\xedch sv\u011btel."},vag_seatbelt_warning_duration:{name:"Nastaven\xed doby varovn\xe9ho zvon\u011bn\xed bezpe\u010dnostn\xedho p\xe1su (VAG)",desc:"Zkracuje nebo potla\u010duje opakuj\xedc\xed se \u010dasova\u010d varovn\xe9ho sign\xe1lu bezpe\u010dnostn\xedho p\xe1su."},vag_sunroof_remote:{name:"D\xe1lkov\xe9 ovl\xe1d\xe1n\xed komfortu st\u0159e\u0161n\xedho okna (VAG)",desc:"Umo\u017e\u0148uje otev\xedr\xe1n\xed a vykl\xe1p\u011bn\xed panoramatick\xe9ho st\u0159e\u0161n\xedho okna pomoc\xed d\xe1lkov\xe9ho dr\u017een\xed kl\xed\u010denky."},vag_acc_distance_preset:{name:"ACC Adaptive Cruise Default Follow Distance (VAG)",desc:"Nastav\xed v\xfdchoz\xed radar podle profilu vzd\xe1lenosti p\u0159i startu zapalov\xe1n\xed."},vag_infotainment_startup_logo:{name:"Infotainment Boot Graphic Logo (VAG)",desc:"P\u0159izp\u016fsobuje logo \xfavodn\xed obrazovky infotainmentu (R-Line, GTI, RS)."},vag_ambient_color_cycle:{name:"Odemknut\xed barevn\xe9ho spektra okoln\xedho sv\u011btla (VAG)",desc:"Roz\u0161i\u0159uje mo\u017enosti palety okoln\xedho osv\u011btlen\xed v nab\xeddce nastaven\xed vozidla."},vag_service_interval_custom:{name:"Vlastn\xed inspekce a prahov\xe1 hodnota servisn\xed vzd\xe1lenosti (VAG)",desc:"Konfiguruje vlastn\xed km a denn\xed c\xedle pro upozorn\u011bn\xed na dal\u0161\xed servisn\xed slu\u017ebu."},vag_door_handle_lights_reverse:{name:"Osv\u011btlen\xed vn\u011bj\u0161\xed kliky dve\u0159\xed zapnuto p\u0159i zp\xe1te\u010dce (VAG)",desc:"Rozsv\xedt\xed LED lou\u017eov\xe1 sv\u011btla klik dve\u0159\xed p\u0159i couv\xe1n\xed pro viditelnost na zem."},bmw_msport_exhaust_burble:{name:"M-Sport Exhaust Burble & Pop Intensity (BMW)",desc:"Uprav\xed agresivitu zvuku p\u0159ete\u010den\xed v re\u017eimu Sport."},bmw_welcome_light_sequence:{name:"Uv\xedtac\xed sv\u011bteln\xe1 sekvence animace (BMW)",desc:"P\u0159izp\u016fsob\xed LED sv\u011btlomet a uv\xedtac\xed uv\xedtac\xed sekvenci Angel Eyes."},bmw_service_history_menu:{name:"Povolit nab\xeddku digit\xe1ln\xed servisn\xed historie (BMW)",desc:"Odemkne nab\xeddku digit\xe1ln\xed servisn\xed knihy iDrive na centr\xe1ln\xedm displeji."},bmw_hud_speed_display:{name:"Head-Up Display P\u0159ekryvn\xfd digit\xe1ln\xed rychlom\u011br (BMW)",desc:"Prom\xedt\xe1 digit\xe1ln\xed ode\u010det rychlosti v re\xe1ln\xe9m \u010dase na Head-Up displej."},bmw_cornering_lights_fog:{name:"Osv\u011btlen\xed zat\xe1\u010dek do mlhy (BMW)",desc:"Zapne p\u0159edn\xed mlhov\xe9 sv\u011btlo na ukazatel sm\u011bru nebo p\u0159i n\xedzk\xe9 rychlosti nato\u010den\xed volantu."},bmw_easy_entry_steering:{name:"Automaticky zasouvac\xed sloupek \u0159\xedzen\xed Easy Entry (BMW)",desc:"St\xe1hne elektrick\xfd volant nahoru po vypnut\xed motoru pro snadn\xe9 vystupov\xe1n\xed."},bmw_bluetooth_audio_enable:{name:"Odemknut\xed vylep\u0161en\xe9ho Bluetooth Audio Streaming (BMW)",desc:"Umo\u017e\u0148uje bezdr\xe1tov\xe9 streamov\xe1n\xed hudby A2DP Bluetooth v iDrive HU_ENTRYNAV."},bmw_door_handle_lights_reverse:{name:"Vn\u011bj\u0161\xed sv\u011btla na klik\xe1ch dve\u0159\xed p\u0159i zp\xe1te\u010dce (BMW)",desc:"Rozsv\xedt\xed LED kliky dve\u0159\xed p\u0159i za\u0159azen\xed zp\xe1te\u010dky."},toyota_auto_headlight_threshold:{name:"Citlivost senzoru okoln\xedho sv\u011btla pro automatick\xe9 sv\u011btlomety (Toyota)",desc:"Upravuje pr\xe1h soumraku pro automatickou aktivaci sv\u011btlomet\u016f."},toyota_turn_signal_click_volume:{name:"Hlasitost reproduktoru s cvaknut\xedm sm\u011brov\xe9ho sign\xe1lu (Toyota)",desc:"Konfiguruje hlasitost cvaknut\xed rel\xe9 sm\u011brov\xfdch sv\u011btel (n\xedzk\xe1, st\u0159edn\xed, vysok\xe1)."},toyota_smart_key_approach_lights:{name:"Smart Key Proximity Welcome Puddle Lights (Toyota)",desc:"Kdy\u017e se chytr\xfd kl\xed\u010d p\u0159ibl\xed\u017e\xed k vozidlu, zapne se osv\u011btlen\xed lou\u017ee zrc\xe1tka."},toyota_rear_hatch_behavior:{name:"Logika ovl\xe1d\xe1n\xed otev\xedr\xe1n\xed/zav\xedr\xe1n\xed v\xfdklopn\xfdch dve\u0159\xed zavazadlov\xe9ho prostoru (Toyota)",desc:"Konfiguruje dobu stisknut\xed tla\u010d\xedtka d\xe1lkov\xe9ho ovl\xe1d\xe1n\xed a ovl\xe1dac\xedho panelu."},toyota_open_windows_smart_key:{name:"Dlouh\xfd stisk stahovac\xedho okna na d\xe1lkov\xe9m ovlada\u010di Smart Key (Toyota)",desc:"Umo\u017e\u0148uje otev\u0159en\xed v\u0161ech oken p\u0159idr\u017een\xedm tla\u010d\xedtka d\xe1lkov\xe9ho odemyk\xe1n\xed."},toyota_interior_light_dim_timer:{name:"Zpo\u017ed\u011bn\xed automatick\xe9ho zhasnut\xed vnit\u0159n\xedho sv\u011btla v kabin\u011b (Toyota)",desc:"Nastavuje \u010dasova\u010d vypnut\xed vnit\u0159n\xedho stropn\xedho sv\u011btla po zav\u0159en\xed dve\u0159\xed."},toyota_panic_alarm_remote:{name:"Funkce sir\xe9ny nouzov\xe9ho alarmu d\xe1lkov\xe9ho ovlada\u010de (Toyota)",desc:"Aktivuje nebo deaktivuje panikov\xfd alarm klaksonu vozidla prost\u0159ednictv\xedm d\xe1lkov\xe9ho p\u0159idr\u017een\xed kl\xed\u010de."},toyota_eco_drive_indicator:{name:"Kontrolka z\xf3ny ECO Drive Cluster (Toyota)",desc:"Zobrazuje ekologickou akcelera\u010dn\xed li\u0161tu a kontrolku na sdru\u017een\xe9m p\u0159\xedstroji."},hyundai_coming_home_duration:{name:"\u010casova\u010d zpo\u017ed\u011bn\xed zhasnut\xed doprovodn\xfdch sv\u011btlomet\u016f (Hyundai/Kia)",desc:"Udr\u017euje rozsv\xedcen\xe1 potk\xe1vac\xed sv\u011btla po opu\u0161t\u011bn\xed vozidla."},hyundai_drl_menu_toggle:{name:"Ovl\xe1d\xe1n\xed nab\xeddky sv\u011btel pro denn\xed sv\xedcen\xed (Hyundai/Kia)",desc:"P\u0159id\xe1 nastaven\xed DRL ON/OFF do u\u017eivatelsk\xfdch mo\u017enost\xed sdru\u017een\xe9ho p\u0159\xedstroje."},hyundai_welcome_sequence:{name:"Uv\xedtac\xed sv\u011btlo a zrc\xe1tko pro p\u0159ibl\xed\u017een\xed chytr\xe9ho kl\xed\u010de (Hyundai/Kia)",desc:"P\u0159i p\u0159ibl\xed\u017een\xed odklop\xed elektricky ovl\xe1dan\xe1 zrc\xe1tka a rozsv\xedt\xed kliky dve\u0159\xed."},hyundai_interior_light_delay:{name:"Zpo\u017ed\u011bn\xed automatick\xe9ho vypnut\xed vnit\u0159n\xedho osv\u011btlen\xed kabiny (Hyundai/Kia)",desc:"Nastav\xed \u010dasova\u010d, ne\u017e se vnit\u0159n\xed osv\u011btlen\xed automaticky vypne, aby se \u0161et\u0159ila baterie."},hyundai_heat_pump_efficiency:{name:"Re\u017eim tepeln\xe9 \xfa\u010dinnosti tepeln\xe9ho \u010derpadla EV (Hyundai/Kia)",desc:"Optimalizuje spot\u0159ebu energie tepeln\xe9ho \u010derpadla EV v chladn\xe9m zimn\xedm po\u010das\xed."},tesla_track_mode_params:{name:"Profil stability a kroutic\xedho momentu v re\u017eimu trat\u011b (Tesla)",desc:"Konfiguruje p\u0159edp\u011bt\xed pohonu p\u0159edn\xedho/zadn\xedho motoru a z\xe1sah stability."},tesla_regen_brake_strength:{name:"Profil regenerativn\xedho brzdn\xe9ho v\xfdkonu (Tesla)",desc:"Nastavuje intenzitu rekuperace energie p\u0159i zdvihu ped\xe1lu plynu."},tesla_walkaway_door_lock:{name:"Automatick\xfd z\xe1mek dve\u0159\xed s kl\xed\u010dem k telefonu (Tesla)",desc:"Zamkne dve\u0159e a potvrd\xed cvrlik\xe1n\xedm klaksonu, kdy\u017e se kl\xed\u010d telefonu vzd\xe1l\xed."},tesla_acceleration_boost_unlock:{name:"Profil pohonu zrychlen\xed zrychlen\xed (Tesla)",desc:"Zlep\u0161uje odezvu m\u011bni\u010de elektromotoru pro rychlej\u0161\xed \u010dasy z 0-100 km/h."},tesla_interior_ambient_color:{name:"P\u0159edvolba barvy okoln\xedho osv\u011btlen\xed prostoru pro nohy v kabin\u011b (Tesla)",desc:"P\u0159izp\u016fsobuje barevnou paletu RGB okoln\xedho osv\u011btlen\xed prostoru pro nohy LED."},audi_matrix_led_animation:{name:"Matrix LED sv\u011btlomety Dynamic Welcome Light Dance (Audi)",desc:"P\u0159ehr\xe1v\xe1 dynamickou sv\u011btelnou choreografii po odemknut\xed vozidla."},audi_mmi_startup_screen:{name:"Grafick\xfd motiv spou\u0161t\u011bn\xed dotykov\xe9 obrazovky MMI (Audi)",desc:"P\u0159izp\u016fsob\xed animaci spou\u0161t\u011bn\xed na centr\xe1ln\xed obrazovce MMI (S / RS / e-tron)."},audi_drive_select_efficiency:{name:"Profil efektivity j\xedzdy v Audi Drive Select (Audi)",desc:"Aktivuje \xfasporn\xfd re\u017eim Efficiency v mo\u017enostech Drive Select."},audi_laptimer_boost_display:{name:"\u010casova\u010d kola a p\u0159ekryvn\xfd m\u011b\u0159i\u010d tlaku Turbo Bar (Audi)",desc:"Zobrazuje stopky a ukazatel turbo boostu v re\xe1ln\xe9m \u010dase na Virtual Cockpit."},audi_needle_sweep_gauge:{name:"Ov\u011b\u0159en\xed pohybu jehly sportovn\xedho m\u011b\u0159idla (Audi)",desc:"P\u0159i startu provede pln\xfd test ru\u010di\u010dky tachometru a rychlom\u011bru."},skoda_coming_home_lights:{name:"\u010casova\u010d osv\u011btlen\xed Leaving Home / Coming Home (\u0160koda)",desc:"Konfiguruje \u010dasova\u010d osv\u011btlen\xed sv\u011btlomet\u016f po opu\u0161t\u011bn\xed vozidla."},skoda_comfort_turn_signal:{name:"Nastaven\xed po\u010dtu pulz\u016f indik\xe1toru komfortu (\u0160koda)",desc:"Nastavuje po\u010det bliknut\xed ukazatel\u016f sm\u011bru jedn\xedm dotykem mezi 3 a 5 bliknut\xedmi."},cupra_sport_display_menu:{name:"Nab\xeddka p\u0159\xedstroje Cupra Performance a G-metru (Cupra)",desc:"Odemyk\xe1 m\u011b\u0159i\u010d s\xedly G, m\u011b\u0159idlo v\xfdkonu kW a displej teploty oleje."},cupra_virtual_cockpit_copper:{name:"Zd\u016frazn\u011bn\xe1 grafika palubn\xed desky s motivem m\u011bdi (Cupra)",desc:"Aplikuje na seskupen\xed m\u011b\u0159idel charakteristick\xfd motiv m\u011bd\u011bn\xe9 metal\xedzy Cupra."},vag_brake_disc_drying:{name:"Funkce st\xedr\xe1n\xed / su\u0161en\xed brzdov\xe9ho kotou\u010de v de\u0161ti (VAG)",desc:"Pravideln\u011b aplikuje minim\xe1ln\xed tlak na desti\u010dky ve vlhk\xe9m po\u010das\xed na such\xe9 rotory."},vag_tourist_mode_lights:{name:"Vzor paprsku sv\u011btlometu v turistick\xe9m re\u017eimu (VAG)",desc:"P\u0159ep\xedn\xe1 sm\u011br paprsku sv\u011btlomet\u016f mezi LHD a RHD pro j\xedzdu v zahrani\u010d\xed."},vag_hood_warning_mute:{name:"Ztlumen\xed zvuku n\xe1stroje kapoty (VAG)",desc:"Potla\u010duje trval\xe9 varovn\xe9 zvon\u011bn\xed p\u0159\xedstroje, kdy\u017e je kapota odji\u0161t\u011bna."},vag_emergency_brake_hazard:{name:"Automatick\xe9 v\xfdstra\u017en\xe9 sv\u011btlo pro nouzov\xe9 brzd\u011bn\xed (VAG)",desc:"Rychle blik\xe1 v\xfdstra\u017en\xe1 sv\u011btla b\u011bhem prudk\xe9ho nouzov\xe9ho zastaven\xed ABS."},vag_sunroof_comfort_open:{name:"Logika d\xe1lkov\xe9ho ovl\xe1d\xe1n\xed komfortn\xedho vykl\xe1p\u011bn\xed/otev\u0159en\xed st\u0159e\u0161n\xedho okna (VAG)",desc:"Konfiguruje akci d\xe1lkov\xe9ho dr\u017een\xed kl\xed\u010de na vyklopen\xed nebo \xfapln\xe9 otev\u0159en\xed st\u0159e\u0161n\xedho okna."},bmw_ecopro_display_variant:{name:"ECO PRO Instrument Cluster Gauge Styling (BMW)",desc:"P\u0159izp\u016fsobuje modr\xfd grafick\xfd motiv m\u011b\u0159i\u010de \xfa\u010dinnosti ECO PRO."},bmw_volume_bar_hud:{name:"Head-Up Display P\u0159ekryvn\xe1 li\u0161ta \xfarovn\u011b hlasitosti zvuku (BMW)",desc:"Zobrazuje pruh zm\u011bny hlasitosti p\u0159\xedmo na projekci HUD."},bmw_anti_dazzle_mirror:{name:"Elektrochromick\xe1 citlivost stm\xedv\xe1n\xed zrc\xe1tek proti osln\u011bn\xed (BMW)",desc:"Nastavuje prahovou hodnotu automatick\xe9ho stm\xedv\xe1n\xed fotosenzoru zp\u011btn\xe9ho zrc\xe1tka."},bmw_camera_pdc_warning_mute:{name:"Nastaven\xed mezn\xed rychlosti PDC a Surround View (BMW)",desc:"Upravuje pr\xe1h rychlosti vozidla, p\u0159i kter\xe9m se parkovac\xed kamery vypnou."},toyota_pcs_distance_preset:{name:"V\xfdchoz\xed vzd\xe1lenost v\xfdstrahy p\u0159ed sr\xe1\u017ekou (PCS) (Toyota)",desc:"Nastavuje po\u010d\xe1te\u010dn\xed citlivost radaru na vzd\xe1lenost varov\xe1n\xed p\u0159ed koliz\xed."},toyota_bsm_timing:{name:"Na\u010dasov\xe1n\xed varov\xe1n\xed monitoru mrtv\xe9ho \xfahlu (BSM) (Toyota)",desc:"Nastavuje \u010dasov\xe1n\xed rozsv\xedcen\xed v\xfdstra\u017en\xe9ho sv\u011btla bo\u010dn\xedch zrc\xe1tek v mrtv\xe9m \xfahlu."},toyota_ac_noise_reduction:{name:"Re\u017eim redukce hluku kompresoru klimatizace (Toyota)",desc:"Omezuje maxim\xe1ln\xed ot\xe1\u010dky ventil\xe1toru klimatizace pro zaji\u0161t\u011bn\xed ticha v kabin\u011b."},toyota_sflow_control:{name:"Re\u017eim S-Flow Smart Climate pro jednoho cestuj\xedc\xedho (Toyota)",desc:"Sm\u011bruje proud\u011bn\xed vzduchu klimatizace v\xfdhradn\u011b na obsazen\xe1 sedadla na z\xe1klad\u011b senzor\u016f hmotnosti."},toyota_relock_timeout:{name:"\u010casova\u010d zpo\u017ed\u011bn\xed automatick\xe9ho op\u011btovn\xe9ho uzam\u010den\xed po d\xe1lkov\xe9m odemknut\xed (Toyota)",desc:"Nastavuje sekundy p\u0159ed automatick\xfdm op\u011btovn\xfdm zamknut\xedm dve\u0159\xed, pokud nejsou otev\u0159eny \u017e\xe1dn\xe9 dve\u0159e (30s-120s)."},lexus_mark_levinson_audio_profile:{name:"Mark Levinson Surround Sound DSP Audio Profile (Lexus)",desc:"Optimalizuje 3D prostorov\xe9 akustick\xe9 lad\u011bn\xed pro pr\xe9miov\xe9 reproduktory Mark Levinson."},lexus_ev_mode_beeper_mute:{name:"Ztlumen\xed akustick\xe9ho v\xfdstra\u017en\xe9ho bzu\u010d\xe1ku EV pro n\xedzkorychlostn\xed chodce (Lexus)",desc:"Potla\u010duje n\xedzkorychlostn\xed syntetick\xfd vn\u011bj\u0161\xed zvonek v elektrick\xe9m re\u017eimu."},lexus_easy_access_seat:{name:"Volant se snadn\xfdm p\u0159\xedstupem a elektricky ovl\xe1dan\xe1 posuvn\xe1 op\u011brka sedadel (Lexus)",desc:"Posune op\u011bradlo sedadla \u0159idi\u010de a odklop\xed volant pro snadn\xe9 nastupov\xe1n\xed/vystupov\xe1n\xed."},nissan_epower_regen_mode:{name:"e-POWER Regenerativn\xed brzdov\xfd re\u017eim s jedn\xedm ped\xe1lem (Nissan)",desc:"Nastavuje v\xfdchoz\xed \xfarove\u0148 zpomalen\xed regenerativn\xedho brzd\u011bn\xed e-Pedal."},nissan_propilot_assist_timing:{name:"Citlivost \u0159\xedzen\xed asistenta pro centrov\xe1n\xed j\xedzdn\xedho pruhu ProPILOT (Nissan)",desc:"Konfiguruje ostrost z\xe1sahu \u0159\xedzen\xed ProPILOT."},nissan_intelligent_around_view:{name:"Automatick\xe9 vyskakov\xe1n\xed monitoru p\u0159i n\xedzk\xe9 rychlosti (Nissan)",desc:"Spust\xed 360stup\u0148ov\xe9 zobrazen\xed kamery, kdy\u017e p\u0159edn\xed parkovac\xed senzory detekuj\xed p\u0159ek\xe1\u017eky."},mazda_g_vectoring_display:{name:"G-Vectoring Control Plus Dynamic Visualizer (Mazda)",desc:"Zobrazuje graf vektorov\xe1n\xed to\u010div\xe9ho momentu v zat\xe1\u010dk\xe1ch GVC+ v re\xe1ln\xe9m \u010dase na p\u0159\xedstrojov\xe9 desce."},mazda_ieloop_capacitor_monitor:{name:"M\u011b\u0159i\u010d kondenz\xe1toru rekuperace brzdn\xe9 energie i-ELOOP (Mazda)",desc:"Zobrazuje stav nabit\xed a vybit\xed elektrick\xe9ho kondenz\xe1toru na centr\xe1ln\xed obrazovce."},mazda_smart_city_brake_sens:{name:"Citlivost brzdov\xe9ho asistenta Smart City (SCBS) (Mazda)",desc:"Nastavuje dosah sn\xedma\u010de automatick\xe9ho nouzov\xe9ho brzd\u011bn\xed p\u0159i n\xedzk\xe9 rychlosti."},subaru_eyesight_distance_preset:{name:"V\xfdchoz\xed vzd\xe1lenost adaptivn\xedho tempomatu EyeSight (Subaru)",desc:"Nakonfiguruje v\xfdchoz\xed profil pr\u016fjezdu stereo kamery p\u0159i spu\u0161t\u011bn\xed."},subaru_xmode_auto_engage:{name:"X-Mode Off-Road Traction Auto-Engage Threshold (Subaru)",desc:"Nastavuje pr\xe1h prokluzu kol pro automatickou aktivaci X-Mode s dvojitou funkc\xed."},subaru_steering_responsive_headlights:{name:"P\u0159ep\xedna\u010d sv\u011btlomet\u016f citliv\xfdch na \u0159\xedzen\xed (SRH) (Subaru)",desc:"Povol\xed nebo zak\xe1\u017ee sm\u011brov\xe9 adaptivn\xed nat\xe1\u010den\xed sv\u011btlomet\u016f."},genesis_sport_plus_mode:{name:"Sport+ Powertrain & Electronic Suspension Mode (Genesis)",desc:"Odblokuje ESC OFF orientovan\xfd na tra\u0165 a zpevn\u011bn\xe9 mapov\xe1n\xed tlumi\u010d\u016f."},genesis_ambient_active_light:{name:"Aktivn\xed okoln\xed osv\u011btlen\xed Synchronizace re\u017eimu j\xedzdy (Genesis)",desc:"Dynamicky m\u011bn\xed barvu okoln\xedho osv\u011btlen\xed v z\xe1vislosti na j\xedzdn\xedm re\u017eimu."},volvo_city_safety_warning:{name:"Citlivost autonomn\xedho nouzov\xe9ho varov\xe1n\xed City Safety (Volvo)",desc:"Konfiguruje na\u010dasov\xe1n\xed varov\xe1n\xed p\u0159ed koliz\xed radaru a lidaru (p\u0159ed\u010dasn\xe9/norm\xe1ln\xed)."},chery_ar_navigation_hud:{name:"AR Navigation Projection Overlay na HUD (Chery)",desc:"Prom\xedt\xe1 3D naviga\u010dn\xed \u0161ipky roz\u0161\xed\u0159en\xe9 reality na \u010deln\xed sklo."},jlr_terrain_response_preset:{name:"P\u0159edvolba automatick\xe9ho re\u017eimu ter\xe9nn\xed odezvy (JLR)",desc:"Pamatuje si posledn\xed profil povrchu Terrain Response (tr\xe1va/\u0161t\u011brk/sn\xedh)."},jlr_adaptive_dynamics_firm:{name:"Profil tuhosti tlumi\u010de adaptivn\xed dynamiky (JLR)",desc:"Nastav\xed v\xfdchoz\xed tuhost tlumen\xed elektronick\xe9ho tlumi\u010de."},jlr_wading_sensor_alert:{name:"Prahov\xe1 hodnota varovn\xe9ho zvon\u011bn\xed p\u0159i sn\xedm\xe1n\xed hloubky vlny (JLR)",desc:"Konfiguruje citlivost ultrazvukov\xe9ho upozorn\u011bn\xed na hloubku vody."},alfa_dna_dynamic_memory:{name:"Pam\u011b\u0165 spou\u0161t\u011bn\xed dynamick\xe9ho re\u017eimu Alfa DNA Selector (Alfa Romeo)",desc:"Po restartu si zachov\xe1 odezvu plynu v dynamick\xe9m re\u017eimu."},alfa_q4_torque_split:{name:"Graf rozd\u011blen\xed to\u010div\xe9ho momentu v re\xe1ln\xe9m \u010dase s pohonem v\u0161ech kol Q4 (Alfa Romeo)",desc:"Zobrazuje procento rozd\u011blen\xed v\xfdkonu AWD vp\u0159edu/vzadu na displeji p\u0159\xedstroje."},li_auto_range_extender_mode:{name:"\xdarove\u0148 udr\u017een\xed nabit\xed baterie gener\xe1toru REV (Li Auto)",desc:"Nastavuje prahovou hodnotu startu gener\xe1toru spalovac\xedho motoru."},li_auto_cinema_seat_position:{name:"Re\u017eim Divadlo / Kino Ergonomick\xe1 poloha sedadla (Li Auto)",desc:"Sklon\xed zadn\xed sedadla a rozlo\u017e\xed op\u011brky nohou, kdy\u017e je aktivn\xed re\u017eim kino."},zeekr_drift_mode_torque:{name:"Dvojit\xfd v\xfdkon motoru Drift Mode Rear Bias (Zeekr)",desc:"P\u0159en\xe1\u0161\xed 100 % to\u010div\xe9ho momentu na zadn\xed elektromotor pro kontrolovan\xe9 driftov\xe1n\xed."},zeekr_ambient_beat_sync:{name:"Okoln\xed osv\u011btlen\xed Hudba Rhythm Beat Sync (Zeekr)",desc:"Pulsuje vnit\u0159n\xed osv\u011btlen\xed kabiny v synchronizaci s p\u0159ehr\xe1van\xfdmi rytmy hudby."},tata_drive_mode_voice:{name:"Hlasov\xe9 ozn\xe1men\xed s p\u0159ep\xedna\u010dem re\u017eimu j\xedzdy (Tata)",desc:"Umo\u017e\u0148uje zvukov\xe9 hlasov\xe9 potvrzen\xed p\u0159i p\u0159ep\xedn\xe1n\xed j\xedzdn\xedch re\u017eim\u016f (City/Sport/Eco)."},mahindra_zip_zap_zoom_custom:{name:"Zip/Zap/Zoom Profil odezvy \u0161krtic\xed klapky hnac\xedho \xfastroj\xed (Mahindra)",desc:"P\u0159izp\u016fsobuje k\u0159ivku zrychlen\xed pro j\xedzdn\xed re\u017eimy Zip, Zap a Zoom."},fun_cyberpunk_cluster_theme:{name:"T\xe9ma neonov\xe9 grafick\xe9 kokpitu Cyberpunk 2077",desc:"Aplikuje futuristick\xfd neonov\xfd azurov\xfd a jantarov\xfd digit\xe1ln\xed styl p\u0159\xedstrojov\xe9 desky."},fun_exhaust_flame_sound_effect:{name:"Stereo syst\xe9m Pop & Bang v\xfdfukov\xfd zvuk FX",desc:"P\u0159ehr\xe1v\xe1 realistick\xe9 zvukov\xe9 efekty v\xfdfuku V8, kter\xe9 se objev\xed p\u0159es reproduktory v kabin\u011b."},fun_matrix_light_show_welcome:{name:"Custom Headlight Matrix LED Dance Welcome",desc:"Hraje rytmickou choreografii Light Show pomoc\xed sv\u011btlomet\u016f a indik\xe1tor\u016f."},fun_stealth_fighter_display:{name:"Stealth Fighter No\u010dn\xed j\xedzda Minimalistick\xfd Cluster Mode",desc:"P\u0159i no\u010dn\xed j\xedzd\u011b v temn\xe9 tm\u011b vypne v\u0161echna sv\u011btla sdru\u017een\xe9ho p\u0159\xedstroje krom\u011b rychlom\u011bru."},vag_lap_timer_oil_temp:{name:"Lap Timer & Oil Temperature in Gauge Cluster",desc:"Unlocks racetrack lap timer stopwatch and real-time engine oil temperature readout."},vag_rear_scandinavian_drl:{name:"Scandinavian DRL (Rear Tail Lights ON with DRL)",desc:"Illuminates rear LED tail lights constantly when front daytime running lights are active."},vag_drl_handbrake_off:{name:"Turn OFF DRL when Handbrake is Engaged",desc:"Automatically turns off daytime running lights whenever parking brake is pulled up."},vag_drl_menu_in_mib:{name:"DRL ON/OFF Toggle Switch in Touchscreen Menu",desc:"Adds Daytime Running Lights toggle checkbox under Vehicle Lights settings in MIB screen."},vag_rain_closing_windows:{name:"Rain Closing (Automatic Windows & Sunroof Close)",desc:"Closes all open windows and panoramic sunroof if parked vehicle detects rain on windshield."},vag_audi_dynamic_throttle:{name:"Audi Linear Direct Throttle Response",desc:"Removes electronic pedal lag by switching from time-gradient to direct linear throttle mapping."},vag_xds_differential_sensitivity:{name:"XDS Electronic Differential Lock Sensitivity",desc:"Increases cornering traction and reduces understeer by applying higher inner-wheel brake torque."},vag_offroad_display_mib:{name:"Off-Road Display & Compass in Infotainment",desc:"Unlocks Off-Road telemetry screen displaying steering angle, compass, and oil/coolant temperatures."},vag_highbeam_assist_memory:{name:"High-Beam Assist (Light Assist) State Memory",desc:"Maintains Auto High-Beam Assist active across ignition cycles so driver does not have to re-arm it."},vag_comfort_turn_signals_count:{name:"Comfort Turn Signal Flash Cycles",desc:"Changes number of highway lane-change blinker pulses from standard 3 to 4 or 5."},bmw_video_in_motion_speedlock:{name:"Video in Motion (VIM) Speedlock Removal",desc:"Allows USB and DVD video playback on iDrive screen while vehicle is moving."},bmw_digital_speedo_kombi:{name:"Digital Speedometer in Instrument Cluster (V= km/h)",desc:"Adds real-time digital speed numerical readout on the onboard computer screen."},bmw_acoustic_lock_chirp:{name:"Acoustic Alarm Chirp on Lock / Unlock",desc:"Adds acoustic confirmation chirp via alarm siren with volume setting in iDrive menu."},bmw_auto_mirror_fold_comfort_close:{name:"Fold Mirrors Instantly with 1-Click Lock",desc:"Eliminates the 1.5s delay requirement for folding mirrors when pressing key lock."},bmw_rolls_royce_warning_chimes:{name:"Rolls-Royce / BMW i / MINI Warning Chime Tones",desc:"Changes the system warning chimes (door open, low temp, seatbelt) to luxury Rolls-Royce tones."},bmw_m_performance_boot_animation:{name:"M Performance / Alpina Cluster Boot Logo",desc:"Sets startup logo on digital instrument cluster to M Performance, M2, M3, M5, or Alpina."},bmw_tpms_temperature_display:{name:"Tire Pressure & Temperature Live Display",desc:"Adds real-time individual tire temperature readouts alongside tire pressure on iDrive screen."},bmw_rear_drl_scandinavian:{name:"Rear Tail Lights Active with Daytime Running Lights",desc:"Keeps rear LED neon rings illuminated when daytime running lights are active in position 0/Auto."},bmw_sport_automatic_transmission_2tb:{name:"Sport Automatic Transmission (2TB) & Launch Control",desc:"Unlocks faster shifting times, rev-matching downshifts, and factory Launch Control mode."},merc_needle_sweep_staging:{name:"Instrument Needle Sweep (AMG Staging)",desc:"Sweeps gauge needles to maximum upon turning on the ignition."},merc_highbeam_memory:{name:"High-Beam Assist State Memory",desc:"Remembers the last active state of Adaptive Highbeam Assist across ignition cycles."},merc_acoustic_lock_chirp:{name:"Acoustic Alarm Lock Chirp",desc:"Emits a short acoustic confirmation beep via alarm siren when vehicle is locked."},merc_amg_cluster_menu_unlock:{name:"AMG Performance Cluster Menu & Oil Temp",desc:"Unlocks AMG performance screen displaying engine oil & gearbox temperature, lap timer, and G-meter."},merc_ambient_lighting_64_colors:{name:"64-Color Dynamic Ambient Lighting Unlock",desc:"Expands ambient lighting color palette from standard colors to 64 multi-color dynamic themes in MBUX."},merc_start_stop_last_state_memory:{name:"ECO Start-Stop Last State Memory",desc:"Remembers ECO Start/Stop button status instead of defaulting to ON on every ignition restart."},merc_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Automatically folds side mirrors when locking with key fob and unfolds upon driver door open."},merc_rear_drl_scandinavian:{name:"Rear Tail Lights as Daytime Running Lights (Scandinavian Mode)",desc:"Keeps rear LED tail lamps illuminated together with front DRLs during daytime driving."},merc_seatbelt_warning_chime_mute:{name:"Seatbelt Acoustic Warning Chime Mute",desc:"Disables the continuous chime sound for unbuckled seatbelts (visual warning lamp remains active)."},merc_agility_manual_mode_unlock:{name:"Agility (Sport+) & Manual Transmission Mode",desc:"Enables hidden Agility (A) and True Manual (M) driving transmission profiles in Dynamic Select."},merc_esp_sport_threshold_tuning:{name:"ESP Sport Dynamic Slip Angle Adjustment",desc:"Allows increased wheel slip angle before ESP torque intervention for track driving."},merc_flashing_emergency_brake_light:{name:"Adaptive Emergency Flashing Brake Lights",desc:"Flashes stop lamps at high frequency (5.5 Hz) during hard emergency braking (> 7 m/s\xb2)."},stell_auto_mirror_fold_lock:{name:"Automatic Mirror Folding on Key Lock",desc:"Folds side mirrors automatically upon pressing lock button on key fob."},stell_cornering_fog_lights:{name:"Cornering Fog Light Illumination",desc:"Activates corresponding front fog lamp when turn signal is on or steering angle > 30\xb0 below 40 km/h."},stell_needle_sweep_cluster:{name:"Instrument Needle Sweep (Sport Staging)",desc:"Performs gauge sweep on startup for analog/hybrid instrument clusters."},stell_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Remote Lock",desc:"Gives a short horn tap confirmation when vehicle doors successfully lock."},stell_rear_scandinavian_drl:{name:"Rear Scandinavian DRL Tail Lights",desc:"Illuminates rear tail lamps in conjunction with daytime running lights in Auto/0 mode."},stell_lane_assist_memory_default:{name:"Lane Keeping Assist Last State Memory",desc:"Remembers the last ON/OFF state of Lane Keeping Assist instead of re-activating at every start."},stell_sport_steering_weight_calibration:{name:"Dynamic Electric Power Steering (EPS) Weight Curve",desc:"Increases steering wheel resistance and centering feel for a firmer, sportier feedback."},stell_digital_speedo_unit_toggle:{name:"Digital Speedometer km/h & mph Dual Display",desc:"Shows numeric speed readout in both km/h and mph simultaneously in the center LCD."},ford_apim_ambient_multi_colors:{name:"SYNC 3/4 Multi-Color Ambient Lighting Theme",desc:"Unlocks full 7-color ambient lighting palette slider in SYNC touchscreen interface."},ford_lincoln_auto_fold_mirrors:{name:"Lincoln Style Auto-Fold Mirrors on Lock",desc:"Folds power mirrors when locking vehicle and automatically unfolds upon closing driver door."},ford_bambi_mode_fog_with_highbeam:{name:"Bambi Mode (High Beams + Fog Lights Simultaneous)",desc:"Prevents fog lights from turning off automatically when high beams are activated."},ford_double_honk_disable:{name:"Disable Double Horn Honk on Keyless Exit",desc:"Disables loud double horn honk when driver exits running vehicle with key fob in pocket."},ford_global_windows_remote_open_close:{name:"Global Window Roll Up & Down via Key Fob",desc:"Opens or closes all power windows by holding unlock or lock button on factory key fob."},ford_cluster_digital_tpms_readout:{name:"Individual Tire Pressure (TPMS) Bar/PSI Display",desc:"Displays exact individual tire pressure numerical readouts on the instrument cluster screen."},ford_sync_boot_splash_st_raptor:{name:"SYNC Performance Boot Splash Theme (ST / Raptor / RS)",desc:"Changes SYNC infotainment boot logo animation to Ford Performance / ST / Raptor styling."},renault_rlink_video_in_motion:{name:"Video in Motion (VIM) Playback Unlock",desc:"Allows USB/video playback on R-Link 2 / EasyLink touchscreen while vehicle is in motion."},renault_rs_monitor_telemetry_unlock:{name:"RS Monitor Performance Telemetry App",desc:"Enables Renault Sport Monitor app displaying live turbo boost, torque, oil temp, and G-force meters."},renault_acoustic_lock_chirp:{name:"Acoustic Horn Chirp on Hands-Free Walkaway Lock",desc:"Emits a brief beep when vehicle automatically locks upon walking away with key card."},renault_rear_scandinavian_drl:{name:"Scandinavian Daytime Running Tail Lights",desc:"Keeps rear 3D LED signature tail lamps active simultaneously with front DRL strips."},renault_cornering_fog_lamps:{name:"Static Cornering Fog Light Illumination",desc:"Lights up the relevant front fog light during turning maneuvers below 40 km/h."},renault_seatbelt_buzzer_mute:{name:"Seatbelt Warning Buzzer Sound Mute",desc:"Mutes acoustic beeping for unfastened seatbelts (visual cluster alert remains active)."},hyundai_ev_charge_limit_ui_unlock:{name:"Manual EV AC/DC Charge Limit Setting UI",desc:"Unlocks 50% to 100% target SoC slider controls in infotainment for battery longevity."},hyundai_isg_start_stop_memory:{name:"ISG (Idle Stop & Go) Last State Memory",desc:"Retains the last selected state of the Start-Stop button across vehicle restarts."},hyundai_approach_auto_unlock_distance:{name:"Smart Key Approach Auto-Unlock Sensitivity",desc:"Adjusts proximity radar detection sensitivity for automatic welcome door unlocking."},hyundai_lead_vehicle_departure_alert:{name:"Lead Vehicle Departure Notification Sensitivity",desc:"Enhances front camera sensitivity when alerting that the front vehicle has started moving in traffic."},hyundai_welcome_escort_lighting_timer:{name:"Headlamp Escort / Follow-Me-Home Delay Timer",desc:"Extends headlamp illumination duration from 15s to 30s or 60s after locking vehicle."},byd_battery_preconditioning_manual_toggle:{name:"Blade Battery Manual Pre-Heating / Pre-Conditioning",desc:"Enables manual battery thermal pre-heating before DC fast charging in cold weather."},byd_vess_pedestrian_sound_customization:{name:"VESS Low-Speed Pedestrian Acoustic Warning Themes",desc:"Unlocks alternative synthesized engine / futuristic tone profiles for low-speed pedestrian alert."},byd_ambient_sound_rhythm_sync:{name:"Music Rhythm Pulse Ambient Lighting Sync",desc:"Synchronizes cabin ambient LED brightness and color shifting with music bass rhythm."},chery_auto_window_rain_close:{name:"Automatic Window & Sunroof Rain Closing",desc:"Closes all open windows and panoramic sunroof when rain sensor detects rainfall while parked."},mg_ev_one_pedal_drive_memory:{name:"One-Pedal Driving Mode Retention",desc:"Remembers the last selected regenerative braking intensity (High/One-Pedal) across starts."},porsche_needle_sweep_staging:{name:"Porsche Tachometer Needle Sweep on Start",desc:"Sweeps central analog tachometer needle to redline on ignition power up."},porsche_sport_exhaust_valve_manual_mode:{name:"PSE Sport Exhaust Flaps Permanently Open",desc:"Keeps dual active exhaust valves 100% open across all RPM ranges when PSE button is active."},porsche_rear_spoiler_manual_speed_threshold:{name:"Active Rear Aerodynamic Wing Deployment Speed",desc:"Adjusts automatic rear spoiler deployment speed threshold (80 km/h vs 120 km/h)."},porsche_matrix_highbeam_unlock:{name:"PDLS+ Matrix LED Adaptive Anti-Glare High Beam",desc:"Enables European-spec variable anti-glare high beam light distribution."},porsche_acoustic_chirp_lock:{name:"Acoustic Siren Beep on Central Lock",desc:"Gives a quick chirp confirmation when locking with Porsche smart key."},actros_rsl_fleet_speed_limit:{name:"Road Speed Limiter (Fleet Limit)",desc:"Configures maximum vehicle road speed limiter (RSL) calibration for fleet operation policy."},actros_idle_shutdown_timer:{name:"Automatic Engine Idle Shutdown Timer",desc:"Automatically shuts down engine after specified idle time while stationary with parking brake set."},volvo_pto_engine_rpm_preset:{name:"PTO (Power Take-Off) Engine RPM Preset",desc:"Sets predefined constant engine idle speed when PTO is engaged for hydraulic pump and tipper operation."},volvo_ppc_eco_roll_hysteresis:{name:"I-See / PPC Topographical Speed Tolerance (Eco-Roll)",desc:"Adjusts GPS predictive cruise control speed hysteresis tolerance window for maximum rolling fuel economy."},scania_retarder_jake_brake_aggressiveness:{na