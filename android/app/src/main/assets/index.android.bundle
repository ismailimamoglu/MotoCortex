0430\u0441\u044b\u0432\u0430\u0435\u0442 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438.",tpsReset:"\u0421\u0431\u0440\u043e\u0441 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438 (TPS)",tpsTitle:"\u0410\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u044f \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438 (TPS)",tpsSubtitle:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0430\u044f \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u0442\u043e\u0447\u043a\u0438 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u043d\u0443\u043b\u0435\u0432\u043e\u043c \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u0435.",absBleed:"\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438 \u0438 \u043a\u043b\u0430\u043f\u0430\u043d\u043e\u0432 ABS",absTitle:"\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438 \u0433\u0438\u0434\u0440\u0430\u0432\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0430\u0441\u043e\u0441\u0430 ABS",absSubtitle:"\u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0438\u0442\u043d\u044b\u0435 \u043a\u043b\u0430\u043f\u0430\u043d\u044b ABS, \u0447\u0442\u043e\u0431\u044b \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u043f\u0443\u0437\u044b\u0440\u044c\u043a\u0438 \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u0438\u0437 \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u044b\u0445 \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043b\u0435\u0439.",ecuRejected:"\u042d\u0411\u0423 \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0441\u0431\u0440\u043e\u0441\u0430. \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d."},aiDoctor:{analyzing:"\u0410\u043d\u0430\u043b\u0438\u0437 \u043a\u043e\u0434\u043e\u0432 DTC \u0438 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e AI Doctor...",healthImpact:"\u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u043e\u0446\u0435\u043d\u043a\u0443 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f: {{score}}/100",drivingSafety:"\u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u043e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f",causes:"\u0412\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u044b",recommendedAction:"\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u043e\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435",estimatedCost:"\u041e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u043e\u0447\u043d\u0430\u044f \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430/\u0440\u0435\u043c\u043e\u043d\u0442\u0430",noFaultsTitle:"\u041e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u2014 \u043a\u043e\u0434\u044b \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 \u043d\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u044b",noFaultsSummary:"\u0422\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044f \u042d\u0411\u0423 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0434\u043e\u0432 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439. \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u0430\u0431\u043e\u0447\u0438\u0445 \u043f\u0440\u0435\u0434\u0435\u043b\u043e\u0432.",stepMaintain:"\u0421\u043e\u0431\u043b\u044e\u0434\u0430\u0439\u0442\u0435 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044b \u0437\u0430\u043c\u0435\u043d\u044b \u043c\u0430\u0441\u043b\u0430 \u0438 \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432.",stepCheckVoltage:"\u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0439\u0442\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u043e\u044f \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430.",safeDrive:"\u0411\u0435\u0437\u043e\u043f\u0430\u0441\u0435\u043d \u0434\u043b\u044f \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0439 \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438.",misfireTitle:"\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d \u043f\u0440\u043e\u043f\u0443\u0441\u043a \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0432 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f",misfireSummary:"\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u044b \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0432 \u043e\u0434\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430\u0445. \u041d\u0435\u0441\u0433\u043e\u0440\u0435\u0432\u0448\u0435\u0435 \u0442\u043e\u043f\u043b\u0438\u0432\u043e \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043f\u0430\u0441\u0442\u044c \u0432 \u043a\u0430\u0442\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043a \u043d\u0435\u043e\u0431\u0440\u0430\u0442\u0438\u043c\u043e\u043c\u0443 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044e.",causeSparkPlug:"\u0418\u0437\u043d\u043e\u0448\u0435\u043d\u043d\u0430\u044f \u0438\u043b\u0438 \u0437\u0430\u0433\u0440\u044f\u0437\u043d\u0435\u043d\u043d\u0430\u044f \u0441\u0432\u0435\u0447\u0430 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f",causeIgnitionCoil:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u043a\u0430\u0442\u0443\u0448\u043a\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0438\u043b\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0430",causeFuelInjector:"\u0417\u0430\u0441\u043e\u0440\u0435\u043d\u043d\u0430\u044f \u0438\u043b\u0438 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u0430\u044f \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u0430\u044f \u0444\u043e\u0440\u0441\u0443\u043d\u043a\u0430",stepInspectPlugs:"\u041e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0438 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u0441\u0432\u0435\u0447\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f.",stepSwapCoils:"\u041f\u043e\u043c\u0435\u043d\u044f\u0439\u0442\u0435 \u043c\u0435\u0441\u0442\u0430\u043c\u0438 \u043a\u0430\u0442\u0443\u0448\u043a\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u043c\u0435\u0436\u0434\u0443 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430\u043c\u0438, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438.",stepFuelPressure:"\u0418\u0437\u043c\u0435\u0440\u044c\u0442\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u043e\u0439 \u0440\u0430\u043c\u043f\u0435.",criticalDrive:"\u041d\u0435 \u0435\u0437\u0434\u0438\u0442\u0435 \u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0441 \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0433\u0430\u0437\u043e\u043c. \u041d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435\u0441\u044c \u0432 \u0441\u0435\u0440\u0432\u0438\u0441.",o2Title:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u0446\u0435\u043f\u0438 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430 (O2)",o2Summary:"\u0423\u0445\u0443\u0434\u0448\u0438\u043b\u0430\u0441\u044c \u043e\u0431\u0440\u0430\u0442\u043d\u0430\u044f \u0441\u0432\u044f\u0437\u044c \u0442\u043e\u043f\u043b\u0438\u0432\u043e\u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0439 \u0441\u043c\u0435\u0441\u0438. \u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430 \u043e\u0431\u0435\u0434\u043d\u0435\u043d\u043d\u043e\u0439 \u0438\u043b\u0438 \u043e\u0431\u0435\u0434\u043d\u0435\u043d\u043d\u043e\u0439 \u0441\u043c\u0435\u0441\u0438, \u0447\u0442\u043e \u0441\u043d\u0438\u0436\u0430\u0435\u0442 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u043e\u043f\u043b\u0438\u0432\u0430.",causeO2Heater:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2",causeExhaustLeak:"\u0423\u0442\u0435\u0447\u043a\u0430 \u0432 \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u043e\u043c \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u043e\u0440\u0435 \u043f\u0435\u0440\u0435\u0434 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u043c",causeHarness:"\u041f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0440\u0430\u0437\u044a\u0435\u043c \u0436\u0433\u0443\u0442\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u043e\u0432",stepCheckWiring:"\u041e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0436\u0433\u0443\u0442 \u043f\u0440\u043e\u0432\u043e\u0434\u043e\u0432 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2 \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u043f\u043b\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0438\u0437\u043d\u0430\u0448\u0438\u0432\u0430\u043d\u0438\u044f.",stepCleanSensor:"\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u0435 \u043d\u0430\u043a\u043e\u043d\u0435\u0447\u043d\u0438\u043a \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2 \u0438\u043b\u0438 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u0434\u0430\u0442\u0447\u0438\u043a, \u0435\u0441\u043b\u0438 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438.",warningDrive:"\u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e \u0435\u0445\u0430\u0442\u044c \u0432 \u0440\u0435\u043c\u043e\u043d\u0442\u043d\u0443\u044e \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0443\u044e \u043d\u0430 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438.",genericTitle:"\u0410\u043d\u0430\u043b\u0438\u0437 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0434\u0430 ({{codes}})",genericSummary:"\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u044b \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u043a\u043e\u0434\u044b \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438: {{codes}}. \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u044b.",causeGeneric1:"\u0426\u0435\u043f\u044c \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0432\u043d\u0435 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u043e\u0433\u043e \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f",causeGeneric2:"\u041e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u043e\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0437\u0430\u043c\u044b\u043a\u0430\u043d\u0438\u0435 \u043d\u0430 \u0437\u0435\u043c\u043b\u044e",stepGeneric1:"\u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0437\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0441\u0442\u043e\u043f-\u043a\u0430\u0434\u0440\u0430.",stepGeneric2:"\u0421\u043e\u0442\u0440\u0438\u0442\u0435 \u043a\u043e\u0434\u044b DTC \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0440\u0430\u0437\u044a\u0435\u043c\u043e\u0432 \u0436\u0433\u0443\u0442\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u043e\u0432.",reportTitle:"\u0410\u043d\u0430\u043b\u0438\u0437 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0434\u0430",healthImpactTitle:"\u0412\u041b\u0418\u042f\u041d\u0418\u0415 \u041d\u0410 \u0421\u041e\u0421\u0422\u041e\u042f\u041d\u0418\u0415 \u0414\u0412\u0418\u0413\u0410\u0422\u0415\u041b\u042f",freeTrialBadge:" \u0412\u042b \u0418\u0421\u041f\u041e\u041b\u042c\u0417\u0423\u0415\u0422\u0415 1 \u0411\u0415\u0421\u041f\u041b\u0410\u0422\u041d\u0423\u042e \u0418\u0418-\u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0423",modalTitle:"Modal Title",modalSubtitle:"Modal Subtitle"},dtcRisk:{safeTitle:" \u0411\u0415\u0417\u041e\u041f\u0410\u0421\u041d\u041e \u0414\u041b\u042f \u0415\u0417\u0414\u042b",safeDesc:"\u042d\u0442\u0430 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u043d\u0435 \u0443\u0433\u0440\u043e\u0436\u0430\u0435\u0442 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0441 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e \u0434\u043e \u0430\u0432\u0442\u043e\u0441\u0435\u0440\u0432\u0438\u0441\u0430.",warningTitle:" \u0412\u041d\u0418\u041c\u0410\u041d\u0418\u0415: \u0422\u0420\u0415\u0411\u0423\u0415\u0422\u0421\u042f \u041f\u0420\u041e\u0412\u0415\u0420\u041a\u0410 \u0412 \u0421\u0415\u0420\u0412\u0418\u0421\u0415",warningDesc:"\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u044b\u0439 \u0432\u044b\u0431\u0440\u043e\u0441. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u0435\u0441\u044c \u0432 \u0430\u0432\u0442\u043e\u0441\u0435\u0440\u0432\u0438\u0441 \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0435\u0435 \u0432\u0440\u0435\u043c\u044f.",criticalTitle:" \u041a\u0420\u0418\u0422\u0418\u0427\u041d\u041e: \u041e\u0421\u0422\u0410\u041d\u041e\u0412\u0418\u0422\u0415 \u0414\u0412\u0418\u0416\u0415\u041d\u0418\u0415 / \u0421\u0415\u0420\u0412\u0418\u0421",criticalDesc:"\u041a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0443\u0433\u0440\u043e\u0437\u0430 \u043f\u043e\u043b\u043e\u043c\u043a\u0438! \u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0438\u043b\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u044b. \u041d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435\u0441\u044c."},dtcDetail:{descTitle:"\u041e\u041f\u0418\u0421\u0410\u041d\u0418\u0415 \u041a\u041e\u0414\u0410 \u041d\u0415\u0418\u0421\u041f\u0420\u0410\u0412\u041d\u041e\u0421\u0422\u0418",possibleCausesTitle:"\u0412\u041e\u0417\u041c\u041e\u0416\u041d\u042b\u0415 \u041f\u0420\u0418\u0427\u0418\u041d\u042b \u0418 \u0418\u041d\u0421\u0422\u0420\u0423\u041a\u0426\u0418\u0418 \u041f\u041e \u0420\u0415\u041c\u041e\u041d\u0422\u0423",cause1:"\u041e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u043a\u043e\u0440\u0440\u043e\u0437\u0438\u044f \u0432 \u0446\u0435\u043f\u0438 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0438\u043b\u0438 \u0436\u0433\u0443\u0442\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u043e\u0432.",cause2:"\u041c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u0437\u043d\u043e\u0441 \u0438\u043b\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430",cause3:"\u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f/\u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u0443\u043b\u044c\u0442\u0438\u043c\u0435\u0442\u0440\u0430 \u0438\u043b\u0438 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442.",recommendedAction:"\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435",tsbTitle:"\u0411\u042e\u041b\u041b\u0415\u0422\u0415\u041d\u042c \u0422\u0415\u0425\u041d\u0418\u0427\u0415\u0421\u041a\u041e\u0413\u041e \u041e\u0411\u0421\u041b\u0423\u0416\u0418\u0412\u0410\u041d\u0418\u042f (TSB)",aiDoctorBtn:"\u042d\u041a\u0421\u041f\u0415\u0420\u0422\u041d\u042b\u0419 \u0410\u041d\u0410\u041b\u0418\u0417 AI DOCTOR",backToDetail:"\u041d\u0410\u0417\u0410\u0414 \u041a \u0414\u0415\u0422\u0410\u041b\u042f\u041c \u041e\u0428\u0418\u0411\u041a\u0418"},dtcCategory:{powertrain:"\u0414\u0412\u0418\u0413\u0410\u0422\u0415\u041b\u042c / \u0422\u0420\u0410\u041d\u0421\u041c\u0418\u0421\u0421\u0418\u042f",chassis:"\u0428\u0410\u0421\u0421\u0418 / \u0422\u041e\u0420\u041c\u041e\u0417\u041d\u0410\u042f \u0421\u0418\u0421\u0422\u0415\u041c\u0410",body:"\u041a\u0423\u0417\u041e\u0412\u041d\u0410\u042f \u042d\u041b\u0415\u041a\u0422\u0420\u041e\u041d\u0418\u041a\u0410",network:"\u0421\u0415\u0422\u042c / \u0421\u0418\u0421\u0422\u0415\u041c\u0410 CAN-\u0428\u0418\u041d\u042b"},guidedDiag:{p0102_cause1:"\u0417\u0430\u0433\u0440\u044f\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u044b\u0439 \u0434\u0430\u0442\u0447\u0438\u043a MAF",p0102_cause2:"\u0423\u0442\u0435\u0447\u043a\u0430 \u0432\u043e \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u043c \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u043e\u0440\u0435 / \u0412\u0430\u043a\u0443\u0443\u043c\u043d\u0430\u044f \u0443\u0442\u0435\u0447\u043a\u0430",p0102_cause3:"\u041f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u043a\u0438 \u0438\u043b\u0438 \u043e\u043a\u0438\u0441\u043b\u0435\u043d\u0438\u0435",p0102_action:"\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u0435 \u0434\u0430\u0442\u0447\u0438\u043a MAF \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0435\u043b\u0435\u043c \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432 \u0438\u043b\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043a\u043e\u0440\u043f\u0443\u0441 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0433\u043e \u0444\u0438\u043b\u044c\u0442\u0440\u0430.",p0102_tsb:"TSB-2023-09: \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0437\u0430\u0442\u044f\u0436\u043a\u0443 \u0445\u043e\u043c\u0443\u0442\u043e\u0432 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u043f\u0430\u0442\u0440\u0443\u0431\u043a\u0430 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043c\u0435\u043d\u043e\u0439 MAF.",p0171_cause1:"\u0423\u0442\u0435\u0447\u043a\u0430 \u0432\u0430\u043a\u0443\u0443\u043c\u043d\u043e\u0433\u043e \u0448\u043b\u0430\u043d\u0433\u0430/\u0443\u0442\u0435\u0447\u043a\u0430 \u043d\u0430 \u0432\u043f\u0443\u0441\u043a\u0435",p0171_cause2:"\u0421\u043b\u0430\u0431\u044b\u0439 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u044b\u0439 \u043d\u0430\u0441\u043e\u0441/\u043d\u0438\u0437\u043a\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435",p0171_cause3:"\u0417\u0430\u0433\u0440\u044f\u0437\u043d\u0435\u043d \u0434\u0430\u0442\u0447\u0438\u043a O2 1",p0171_action:"\u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0442\u0435\u0441\u0442 \u043d\u0430 \u0434\u044b\u043c \u0432\u043e \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u043c \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u043e\u0440\u0435 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0434\u043e\u043b\u0433\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0443 \u043f\u043e\u0434\u0430\u0447\u0438 \u0442\u043e\u043f\u043b\u0438\u0432\u0430 (LTFT).",p0171_tsb:"TSB-2022-14: \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043c\u0443 \u043a\u043b\u0430\u043f\u0430\u043d\u0430 PCV \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0440\u0430\u0437\u0440\u044b\u0432\u043e\u0432.",p0420_cause1:"\u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043a\u0430\u0442\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u0430",p0420_cause2:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u043d\u0438\u0436\u043d\u0435\u0433\u043e \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2",p0420_cause3:"\u0423\u0442\u0435\u0447\u043a\u0430 \u0432\u044b\u0445\u043b\u043e\u043f\u043d\u044b\u0445 \u0433\u0430\u0437\u043e\u0432 \u043f\u0435\u0440\u0435\u0434 \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u043e\u043c",p0420_action:"\u0421\u0440\u0430\u0432\u043d\u0438\u0442\u0435 \u0444\u043e\u0440\u043c\u044b \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432 \u0432\u0435\u0440\u0445\u043d\u0435\u0433\u043e \u0438 \u043d\u0438\u0436\u043d\u0435\u0433\u043e \u0434\u0430\u0442\u0447\u0438\u043a\u0430 O2 \u0438\u043b\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043a\u0430\u0442\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u0430.",p0300_cause1:"\u0418\u0437\u043d\u043e\u0448\u0435\u043d\u043d\u0430\u044f \u0441\u0432\u0435\u0447\u0430 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f/\u043a\u0430\u0442\u0443\u0448\u043a\u0430 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f",p0300_cause2:"\u0417\u0430\u0441\u043e\u0440\u0435\u043d\u043d\u0430\u044f \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u0430\u044f \u0444\u043e\u0440\u0441\u0443\u043d\u043a\u0430",p0300_cause3:"\u041d\u0438\u0437\u043a\u0430\u044f \u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u0432 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0430\u0445 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f",p0300_action:"\u041f\u043e\u043c\u0435\u043d\u044f\u0439\u0442\u0435 \u043a\u0430\u0442\u0443\u0448\u043a\u0443 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u043d\u0430 \u0441\u043e\u0441\u0435\u0434\u043d\u0438\u0439 \u0446\u0438\u043b\u0438\u043d\u0434\u0440 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435, \u043d\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0442 \u043b\u0438 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f.",p17bf_cause1:"\u0423\u0442\u0435\u0447\u043a\u0430 \u0432 \u0433\u0438\u0434\u0440\u043e\u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0435 \u043c\u0435\u0445\u0430\u0442\u0440\u043e\u043d\u043d\u043e\u0433\u043e \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f",p17bf_cause2:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u0446\u0435\u043f\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u043f\u0430\u043d\u0430",p17bf_cause3:"\u041d\u0438\u0437\u043a\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438/\u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0438\u044f \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438",p17bf_action:"\u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043c\u0435\u0445\u0430\u0442\u0440\u043e\u043d\u0438\u043a\u0430 DCT \u0438 \u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u043a\u043e\u0440\u043f\u0443\u0441 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430.",p17bf_tsb:"TSB-VAG-DSG: \u0417\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u043a\u043e\u0440\u043f\u0443\u0441 \u043c\u0435\u0445\u0430\u0442\u0440\u043e\u043d\u0438\u043a\u0430 \u0438\u043b\u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u043d\u0443\u044e \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u043d\u0443\u044e \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u0443.",default_cause1:"\u041d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u044c \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u0446\u0435\u043f\u0438/\u043f\u0440\u043e\u0432\u043e\u0434\u043a\u0438 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430",default_cause2:"\u041c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u0437\u043d\u043e\u0441 \u0438\u043b\u0438 \u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0438\u044f \u0434\u0430\u0442\u0447\u0438\u043a\u0430",default_action:"\u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u043f\u0430\u0434\u0435\u043d\u0438\u044f \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u0438 \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u0446\u0435\u043f\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u0443\u043b\u044c\u0442\u0438\u043c\u0435\u0442\u0440\u0430."},ev:{loading:"\u0417\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044f...",back:"\u2190 \u041d\u0430\u0437\u0430\u0434",title:" \u041f\u0430\u043d\u0435\u043b\u044c \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u0435\u0439 \u0438 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u043e\u0432",sohTitle:"\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 (SOH)",socAndPack:"\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0437\u0430\u0440\u044f\u0434\u0430 (SoC): {{soc}}% | \u041d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430: {{voltage}} \u0412",insulationTitle:"\u0418\u0437\u043e\u043b\u044f\u0446\u0438\u044f \u0438 \u0442\u0435\u043f\u043b\u043e\u0432\u0430\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c",insulationResistance:"\u0421\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438",cellDeltaVoltage:"\u0414\u0435\u043b\u044c\u0442\u0430 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u044f\u0447\u0435\u0439\u043a\u0438",maxCellTemp:"\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u044f\u0447\u0435\u0439\u043a\u0438",minCellTemp:"\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u044f\u04