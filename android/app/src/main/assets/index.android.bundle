desc:"Automatically folds side mirrors when lock button is held on key fob."},vag_lap_timer:{name:"Instrument Cluster Lap Timer",desc:"Unlocks track lap timer display tab in instrument cluster screen."},vag_refuel_quantity:{name:"Refuel Quantity Display",desc:"Displays exact volume in liters required for a full fuel refuel."},bmw_start_stop_memory:{name:"Auto Start-Stop Memory Mode",desc:"Remembers last Auto Start-Stop state across vehicle restarts."},bmw_digital_speedometer:{name:"Digital Speedometer Display",desc:"Adds instant digital speed numerical display option to cluster screen."},bmw_sport_displays:{name:"Sport Displays",desc:"Enables live horsepower and torque dynamic dials in iDrive screen."},bmw_acoustic_lock_sound:{name:"Acoustic Lock/Unlock Sound",desc:"Emits alarm system chirps when locking or unlocking the vehicle."},bmw_mirror_fold_delay_zero:{name:"Instant Mirror Folding",desc:"Folds side mirrors instantly upon lock button press without holding delay."},bmw_tpms_tire_temperature:{name:"Tire Pressure & Temperature Display",desc:"Displays real-time tire temperature alongside pressure in TPMS screen."},renault_trip_computer_enable:{name:"On-Board Trip Computer Enable",desc:"Unlocks average fuel consumption and range trip computer displays."},renault_external_temp_display:{name:"External Temperature Display",desc:"Enables ambient outdoor temperature reading in instrument cluster."},renault_automatic_tailgate:{name:"Key Fob Trunk Release",desc:"Fully pops trunk latch mechanism upon holding key fob trunk button."},renault_alarm_chirp:{name:"Alarm Lock Confirmation Chirp",desc:"Sounds horn confirmation chirp upon vehicle door locking."},renault_shift_indicator:{name:"Gear Shift Indicator",desc:"Activates eco-driving shift UP/DOWN arrows in instrument cluster."},ford_double_horn_honk_disable:{name:"Disable Double Horn Honk on Door Close",desc:"Disables double horn honk when closing door with engine running."},ford_auto_door_locking:{name:"Auto Door Locking at 20 km/h",desc:"Automatically locks all doors when vehicle speed exceeds 20 km/h."},ford_tpms_psi_display:{name:"Numerical Tire Pressure Display",desc:"Displays exact numerical PSI/BAR pressure per tire in instrument screen."},ford_sync_climate_screen:{name:"SYNC Screen Climate Controls",desc:"Adds climate control and seat heating touchscreen menu to SYNC display."},stellantis_power_windows_remote:{name:"Key Fob Remote Window Roll Up/Down",desc:"Rolls up or down all power windows when holding lock/unlock buttons."},stellantis_cornering_fogs:{name:"Cornering Fog Lights Enable",desc:"Illuminates cornering fog lamp during low-speed turns."},vag_traffic_sign_recognition:{name:"Traffic Sign Recognition",desc:"Displays camera-detected speed signs in instrument cluster and HUD."},vag_ambient_color_palette_30:{name:"30-Color Ambient Lighting Palette",desc:"Unlocks 30 RGB interior lighting color picker in MIB infotainment menu."},vag_seatbelt_warning_mute:{name:"Seatbelt Chime Deactivation",desc:"Disables unbuckled seatbelt acoustic chime in instrument cluster."},bmw_alpina_cluster_theme:{name:"Alpina Digital Dash Layout",desc:"Applies blue Alpina signature theme to digital instrument cluster."},bmw_video_in_motion:{name:"Video In Motion",desc:"Unlocks USB video playback on iDrive screen while driving."},bmw_sport_plus_mode_unlock:{name:"Sport+ Driving Mode Enable",desc:"Enables Sport+ high-performance dynamic driving mode in DEC selector."},mercedes_amg_menu_unlock:{name:"AMG Performance Telemetry Menu",desc:"Displays AMG oil temp, transmission temp, lap timer, and G-meter."},mercedes_agility_mode_enable:{name:"Agility Transmission Mode",desc:"Unlocks ultra-responsive Agility shift program in 7G/9G-Tronic transmission."},mercedes_drl_brightness_boost:{name:"Daytime Running Lights 100% Intensity",desc:"Increases LED daytime running lights output to 100% full brightness."},mercedes_alarm_lock_chirp:{name:"Acoustic Locking Horn Chirp",desc:"Emits short horn chirp notification when central locking is engaged."},mercedes_dpf_adblue_gauge:{name:"DPF Soot & AdBlue Level Gauge",desc:"Displays exact DPF soot mass percentage and remaining AdBlue range in IC."},renault_rs_monitor_enable:{name:"Renault Sport RS Monitor Telemetry",desc:"Enables live G-force, turbo boost, and oil temp telemetry on R-Link."},renault_duster_mirror_fold:{name:"Duster Auto Mirror Folding on Lock",desc:"Folds side mirrors automatically via BCM central locking command."},ford_bambi_mode_fog_light:{name:"Bambi Mode",desc:"Allows fog lights to remain ON when high beam headlights are activated."},ford_st_rs_boot_animation:{name:"ST/RS Performance SYNC Boot Screen",desc:"Changes SYNC touchscreen startup splash animation to ST / RS logo."},toyota_reverse_beep_mute:{name:"Reverse Gear Continuous Cabin Beep Mute",desc:"Mutes continuous reverse gear chime inside cabin to a single beep."},toyota_remote_window_drop:{name:"Key Fob Remote Window Roll Down",desc:"Rolls down all power windows when holding key fob unlock button."},toyota_auto_lock_shift_p:{name:"Auto Lock Doors on Gear Shift",desc:"Automatically locks all doors when shifting out of Park position."},peugeot_icockpit_theme_unlock:{name:"Peugeot 3D i-Cockpit Performance Theme",desc:"Unlocks Copper and Track Red color display themes on 3D digital cluster."},jeep_offroad_pages_enable:{name:"Jeep Uconnect Off-Road Pages",desc:"Enables pitch/roll angle gauges, wheel articulation, and 4x4 lock status."},hyundai_smart_welcome_mirror:{name:"Smart Key Approach Welcome Mirror Unfold",desc:"Automatically unfolds side mirrors when approaching vehicle with smart key."},hyundai_one_touch_turn_7_flashes:{name:"One-Touch Lane Change Signal",desc:"Sets one-touch lane change blinker duration to 7 flashes."},hyundai_svm_camera_speed_extend:{name:"360\xb0 Surround Camera Speed Extension",desc:"Keeps 360-degree parking camera active up to 20 km/h forward speed."},hyundai_n_performance_exhaust_flap:{name:"N-Performance Exhaust Flap Default OPEN",desc:"Sets active exhaust valve default position to OPEN on engine start."},vag_rain_closing_sunroof:{name:"Rain Closing",desc:"Automatically closes sunroof and windows when rain is detected while parked."},bmw_launch_control_unlock:{name:"Launch Control Unlock",desc:"Unlocks factory launch control acceleration program in transmission ECU."},mercedes_ambient_64_multi_zone:{name:"64-Color Multi-Zone Ambient Profile",desc:"Unlocks dynamic multi-zone color cycle animation in MBUX interior lighting."},ford_trailer_brake_activation:{name:"Trailer Brake Controller Enable",desc:"Enables integrated trailer brake controller menu in instrument cluster."},gm_afm_dfm_cylinder_deactivation_disable:{name:"AFM/DFM V8 Cylinder Lock",desc:"Locks engine in 8-cylinder mode permanently to prevent V4 vibration."},gm_remote_start_time_extend:{name:"Remote Start Duration Extension",desc:"Extends factory key fob remote engine start run time from 10 to 20 minutes."},dodge_srt_performance_pages:{name:"SRT Performance Pages & Drive Modes",desc:"Unlocks Uconnect 0-100 acceleration timers, G-force meter, and launch control."},ram_bambi_mode_fog:{name:"RAM Truck Fog Lights with High Beam",desc:"Allows RAM fog lights to remain active alongside high beam headlights."},byd_avas_pedestrian_siren_mute:{name:"AVAS EV Low-Speed Siren Mute",desc:"Mutes low-speed artificial electric motor siren below 30 km/h."},chery_isa_overspeed_chime_mute:{name:"ISA Overspeed Warning Chime Deactivation",desc:"Disables continuous 80/120 km/h overspeed warning beep on Tiggo/MG models."},mg_ev_battery_preconditioning_toggle:{name:"EV Fast-Charge Battery Pre-Heating Manual Switch",desc:"Enables manual battery pre-heating switch before DC fast charging."},chery_dms_fatigue_camera_mute:{name:"Driver Monitoring Camera Sensitivity Reduction",desc:"Reduces over-sensitive eye-tracking fatigue warnings on steering column."},honda_walk_away_auto_lock:{name:"Walk-Away Auto Door Lock",desc:"Automatically locks all doors when driver steps 2 meters away with key fob."},subaru_avh_auto_hold_memory:{name:"Auto Vehicle Hold Memory Mode",desc:"Remembers AVH brake hold ON/OFF state across ignition cycles."},volvo_start_stop_default_off:{name:"Auto Start-Stop Default OFF Mode",desc:"Sets Start-Stop engine shutoff system default state to OFF upon vehicle start."},volvo_polestar_digital_theme:{name:"Polestar Blue Digital Cluster Theme",desc:"Unlocks Polestar signature blue dynamic gauge theme in Volvo driver display."},vag_virtual_cockpit_r_theme:{name:"Virtual Cockpit R / S / Cupra Performance Themes",desc:"Unlocks R-Line, S-Line, and Cupra central tachometer performance themes in digital cockpit."},vag_sound_symposer_mute:{name:"Sound Symposer Fake Engine Noise Deactivation",desc:"Deactivates cabin speaker fake engine sound generator for pure exhaust note."},vag_wireless_carplay_enable:{name:"Wireless Apple CarPlay & Android Auto Activation",desc:"Enables 5GHz Wi-Fi wireless Apple CarPlay and Android Auto on MIB2.5/MIB3 units."},vag_offroad_telemetry_menu:{name:"MIB Offroad Telemetry & Gauge Display",desc:"Displays steering angle, oil temp, coolant temp, and altitude gauges on MIB screen."},vag_easy_entry_driver_seat:{name:"Automatic Easy Entry Power Seat Back-step",desc:"Moves electric driver seat back 5 cm upon door opening for easy vehicle entry."},vag_hba_memory_state:{name:"High-Beam Assist Memory Retention",desc:"Remembers High-Beam Assist ON status across ignition restart cycles."},vag_battery_soc_display:{name:"Battery State of Charge Display",desc:"Shows exact battery charge percentage on instrument cluster when trip button is held."},bmw_idrive7_m_animation:{name:"iDrive 7 / 8 M-Performance Startup Animation",desc:"Changes iDrive screen boot graphic to M-Performance or M-GmbH logo animation."},bmw_bowers_wilkins_audio_profiles:{name:"Bowers & Wilkins 3D Sound Engine Unlock",desc:"Unlocks Bowers & Wilkins Concert, Studio, and Stage DSP audio profiles on HiFi systems."},bmw_hitch_zoom_camera:{name:"Reverse Camera Trailer Hitch Zoom Mode",desc:"Unlocks top-down trailer hitch alignment zoom mode on reverse camera view."},bmw_secure_idle_protection:{name:"Secure Idle Engine Shift-Lock Protection",desc:"Locks transmission in Park if driver leaves running vehicle with key fob."},bmw_seatbelt_handover_mute:{name:"Coupe Electric Seatbelt Handover Arm Deactivation",desc:"Disables motorized seatbelt extender arm on 4 Series and 2 Series Coupes."},bmw_auto_heat_threshold_5c:{name:"Automatic Seat & Steering Wheel Heating Temperature",desc:"Triggers automatic seat and steering wheel heating when ambient temp drops below 5\xb0C."},mercedes_amg_track_pace_unlock:{name:"MBUX AMG Track Pace Telemetry & Lap Timer",desc:"Unlocks lap timing, acceleration telemetry, and G-force graphs on MBUX screen."},mercedes_drive_mode_last_memory:{name:"Dynamic Select Last Drive Mode Memory",desc:"Remembers last selected Drive Mode across vehicle restart."},mercedes_proximity_360_camera_auto:{name:"Proximity Sensor Auto 360\xb0 Camera View",desc:"Automatically switches screen to 360 camera when front sensors detect obstacle < 50 cm."},ford_sync_climate_screen_unlock:{name:"SYNC3 / SYNC4 Touchscreen Climate Control Page",desc:"Enables climate control, heated seat, and airflow direction touchscreen page."},ford_turn_signal_5_flashes:{name:"One-Touch Lane Change Signal",desc:"Increases one-touch lane change turn signal duration from 3 to 5 flashes."},ford_auto_engine_shutdown_disable:{name:"30-Minute Idle Auto Engine Shutdown Override",desc:"Prevents automatic engine shutoff after 30 minutes idle."},ev_battery_preheat_manual_switch:{name:"EV Battery Pre-Heating Manual Switch",desc:"Allows manual battery pre-heating to 25\xb0C before DC fast charging without navigation route."},ev_v2l_power_output_expand:{name:"V2L 220V Outlet Power Expansion",desc:"Expands V2L external 220V AC household power outlet limit from 2.2 kW to 3.6 kW."},ev_one_pedal_regen_force_level3:{name:"One-Pedal Drive Maximum Regenerative Braking Default",desc:"Sets maximum regenerative braking as default on vehicle start."},byd_soc_max_charge_target_limit:{name:"BYD Battery Health Protection Max Charge Limit",desc:"Sets max AC/DC charge cutoff limit to 80% or 90% to extend Blade Battery lifespan."},byd_dmi_forced_pure_ev_speed_override:{name:"BYD DM-i Pure EV Mode Gasoline Engine Override",desc:"Inhibits gasoline engine start in EV mode up to 130 km/h even during full throttle acceleration."},byd_vtol_v2v_rescue_charge_mode:{name:"BYD VTOL Rescue Charge Mode",desc:"Unlocks external AC power output to charge stranded electric vehicles on road."},hyundai_ipedal_memory_lock:{name:"Hyundai / Kia i-PEDAL One-Pedal Drive Memory Lock",desc:"Prevents i-PEDAL one-pedal stop mode from dropping back to Level 3 after shifting to Reverse."},hyundai_utility_mode_12v_saver:{name:"Utility Camping Mode High-Voltage 12V Saver",desc:"Powers 220V V2L outlet directly from HV traction battery to prevent auxiliary 12V battery drain."},hyundai_phev_no_ice_climate_start:{name:"PHEV EV Mode Climate Heating Gasoline Engine Suppression",desc:"Forces heat pump / PTC electric heater for cabin climate without starting gasoline engine."},vag_taycan_ess_sound_profile_swap:{name:"Electric Sport Sound Taycan / RS e-tron Profile",desc:"Changes electric driving sound profile to Porsche Taycan GTS or Audi RS e-tron GT sound generator."},vag_meb_daily_charge_target_menu:{name:"MEB Battery Daily 80% / Trip 100% Quick Charge Bar",desc:"Adds quick toggle bar on MIB screen to switch between 80% daily battery care and 100% trip charge."},vag_gte_generator_charge_reserve:{name:"GTE / E-Mode Engine Generator Battery Force Charge",desc:"Forces combustion engine to act as generator to recharge high-voltage battery up to 80% while driving."},bmw_hans_zimmer_iconic_sounds_m:{name:"Hans Zimmer IconicSounds Electric M-Performance Sound Engine",desc:"Unlocks Hans Zimmer acoustic M-Performance electric acceleration sound profiles on i4 and iX."},bmw_phev_max_edrive_140kmh:{name:"PHEV MAX eDrive Pure Electric Speed Ceiling",desc:"Increases max pure electric speed ceiling on 330e / 530e Plug-in hybrids to 140 km/h."},bmw_ac_charging_current_limit_menu:{name:"AC Home Charger Maximum Current Limit Selector",desc:"Adds AC home charging current limiter to prevent home circuit overload."},toyota_hybrid_ev_mode_override:{name:"Toyota / Lexus EV Mode Throttle Override Suppression",desc:"Prevents gasoline engine from forced start during acceleration when EV mode button is active."},toyota_hybrid_battery_fan_speed_boost:{name:"Toyota / Lexus High-Voltage Battery Cooling Fan Boost",desc:"Increases hybrid traction battery cooling fan speed by +30% to prevent thermal degradation in hot climates."},tesla_sentry_high_bitrate_video:{name:"Tesla Sentry Mode High-Bitrate Continuous Dashcam Recording",desc:"Increases Sentry Mode camera video recording bitrate for crystal-clear license plate visibility."},tesla_cabin_overheat_threshold_30c:{name:"Tesla Cabin Overheat Protection Temperature Threshold",desc:"Lowers cabin overheat protection climate trigger temperature from 40\xb0C to 30\xb0C for interior preservation."},bmwmotorrad_quickshifter_pro_readapt:{name:"Shift Assistant Pro Re-Adaptation",desc:"Resets shift sensor learning parameters and initiates quickshifter recalibration."},bmwmotorrad_esa_zero_point_calib:{name:"Dynamic ESA Suspension Zero-Point Calibration",desc:"Calibrates electronic suspension load and travel sensors to factory zero."},bmwmotorrad_abs_pro_cornering_toggle:{name:"ABS Pro Cornering Mode Intervention Threshold",desc:"Adjusts lean-angle dependent ABS intervention sensitivity for track use."},bmwmotorrad_service_interval_reset:{name:"Annual & Distance Service Reminder Reset",desc:"Resets instrument cluster service indicator and sets custom interval."},bmwmotorrad_headlight_pro_cornering:{name:"Headlight Pro Adaptive Cornering Light Sensitivity",desc:"Adjusts lean angle threshold for adaptive cornering headlight activation."},bmwmotorrad_keyless_ride_range_extend:{name:"Keyless Ride Fob Detection Range Extension",desc:"Optimizes transponder signal range for keyless ignition sensing."},bmwmotorrad_reverse_assist_sensitivity:{name:"Electric Reverse Assist Motor Sensitivity",desc:"Fine-tunes reverse drive electric starter motor speed and torque limit."},ducati_riding_mode_custom_profile:{name:"Riding Mode Custom Profile Creator",desc:"Unlocks custom combinations for Race, Sport, Touring, and Urban profiles."},ducati_ohlins_suspension_mapping:{name:"\xd6hlins Smart EC 2.0 Semi-Active Suspension Mapping",desc:"Fine-tunes damping curve and stiffness presets for electronic suspension."},ducati_dashboard_lap_timer_gps:{name:"TFT Dashboard Lap Timer & GPS Sector Splits",desc:"Unlocks track lap timer and sector split display on instrument cluster."},ducati_engine_brake_control_ebc:{name:"Engine Brake Control Level Adjustment",desc:"Adjusts rear wheel deceleration torque during hard corner entry braking."},ducati_cruise_control_retrofit_enable:{name:"Cruise Control Retrofit Activation",desc:"Enables ECU software flag for retrofitted electronic cruise control switches."},ducati_exhaust_valve_sound_map:{name:"Exhaust Servo Valve Opening RPM Map",desc:"Adjusts acoustic exhaust valve opening threshold for enhanced exhaust note."},ducati_pit_lane_limiter_config:{name:"Pit Lane Speed Limiter Threshold",desc:"Enables 60 km/h pit lane speed limiter toggle on handlebar switches."},ducati_desmo_service_light_reset:{name:"Oil & Desmo Valve Service Light Reset",desc:"Clears Desmodromic valve service reminder warning on instrument cluster."},ktm_quickshifter_plus_delay_tuning:{name:"Quickshifter+ Shift Cut Time & Delay Fine-Tuning",desc:"Customizes ignition cut duration per gear for seamless up/down shifts."},ktm_rally_offroad_abs_tc_unlock:{name:"Rally / Off-Road ABS & TC Mode Unlock",desc:"Disables rear ABS and unlocks 9-stage slip adjustment in Rally mode."},ktm_my_kt