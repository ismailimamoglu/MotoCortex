b9\u03c3\u03b7\u03c2 AC 220V/3,6kW V2L \u03b3\u03b9\u03b1 \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ad\u03c2 \u03ba\u03ac\u03bc\u03c0\u03b9\u03bd\u03b3\u03ba."},xiaomi_su7_drift_mode_unlock:{name:"Xiaomi SU7 Track Drift Mode & Rear-Torque Bias",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af 100% \u03c0\u03cc\u03bb\u03c9\u03c3\u03b7 \u03c1\u03bf\u03c0\u03ae\u03c2 \u03c0\u03af\u03c3\u03c9 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03ba\u03b1\u03b9 ESC Track Drift Mode."},vag_oil_service_reset:{name:"Oil Change Service Reset (Flexible Interval)",desc:"Resets instrument cluster oil change interval counter to factory 15,000 km / 365 days."},vag_epb_service_mode:{name:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c3\u03ad\u03c1\u03b2\u03b9\u03c2 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03ce\u03bd \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd \u03c3\u03c4\u03ac\u03b8\u03bc\u03b5\u03c5\u03c3\u03b7\u03c2 (EPB).",desc:"\u0391\u03bd\u03b1\u03c3\u03cd\u03c1\u03b5\u03b9 \u03c4\u03b1 \u03c0\u03af\u03c3\u03c9 \u03ad\u03bc\u03b2\u03bf\u03bb\u03b1 \u03b4\u03b1\u03b3\u03ba\u03ac\u03bd\u03b1\u03c2 EPB \u03b3\u03b9\u03b1 \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c0\u03af\u03c3\u03c9 \u03c4\u03b1\u03ba\u03b1\u03ba\u03b9\u03bf\u03cd \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c1\u03cc\u03c4\u03bf\u03c1\u03b1."},bmw_bms_battery_registration:{name:"\u0395\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 Intelligent Battery Sensor (IBS).",desc:"\u039a\u03b1\u03c4\u03b1\u03c7\u03c9\u03c1\u03b5\u03af \u03bd\u03ad\u03b1 \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 12V AGM/\u039c\u03bf\u03bb\u03cd\u03b2\u03b4\u03bf\u03c5-\u03bf\u03be\u03ad\u03bf\u03c2 \u03c3\u03c4\u03b7 \u03b4\u03b9\u03b1\u03c7\u03b5\u03af\u03c1\u03b9\u03c3\u03b7 \u03ba\u03b9\u03b