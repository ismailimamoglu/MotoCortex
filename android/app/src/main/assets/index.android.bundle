},expertise:{historyFound:"HISTORIE VOZU NALEZENA!",historyFoundDesc:"{{count}}z\xe1znamy o tomto vozidle byly vytvo\u0159eny d\u0159\xedve. Historii si m\u016f\u017eete prohl\xe9dnout n\xed\u017ee.",viewHistory:"POD\xcdVEJTE SE NA HISTORII \u203a",manualVin:"\u010c\xcdSLO PODVOZKU",manualVinDesc:"Pokud po\u010d\xedta\u010d vozidla nesd\xedl\xed \u010d\xedslo podvozku automaticky, m\u016f\u017eete ho napsat sem.",vinPlaceholder:"Typ VIN...",startScan:"SPUSTIT EXPERTN\xcd SKENOV\xc1N\xcd",scanning:"SKENOV\xc1N\xcd...",vehicleIdentity:"ID VOZIDLA A NAJET\xc9 KILOMETY",vin:"\u010c\xedslo podvozku",odometer:"P\u016fvodn\xed KM",distSinceCleared:"Chyba vymaz\xe1na",milDist:"Kontrolka motoru Sv\xedt\xed",dtcTitle:"Chybov\xe9 k\xf3dy",dtcClean:"\u017d\xc1DN\xc9 CHYBOV\xc9 K\xd3DY - \u010cIST\xdd",extraActions:"EXTRA TRANSAKCE",garageTitle:"GAR\xc1\u017d A MINUL\xc9 Z\xc1ZNAMY",share:"SD\xcdLET",saveVehicle:"ULO\u017dTE TENTO N\xc1STROJ",noRecords:"Zat\xedm nejsou registrov\xe1na \u017e\xe1dn\xe1 vozidla.",clean:"\u010cISTIT",faults:"SELH\xc1N\xcd",vinRequired:"Vy\u017eaduje se VIN",vinRequiredDesc:"Pro registraci se mus\xed \u010d\xedslo podvozku objevit automaticky nebo b\xfdt zaps\xe1no ru\u010dn\u011b.",missingInfo:"Chyb\u011bj\xedc\xed informace",missingInfoDesc:"Vypl\u0148te pros\xedm pole Zna\u010dka a model.",saved:"Ulo\u017eeno",savedDesc:"Na z\xe1klad\u011b expertizy byla p\u0159istav\u011bna ke gar\xe1\u017ei.",connRequired:"Je vy\u017eadov\xe1no p\u0159ipojen\xed",connRequiredDesc:"Chcete-li zah\xe1jit tento proces, nejprve se p\u0159ipojte k vozidlu.",chronicFaultsTitle:"Statistick\xe9 chronick\xe9 probl\xe9my",chronicFaultsObs:"{{code}} (Observation: {{days}} Unique Days / Total: {{total}} Times)",chronicFaultsPending:"Shroma\u017e\u010fov\xe1n\xed datov\xe9ho fondu / anal\xfdza statistik",notScanned:"Nenaskenov\xe1no",notScannedDesc:"Chcete-li p\u0159e\u010d\xedst diagnostick\xe9 k\xf3dy, stiskn\u011bte tla\u010d\xedtko skenov\xe1n\xed vpravo naho\u0159e.",scanFailed:"Skenov\xe1n\xed se nezda\u0159ilo",errTimeout:"Error: Connection Timeout\nECU not responding, connection slow or disconnected.",errConnectionLost:"Error: Connection Lost\nCommunication with the adapter was lost.",errHardwareFatal:"ERROR: HARDWARE CRITICAL LOCK\nRecovery attempts failed. Please unplug and re-insert the adapter.",errUnableToRead:"Error: Read Error\nECU trouble codes could not be read.",scannedSystems:"SKENOVAN\xc9 SYST\xc9MY",moduleEngine:"\u0158\xeddic\xed jednotka motoru",moduleAbs:"Protiblokovac\xed brzdov\xfd syst\xe9m",moduleTcm:"\u0158\xeddic\xed modul p\u0159evodovky",moduleBcm:"\u0158\xeddic\xed modul karoserie",simSaveBlocked:"Sim Save Blocked",scannedModules:"Scanned Modules"},service:{safetyWarning:"BEZPE\u010cNOSTN\xcd UPOZORN\u011aN\xcd",safetyWarningDesc:"B\u011bhem tohoto procesu: \u2022 Zapalov\xe1n\xed mus\xed b\xfdt zapnuto \u2022 Motor mus\xed b\xfdt VYPNUT\xdd \u2022 Nestartujte vozidlo Chcete pokra\u010dovat?",step1:"Krok 1: Vyma\u017ete chybov\xe9 k\xf3dy",step1Desc:"V\u0161echny ulo\u017een\xe9 chybov\xe9 k\xf3dy a kontrolka Check Engine budou vymaz\xe1ny. Hodnoty korekce paliva budou resetov\xe1ny. Tuto akci nelze vr\xe1tit zp\u011bt!",step2:"Krok 2: Tvrd\xfd reset ECU",step2Desc:"Elektrick\xfd reset bude odesl\xe1n do po\u010d\xedta\u010de motoru. Funguje to jako vyjmut\xed a instalace baterie. V nepodporuj\xedc\xedch ECU je ne\xfa\u010dinn\xfd. Ne\u0161kod\xed to.",clearCodes:"Smazat k\xf3dy",ecuReset:"Vymazat chybov\xe9 k\xf3dy",finish:"P\u0159esko\u010dit",completed:"Dokon\u010deno",completedDesc:"Servisn\xed operace byly \xfasp\u011b\u0161n\u011b dokon\u010deny. Vozidlo m\u016f\u017eete restartovat.",hardResetDesc:"V\u0161echny servisn\xed operace byly \xfasp\u011b\u0161n\u011b dokon\u010deny. \u2022 Chybov\xe9 k\xf3dy byly vymaz\xe1ny \u2022 Resetov\xe1n\xed korekc\xed paliva \u2022 Resetov\xe1n\xed ECU Vozidlo m\u016f\u017eete restartovat."},info:{desc:"Profesion\xe1ln\xed aplikace pro diagnostiku motocykl\u016f a vozidel. Kompatibiln\xed se v\u0161emi vozidly.",upgrade:"Upgradujte na Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"P\u0159edb\u011b\u017en\xfd p\u0159\xedstup",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner je v sou\u010dasn\xe9 dob\u011b ve v\xfdvoji. Proto\u017ee jste na\u0161\xedm prvn\xedm u\u017eivatelem, m\xe1te nyn\xed k dispozici v\u0161echny profesion\xe1ln\xed funkce. Va\u0161e zp\u011btn\xe1 vazba je pro n\xe1s velmi cenn\xe1!",helpGuide:"POMOC A PR\u016eVODCE",language:"Jazyk / Jazyk / Bahasa",support:"CENTRUM PODPORY",supportSubject:"Podpora a zp\u011btn\xe1 vazba Cortex OBD2 Diagnostic Scanner",thanks:"d\u011bkuji!",thanksDesc:"d\u011bkujeme za va\u0161i zp\u011btnou vazbu. M\u016f\u017eete n\xe1m zanechat koment\xe1\u0159 v Obchod\u011b Play.",sections:{live:{title:"\u017dIV\xc9 MONITOROVAC\xcd SENZORY",content:"M\u016f\u017eete okam\u017eit\u011b sledovat ot\xe1\u010dky, rychlost, teplotu motoru, polohu \u0161krtic\xed klapky, nap\u011bt\xed baterie, zat\xed\u017een\xed motoru, teplotu nas\xe1van\xe9ho vzduchu a tlak v potrub\xed. Hodnoty se obnovuj\xed 1-5kr\xe1t za sekundu v z\xe1vislosti na rychlosti va\u0161eho Bluetooth. Prost\u0159ednictv\xedm termin\xe1lu m\u016f\u017eete p\u0159\xedmo zasahovat do vozidla pomoc\xed p\u0159\xedkaz\u016f UDS / OBD."},expertise:{title:"ZKOU\u0160KA A Z\xc1RUKA",content:"Aplikace pou\u017e\xedv\xe1 k detekci chyb k\xf3dy ECU. Zaznamen\xe1v\xe1 se \u010d\xedslo VIN a aktu\xe1ln\xed ujet\xe9 kilometry zaznamenan\xe9 na vozidle. Minul\xe9 chyby jsou nav\xedc ur\u010deny v\xfdpo\u010dtem, jak daleko vozidlo ujelo s kontrolkou Check Engine. V\xfdslednou zpr\xe1vu lze sd\xedlet v prost\u0159ed\xedch PDF a zpr\xe1v."},tests:{title:"ZKOU\u0160KY BATERIE / V\xddKONU",content:"Testov\xe1n\xed baterie m\xe1 3 f\xe1ze: Testy klidu, rozt\xe1\u010den\xed a nab\xedjen\xed p\u0159i ne\u010dinnosti m\u011b\u0159\xed stav baterie/regul\xe1toru. V\xfdkonnostn\xed test m\u011b\u0159\xed hodnoty zrychlen\xed 0-60 a 0-100 km/h s odchylkou 50 ms s vyu\u017eit\xedm okam\u017eit\xfdch \xfadaj\u016f o rychlosti z procesoru va\u0161eho telefonu a va\u0161eho vozidla."},hardware:{title:"HARDWAROV\xc1 KOMPATIBILITA",content:"Doporu\u010duje se ELM327 Bluetooth. N\u011bkter\xe9 pokro\u010dil\xe9 k\xf3dy nemus\xed fungovat na nekvalitn\xedm hardwaru s verz\xed v2.1 CLONE. Nejvy\u0161\u0161\xed rychlost z\xedsk\xe1te s pr\xe9miov\xfdmi adapt\xe9ry, jako jsou vLinker a OBDLink."},warnings:{title:"D\u016eLE\u017dIT\xc1 UPOZORN\u011aN\xcd",content:"\u2022 B\u011bhem procesu maz\xe1n\xed chybov\xe9ho k\xf3du nebo funkce resetov\xe1n\xed ECU mus\xed b\xfdt zapalov\xe1n\xed zapnut\xe9 a motor vypnut\xfd. \u2022 Nepos\xedlejte reset do b\u011b\u017e\xedc\xedho vozidla. \u2022 Ne ka\u017ed\xe9 vozidlo m\u016f\u017ee podporovat v\u0161echny senzory, nepodporovan\xe9 senzory zobraz\xed \u201e--\u201c."},onboarding:{title:"Z\xc1KONN\xc1 OPR\xc1VN\u011aN\xcd A ANONYMN\xcd TELEMETRIE",content:"Za \xfa\u010delem zlep\u0161en\xed kvality aplikace a kompatibility vozidel; Zcela anonymizovan\xe9 parametry motoru a chybov\xe9 k\xf3dy generovan\xe9 b\u011bhem diagnostiky poruch lze analyzovat na na\u0161ich zabezpe\u010den\xfdch serverech. Pokra\u010dov\xe1n\xedm souhlas\xedte s t\u011bmito podm\xednkami anonymn\xed telemetrie. Ke komunikaci s ECU va\u0161eho motocyklu jsou vy\u017eadov\xe1na opr\xe1vn\u011bn\xed Bluetooth a um\xedst\u011bn\xed."},featureCoding:{title:"ODEMKNUT\xcd SKRYT\xc9 FUNKCE A K\xd3DOV\xc1N\xcd UDS",content:"D\xedky na\u0161emu protokolu UDS podle normy ISO 14229 m\u016f\u017eete bezpe\u010dn\u011b p\u0159ep\xednat funkce, jako jsou americk\xe1 parkovac\xed sv\u011btla, jehlov\xe9 zamet\xe1n\xed, z\xe1mek klaksonu, komfortn\xed okna a nastaven\xed DRL pro vozidla VAG, BMW, Renault a Dacia."},multiEcu:{title:"MULTI-ECU SKENOV\xc1N\xcd V\u0160ECH MODUL\u016e",content:"Skenujte a vyma\u017ete chybov\xe9 k\xf3dy mimo ECU motoru \u2013 v\u010detn\u011b ABS, airbag\u016f, automatick\xe9 p\u0159evodovky, sdru\u017een\xe9ho bloku p\u0159\xedstroj\u016f, klimatizace a modul\u016f \u0159\xedzen\xed karos\xe9rie."},advancedDiagnostics:{title:"ADAPTACE DCT, DPF & M\u011a\u0158EN\xcd V\xddKONU HP",content:"\u2022 DCT / DSG Clutch Kiss Point Learning & Adaptation Reset\n\u2022 Zat\xed\u017een\xed DPF sazemi a monitorov\xe1n\xed teploty regenerace v\xfdfukov\xfdch plyn\u016f\n\u2022 Kr\xe1tkodob\xe9/dlouhodob\xe9 korekce paliva v re\xe1ln\xe9m \u010dase a anal\xfdza lambda\n\u2022 Dynamick\xfd graf v\xfdkonu a to\u010div\xe9ho momentu \u017eiv\xe9 telemetrie"},demoMode:{title:"DEMO RE\u017dIM",content:"Otestujte a prozkoumejte aplikaci bez fyzick\xe9ho hardwaru OBD2. Vyzkou\u0161ejte pln\xe9 diagnostick\xe9 funkce CAN-Bus a UDS s realistickou telemetrickou simulac\xed v re\xe1ln\xe9m \u010dase."}},reconfigurePermissions:"Opr\xe1vn\u011bn\xed k op\u011btovn\xe9mu zobrazen\xed a pr\xe1vn\xed podm\xednky",shareWithFriend:"SD\xcdLET S P\u0158\xcdTELEM",shareMessageText:"Objevte chybov\xe9 k\xf3dy ECU vozidla a \u017eivou telemetrii senzor\u016f s Cortex OBD2 Diagnostic Scanner! St\xe1hnout nyn\xed: iOS: https://apps.apple.com/app/id6764052240 Android: https://play.google.com/store/apps/details?id=com.ismail.motocortexv2 Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:"\u2550\u2550\u2550 DIAGNOSTICK\xc1 ZPR\xc1VA CORTEX OBD2U \u2550\u2550\u2550",vehicleIdentity:"ID VOZIDLA",vin:"\u010c\xedslo podvozku",odometer:"Vzd\xe1lenost",milDist:"Kontrolka motoru Sv\xedt\xed",distSinceCleared:"Chyba vymaz\xe1na",dtcCount:"FAULT CODES ({{count}})",sensorData:"\u017dIV\xc9 DATA SENZORU",noData:"Data se nepoda\u0159ilo p\u0159e\u010d\xedst",proApp:"Skenov\xe1no pomoc\xed Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"datum",vinNotFound:"Nezji\u0161t\u011bno",noDtcs:"\u017d\xc1DN\xc9 CHYBOV\xc9 K\xd3DY - \u010cIST\xdd",speed:"rychlost",coolant:"Teplota motoru",throttle:"plynu",engineLoad:"Zat\xed\u017een\xed motoru",intakeAir:"Nas\xe1van\xfd vzduch",manifold:"Rozd\u011blova\u010d",voltage:"Nap\u011bt\xed baterie",shareMessage:"Sledujte stav sv\xe9ho motocyklu z kapsy pomoc\xed diagnostick\xe9 aplikace Motocortex OBD2! Ke sta\u017een\xed: https://cortexobd2.app",subtitle:"Komplexn\xed diagnostika a telemetrick\xe1 kontrola z druh\xe9 ruky",vehicleInfo:"Identifikace vozidla a metadata ECU",healthScore:"Celkov\xe9 zdravotn\xed sk\xf3re ECU",dtcSection:"Diagnostick\xe9 poruchov\xe9 k\xf3dy",telemetrySection:"\u017div\xe1 telemetrie a sn\xedmek senzoru",maintenanceSection:"Historie servisu a \xfadr\u017eby Ak\u0131ll\u0131 Garaj",aiSection:"Anal\xfdza celkov\xe9ho stavu AI Doctor",noFaults:"V pam\u011bti ECU nejsou ulo\u017eeny \u017e\xe1dn\xe9 aktivn\xed nebo historick\xe9 chybov\xe9 k\xf3dy.",noMaintenance:"\u017d\xe1dn\xe9 zaznamenan\xe9 servisn\xed z\xe1znamy v Ak\u0131ll\u0131 Garaj.",disclaimer:"Upozorn\u011bn\xed: Tato zpr\xe1va je generov\xe1na diagnostick\xfdm softwarem MotoCortex. P\u0159ed po\u0159\xedzen\xedm vozidla se doporu\u010duje fyzick\xe1 kontrola certifikovan\xfdm technikem.",shareTitle:"Sd\xedlejte zpr\xe1vu o hodnocen\xed MotoCortex"},battery:{title:"TEST BATERIE A STARTOV\xc1N\xcd",ready:"P\u0159ipraveno k zah\xe1jen\xed testov\xe1n\xed.",restingStatus:"Zapalov\xe1n\xed zapnuto, motor vypnut\xfd... Nap\u011bt\xed baterie se ode\u010d\xedt\xe1...",crankingStatus:"ZA\u010cN\u011aTE HNED!",chargingStatus:"Motor b\u011b\u017e\xed napr\xe1zdno... Na\u010d\xedt\xe1 se nab\xedjec\xed nap\u011bt\xed...",doneStatus:"Testov\xe1n\xed dokon\u010deno!",voltageError:"Nap\u011bt\xed nelze p\u0159e\u010d\xedst. Zkontrolujte p\u0159ipojen\xed.",start:"ZAHAJTE TEST",retry:"OPAKOVAN\xdd TEST",procedure:"ZKU\u0160EBN\xcd POSTUP",steps:{1:"1. Zapalov\xe1n\xed zapnuto, motor vypnut\xfd \u2192 M\u011b\u0159\xed se klidov\xe9 nap\u011bt\xed",2:"2. Kdy\u017e se objev\xed zpr\xe1va \u201eSTART NOW\u201c, nastartujte motor.",3:"3. Nejni\u017e\u0161\xed nap\u011bt\xed zaznamenan\xe9 po dobu 5 sekund",4:"4. Nap\u011bt\xed nab\xedjec\