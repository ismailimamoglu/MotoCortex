vag_american_parking_lights:{name:"\u041f\u0430\u0440\u043a\u0443\u0432\u0430\u043b\u044c\u043d\u0456 \u0432\u043e\u0433\u043d\u0456 \u0432 \u0441\u0442\u0438\u043b\u0456 \u0421\u0428\u0410",desc:"\u041f\u043e\u0441\u0442\u0456\u0439\u043d\u043e \u043f\u0456\u0434\u0441\u0432\u0456\u0447\u0443\u0454 \u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u043f\u043e\u043a\u0430\u0436\u0447\u0438\u043a\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0443 \u0437 20% \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u043d\u044f\u043c \u0456\u0437 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043d\u0438\u043c\u0438 \u0432\u043e\u0433\u043d\u044f\u043c\u0438."},vag_drl_menu_toggle:{name:"\u041f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u043c\u0435\u043d\u044e \u0434\u0435\u043d\u043d\u0438\u0445 \u0445\u043e\u0434\u043e\u0432\u0438\u0445 \u0432\u043e\u0433\u043d\u0456\u0432 (DRL).",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u043f\u0440\u0430\u043f\u043e\u0440\u0435\u0446\u044c DRL ON/OFF \u0443 \u043c\u0435\u043d\u044e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0439\u043d\u043e-\u0440\u043e\u0437\u0432\u0430\u0436\u0430\u043b\u044c\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438."},vag_tear_wiping:{name:"\u041f\u0440\u043e\u0442\u0438\u0440\u0430\u043d\u043d\u044f \u043b\u043e\u0431\u043e\u0432\u043e\u0433\u043e \u0441\u043a\u043b\u0430",desc:"\u0412\u0438\u043a\u043e\u043d\u0443\u0454 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0435 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0435 \u043f\u0440\u043e\u0442\u0438\u0440\u0430\u043d\u043d\u044f \u0447\u0435\u0440\u0435\u0437 5 \u0441\u0435\u043a\u0443\u043d\u0434 \u043f\u0456\u0441\u043b\u044f \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043e\u043c\u0438\u0432\u0430\u0447\u0430 \u0432\u0456\u0442\u0440\u043e\u0432\u043e\u0433\u043e \u0441\u043a\u043b\u0430."},vag_emergency_brake_flashing:{name:"\u0411\u043b\u0438\u043c\u0430\u043d\u043d\u044f \u043d\u0435\u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u0435\u043a\u0441\u0442\u0440\u0435\u043d\u043e\u0433\u043e \u0433\u0430\u043b\u044c\u043c\u0443\u0432\u0430\u043d\u043d\u044f",desc:"\u0428\u0432\u0438\u0434\u043a\u043e \u0431\u043b\u0438\u043c\u0430\u0454 \u0441\u0442\u043e\u043f-\u0441\u0438\u0433\u043d\u0430\u043b\u043e\u043c \u0456 \u043d\u0435\u0431\u0435\u0437\u043f\u0435\u043a\u043e\u044e \u043f\u0456\u0434 \u0447\u0430\u0441 \u0440\u0456\u0437\u043a\u043e\u0433\u043e \u0435\u043a\u0441\u0442\u0440\u0435\u043d\u043e\u0433\u043e \u0433\u0430\u043b\u044c\u043c\u0443\u0432\u0430\u043d\u043d\u044f."},vag_cornering_lights:{name:"\u041f\u0440\u043e\u0442\u0438\u0442\u0443\u043c\u0430\u043d\u043d\u0456 \u0444\u0430\u0440\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0456\u0432",desc:"\u041f\u0456\u0434\u0441\u0432\u0456\u0447\u0443\u0454 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043d\u0438\u0439 \u043f\u0440\u043e\u0442\u0438\u0442\u0443\u043c\u0430\u043d\u043d\u0438\u0439 \u043b\u0456\u0445\u0442\u0430\u0440 \u0437 \u0431\u043e\u043a\u0443 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0443 \u043a\u0435\u0440\u043c\u0430."},vag_comfort_mirror_folding:{name:"\u0411\u0440\u0435\u043b\u043e\u043a Comfort Mirror Folding",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u044e\u0442\u044c\u0441\u044f \u0431\u0456\u0447\u043d\u0456 \u0434\u0437\u0435\u0440\u043a\u0430\u043b\u0430, \u044f\u043a\u0449\u043e \u0443\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u043a\u043d\u043e\u043f\u043a\u0443 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0431\u0440\u0435\u043b\u043e\u043a\u0443."},vag_lap_timer:{name:"\u0422\u0430\u0439\u043c\u0435\u0440 \u043a\u043e\u043b\u0430 \u043f\u0440\u0438\u043b\u0430\u0434\u0456\u0432",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0454 \u0432\u043a\u043b\u0430\u0434\u043a\u0443 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0442\u0430\u0439\u043c\u0435\u0440\u0430 \u043a\u043e\u043b\u0430 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u043e\u0432\u043e\u0457 \u043f\u0430\u043d\u0435\u043b\u0456."},vag_refuel_quantity:{name:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043a\u0456\u043b\u044c\u043a\u043e\u0441\u0442\u0456 \u0437\u0430\u043f\u0440\u0430\u0432\u043a\u0438",desc:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454 \u0442\u043e\u0447\u043d\u0438\u0439 \u043e\u0431'\u0454\u043c \u0432 \u043b\u0456\u0442\u0440\u0430\u0445, \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0438\u0439 \u0434\u043b\u044f \u043f\u043e\u0432\u043d\u043e\u0457 \u0437\u0430\u043f\u0440\u0430\u0432\u043a\u0438 \u043f\u0430\u043b\u0438\u0432\u0430."},bmw_start_stop_memory:{name:"\u0420\u0435\u0436\u0438\u043c \u043f\u0430\u043c'\u044f\u0442\u0456 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443-\u0437\u0443\u043f\u0438\u043d\u043a\u0438",desc:"\u0417\u0430\u043f\u0430\u043c'\u044f\u0442\u043e\u0432\u0443\u0454 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u0441\u0442\u0430\u043d \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443-\u0437\u0443\u043f\u0438\u043d\u043a\u0438 (\u0412\u0418\u041c\u041a./\u0423\u0412\u0406\u041c\u041a.) \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f."},bmw_digital_speedometer:{name:"\u0426\u0438\u0444\u0440\u043e\u0432\u0438\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0441\u043f\u0456\u0434\u043e\u043c\u0435\u0442\u0440\u0430",desc:"\u0414\u043e\u0434\u0430\u0454 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 \u043c\u0438\u0442\u0442\u0454\u0432\u043e\u0433\u043e \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0433\u043e \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0430."},bmw_sport_displays:{name:"\u0421\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u0456 \u0434\u0438\u0441\u043f\u043b\u0435\u0457 (\u0434\u0430\u0442\u0447\u0438\u043a\u0438 HP \u0456 Nm)",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u0434\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u0456 \u0448\u043a\u0430\u043b\u0438 \u043a\u0456\u043d\u0441\u044c\u043a\u0438\u0445 \u0441\u0438\u043b \u0456 \u043a\u0440\u0443\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0443 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 iDrive."},bmw_acoustic_lock_sound:{name:"\u0410\u043a\u0443\u0441\u0442\u0438\u0447\u043d\u0438\u0439 \u0437\u0432\u0443\u043a \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f/\u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f",desc:"\u0412\u0438\u0434\u0430\u0454 \u0441\u0438\u0433\u043d\u0430\u043b\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0441\u0438\u0433\u043d\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u0432\u0456\u0434\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f."},bmw_mirror_fold_delay_zero:{name:"\u041c\u0438\u0442\u0442\u0454\u0432\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u044f \u0434\u0437\u0435\u0440\u043a\u0430\u043b\u0430 (\u0437\u0430\u0442\u0440\u0438\u043c\u043a\u0430 0,0 \u0441)",desc:"\u0411\u0456\u0447\u043d\u0456 \u0434\u0437\u0435\u0440\u043a\u0430\u043b\u0430 \u043c\u0438\u0442\u0442\u0454\u0432\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u044e\u0442\u044c\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u043a\u043d\u043e\u043f\u043a\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u0435\u0437 \u0437\u0430\u0442\u0440\u0438\u043c\u043a\u0438."},bmw_tpms_tire_temperature:{name:"\u0414\u0438\u0441\u043f\u043b\u0435\u0439 \u0442\u0438\u0441\u043a\u0443 \u0442\u0430 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0438 \u0432 \u0448\u0438\u043d\u0430\u0445",desc:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0448\u0438\u043d\u0438 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0430\u0441\u0456 \u0440\u0430\u0437\u043e\u043c \u0456\u0437 \u0442\u0438\u0441\u043a\u043e\u043c \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 TPMS."},renault_trip_computer_enable:{name:"\u0423\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u0431\u043e\u0440\u0442\u043e\u0432\u043e\u0433\u043e \u0431\u043e\u0440\u0442\u043e\u0432\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u2019\u044e\u0442\u0435\u0440\u0430",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0441\u0435\u0440\u0435\u0434\u043d\u044e \u0432\u0438\u0442\u0440\u0430\u0442\u0443 \u043f\u0430\u043b\u0438\u0432\u0430 \u0442\u0430 \u0434\u0456\u0430\u043f\u0430\u0437\u043e\u043d \u0434\u043e\u0440\u043e\u0436\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u2019\u044e\u0442\u0435\u0440\u0430."},renault_external_temp_display:{name:"\u0417\u043e\u0432\u043d\u0456\u0448\u043d\u0456\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0438",desc:"\u0414\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0437\u0447\u0438\u0442\u0443\u0432\u0430\u0442\u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u0456\u0432."},renault_automatic_tailgate:{name:"\u0411\u0440\u0435\u043b\u043e\u043a \u0434\u043b\u044f \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a\u0430",desc:"\u041c\u0435\u0445\u0430\u043d\u0456\u0437\u043c \u0437\u0430\u0441\u0443\u0432\u043a\u0438 \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a\u0430 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u0443\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u0456 \u043a\u043d\u043e\u043f\u043a\u0438 \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a\u0430 \u043d\u0430 \u0431\u0440\u0435\u043b\u043e\u043a\u0443."},renault_alarm_chirp:{name:"\u0421\u0438\u0433\u043d\u0430\u043b \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f",desc:"\u0417\u0432\u0443\u043a\u043e\u0432\u0438\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u0434\u0432\u0435\u0440\u0435\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f."},renault_shift_indicator:{name:"\u0406\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447 (GSI)",desc:"\u0410\u043a\u0442\u0438\u0432\u0443\u0454 \u0441\u0442\u0440\u0456\u043b\u043a\u0438 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u0412\u0413\u041e\u0420\u0423/\u0412\u041d\u0418\u0417 \u0434\u043b\u044f \u0435\u043a\u043e\u043b\u043e\u0433\u0456\u0447\u043d\u043e\u0433\u043e \u0432\u043e\u0434\u0456\u043d\u043d\u044f \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u0456\u0432."},ford_double_horn_honk_disable:{name:"\u0412\u0438\u043c\u043a\u043d\u0456\u0442\u044c \u043f\u043e\u0434\u0432\u0456\u0439\u043d\u0438\u0439 \u0433\u0443\u0434\u043e\u043a \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u043a\u0440\u0438\u0442\u0442\u044f \u0434\u0432\u0435\u0440\u0435\u0439",desc:"\u0412\u0456\u0434\u043a\u043b\u044e\u0447\u0430\u0454 \u043f\u043e\u0434\u0432\u0456\u0439\u043d\u0438\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u0438\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0447\u0438\u043d\u0435\u043d\u043d\u044f \u0434\u0432\u0435\u0440\u0435\u0439 \u0456\u0437 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0438\u043c \u0434\u0432\u0438\u0433\u0443\u043d\u043e\u043c."},ford_auto_door_locking:{name:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u0432\u0435\u0440\u0435\u0439 \u043d\u0430 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 20 \u043a\u043c/\u0433\u043e\u0434",desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0431\u043b\u043e\u043a\u0443\u0454 \u0432\u0441\u0456 \u0434\u0432\u0435\u0440\u0456, \u043a\u043e\u043b\u0438 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454 20 \u043a\u043c/\u0433\u043e\u0434."},ford_tpms_psi_display:{name:"\u0427\u0438\u0441\u043b\u043e\u0432\u0438\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0442\u0438\u0441\u043a\u0443 \u0432 \u0448\u0438\u043d\u0430\u0445",desc:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454 \u0442\u043e\u0447\u043d\u0435 \u0447\u0438\u0441\u043b\u043e\u0432\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0442\u0438\u0441\u043a\u0443 PSI/BAR \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0457 \u0448\u0438\u043d\u0438 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u0443."},ford_sync_climate_screen:{name:"SYNC \u0415\u043a\u0440\u0430\u043d \u043a\u043b\u0456\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e",desc:"\u0414\u043e\u0434\u0430\u0454 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0435 \u043c\u0435\u043d\u044e \u043a\u043b\u0456\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e \u0442\u0430 \u043f\u0456\u0434\u0456\u0433\u0440\u0456\u0432\u0443 \u0441\u0438\u0434\u0456\u043d\u044c \u043d\u0430 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 SYNC."},stellantis_power_windows_remote:{name:"\u0411\u0440\u0435\u043b\u043e\u043a \u0434\u043b\u044f \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0456\u0439\u043d\u043e\u0433\u043e \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0456\u043a\u043d\u043e\u043c \u0432\u0433\u043e\u0440\u0443/\u0432\u043d\u0438\u0437",desc:"\u041f\u0456\u0434\u043d\u0456\u043c\u0430\u0454 \u0430\u0431\u043e \u043e\u043f\u0443\u0441\u043a\u0430\u0454 \u0432\u0441\u0456 \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u043d\u0456 \u0432\u0456\u043a\u043d\u0430, \u0443\u0442\u0440\u0438\u043c\u0443\u044e\u0447\u0438 \u043a\u043d\u043e\u043f\u043a\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f/\u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f."},stellantis_cornering_fogs:{name:"\u0423\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0442\u0438\u0442\u0443\u043c\u0430\u043d\u043d\u0438\u0445 \u0444\u0430\u0440 \u043d\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u0445",desc:"\u041f\u0456\u0434\u0441\u0432\u0456\u0447\u0443\u0454 \u043f\u0440\u043e\u0442\u0438\u0442\u0443\u043c\u0430\u043d\u043d\u0456 \u0444\u0430\u0440\u0438 \u043d\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u0445 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0456\u0432 \u043d\u0430 \u043d\u0438\u0437\u044c\u043a\u0456\u0439 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456."},vag_traffic_sign_recognition:{name:"\u0420\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0434\u043e\u0440\u043e\u0436\u043d\u0456\u0445 \u0437\u043d\u0430\u043a\u0456\u0432 (VZE)",desc:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454 \u0437\u043d\u0430\u043a\u0438 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456, \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0456 \u043a\u0430\u043c\u0435\u0440\u043e\u044e, \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u0456\u0432 \u0456 HUD."},vag_ambient_color_palette_30:{name:"30-\u043a\u043e\u043b\u044c\u043e\u0440\u043e\u0432\u0430 \u043f\u0430\u043b\u0456\u0442\u0440\u0430 \u043d\u0430\u0432\u043a\u043e\u043b\u0438\u0448\u043d\u044c\u043e\u0433\u043e \u043e\u0441\u0432\u0456\u0442\u043b\u0435\u043d\u043d\u044f",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u043a\u043e\u043b\u0456\u0440 \u0432\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u043e\u0441\u0432\u0456\u0442\u043b\u0435\u043d\u043d\u044f 30 RGB \u0432 \u043c\u0435\u043d\u044e \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0439\u043d\u043e-\u0440\u043e\u0437\u0432\u0430\u0436\u0430\u043b\u044c\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 MIB."},vag_seatbelt_warning_mute:{name:"\u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u0441\u0438\u0433\u043d\u0430\u043b\u0443 \u0440\u0435\u043c\u0435\u043d\u044f \u0431\u0435\u0437\u043f\u0435\u043a\u0438",desc:"\u0412\u0438\u043c\u0438\u043a\u0430\u0454 \u0437\u0432\u0443\u043a\u043e\u0432\u0438\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u0432\u0456\u0434\u0441\u0442\u0435\u0431\u043d\u0443\u0442\u0438\u0445 \u0440\u0435\u043c\u0435\u043d\u0456\u0432 \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u0456\u0432."},bmw_alpina_cluster_theme:{name:"\u041a\u043e\u043c\u043f\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0457 \u043f\u0440\u0438\u043b\u0430\u0434\u043e\u0432\u043e\u0457 \u043f\u0430\u043d\u0435\u043b\u0456 Alpina",desc:"\u0417\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454 \u0441\u0438\u043d\u044e \u0444\u0456\u0440\u043c\u043e\u0432\u0443 \u0442\u0435\u043c\u0443 Alpina \u0434\u043e \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0457 \u043f\u0430\u043d\u0435\u043b\u0456 \u043f\u0440\u0438\u043b\u0430\u0434\u0456\u0432."},bmw_video_in_motion:{name:"\u0412\u0456\u0434\u0435\u043e \u0432 \u0440\u0443\u0441\u0456 (VIM)",desc:"\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0454 \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f USB-\u0432\u0456\u0434\u0435\u043e \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 iDrive \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u043e\u0434\u0456\u043d\u043d\u044f."},bmw_sport_plus_mode_unlock:{name:"\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0440\u0435\u0436\u0438\u043c \u0432\u043e\u0434\u0456\u043d\u043d\u044f Sport+",desc:"\u0412\u043c\u0438\u043a\u0430\u0454 \u0432\u0438\u0441\u043e\u043a\u043e\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u0434\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c \u0432\u043e\u0434\u0456\u043d\u043d\u044f Sport+ \u0443 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0456 DEC."},mercedes_amg_menu_unlock:{name:"\u041c\u0435\u043d\u044e AMG Performance Telemetry",desc:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043c\u0430\u0441\u043b\u0430 AMG, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0442\u0440\u0430\u043d\u0441\u043c\u0456\u0441\u0456\u0457, \u0442\u0430\u0439\u043c\u0435\u0440 \u043a\u043e\u043b\u0