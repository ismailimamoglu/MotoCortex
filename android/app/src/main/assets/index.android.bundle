430\u043d\u0456 GDPR \u0456 KVKK",downloadBtn:"\u0417\u0410\u0412\u0410\u041d\u0422\u0410\u0416\u0418\u0422\u0418 \u041c\u041e\u0407 \u0414\u0410\u041d\u0406 (JSON)",purgeBtn:"\u0412\u0418\u0414\u0410\u041b\u0418\u0422\u0418 \u0412\u0421\u0406 \u041c\u041e\u0407 \u0414\u0410\u041d\u0406",exportSuccessTitle:"\u0414\u0430\u043d\u0456 \u0433\u043e\u0442\u043e\u0432\u0456 (GDPR / KVKK)",exportSuccessMsg:"\u0412\u0430\u0448 \u043f\u0430\u043a\u0435\u0442 \u0434\u0430\u043d\u0438\u0445 \u0431\u0443\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043e {{date}}.\n\n\u0417\u043c\u0456\u0441\u0442: \u0427\u0435\u0440\u0433\u0430 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0456\u0457 ({{count}} \u0437\u0430\u043f\u0438\u0441\u0456\u0432), \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438.",exportErrorTitle:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430",exportErrorMsg:"\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043f\u0430\u043a\u0435\u0442 \u0434\u0430\u043d\u0438\u0445.",purgeAlertTitle:" \u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0432\u0441\u0456 \u0434\u0430\u043d\u0456 (\u041f\u0440\u0430\u0432\u043e \u0431\u0443\u0442\u0438 \u0437\u0430\u0431\u0443\u0442\u0438\u043c)",purgeAlertMsg:"\u0423\u0441\u0456 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0456 \u0442\u0430 \u0445\u043c\u0430\u0440\u043d\u0456 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u0445 \u0437\u0430\u0441\u043e\u0431\u0456\u0432 \u0431\u0443\u0434\u0435 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e. \u0426\u044e \u0434\u0456\u044e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438.",cancel:"\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438",confirmDelete:"\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438",purgeDoneTitle:"\u0412\u0438\u043a\u043e\u043d\u0430\u043d\u043e",purgeDoneMsg:"\u0412\u0430\u0448\u0456 \u0434\u0430\u043d\u0456 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438: {{items}}",purgeErrorTitle:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430",purgeErrorMsg:"\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0434\u0430\u043d\u0456."},inspectionReport:{verificationHash:" \u0412\u0415\u0420\u0418\u0424\u0406\u041a\u0410\u0426\u0406\u0419\u041d\u0418\u0419 \u0425\u0415\u0428:"},errorBoundary:{aiDoctor:"\u041b\u0406\u041a\u0410\u0420 \u0428\u0406",cortex:"\u041a\u041e\u0420\u0410",obdScanner:"OBD2 \u0414\u0406\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u0427\u041d\u0418\u0419 \u0421\u041a\u0410\u041d\u0415\u0420",systemRecovery:" \u0412\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0438",unexpectedError:"\u0414\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u043d\u0438\u0439 \u0441\u043a\u0430\u043d\u0435\u0440 Cortex OBD2 \u0432\u0438\u044f\u0432\u0438\u0432 \u043d\u0435\u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043d\u0443 \u043f\u043e\u043c\u0438\u043b\u043a\u0443 \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430. \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043e \u043f\u0440\u043e \u0430\u0432\u0430\u0440\u0456\u044e.",retryApp:"\u041f\u041e\u0412\u0422\u041e\u0420\u0418\u0422\u0418 \u0417\u0410\u042f\u0412\u041a\u0423"},categoryDashboards:{heavyDutyTitle:"\u041a\u041e\u041c\u0415\u0420\u0426\u0406\u0419\u041d\u0410 \u0422\u0415\u041b\u0415\u041c\u0415\u0422\u0420\u0406\u042f \u0414\u041b\u042f \u0412\u0410\u0416\u041a\u0418\u0425 \u041f\u041e\u041c\u041e\u0429\u042c (SAE