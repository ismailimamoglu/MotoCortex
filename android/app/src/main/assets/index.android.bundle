at",ford:"ford",hero:"\u03ae\u03c1\u03c9\u03b1\u03c2",honda_car:"Honda (\u0391\u03c5\u03c4\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03bf)",honda_moto:"Honda (\u039c\u03bf\u03c4\u03bf\u03c3\u03b9\u03ba\u03bb\u03ad\u03c4\u03b1)",hyundai:"hyundai",indian:"\u0399\u03bd\u03b4\u03cc\u03c2",jeep:"\u03c4\u03b6\u03b9\u03c0",kawasaki:"kawasaki",kia:"Kia",ktm:"KTM",kuba:"\u039a\u03bf\u03cd\u03b2\u03b1",kymco:"Kymco",land_rover:"land rover",lexus:"Lexus",mazda:"Mazda",mg:"MG",mondial:"\u03bc\u03bf\u03bd\u03b4\u03b9\u03ac\u03bb",mv_agusta:"MV Augusta",opel:"opel",peugeot_car:"Peugeot (\u0391\u03c5\u03c4\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03bf)",peugeot_moto:"Peugeot (\u039c\u03bf\u03c4\u03bf\u03c3\u03b9\u03ba\u03bb\u03ad\u03c4\u03b1)",porsche:"porsche",rks:"RKS",seat:"\u039a\u03ac\u03b8\u03b9\u03c3\u03bc\u03b1",skoda:"Skoda",suzuki_car:"Suzuki (\u0391\u03c5\u03c4\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03bf)",suzuki_moto:"Suzuki (\u039c\u03bf\u03c4\u03bf\u03c3\u03b9\u03ba\u03bb\u03ad\u03c4\u03b1)",sym:"\u03c3\u03c5\u03bc",tesla:"Tesla",togg:"\u03b5\u03bd\u03b1\u03bb\u03bb\u03b1\u03b3\u03ae",triumph:"\u0398\u03c1\u03af\u03b1\u03bc\u03b2\u03bf\u03c2",tvs:"TVS",vespa:"\u03b2\u03ad\u03c3\u03c0\u03b1",volvo:"volvo",yuki:"yuki",other:"\u0386\u03bb\u03bb\u03bf",alfa_romeo:"Alfa Romeo",aprilia:"Aprilia",aston_martin:"Aston Martin",cfmoto:"CFMoto",chevrolet:"Chevrolet",citroen:"Citro\xebn",ducati:"Ducati",harley:"Harley-Davidson",husqvarna:"Husqvarna",mercedes:"Mercedes-Benz",mitsubishi:"Mitsubishi",nissan:"Nissan",peugeot:"Peugeot",renault:"Renault",subaru:"Subaru",toyota:"Toyota",volkswagen:"Volkswagen",bmw:"BMW / MINI",gm:"GM / Chevrolet / GMC",dodge:"Dodge / RAM / Jeep",byd:"BYD EV",stellantis:"\u03a3\u03c4\u03b5\u03bb\u03bb\u03ac\u03bd\u03c4\u03b7\u03c2 / Fiat"},permissions:{headerSubtitle:"\u03a0\u0399\u039d\u0391\u039a\u0391\u03a3 \u0391\u0394\u0395\u0399\u0391\u03a3",cardTitle:"\u0391\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7 \u03c5\u03bb\u03b9\u03ba\u03bf\u03cd",cardDesc:"\u03a0\u03c1\u03bf\u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf\u03c5 \u03bd\u03b1 \u03b2\u03b5\u03bb\u03c4\u03b9\u03c9\u03b8\u03b5\u03af \u03b7 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03b7\u03c2 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03b7 \u03c3\u03c5\u03bc\u03b2\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2. \u039f\u03b9 \u03b5\u03bd\u03c4\u03b5\u03bb\u03ce\u03c2 \u03b1\u03bd\u03ce\u03bd\u03c5\u03bc\u03b5\u03c2 \u03c0\u03b1\u03c1\u03ac\u03bc\u03b5\u03c4\u03c1\u03bf\u03b9 \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03bf\u03b9 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03af \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd \u03c0\u03bf\u03c5 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd (\u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03ad\u03c7\u03bf\u03c5\u03bd \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03ac \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03ba\u03b1\u03b9 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc \u03c0\u03bb\u03b1\u03b9\u03c3\u03af\u03bf\u03c5) \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03b1\u03bd\u03b1\u03bb\u03c5\u03b8\u03bf\u03cd\u03bd \u03c3\u03c4\u03bf\u03c5\u03c2 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03c2 \u03b4\u03b9\u03b1\u03ba\u03bf\u03bc\u03b9\u03c3\u03c4\u03ad\u03c2 \u03bc\u03b1\u03c2. \u03a3\u03c5\u03bd\u03b5\u03c7\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03c2, \u03c3\u03c5\u03bc\u03c6\u03c9\u03bd\u03b5\u03af\u03c4\u03b5 \u03bc\u03b5 \u03b1\u03c5\u03c4\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03bd\u03ce\u03bd\u03c5\u03bc\u03bf\u03c5\u03c2 \u03cc\u03c1\u03bf\u03c5\u03c2 \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1\u03c2.",btSub:"\u03a7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1\u03b9 \u03bc\u03cc\u03bd\u03bf \u03b3\u03b9\u03b1 \u03c3\u03cd\u03b6\u03b5\u03c5\u03be\u03b7 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1 ELM327/OBD2 \u03ba\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03c1\u03bf\u03ae \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd CAN-bus/K-Line.",locLabel:"\u0386\u03b4\u03b5\u03b9\u03b1 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c3\u03af\u03b1\u03c2",locSub:"\u0395\u03af\u03bd\u03b1\u03b9 \u03c5\u03c0\u03bf\u03c7\u03c1\u03b5\u03c9\u03c4\u03b9\u03ba\u03cc \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03c4\u03b5\u03ba\u03c4\u03bf\u03bd\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 Android \u03bd\u03b1 \u03b2\u03c1\u03af\u03c3\u03ba\u03b5\u03c4\u03b5 \u03ba\u03bf\u03bd\u03c4\u03b9\u03bd\u03ad\u03c2 \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ad\u03c2 Bluetooth \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae\u03c2 \u03ba\u03b1\u03c4\u03b1\u03bd\u03ac\u03bb\u03c9\u03c3\u03b7\u03c2. \u0394\u03b5\u03bd \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03bf\u03cd\u03bc\u03b5 \u03c4\u03b7\u03bd \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03ae \u03c3\u03b1\u03c2.",grantBtn:"\u0395\u03a0\u0399\u03a4\u03a1\u0395\u03a0\u03a4\u0395 \u039a\u0391\u0399 \u03a3\u03a5\u039d\u0395\u03a7\u0399\u03a3\u03a4\u0395",skipBtn:"\u03a0\u03b1\u03c1\u03ac\u03bb\u03b5\u03b9\u03c8\u03b7 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03bf \u03c0\u03b1\u03c1\u03cc\u03bd (\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b5\u03c0\u03af\u03b4\u03b5\u03b9\u03be\u03b7\u03c2)",deniedDesc:"\u039f\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03b5\u03c2 \u03ac\u03b4\u03b5\u03b9\u03b5\u03c2 \u03b1\u03c1\u03bd\u03ae\u03b8\u03b7\u03ba\u03b1\u03bd. \u03a4\u03bf Cortex OBD2 Diagnostic Scanner \u03b5\u03bd\u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03bc\u03b7\u03bd \u03c3\u03b1\u03c1\u03ce\u03c3\u03b5\u03b9 \u03ae \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b4\u03b5\u03b8\u03b5\u03af \u03bc\u03b5 \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ad\u03c2 OBD2 \u03bc\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1.",proceedAnyway:"\u03a3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03c4\u03b5 \u03c0\u03ac\u03bd\u03c4\u03c9\u03c2",openSettings:"\u0391\u03bd\u03bf\u03af\u03be\u03c4\u03b5 \u03c4\u03b9\u03c2 \u03a1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2",btLabel:"Bluetooth (BLE)",langTitle:"\u0395\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2",nextBtn:"\u03a3\u03a5\u039d\u0395\u03a7\u0395\u0399\u0391",langDesc:"\u03a0\u03b1\u03c1\u03b1\u03ba\u03b1\u03bb\u03ce \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c4\u03b9\u03bc\u03ce\u03bc\u03b5\u03bd\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1 \u03c3\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03c3\u03b5\u03c4\u03b5 \u03c4\u03b7\u03bd \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ce\u03bd.",langSelectSub:"\u03a0\u03a5\u039b\u0397 \u0393\u039b\u03a9\u03a3\u03a3\u0391\u03a3",telemetryLabel:"\u0394\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ae \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1 (opt-in)",telemetrySub:"\u039c\u03bf\u03b9\u03c1\u03b1\u03c3\u03c4\u03b5\u03af\u03c4\u03b5 \u03b1\u03bd\u03ce\u03bd\u03c5\u03bc\u03b1 \u03c0\u03c1\u03c9\u03c4\u03cc\u03ba\u03bf\u03bb\u03bb\u03b1 \u03ba\u03b1\u03b9 \u03b1\u03c1\u03c7\u03b5\u03af\u03b1 \u03ba\u03b1\u03c4\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2 \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b2\u03b5\u03bb\u03c4\u03b9\u03ce\u03c3\u03b5\u03c4\u03b5 \u03c4\u03b7 \u03c3\u03c5\u03bc\u03b2\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2.",restartOnboarding:"\u0395\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae\u03c2 \u03c1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7\u03c2 (\u0393\u03bb\u03ce\u03c3\u03c3\u03b1 & \u0394\u03b9\u03ba\u03b1\u03b9\u03ce\u03bc\u03b1\u03c4\u03b1)"},disclaimer:"\u038c\u03bb\u03b1 \u03c4\u03b1 \u03bf\u03bd\u03cc\u03bc\u03b1\u03c4\u03b1 \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03c9\u03bd, \u03c4\u03b1 \u03bb\u03bf\u03b3\u03cc\u03c4\u03c5\u03c0\u03b1 \u03ba\u03b1\u03b9 \u03bf\u03b9 \u03bc\u03ac\u03c1\u03ba\u03b5\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b9\u03b4\u03b9\u03bf\u03ba\u03c4\u03b7\u03c3\u03af\u03b1 \u03c4\u03c9\u03bd \u03b1\u03bd\u03c4\u03af\u03c3\u03c4\u03bf\u03b9\u03c7\u03c9\u03bd \u03ba\u03b1\u03c4\u03cc\u03c7\u03c9\u03bd \u03c4\u03bf\u03c5\u03c2. \u038c\u03bb\u03b1 \u03c4\u03b1 \u03bf\u03bd\u03cc\u03bc\u03b1\u03c4\u03b1 \u03b5\u03c4\u03b1\u03b9\u03c1\u03b5\u03b9\u03ce\u03bd, \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u03c0\u03bf\u03c5 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c0\u03c1\u03bf\u03bf\u03c1\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bc\u03cc\u03bd\u03bf \u03b3\u03b9\u03b1 \u03c3\u03ba\u03bf\u03c0\u03bf\u03cd\u03c2 \u03b1\u03bd\u03b1\u03b3\u03bd\u03ce\u03c1\u03b9\u03c3\u03b7\u03c2. \u0397 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03b1\u03c5\u03c4\u03ce\u03bd \u03c4\u03c9\u03bd \u03bf\u03bd\u03bf\u03bc\u03ac\u03c4\u03c9\u03bd, \u03bb\u03bf\u03b3\u03bf\u03c4\u03cd\u03c0\u03c9\u03bd \u03ba\u03b1\u03b9 \u03b5\u03bc\u03c0\u03bf\u03c1\u03b9\u03ba\u03ce\u03bd \u03c3\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03b4\u03b5\u03bd \u03c3\u03c5\u03bd\u03b5\u03c0\u03ac\u03b3\u03b5\u03c4\u03b1\u03b9 \u03ba\u03b1\u03bc\u03af\u03b1 \u03ad\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7 \u03ae \u03c7\u03bf\u03c1\u03b7\u03b3\u03af\u03b1.",hiddenFeatures:{title:"\u039a\u03a1\u03a5\u03a6\u0395\u03a3 \u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u0399\u0395\u03a3",btnLabel:"\u039e\u0395\u039a\u039b\u0395\u0399\u0394\u03a9\u039c\u0391 \u039a\u03a1\u03a5\u03a6\u03a9\u039d \u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u0399\u03a9\u039d",unsupported:"\u0391\u03c5\u03c4\u03cc\u03c2 \u03bf \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1\u03c2 OBD2 \u03b4\u03b5\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03b5\u03b9 \u03be\u03b5\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03ba\u03c1\u03c5\u03c6\u03ce\u03bd \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b9\u03ce\u03bd.",unsupportedDesc:"\u0391\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03b1\u03c5\u03b8\u03b5\u03bd\u03c4\u03b9\u03ba\u03cc ELM327 v2.1 \u03ae \u03bd\u03b5\u03cc\u03c4\u03b5\u03c1\u03bf. \u039f\u03b9 \u03b1\u03bd\u03c4\u03af\u03b3\u03c1\u03b1\u03c6\u03b5\u03c2 \u03b4\u03b5\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9.",notConnected:"\u03a3\u03c5\u03bd\u03b4\u03b5\u03b8\u03b5\u03af\u03c4\u03b5 \u03c0\u03c1\u03ce\u03c4\u03b1 \u03c3\u03b5 \u03cc\u03c7\u03b7\u03bc\u03b1.",notConnectedDesc:"\u039c\u03b9\u03b1 \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ae OBD2 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03c5\u03bd\u03b4\u03b5\u03b4\u03b5\u03bc\u03ad\u03bd\u03b7.",warning:"\u0391\u03c5\u03c4\u03ad\u03c2 \u03bf\u03b9 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ad\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b5\u03c0\u03b7\u03c1\u03b5\u03ac\u03c3\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03b5\u03b3\u03b3\u03cd\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03cc\u03c2 \u03c3\u03b1\u03c2.",confirmTitle:"\u0391\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03b5\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03af\u03c9\u03c3\u03b7",confirmMsg:"\u0397 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03b1\u03c5\u03c4\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03b5\u03c0\u03b7\u03c1\u03b5\u03ac\u03b6\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 ECU. \u03a3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1;",confirmOk:"\u03a3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1",confirmCancel:"\u0391\u03ba\u03cd\u03c1\u03c9\u03c3\u03b7",categoryLighting:"\u03a6\u03a9\u03a4\u0399\u03a3\u039c\u039f\u03a3",categorySound:"\u0397\u03a7\u039f\u03a3 & \u0395\u0399\u0394\u039f\u03a0\u039f\u0399\u0397\u03a3\u0395\u0399\u03a3",categoryDisplay:"\u03a0\u0399\u039d\u0391\u039a\u0391\u03a3 \u039f\u03a1\u0393\u0391\u039d\u03a9\u039d",categoryDriving:"\u039f\u0394\u0397\u0393\u0397\u03a3\u0397",featureDrl:"\u03a6\u03ce\u03c4\u03b1 \u0397\u03bc\u03ad\u03c1\u03b1\u03c2 (DRL)",featureRearFog:"Override \u03a0\u03af\u03c3\u03c9 \u039f\u03bc\u03af\u03c7\u03bb\u03b7\u03c2",featureDoorChime:"\u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u0389\u03c7\u03bf\u03c5 \u03a0\u03cc\u03c1\u03c4\u03b1\u03c2",featureParkingAlert:"\u0397\u03c7\u03b7\u03c4\u03b9\u03ba\u03ae \u0395\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03a7\u03b5\u03b9\u03c1\u03cc\u03c6\u03c1\u03b5\u03bd\u03bf\u03c5",featureRpmWarning:"\u03a0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u039f\u03c1\u03af\u03bf\u03c5 \u03a3\u03c4\u03c1\u03bf\u03c6\u03ce\u03bd",featureFuelSensitivity:"\u0395\u03c5\u03b1\u03b9\u03c3\u03b8\u03b7\u03c3\u03af\u03b1 \u0394\u03b5\u03af\u03ba\u03c4\u03b7 \u039a\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5",featureStartStop:"Start-Stop \u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf",featureSportMemory:"\u039c\u03bd\u03ae\u03bc\u03b7 \u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03ae\u03c2 \u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2",enabled:"\u0395\u039d\u0395\u03a1\u0393\u039f\u03a0\u039f\u0399\u0397\u039c\u0395\u039d\u039f",disabled:"\u0391\u03a0\u0395\u039d\u0395\u03a1\u0393\u039f\u03a0\u039f\u0399\u0397\u039c\u0395\u039d\u039f",writeSuccess:"\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2.",writeError:"\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2. \u0394\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03c4\u03b5 \u03be\u03b1\u03bd\u03ac.",simulationBanner:"\u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u038a\u0391 \u03a0\u03a1\u039f\u03a3\u039f\u039c\u039f\u038a\u03a9\u03a3\u0397\u03a3 \u2014 \u0397 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae ECU \u03b4\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03ba\u03cc\u03bc\u03b7 \u03b5\u03bd\u03b5\u03c1\u03b3\u03ae",closeBtn:"\u039a\u039b\u0395\u0399\u03a3\u0399\u039c\u039f",unsupportedOk:"OK",disclaimerTitle:"\u0391\u03a0\u039f\u03a0\u039f\u0399\u0397\u03a3\u0397 \u0395\u03a5\u0398\u03a5\u039d\u0397\u03a3",disclaimerFeature:"\u03a7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc",disclaimerBody:"\u0397 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03b1\u03c5\u03c4\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03b5\u03c0\u03b7\u03c1\u03b5\u03ac\u03b6\u03b5\u03b9 \u03ac\u03bc\u03b5\u03c3\u03b1 \u03c4\u03b9\u03c2 \u03b5\u03c1\u03b3\u03bf\u03c3\u03c4\u03b1\u03c3\u03b9\u03b1\u03ba\u03ad\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03cc\u03c2 \u03c3\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03b9\u03ba\u03cc ECU. \u0394\u03b9\u03b1\u03b2\u03ac\u03c3\u03c4\u03b5 \u03c0\u03c1\u03bf\u03c3\u03b5\u03ba\u03c4\u03b9\u03ba\u03ac \u03c4\u03bf\u03c5\u03c2 \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03c4\u03c9 \u03ba\u03b9\u03bd\u03b4\u03cd\u03bd\u03bf\u03c5\u03c2:\n\n\u2022 \u0397 \u03b5\u03c3\u03c6\u03b1\u03bb\u03bc\u03ad\u03bd\u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b1\u03ba\u03c5\u03c1\u03ce\u03c3\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03b3\u03b3\u03cd\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03cc\u03c2 \u03c3\u03b1\u03c2.\n\u2022 \u039f\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ad\u03c2 \u03b5\u03bd\u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03ba\u03b1\u03bb\u03ad\u03c3\u03bf\u03c5\u03bd \u03bc\u03cc\u03bd\u03b9\u03bc\u03b5\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b5\u03c2 \u03ae \u03b1\u03c0\u03c1\u03bf\u03c3\u03b4\u03cc\u03ba\u03b7\u03c4\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03b1.\n\u2022 \u0395\u03bd\u03ce \u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03bd\u03b1\u03c3\u03c4\u03c1\u03ad\u03c8\u03b9\u03bc\u03b7, \u03bf\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03b5\u03c2 \u03bc\u03bf\u03bd\u03ac\u03b4\u03b5\u03c2 ECU \u03b5\u03bd\u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03b1\u03c0\u03b1\u03b9\u03c4\u03bf\u03cd\u03bd \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03b5\u03c1\u03b3\u03bf\u03c3\u03c4\u03b1\u03c3\u03b9\u03b1\u03ba\u03ce\u03bd \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03c9\u03bd.\n\u2022 \u039f \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c0\u03bf\u03ba\u03bb\u03b5\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03c5\u03c0\u03b5\u03cd\u03b8\u03c5\u03bd\u03bf\u03c2 \u03b3\u03b9\u03b1 \u03bf\u03c0\u03bf\u03b9\u03b1\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03c5\u03bb\u03b9\u03ba\u03ae \u03ae \u03ac\u03c5\u03bb\u03b7 \u03b6\u03b7\u03bc\u03af\u03b1 \u03c0\u03c1\u03bf\u03ba\u03cd\u03c8\u03b5\u03b9 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03b1\u03c5\u03c4\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2.\n\u2022 \u03a4\u03bf Cortex OBD2 Diagnostic Scanner \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b8\u03b5\u03c9\u03c1\u03b7\u03b8\u03b5\u03af \u03c5\u03c0\u03b5\u03cd\u03b8\u03c5\u03bd\u03bf \u03b3\u03b9\u03b1 \u03bf\u03c0\u03bf\u03b9\u03b1\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03b4\u03c5\u03c3\u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ae \u03b6\u03b7\u03bc\u03b9\u03ac \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03ba\u03b1\u03bb\u03b5\u03af\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c4\u03b9\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ad\u03c2.\n\n\u03a0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03b9\u03ce\u03c3\u03b5\u03c4\u03b5 \u03cc\u03c4\u03b9 \u03ad\u03c7\u03b5\u03c4\u03b5 \u03b4\u03b9\u03b1\u03b2\u03ac\u03c3\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03b1\u03bd\u03bf\u03ae\u03c3\u03b5\u03b9 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7.",checkboxTitle:"\u0391\u03a0\u0391\u0399\u03a4\u0395\u0399\u03a4\u0391\u0399 \u0395\u03a0\u0399\u0392\u0395\u0392\u0391\u0399\u03a9\u03a3\u0397",check1:"\u0388\u03c7\u03c9 \u03b4\u03b9\u03b1\u03b2\u03ac\u03c3\u03b5\u03b9 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03b1\u03bd\u03bf\u03ce \u03cc\u03c4\u03b9 \u03b5\u03bd\u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03b5\u03c0\u03b7\u03c1\u03b5\u03b1\u03c3\u03c4\u03b5\u03af \u03b7 \u03b5\u03b3\u03b3\u03cd\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03cc\u03c2 \u03bc\u03bf\u03c5.",check2:"\u0391\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03af\u03b6\u03c9 \u03cc\u03c4\u03b9 \u03c4\u03bf Cortex OBD2 Diagnostic Scanner \u03b4\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03c5\u03c0\u03b5\u03cd\u03b8\u03c5\u03bd\u03bf \u03b3\u03b9\u03b1 \u03c4\u03c5\u03c7\u03cc\u03bd \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03b1 \u03ae \u03b6\u03b7\u03bc\u03b9\u03ad\u03c2 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03ba\u03cd\u03c0\u03c4\u03bf\u03c5\u03bd \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1.",check3:"\u0398\u03ad\u03bb\u03c9 \u03bd\u03b1 \u03ba\u03ac\u03bd\u03c9 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03b5\u03bd \u03b3\u03bd\u03ce\u03c3\u03b5\u03b9 \u03bc\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03bc\u03b5 \u03c4\u03b7 \u03b4\u03b9\u03ba\u03ae \u03bc\u03bf\u03c5 \u03b5\u03bb\u03b5\u03cd\u03b8\u03b5\u03c1\u03b7 \u03b2\u03bf\u03cd\u03bb\u03b7\u03c3\u03b7, \u03b1\u03c0\u03bf\u03b4\u03b5\u03c7\u03cc\u03bc\u03b5\u03bd\u03bf\u03c2 \u03cc\u03bb\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b9\u03bd\u03b4\u03cd\u03bd\u03bf\u03c5\u03c2.",disclaimerCancel:"\u0391\u039a\u03a5\u03a1\u03a9\u03a3\u0397",disclaimerContinue:"\u03a3\u03a5\u039d\u0395\u03a7\u0399\u03a3\u03a4\u0395",unsupportedTitle:"\u039c\u03b7 \u03a5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03b9\u03b6\u03cc\u03bc\u03b5\u03bd\u03bf \u038c\u03c7\u03b7\u03bc\u03b1",unsupportedMsg:"\u0391\u03c5\u03c4\u03ae \u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03b4\u03b5\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03bf ECU \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03cc\u03c2 \u03c3\u03b1\u03c2."},disconnectShort:"\u0391\u03a0\u039f\u03a3.",obdTerminal:{title:"\u039e\u0395\u039a\u039b\u0395\u0399\u0394\u03a9\u039c\u0391 \u039a\u03a1\u03a5\u03a6\u03a9\u039d \u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u0399\u03a9\u039d & UDS",terminalTitle:"\u03a4\u0395\u03a1\u039c\u0391\u03a4\u0399\u039a\u039f OBD",terminalPlaceholder:"\u03a0\u03bb\u03b7\u03ba\u03c4\u03c1\u03bf\u03bb\u03bf\u03b3\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03c4\u03c9 \u03b5\u03bd\u03c4\u03bf\u03bb\u03ae \u03b3\u03b9\u03b1 \u03b1\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae \u03c3\u03b5 ECU (\u03c0.\u03c7. 010C, ATRV)",inputPlaceholder:"\u0395\u03b9\u03c3\u03b1\u03b3\u03ac\u03b3\u03b5\u03c4\u03b5 \u03b5\u03bd\u03c4\u03bf\u03bb\u03ae...",sendButton:"\u0391\u03a0\u039f\u03a3\u03a4\u039f\u039b\u0397",statsTitle:"\u03a3\u03a4\u0391\u03a4\u0399\u03a3\u03a4\u0399\u039a\u0395\u03a3 \u03a5\u0393\u0395\u0399\u0391\u03a3 OBD",connectionProtocol:"\u03a0\u03c1\u03c9\u03c4\u03cc\u03ba\u03bf\u03bb\u03bb\u03bf \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7\u03c2:",none:"\u039a\u03b1\u03bd\u03ad\u03bd\u03b1",hardwareQualityScore:"\u0392\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c5\u03bb\u03b9\u03ba\u03bf\u03cd:",original:"\u03a0\u03c1\u03c9\u03c4\u03cc\u03c4\u03c5\u03c0\u03bf",clone:"\u039a\u03bb\u03ce\u03bd\u03bf\u03c2",requestResponseCount:"\u03a0\u03bb\u03ae\u03b8\u03bf\u03c2 \u03b1\u03b9\u03c4\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd / \u03b1\u03c0\u03b1\u03bd\u03c4\u03ae\u03c3\u03b5\u03c9\u03bd:",timeoutCount:"\u039c\u03ad\u03c4\u03c1\u03b7\u03c3\u03b7 \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03bf\u03cd \u03bf\u03c1\u03af\u03bf\u03c5:",recoveryCount:"\u03a0\u03bb\u03ae\u03b8\u03bf\u03c2 \u03b1\u03bd\u03ac\u03ba\u03c4\u03b7\u03c3\u03b7\u03c2 (\u0391\u03bd\u03ac\u03ba\u03c4\u03b7\u03c3\u03b7):",diagnosticLogTitle:"\u0394\u0399\u0391\u0393\u039d\u03a9\u03a3\u03a4\u0399\u039a\u039f \u0397\u039c\u0395\u03a1\u039f\u039b\u039f\u0393\u0399\u039f",clearButton:"\u039a\u0391\u0398\u0391\u03a1\u0399\u03a3\u03a4\u039f",shareButton:"\u039c\u039f\u0399\u03a1\u0391\u03a3\u03a4\u0395\u0399\u03a4\u0395",noLogs:"\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1\u03bd \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac \u03b1\u03c1\u03c7\u03b5\u03af\u03b1 \u03ba\u03b1\u03c4\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2.",noShareSupport:"\u039f\u03b9 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 \u03ba\u03bf\u03b9\u03bd\u03ae\u03c2 \u03c7\u03c1\u03ae\u03c3\u03b7\u03c2 \u03b4\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b5\u03c2 \u03c3\u03b5 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7 \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ae."},dtcContext:{powertrain:"\u0391\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b5\u03c0\u03b7\u03c1\u03b5\u03ac\u03c3\u03b5\u03b9 \u03c4\u03b7\u03bd \u03bf\u03b9\u03ba\u03bf\u03bd\u03bf\u03bc\u03af\u03b1 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1. \u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c0\u03bb\u03ae\u03c1\u03b7 \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u2192",cooling:"\u0395\u03bd\u03c4\u03bf\u03c0\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03ba\u03c1\u03af\u03c3\u03b9\u03bc\u03bf\u03c2 \u03ba\u03af\u03bd\u03b4\u03c5\u03bd\u03bf\u03c2 \u03c8\u03cd\u03be\u03b7\u03c2. \u0394\u03b5\u03af\u03c4\u03b5 \u03b1\u03bd\u03b1\u03bb\u03c5\u03c4\u03b9\u03ba\u03ac \u03b2\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c5\u03ae\u03c2 \u2192",ignition:"\u0395\u03bd\u03c4\u03bf\u03c0\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b7\u03bc\u03b1 \u03bc\u03b5 \u03c4\u03bf \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2. \u0394\u03b5\u03af\u03c4\u03b5 \u03b1\u03bd\u03b1\u03bb\u03c5\u03c4\u03b9\u03ba\u03ac \u03b2\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c5\u03ae\u03c2 \u2192",chassis:"\u0395\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03c3\u03c6\u03b1\u03bb\u03b5\u03af\u03b1\u03c2 \u03c0\u03bb\u03b1\u03b9\u03c3\u03af\u03bf\u03c5. \u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03c3\u03c4\u03b5 \u03c4\u03bf PRO \u03b3\u03b9\u03b1 \u03c0\u03bb\u03ae\u03c1\u03b7 \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u2192",body:"\u0392\u03c1\u03ad\u03b8\u03b7\u03ba\u03b5 \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03ce\u03bd \u03b1\u03bc\u03b1\u03be\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2. \u0391\u03bd\u03b1\u03b2\u03ac\u03b8\u03bc\u03b9\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03c0\u03bb\u03ae\u03c1\u03b7 \u03b4\u03b9\u03b1\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac \u2192",network:"\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03b4\u03b9\u03ba\u03c4\u03cd\u03bf\u03c5 \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1\u03c2. \u03a4\u03bf PRO \u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03bb\u03ae\u03c1\u03b7 \u03b1\u03bd\u03c4\u03b9\u03bc\u03b5\u03c4\u03ce\u03c0\u03b9\u03c3\u03b7 \u03c0\u03c1\u03bf\u03b2\u03bb\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u2192",fallback:"\u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03c3\u03c4\u03b5 \u03bb\u03b5\u03c0\u03c4\u03bf\u03bc\u03b5\u03c1\u03ae \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd, \u03ba\u03cc\u03c3\u03c4\u03bf\u03c2 \u03b5\u03c0\u03b9\u03c3\u03ba\u03b5\u03c5\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03ba\u03c4\u03af\u03bc\u03b7\u03c3\u03b7 \u03ba\u03b9\u03bd\u03b4\u03cd\u03bd\u03bf\u03c5 \u2192"},perfTeaser:{limitTitle:"\u03a3\u03c5\u03bc\u03c0\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03c4\u03bf \u03b7\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf \u03cc\u03c1\u03b9\u03bf",limitDesc:"\u0388\u03c7\u03b5\u03c4\u03b5 \u03c6\u03c4\u03ac\u03c3\u03b5\u03b9 \u03c4\u03bf \u03b7\u03bc\u03b5\u03c1\u03ae\u03c3\u03b9\u03bf \u03cc\u03c1\u03b9\u03bf \u03c4\u03c9\u03bd 3 \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03b4\u03bf\u03ba\u03b9\u03bc\u03ce\u03bd 0-60 km/h. \u0391\u03bd\u03b1\u03b2\u03ac\u03b8\u03bc\u03b9\u03c3\u03b7 \u03c3\u03b5 PRO \u03b3\u03b9\u03b1 \u03b1\u03c0\u03b5\u03c1\u03b9\u03cc\u03c1\u03b9\u03c3\u03c4\u03b5\u03c2 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03c1\u03ae\u03c3\u03b5\u03b9\u03c2 0-100 km/h."},sandbox:{title:"\u039e\u0395\u039a\u039b\u0395\u0399\u0394\u03a9\u039c\u0391 \u039a\u03a1\u03a5\u03a6\u03a9\u039d \u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u0399\u03a9\u039d & UDS",connectionStatus:"\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7\u03c2:",ecuStatus:"\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 ECU:",fps:"\u0391\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03b4\u03b9\u03b5\u03c0\u03b1\u03c6\u03ae\u03c2 \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7: {{fps}} FPS",stressBtnStart:"\u03a3\u03c4\u03c1\u03b5\u03c2 \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7\u03c2 20 Hz",stressBtnStop:"\u0394\u03b9\u03b1\u03ba\u03bf\u03c0\u03ae \u03b2\u03c1\u03cc\u03c7\u03bf\u03c5 \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1\u03c2",stopDisconnect:"\u0394\u03b9\u03b1\u03ba\u03bf\u03c0\u03ae / \u0391\u03c0\u03bf\u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7",discoveredDevices:"\u03a3\u03a5\u03a3\u039a\u0395\u03a5\u0395\u03a3 \u0391\u039d\u0391\u039a\u0391\u039b\u03a5\u03a8\u0395\u0399\u03a3",connect:"\u03a3\u03a5\u039d\u0394\u0395\u03a3\u0397",scanning:"\u03a3\u03ac\u03c1\u03c9\u03c3\u03b7...",scan:"\u03a3\u03ac\u03c1\u03c9\u03c3\u03b7 \u03a3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ce\u03bd",rpm:"\u03a3\u03c4\u03c1\u03bf\u03c6\u03ad\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",speed:"\u03a4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2",coolant:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03c8\u03c5\u03ba\u03c4\u03b9\u03ba\u03bf\u03cd",throttle:"\u0398\u03ad\u03c3\u03b7 \u03b3\u03ba\u03b1\u03b6\u03b9\u03bf\u03cd",notConnected:"\u0394\u03b5\u03bd \u03ad\u03c7\u03b5\u03b9 \u03c3\u03c5\u03bd\u03b4\u03b5\u03b8\u03b5\u03af",connected:"\u03a3\u03c5\u03bd\u03b4\u03b5\u03b4\u03b5\u03bc\u03ad\u03bd\u03bf\u03c2",connecting:"\u03a3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7...",error:"\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1",openSandbox:"\u0394\u0399\u0391\u0393",advancedTerminal:"Advanced Connection Terminal (DIAG)",terminalTitle:"\u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03bf\u03b8\u03cc\u03bd\u03b7 \u03c4\u03b5\u03c1\u03bc\u03b1\u03c4\u03b9\u03ba\u03bf\u03cd \u03ba\u03b1\u03b9 \u03bb\u03b5\u03c9\u03c6\u03bf\u03c1\u03b5\u03af\u03bf\u03c5",pause:"\u03a0\u0391\u03a5\u03a3\u0397",resume:"RESUME",share:"\u039c\u039f\u0399\u03a1\u0391\u03a3\u03a4\u0395\u0399\u03a4\u0395",clear:"\u039a\u0391\u0398\u0391\u03a1\u0399\u03a3\u03a4\u039f",clearDtcs:"\u0394\u0399\u0391\u0393\u03a1\u0391\u03a6\u0397 DTC",dtcTitle:"DTC \u0394\u0399\u0391\u0393\u039d\u03a9\u03a3\u03a4\u0399\u039a\u0391 & \u039a\u03a9\u0394\u0399\u039a\u039f\u0399 \u0392\u039b\u0391\u0392\u03a9\u039d",noDtcs:"\u0394\u0395\u039d \u0392\u03a1\u0395\u0398\u0397\u039a\u0391\u039d \u039a\u03a9\u0394\u0399\u039a\u039f\u0399 DTC \u03a3\u0395 ECU",readDtcs:"\u0394\u0399\u0391\u0392\u0391\u03a3\u03a4\u0395 DTC",sendDtcs:"\u0391\u03a0\u039f\u03a3\u03a4\u039f\u039b\u0397"},health:{titleMenu:"\u03a5\u0393\u0395\u0399\u0391 \u039a\u0391\u0399 \u0394\u03a5\u039d\u0391\u03a4\u039f\u03a4\u0397\u03a4\u0395\u03a3 OBD2",adapterQuality:"\u03a0\u039f\u0399\u039f\u03a4\u0397\u03a4\u0391 \u039a\u0391\u0399 \u0391\u03a0\u039f\u0394\u039f\u03a3\u0397 \u03a0\u03a1\u039f\u03a3\u0391\u03a1\u039c\u039f\u0393\u0395\u0391",excellent:"\u0395\u039e\u0391\u0399\u03a1\u0395\u03a4\u0399\u039a\u039f\u03a3 (\u0391\u03a5\u0398\u0395\u039d\u03a4\u0399\u039a\u039f\u03a3)",good:"\u039a\u0391\u039b\u039f\u03a3 (\u03a4\u03a5\u03a0\u0399\u039a\u039f\u03a3)",clone:"\u0391\u03a3\u03a5\u039c\u0392\u0391\u03a4\u039f\u03a3 / \u039a\u039b\u03a9\u039d\u039f\u03a3",firmware:"\u0388\u03ba\u03b4\u03bf\u03c3\u03b7 \u03c5\u03bb\u03b9\u03ba\u03bf\u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03b9\u03ba\u03bf\u03cd:",capScore:"\u0392\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03b4\u03c5\u03bd\u03b1\u03c4\u03bf\u03c4\u03ae\u03c4\u03c9\u03bd",latency:"\u039a\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7 (RTT)",protocol:"\u0395\u03bd\u03b5\u03c1\u03b3\u03cc \u03c0\u03c1\u03c9\u03c4\u03cc\u03ba\u03bf\u03bb\u03bb\u03bf",featureSupport:"\u03a0\u0399\u039d\u0391\u039a\u0391\u03a3 \u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u0399\u03a9\u039d \u0395\u03a6\u0391\u03a1\u039c\u039f\u0393\u0397\u03a3",matrixReadCodes:"\u0391\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03ba\u03c9\u03b4\u03b9\u03ba\u03ce\u03bd \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03bf\u03c2",matrixLiveSensors:"\u03a0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b7 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03cc\u03bd\u03bf (\u0392\u03b1\u03c3\u03b9\u03ba\u03cc)",matrixBattery:"\u0394\u03bf\u03ba\u03b9\u03bc\u03ae \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 / \u03c4\u03ac\u03c3\u03b7\u03c2",matrixHighSpeed:"\u03a4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1 \u03c5\u03c8\u03b7\u03bb\u03ae\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 (20Hz)",matrixCoding:"\u039a\u03c9\u03b4\u03b9\u03ba\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03c2 ECU",active:"\u0395\u03bd\u03b5\u03c1\u03b3\u03cc",degraded:"\u03a5\u03c0\u03bf\u03b2\u03b1\u03b8\u03bc\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf (\u0391\u03c1\u03b3\u03cc RTT)",locked:"\u039a\u03bb\u03b5\u03b9\u03b4\u03c9\u03bc\u03ad\u03bd\u03bf (\u0391\u03c3\u03c6\u03b1\u03bb\u03ae\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1)",warning:"\u039a\u039b\u0395\u0399\u0394\u0391\u03a1\u0399\u0391 \u0391\u03a3\u03a6\u0391\u039b\u0395\u0399\u0391\u03a3:",lockExplain:"\u039f \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03b1\u03c2 \u03c3\u03b1\u03c2 \u03ad\u03c7\u03b5\u03b9 \u03b5\u03c0\u03b9\u03c3\u03b7\u03bc\u03b1\u03bd\u03b8\u03b5\u03af \u03c9\u03c2 \u03ba\u03bb\u03c9\u03bd\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf/\u03c8\u03b5\u03cd\u03c4\u03b9\u03ba\u03bf \u03c4\u03c3\u03b9\u03c0. \u0395\u03c0\u03b5\u03b9\u03b4\u03ae \u03bf\u03b9 \u03ba\u03bb\u03c9\u03bd\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03b9 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03b5\u03af\u03c2 \u03c3\u03c4\u03b5\u03c1\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03b1\u03ba\u03c1\u03af\u03b2\u03b5\u03b9\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03ad\u03c8\u03bf\u03c5\u03bd \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03b1 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ce\u03bd, \u03bf\u03b9 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2 \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03bb\u03b5\u03b9\u03b4\u03c9\u03bc\u03ad\u03bd\u03b5\u03c2. \u0391\u03c0\u03bf\u03ba\u03c4\u03ae\u03c3\u03c4\u03b5 \u03b1\u03c5\u03b8\u03b5\u03bd\u03c4\u03b9\u03ba\u03ae \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ae ELM327 v2.1 \u03ae vLinker \u03b3\u03b9\u03b1 \u03b1\u03c3\u03c6\u03b1\u03bb\u03ae \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7.",vehiclePids:"\u039b\u0399\u03a3\u03a4\u0391 \u0395\u039b\u0395\u0393\u03a7\u039f\u03a5 \u0391\u0399\u03a3\u0398\u0397\u03a4\u0397\u03a1\u03a9\u039d \u039f\u03a7\u0397\u039c\u0391\u03a4\u039f\u03a3",checklistPrompt:"\u039f\u03b9 \u03c4\u03c5\u03c0\u03b9\u03ba\u03ad\u03c2 \u03c0\u03b1\u03c1\u03ac\u03bc\u03b5\u03c4\u03c1\u03bf\u03b9 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03c9\u03bd (PID) \u03c0\u03bf\u03c5 \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd ECU \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03cc\u03c2 \u03c3\u03b1\u03c2 \u03c0\u03b1\u03c1\u03b1\u03c4\u03af\u03b8\u03b5\u03bd\u03c4\u03b1\u03b9 \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03c4\u03c9. \u039f\u03b9 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2 \u03c7\u03c9\u03c1\u03af\u03c2 \u03c3\u03b7\u03bc\u03ac\u03b4\u03b9 \u03b4\u03b5\u03bd \u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03bf \u03cc\u03c7\u03b7\u03bc\u03ac \u03c3\u03b1\u03c2.",supportedBadge:" \u03a5\u03a0\u039f\u03a3\u03a4\u0397\u03a1\u0399\u0396\u0395\u03a4\u0391\u0399",unsupportedBadge:" \u0394\u0395\u039d \u03a5\u03a0\u039f\u03a3\u03a4\u0397\u03a1\u0399\u0396\u0395\u03a4\u0391\u0399"},sensor:{oilTemp:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03bb\u03b1\u03b4\u03b9\u03bf\u03cd \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",boost:"Turbo Boost Pressure",widebandAfr:"\u0391\u03bd\u03b1\u03bb\u03bf\u03b3\u03af\u03b1 \u03b5\u03c5\u03c1\u03b5\u03af\u03b1\u03c2 \u03b6\u03ce\u03bd\u03b7\u03c2 O2 / AFR",transTemp:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03bc\u03b5\u03c4\u03ac\u03b4\u03bf\u03c3\u03b7\u03c2",catalystTemp:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03ba\u03b1\u03c4\u03b1\u03bb\u03cd\u03c4\u03b7",ethanol:"% \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u03b1\u03b9\u03b8\u03b1\u03bd\u03cc\u03bb\u03b7\u03c2",timingAdvance:"\u03a0\u03c1\u03bf\u03ce\u03b8\u03b7\u03c3\u03b7 \u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2",baro:"\u0392\u03b1\u03c1\u03bf\u03bc\u03b5\u03c4\u03c1\u03b9\u03ba\u03ae \u03c0\u03af\u03b5\u03c3\u03b7",rpm:"\u03a3\u03c4\u03c1\u03bf\u03c6\u03ad\u03c2 \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1 (RPM)",speed:"\u03a4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2",coolant:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03c8\u03c5\u03ba\u03c4\u03b9\u03ba\u03bf\u03cd \u03c5\u03b3\u03c1\u03bf\u03cd",throttle:"\u0398\u03ad\u03c3\u03b7 \u03b3\u03ba\u03b1\u03b6\u03b9\u03bf\u03cd",voltage:"\u03a4\u03ac\u03c3\u03b7 \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1\u03c2 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5",maf:"\u03a1\u03bf\u03ae \u03b1\u03ad\u03c1\u03b1 MAF",iat:"\u0398\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03b1\u03ad\u03c1\u03b1 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2",load:"\u03a5\u03c0\u03bf\u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf \u03c6\u03bf\u03c1\u03c4\u03af\u03bf \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1",fuel:"\u03a3\u03c4\u03ac\u03b8\u03bc\u03b7 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5"},secretDebug:{title:"\u039e\u0395\u039a\u039b\u0395\u0399\u0394\u03a9\u039c\u0391 \u039a\u03a1\u03a5\u03a6\u03a9\u039d \u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u0399\u03a9\u039d & UDS",logFileSize:"Black Box / \u039c\u03ad\u03b3\u03b5\u03b8\u03bf\u03c2 \u03b1\u03c1\u03c7\u03b5\u03af\u03bf\u03c5:",dtcCloudSync:" \u03a3\u03a5\u0393\u03a7\u03a1\u039f\u039d\u0399\u03a3\u039c\u039f\u03a3 DTC CLOD",lastSync:"\u03a4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf\u03c2 \u03c3\u03c5\u03b3\u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2",syncNow:"\u03a3\u03c5\u03b3\u03c7\u03c1\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c4\u03ce\u03c1\u03b1",developerTools:"\u0395\u03a1\u0393\u0391\u039b\u0395\u0399\u0391 \u03a0\u03a1\u039f\u0393\u03a1\u0391\u039c\u039c\u0391\u03a4\u0399\u03a3\u03a4\u03a9\u039d",trialResetSuccess:"\u0395\u03c0\u03b9\u03c4\u03c5\u03c7\u03ae\u03c2 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c4\u03bf\u03c5 \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae\u03c2!",crashTestTitle:"Crash Test",crashTestDesc:"\u0397 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b8\u03b1 \u03b4\u03b9\u03b1\u03ba\u03bf\u03c0\u03b5\u03af \u03c0\u03bb\u03ad\u03bf\u03bd \u03c3\u03ba\u03cc\u03c0\u03b9\u03bc\u03b1. \u0395\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03b9\u03ce\u03c3\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b5\u03c0\u03b1\u03bb\u03b7\u03b8\u03b5\u03cd\u03c3\u03b5\u03c4\u03b5 \u03c4\u03b7\u03bd \u03b5\u03bd\u03c3\u03c9\u03bc\u03ac\u03c4\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 Crashlytics.",crashButton:"\u03a3\u03c5\u03bd\u03c4\u03c1\u03b9\u03b2\u03ae",crashTest:"Crash Test"},features:{title:"\u039e\u0395\u039a\u039b\u0395\u0399\u0394\u03a9\u039c\u0391 \u039a\u03a1\u03a5\u03a6\u03a9\u039d \u039b\u0395\u0399\u03a4\u039f\u03a5\u03a1\u0393\u0399\u03a9\u039d & UDS",subTitle:"\u039c\u03b7\u03c7\u03b1\u03bd\u03ae \u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 & Long Coding ISO 14229 UDS",batteryVoltage:"\u03a4\u0391\u03a3\u0397 \u039c\u03a0\u0391\u03a4\u0391\u03a1\u0399\u0391\u03a3",voltageReady:" \u0391\u03c3\u03c6\u03b1\u03bb\u03ad\u03c2 (\u0388\u03c4\u03bf\u03b9\u03bc\u03bf \u03b3\u03b9\u03b1 \u0395\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae ECU)",voltageLocked:" \u03a7\u03b1\u03bc\u03b7\u03bb\u03ae \u03a4\u03ac\u03c3\u03b7 (\u039a\u03bb\u03b5\u03b9\u03b4\u03c9\u03bc\u03ad\u03bd\u03b7 \u0395\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae)",locked:"\u039a\u039b\u0395\u0399\u0394\u03a9\u039c\u0395\u039d\u039f",ready:"\u0395\u03a4\u039f\u0399\u039c\u039f",allMarks:"\u039f\u039b\u0395\u03a3 \u039f\u0399 \u039c\u0391\u03a1\u039a\u0395\u03a3",writeBtn:"\u0393\u03a1\u0391\u03a8\u03a4\u0395",catLighting:"\u03a6\u03a9\u03a4\u0399\u03a3\u039c\u039f\u03a3",catSound:"\u0397\u03a7\u039f\u03a3 & \u0395\u0399\u0394\u039f\u03a0\u039f\u0399\u0397\u03a3\u0395\u0399\u03a3",catDisplay:"\u039f\u03a1\u0393\u0391\u039d\u0391",catComfort:"\u0391\u039d\u0395\u03a3\u0397",catSafety:"\u0391\u03a3\u03a6\u0391\u039b\u0395\u0399\u0391",safetyAlertTitle:" \u0395\u03b9\u03b4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae\u03c2 \u03c4\u03ac\u03c3\u03b7\u03c2 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2",safetyAlertMsg:"\u0391\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03b5\u03bb\u03ac\u03c7\u03b9\u03c3\u03c4\u03b7 \u03c4\u03ac\u03c3\u03b7 \u03bc\u03c0\u03b1\u03c4\u03b1\u03c1\u03af\u03b1\u03c2 12,2 V \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03ba\u03c9\u03b4\u03b9\u03ba\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7.\n\u03a3\u03c5\u03bd\u03b4\u03ad\u03c3\u03c4\u03b5 \u03ad\u03bd\u03b1\u03bd \u03c6\u03bf\u03c1\u03c4\u03b9\u03c3\u03c4\u03ae \u03ae \u03be\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03ba\u03b9\u03bd\u03b7\u03c4\u03ae\u03c1\u03b1.",items:{vag_staging_needle_sweep:{name:"\u03a3\u03c4\u03b1\u03b4\u03b9\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ae / \u03a3\u03ba\u03bf\u03cd\u03c0\u03b9\u03c3\u03bc\u03b1 \u03bc\u03b5 \u03b2\u03b5\u03bb\u03cc\u03bd\u03b1",desc:"\u03a3\u03b1\u03c1\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03b2\u03b5\u03bb\u03cc\u03bd\u03b5\u03c2 \u03c4\u03bf\u03c5 \u03bf\u03c1\u03b3\u03ac\u03bd\u03bf\u03c5 \u03c3\u03c4\u03bf \u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03bf \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7\u03c2."},vag_acoustic_lock_confirmation:{name:"\u0395\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03af\u03c9\u03c3\u03b7 \u0391\u03ba\u03bf\u03c5\u03c3\u03c4\u03b9\u03ba\u03ae\u03c2 \u039a\u03bb\u03b5\u03b9\u03b4\u03b1\u03c1\u03b9\u03ac\u03c2",desc:"\u0395\u03ba\u03c0\u03ad\u03bc\u03c0\u03b5\u03b9 \u03ad\u03bd\u03b1 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03bf \u03ba\u03bf\u03c5\u03b4\u03bf\u03cd\u03bd\u03b9\u03c3\u03bc\u03b1 \u03b5\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03af\u03c9\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03ba\u03cc\u03c1\u03bd\u03b1\u03c2 \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba."},vag_american_parking_lights:{name:"\u03a6\u03ce\u03c4\u03b1 \u03c3\u03c4\u03ac\u03b8\u03bc\u03b5\u03c5\u03c3\u03b7\u03c2 \u03b1\u03bc\u03b5\u03c1\u03b9\u03ba\u03b1\u03bd\u03b9\u03ba\u03bf\u03cd \u03c3\u03c4\u03c5\u03bb",desc:"\u0391\u03bd\u03ac\u03b2\u03b5\u03b9 \u03c3\u03c5\u03bd\u03b5\u03c7\u03ce\u03c2 \u03c4\u03b1 \u03bc\u03c0\u03c1\u03bf\u03c3\u03c4\u03b9\u03bd\u03ac \u03c6\u03bb\u03b1\u03c2 \u03c3\u03c4\u03bf 20% \u03c7\u03b1\u03bc\u03b7\u03bb\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7 \u03c6\u03c9\u03c4\u03b5\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03bc\u03b5 \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03c3\u03c4\u03ac\u03b8\u03bc\u03b5\u03c5\u03c3\u03b7\u03c2."},vag_drl_menu_toggle:{name:"\u0395\u03bd\u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03bc\u03b5\u03bd\u03bf\u03cd \u03c6\u03ce\u03c4\u03b1 \u03b7\u03bc\u03ad\u03c1\u03b1\u03c2 (DRL).",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5 DRL ON/OFF \u03c3\u03c4\u03bf \u03bc\u03b5\u03bd\u03bf\u03cd \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03c9\u03bd \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 infotainment."},vag_tear_wiping:{name:"\u03a3\u03ba\u03bf\u03cd\u03c0\u03b9\u03c3\u03bc\u03b1 \u03b4\u03b1\u03ba\u03c1\u03cd\u03c9\u03bd \u03c0\u03b1\u03c1\u03bc\u03c0\u03c1\u03af\u03b6",desc:"\u0395\u03ba\u03c4\u03b5\u03bb\u03b5\u03af \u03ad\u03bd\u03b1 \u03b5\u03c0\u03b9\u03c0\u03bb\u03ad\u03bf\u03bd \u03c4\u03b5\u03bb\u03b9\u03ba\u03cc \u03c3\u03ba\u03bf\u03cd\u03c0\u03b9\u03c3\u03bc\u03b1 5 \u03b4\u03b5\u03c5\u03c4\u03b5\u03c1\u03cc\u03bb\u03b5\u03c0\u03c4\u03b1 \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c0\u03bb\u03c5\u03bd\u03c4\u03b7\u03c1\u03af\u03bf\u03c5 \u03c0\u03b1\u03c1\u03bc\u03c0\u03c1\u03af\u03b6."},vag_emergency_brake_flashing:{name:"\u039a\u03af\u03bd\u03b4\u03c5\u03bd\u03bf\u03c2 \u03c0\u03ad\u03b4\u03b7\u03c3\u03b7\u03c2 \u03ad\u03ba\u03c4\u03b1\u03ba\u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03b3\u03ba\u03b7\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03b2\u03bf\u03c3\u03b2\u03ae\u03bd\u03b5\u03b9",desc:"\u0391\u03bd\u03b1\u03b2\u03bf\u03c3\u03b2\u03ae\u03bd\u03b5\u03b9 \u03b3\u03c1\u03ae\u03b3\u03bf\u03c1\u03b1 \u03c4\u03b1 \u03c6\u03ce\u03c4\u03b1 \u03c4\u03c9\u03bd \u03c6\u03c1\u03ad\u03bd\u03c9\u03bd \u03ba\u03b1\u03b9 \u03ba\u03b9\u03bd\u03b4\u03c5\u03bd\u03b5\u03cd\u03b5\u03b9 \u03ba\u03ac\u03c4\u03c9 \u03b1\u03c0\u03cc \u03b9\u03c3\u03c7\u03c5\u03c1\u03cc \u03c6\u03c1\u03b5\u03bd\u03ac\u03c1\u03b9\u03c3\u03bc\u03b1 \u03ad\u03ba\u03c4\u03b1\u03ba\u03c4\u03b7\u03c2 \u03b1\u03bd\u03ac\u03b3\u03ba\u03b7\u03c2."},vag_cornering_lights:{name:"\u0393\u03c9\u03bd\u03b9\u03b1\u03ba\u03ac \u03c6\u03ce\u03c4\u03b1 \u03bf\u03bc\u03af\u03c7\u03bb\u03b7\u03c2",desc:"\u0391\u03bd\u03ac\u03b2\u03b5\u03b9 \u03c4\u03bf \u03c6\u03c9\u03c2 \u03bf\u03bc\u03af\u03c7\u03bb\u03b7\u03c2 \u03c3\u03c4\u03b9\u03c2 \u03c3\u03c4\u03c1\u03bf\u03c6\u03ad\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03bb\u03b5\u03c5\u03c1\u03ac \u03c0\u03b5\u03c1\u03b9\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c4\u03bf\u03c5 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd."},vag_comfort_mirror_folding:{name:"\u039c\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba Comfort \u039a\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b7\u03c2 \u03a0\u03c4\u03c5\u03c3\u03c3\u03cc\u03bc\u03b5\u03bd\u03bf\u03c2",desc:"\u0394\u03b9\u03c0\u03bb\u03ce\u03bd\u03b5\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5\u03c2 \u03c0\u03bb\u03b1\u03ca\u03bd\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b5\u03c2 \u03cc\u03c4\u03b1\u03bd \u03ba\u03c1\u03b1\u03c4\u03ac\u03c4\u03b5 \u03c0\u03b1\u03c4\u03b7\u03bc\u03ad\u03bd\u03bf \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c3\u03c4\u03bf \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba."},vag_lap_timer:{name:"Instrument Cluster Lap Timer",desc:"\u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03ba\u03b1\u03c1\u03c4\u03ad\u03bb\u03b1 \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7\u03c2 \u03c7\u03c1\u03bf\u03bd\u03bf\u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7 \u03b3\u03cd\u03c1\u03bf\u03c5 \u03ba\u03bf\u03bc\u03bc\u03b1\u03c4\u03b9\u03bf\u03cd \u03c3\u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 \u03c4\u03bf\u03c5 \u03c4\u03b1\u03bc\u03c0\u03bb\u03cc \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd."},vag_refuel_quantity:{name:"\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03c0\u03bf\u03c3\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03b1\u03bd\u03b5\u03c6\u03bf\u03b4\u03b9\u03b1\u03c3\u03bc\u03bf\u03cd",desc:"\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b1\u03ba\u03c1\u03b9\u03b2\u03ae \u03cc\u03b3\u03ba\u03bf \u03c3\u03b5 \u03bb\u03af\u03c4\u03c1\u03b1 \u03c0\u03bf\u03c5 \u03b1\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c0\u03bb\u03ae\u03c1\u03b7 \u03b1\u03bd\u03b5\u03c6\u03bf\u03b4\u03b9\u03b1\u03c3\u03bc\u03cc \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5."},bmw_start_stop_memory:{name:"\u0391\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03ad\u03bd\u03b1\u03c1\u03be\u03b7-\u03b4\u03b9\u03b1\u03ba\u03bf\u03c0\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03bc\u03bd\u03ae\u03bc\u03b7\u03c2",desc:"\u0398\u03c5\u03bc\u03ac\u03c4\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 Auto Start-Stop (OFF/ON) \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2."},bmw_digital_speedometer:{name:"\u03a8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ae \u03bf\u03b8\u03cc\u03bd\u03b7 \u03c4\u03b1\u03c7\u03cd\u03bc\u03b5\u03c4\u03c1\u03bf\u03c5",desc:"\u03a0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c4\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b1\u03c1\u03b9\u03b8\u03bc\u03b7\u03c4\u03b9\u03ba\u03ae\u03c2 \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7\u03c2 \u03ac\u03bc\u03b5\u03c3\u03b7\u03c2 \u03c8\u03b7\u03c6\u03b9\u03b1\u03ba\u03ae\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c3\u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 \u03c3\u03c5\u03bc\u03c0\u03bb\u03ad\u03b3\u03bc\u03b1\u03c4\u03bf\u03c2."},bmw_sport_displays:{name:"\u0391\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03ad\u03c2 \u03bf\u03b8\u03cc\u03bd\u03b5\u03c2 (\u03bc\u03b5\u03c4\u03c1\u03b7\u03c4\u03ad\u03c2 HP & Nm)",desc:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03ac \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ac \u03c0\u03bb\u03ae\u03ba\u03c4\u03c1\u03b1 \u03b9\u03c0\u03c0\u03bf\u03b4\u03cd\u03bd\u03b1\u03bc\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c1\u03bf\u03c0\u03ae\u03c2 \u03c3\u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 iDrive."},bmw_acoustic_lock_sound:{name:"\u0391\u03ba\u03bf\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc\u03c2 \u03ae\u03c7\u03bf\u03c2 \u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2/\u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2",desc:"\u0395\u03ba\u03c0\u03ad\u03bc\u03c0\u03b5\u03b9 \u03ba\u03bf\u03c5\u03b4\u03bf\u03c5\u03bd\u03af\u03c3\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c3\u03c5\u03bd\u03b1\u03b3\u03b5\u03c1\u03bc\u03bf\u03cd \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf \u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03ae \u03c4\u03bf \u03be\u03b5\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2."},bmw_mirror_fold_delay_zero:{name:"Instant Mirror Folding (\u039a\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7 0,0 \u03b4\u03b5\u03c5\u03c4\u03b5\u03c1\u03bf\u03bb\u03ad\u03c0\u03c4\u03c9\u03bd)",desc:"\u0394\u03b9\u03c0\u03bb\u03ce\u03bd\u03b5\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03c0\u03bb\u03b1\u03ca\u03bd\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b8\u03c1\u03ad\u03c6\u03c4\u03b5\u03c2 \u03b1\u03bc\u03ad\u03c3\u03c9\u03c2 \u03bc\u03b5 \u03c4\u03bf \u03c0\u03ac\u03c4\u03b7\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd \u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c7\u03c9\u03c1\u03af\u03c2 \u03ba\u03b1\u03b8\u03c5\u03c3\u03c4\u03ad\u03c1\u03b7\u03c3\u03b7."},bmw_tpms_tire_temperature:{name:"\u0388\u03bd\u03b4\u03b5\u03b9\u03be\u03b7 \u03c0\u03af\u03b5\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1\u03c2 \u03b5\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03ce\u03bd",desc:"\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1 \u03c4\u03c9\u03bd \u03b5\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03ce\u03bd \u03c3\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03cc\u03bd\u03bf \u03c0\u03b1\u03c1\u03ac\u03bb\u03bb\u03b7\u03bb\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c0\u03af\u03b5\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 TPMS."},renault_trip_computer_enable:{name:"\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03b5\u03bd\u03c3\u03c9\u03bc\u03b1\u03c4\u03c9\u03bc\u03ad\u03bd\u03bf\u03c5 \u03c5\u03c0\u03bf\u03bb\u03bf\u03b3\u03b9\u03c3\u03c4\u03ae \u03c4\u03b1\u03be\u03b9\u03b4\u03b9\u03bf\u03cd",desc:"\u039e\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03bf\u03b8\u03cc\u03bd\u03b5\u03c2 \u03bc\u03ad\u03c3\u03b7\u03c2 \u03ba\u03b1\u03c4\u03b1\u03bd\u03ac\u03bb\u03c9\u03c3\u03b7\u03c2 \u03ba\u03b1\u03c5\u03c3\u03af\u03bc\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b1\u03c5\u03c4\u03bf\u03bd\u03bf\u03bc\u03af\u03b1\u03c2 \u03c5\u03c0\u03bf\u03bb\u03bf\u03b3\u03b9\u03c3\u03c4\u03ae \u03c4\u03b1\u03be\u03b9\u03b4\u03b9\u03bf\u03cd."},renault_external_temp_display:{name:"\u0395\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae \u03ad\u03bd\u03b4\u03b5\u03b9\u03be\u03b7 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1\u03c2",desc:"\u0395\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b5\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae\u03c2 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1\u03c2 \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 \u03c3\u03c4\u03bf\u03bd \u03c0\u03af\u03bd\u03b1\u03ba\u03b1 \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd."},renault_automatic_tailgate:{name:"\u0391\u03c0\u03bf\u03b4\u03ad\u03c3\u03bc\u03b5\u03c5\u03c3\u03b7 \u03ba\u03bf\u03c1\u03bc\u03bf\u03cd \u03bc\u03c0\u03c1\u03b5\u03bb\u03cc\u03ba",desc:"\u03a3\u03ba\u03ac\u03b5\u03b9 \u03c0\u03bb\u03ae\u03c1\u03c9\u03c2 \u03bf \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 \u03bc\u03b1\u03bd\u03b4\u03ac\u03bb\u03c9\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03c0\u03bf\u03c1\u03c4\u03bc\u03c0\u03b1\u03b3\u03ba\u03ac\u03b6 \