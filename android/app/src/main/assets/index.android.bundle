30d2\u30e5\u30f3\u30c0\u30a4/\u30ad\u30a2\uff09",desc:"\u30a8\u30f3\u30b8\u30f3\u518d\u59cb\u52d5\u5f8c\u3001\u6700\u5f8c\u306b\u9078\u629e\u3057\u305f\u30c9\u30e9\u30a4\u30d6\u30e2\u30fc\u30c9 (\u30b9\u30dd\u30fc\u30c4/\u30a8\u30b3) \u3092\u8a18\u61b6\u3057\u307e\u3059\u3002"},tesla_charge_limit_custom:{name:"\u30d0\u30c3\u30c6\u30ea\u30fc\u5145\u96fb\u5236\u9650\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba (Tesla)",desc:"\u30c7\u30d5\u30a9\u30eb\u30c8\u306e HV \u30d0\u30c3\u30c6\u30ea\u30fc\u5145\u96fb\u5236\u9650\u30d1\u30fc\u30bb\u30f3\u30c6\u30fc\u30b8 (\u6bce\u65e5 80% / \u65c5\u884c 100%) \u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},tesla_mirror_fold_lock:{name:"\u30a6\u30a9\u30fc\u30af\u30a2\u30a6\u30a7\u30a4 \u30ed\u30c3\u30af\u3067\u30df\u30e9\u30fc\u3092\u81ea\u52d5\u6298\u308a\u305f\u305f\u307f (\u30c6\u30b9\u30e9)",desc:"\u96fb\u8a71\u30ad\u30fc\u306e\u30a6\u30a9\u30fc\u30af\u30a2\u30a6\u30a7\u30a4\u30ed\u30c3\u30af\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u308b\u3068\u3001\u30b5\u30a4\u30c9\u30df\u30e9\u30fc\u304c\u81ea\u52d5\u7684\u306b\u6298\u308a\u305f\u305f\u307e\u308c\u307e\u3059\u3002"},nissan_coming_home:{name:"\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u6d88\u706f\u9045\u5ef6\u306e\u4e8b\u4f8b\uff08\u65e5\u7523\uff09",desc:"\u65e5\u7523\u8eca\u304b\u3089\u964d\u8eca\u3057\u305f\u5f8c\u3001\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u309230\u79d2\u9593\u70b9\u706f\u3057\u7d9a\u3051\u307e\u3059\u3002"},nissan_lane_change_flash:{name:"\u30bf\u30c3\u30d7\u30c4\u30fc\u30d1\u30b9\u306e\u30ec\u30fc\u30f3\u30c1\u30a7\u30f3\u30b8\u30d5\u30e9\u30c3\u30b7\u30e5\u30ab\u30a6\u30f3\u30c8 (\u65e5\u7523)",desc:"\u30e9\u30a4\u30c8\u30b9\u30c8\u30fc\u30af\u30bf\u30c3\u30d7\u306e\u30a6\u30a4\u30f3\u30ab\u30fc\u30a4\u30f3\u30b8\u30b1\u30fc\u30bf\u30fc\u306e\u30d1\u30eb\u30b9\u6570\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},nissan_autolock_behavior:{name:"\u901f\u5ea6\u4f9d\u5b58\u81ea\u52d5\u30c9\u30a2\u30ed\u30c3\u30af\uff08\u65e5\u7523\uff09",desc:"\u8eca\u4e21\u304c\u6642\u901f 24 km \u306b\u9054\u3059\u308b\u3068\u3001\u3059\u3079\u3066\u306e\u30c9\u30a2\u304c\u81ea\u52d5\u7684\u306b\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002"},nissan_window_remote:{name:"\u30ea\u30e2\u30fc\u30c8\u30ad\u30fc\u30d5\u30a9\u30d6\u30d1\u30ef\u30fc\u30a6\u30a3\u30f3\u30c9\u30a6\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb (\u65e5\u7523)",desc:"\u30ad\u30fc\u30d5\u30a9\u30d6\u306e\u30ed\u30c3\u30af\u89e3\u9664\u30dc\u30bf\u30f3\u3092\u9577\u62bc\u3057\u3057\u3066\u3001\u30d5\u30ed\u30f3\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u958b\u9589\u3057\u307e\u3059\u3002"},nissan_seatbelt_chime_mute:{name:"\u30b7\u30fc\u30c8\u30d9\u30eb\u30c8\u8b66\u544a\u97f3\u58f0\u30c1\u30e3\u30a4\u30e0\u6291\u5236\uff08\u65e5\u7523\uff09",desc:"\u30af\u30e9\u30b9\u30bf\u30fc\u30a2\u30a4\u30b3\u30f3\u3092\u7dad\u6301\u3057\u305f\u307e\u307e\u3001\u7e70\u308a\u8fd4\u3057\u767a\u751f\u3059\u308b\u30b7\u30fc\u30c8\u30d9\u30eb\u30c8\u8b66\u544a\u30c1\u30e3\u30a4\u30e0\u3092\u30df\u30e5\u30fc\u30c8\u3057\u307e\u3059\u3002"},porsche_sport_chrono_launch:{name:"\u30b9\u30dd\u30fc\u30c4 \u30af\u30ed\u30ce \u30ed\u30fc\u30f3\u30c1 \u30b3\u30f3\u30c8\u30ed\u30fc\u30eb \u30ec\u30b9\u30dd\u30f3\u30b9 \u30d7\u30ed\u30d5\u30a1\u30a4\u30eb (\u30dd\u30eb\u30b7\u30a7)",desc:"PDK \u30c8\u30e9\u30f3\u30b9\u30df\u30c3\u30b7\u30e7\u30f3 \u30ed\u30fc\u30f3\u30c1 \u30b3\u30f3\u30c8\u30ed\u30fc\u30eb RPM \u95be\u5024\u3068\u30af\u30e9\u30c3\u30c1 \u30d0\u30a4\u30c8\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002"},porsche_pasm_default:{name:"PASM \u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3 \u30e2\u30fc\u30c9\u8d77\u52d5\u30d7\u30ea\u30bb\u30c3\u30c8 (\u30dd\u30eb\u30b7\u30a7)",desc:"\u70b9\u706b\u958b\u59cb\u6642\u306e PASM \u30a2\u30c0\u30d7\u30c6\u30a3\u30d6 \u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3\u306e\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u525b\u6027\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},porsche_exhaust_flap:{name:"\u30b9\u30dd\u30fc\u30c4 \u30a8\u30ad\u30be\u30fc\u30b9\u30c8 \u30d5\u30e9\u30c3\u30d7 \u30b3\u30f3\u30b9\u30bf\u30f3\u30c8 \u30aa\u30fc\u30d7\u30f3 \u30aa\u30fc\u30d0\u30fc\u30e9\u30a4\u30c9 (\u30dd\u30eb\u30b7\u30a7)",desc:"\u3059\u3079\u3066\u306e RPM \u7bc4\u56f2\u306b\u308f\u305f\u3063\u3066\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u6392\u6c17\u30d0\u30eb\u30d6\u3092\u5f37\u5236\u7684\u306b 100% \u958b\u3044\u305f\u307e\u307e\u306b\u3057\u307e\u3059\u3002"},audi_drive_select_memory:{name:"\u30a2\u30a6\u30c7\u30a3 \u30c9\u30e9\u30a4\u30d6 \u30bb\u30ec\u30af\u30c8 \u30e2\u30fc\u30c9\u306e\u30e1\u30e2\u30ea\u4fdd\u6301 (\u30a2\u30a6\u30c7\u30a3)",desc:"\u518d\u8d77\u52d5\u6642\u306b\u3001\u6700\u5f8c\u306b\u30a2\u30af\u30c6\u30a3\u30d6\u3060\u3063\u305f\u30c9\u30e9\u30a4\u30d6\u9078\u629e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb (\u52d5\u7684/\u500b\u5225) \u304c\u4fdd\u6301\u3055\u308c\u307e\u3059\u3002"},audi_virtual_cockpit_themes:{name:"\u30a2\u30a6\u30c7\u30a3 \u30d0\u30fc\u30c1\u30e3\u30eb \u30b3\u30c3\u30af\u30d4\u30c3\u30c8 S/RS \u30b9\u30dd\u30fc\u30c4 \u30b0\u30e9\u30d5\u30a3\u30c3\u30af \u30ec\u30a4\u30a2\u30a6\u30c8 (\u30a2\u30a6\u30c7\u30a3)",desc:"\u30d0\u30fc\u30c1\u30e3\u30eb\u30b3\u30c3\u30af\u30d4\u30c3\u30c8\u306eS/RS\u4e2d\u592e\u30bf\u30b3\u30e1\u30fc\u30bf\u30fc\u30ec\u30a4\u30a2\u30a6\u30c8\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3057\u307e\u3059\u3002"},vag_scandinavian_drl:{name:"\u30b9\u30ab\u30f3\u30b8\u30ca\u30d3\u30a2\u30f3 DRL \u30e2\u30fc\u30c9 (VAG)",desc:"\u30ea\u30a2\u30c6\u30fc\u30eb\u30e9\u30a4\u30c8\u3092\u30d5\u30ed\u30f3\u30c8 DRL \u3068\u4e26\u884c\u3057\u3066\u7d99\u7d9a\u7684\u306b\u70b9\u706f\u3055\u305b\u307e\u3059\u3002"},vag_mirror_dip_reverse:{name:"\u52a9\u624b\u5e2d\u30df\u30e9\u30fc\u30c7\u30a3\u30c3\u30d7\u30a4\u30f3\u30ea\u30d0\u30fc\u30b9 (VAG)",desc:"\u30ea\u30d0\u30fc\u30b9\u30ae\u30a2\u3092\u5165\u308c\u308b\u3068\u52a9\u624b\u5e2d\u5074\u306e\u30df\u30e9\u30fc\u304c\u4e0b\u5411\u304d\u306b\u306a\u308a\u307e\u3059\u3002"},vag_dynamic_turn_signal:{name:"\u30c0\u30a4\u30ca\u30df\u30c3\u30af/\u30b7\u30fc\u30b1\u30f3\u30b7\u30e3\u30eb\u30a6\u30a4\u30f3\u30ab\u30fc\u30e2\u30fc\u30c9 (VAG)",desc:"\u4e92\u63db\u6027\u306e\u3042\u308b\u30ea\u30a2\u30e9\u30a4\u30c8\u30e2\u30b8\u30e5\u30fc\u30eb\u3067\u30b9\u30a4\u30fc\u30d7\u30c0\u30a4\u30ca\u30df\u30c3\u30af LED \u30a6\u30a4\u30f3\u30ab\u30fc\u30d1\u30bf\u30fc\u30f3\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002"},vag_seatbelt_warning_duration:{name:"\u30b7\u30fc\u30c8\u30d9\u30eb\u30c8\u8b66\u544a\u30c1\u30e3\u30a4\u30e0\u6301\u7d9a\u6642\u9593\u8abf\u6574\uff08VAG\uff09",desc:"\u7e70\u308a\u8fd4\u3057\u767a\u751f\u3059\u308b\u30b7\u30fc\u30c8\u30d9\u30eb\u30c8\u8b66\u544a\u30c1\u30e3\u30a4\u30e0\u306e\u30bf\u30a4\u30de\u30fc\u3092\u77ed\u7e2e\u307e\u305f\u306f\u6291\u5236\u3057\u307e\u3059\u3002"},vag_sunroof_remote:{name:"\u30b5\u30f3\u30eb\u30fc\u30d5 \u30ea\u30e2\u30fc\u30c8 \u30b3\u30f3\u30d5\u30a9\u30fc\u30c8 \u30b3\u30f3\u30c8\u30ed\u30fc\u30eb (VAG)",desc:"\u30ea\u30e2\u30fc\u30c8\u30ad\u30fc\u30d5\u30a9\u30d6\u3092\u62bc\u3057\u7d9a\u3051\u308b\u3068\u3001\u30d1\u30ce\u30e9\u30df\u30c3\u30af\u30b5\u30f3\u30eb\u30fc\u30d5\u3092\u958b\u3044\u305f\u308a\u50be\u3051\u305f\u308a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"},vag_acc_distance_preset:{name:"ACC \u30a2\u30c0\u30d7\u30c6\u30a3\u30d6\u30af\u30eb\u30fc\u30ba \u30c7\u30d5\u30a9\u30eb\u30c8\u8ffd\u5f93\u8ddd\u96e2 (VAG)",desc:"\u70b9\u706b\u958b\u59cb\u6642\u306e\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u30ec\u30fc\u30c0\u30fc\u8ffd\u5f93\u8ddd\u96e2\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},vag_infotainment_startup_logo:{name:"\u30a4\u30f3\u30d5\u30a9\u30c6\u30a4\u30f3\u30e1\u30f3\u30c8 \u30d6\u30fc\u30c4 \u30b0\u30e9\u30d5\u30a3\u30c3\u30af \u30ed\u30b4 (VAG)",desc:"\u30a4\u30f3\u30d5\u30a9\u30c6\u30a4\u30f3\u30e1\u30f3\u30c8\u306e\u8d77\u52d5\u30b9\u30d7\u30e9\u30c3\u30b7\u30e5 \u30b9\u30af\u30ea\u30fc\u30f3\u306e\u30ed\u30b4\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059 (R-Line\u3001GTI\u3001RS)\u3002"},vag_ambient_color_cycle:{name:"\u5ba4\u5185\u74b0\u5883\u5149\u306e\u8272\u30b9\u30da\u30af\u30c8\u30eb\u306e\u30ed\u30c3\u30af\u89e3\u9664 (VAG)",desc:"\u8eca\u4e21\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306e\u30a2\u30f3\u30d3\u30a8\u30f3\u30c8\u7167\u660e\u30d1\u30ec\u30c3\u30c8\u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u62e1\u5f35\u3057\u307e\u3059\u3002"},vag_service_interval_custom:{name:"\u30ab\u30b9\u30bf\u30e0\u691c\u67fb\u304a\u3088\u3073\u30b5\u30fc\u30d3\u30b9\u8ddd\u96e2\u3057\u304d\u3044\u5024 (VAG)",desc:"\u6b21\u56de\u306e\u30b5\u30fc\u30d3\u30b9\u8b66\u544a\u306e\u30ab\u30b9\u30bf\u30e0\u306e\u8d70\u884c\u8ddd\u96e2\u3068\u65e5\u306e\u76ee\u6a19\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},vag_door_handle_lights_reverse:{name:"\u30a8\u30af\u30b9\u30c6\u30ea\u30a2\u30c9\u30a2\u30cf\u30f3\u30c9\u30eb\u5f8c\u9000\u6642\u70b9\u706f\uff08VAG\uff09",desc:"\u30d0\u30c3\u30af\u6642\u306b\u30c9\u30a2\u30cf\u30f3\u30c9\u30eb\u306eLED\u6c34\u305f\u307e\u308a\u30e9\u30a4\u30c8\u3092\u70b9\u706f\u3057\u3001\u5730\u9762\u3092\u8996\u8a8d\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"},bmw_msport_exhaust_burble:{name:"M \u30b9\u30dd\u30fc\u30c4 \u30a8\u30ad\u30be\u30fc\u30b9\u30c8 \u30d6\u30eb\u30d6\u30eb & \u30dd\u30c3\u30d7 \u30a4\u30f3\u30c6\u30f3\u30b7\u30c6\u30a3 (BMW)",desc:"\u30b9\u30dd\u30fc\u30c4\u30e2\u30fc\u30c9\u3067\u306e\u30aa\u30fc\u30d0\u30fc\u30e9\u30f3\u30d0\u30fc\u30d6\u30eb\u30b5\u30a6\u30f3\u30c9\u306e\u653b\u6483\u6027\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"},bmw_welcome_light_sequence:{name:"\u30a6\u30a7\u30eb\u30ab\u30e0 \u30e9\u30a4\u30c8 \u30b7\u30fc\u30b1\u30f3\u30b9 \u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3 (BMW)",desc:"LED \u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u3068\u30a8\u30f3\u30b8\u30a7\u30eb \u30a2\u30a4\u306e\u30a6\u30a7\u30eb\u30ab\u30e0 \u30b0\u30ea\u30fc\u30c6\u30a3\u30f3\u30b0 \u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002"},bmw_service_history_menu:{name:"\u30c7\u30b8\u30bf\u30eb \u30b5\u30fc\u30d3\u30b9\u5c65\u6b74\u30e1\u30cb\u30e5\u30fc\u306e\u6709\u52b9\u5316 (BMW)",desc:"\u4e2d\u592e\u30c7\u30a3\u30b9\u30d7\u30ec\u30a4\u306e iDrive \u30c7\u30b8\u30bf\u30eb \u30b5\u30fc\u30d3\u30b9 \u30ec\u30b3\u30fc\u30c9 \u30d6\u30c3\u30af \u30e1\u30cb\u30e5\u30fc\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3057\u307e\u3059\u3002"},bmw_hud_speed_display:{name:"\u30d8\u30c3\u30c9\u30a2\u30c3\u30d7 \u30c7\u30a3\u30b9\u30d7\u30ec\u30a4 \u30c7\u30b8\u30bf\u30eb \u30b9\u30d4\u30fc\u30c9\u30e1\u30fc\u30bf\u30fc \u30aa\u30fc\u30d0\u30fc\u30ec\u30a4 (BMW)",desc:"\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u30c7\u30b8\u30bf\u30eb\u901f\u5ea6\u8aad\u307f\u53d6\u308a\u5024\u3092\u30d8\u30c3\u30c9\u30a2\u30c3\u30d7 \u30c7\u30a3\u30b9\u30d7\u30ec\u30a4\u306b\u6295\u5f71\u3057\u307e\u3059\u3002"},bmw_cornering_lights_fog:{name:"\u30d5\u30a9\u30b0\u30e9\u30f3\u30d7\u30b3\u30fc\u30ca\u30ea\u30f3\u30b0\u30a4\u30eb\u30df\u30cd\u30fc\u30b7\u30e7\u30f3\uff08BMW\uff09",desc:"\u65b9\u5411\u6307\u793a\u5668\u307e\u305f\u306f\u4f4e\u901f\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u89d2\u5ea6\u3067\u30d5\u30ed\u30f3\u30c8\u30d5\u30a9\u30b0\u30e9\u30f3\u30d7\u304c\u70b9\u706f\u3057\u307e\u3059\u3002"},bmw_easy_entry_steering:{name:"\u30a4\u30fc\u30b8\u30fc\u30a8\u30f3\u30c8\u30ea\u30fc\u30aa\u30fc\u30c8\u30ea\u30c8\u30e9\u30af\u30bf\u30ea\u30f3\u30b0\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u30b3\u30e9\u30e0 (BMW)",desc:"\u30a8\u30f3\u30b8\u30f3\u505c\u6b62\u6642\u306b\u96fb\u52d5\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u30db\u30a4\u30fc\u30eb\u3092\u4e0a\u65b9\u306b\u683c\u7d0d\u3057\u3001\u7c21\u5358\u306b\u8131\u51fa\u3067\u304d\u307e\u3059\u3002"},bmw_bluetooth_audio_enable:{name:"\u5f37\u5316\u3055\u308c\u305f Bluetooth \u30aa\u30fc\u30c7\u30a3\u30aa \u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0 \u30ed\u30c3\u30af\u89e3\u9664 (BMW)",desc:"iDrive HU_ENTRYNAV \u3067 A2DP Bluetooth \u30ef\u30a4\u30e4\u30ec\u30b9\u97f3\u697d\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002"},bmw_door_handle_lights_reverse:{name:"\u30a8\u30af\u30b9\u30c6\u30ea\u30a2 \u30c9\u30a2 \u30cf\u30f3\u30c9\u30eb \u30ea\u30d0\u30fc\u30b9\u6642\u306e\u30d1\u30c9\u30eb \u30e9\u30a4\u30c8 (BMW)",desc:"\u30ea\u30d0\u30fc\u30b9\u30ae\u30a2\u304c\u5165\u3063\u3066\u3044\u308b\u3068\u304d\u306b\u30c9\u30a2\u30cf\u30f3\u30c9\u30eb\u306e LED \u304c\u70b9\u706f\u3057\u307e\u3059\u3002"},toyota_auto_headlight_threshold:{name:"\u81ea\u52d5\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u5468\u56f2\u5149\u30bb\u30f3\u30b5\u30fc\u611f\u5ea6 (\u30c8\u30e8\u30bf)",desc:"\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u3092\u81ea\u52d5\u70b9\u706f\u3059\u308b\u305f\u3081\u306e\u5915\u66ae\u308c\u306e\u3057\u304d\u3044\u5024\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"},toyota_turn_signal_click_volume:{name:"\u30a6\u30a4\u30f3\u30ab\u30fc\u30aa\u30fc\u30c7\u30a3\u30aa\u30af\u30ea\u30c3\u30ab\u30fc\u30b9\u30d4\u30fc\u30ab\u30fc\u97f3\u91cf (\u30c8\u30e8\u30bf)",desc:"\u30a6\u30a4\u30f3\u30ab\u30fc\u30ea\u30ec\u30fc\u306e\u30af\u30ea\u30c3\u30af\u30c1\u30e3\u30a4\u30e0\u97f3\u91cf\uff08\u4f4e\u3001\u4e2d\u3001\u9ad8\uff09\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},toyota_smart_key_approach_lights:{name:"\u30b9\u30de\u30fc\u30c8\u30ad\u30fc\u8fd1\u63a5\u30a6\u30a7\u30eb\u30ab\u30e0\u6c34\u305f\u307e\u308a\u30e9\u30a4\u30c8 (\u30c8\u30e8\u30bf)",desc:"\u30b9\u30de\u30fc\u30c8\u30ad\u30fc\u304c\u8eca\u4e21\u306b\u8fd1\u3065\u304f\u3068\u30df\u30e9\u30fc\u6c34\u305f\u307e\u308a\u30e9\u30a4\u30c8\u304c\u70b9\u706f\u3057\u307e\u3059\u3002"},toyota_rear_hatch_behavior:{name:"\u30d1\u30ef\u30fc\u30c6\u30fc\u30eb\u30b2\u30fc\u30c8 \u30ea\u30d5\u30c8\u30b2\u30fc\u30c8\u958b\u9589\u52d5\u4f5c\u30ed\u30b8\u30c3\u30af\uff08\u30c8\u30e8\u30bf\uff09",desc:"\u30ea\u30e2\u30fc\u30c8\u304a\u3088\u3073\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u306e\u96fb\u6e90\u30cf\u30c3\u30c1\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u6642\u9593\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002"},toyota_open_windows_smart_key:{name:"\u30b9\u30de\u30fc\u30c8\u30ad\u30fc \u30ea\u30e2\u30fc\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6 \u30ed\u30fc\u30eb\u30c0\u30a6\u30f3\u9577\u62bc\u3057\uff08\u30c8\u30e8\u30bf\uff09",desc:"\u30ea\u30e2\u30fc\u30c8\u30ed\u30c3\u30af\u89e3\u9664\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u7d9a\u3051\u308b\u3068\u3001\u3059\u3079\u3066\u306e\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u958b\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"},toyota_interior_light_dim_timer:{name:"\u30ad\u30e3\u30d3\u30f3\u5185\u7167\u660e\u306e\u81ea\u52d5\u6e1b\u5149\u30aa\u30d5\u9045\u5ef6 (\u30c8\u30e8\u30bf)",desc:"\u30c9\u30a2\u304c\u9589\u307e\u3063\u305f\u5f8c\u306e\u5185\u90e8\u30c9\u30fc\u30e0\u30e9\u30a4\u30c8\u306e\u30b7\u30e3\u30c3\u30c8\u30c0\u30a6\u30f3\u30bf\u30a4\u30de\u30fc\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"},toyota_panic_alarm_remote:{name:"\u30ea\u30e2\u30fc\u30c8\u30ad\u30fc\u30d5\u30a9\u30d6\u30d1\u30cb\u30c3\u30af\u30a2\u30e9\u30fc\u30e0\u30b5\u30a4\u30ec\u30f3\u6a5f\u80fd (\u30c8\u30e8\u30bf)",desc:"\u30ea\u30e2\u30fc\u30c8\u30ad\u30fc\u30db\u30fc\u30eb\u30c9\u306b\u3088\u308b\u8eca\u4e21\u30db\u30fc\u30f3\u30d1\u30cb\u30c3\u30af\u30a2\u30e9\u30fc\u30e0\u3092\u6709\u52b9\u307e\u305f\u306f\u7121\u52b9\u306b\u3057\u307e\u3059\u3002"},toyota_eco_drive_indicator:{name:"\u30a8\u30b3\u30c9\u30e9\u30a4\u30d6\u30af\u30e9\u30b9\u30bf\u30fc\u30be\u30fc\u30f3\u8868\u793a\u706f\uff08\u30c8\u30e8\u30bf\uff09",desc:"\u74b0\u5883\u306b\u512a\u3057\u3044\u52a0\u901f\u30d0\u30fc\u3068\u30af\u30e9\u30b9\u30bf\u30fc\u8868\u793a\u706f\u3092\u8868\u793a\u3057\u307e\u3059\u3002"},hyundai_coming_home_duration:{name:"\u30a8\u30b9\u30b3\u30fc\u30c8\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u30aa\u30d5\u30c7\u30a3\u30ec\u30fc\u30bf\u30a4\u30de\u30fc (\u30d2\u30e5\u30f3\u30c0\u30a4/\u30ad\u30a2)",desc:"\u8eca\u4e21\u306e\u964d\u8eca\u5f8c\u3082\u30ed\u30fc\u30d3\u30fc\u30e0\u30d8\u30c3\u30c9\u30e9\u30a4\u30c8\u3092\u70b9\u706f\u3057\u7d9a\