30af\u30ea\u30a2\u3059\u308b",finish:"\u30b9\u30ad\u30c3\u30d7\uff08\u7d42\u4e86\uff09",completed:"\u5b8c\u6210\u3057\u307e\u3057\u305f",completedDesc:"\u30b5\u30fc\u30d3\u30b9\u64cd\u4f5c\u306f\u6b63\u5e38\u306b\u5b8c\u4e86\u3057\u307e\u3057\u305f\u3002\u8eca\u4e21\u3092\u518d\u59cb\u52d5\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002",hardResetDesc:"\u3059\u3079\u3066\u306e\u30b5\u30fc\u30d3\u30b9\u64cd\u4f5c\u304c\u6b63\u5e38\u306b\u5b8c\u4e86\u3057\u307e\u3057\u305f\u3002 \u2022 \u30a8\u30e9\u30fc\u30b3\u30fc\u30c9\u304c\u30af\u30ea\u30a2\u3055\u308c\u307e\u3057\u305f \u2022 \u71c3\u6599\u30c8\u30ea\u30e0\u306e\u30ea\u30bb\u30c3\u30c8 \u30fbECU\u30ea\u30bb\u30c3\u30c8 \u8eca\u4e21\u3092\u518d\u59cb\u52d5\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"},info:{desc:"\u30aa\u30fc\u30c8\u30d0\u30a4\u304a\u3088\u3073\u8eca\u4e21\u306e\u5c02\u9580\u7684\u306a\u8a3a\u65ad\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3002 \u3059\u3079\u3066\u306e\u8eca\u4e21\u306b\u5bfe\u5fdc\u3057\u307e\u3059\u3002",upgrade:" Cortex OBD2 Diagnostic Scanner PRO \u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9",upgradeAlert:"\u65e9\u671f\u30a2\u30af\u30bb\u30b9 ",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner \u306f\u73fe\u5728\u958b\u767a\u4e2d\u3067\u3059\u3002\u3042\u306a\u305f\u306f\u521d\u671f\u306e\u30e6\u30fc\u30b6\u30fc\u3067\u3042\u308b\u305f\u3081\u3001\u3059\u3079\u3066\u306e\u30d7\u30ed\u6a5f\u80fd\u3092\u4eca\u3059\u3050\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u306f\u79c1\u305f\u3061\u306b\u3068\u3063\u3066\u975e\u5e38\u306b\u8cb4\u91cd\u3067\u3059\u3002",helpGuide:"\u30d8\u30eb\u30d7\u3068\u30ac\u30a4\u30c9",language:" \u8a00\u8a9e / \u8a00\u8a9e / \u30d0\u30cf\u30b5\u8a9e",support:"\u30b5\u30dd\u30fc\u30c8\u30bb\u30f3\u30bf\u30fc",supportSubject:"Cortex OBD2 Diagnostic Scanner \u306e\u30b5\u30dd\u30fc\u30c8\u3068\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af",thanks:"\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01",thanksDesc:"\u3054\u610f\u898b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002 Play\u30b9\u30c8\u30a2\u306b\u30b3\u30e1\u30f3\u30c8\u3092\u6b8b\u3057\u3066\u304f\u3060\u3055\u3044\u3002",sections:{live:{title:"\u30e9\u30a4\u30d6\u30e2\u30cb\u30bf\u30ea\u30f3\u30b0\u30bb\u30f3\u30b5\u30fc",content:"RPM\u3001\u901f\u5ea6\u3001\u30a8\u30f3\u30b8\u30f3\u6e29\u5ea6\u3001\u30b9\u30ed\u30c3\u30c8\u30eb\u4f4d\u7f6e\u3001\u30d0\u30c3\u30c6\u30ea\u30fc\u96fb\u5727\u3001\u30a8\u30f3\u30b8\u30f3\u8ca0\u8377\u3001\u5438\u6c17\u6e29\u5ea6\u3001\u30de\u30cb\u30db\u30fc\u30eb\u30c9\u5727\u529b (MAP) \u3092\u77ac\u6642\u306b\u76e3\u8996\u3067\u304d\u307e\u3059\u3002 Bluetooth \u306e\u901f\u5ea6\u306b\u5fdc\u3058\u3066\u3001\u5024\u306f 1 \u79d2\u3042\u305f\u308a 1 \uff5e 5 \u56de\u66f4\u65b0\u3055\u308c\u307e\u3059\u3002\u30bf\u30fc\u30df\u30ca\u30eb\u7d4c\u7531\u3067 UDS / OBD \u30b3\u30de\u30f3\u30c9\u3092\u4f7f\u7528\u3057\u3066\u8eca\u4e21\u306b\u76f4\u63a5\u4ecb\u5165\u3067\u304d\u307e\u3059\u3002"},expertise:{title:"\u691c\u67fb\u3068\u4fdd\u8a3c",content:"\u3053\u306e\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u306f\u3001ECU (Brain) \u30b3\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u30a8\u30e9\u30fc\u3092\u691c\u51fa\u3057\u307e\u3059\u3002\u8eca\u4e21\u306b\u8a18\u9332\u3055\u308c\u3066\u3044\u308b VIN \u756a\u53f7 (VIN) \u3068\u73fe\u5728\u306e\u8d70\u884c\u8ddd\u96e2\u304c\u53d6\u5f97\u3055\u308c\u307e\u3059\u3002 \u3055\u3089\u306b\u3001\u904e\u53bb\u306e\u30a8\u30e9\u30fc\u306f\u3001\u30c1\u30a7\u30c3\u30af \u30a8\u30f3\u30b8\u30f3 \u30e9\u30a4\u30c8\u3067\u8eca\u4e21\u304c\u8d70\u884c\u3057\u305f\u8ddd\u96e2\u3092\u8a08\u7b97\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u5224\u65ad\u3055\u308c\u307e\u3059\u3002\u4f5c\u6210\u3055\u308c\u305f\u30ec\u30dd\u30fc\u30c8\u306f\u3001PDF \u304a\u3088\u3073\u30e1\u30c3\u30bb\u30fc\u30b8\u30f3\u30b0\u74b0\u5883\u3067\u5171\u6709\u3067\u304d\u307e\u3059\u3002"},tests:{title:"\u30d0\u30c3\u30c6\u30ea\u30fc/\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30c6\u30b9\u30c8",content:"\u30d0\u30c3\u30c6\u30ea\u30fc\u30c6\u30b9\u30c8\u306b\u306f 3 \u3064\u306e\u6bb5\u968e\u304c\u3042\u308a\u307e\u3059: \u4f11\u6b62\u3001\u30af\u30e9\u30f3\u30ad\u30f3\u30b0\u3001\u30a2\u30a4\u30c9\u30eb\u5145\u96fb\u30c6\u30b9\u30c8\u3067\u306f\u3001\u30d0\u30c3\u30c6\u30ea\u30fc/\u30ec\u30ae\u30e5\u30ec\u30fc\u30bf\u30fc\u306e\u72b6\u614b\u3092\u6e2c\u5b9a\u3057\u307e\u3059\u3002 \u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9 \u30c6\u30b9\u30c8\u3067\u306f\u3001\u643a\u5e2f\u96fb\u8a71\u306e\u30d7\u30ed\u30bb\u30c3\u30b5\u3068\u8eca\u4e21\u304b\u3089\u306e\u77ac\u9593\u901f\u5ea6\u30c7\u30fc\u30bf\u3092\u4f7f\u7528\u3057\u3066\u30010 \uff5e 60 km/h \u304a\u3088\u3073 0 \uff5e 100 km/h \u306e\u52a0\u901f\u5024\u3092 50 \u30df\u30ea\u79d2\u306e\u8aa4\u5dee\u306e\u7bc4\u56f2\u3067\u6e2c\u5b9a\u3057\u307e\u3059\u3002"},hardware:{title:"\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u306e\u4e92\u63db\u6027",content:"ELM327 Bluetooth (v1.5) \u3092\u63a8\u5968\u3057\u307e\u3059\u3002\u4e00\u90e8\u306e\u9ad8\u5ea6\u306a\u30b3\u30fc\u30c9\u306f\u3001v2.1 CLONE \u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u4f4e\u54c1\u8cea\u306e\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u3067\u306f\u52d5\u4f5c\u3057\u306a\u3044\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002 vLinker \u3084 OBDLink \u306a\u3069\u306e\u30d7\u30ec\u30df\u30a2\u30e0 \u30a2\u30c0\u30d7\u30bf\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u6700\u901f\u306e\u901f\u5ea6\u304c\u5f97\u3089\u308c\u307e\u3059\u3002"},warnings:{title:"\u91cd\u8981\u306a\u8b66\u544a",content:"\u2022 \u30d5\u30a9\u30eb\u30c8\u30b3\u30fc\u30c9\u524a\u9664\u30d7\u30ed\u30bb\u30b9\u307e\u305f\u306f ECU \u30ea\u30bb\u30c3\u30c8\u6a5f\u80fd\u4e2d\u306f\u3001\u30a4\u30b0\u30cb\u30c3\u30b7\u30e7\u30f3\u3092 ON \u306b\u3057\u3001\u30a8\u30f3\u30b8\u30f3\u3092 OFF \u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002 \u2022 \u8d70\u884c\u4e2d\u306e\u8eca\u4e21\u306b\u30ea\u30bb\u30c3\u30c8\u3092\u9001\u4fe1\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002 \u2022 \u3059\u3079\u3066\u306e\u8eca\u4e21\u304c\u3059\u3079\u3066\u306e\u30bb\u30f3\u30b5\u30fc\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u306a\u3044\u30bb\u30f3\u30b5\u30fc\u306b\u306f\u300c--\u300d\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"},onboarding:{title:"\u6cd5\u7684\u8a31\u53ef\u3068\u533f\u540d\u30c6\u30ec\u30e1\u30c8\u30ea",content:"\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u306e\u54c1\u8cea\u3068\u8eca\u4e21\u306e\u4e92\u63db\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u3002\u5b8c\u5168\u306b\u533f\u540d\u5316\u3055\u308c\u305f\u30a8\u30f3\u30b8\u30f3\u30d1\u30e9\u30e1\u30fc\u30bf\u3068\u6545\u969c\u8a3a\u65ad\u4e2d\u306b\u751f\u6210\u3055\u308c\u305f\u6545\u969c\u30b3\u30fc\u30c9\uff08\u500b\u4eba\u30c7\u30fc\u30bf\u3084\u8eca\u53f0\u756a\u53f7\u306f\u542b\u307e\u308c\u306a\u3044\uff09\u306f\u3001\u5f53\u793e\u306e\u5b89\u5168\u306a\u30b5\u30fc\u30d0\u30fc\u3067\u5206\u6790\u3067\u304d\u307e\u3059\u3002\u7d9a\u884c\u3059\u308b\u3068\u3001\u3053\u308c\u3089\u306e\u533f\u540d\u30c6\u30ec\u30e1\u30c8\u30ea\u898f\u7d04\u306b\u540c\u610f\u3057\u305f\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002 \u30aa\u30fc\u30c8\u30d0\u30a4\u306e ECU \u3068\u901a\u4fe1\u3059\u308b\u306b\u306f\u3001Bluetooth \u3068\u4f4d\u7f6e\u60c5\u5831\u306e\u8a31\u53ef\u304c\u5fc5\u8981\u3067\u3059\u3002"},featureCoding:{title:"\u96a0\u3057\u6a5f\u80fd\u306e\u30ed\u30c3\u30af\u89e3\u9664\u3068 UDS \u30b3\u30fc\u30c7\u30a3\u30f3\u30b0",content:"\u5f53\u793e\u306e ISO 14229 UDS \u30d7\u30ed\u30c8\u30b3\u30eb \u30a8\u30f3\u30b8\u30f3\u3092\u642d\u8f09\u3057\u3001US \u30d1\u30fc\u30ad\u30f3\u30b0 \u30e9\u30a4\u30c8\u3001\u30cb\u30fc\u30c9\u30eb \u30b9\u30a4\u30fc\u30d7\u3001\u30db\u30fc\u30f3 \u30a2\u30c3\u30af \u30e