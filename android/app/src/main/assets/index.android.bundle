rnal backups, but failure to comply with safety rules can risk module lockouts.",check1:"I confirm that the vehicle battery is stable (>= 12.4V) and ignition is ON.",check2:"I understand that incorrect coding may require a factory reset and accept all liability.",proceed:"WRITE PARAMETERS"},hiddenFeatures:{title:"\u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902",btnLabel:"\u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902",unsupported:"\u092f\u0939 OBD2 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u0913\u0902 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964",unsupportedDesc:"\u092e\u0942\u0932 ELM327 v2.1 \u092f\u093e \u0909\u0938\u0938\u0947 \u090a\u092a\u0930 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u0932\u094b\u0928 \u090f\u0921\u093e\u092a\u094d\u091f\u0930 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964",notConnected:"\u092a\u0939\u0932\u0947 \u0935\u093e\u0939\u0928 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0964",notConnectedDesc:"OBD2 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964",warning:"\u092f\u0947 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",confirmTitle:"\u092a\u0941\u0937\u094d\u091f\u093f \u0906\u0935\u0936\u094d\u092f\u0915",confirmMsg:"\u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u094b \u092c\u0926\u0932\u0928\u0947 \u0938\u0947 ECU \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902?",confirmOk:"\u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",confirmCancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902",categoryLighting:"\u092a\u094d\u0930\u0915\u093e\u0936 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e",categorySound:"\u0927\u094d\u0935\u0928\u093f \u0914\u0930 \u091a\u0947\u0924\u093e\u0935\u0928\u0940",categoryDisplay:"\u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u092a\u0948\u0928\u0932",categoryDriving:"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917",featureDrl:"\u0926\u093f\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u091a\u0932\u0928\u0947 \u0935\u093e\u0932\u0940 \u0930\u094b\u0936\u0928\u0940",featureRearFog:"\u0930\u093f\u092f\u0930 \u092b\u0949\u0917 \u0932\u093e\u0907\u091f \u0913\u0935\u0930\u0930\u093e\u0907\u0921",featureDoorChime:"\u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0918\u0902\u091f\u0940 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902",featureParkingAlert:"\u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092c\u094d\u0930\u0947\u0915 \u0927\u094d\u0935\u0928\u093f \u0905\u0932\u0930\u094d\u091f",featureRpmWarning:"RPM \u0938\u0940\u092e\u093e \u091a\u0947\u0924\u093e\u0935\u0928\u0940",featureFuelSensitivity:"\u0908\u0902\u0927\u0928 \u0917\u0947\u091c \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e",featureStartStop:"\u0938\u094d\u091f\u093e\u0930\u094d\u091f-\u0938\u094d\u091f\u0949\u092a \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u092c\u0902\u0926",featureSportMemory:"\u0938\u094d\u092a\u094b\u0930\u094d\u091f \u092e\u094b\u0921 \u092e\u0947\u092e\u094b\u0930\u0940",enabled:"\u0938\u0915\u094d\u0937\u092e",disabled:"\u0905\u0915\u094d\u0937\u092e",writeSuccess:"\u0938\u0941\u0935\u093f\u0927\u093e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u092a\u0921\u0947\u091f \u0915\u0940 \u0917\u0908\u0964",writeError:"\u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",simulationBanner:"\u0938\u093f\u092e\u0941\u0932\u0947\u0936\u0928 \u092e\u094b\u0921 \u2014 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 ECU \u0930\u093e\u0907\u091f\u093f\u0902\u0917 \u0905\u092d\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0928\u0939\u0940\u0902 \u0939\u0948",closeBtn:"\u092c\u0902\u0926 \u0915\u0930\u0947\u0902",unsupportedOk:"OK",disclaimerTitle:"\u0926\u093e\u092f\u093f\u0924\u094d\u0935 \u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0923",disclaimerFeature:"\u0935\u093f\u0936\u0947\u0937\u0924\u093e",disclaimerBody:"\u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u094b \u092c\u0926\u0932\u0928\u0947 \u0938\u0947 \u0938\u0940\u0927\u0947 \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0915\u0940 \u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0914\u0930 ECU \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u091c\u094b\u0916\u093f\u092e\u094b\u0902 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u092a\u0922\u093c\u0947\u0902: \u2022 \u0917\u0932\u0924 \u0906\u0935\u0947\u0926\u0928 \u0938\u0947 \u0906\u092a\u0915\u0947 \u0935\u093e\u0939\u0928 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u0916\u093c\u0924\u094d\u092e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964\n\u2022 \u0915\u0941\u091b \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0938\u094d\u0925\u093e\u092f\u0940 \u0916\u0930\u093e\u092c\u0940 \u092f\u093e \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u093e\u0936\u093f\u0924 \u0935\u093f\u0926\u094d\u092f\u0941\u0924 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u093e\u0901 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964\n\u2022 \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0911\u092a\u0930\u0947\u0936\u0928 \u0909\u0932\u091f\u093e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948, \u0915\u0941\u091b \u0908\u0938\u0940\u092f\u0942 \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0915\u094b \u092b\u093c\u0948\u0915\u094d\u091f\u0930\u0940 \u0930\u0940\u0938\u0947\u091f \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964\n\u2022 \u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092f\u093e \u0905\u092d\u094c\u0924\u093f\u0915 \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u0948\u0964\n\u2022 \u0907\u0928 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0916\u0930\u093e\u092c\u0940 \u092f\u093e \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 OBD2 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u094d\u0915\u0948\u0928\u0930 \u0915\u094b \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0928\u0939\u0940\u0902 \u0920\u0939\u0930\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u094b \u092f\u0939 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0928\u0940 \u0939\u094b\u0917\u0940 \u0915\u093f \u0906\u092a\u0928\u0947 \u092f\u0939 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092a\u0922\u093c \u0914\u0930 \u0938\u092e\u091d \u0932\u0940 \u0939\u0948\u0964",checkboxTitle:"\u092a\u0941\u0937\u094d\u091f\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948",check1:"\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092a\u0922\u093c \u0932\u0940 \u0939\u0948 \u0914\u0930 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092e\u0947\u0930\u0947 \u0935\u093e\u0939\u0928 \u0915\u0940 \u0935\u093e\u0930\u0902\u091f\u0940 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",check2:"\u092e\u0948\u0902 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0915\u0949\u0930\u094d\u091f\u0947\u0915\u094d\u0938 \u0913\u092c\u0940\u0921\u09402 \u0921\u093e\u092f\u0917\u094d\u0928\u094b\u0938\u094d\u091f\u093f\u0915 \u0938\u094d\u0915\u0948\u0928\u0930 \u0907\u0938 \u0911\u092a\u0930\u0947\u0936\u0928 \u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0916\u0930\u093e\u092c\u0940 \u092f\u093e \u0915\u094d\u0937\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",check3:"\u092e\u0948\u0902 \u0938\u092d\u0940 \u091c\u094b\u0916\u093f\u092e\u094b\u0902 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0938\u094d\u0935\u0924\u0902\u0924\