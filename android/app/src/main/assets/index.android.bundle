A",resume:"RETOMAR",share:"COMPARTILHE",clear:"LIMPAR",clearDtcs:"LIMPAR DTC",dtcTitle:"DIAGN\xd3STICO DTC E C\xd3DIGOS DE FALHA",noDtcs:"NENHUM C\xd3DIGO DTC ENCONTRADO NA ECU",readDtcs:"LER DTC",sendDtcs:"ENVIAR"},health:{titleMenu:"SA\xdaDE E CAPACIDADE OBD2",adapterQuality:"QUALIDADE E DESEMPENHO DO ADAPTADOR",excellent:"EXCELENTE",good:"BOM",clone:"INCOMPAT\xcdVEL / CLONE",firmware:"Vers\xe3o do firmware:",capScore:"Pontua\xe7\xe3o de capacidade",latency:"Lat\xeancia",protocol:"Protocolo ativo",featureSupport:"MATRIZ DE RECURSOS DO APLICATIVO",matrixReadCodes:"Ler e apagar c\xf3digos de falha",matrixLiveSensors:"Monitoramento de sensores ao vivo",matrixBattery:"Teste de bateria / tens\xe3o",matrixHighSpeed:"Telemetria de alta velocidade",matrixCoding:"Codifica\xe7\xe3o e adapta\xe7\xf5es da ECU",active:"Ativo",degraded:"Degradado",locked:"Bloqueado",warning:"BLOQUEIO DE SEGURAN\xc7A:",lockExplain:"Seu adaptador foi identificado como um chip clone/falso. Como adaptadores clone carecem de precis\xe3o de temporiza\xe7\xe3o e podem danificar o ve\xedculo durante opera\xe7\xf5es de escrita, os recursos de codifica\xe7\xe3o e adapta\xe7\xe3o est\xe3o bloqueados. Obtenha um dispositivo original ELM327 v2.1 ou vLinker para codifica\xe7\xe3o segura.",vehiclePids:"LISTA DE VERIFICA\xc7\xc3O DE SENSORES DO VE\xcdCULO",checklistPrompt:"Os par\xe2metros de sensor padr\xe3o suportados pela ECU do seu ve\xedculo est\xe3o listados abaixo. Sensores sem marca de verifica\xe7\xe3o n\xe3o s\xe3o relatados pelo seu ve\xedculo.",supportedBadge:"SUPORTADO",unsupportedBadge:"N\xc3O SUPORTADO",backToExpertise:"BACK TO DIAGNOSTICS",tabHardware:"HARDWARE",tabModes:"MODES",tabTopology:"ECU NETWORK",tabReadiness:"I/M READINESS",tabVehicles:"VEHICLES",chipType:"Detected Chipset:",atCommands:"AT Command Set Benchmark",mode01:"Mode 01: Live Sensor Stream",mode02:"Mode 02: Freeze Frame Snapshot",mode03:"Mode 03 & 07: Fault Codes",mode04:"Mode 04: Clear DTCs & Reset MIL",mode06:"Mode 06: On-Boa