atterie auxiliaire de d\xe9marrage/support AGM dans la PCU."},vag_comfort_turn_signal:{name:"Nombre de clignotements des clignotants de confort (VAG)",desc:"Ajuste le nombre de cycles des clignotants de changement de voie entre 3, 4 et 5 clignotements."},vag_coming_home_duration:{name:"Dur\xe9e d'\xe9clairage d'arriv\xe9e/de d\xe9part de la maison (VAG)",desc:"Configure la minuterie d'\xe9clairage des phares apr\xe8s le verrouillage du v\xe9hicule (10 s - 60 s)."},vag_remote_windows:{name:"Commande de fen\xeatre de commodit\xe9 \xe0 distance (VAG)",desc:"Permet d'ouvrir et de fermer les vitres \xe9lectriques via un appui long sur la t\xe9l\xe9commande."},vag_auto_lock_15kmh:{name:"Verrouillage automatique des portes \xe0 15 km/h (VAG)",desc:"Verrouille automatiquement toutes les portes lorsque la vitesse du v\xe9hicule atteint 15 km/h."},vag_sfd_unlock_prep:{name:"Pr\xe9paration de l'\xe9tat de protection de la passerelle SFD (VAG 2020+)",desc:"Pr\xe9pare la session de jeton de passerelle MQB-evo SFD pour l'\xe9criture de DID prot\xe9g\xe9s."},bmw_asd_deactivate:{name:"D\xe9sactivation de la conception sonore active (ASD) (BMW)",desc:"Coupe le son synth\xe9tique du moteur diffus\xe9 par les haut-parleurs de l'habitacle."},bmw_comfort_turn_signal:{name:"Nombre de clignotants confort (BMW)",desc:"D\xe9finit le nombre d\u2019impulsions de l\u2019indicateur \xe0 une touche (1 \xe0 5 clignotements)."},bmw_mirror_fold_lock:{name:"R\xe9troviseur d'acc\xe8s confort repliable sur verrouillage (BMW)",desc:"Rabattre automatiquement les r\xe9troviseurs lat\xe9raux imm\xe9diatement apr\xe8s le verrouillage du v\xe9hicule."},toyota_coming_home_duration:{name:"Retard de courtoisie des phares / retour \xe0 la maison (Toyota)",desc:"Configure le d\xe9lai d'extinction des phares apr\xe8s la coupure du contact (30 s-120 s)."},toyota_lane_change_flash:{name:"Nombre de clignotements des clignotants de changement de voie (Toyota)",desc:"Ajuste le nombre de cycles du clignotant de changem