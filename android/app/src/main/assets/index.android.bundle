0928 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0947\u0902",scanning:"\u0938\u094d\u0915\u0948\u0928\u093f\u0902\u0917...",vehicleIdentity:"\u0935\u093e\u0939\u0928 \u0906\u0908\u0921\u0940 \u0914\u0930 \u092e\u093e\u0907\u0932\u0947\u091c",vin:"\u091a\u0947\u0938\u093f\u0938 \u0928\u0902\u092c\u0930 (VIN)",odometer:"\u092e\u0942\u0932 \u0915\u093f\u092e\u0940",distSinceCleared:"\u0924\u094d\u0930\u0941\u091f\u093f \u0938\u093e\u092b\u093c \u0915\u0940 \u0917\u0908",milDist:"\u0907\u0902\u091c\u0928 \u0932\u093e\u0907\u091f \u091a\u093e\u0932\u0942",dtcTitle:"\u0926\u094b\u0937 \u0915\u094b\u0921 (\u0921\u0940\u091f\u0940\u0938\u0940)",dtcClean:"\u0915\u094b\u0908 \u0924\u094d\u0930\u0941\u091f\u093f \u0915\u094b\u0921 \u0928\u0939\u0940\u0902 - \u0938\u093e\u092b\u093c",extraActions:"\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0932\u0947\u0928-\u0926\u0947\u0928",garageTitle:"\u0917\u0948\u0930\u093e\u091c \u0914\u0930 \u092a\u093f\u091b\u0932\u0947 \u0930\u093f\u0915\u0949\u0930\u094d\u0921",share:"\u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902",saveVehicle:"\u0907\u0938 \u0909\u092a\u0915\u0930\u0923 \u0915\u094b \u0938\u0939\u0947\u091c\u0947\u0902",noRecords:"\u0905\u092d\u0940 \u0924\u0915 \u0915\u094b\u0908 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0935\u093e\u0939\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902.",clean:"\u0938\u093e\u092b",faults:"\u0935\u093f\u092b\u0932\u0924\u093e",vinRequired:"\u0935\u0940\u0906\u0908\u090f\u0928 \u0906\u0935\u0936\u094d\u092f\u0915",vinRequiredDesc:"\u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u091a\u0947\u0938\u093f\u0938 \u0928\u0902\u092c\u0930 (\u0935\u0940\u0906\u0908\u090f\u0928) \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092a\u094d\u0930\u0915\u091f \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u092f\u093e \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0930\u0942\u092a \u093