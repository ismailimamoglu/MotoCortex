c2dc\ubcf4\ub808/GMC",dodge:"\ub2f7\uc9c0 / RAM / \uc9c0\ud504",byd:"BYD EV",stellantis:"\uc2a4\ud154\ub780\ud2f0\uc2a4 / \ud53c\uc544\ud2b8"},permissions:{headerSubtitle:"\uad8c\ud55c \ud328\ub110",cardTitle:"\ud558\ub4dc\uc6e8\uc5b4 \uc561\uc138\uc2a4 \ud544\uc694",cardDesc:"\uc560\ud50c\ub9ac\ucf00\uc774\uc158 \ud488\uc9c8\uacfc \ucc28\ub7c9 \ud638\ud658\uc131\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud574 \uacb0\ud568 \uc9c4\ub2e8 \uc911\uc5d0 \uc0dd\uc131\ub41c \uc644\uc804\ud788 \uc775\uba85\ud654\ub41c \uc5d4\uc9c4 \ub9e4\uac1c\ubcc0\uc218\uc640 \uacb0\ud568 \ucf54\ub4dc(\uac1c\uc778 \ub370\uc774\ud130 \ubc0f \uc100\uc2dc \ubc88\ud638\ub97c \ud3ec\ud568\ud558\uc9c0 \uc54a\uc74c)\ub97c \ub2f9\uc0ac\uc758 \ubcf4\uc548 \uc11c\ubc84\uc5d0\uc11c \ubd84\uc11d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacc4\uc18d\ud558\uba74 \uc774\ub7ec\ud55c \uc775\uba85 \uc6d0\uaca9 \uce21\uc815 \uc57d\uad00\uc5d0 \ub3d9\uc758\ud558\uac8c \ub429\ub2c8\ub2e4.",btLabel:"\ube14\ub8e8\ud22c\uc2a4(BLE)",btSub:"ELM327/OBD2 \uc5b4\ub311\ud130\uc640 \ud398\uc5b4\ub9c1\ud558\uace0 \ub77c\uc774\ube0c CAN \ubc84\uc2a4/K-\ub77c\uc778 \ub370\uc774\ud130\ub97c \uc2a4\ud2b8\ub9ac\ubc0d\ud558\ub294 \ub370\uc5d0\ub9cc \uc0ac\uc6a9\ub429\ub2c8\ub2e4.",locLabel:"\uc704\uce58 \uad8c\ud55c",locSub:"\uadfc\ucc98\uc758 \uc800\uc5d0\ub108\uc9c0 Bluetooth \uc7a5\uce58\ub97c \ucc3e\ub294 \uac83\uc740 Android \uc2dc\uc2a4\ud15c \uc544\ud0a4\ud14d\ucc98\uc5d0 \ub530\ub77c \ud544\uc218\uc785\ub2c8\ub2e4. \uc6b0\ub9ac\ub294 \uadc0\ud558\uc758 \uc6b4\uc804\uc744 \ucd94\uc801\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",grantBtn:"\ud5c8\uc6a9\ud558\uace0 \uacc4\uc18d",skipBtn:"\uc9c0\uae08\uc740 \uac74\ub108\ub6f0\uae30(\ub370\ubaa8 \ubaa8\ub4dc)",deniedDesc:"\uc77c\ubd80 \ud5c8\uac00\uac00 \uac70\ubd80\ub418\uc5c8\uc2b5\ub2c8\ub2e4. Cortex OBD2 Diagnostic Scanner\ub294 OBD2 \uc7a5\uce58\ub97c \uc131\uacf5\uc801\uc73c\ub85c \uc2a4\uce94\ud558\uac70\ub098 \uc5f0\uacb0\ud558\uc9c0 \ubabb\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",proceedAnyway:"\uc5b4\uca0c\ub4e0 \uacc4\uc18d\ud574\ub77c",openSettings:"\uc124\uc815 \uc5f4\uae30",langTitle:"\uc5b8\uc5b4 \uc120\ud0dd",nextBtn:"\uacc4\uc18d",langDesc:"\uc6d0\ud558\ub294 \uc5b8\uc5b4\ub97c \uc120\ud0dd\ud558\uc138\uc694.",langSelectSub:"\uc5b8\uc5b4 \uac8c\uc774\ud2b8\uc6e8\uc774",telemetryLabel:"\uc9c4\ub2e8 \uc6d0\uaca9 \uce21\uc815(\uc120\ud0dd)",telemetrySub:"\uc775\uba85\uc758 \ud504\ub85c\ud1a0\ucf5c\uacfc \uc624\ub958 \ub85c\uadf8\ub97c \uacf5\uc720\ud558\uc5ec \ucc28\ub7c9 \ud638\ud658\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4.",restartOnboarding:"\ucd08\uae30 \uc124\uc815 \uc7ac\uc2dc\uc791 (\uc5b8\uc5b4 \ubc0f \uad8c\ud55c)"},disclaimer:"\ubaa8\ub4e0 \uc81c\ud488 \uc774\ub984, \ub85c\uace0 \ubc0f \ube0c\ub79c\ub4dc\ub294 \ud574\ub2f9 \uc18c\uc720\uc790\uc758 \uc790\uc0b0\uc785\ub2c8\ub2e4. \ubcf8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc5d0 \uc0ac\uc6a9\ub41c \ubaa8\ub4e0 \ud68c\uc0ac, \uc81c\ud488 \ubc0f \uc11c\ube44\uc2a4 \uc774\ub984\uc740 \uc2dd\ubcc4 \ubaa9\uc801\uc73c\ub85c\ub9cc \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\ub984, \ub85c\uace0 \ubc0f \ube0c\ub79c\ub4dc\ub97c \uc0ac\uc6a9\ud55c\ub2e4\uace0 \ud574\uc11c \uc5b4\ub5a0\ud55c \ubcf4\uc99d\uc774\ub098 \ud6c4\uc6d0\uc744 \uc758\ubbf8\ud558\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.",hiddenFeatures:{title:"\uc228\uaca8\uc9c4 \uae30\ub2a5",btnLabel:"\uc228\uaca8\uc9c4 \uae30\ub2a5 \uc7a0\uae08 \ud574\uc81c",unsupported:"\uc774 OBD2 \uc5b4\ub311\ud130\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5 \uc7a0\uae08 \ud574\uc81c\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",unsupportedDesc:"\uc815\ud488 ELM327 v2.1 \uc774\uc0c1\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ud074\ub860 \uc5b4\ub311\ud130\ub294 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",notConnected:"\uba3c\uc800 \ucc28\ub7c9\uc5d0 \uc5f0\uacb0\ud558\uc138\uc694.",notConnectedDesc:"OBD2 \uc7a5\uce58\uac00 \uc5f0\uacb0\ub418\uc5b4 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4.",warning:"\uc774\ub7ec\ud55c \ubcc0\uacbd \uc0ac\ud56d\uc740 \ucc28\ub7c9 \ubcf4\uc99d\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",confirmTitle:"\ud655\uc778 \ud544\uc694",confirmMsg:"\uc774 \uae30\ub2a5\uc744 \ubcc0\uacbd\ud558\uba74 ECU \uc124\uc815\uc5d0 \uc601\ud5a5\uc744 \uc90d\ub2c8\ub2e4. \uacc4\uc18d\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",confirmOk:"\uacc4\uc18d",confirmCancel:"\ucde8\uc18c",categoryLighting:"\uc870\uba85",categorySound:"\uc0ac\uc6b4\ub4dc \ubc0f \uacbd\uace0",categoryDisplay:"\uacc4\uae30\ud310",categoryDriving:"\uc8fc\ud589",featureDrl:"\uc8fc\uac04 \uc8fc\ud589\ub4f1 (DRL)",featureRearFog:"\ud6c4\ubc29 \uc548\uac1c\ub4f1 \uc624\ubc84\ub77c\uc774\ub4dc",featureDoorChime:"\ub3c4\uc5b4 \ucc28\uc784 \ube44\ud65c\uc131\ud654",featureParkingAlert:"\uc8fc\ucc28 \ube0c\ub808\uc774\ud06c \uacbd\ubcf4\uc74c",featureRpmWarning:"RPM \ud55c\ub3c4 \uacbd\uace0",featureFuelSensitivity:"\uc5f0\ub8cc\uacc4 \uac10\ub3c4",featureStartStop:"\uc2a4\ud0c0\ud2b8-\uc2a4\ud1b1 \uae30\ubcf8 \uaebc\uc9d0",featureSportMemory:"\uc2a4\ud3ec\uce20 \ubaa8\ub4dc \uba54\ubaa8\ub9ac",enabled:"\ud65c\uc131\ud654",disabled:"\ube44\ud65c\uc131\ud654",writeSuccess:"\uae30\ub2a5\uc774 \uc131\uacf5\uc801\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",writeError:"\uc4f0\uae30 \uc624\ub958. \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694.",simulationBanner:"\uc2dc\ubbac\ub808\uc774\uc158 \ubaa8\ub4dc \u2014 \uc2e4\uc81c ECU \uc4f0\uae30\uac00 \uc544\uc9c1 \ud65c\uc131\ud654\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4",closeBtn:"\ub2eb\uae30",unsupportedOk:"OK",disclaimerTitle:"\ucc45\uc784 \uba74\ucc45\uc870\ud56d",disclaimerFeature:"\ud2b9\uc9d5",disclaimerBody:"\uc774 \uae30\ub2a5\uc744 \ubcc0\uacbd\ud558\uba74 \ucc28\ub7c9\uc758 \uacf5\uc7a5 \uc124\uc815\uacfc ECU \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub2e4\uc74c \uc704\ud5d8\uc744 \uc8fc\uc758 \uae4a\uac8c \uc77d\uc5b4 \ubcf4\uc2ed\uc2dc\uc624.\n\n\u2022 \uc798\ubabb \uc801\uc6a9\ud558\uba74 \ucc28\ub7c9 \ubcf4\uc99d\uc774 \ubb34\ud6a8\ud654\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\u2022 \uc77c\ubd80 \ubcc0\uacbd\uc73c\ub85c \uc778\ud574 \uc601\uad6c\uc801\uc778 \uc624\ub958\ub098 \uc608\uc0c1\uce58 \ubabb\ud55c \uc804\uae30 \uc624\ub958\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\u2022 \uc791\uc5c5\uc744 \ub418\ub3cc\ub9b4 \uc218 \uc788\uc9c0\ub9cc \uc77c\ubd80 ECU \ubaa8\ub4c8\uc740 \uacf5\uc7a5 \ucd08\uae30\ud654\uac00 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\u2022 \uc774 \uae30\ub2a5\uc758 \uc0ac\uc6a9\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \ubb3c\uc9c8\uc801 \ub610\ub294 \ube44\ubb3c\uc9c8\uc801 \uc190\ud574\uc5d0 \ub300\ud55c \ucc45\uc784\uc740 \uc804\uc801\uc73c\ub85c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uc788\uc2b5\ub2c8\ub2e4.\n\u2022 Cortex OBD2 \uc9c4\ub2e8 \uc2a4\uce90\ub108\ub294 \uc774\ub7ec\ud55c \ubcc0\uacbd\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \uc624\uc791\ub3d9\uc774\ub098 \uc190\uc0c1\uc5d0 \ub300\ud574 \ucc45\uc784\uc744 \uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\n\uadc0\ud558\ub294 \uc774 \uacbd\uace0\ub97c \uc77d\uace0 \uc774\ud574\ud588\uc74c\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.",checkboxTitle:"\ud655\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4",check1:"\ub098\ub294 \uc774 \uacbd\uace0\ub97c \uc77d\uc5c8\uc73c\uba70 \ub0b4 \ucc28\ub7c9 \ubcf4\uc99d\uc774 \uc601\ud5a5\uc744 \ubc1b\uc744 \uc218 \uc788\uc74c\uc744 \uc774\ud574\ud569\ub2c8\ub2e4.",check2:"\ub098\ub294 Cortex OBD2 \uc9c4\ub2e8 \uc2a4\uce90\ub108\uac00 \uc774 \uc791\uc5c5\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud558\ub294 \uc5b4\ub5a0\ud55c \uacb0\ud568\uc774\ub098 \uc190\uc0c1\uc5d0 \ub300\ud574\uc11c\ub3c4 \ucc45\uc784\uc744 \uc9c0\uc9c0 \uc54a\uc74c\uc744 \uc778\uc815\ud569\ub2c8\ub2e4.",check3:"\ub098\ub294 \ubaa8\ub4e0 \uc704\ud5d8\uc744 \uac10\uc218\ud558\uba74\uc11c \uace0\uc758\ub85c \uadf8\ub9ac\uace0 \ub098 \uc790\uc2e0\uc758 \uc790\uc720 \uc758\uc9c0\ub85c \uc774\ub7ec\ud55c \ubcc0\ud654\ub97c \ub9cc\ub4e4\uace0 \uc2f6\uc2b5\ub2c8\ub2e4.",disclaimerCancel:"\ucde8\uc18c",disclaimerContinue:"\uacc4\uc18d",unsupportedTitle:"\uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc74c",unsupportedMsg:"\uc5f0\uacb0\ub41c OBD2 \uc7a5\uce58\ub294 \uc544\uc9c1 \uc774 \uae30\ub2a5\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\n\uc228\uaca8\uc9c4 \uae30\ub2a5\uc744 \uc791\uc131\ud558\ub824\uba74 \ud638\ud658 \uac00\ub2a5\ud55c ELM327 v2.1+ \uc5b4\ub311\ud130\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubcf5\uc81c \ub610\ub294 \ud45c\uc900 \uc5b4\ub311\ud130\ub294 \uc774\ub7ec\ud55c \uba85\ub839\uc744 \ucc98\ub9ac\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},disconnectShort:"\ud574\uc81c",obdTerminal:{title:"Obd \uac74\uac15 \ubc0f \ud130\ubbf8\ub110",terminalTitle:"obd \ud130\ubbf8\ub110",terminalPlaceholder:"ECU(\uc608: 010C, ATRV)\ub85c \ubcf4\ub0b4\ub824\uba74 \uc544\ub798 \uba85\ub839\uc744 \uc785\ub825\ud558\uc138\uc694.",inputPlaceholder:"\uba85\ub839\uc744 \uc785\ub825\ud558\uc138\uc694...",sendButton:"\ubcf4\ub0b4\uae30",statsTitle:"Obd \uac74\uac15 \ud1b5\uacc4",connectionProtocol:"\uc5f0\uacb0 \ud504\ub85c\ud1a0\ucf5c:",none:"\uc5c6\uc74c",hardwareQualityScore:"\ud558\ub4dc\uc6e8\uc5b4 \ud488\uc9c8 \uc810\uc218:",original:"\uc6d0\ubcf8",clone:"\ud074\ub860",requestResponseCount:"\uc694\uccad/\uc751\ub2f5 \uc218:",timeoutCount:"\uc2dc\uac04 \ucd08\uacfc \ud69f\uc218:",recoveryCount:"\ubcf5\uad6c \ud69f\uc218(\ubcf5\uad6c):",diagnosticLogTitle:"\uc9c4\ub2e8 \ub85c\uadf8",clearButton:"\ud074\ub9ac\uc5b4",shareButton:"\uacf5\uc720",noLogs:"\uc9c4\ub2e8 \ub85c\uadf8\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",noShareSupport:"\uc774 \uc7a5\uce58\uc5d0\uc11c\ub294 \uacf5\uc720 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."},dtcContext:{powertrain:"\uc774 \uacb0\ud568\uc740 \uc5f0\ube44\uc640 \uc5d4\uc9c4 \uc131\ub2a5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc804\uccb4 \uc9c4\ub2e8 \uc7a0\uae08 \ud574\uc81c \u2192",cooling:"\uc2ec\uac01\ud55c \ub0c9\uac01 \uc704\ud5d8\uc774 \uac10\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc790\uc138\ud55c \uc218\ub9ac \ub2e8\uacc4 \ubcf4\uae30 \u2192",ignition:"\uc810\ud654 \uc2dc\uc2a4\ud15c \ubb38\uc81c\uac00 \uac10\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc790\uc138\ud55c \uc218\ub9ac \ub2e8\uacc4 \ubcf4\uae30 \u2192",chassis:"\uc100\uc2dc \uc548\uc804 \uc2dc\uc2a4\ud15c \uacbd\uace0. \uc804\uccb4 \ubd84\uc11d\uc744 \uc704\ud574 PRO \uc7a0\uae08 \ud574\uc81c \u2192",body:"\ucc28\uccb4 \uc804\uc790 \uc7a5\uce58 \uacb0\ud568\uc774 \ubc1c\uacac\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc644\uc804\ud55c \uc9c4\ub2e8\uc744 \uc704\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc \u2192",network:"\ud1b5\uc2e0 \ub124\ud2b8\uc6cc\ud06c \uc624\ub958\uc785\ub2c8\ub2e4. PRO\ub294 \uc804\uccb4 \ubb38\uc81c \ud574\uacb0\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4 \u2192",fallback:"\uc790\uc138\ud55c \uacb0\ud568 \ubd84\uc11d, \uc218\ub9ac \ube44\uc6a9 \ubc0f \uc704\ud5d8 \ud3c9\uac00 \uc7a0\uae08 \ud574\uc81c \u2192"},perfTeaser:{limitTitle:"\uc77c\uc77c \ud55c\ub3c4 \ub3c4\ub2ec",limitDesc:"0-60km/h \ubb34\ub8cc \ud14c\uc2a4\ud2b8 3\ud68c \uc77c\uc77c \ud55c\ub3c4\uc5d0 \ub3c4\ub2ec\ud588\uc2b5\ub2c8\ub2e4. \ubb34\uc81c\ud55c \ud14c\uc2a4\ud2b8\uc640 0~100km/h \uce21\uc815\uc744 \uc704\ud574 PRO\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694."},sandbox:{title:"\uc0cc\ub4dc\ubc15\uc2a4 \uc6d0\uaca9 \uce21\uc815 \uc81c\uc5b4",connectionStatus:"\uc5f0\uacb0 \uc0c1\ud0dc:",ecuStatus:"ECU \uc0c1\ud0dc:",fps:"UI \uc131\ub2a5: {{fps}} FPS",stressBtnStart:"20Hz \uc2a4\ud2b8\ub808\uc2a4 \uc2dc\uc791",stressBtnStop:"\uc6d0\uaca9 \uce21\uc815 \ub8e8\ud504 \uc911\uc9c0",stopDisconnect:"\uc911\uc9c0/\uc5f0\uacb0 \ub04a\uae30",discoveredDevices:"\ubc1c\uacac\ub41c \uc7a5\uce58",connect:"\uc5f0\uacb0",scanning:"\uc2a4\uce94 \uc911...",scan:"\uc2a4\uce94 \uc7a5\uce58",rpm:"\uc5d4\uc9c4 RPM",speed:"\ucc28\ub7c9 \uc18d\ub3c4",coolant:"\u