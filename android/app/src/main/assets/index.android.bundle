\u03b4\u03cc\u03c1\u03bf\u03c5."},adas_lane_keep_assist_gentle_curve:{name:"\u0391\u03c0\u03b1\u03bb\u03ae \u03ba\u03b1\u03bc\u03c0\u03cd\u03bb\u03b7 \u03c0\u03b1\u03c1\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7\u03c2 \u03b4\u03b9\u03b5\u03cd\u03b8\u03c5\u03bd\u03c3\u03b7\u03c2 Assist Lane Keep Assist (LKA).",desc:"\u039c\u03b1\u03bb\u03b1\u03ba\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b1 \u03be\u03b1\u03c6\u03bd\u03b9\u03ba\u03ac \u03c1\u03c5\u03bc\u03bf\u03c5\u03bb\u03ba\u03ac \u03c4\u03bf\u03c5 \u03c4\u03b9\u03bc\u03bf\u03bd\u03b9\u03bf\u03cd \u03b5\u03c6\u03b1\u03c1\u03bc\u03cc\u03b6\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c0\u03c1\u03bf\u03bf\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7 \u03c1\u03bf\u03c0\u03ae\u03c2."},adas_lka_last_state_memory_mode:{name:"Lane Keep Assist Last State Memory Lock",desc:"\u0391\u03c0\u03bf\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03b5\u03c0\u03b1\u03bd\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 LKA \u03ba\u03ac\u03b8\u03b5 \u03c6\u03bf\u03c1\u03ac \u03c0\u03bf\u03c5 \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03b9\u03bd\u03b5\u03af\u03c4\u03b1\u03b9 \u03b7 \u03b1\u03bd\u03ac\u03c6\u03bb\u03b5\u03be\u03b7."},adas_acc_default_follow_distance:{name:"\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b1\u03c0\u03cc\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 Adaptive Cruise Control (ACC).",desc:"\u039f\u03c1\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03c1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7 \u03ba\u03b5\u03bd\u03bf\u03cd (1 \u03ad\u03c9\u03c2 4 \u03bc\u03c0\u03ac\u03c1\u03b5\u03c2) \u03ba\u03ac\u03b8\u03b5 \u03c6\u03bf\u03c1\u03ac \u03c0\u03bf\u03c5 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1