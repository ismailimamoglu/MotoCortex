0441\u044c \u0443\u0441\u043f\u0435\u0448\u043d\u043e. \u2022 \u041a\u043e\u0434\u044b \u043e\u0448\u0438\u0431\u043e\u043a \u0443\u0434\u0430\u043b\u0435\u043d\u044b. \u2022 \u0421\u0431\u0440\u043e\u0441 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u044b\u0445 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0439. \u2022 \u0421\u0431\u0440\u043e\u0441 \u042d\u0411\u0423 \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c."},info:{desc:"\u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043c\u043e\u0442\u043e\u0446\u0438\u043a\u043b\u043e\u0432 \u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432. \u0421\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c \u0441\u043e \u0432\u0441\u0435\u043c\u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u044b\u043c\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438.",upgrade:"\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 Cortex OBD2 Diagnostic Scanner PRO",upgradeAlert:"\u0420\u0430\u043d\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f",upgradeAlertDesc:"Cortex OBD2 Diagnostic Scanner \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435. \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0432\u044b \u044f\u0432\u043b\u044f\u0435\u0442\u0435\u0441\u044c \u043d\u0430\u0448\u0438\u043c \u043f\u0435\u0440\u0432\u044b\u043c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c, \u0432\u0441\u0435 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0442\u0435\u043f\u0435\u0440\u044c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b \u0432\u0430\u043c. \u0412\u0430\u0448 \u043e\u0442\u0437\u044b\u0432 \u043e\u0447\u0435\u043d\u044c \u0446\u0435\u043d\u0435\u043d \u0434\u043b\u044f \u043d\u0430\u0441!",helpGuide:"\u041f\u041e\u041c\u041e\u0429\u042c \u0418 \u0420\u0423\u041a\u041e\u0412\u041e\u0414\u0421\u0422\u0412\u041e",language:"\u042f\u0437\u044b\u043a / \u042f\u0437\u044b\u043a / \u0411\u0430\u0445\u0430\u0441\u0430",support:"\u0426\u0415\u041d\u0422\u0420 \u041f\u041e\u0414\u0414\u0415\u0420\u0416\u041a\u0418",supportSubject:"\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0438 \u043e\u0442\u0437\u044b\u0432\u044b Cortex OBD2 Diagnostic Scanner",thanks:"\u0421\u043f\u0430\u0441\u0438\u0431\u043e!",thanksDesc:"\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0432\u0430\u0448 \u043e\u0442\u0437\u044b\u0432. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u0430\u043c \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u0432 Play Store.",sections:{live:{title:"\u0414\u0410\u0422\u0427\u0418\u041a\u0418 \u0416\u0418\u0412\u041e\u0413\u041e \u041c\u041e\u041d\u0418\u0422\u041e\u0420\u0418\u041d\u0413\u0410",content:"\u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c \u043e\u0431\u043e\u0440\u043e\u0442\u044b \u0432 \u043c\u0438\u043d\u0443\u0442\u0443, \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f, \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u0440\u043e\u0441\u0441\u0435\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u0441\u043b\u043e\u043d\u043a\u0438, \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430, \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0443 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u0438 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u043e\u0440\u0435. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u044e\u0442\u0441\u044f 1\u20135 \u0440\u0430\u0437 \u0432 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0432\u0430\u0448\u0435\u0433\u043e Bluetooth. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0432\u043c\u0435\u0448\u0430\u0442\u044c\u0441\u044f \u0432 \u0440\u0430\u0431\u043e\u0442\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043a\u043e\u043c\u0430\u043d\u0434 UDS/OBD \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b."},expertise:{title:"\u041e\u0411\u0421\u041b\u0415\u0414\u041e\u0412\u0410\u041d\u0418\u0415 \u0418 \u0413\u0410\u0420\u0410\u041d\u0422\u0418\u042f",content:"\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u043a\u043e\u0434\u044b ECU \u0434\u043b\u044f \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u043e\u0448\u0438\u0431\u043e\u043a. \u0424\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044f VIN-\u043d\u043e\u043c\u0435\u0440 \u0438 \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u043f\u0440\u043e\u0431\u0435\u0433 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f. \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u043f\u0440\u043e\u0448\u043b\u044b\u0435 \u043e\u0448\u0438\u0431\u043a\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u0443\u0442\u0435\u043c \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043f\u0440\u043e\u0435\u0445\u0430\u043b \u0441 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c Check Engine. \u041f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0439 \u043e\u0442\u0447\u0435\u0442 \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0432 \u0441\u0440\u0435\u0434\u0430\u0445 PDF \u0438 Messaging."},tests:{title:"\u0410\u041a\u041a\u0423\u041c\u0423\u041b\u042f\u0422\u041e\u0420\u041d\u0410\u042f \u0411\u0410\u0422\u0410\u0420\u0415\u042f / \u0422\u0415\u0421\u0422\u042b \u0420\u0410\u0411\u041e\u0422\u042b",content:"\u0422\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 3 \u044d\u0442\u0430\u043f\u043e\u0432: \u0442\u0435\u0441\u0442\u044b \u043f\u043e\u043a\u043e\u044f, \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0438 \u0437\u0430\u0440\u044f\u0434\u043a\u0438 \u043d\u0430 \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u043c \u0445\u043e\u0434\u0443 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430/\u0440\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u0430. \u0422\u0435\u0441\u0442 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438\u0437\u043c\u0435\u0440\u044f\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f 0\u201360 \u0438 0\u2013100 \u043a\u043c/\u0447 \u0441 \u043f\u043e\u0433\u0440\u0435\u0448\u043d\u043e\u0441\u0442\u044c\u044e 50 \u043c\u0441, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u0430 \u0432\u0430\u0448\u0435\u0433\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0438 \u0432\u0430\u0448\u0435\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f."},hardware:{title:"\u0410\u041f\u041f\u0410\u0420\u0410\u0422\u041d\u0410\u042f \u0421\u041e\u0412\u041c\u0415\u0421\u0422\u0418\u041c\u041e\u0421\u0422\u042c",content:"\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f ELM327 Bluetooth. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0435 \u043a\u043e\u0434\u044b \u043c\u043e\u0433\u0443\u0442 \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0438 \u043d\u0438\u0437\u043a\u043e\u0433\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0441 \u0432\u0435\u0440\u0441\u0438\u0435\u0439 CLONE v2.1. \u0412\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0441 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u0430\u043c\u0438 \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u043a\u043b\u0430\u0441\u0441\u0430, \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a vLinker \u0438 OBDLink."},warnings:{title:"\u0412\u0410\u0416\u041d\u042b\u0415 \u041f\u0420\u0415\u0414\u0423\u041f\u0420\u0415\u0416\u0414\u0415\u041d\u0418\u042f",content:"\u2022 \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u0434\u0430 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0441\u0431\u0440\u043e\u0441\u0430 \u042d\u0411\u0423 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d. \u2022 \u041d\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0441\u0431\u0440\u043e\u0441 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c. \u2022 \u041d\u0435 \u043a\u0430\u0436\u0434\u043e\u0435 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u0432\u0441\u0435 \u0434\u0430\u0442\u0447\u0438\u043a\u0438, \u0434\u043b\u044f \u043d\u0435\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0445 \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u0432 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \xab--\xbb."},onboarding:{title:"\u042e\u0420\u0418\u0414\u0418\u0427\u0415\u0421\u041a\u0418\u0415 \u0420\u0410\u0417\u0420\u0415\u0428\u0415\u041d\u0418\u042f \u0418 \u0410\u041d\u041e\u041d\u0418\u041c\u041d\u0410\u042f \u0422\u0415\u041b\u0415\u041c\u0415\u0422\u0420\u0418\u042f",content:"\u0414\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438 \u0441 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u044b\u043c\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438; \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0438 \u043a\u043e\u0434\u044b \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439, \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0435 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439, \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u043d\u0430 \u043d\u0430\u0448\u0438\u0445 \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u043d\u044b\u0445 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u0445. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f, \u0432\u044b \u0441\u043e\u0433\u043b\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044c \u0441 \u044d\u0442\u0438\u043c\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c\u0438 \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u043e\u0439 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0438. \u0414\u043b\u044f \u0441\u0432\u044f\u0437\u0438 \u0441 \u042d\u0411\u0423 \u0432\u0430\u0448\u0435\u0433\u043e \u043c\u043e\u0442\u043e\u0446\u0438\u043a\u043b\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f Bluetooth \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f."},featureCoding:{title:"\u0420\u0410\u0417\u0411\u041b\u041e\u041a\u0418\u0420\u041e\u0412\u041a\u0410 \u0421\u041a\u0420\u042b\u0422\u042b\u0425 \u0424\u0423\u041d\u041a\u0426\u0418\u0419 \u0418 \u041a\u041e\u0414\u0418\u0420\u041e\u0412\u0410\u041d\u0418\u0415 UDS",content:"\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043d\u0430\u0448\u0435\u043c\u0443 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0443 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 UDS \u043f\u043e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0443 ISO 14229 \u043c\u043e\u0436\u043d\u043e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u044c \u0442\u0430\u043a\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043a\u0430\u043a \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043d\u044b\u0435 \u043e\u0433\u043d\u0438 \u0421\u0428\u0410, \u0438\u0433\u043e\u043b\u044c\u0447\u0430\u0442\u0443\u044e \u0440\u0430\u0437\u0432\u0435\u0440\u0442\u043a\u0443, \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0443 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0430, \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u044b\u0435 \u043e\u043a\u043d\u0430 \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0414\u0425\u041e \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0435\u0439 VAG, BMW, Renault \u0438 Dacia."},multiEcu:{title:"\u0421\u041a\u0410\u041d\u0418\u0420\u041e\u0412\u0410\u041d\u0418\u0415 \u0412\u0421\u0415\u0425 \u041c\u041e\u0414\u0423\u041b\u0415\u0419 \u041c\u0423\u041b\u042c\u0422\u0418-\u042d\u0411\u0423",content:"\u0421\u043a\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u0438 \u0443\u0434\u0430\u043b\u044f\u0439\u0442\u0435 \u043a\u043e\u0434\u044b \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u042d\u0411\u0423 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f, \u0432\u043a\u043b\u044e\u0447\u0430\u044f ABS, \u043f\u043e\u0434\u0443\u0448\u043a\u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438, \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043a\u043e\u0440\u043e\u0431\u043a\u0443 \u043f\u0435\u0440\u0435\u0434\u0430\u0447, \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044e \u043f\u0440\u0438\u0431\u043e\u0440\u043e\u0432, \u043a\u043b\u0438\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0438 \u043c\u043e\u0434\u0443\u043b\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u0443\u0437\u043e\u0432\u043d\u044b\u043c \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c."},advancedDiagnostics:{title:"\u0410\u0414\u0410\u041f\u0422\u0410\u0426\u0418\u042f DCT, DPF \u0418 \u0414\u0410\u0422\u0427\u0418\u041a \u041c\u041e\u0429\u041d\u041e\u0421\u0422\u0418 HP",content:"\u2022 DCT/DSG \u0421\u0431\u0440\u043e\u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0438 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u0442\u043e\u0447\u043a\u0438 \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u044f \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u044f\n\u2022 \u0417\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0441\u0430\u0436\u0438 DPF \u0438 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0432\u044b\u0445\u043b\u043e\u043f\u043d\u044b\u0445 \u0433\u0430\u0437\u043e\u0432\n\u2022 \u041a\u0440\u0430\u0442\u043a\u043e\u0441\u0440\u043e\u0447\u043d\u0430\u044f/\u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u0430\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u043f\u043e\u0434\u0430\u0447\u0438 \u0442\u043e\u043f\u043b\u0438\u0432\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u043b\u044f\u043c\u0431\u0434\u0430-\u0430\u043d\u0430\u043b\u0438\u0437\n\u2022 \u0414\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u0430 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 \u0438 \u043a\u0440\u0443\u0442\u044f\u0449\u0435\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0438"},demoMode:{title:"\u0414\u0415\u041c\u041e \u0420\u0415\u0416\u0418\u041c",content:"\u0422\u0435\u0441\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u0438 \u0438\u0437\u0443\u0447\u0430\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0431\u0435\u0437 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044f OBD2. \u0418\u0441\u043f\u044b\u0442\u0430\u0439\u0442\u0435 \u0432\u0441\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 CAN-Bus \u0438 UDS \u0441 \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u043e\u0439 \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0435\u0439 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0438 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438."}},reconfigurePermissions:"\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043d\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0438 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f",shareWithFriend:"\u041f\u041e\u0414\u0415\u041b\u0418\u0422\u042c\u0421\u042f \u0421 \u0414\u0420\u0423\u0413\u041e\u041c",shareMessageText:"\u041d\u0430\u0439\u0434\u0438\u0442\u0435 \u043a\u043e\u0434\u044b \u043e\u0448\u0438\u0431\u043e\u043a \u042d\u0411\u0423 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0438 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044e \u0434\u0430\u0442\u0447\u0438\u043a\u043e\u0432 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e Cortex OBD2 Diagnostic Scanner! \u0421\u043a\u0430\u0447\u0430\u0442\u044c \u0441\u0435\u0439\u0447\u0430\u0441: iOS: https://apps.apple.com/app/id6764052240 Android: https://play.google.com/store/apps/details?id=com.ismail.motocortexv2 Web Portal: https://motocortex-telemetry.vercel.app/"},report:{title:"\u2550\u2550\u2550 \u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u0427\u0415\u0421\u041a\u0418\u0419 \u041e\u0422\u0427\u0415\u0422 \u041c\u041e\u0422\u041e\u041a\u041e\u0420\u0422\u0415\u041a\u0421\u0410 \u2550\u2550\u2550",vehicleIdentity:"\u0418\u0414\u0415\u041d\u0422\u0418\u0424\u0418\u041a\u0410\u0422\u041e\u0420 \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0418\u041b\u042f",vin:"\u041d\u043e\u043c\u0435\u0440 \u0448\u0430\u0441\u0441\u0438",odometer:"\u0420\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435",milDist:"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0433\u043e\u0440\u0438\u0442",distSinceCleared:"\u041e\u0448\u0438\u0431\u043a\u0430 \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0430",dtcCount:"FAULT CODES ({{count}})",sensorData:"\u0416\u0418\u0412\u042b\u0415 \u0414\u0410\u041d\u041d\u042b\u0415 \u0421 \u0421\u0415\u041d\u0421\u041e\u0420\u0410",noData:"\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435",proApp:"\u0421\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e Cortex OBD2 Diagnostic Scanner v7 PRO.",date:"\u0434\u0430\u0442\u0430",vinNotFound:"\u041d\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d",noDtcs:"\u041d\u0415\u0422 \u041a\u041e\u0414\u041e\u0412 \u041e\u0428\u0418\u0411\u041e\u041a \u2013 \u0427\u0418\u0421\u0422\u041a\u0410",speed:"\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c",coolant:"\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f",throttle:"\u0433\u0430\u0437",engineLoad:"\u041d\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f",intakeAir:"\u0412\u043f\u0443\u0441\u043a\u043d\u043e\u0439 \u0432\u043e\u0437\u0434\u0443\u0445",manifold:"\u041a\u043e\u043b\u043b\u0435\u043a\u0442\u043e\u0440",voltage:"\u041d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0431\u0430\u0442\u0430\u0440\u0435\u0438",shareMessage:"\u0421\u043b\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c \u0432\u0430\u0448\u0435\u0433\u043e \u043c\u043e\u0442\u043e\u0446\u0438\u043a\u043b\u0430 \u0438\u0437 \u0441\u0432\u043e\u0435\u0433\u043e \u043a\u0430\u0440\u043c\u0430\u043d\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f Motocortex OBD2! \u0421\u043a\u0430\u0447\u0430\u0442\u044c: https://cortexobd2.app",subtitle:"\u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u0430\u044f \u043f\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0438 \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430",vehicleInfo:"\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0438 \u043c\u0435\u0442\u0430\u0434\u0430\u043d\u043d\u044b\u0435 \u042d\u0411\u0423",healthScore:"\u041e\u0431\u0449\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u042d\u0411\u0423",dtcSection:"\u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u0434\u044b \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439",telemetrySection:"\u0422\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044f \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0441\u043d\u0438\u043c\u043e\u043a \u0434\u0430\u0442\u0447\u0438\u043a\u0430",maintenanceSection:"\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0438 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0410\u043a\u044b\u043b\u043b\u044b \u0413\u0430\u0440\u0430\u0434\u0436",aiSection:"\u0410\u043d\u0430\u043b\u0438\u0437 \u043e\u0431\u0449\u0435\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f AI Doctor",noFaults:"\u0412 \u043f\u0430\u043c\u044f\u0442\u0438 \u042d\u0411\u0423 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0438\u043b\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u0434\u044b \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0435\u0439.",noMaintenance:"\u0412 \u0410\u043a\u044b\u043b\u043b\u044b \u0413\u0430\u0440\u0430\u0434\u0436\u0435 \u043d\u0435\u0442 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0441\u043b\u0443\u0436\u0435\u0431\u043d\u044b\u0445 \u0437\u0430\u043f\u0438\u0441\u0435\u0439.",disclaimer:"\u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438: \u044d\u0442\u043e\u0442 \u043e\u0442\u0447\u0435\u0442 \u0441\u043e\u0437\u0434\u0430\u0435\u0442\u0441\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u044b\u043c \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u0435\u043c MotoCortex. \u041f\u0435\u0440\u0435\u0434 \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u0438\u0435\u043c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0441\u043c\u043e\u0442\u0440 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u043c.",shareTitle:"\u041f\u043e\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u043e\u0442\u0447\u0435\u0442\u043e\u043c \u043e\u0431 \u043e\u0446\u0435\u043d\u043a\u0435 MotoCortex"},battery:{title:"\u0410\u041a\u041a\u0423\u041c\u0423\u041b\u042f\u0422\u041e\u0420\u041d\u0410\u042f \u0411\u0410\u0422\u0410\u0420\u0415\u042f \u0418 \u041f\u0423\u0421\u041a\u041e\u0412\u041e\u0419 \u0422\u0415\u0421\u0422",ready:"\u0413\u043e\u0442\u043e\u0432 \u043d\u0430\u0447\u0430\u0442\u044c \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435.",restingStatus:"\u0417\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d... \u0421\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0430\u043a\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430...",crankingStatus:"\u0421\u0422\u0410\u0420\u0422\u0415\u0420 \u0421\u0415\u0419\u0427\u0410\u0421!",chargingStatus:"\u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430 \u0445\u043e\u043b\u043e\u0441\u0442\u043e\u043c \u0445\u043e\u0434\u0443... \u0421\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0437\u0430\u0440\u044f\u0434\u043a\u0438...",doneStatus:"\u0422\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e!",voltageError:"\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435.",start:"\u041d\u0410\u0427\u0410\u0422\u042c \u0422\u0415\u0421\u0422",retry:"\u041f\u041e\u0412\u0422\u041e\u0420\u0418\u0422\u042c \u0422\u0415\u0421\u0422",procedure:"\u041f\u0420\u041e\u0426\u0415\u0414\u0423\u0420\u0410 \u0418\u0421\u041f\u042b\u0422\u0410\u041d\u0418\u042f",steps:{1:"1. \u0417\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d \u2192 \u0418\u0437\u043c\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u043e\u044f.",2:"2. \u041a\u043e\u0433\u0434\u0430 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \xab\u041d\u0410\u0427\u0410\u0422\u042c \u0421\u0415\u0419\u0427\u0410\u0421\xbb, \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c.",3:"3. \u0421\u0430\u043c\u043e\u0435 \u043d\u0438\u0437\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435, \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 5 \u0441\u0435\u043a\u0443\u043d\u0434.",4:"4. \u041d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0437\u0430\u0440\u044f\u0434\u043a\u0438/\u0440\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u0430 \u0438\u0437\u043c\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0435\u043c \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0435."},warning:"\u041d\u0435 \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u0439\u0442\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 Bluetooth \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f.",resting:"\u041e\u0422\u0414\u042b\u0425",cranking:"\u0413\u0418\u041c\u041d",charging:"\u0417\u0410\u0420\u042f\u0414\u041a\u0410",instantV:"\u041c\u0413\u041d\u041e\u0412\u0415\u041d\u041d\u041e\u0415 \u041d\u0410\u041f\u0420\u042f\u0416\u0415\u041d\u0418\u0415",evaluation:"\u041e\u0426\u0415\u041d\u041a\u0410",verdicts:{full:"\u0411\u0430\u0442\u0430\u0440\u0435\u044f: \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0437\u0430\u0440\u044f\u0436\u0435\u043d\u0430",good:"\u0411\u0430\u0442\u0430\u0440\u0435\u044f: \u0425\u043e\u0440\u043e\u0448\u0435\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435",weak:"\u0411\u0430\u0442\u0430\u0440\u0435\u044f: \u041e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0438\u0435",empty:"\u0411\u0430\u0442\u0430\u0440\u0435\u044f: \u0421\u043b\u0430\u0431\u0430\u044f/\u0420\u0430\u0437\u0440\u044f\u0436\u0435\u043d\u043d\u0430\u044f",crankNormal:"\u041d\u0430\u0447\u0430\u043b\u043e: \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435",crankLow:"\u0421\u0442\u0430\u0440\u0442\u0435\u0440: \u041d\u0438\u0437\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435",crankCritical:"\u0413\u0438\u043c\u043d: \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0430\u0434\u0435\u043d\u0438\u0435",regNormal:"\u0417\u0430\u0440\u044f\u0434\u043a\u0430: \u0420\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439",regLow:"\u0417\u0430\u0440\u044f\u0434\u043a\u0430: \u043d\u0438\u0437\u043a\u0438\u0439 \u0437\u0430\u0440\u044f\u0434",regHigh:"\u0417\u0430\u0440\u044f\u0434\u043a\u0430: \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0430",regFail:"\u0417\u0430\u0440\u044f\u0434\u043a\u0430: \u0420\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440 \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u0435\u043d"},verdictLocked:"\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435\u0441\u044c \u0434\u043e PRO \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0442\u0447\u0451\u0442\u0430 \u043e \u0431\u0430\u0442\u0430\u0440\u0435\u0435."},freeze:{title:"\u0421\u0422\u041e\u041f-\u041a\u0410\u0414\u0420",snapshot:"\u041f\u0410\u041c\u042f\u0422\u042c \u041e \u041d\u0415\u0418\u0421\u041f\u0420\u0410\u0412\u041d\u041e\u0421\u0422\u0418",desc:"\u041e\u043d \u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f, \u043a\u043e\u0433\u0434\u0430 \u0437\u0430\u0433\u043e\u0440\u0430\u0435\u0442\u0441\u044f 