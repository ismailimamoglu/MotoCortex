{
  "expo": {
    "name": "Cortex OBD2 Diagnostic Scanner",
    "displayName": "Cortex OBD2 Diagnostic Scanner",
    "slug": "MotoCortex-mobile",
    "version": "2.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ismail.motocortexv2",
      "buildNumber": "69",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "NSBluetoothAlwaysUsageDescription": "MotoCortex connects via Bluetooth to your ELM327 / OBD-II vehicle diagnostic adapter to monitor real-time engine telemetry (RPM, coolant temperature, boost, fuel trims) and read diagnostic trouble codes (DTCs), ensuring continuous vehicle monitoring even while the screen is locked.",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth access is required to discover, pair, and communicate with your wireless OBD2 / ELM327 vehicle scanner.",
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "tr",
          "de",
          "fr",
          "es",
          "it",
          "pt",
          "nl",
          "ru",
          "zh",
          "ja",
          "ko",
          "ar",
          "id",
          "pl",
          "uk",
          "ro",
          "hu",
          "no",
          "da",
          "fi",
          "sv",
          "cs",
          "el",
          "th",
          "hi"
        ],
        "NSLocationWhenInUseUsageDescription": "Location access is required by iOS core Bluetooth services to scan for nearby wireless OBD2 diagnostic adapters. MotoCortex does NOT track, store, or share your GPS location."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#0c2b48"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 73,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.ismail.motocortexv2",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Cortex OBD2 Diagnostic Scanner uses Bluetooth to maintain a constant diagnostic link with your vehicle's ECU for live performance monitoring."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-localization",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "ed445853-1aed-4ed1-91e6-d767416ebf17"
      }
    },
    "runtimeVersion": "1.2.1",
    "updates": {
      "url": "https://u.expo.dev/ed445853-1aed-4ed1-91e6-d767416ebf17"
    }
  }
}
