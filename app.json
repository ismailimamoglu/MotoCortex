{
  "expo": {
    "name": "Cortex OBD2 Diagnosis Scanner",
    "displayName": "Cortex OBD2 Diagnosis Scanner",
    "slug": "MotoCortex-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ismail.motocortexv2",
      "buildNumber": "46",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "NSBluetoothAlwaysUsageDescription": "Cortex OBD2 Diagnosis Scanner uses Bluetooth to maintain a constant diagnostic link with your vehicle's ECU via BLE adapters, enabling live performance monitoring and real-time alerts even when the app is in the background or the screen is off.",
        "NSBluetoothPeripheralUsageDescription": "Cortex OBD2 Diagnosis Scanner requires access to discover and connect to your vehicle's ELM327/OBD2 diagnostic adapter for engine data streaming.",
        "NSLocationWhenInUseUsageDescription": "iOS requires Location access to perform Bluetooth Low Energy (BLE) device scanning. Cortex OBD2 Diagnosis Scanner does NOT track, store, or share your movement data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 46,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_ADVERTISE"
      ],
      "package": "com.ismail.motocortexv2",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Cortex OBD2 Diagnosis Scanner uses Bluetooth to maintain a constant diagnostic link with your vehicle's ECU for live performance monitoring."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-localization",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "ed445853-1aed-4ed1-91e6-d767416ebf17"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/ed445853-1aed-4ed1-91e6-d767416ebf17"
    }
  }
}
